<tal:report>

  <!-- ══════════════════════════════════════════════════════════════════════
       PFAS Certificate of Analysis — controlled documentation publication
       (senaite.pfas, D65). Registered via plone:static as a
       senaite.impress.reports template, so it appears in the impress picker as
       "senaite.pfas:CertificateOfAnalysis.pt". Built ON core impress (§6C,
       Golden Rule 2): reuses every core render_* section verbatim. The only
       PFAS divergence is the SIGNATURES section (A2), which is replaced with a
       controlled 3-tier attestation resolved from the live workflow actors.

       A1: identical to core Default.pt — verifies the plumbing renders the
       stock report before any divergence is introduced.
       ══════════════════════════════════════════════════════════════════════ -->

  <!-- REPORT CONTROLS -->
  <tal:t replace="structure python:view.render_controls(context, **options)" />

  <!-- REPORT JS -->
  <tal:t replace="structure python:view.render_js(context, **options)" />

  <!-- REPORT CSS -->
  <tal:t replace="structure python:view.render_css(context, **options)" />

  <!-- Per-result QC qualifier marker, emitted beside the value by
       browser/reportview.py on a qualified release. Deliberately understated:
       it must be legible next to the number without competing with it, and the
       wording it points at is in the QC Qualifications section below. -->
  <style type="text/css">
    .qc-qualifier {
      font-size: 0.8em;
      font-weight: 600;
      vertical-align: super;
      margin-left: 0.15em;
      color: #8a5a00;
      white-space: nowrap;
    }
  </style>

  <!-- REPORT HEADER -->
  <tal:t replace="structure python:view.render_header(context, **options)" />

  <!-- REPORT INFO -->
  <tal:t replace="structure python:view.render_info(context, **options)" />

  <!-- REPORT ALERTS -->
  <tal:t replace="structure python:view.render_alerts(context, **options)" />

  <!-- REPORT SUMMARY -->
  <tal:t replace="structure python:view.render_summary(context, **options)" />

  <!-- REPORT RESULTS -->
  <tal:t replace="structure python:view.render_results(context, **options)" />

  <!-- RESULTS INTERPRETATION -->
  <tal:t replace="structure python:view.render_interpretations(context, **options)" />

  <!-- SAMPLE REMARKS -->
  <tal:t replace="structure python:view.render_remarks(context, **options)" />

  <!-- REPORT ATTACHMENTS -->
  <tal:t replace="structure python:view.render_attachments(context, **options)" />

  <!-- CONTROLLED CoA ATTESTATION (PFAS, D65 A2) — replaces core's
       render_signatures. Resolves the actual workflow actors (prepared /
       verified / authorized) from the samples on this certificate. `context`
       here is the portal; the attestation view is traversed off it and handed
       the report's collection of SuperModels + the impress report view. -->
  <tal:t replace="structure python:context.restrictedTraverse('@@pfas-coa-attestation')(collection=view.collection, report_view=view)" />

  <!-- REPORT DISCREETER -->
  <tal:t replace="structure python:view.render_discreeter(context, **options)" />


  <!-- ACCREDITATION SCOPE (PFAS) — printed ABOVE the QC qualifications and in
       a heavier frame on purpose. It is a statement about the SAMPLE, not about
       a measurement: ISO 17025 §7.8.2.1 requires results not covered by the
       laboratory's accreditation to be clearly identified, and a reader must
       not have to infer scope from a list of per-result codes.

       Read from the criteria FROZEN on the worksheet at verification, never
       resolved at render time — see accreditation_disclosure(). When nothing
       was frozen the block is absent: the certificate states no scope claim
       rather than implying one. -->
  <tal:accred define="att python:context.restrictedTraverse('@@pfas-coa-attestation');
                      accred python:att.accreditation_disclosure(view.collection);"
              condition="python:accred and accred.get('out_of_scope')">
    <div style="margin-top:14px; padding:9px 11px; border:2px solid #000;">
      <div style="font-weight:bold; font-size:12px; margin-bottom:4px;"
           i18n:translate="">
        Not covered by the laboratory's accreditation
      </div>
      <div style="font-size:10px; color:#222; margin-bottom:6px;">
        This sample was analysed under project-specific requirements that depart
        from the published method. The departures are stated below. Results are
        reported in full; they are not accredited results.
      </div>
      <table style="width:100%; font-size:10px; border-collapse:collapse;">
        <tr tal:repeat="line accred/lines" style="vertical-align:top;">
          <td style="width:14px; padding:3px 4px;">&#8226;</td>
          <td style="padding:3px 4px;" tal:content="line">departure</td>
        </tr>
      </table>
      <div style="font-size:9px; color:#555; margin-top:5px;"
           tal:condition="accred/frozen_at">
        Governing criteria recorded at technical review
        (<tal:v replace="accred/frozen_at"/>).
      </div>
    </div>
  </tal:accred>


  <!-- QC QUALIFICATIONS (PFAS) — results released despite a failing QC
       criterion, with the laboratory's statement of what it means. Rendered
       here because core owns the results table; the short code travels with
       each affected analysis so a value cannot be read off the table without
       it. ISO 17025 §7.8.4: releasing non-conforming work is permitted when
       the deviation is authorised, justified and RECORDED — this is the
       client's half of that record. -->
  <tal:quals define="att python:context.restrictedTraverse('@@pfas-coa-attestation');
                     quals python:att.qc_qualifications(view.collection);"
             condition="quals">
    <div style="margin-top:14px; padding:8px 10px; border:1px solid #bbb;">
      <div style="font-weight:bold; font-size:12px; margin-bottom:4px;"
           i18n:translate="">Quality control qualifications</div>
      <div style="font-size:10px; color:#444; margin-bottom:6px;"
           i18n:translate="">
        The results below were released although a quality control criterion was
        not met. Each qualified result carries the code shown.
      </div>
      <table style="width:100%; font-size:10px; border-collapse:collapse;">
        <tr tal:repeat="q quals" style="vertical-align:top;">
          <td style="width:34px; font-weight:bold; padding:3px 4px;"
              tal:content="q/code">M</td>
          <td style="padding:3px 4px;">
            <div tal:content="q/statement">statement</div>
            <div style="color:#666; margin-top:2px;"
                 tal:condition="q/analytes">
              <span i18n:translate="">Affected analytes:</span>
              <span tal:content="q/analytes">PFOA</span>
            </div>
          </td>
        </tr>
      </table>
    </div>
  </tal:quals>

  <!-- REPORT FOOTER -->
  <tal:t replace="structure python:view.render_footer(context, **options)" />

  <!-- CONTROLLED-DOCUMENT STAMP (PFAS, D65 A3) — report identity + revision
       (prospective at render time) and the uncontrolled-when-printed notice. -->
  <tal:stamp define="att python:context.restrictedTraverse('@@pfas-coa-attestation');
                     meta python:att.controlled_doc_meta(view.collection)">
    <div style="margin-top:10px; padding-top:6px; border-top:1px solid #ccc;
                font-size:10px; color:#666; text-align:center;">
      <span i18n:translate="">Controlled documentation publication</span>
      <tal:rid condition="meta/report_id">
        &middot; <span tal:content="meta/report_id"></span>
      </tal:rid>
      &middot; <span i18n:translate="">uncontrolled when printed</span>
    </div>
  </tal:stamp>

</tal:report>
