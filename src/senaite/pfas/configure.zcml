<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:five="http://namespaces.zope.org/five"
    i18n_domain="senaite.pfas">

  <!-- Zope calls initialize() at start-up: it installs the log filters and
       the wrappers that show SENAITE's dates in the laboratory's zone. -->
  <five:registerPackage package="." initialize=".initialize" />

  <!-- What the pipeline worker's own account may do beyond core's roles
       (setuphandlers.setup_worker_role grants it to the worker's role) -->
  <permission id="senaite.pfas.WorkerTasks" title="senaite.pfas: Worker tasks" />

  <includeDependencies package="." />
  <include package=".browser" />

  <!-- PFAS impress report templates: registers templates/reports/ as a
       senaite.impress.reports resource directory so the PFAS Certificate of
       Analysis appears in the impress template picker as
       "senaite.pfas:CertificateOfAnalysis.pt". Mirrors senaite.impress's own
       report-dir registration; no core fork (§6C). -->
  <plone:static
      name="senaite.pfas"
      directory="templates/reports"
      type="senaite.impress.reports"
      />

  <!-- GenericSetup profile that installs analytes, methods, sample types,
       containers, storage locations, and custom content types -->
  <genericsetup:registerProfile
      name="default"
      title="senaite.pfas"
      description="PFAS LIMS extension: analyte library + method profiles +
                   reagent tracking + run-queue QC + extraction reporting."
      directory="profiles/default"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_install"
  />

  <genericsetup:registerProfile
      name="uninstall"
      title="senaite.pfas (uninstall)"
      directory="profiles/uninstall"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_uninstall"
  />

  <!-- Custom content types defined by this add-on -->
  <include file="content.zcml" />

  <!-- Archetypes schema extenders (ReferenceDefinition PFAS QC fields) -->
  <include package=".extenders" />

  <!-- A password set: its time for the expiry, and a reset by another
       account opened for review (password_events.py) -->
  <subscriber
      for="Products.PluggableAuthService.interfaces.events.ICredentialsUpdatedEvent"
      handler=".password_events.on_credentials_updated"
      />

  <!-- A core Sample Type renamed renames that matrix in every method profile,
       the regulatory limits and project specs (matrix_rename.py: core owns matrix names) -->
  <subscriber
      for="senaite.core.interfaces.ISampleType
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".matrix_rename.on_sampletype_modified"
      />
  <!-- ... and its form refuses a title already in use (sampletype_title.py) -->
  <adapter factory=".sampletype_title.SampleTypeTitleValidator" />

  <!-- A core Analysis Service added or edited in Setup (its PFAS tab holds
       the compound library) is exported to the worker with the method
       profiles (compound_library_store.py) -->
  <subscriber
      for="bika.lims.interfaces.IAnalysisService
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".compound_library_store.on_service_changed"
      />
  <!-- a service a method profile still names is not deleted (the refusal
       lists each method and where) -->
  <subscriber
      for="bika.lims.interfaces.IAnalysisService
           OFS.interfaces.IObjectWillBeRemovedEvent"
      handler=".compound_library_store.refuse_referenced_removal"
      />
  <subscriber
      for="bika.lims.interfaces.IAnalysisService
           zope.lifecycleevent.interfaces.IObjectRemovedEvent"
      handler=".compound_library_store.on_service_removed"
      />

  <!-- A core analysis shows the method x matrix unit and the lab-rounded
       decimals: set inside SENAITE whenever it changes or is submitted
       (analysis_display.py) -->
  <subscriber
      for="bika.lims.interfaces.IRoutineAnalysis
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".analysis_display.on_analysis_changed"
      />
  <subscriber
      for="bika.lims.interfaces.IRoutineAnalysis
           Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".analysis_display.on_analysis_changed"
      />

  <!-- A new sample with no homogenisation method takes its matrix's
       default, frozen then (homogenisation.py) -->
  <subscriber
      for="bika.lims.interfaces.IAnalysisRequest
           Products.Archetypes.interfaces.IObjectInitializedEvent"
      handler=".homogenisation.on_sample_initialized"
      />

  <!-- A new sample with no report tier takes its client's default, frozen
       then (report_tiers.py) -->
  <subscriber
      for="bika.lims.interfaces.IAnalysisRequest
           Products.Archetypes.interfaces.IObjectInitializedEvent"
      handler=".report_tiers.on_sample_initialized"
      />

  <!-- A new batch naming no project takes its client's standing project
       (project_ref.py) -->
  <subscriber
      for="bika.lims.interfaces.IBatch
           Products.Archetypes.interfaces.IObjectInitializedEvent"
      handler=".project_ref.on_batch_initialized"
      />

  <!-- A sample created or edited: a project-linked batch with no resolved
       criteria file yet gets one after the commit, once its method and
       matrix are known (project_ref.py) -->
  <subscriber
      for="bika.lims.interfaces.IAnalysisRequest
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".project_ref.on_sample_modified"
      />

  <!-- A sample registered with a generated Analysis Profile: its analyses
       carry that method (analysis_profiles.apply_method) -->
  <subscriber
      for="bika.lims.interfaces.IAnalysisRequest
           Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".analysis_profiles.on_sample_changed"
      />

  <!-- Core's analyses listings show a PFAS result as the certificate states
       it, rounded by the lab's rule (analysis_display.py) -->
  <subscriber
      for="bika.lims.browser.analyses.view.AnalysesView
           *"
      provides="senaite.app.listing.interfaces.IListingViewAdapter"
      factory=".analysis_display.PFASResultListingAdapter"
      />

  <!-- The Instruments list: methods as short method-id tags, the full name
       on hover (instrument_listing.py) -->
  <subscriber
      for="bika.lims.controlpanel.bika_instruments.InstrumentsView
           *"
      provides="senaite.app.listing.interfaces.IListingViewAdapter"
      factory=".instrument_listing.InstrumentMethodTagsAdapter"
      />

  <!-- A sample's analyses: the unit in its own column, no Submitter or
       Attachments column (analysis_display.py) -->
  <subscriber
      for="bika.lims.browser.analyses.view.AnalysesView
           *"
      provides="senaite.app.listing.interfaces.IListingViewAdapter"
      factory=".analysis_display.SampleAnalysesColumnsAdapter"
      />

  <!-- A samples list: Matrix, Sampled and Client sample ID as the column
       titles (sample_listing.py) -->
  <subscriber
      for="senaite.core.browser.samples.view.SamplesView
           *"
      provides="senaite.app.listing.interfaces.IListingViewAdapter"
      factory=".sample_listing.SamplesColumnTitlesAdapter"
      />

  <!-- core's Laboratory edited in its own form: the site title stays the
       laboratory's name (lab_identity.py) -->
  <subscriber
      for="bika.lims.interfaces.ILaboratory
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".lab_identity.on_laboratory_modified"
      />

  <!-- A core Supplier / Storage Location renamed is renamed on every reagent
       and prepared standard (browser/core_lists.py) -->
  <subscriber
      for="senaite.core.interfaces.ISupplier
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".browser.core_lists.on_core_list_modified"
      />
  <subscriber
      for="senaite.core.interfaces.IStorageLocation
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".browser.core_lists.on_core_list_modified"
      />

</configure>
