<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="senaite.pfas">

  <includeDependencies package="." />
  <include package=".browser" />

  <!-- GenericSetup profile that installs analytes, methods, sample types,
       containers, storage locations, and custom content types -->
  <genericsetup:registerProfile
      name="default"
      title="senaite.pfas"
      description="PFAS LIMS extension: analyte library + method profiles +
                   reagent tracking + run-queue QC + extraction reporting."
      directory="profiles/default"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_install"
  />

  <genericsetup:registerProfile
      name="uninstall"
      title="senaite.pfas (uninstall)"
      directory="profiles/uninstall"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_uninstall"
  />

  <!-- Custom content types defined by this add-on -->
  <include file="content.zcml" />

</configure>
