<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="senaite.pfas">

  <includeDependencies package="." />
  <include package=".browser" />

  <!-- PFAS impress report templates (D65): registers templates/reports/ as a
       senaite.impress.reports resource directory so the PFAS Certificate of
       Analysis appears in the impress template picker as
       "senaite.pfas:CertificateOfAnalysis.pt". Mirrors senaite.impress's own
       report-dir registration; no core fork (§6C). -->
  <plone:static
      name="senaite.pfas"
      directory="templates/reports"
      type="senaite.impress.reports"
      />

  <!-- GenericSetup profile that installs analytes, methods, sample types,
       containers, storage locations, and custom content types -->
  <genericsetup:registerProfile
      name="default"
      title="senaite.pfas"
      description="PFAS LIMS extension: analyte library + method profiles +
                   reagent tracking + run-queue QC + extraction reporting."
      directory="profiles/default"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_install"
  />

  <genericsetup:registerProfile
      name="uninstall"
      title="senaite.pfas (uninstall)"
      directory="profiles/uninstall"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_uninstall"
  />

  <!-- Custom content types defined by this add-on -->
  <include file="content.zcml" />

  <!-- Archetypes schema extenders (ReferenceDefinition PFAS QC fields) -->
  <include package=".extenders" />

  <!-- Reverse sync: editing a spec_sync-managed AnalysisSpec writes per-analyte
       overrides back into the owning Method Profile (write-through; profile
       stays the single source of truth). Loop-guarded in spec_reverse. -->
  <subscriber
      for="bika.lims.interfaces.IAnalysisSpec
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".spec_reverse.on_spec_modified"
      />

</configure>
