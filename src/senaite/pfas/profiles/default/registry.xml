<?xml version="1.0"?>
<registry>
  <!-- the sample's analyses open folded to one line (core_sample.py) -->
  <records interface="senaite.core.registry.schema.ISampleViewRegistry">
    <value key="sampleview_collapse_lab_analysis_table">True</value>
  </records>
  <!-- D65: make the controlled PFAS Certificate of Analysis the default
       impress report template (record is owned by senaite.impress; we only
       set its value). Single-per-sample so each sample gets its own
       controlled certificate with its own report ID / revision. -->
  <record name="senaite.impress.default_template">
    <value>senaite.pfas:CertificateOfAnalysis.pt</value>
  </record>
  <!-- The publisher offers only the PFAS templates: a certificate is printed
       only from the lab's issued certificate layout (the storage refuses a
       sample's report in any other template too). The list is replaced on
       every run of the install step. -->
  <record name="senaite.impress.templates">
    <value purge="true">
      <element>senaite.pfas:CertificateOfAnalysis.pt</element>
      <element>senaite.pfas:QCReviewReport.pt</element>
    </value>
  </record>
</registry>
