<?xml version="1.0"?>
<object name="EGADConfig" meta_type="Dexterity FTI">
  <property name="title">EGAD Config</property>
  <property name="description">Singleton EGAD configuration (six JSON blob sections for lab, method, analyte CAS, qualifier, QC type, and lookup tables)</property>
  <property name="icon_expr">string:${portal_url}/senaite_theme/icon/lab</property>
  <property name="factory">EGADConfig</property>
  <property name="add_view_expr">string:${folder_url}/++add++EGADConfig</property>
  <property name="schema">senaite.pfas.content.egad_config.IEGADConfig</property>
  <property name="klass">senaite.pfas.content.egad_config.EGADConfig</property>
  <property name="behaviors">
    <element value="plone.dublincore"/>
    <element value="plone.namefromtitle"/>
    <element value="plone.app.referenceablebehavior.referenceable.IReferenceable"/>
    <element value="bika.lims.interfaces.IMultiCatalogBehavior"/>
  </property>
  <property name="global_allow">True</property>
  <property name="filter_content_types">False</property>
</object>
