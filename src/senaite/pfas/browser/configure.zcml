<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:browser="http://namespaces.zope.org/browser"
           i18n_domain="senaite.pfas">

  <!-- Static JS/CSS resources served via ++resource++senaite.pfas/<file> -->
  <browser:resourceDirectory
      name="senaite.pfas"
      directory="static"
      />

  <!-- @@lims-setup override on ISenaitePFASLayer (more specific than ISenaiteCore,
       so Zope prefers our view over senaite.core's without any conflict). -->
  <include file="overrides.zcml" />

  <!-- Core UI overlay: inject pfas-core-overlay.css into the <head> of every
       core SENAITE page (PFAS-layer requests only).  Pure CSS overlay — restyles
       senaite.app.listing tables/buttons/alerts into the PFAS palette and adds
       the mobile table-scroll fix.  Upgrade-safe: no core template forked.
       See DECISIONS.md (core UI unification) and static/pfas-core-overlay.css. -->
  <browser:viewlet
      name="senaite.pfas.core-overlay-css"
      for="*"
      manager="plone.app.layout.viewlets.interfaces.IHtmlHead"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      template="templates/core_overlay_link.pt"
      permission="zope2.Public"
      />

  <!-- Reverse bridge add-in: on a core Method view, link to its PFAS profile
       (QC ranges). Upgrade-safe viewlet on the PFAS layer — no core fork. -->
  <browser:viewlet
      name="senaite.pfas.method-profile-link"
      for="bika.lims.interfaces.IMethod"
      manager="plone.app.layout.viewlets.interfaces.IAboveContentBody"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      class=".method_viewlet.PFASMethodProfileViewlet"
      permission="zope2.View"
      />

  <!-- LC-MS Run Builder — extraction form → instrument worklist → re-import -->
  <browser:page
      name="pfas-run-builder"
      for="*"
      class=".run_builder.PFASRunBuilderView"
      permission="zope2.View"
      />

  <!-- Print settings — site-wide print header/footer template (Configuration) -->
  <browser:page
      name="pfas-print-settings"
      for="*"
      class=".print_settings.PFASPrintSettingsView"
      permission="senaite.core.permissions.ManageBika"
      />

  <!-- Interactive system map — clickable architecture diagram under Configuration -->
  <browser:page
      name="pfas-system-map"
      for="*"
      class=".system_map.PFASSystemMapView"
      permission="zope2.View"
      />

  <!-- Shared METAL macro provider — access via context/@@pfas-macros/macros/page -->
  <browser:page
      name="pfas-macros"
      for="*"
      class=".pfas_macros.PFASMacrosView"
      permission="zope2.Public"
      />

  <!-- Unified accordion sidebar — used by PFASSidebarManager (core pages)
       and called directly from pfas_macros.pt (PFAS workspace pages). -->
  <browser:page
      name="pfas-sidebar"
      for="*"
      class=".sidebar.PFASSidebarView"
      permission="zope2.View"
      />

  <!-- PFAS dashboard tiles viewlet — REMOVED (Round 6).
       PFAS tools are now integrated directly into @@lims-setup groups via
       VirtualTile entries in lims_setup.py SETUP_GROUPS.  The dark bottom
       panel rendered twice on the Setup page and has been retired. -->
  <!--
  <browser:viewlet
      name="senaite.pfas.dashboard.tiles"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      manager="plone.app.layout.viewlets.interfaces.IBelowContent"
      class=".pfas_nav.PFASDashboardTilesViewlet"
      permission="zope2.View"
      />
  -->

  <!-- PFAS Stage sub-tab on Worksheet -->
  <browser:page
      name="pfas-ws-stage"
      for="bika.lims.interfaces.IWorksheet"
      class=".pfas_nav.PFASWorksheetStageTabView"
      permission="zope2.View"
      />

  <!-- PFAS Tracker sub-tab on AnalysisRequest (Sample) -->
  <browser:page
      name="pfas-ar-tracker"
      for="bika.lims.interfaces.IAnalysisRequest"
      class=".pfas_nav.PFASARTrackerTabView"
      permission="zope2.View"
      />
  <!-- PFAS QC Control Chart — Levey-Jennings + Westgard multi-rules -->
  <browser:page
      name="pfas-control-chart"
      for="*"
      class=".controlchart.PFASControlChartView"
      permission="zope2.View"
      />

  <!-- PFAS QC Rules Editor — Manager only -->
  <browser:page
      name="pfas-qc-rules"
      for="*"
      class=".qcrules.PFASQCRulesView"
      permission="zope2.View"
      />

  <!-- PFAS Calibration Review — secondary sign-off for calibration curves -->
  <browser:page
      name="pfas-calibrations"
      for="*"
      class=".calibrations.PFASCalibrationsView"
      permission="zope2.View"
      />

  <!-- PFAS Reference Definition Setup — creates/updates SENAITE ReferenceDefinitions -->
  <browser:page
      name="pfas-setup-references"
      for="*"
      class=".setuprefs.PFASSetupRefsView"
      permission="zope2.View"
      />

  <!-- PFAS Guided New-Method Wizard -->
  <browser:page
      name="pfas-method-wizard"
      for="*"
      class=".method_wizard.PFASMethodWizardView"
      permission="senaite.core.permissions.ManageBika"
      />

  <!-- PFAS QC Type Grid — method × QC type toggle matrix -->
  <browser:page
      name="pfas-qc-type-grid"
      for="*"
      class=".qc_grid.PFASQCTypeGridView"
      template="templates/qc_grid.pt"
      permission="senaite.core.permissions.ManageBika"
      />

  <!-- PFAS Method Profile list — Manager/LabManager only -->
  <browser:page
      name="pfas-method-profiles"
      for="*"
      class=".method_profiles.PFASMethodProfilesView"
      permission="zope2.View"
      />

  <!-- PFAS Method Profile editor — Manager/LabManager only -->
  <browser:page
      name="pfas-method-profile-edit"
      for="*"
      class=".method_profiles.PFASMethodProfileEditView"
      permission="zope2.View"
      />

  <!-- PFAS Data Review — analyst checklist for batch release sign-off -->
  <browser:page
      name="pfas-data-review"
      for="*"
      class=".data_review.PFASDataReviewView"
      permission="zope2.View"
      />

  <!-- Controlled CoA attestation (D65 A2): renders the 3-tier authorization
       block (prepared/verified/authorized) from the live workflow actors.
       Called from the PFAS Certificate of Analysis impress template. -->
  <browser:page
      name="pfas-coa-attestation"
      for="*"
      class=".coa_attestation.PFASCoAAttestationView"
      permission="zope2.View"
      />

  <!-- Controlled Publications register (D65 B): auditor-facing, read-only,
       cross-client → manager/QAO permission (not client-accessible). -->
  <browser:page
      name="pfas-controlled-publications"
      for="*"
      class=".controlled_publications.PFASControlledPublicationsView"
      permission="senaite.core.permissions.ManageBika"
      />

  <!-- PFAS Analyst Batch Status — five-stage tracker driven from WS workflow -->
  <browser:page
      name="pfas-sample-status"
      for="*"
      class=".sample_status.PFASSampleStatusView"
      permission="zope2.View"
      />

  <!-- PFAS Client Tracker — public no-login sample status page -->
  <browser:page
      name="pfas-track"
      for="*"
      class=".tracker.PFASClientTrackerView"
      permission="zope2.Public"
      />

  <!-- PFAS Sample Receipt — internal printable receipt with QR code -->
  <browser:page
      name="pfas-receipt"
      for="*"
      class=".receipt.PFASReceiptView"
      permission="zope2.View"
      />

  <!-- Assign tracking number when a sample is received -->
  <subscriber
      for="* Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".tracking.on_after_transition"
      />

  <!-- Guided Extraction Interface — stage-by-stage tablet workflow -->
  <browser:page
      name="pfas-extraction-guide"
      for="*"
      class=".extraction_guide.PFASExtractionGuideView"
      permission="zope2.View"
      />

  <!-- Extraction Logbook PDF (ReportLab) -->
  <browser:page
      name="pfas-extraction-pdf"
      for="*"
      class=".extraction_pdf.PFASExtractionPDFView"
      permission="zope2.View"
      />

  <!-- Reagent / Solution Label Printer -->
  <browser:page
      name="pfas-label"
      for="*"
      class=".label_print.PFASLabelPrintView"
      permission="zope2.View"
      />

  <!-- PFAS Reagent Inventory (ISO 17025 / MLAB lot tracking) -->
  <browser:page
      name="pfas-reagents"
      for="*"
      class=".reagents.PFASReagentsView"
      permission="zope2.View"
      />

  <!-- Guided Instrument Import & Mapping Studio -->
  <browser:page
      name="pfas-import-studio"
      for="*"
      class=".import_studio.PFASImportStudioView"
      permission="zope2.View"
      />

  <!-- Import Studio profile REST bridge — used by pfas_pipeline importer
       to fetch a saved column-mapping profile by vendor_key + version.
       Returns JSON {map, vendor, ...} or {error: "..."} if not saved yet. -->
  <browser:page
      name="pfas-instrument-profile"
      for="*"
      class=".import_studio.PFASInstrumentProfileView"
      permission="zope2.View"
      />

  <!-- Maine EGAD EDD configuration panel (lab-global, method, analyte CAS, qualifiers) -->
  <browser:page
      name="pfas-egad-config"
      for="*"
      class=".egad_config.PFASEGADConfigView"
      permission="zope2.View"
      />

  <!-- Per-client EGAD toggle and project/site settings -->
  <browser:page
      name="pfas-egad-client-config"
      for="*"
      class=".egad_config.PFASEGADClientConfigView"
      permission="zope2.View"
      />

  <!-- EDD CSV export/download for a batch -->
  <browser:page
      name="pfas-egad-export"
      for="*"
      class=".egad_config.PFASEGADExportView"
      permission="zope2.View"
      />

  <!-- Batch EDD dashboard and per-sample EGAD SAMPLE_TYPE override editor -->
  <browser:page
      name="pfas-egad-batches"
      for="*"
      class=".egad_config.PFASEGADBatchesView"
      permission="zope2.View"
      />

  <!-- Generate EGAD EDD and email client when government-agency AR is published -->
  <subscriber
      for="* Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".egad_publish.on_after_transition"
      />

  <!-- Controlled publication register (D65 B): record an immutable issuance
       entry on the sample each time a CoA is published (publish transition). -->
  <subscriber
      for="* Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".controlled_publications.on_after_transition"
      />

  <!-- Role-aware workspace launcher — redirects to the user's default workspace -->
  <browser:page
      name="pfas-home"
      for="*"
      class=".workspace_home.PFASWorkspaceHomeView"
      permission="zope2.View"
      />

  <!-- QC Management workspace landing page (LabManager/QAO default) -->
  <browser:page
      name="pfas-qc-management"
      for="*"
      class=".workspace_home.PFASQCManagementView"
      permission="zope2.View"
      />

  <!-- Logbook definition manager (portal-level) -->
  <browser:page
      name="pfas-logbook-admin"
      for="*"
      class=".logbooks.PFASLogbookAdminView"
      permission="zope2.View"
      />

  <!-- Generic custom logbook renderer (batch-level) -->
  <browser:page
      name="pfas-logbook-custom"
      for="*"
      class=".logbooks.PFASLogbookCustomView"
      permission="zope2.View"
      />

  <!-- Per-batch logbooks (FM-ENV-250 through 253) — registered on Batch context -->
  <browser:page
      name="pfas-logbook-index"
      for="*"
      class=".logbooks.PFASLogbookIndexView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-logbook-250"
      for="*"
      class=".logbooks.PFASLogbook250View"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-logbook-251"
      for="*"
      class=".logbooks.PFASLogbook251View"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-logbook-252"
      for="*"
      class=".logbooks.PFASLogbook252View"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-logbook-253"
      for="*"
      class=".logbooks.PFASLogbook253View"
      permission="zope2.View"
      />

  <!-- Dynamic logbook renderer (PrepLogbookDef field_schema_json driven) -->
  <browser:page
      name="pfas-logbook-dynamic"
      for="*"
      class=".logbooks.PFASDynamicLogbookView"
      permission="zope2.View"
      />

  <!-- AJAX: Prepared Standard lot autocomplete (lot_ref fields) -->
  <browser:page
      name="pfas-lot-autocomplete"
      for="*"
      class=".logbooks.PFASLotAutocompleteView"
      permission="zope2.View"
      />

  <!-- AJAX: Reagent inventory autocomplete (reagent_ref fields) -->
  <browser:page
      name="pfas-reagent-autocomplete"
      for="*"
      class=".logbooks.PFASReagentAutocompleteView"
      permission="zope2.View"
      />

  <!-- Prep logbook definitions -->
  <browser:page
      name="pfas-prep-logbooks"
      for="*"
      class=".prep_logbooks.PFASPrepLogbooksView"
      permission="zope2.View"
      />

  <!-- Guided-step media (GIF / photo). GET is open so analysts can see the
       image while filling a logbook; POST is manager-gated inside the view. -->
  <browser:page
      name="pfas-logbook-media"
      for="*"
      class=".logbook_media.PFASLogbookMediaView"
      permission="zope2.View"
      />

  <!-- Prepared standards inventory -->
  <browser:page
      name="pfas-prep-standards"
      for="*"
      class=".prepared_standards.PFASPrepStandardsView"
      permission="zope2.View"
      />

  <!-- ── Facility QC (ISO 17025 daily verifications) ──────────────────── -->
  <browser:page
      name="pfas-facility-qc"
      for="*"
      class=".facility_qc.PFASFacilityDashboardView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-facility-units"
      for="*"
      class=".facility_qc.PFASFacilityUnitsView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-temperature-log"
      for="*"
      class=".facility_qc.PFASTemperatureLogView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-balance-log"
      for="*"
      class=".facility_qc.PFASBalanceLogView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-water-log"
      for="*"
      class=".facility_qc.PFASWaterLogView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-waste-log"
      for="*"
      class=".facility_qc.PFASWasteLogView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-eyewash-log"
      for="*"
      class=".facility_qc.PFASEyeWashLogView"
      permission="zope2.View"
      />
  <!-- Unauthenticated RPi ingest endpoint — API key validated in the view -->
  <browser:page
      name="pfas-sensor-ingest"
      for="*"
      class=".facility_qc.PFASSensorIngestView"
      permission="zope2.Public"
      />

  <!-- SOP Document Management — revision control, sign-off, PDF viewer -->
  <browser:page
      name="pfas-sop"
      for="*"
      class=".sop_documents.PFASSOPView"
      template="templates/sop_documents.pt"
      permission="zope2.View"
      />

  <!-- Deviation & CAR non-conformance management -->
  <browser:page
      name="pfas-deviations"
      for="*"
      class=".deviations.PFASDeviationView"
      template="templates/deviations.pt"
      permission="zope2.View"
      />

</configure>
