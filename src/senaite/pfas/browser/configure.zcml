<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:browser="http://namespaces.zope.org/browser"
           i18n_domain="senaite.pfas">

  <!-- Static JS/CSS resources served via ++resource++senaite.pfas/<file> -->
  <browser:resourceDirectory
      name="senaite.pfas"
      directory="static"
      />

  <!-- @@lims-setup override on ISenaitePFASLayer (more specific than ISenaiteCore,
       so Zope prefers our view over senaite.core's without any conflict). -->
  <include file="overrides.zcml" />

  <!-- Core UI overlay: inject pfas-core-overlay.css into the <head> of every
       core SENAITE page (PFAS-layer requests only).  Pure CSS overlay — restyles
       senaite.app.listing tables/buttons/alerts into the PFAS palette and adds
       the mobile table-scroll fix.  Upgrade-safe: no core template forked. and static/pfas-core-overlay.css. -->
  <browser:viewlet
      name="senaite.pfas.core-overlay-css"
      for="*"
      manager="plone.app.layout.viewlets.interfaces.IHtmlHead"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      template="templates/core_overlay_link.pt"
      permission="zope2.Public"
      />

  <!-- Reverse bridge add-in: on a core Method view, link to its PFAS profile
       (QC ranges). Upgrade-safe viewlet on the PFAS layer — no core fork. -->
  <browser:viewlet
      name="senaite.pfas.method-profile-link"
      for="bika.lims.interfaces.IMethod"
      manager="plone.app.layout.viewlets.interfaces.IAboveContentBody"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      class=".method_viewlet.PFASMethodProfileViewlet"
      permission="zope2.View"
      />

  <!-- Batch -> Project assignment: the missing link that turns a Project
       (created at @@pfas-projects) into a live QAPP override for a batch's
       resolved QC criteria. Shows the batch's current Project + QAPP (or
       states plainly that none is assigned); a manager may assign/clear via
       project_ref.set_project_uid(), which is what triggers the resolved-
       criteria export. Upgrade-safe viewlet on the PFAS layer, mirroring
       senaite.pfas.method-profile-link above — no core fork. -->
  <browser:viewlet
      name="senaite.pfas.batch-project-link"
      for="bika.lims.interfaces.IBatch"
      manager="plone.app.layout.viewlets.interfaces.IAboveContentBody"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      class=".batch_project_viewlet.PFASBatchProjectViewlet"
      permission="zope2.View"
      />

  <!-- POST-only action target for the viewlet's assign/clear form. -->
  <browser:page
      name="pfas-batch-project-assign"
      for="bika.lims.interfaces.IBatch"
      class=".batch_project_viewlet.PFASBatchProjectAssignView"
      permission="zope2.View"
      />

  <!-- LC-MS Run Builder — extraction form → instrument worklist → re-import -->
  <browser:page
      name="pfas-run-builder"
      for="*"
      class=".run_builder.PFASRunBuilderView"
      permission="zope2.View"
      />

  <!-- Lab Settings console — every setting the lab owns, enumerated from
       settings_registry. Viewing needs ManageBika. -->
  <browser:page
      name="pfas-lab-settings"
      for="*"
      class=".lab_settings.PFASLabSettingsView"
      permission="senaite.core.permissions.ManageBika"
      />

  <!-- Print settings — site-wide print header/footer template (Configuration) -->
  <browser:page
      name="pfas-print-settings"
      for="*"
      class=".print_settings.PFASPrintSettingsView"
      permission="senaite.core.permissions.ManageBika"
      />

  <!-- QC qualifiers: what a certificate says when a QC criterion fails
       (Reporting Setup, after Print Settings) -->
  <browser:page
      name="pfas-qc-qualifiers"
      for="*"
      class=".print_settings.PFASQCQualifiersView"
      permission="senaite.core.permissions.ManageBika"
      />

  <!-- Report tiers: the catalogue of what a report package holds
       (Reporting Setup, after QC Qualifiers) -->
  <browser:page
      name="pfas-report-tiers"
      for="*"
      class=".report_tiers_view.PFASReportTiersView"
      permission="senaite.core.permissions.ManageBika"
      />

  <!-- System map: the lab's live model as a tree (d3), one level per request -->
  <browser:page
      name="pfas-system-map"
      for="*"
      class=".system_map.PFASSystemMapView"
      permission="zope2.View"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />
  <browser:page
      name="pfas-system-map-data"
      for="*"
      class=".system_map.PFASSystemMapDataView"
      permission="zope2.View"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />

  <!-- The sign dialog every signed step opens: context/@@pfas-esig-macros/macros/sign_dialog -->
  <browser:page
      name="pfas-esig-macros"
      for="*"
      class=".esig_views.PFASSignatureMacros"
      permission="zope2.View"
      />

  <!-- A table row's menu, written once per row: context/@@pfas-row-menu/actions -->
  <browser:page
      name="pfas-row-menu"
      for="*"
      class=".row_menu.PFASRowMenu"
      permission="zope2.Public"
      />

  <!-- Every other icon, from the one helper (icons.py): context/@@pfas-icons/svg -->
  <browser:page
      name="pfas-icons"
      for="*"
      class=".icons_view.PFASIcons"
      permission="zope2.Public"
      />

  <!-- A sample type's icon, the same on every page: context/@@pfas-type-icons/svg -->
  <browser:page
      name="pfas-type-icons"
      for="*"
      class=".type_icons.PFASTypeIcons"
      permission="zope2.Public"
      />

  <!-- Shared METAL macro provider — access via context/@@pfas-macros/macros/page -->
  <browser:page
      name="pfas-macros"
      for="*"
      class=".pfas_macros.PFASMacrosView"
      permission="zope2.Public"
      />

  <!-- Record field widget macro — the guided extraction's stage questions
       via context/@@pfas-record-macros/macros/logbook_field -->
  <browser:page
      name="pfas-record-macros"
      for="*"
      class=".record_macros.PFASRecordMacrosView"
      permission="zope2.Public"
      />

  <!-- Declared configuration section macro (config_forms.py, R2) —
       context/@@pfas-config-form-macros/macros/section -->
  <browser:page
      name="pfas-config-form-macros"
      for="*"
      class=".config_form_macros.PFASConfigFormMacrosView"
      permission="zope2.Public"
      />

  <!-- The method profile's grid macro (profile_grids.py) —
       context/@@pfas-grid-macros/macros/sheet -->
  <browser:page
      name="pfas-grid-macros"
      for="*"
      class=".grid_macros.PFASGridMacrosView"
      permission="zope2.View"
      />

  <!-- The one top toolbar macro: context/@@pfas-topbar/macros/topbar,
       filled by pfas_macros.pt and by PFASToolbarManager on core pages. -->
  <browser:page
      name="pfas-topbar"
      for="*"
      class=".topbar.PFASTopbarView"
      permission="zope2.Public"
      />

  <!-- Unified accordion sidebar — used by PFASSidebarManager (core pages)
       and called directly from pfas_macros.pt (PFAS workspace pages). -->
  <browser:page
      name="pfas-sidebar"
      for="*"
      class=".sidebar.PFASSidebarView"
      permission="zope2.View"
      />

  <!-- Per-user sidebar pins (Windows-Explorer-style, under Dashboard).
       POST path + pinned + _authenticator; stored per user on the portal. -->
  <browser:page
      name="pfas-sidebar-pins"
      for="*"
      class=".sidebar_pins.PFASSidebarPinsView"
      permission="zope2.View"
      />

  <!-- The signed-in person's pages from the navigation map, as JSON, for the
       audit tools (tools/nav_pages.py). GET only; staff only by the client
       wall (perms.keep_clients_out). -->
  <browser:page
      name="pfas-nav-pages"
      for="*"
      class=".sidebar.PFASNavPagesView"
      permission="zope2.View"
      />

  <!-- PFAS Stage sub-tab on Worksheet -->
  <browser:page
      name="pfas-ws-stage"
      for="bika.lims.interfaces.IWorksheet"
      class=".pfas_nav.PFASWorksheetStageTabView"
      permission="zope2.View"
      />

  <!-- The extraction batch (the worksheet): samples, QC, parents -->
  <browser:page
      name="pfas-extraction-batch"
      for="bika.lims.interfaces.IWorksheet"
      class=".extraction_batch_view.PFASExtractionBatchView"
      permission="zope2.View"
      />
  <!-- A finalised extraction record corrected: amend, undo, confirm, send
       back, re-extract (POST only; back to the batch record or Data Review) -->
  <browser:page
      name="pfas-extraction-corrections"
      for="bika.lims.interfaces.IWorksheet"
      class=".extraction_corrections.PFASExtractionCorrectionsView"
      permission="zope2.View"
      />
  <!-- A worksheet's method and matrix, and the received samples of both,
       added through core (core's EditWorksheet, as its add_analyses) -->
  <browser:page
      name="pfas-worksheet-samples"
      for="bika.lims.interfaces.IWorksheet"
      class=".worksheet_samples.PFASWorksheetSamplesView"
      permission="senaite.core.permissions.EditWorksheet"
      />
  <!-- a Help figure's screenshot, captured at the release -->
  <browser:page
      name="pfas-help-figure"
      for="*"
      class=".help.PFASHelpFigureView"
      permission="zope2.View"
      />
  <!-- the top bar's notifications bell (JSON) -->
  <browser:page
      name="pfas-bell"
      for="*"
      class=".bell_view.PFASBellView"
      permission="zope2.View"
      />
  <!-- Configuration: a sample type's sub-types -->
  <browser:page
      name="pfas-sample-subtypes"
      for="*"
      class=".sample_subtypes_view.PFASSampleSubtypesView"
      permission="zope2.View"
      />
  <!-- a prep sitting's labels, one per lot made -->
  <browser:page
      name="pfas-sitting-labels"
      for="*"
      class=".label_print.PFASSittingLabelsView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-extraction-labels"
      for="bika.lims.interfaces.IWorksheet"
      class=".extraction_batch_view.PFASExtractionLabelsView"
      permission="zope2.View"
      />

  <!-- PFAS Tracker sub-tab on AnalysisRequest (Sample) -->
  <browser:page
      name="pfas-ar-tracker"
      for="bika.lims.interfaces.IAnalysisRequest"
      class=".pfas_nav.PFASARTrackerTabView"
      permission="zope2.View"
      />
  <!-- PFAS QC Control Chart — Levey-Jennings + Westgard multi-rules -->
  <browser:page
      name="pfas-control-chart"
      for="*"
      class=".controlchart.PFASControlChartView"
      permission="zope2.View"
      />

  <!-- PFAS Calibration Review — secondary sign-off for calibration curves -->
  <browser:page
      name="pfas-calibrations"
      for="*"
      class=".calibrations.PFASCalibrationsView"
      permission="zope2.View"
      />

  <!-- PFAS Reference Definition Setup — creates/updates SENAITE ReferenceDefinitions -->
  <browser:page
      name="pfas-setup-references"
      for="*"
      class=".setuprefs.PFASSetupRefsView"
      permission="zope2.View"
      />

  <!-- PFAS Guided New-Method Wizard -->
  <browser:page
      name="pfas-method-wizard"
      for="*"
      class=".method_wizard.PFASMethodWizardView"
      permission="senaite.core.permissions.ManageBika"
      />

  <!-- PFAS Method Profile list — Manager/LabManager only -->
  <browser:page
      name="pfas-method-profiles"
      for="*"
      class=".method_profiles.PFASMethodProfilesView"
      permission="zope2.View"
      />

  <!-- PFAS Method Profile editor — Manager/LabManager only -->
  <browser:page
      name="pfas-method-profile-edit"
      for="*"
      class=".method_profiles.PFASMethodProfileEditView"
      permission="zope2.View"
      />

  <!-- QC Review Report — the reviewer/auditor counterpart to the client CoA.
       Same permission as Data Review: it shows the same information that
       screen already shows, to the same people. -->
  <browser:page
      name="pfas-qc-review-report"
      for="*"
      class=".qc_review_report.PFASQCReviewReportView"
      permission="zope2.View"
      />

  <!-- PFAS Data Review — analyst checklist for batch release sign-off -->
  <browser:page
      name="pfas-data-review"
      for="*"
      class=".data_review.PFASDataReviewView"
      permission="zope2.View"
      />

  <!-- the analyst's route to a compound's expected retention time, from
       the Raw Data card (POST; analyst or manager, review open) -->
  <browser:page
      name="pfas-set-expected-rt"
      for="*"
      class=".expected_rt.PFASSetExpectedRTView"
      permission="zope2.View"
      />

  <!-- Configuration change history (R1): who changed which setting, when,
       before and after. Viewing needs ManageBika (like Lab Settings): it shows
       every client's EDD settings. Revert is gated at TIER_CONFIG. -->
  <browser:page
      name="pfas-config-history"
      for="*"
      class=".config_history_view.PFASConfigHistoryView"
      permission="senaite.core.permissions.ManageBika"
      />

  <!-- The signature ledger for Managers: filters, the chain check, the CSV
       export, orphans, withdrawal and the seal worker's health. Viewing
       needs ManageBika and the Manager role (perms.MANAGER_VIEWS); the
       chain check is gated at TIER_CONFIG, a withdrawal to the signer or a
       Manager. -->
  <browser:page
      name="pfas-signatures"
      for="*"
      class=".signatures_page.PFASSignaturesView"
      permission="senaite.core.permissions.ManageBika"
      />

  <!-- A signer withdraws their own signature from the record's Signatures
       card (the Signatures page is the Manager's): POST only, the signer
       or a Manager, with a reason and their password or PIN -->
  <browser:page
      name="pfas-signature-withdraw"
      for="*"
      class=".signatures_page.PFASSignatureWithdrawView"
      permission="zope2.View"
      />

  <!-- The system's backups and a method's restore from one -->
  <browser:page
      name="pfas-backups"
      for="*"
      class=".backups.PFASBackupsView"
      permission="zope2.View"
      />

  <!-- The laboratory's identity over core's Laboratory record -->
  <browser:page
      name="pfas-laboratory"
      for="*"
      class=".laboratory.PFASLaboratoryView"
      permission="zope2.View"
      />

  <!-- The old Site Settings address: bookmarks arrive at the Laboratory -->
  <browser:page
      name="pfas-site-settings"
      for="*"
      class=".site_settings.PFASSiteSettingsRedirect"
      permission="zope2.View"
      />

  <!-- Site language and the laboratory time zone -->
  <browser:page
      name="pfas-time-language"
      for="*"
      class=".time_language.PFASTimeLanguageView"
      permission="zope2.View"
      />

  <!-- Notifications, the raw-data share and the Site Administrator's shortcuts -->
  <browser:page
      name="pfas-system"
      for="*"
      class=".system_settings.PFASSystemView"
      permission="zope2.View"
      />

  <!-- The issued DESIGNED certificate replaces impress's PDF when stored
       (overrides senaite.impress's IPdfReportStorage on our layer). -->
  <adapter
      for="zope.interface.Interface
           senaite.pfas.interfaces.ISenaitePFASLayer"
      factory=".coa_storage.PFASPdfReportStorage"
      provides="senaite.impress.interfaces.IPdfReportStorage"
      permission="zope2.View"
      />

  <!-- People & Roles; the old address redirects to it; each
       person's profile & signature -->
  <browser:page
      name="pfas-people"
      for="*"
      class=".people.PFASPeopleView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-lab-staff"
      for="*"
      class=".people.PFASLabStaffRedirect"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-my-profile"
      for="*"
      class=".lab_staff.PFASMyProfileView"
      permission="zope2.View"
      />

  <!-- The site icon on core pages: overrides senaite.core's
       plone.links.favicon on the PFAS layer -->
  <browser:viewlet
      name="plone.links.favicon"
      manager="plone.app.layout.viewlets.interfaces.IHtmlHead"
      class=".pfas_macros.PFASFaviconViewlet"
      permission="zope2.View"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />

  <!-- The sign-in page: overrides core's login view on the PFAS
       layer (same "for" as senaite.core.browser.login); the form is Plone's -->
  <browser:page
      name="login"
      for="plone.app.layout.navigation.interfaces.INavigationRoot"
      permission="zope.Public"
      class=".login.PFASLoginForm"
      template="templates/login.pt"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />
  <browser:page
      name="login_form"
      for="plone.app.layout.navigation.interfaces.INavigationRoot"
      permission="zope.Public"
      class=".login.PFASLoginForm"
      template="templates/login.pt"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />

  <!-- Badges at registered lab terminals (part C) -->
  <browser:page
      name="pfas-terminals"
      for="*"
      class=".badges.PFASTerminalsView"
      permission="zope2.View"
      />
  <!-- reached signed out: the view itself refuses anything but a registered
       terminal (badges.py) -->
  <browser:page
      name="pfas-badge-signin"
      for="*"
      class=".badges.PFASBadgeSigninView"
      permission="zope2.Public"
      />
  <!-- core Specifications / Dynamic Specifications / Calculations are retired:
       any request into them goes to Method Profiles (retired_core.py) -->
  <subscriber
      for="ZPublisher.interfaces.IPubAfterTraversal"
      handler=".retired_core.redirect_retired"
      />
  <!-- the PFAS instrument data interfaces in core's per-instrument lists
       (core_instrument.py): core's import / export screens go through the
       pipeline -->
  <adapter
      for="*"
      factory=".core_instrument.PFASPipelineImport"
      provides="senaite.core.exportimport.instruments.IInstrumentImportInterface"
      name="pfas-pipeline-import"
      />
  <adapter
      for="*"
      factory=".core_instrument.PFASSequenceExport"
      provides="senaite.core.exportimport.instruments.IInstrumentExportInterface"
      name="pfas-sequence-export"
      />
  <!-- clients are refused every PFAS staff page (perms.keep_clients_out) -->
  <subscriber
      for="ZPublisher.interfaces.IPubAfterTraversal"
      handler=".perms.keep_clients_out"
      />
  <!-- the terminal's 10-minute idle sign-out, enforced on every request -->
  <subscriber
      for="ZPublisher.interfaces.IPubAfterTraversal"
      handler=".badges.enforce_terminal_idle"
      />

  <!-- Document Templates: the lab draws its documents with pdfme -->
  <browser:page
      name="pfas-document-templates"
      for="*"
      class=".document_templates.PFASDocumentTemplatesView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-document-designer"
      for="*"
      class=".document_templates.PFASDocumentDesignerView"
      permission="zope2.View"
      />

  <!-- One search for the whole site: the top bar's box -->
  <browser:page
      name="pfas-search"
      for="*"
      class=".site_search.PFASSiteSearchView"
      permission="zope2.View"
      />

  <!-- Manual integration review -->
  <browser:page
      name="pfas-manual-integration"
      for="bika.lims.interfaces.IWorksheet"
      class=".manual_integration_view.PFASManualIntegrationView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-mi-report"
      for="bika.lims.interfaces.IWorksheet"
      class=".manual_integration_view.PFASMIReportView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-mi-reasons"
      for="*"
      class=".manual_integration_view.PFASMIReasonsView"
      permission="zope2.View"
      />

  <!-- The central Help dictionary -->
  <browser:page
      name="pfas-help"
      for="*"
      class=".help.PFASHelpView"
      permission="zope2.View"
      />

  <!-- Regulatory limits (MCLs / action levels) + state program links for the
       certificate's regulatory notes. Save gated at TIER_CONFIG. -->
  <browser:page
      name="pfas-regulatory-limits"
      for="*"
      class=".regulatory_limits_view.PFASRegulatoryLimitsView"
      permission="zope2.View"
      />

  <!-- Compact CoA sections (header / samples / footer), replacing core
       impress's header, info, summary, results, discreeter and footer on the
       PFAS certificate. -->
  <browser:page
      name="pfas-coa-sections"
      for="*"
      class=".coa_sections.PFASCoASectionsView"
      permission="zope2.View"
      />

  <!-- Controlled CoA attestation (D65 A2): renders the 3-tier authorization
       block (prepared/verified/authorized) from the live workflow actors.
       Called from the PFAS Certificate of Analysis impress template. -->
  <browser:page
      name="pfas-coa-attestation"
      for="*"
      class=".coa_attestation.PFASCoAAttestationView"
      permission="zope2.View"
      />

  <!-- Controlled Publications register (D65 B): auditor-facing, read-only,
       cross-client → manager/QAO permission (not client-accessible). -->
  <browser:page
      name="pfas-controlled-publications"
      for="*"
      class=".controlled_publications.PFASControlledPublicationsView"
      permission="senaite.core.permissions.ManageBika"
      />

  <!-- The worker, after the site starts, asks it to work out every open
       worksheet's method once, so no person waits for it -->
  <browser:page
      name="pfas-warm"
      for="*"
      class=".warm.PFASWarmView"
      permission="senaite.pfas.WorkerTasks"
      />
  <!-- The worker asks the site to send the notices that are due -->
  <browser:page
      name="pfas-notice-reminders"
      for="*"
      class=".notices.PFASNoticeRemindersView"
      permission="senaite.pfas.WorkerTasks"
      />
  <!-- The worker, once it has pushed a run, asks for the deviation its
       unset QC criteria call for -->
  <browser:page
      name="pfas-unconfigured-deviation"
      for="*"
      class=".unconfigured_deviation.PFASUnconfiguredDeviationView"
      permission="senaite.pfas.WorkerTasks"
      />
  <!-- The worker applies a display setting to analyses it may edit -->
  <browser:page
      name="pfas-apply-display"
      for="*"
      class="senaite.pfas.analysis_display.PFASApplyDisplayView"
      permission="zope2.View"
      />
  <!-- The worker hands over a dilution's result (appended as a retest at
       Data Review submission) -->
  <browser:page
      name="pfas-dilution-result"
      for="*"
      class=".dilution_retests.PFASDilutionResultView"
      permission="zope2.View"
      />
  <!-- The worker hands over an above-range result's top of the range and
       reading (the certificate prints "> top" with E) -->
  <browser:page
      name="pfas-above-range"
      for="*"
      class=".above_range_view.PFASAboveRangeView"
      permission="zope2.View"
      />
  <!-- The package worker reads a report's preconditions and its parts
       (refused inside the view without Manage Bika on the portal) -->
  <browser:page
      name="pfas-package-source"
      for="*"
      class=".report_packages_view.PFASPackageSourceView"
      permission="zope2.View"
      />

  <!-- The package worker hands a report's package back, built or failed
       (refused inside the view without Manage Bika on the portal) -->
  <browser:page
      name="pfas-package-done"
      for="*"
      class=".report_packages_view.PFASPackageDoneView"
      permission="zope2.View"
      />

  <!-- The signing worker fetches a certificate stored with no package, to
       seal it (refused inside the view without Manage Bika on the portal) -->
  <browser:page
      name="pfas-seal-source"
      for="*"
      class=".report_packages_view.PFASSealSourceView"
      permission="zope2.View"
      />

  <!-- The signing worker hands a certificate's seal back, sealed or failed
       (refused inside the view without Manage Bika on the portal) -->
  <browser:page
      name="pfas-seal-done"
      for="*"
      class=".report_packages_view.PFASSealDoneView"
      permission="zope2.View"
      />

  <!-- A Manager queues a report's package again (refused inside the view
       without Manage Bika on the portal) -->
  <browser:page
      name="pfas-package-retry"
      for="*"
      class=".report_packages_view.PFASPackageRetryView"
      permission="zope2.View"
      />

  <!-- A Manager sends an issued certificate's waiting e-mail again
       (refused inside the view without Manage Bika on the portal) -->
  <browser:page
      name="pfas-delivery-send"
      for="*"
      class=".certificate_delivery_view.PFASDeliverySendView"
      permission="zope2.View"
      />

  <!-- A Manager deletes a stored certificate not yet issued (refused inside
       the view without Manage Bika and the Manager role on the portal) -->
  <browser:page
      name="pfas-certificate-delete"
      for="*"
      class=".report_packages_view.PFASCertificateDeleteView"
      permission="zope2.View"
      />

  <!-- A stored certificate's PDF for the register: core's downloaders and
       the read-only inspector (refused inside the view otherwise) -->
  <browser:page
      name="pfas-certificate-pdf"
      for="*"
      class=".certificate_pdf.PFASCertificatePDFView"
      permission="zope2.View"
      />

  <!-- The certificate template as a controlled document (report_templates) -->
  <browser:page
      name="pfas-report-template"
      for="*"
      class=".report_template.PFASReportTemplateView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-report-template-preview"
      for="*"
      class=".report_template.PFASReportTemplatePreviewView"
      permission="zope2.View"
      />

  <!-- method studies: MDL, MRL confirmation, precision / accuracy, DL
        -->
  <browser:page
      name="pfas-method-studies"
      for="*"
      class=".method_studies.PFASMethodStudiesView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-method-study-macros"
      for="*"
      class=".method_studies.PFASMethodStudyMacrosView"
      permission="zope2.View"
      />
  <!-- a blank-matrix lot's assigned levels (matrix_blank.py) -->
  <browser:page
      name="pfas-assigned-levels"
      for="*"
      class=".assigned_levels.PFASAssignedLevelsView"
      permission="zope2.View"
      />
  <!-- the Make dialog of a requested dilution or re-injection, shared by
       Run Builder and the guided extraction (dilution_make.py) -->
  <browser:page
      name="pfas-dilution-make-macros"
      for="*"
      class=".dilution_make.PFASDilutionMakeMacrosView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-blank-history-macros"
      for="*"
      class=".blank_history.PFASBlankHistoryMacrosView"
      permission="zope2.Public"
      />

  <!-- Lot usage + recall search (bench phase 3, inventory_ledger) -->
  <browser:page
      name="pfas-lot-usage"
      for="*"
      class=".lot_usage.PFASLotUsageView"
      permission="zope2.View"
      />

  <!-- PFAS Analyst Batch Status — five-stage tracker driven from WS workflow -->
  <browser:page
      name="pfas-sample-status"
      for="*"
      class=".sample_status.PFASSampleStatusView"
      permission="zope2.View"
      />

  <!-- PFAS Client Tracker — public no-login sample status page -->
  <browser:page
      name="pfas-track"
      for="*"
      class=".tracker.PFASClientTrackerView"
      permission="zope2.Public"
      />

  <!-- PFAS Sample Receipt — internal printable receipt with QR code -->
  <browser:page
      name="pfas-receipt"
      for="*"
      class=".receipt.PFASReceiptView"
      permission="zope2.View"
      />

  <!-- Assign tracking number when a sample is received -->
  <subscriber
      for="* Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".tracking.on_after_transition"
      />

  <!-- Guided Extraction Interface — stage-by-stage tablet workflow -->
  <browser:page
      name="pfas-extraction-guide"
      for="*"
      class=".extraction_guide.PFASExtractionGuideView"
      permission="zope2.View"
      />

  <!-- The batch record, printed from its issued design -->
  <browser:page
      name="pfas-extraction-pdf"
      for="*"
      class=".extraction_pdf.PFASExtractionPDFView"
      permission="zope2.View"
      />

  <!-- A preparation record, printed from its issued design -->
  <browser:page
      name="pfas-preparation-pdf"
      for="*"
      class=".preparation_pdf.PFASPreparationPDFView"
      permission="zope2.View"
      />

  <!-- Reagent / Solution Label Printer -->
  <browser:page
      name="pfas-label"
      for="*"
      class=".label_print.PFASLabelPrintView"
      permission="zope2.View"
      />

  <!-- PFAS Reagent Inventory (ISO 17025 / MLAB lot tracking) -->
  <browser:page
      name="pfas-reagents"
      for="*"
      class=".reagents.PFASReagentsView"
      permission="zope2.View"
      />

  <!-- PFAS Projects (client project carrying a QAPP, linked to batches) -->
  <browser:page
      name="pfas-projects"
      for="*"
      class=".projects.PFASProjectsView"
      permission="zope2.View"
      />

  <!-- Every QC setting and how/where it is applied, as a page and a PDF.
       Manager only, checked in the view (403). -->
  <browser:page
      name="pfas-settings-report"
      for="*"
      class=".settings_report_view.PFASSettingsReportView"
      permission="zope2.View"
      />

  <!-- Logbooks > 4 · Recipes: each method's recipes -->
  <browser:page
      name="pfas-recipes"
      for="*"
      class=".recipes_view.PFASRecipesView"
      permission="zope2.View"
      />

  <!-- A project's differences from its method. Save is
       manager only, checked in the view (403), like the QAPP criteria. -->
  <browser:page
      name="pfas-project-specs"
      for="*"
      class=".project_specs_view.PFASProjectSpecsView"
      permission="zope2.View"
      />

  <!-- Effective QC: one method in one matrix, every check with the level that
       set its limit. Read only. -->
  <browser:page
      name="pfas-effective-qc"
      for="*"
      class=".effective_qc.PFASEffectiveQCView"
      permission="zope2.View"
      />

  <!-- Guided Instrument Import & Mapping Studio -->
  <browser:page
      name="pfas-import-studio"
      for="*"
      class=".import_studio.PFASImportStudioView"
      permission="zope2.View"
      />

  <!-- Import Studio profile REST bridge — used by pfas_pipeline importer
       to fetch a saved column-mapping profile by vendor_key + version.
       Returns JSON {map, vendor, ...} or {error: "..."} if not saved yet. -->
  <browser:page
      name="pfas-instrument-profile"
      for="*"
      class=".import_studio.PFASInstrumentProfileView"
      permission="zope2.View"
      />

  <!-- EDD export: profiles and their settings -->
  <browser:page
      name="pfas-edd-config"
      for="*"
      class=".edd_config.PFASEDDConfigView"
      permission="zope2.View"
      />

  <!-- A client's EDD settings: its profile and the fields the profile asks for -->
  <browser:page
      name="pfas-edd-client-config"
      for="*"
      class=".edd_config.PFASEDDClientConfigView"
      permission="zope2.View"
      />

  <!-- EDD file export/download for a batch -->
  <browser:page
      name="pfas-edd-export"
      for="*"
      class=".edd_config.PFASEDDExportView"
      permission="zope2.View"
      />

  <!-- Batch EDD dashboard and per-sample sample-type code override editor -->
  <browser:page
      name="pfas-edd-batches"
      for="*"
      class=".edd_config.PFASEDDBatchesView"
      permission="zope2.View"
      />


  <!-- Report views that render the per-result QC qualifier code beside the
       value (e.g. "12.4 [M]") on a qualified release.

       Registered as THREE-way multiadapters on (context, model, request).
       senaite.impress' PublishView.get_report_view_controller queries that form
       first and falls back to its own two-way registration — its comment says
       the three-way form exists "to allow 3rd party overriding with a browser
       layer". So this is the sanctioned seam, it is scoped to
       ISenaitePFASLayer, and no core template is forked.
       See browser/reportview.py for why the remarks route did not work. -->
  <adapter
      for="zope.interface.Interface
           zope.interface.Interface
           senaite.pfas.interfaces.ISenaitePFASLayer"
      name="AnalysisRequest"
      factory=".reportview.PFASSingleReportView"
      provides="senaite.impress.interfaces.IReportView"
      permission="zope2.View"/>

  <adapter
      for="zope.interface.Interface
           zope.interface.Interface
           senaite.pfas.interfaces.ISenaitePFASLayer"
      name="AnalysisRequest"
      factory=".reportview.PFASMultiReportView"
      provides="senaite.impress.interfaces.IMultiReportView"
      permission="zope2.View"/>

  <!-- Generate the batch's EDD when a sample of an exporting client is published -->
  <subscriber
      for="* Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".edd_publish.on_after_transition"
      />

  <!-- A sample whose method cannot be identified is not published;
       the certificate refuses it for the same reason. -->
  <adapter
      factory=".guards.SampleMethodGuard"
      for="bika.lims.interfaces.IAnalysisRequest"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.sample_method"
      />

  <!-- An analysis goes only on a worksheet whose Method is its sample's
       (worksheet_samples.assign_allowed) -->
  <adapter
      factory=".guards.WorksheetMethodGuard"
      for="bika.lims.interfaces.IRoutineAnalysis"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.worksheet_method"
      />

  <!-- Only Send back reopens a submitted or verified worksheet: its
       retract, and an analysis's retract on it, need the request's mark
       (reopen_guard); the plain Retract is hidden and refused by URL -->
  <adapter
      factory=".guards.ReopenGuard"
      for="bika.lims.interfaces.IWorksheet"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.reopen"
      />
  <adapter
      factory=".guards.ReopenGuard"
      for="bika.lims.interfaces.IRoutineAnalysis"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.reopen"
      />

  <!-- Entering, reviewing or issuing needs a Lab Contact with initials and
       a signature (entry_rights.py) -->
  <adapter
      factory=".guards.EntryRightsGuard"
      for="bika.lims.interfaces.IRoutineAnalysis"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.entry_rights"
      />
  <adapter
      factory=".guards.EntryRightsGuard"
      for="bika.lims.interfaces.IAnalysisRequest"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.entry_rights"
      />

  <!-- No certificate before a reporting-template revision is issued -->
  <adapter
      factory=".guards.ReportTemplateGuard"
      for="bika.lims.interfaces.IAnalysisRequest"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.report_template"
      />

  <!-- No certificate while no certificate layout is issued -->
  <adapter
      factory=".guards.CertificateLayoutGuard"
      for="bika.lims.interfaces.IAnalysisRequest"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.certificate_layout"
      />

  <!-- No certificate without the laboratory's address -->
  <adapter
      factory=".guards.LabAddressGuard"
      for="bika.lims.interfaces.IAnalysisRequest"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.lab_address"
      />

  <!-- No certificate for a sample that was run while its surrogate /
       internal-standard verdicts are missing -->
  <adapter
      factory=".guards.QCStandardsGuard"
      for="bika.lims.interfaces.IAnalysisRequest"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.qc_standards"
      />
  <!-- No certificate for a compliance sample received out of compliance
       with its method: a resample is requested -->
  <adapter
      factory=".guards.ReceiptComplianceGuard"
      for="bika.lims.interfaces.IAnalysisRequest"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.receipt_compliance"
      />
  <!-- No certificate goes out while its package is building, failed, or
       missing at a tier that needs one: every path that publishes -->
  <adapter
      factory=".guards.ReportPackageGuard"
      for="bika.lims.interfaces.IAnalysisRequest"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.report_package"
      />
  <!-- No certificate is issued without its authoriser's signature, given
       by the publisher on Data Review before it was generated -->
  <adapter
      factory=".guards.SignatureGuard"
      for="bika.lims.interfaces.IAnalysisRequest"
      provides="bika.lims.interfaces.IGuardAdapter"
      name="senaite.pfas.signature"
      />

  <!-- Controlled publication register (D65 B): record an immutable issuance
       entry on the sample each time a CoA is published (publish transition). -->
  <subscriber
      for="* Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".controlled_publications.on_after_transition"
      />

  <!-- Freeze the resolved QC criteria on a Worksheet when it is VERIFIED.
       Registered on the transition rather than called from
       the Data Review Approve handler, so a worksheet verified from a native
       SENAITE listing or a script is recorded too. The handler rejects every
       other type and transition first and can never raise. -->
  <subscriber
      for="* Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".data_review.on_after_transition"
      />

  <!-- Core's front page: a signed-in client opens the tracker, not core's
       client sample list (workspace_home.front_page_for) -->
  <adapter
      for="*"
      provides="bika.lims.interfaces.IFrontPageAdapter"
      factory=".workspace_home.PFASFrontPage"
      name="senaite.pfas.front-page"
      />

  <!-- Role-aware workspace launcher — redirects to the user's default workspace -->
  <browser:page
      name="pfas-home"
      for="*"
      class=".workspace_home.PFASWorkspaceHomeView"
      permission="zope2.View"
      />

  <!-- QC Management workspace landing page (LabManager/QAO default) -->
  <browser:page
      name="pfas-qc-management"
      for="*"
      class=".workspace_home.PFASQCManagementView"
      permission="zope2.View"
      />

  <!-- Bench workspace landing page (Bench Chemist / LabClerk default) -->
  <browser:page
      name="pfas-bench"
      for="*"
      class=".workspace_home.PFASBenchHomeView"
      permission="zope2.View"
      />

  <!-- Data Review workspace landing page (Analyst/Verifier default) — links
       to the existing @@pfas-data-review queue plus related review surfaces.
       Do not confuse with @@pfas-data-review itself, which is unchanged. -->
  <browser:page
      name="pfas-data-review-home"
      for="*"
      class=".workspace_home.PFASDataReviewHomeView"
      permission="zope2.View"
      />

  <browser:page
      name="pfas-retire-attachment"
      for="*"
      class=".batch_api.PFASRetireAttachmentView"
      permission="zope2.View"
      />

  <!-- the worker's daily sweep of the instrument archive (manager, POST) -->
  <browser:page
      name="pfas-instrument-archive-sweep"
      for="*"
      class=".batch_api.PFASInstrumentArchiveSweepView"
      permission="zope2.View"
      />

  <browser:page
      name="pfas-run-manifest"
      for="*"
      class=".batch_api.PFASRunManifestView"
      permission="zope2.View"
      />

  <browser:page
      name="pfas-batch-dilutions"
      for="*"
      class=".batch_api.PFASBatchDilutionsView"
      permission="zope2.View"
      />

  <!-- value provenance: the record behind one Data Review value, as JSON
       for the drawer (staff only, read-only) -->
  <browser:page
      name="pfas-provenance"
      for="*"
      class=".provenance.PFASProvenanceView"
      permission="zope2.View"
      />

  <!-- Guided-step media (GIF / photo). GET is open so analysts can see the
       image while working through a stage; POST is manager-gated inside the view. -->
  <browser:page
      name="pfas-logbook-media"
      for="*"
      class=".logbook_media.PFASLogbookMediaView"
      permission="zope2.View"
      />

  <!-- Bench: each worksheet's batch record, on SENAITE's own listing:
       In progress (until verified) by default, the 50 oldest first;
       ?record=<uid> one record (batch_records.PFASBatchRecordsView). -->
  <browser:page
      name="pfas-batch-records"
      for="*"
      class=".batch_records_listing.PFASBatchRecordsListing"
      permission="zope2.View"
      />

  <!-- Materials & Containers: the reagent inventory over the lots whose
       category has no expiry -->
  <browser:page
      name="pfas-materials"
      for="*"
      class=".reagents.PFASMaterialsView"
      permission="zope2.View"
      />

  <!-- Lot extensions: the request on a lot, QA's queue, the signed approval -->
  <browser:page
      name="pfas-lot-extensions"
      for="*"
      class=".lot_extensions.PFASLotExtensionsView"
      permission="zope2.View"
      />

  <!-- Prepared standards inventory -->
  <browser:page
      name="pfas-prep-standards"
      for="*"
      class=".prepared_standards.PFASPrepStandardsView"
      permission="zope2.View"
      />

  <!-- ── Facility QC (ISO 17025 daily verifications) ──────────────────── -->
  <browser:page
      name="pfas-facility-qc"
      for="*"
      class=".facility_qc.PFASFacilityDashboardView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-equipment"
      for="*"
      class=".equipment.PFASEquipmentView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-equipment-types"
      for="*"
      class=".equipment.PFASEquipmentTypesView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-coc-document"
      for="*"
      class=".custody_documents.PFASCoCDocumentView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-coc"
      for="*"
      class=".coc.PFASCoCView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-coc-receive"
      for="*"
      class=".coc_receive.PFASCoCReceiveView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-coc-print"
      for="*"
      class=".custody_documents.PFASCoCPrintView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-sop-cover"
      for="*"
      class=".custody_documents.PFASSOPCoverView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-homogenisation"
      for="*"
      class=".homogenisation_bench.PFASHomogenisationView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-study-designer"
      for="*"
      class=".study_designer.PFASStudyDesignerView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-vocabularies"
      for="*"
      class=".vocab_editor.PFASVocabulariesView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-homogenisation-setup"
      for="*"
      class=".homogenisation_setup.PFASHomogenisationSetupView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-equipment-settings"
      for="*"
      class=".equipment.PFASEquipmentSettingsView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-temperature-log"
      for="*"
      class=".facility_qc.PFASTemperatureLogView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-balance-log"
      for="*"
      class=".facility_qc.PFASBalanceLogView"
      permission="zope2.View"
      />
  <!-- Reference weight sets: the external metrology-lab calibration a balance
       verification traces to. -->
  <browser:page
      name="pfas-weight-sets"
      for="*"
      class=".facility_qc.PFASWeightSetsView"
      permission="zope2.View"
      />
  <!-- The sample page (core_sample.py): Attachments
       as its own tab, the analyses folded to one line, the results
       interpretation named "Comments on the certificate" -->
  <browser:viewlet
      for="bika.lims.interfaces.IAnalysisRequest"
      name="sample_attachments"
      class=".core_sample.PFASSampleAttachmentsViewlet"
      manager="plone.app.layout.viewlets.interfaces.IBelowContentTitle"
      permission="zope2.View"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />
  <!-- Under the sample's title while its newest certificate is interim -->
  <browser:viewlet
      for="bika.lims.interfaces.IAnalysisRequest"
      name="senaite.pfas.sample-interim"
      class=".core_sample.PFASSampleInterimViewlet"
      manager="plone.app.layout.viewlets.interfaces.IBelowContentTitle"
      permission="zope2.View"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />
  <browser:page
      name="pfas-sample-attachments"
      for="bika.lims.interfaces.IAnalysisRequest"
      class=".core_sample.PFASSampleAttachmentsView"
      permission="zope2.View"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />
  <!-- a samples list offers no Add Samples: the chain of custody is the one way in -->
  <browser:viewlet
      name="senaite.core.listings.add_samples"
      manager="senaite.core.browser.viewlets.interfaces.IListingTableTitle"
      class=".core_sample.PFASNoAddSamplesViewlet"
      permission="zope2.View"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />
  <browser:viewlet
      for="bika.lims.interfaces.IAnalysisRequest"
      name="senaite.core.samplesection.lab_analyses"
      manager="senaite.core.browser.viewlets.interfaces.ISampleSection"
      class=".core_sample.PFASLabAnalysesViewlet"
      permission="zope2.View"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />
  <browser:viewlet
      for="bika.lims.interfaces.IAnalysisRequest"
      name="senaite.core.belowsamplesection.resultsinterpretation"
      manager="senaite.core.browser.viewlets.interfaces.IBelowSampleSection"
      class=".core_sample.PFASResultsInterpretationViewlet"
      permission="zope2.View"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />

  <!-- A worksheet opens on its Data Review (setuphandlers.worksheet_opens_on_review) -->
  <browser:page
      name="pfas-ws-open"
      for="bika.lims.interfaces.IWorksheet"
      class=".core_sample.PFASWorksheetOpenView"
      permission="zope2.View"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />

  <!-- Where a refused data-entry or review form lands (entry_rights.py) -->
  <browser:page
      name="pfas-entry-refused"
      for="*"
      class=".entry_refused.PFASEntryRefusedView"
      permission="zope2.View"
      />

  <!-- Reference thermometers: the registered NIST-traceable references a
       temperature study is read against, with their certificates. -->
  <browser:page
      name="pfas-reference-thermometers"
      for="*"
      class=".equipment.PFASReferenceThermometersView"
      permission="zope2.View"
      />
  <!-- Pipette calibration: quarterly in house, or external. -->
  <browser:page
      name="pfas-pipette-calibration"
      for="*"
      class=".facility_qc.PFASPipetteCalibrationView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-water-log"
      for="*"
      class=".facility_qc.PFASWaterLogView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-waste-log"
      for="*"
      class=".facility_qc.PFASWasteLogView"
      permission="zope2.View"
      />
  <browser:page
      name="pfas-eyewash-log"
      for="*"
      class=".facility_qc.PFASEyeWashLogView"
      permission="zope2.View"
      />
  <!-- Unauthenticated RPi ingest endpoint — API key validated in the view -->
  <browser:page
      name="pfas-sensor-ingest"
      for="*"
      class=".facility_qc.PFASSensorIngestView"
      permission="zope2.Public"
      />

  <!-- SOP Document Management — revision control, sign-off, PDF viewer -->
  <browser:page
      name="pfas-sop"
      for="*"
      class=".sop_documents.PFASSOPView"
      template="templates/sop_documents.pt"
      permission="zope2.View"
      />

  <!-- Deviation & CAR non-conformance management -->
  <browser:page
      name="pfas-deviations"
      for="*"
      class=".deviations.PFASDeviationView"
      template="templates/deviations.pt"
      permission="zope2.View"
      />

</configure>
