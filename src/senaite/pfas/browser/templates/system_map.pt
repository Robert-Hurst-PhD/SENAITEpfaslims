<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">System Map</title>
  <tal:extras metal:fill-slot="head-extra">
  <link rel="stylesheet" tal:attributes="href string:${context/portal_url}/++resource++senaite.pfas/system_map.css?v=${context/@@pfas-macros/asset_version}" />
  <script tal:attributes="src string:${context/portal_url}/++resource++senaite.pfas/vendor/d3-7.9.0.min.js"></script>
  <script defer="defer" tal:attributes="src string:${context/portal_url}/++resource++senaite.pfas/system_map.js?v=${context/@@pfas-macros/asset_version}"></script>
  </tal:extras>
</head>
<body>
  <tal:t metal:fill-slot="header-title">System Map</tal:t>

  <div metal:fill-slot="content">
  <div class="page-body">

    <div class="pfas-filterbar pfas-map-tools">
      <div class="pfas-field">
        <label for="map-find">Find</label>
        <input id="map-find" class="pfas-input" type="search" placeholder="Worksheet, sample, lot, method" />
      </div>
      <label class="pfas-switch">
        <input type="checkbox" id="map-path-only" />
        <span class="pfas-switch-track"></span>
        <span>Path only</span>
      </label>
      <label class="pfas-switch">
        <input type="checkbox" id="map-cross" checked="checked" />
        <span class="pfas-switch-track"></span>
        <span>Cross-links</span>
      </label>
      <span class="pfas-filterbar-spacer"></span>
      <button type="button" class="btn btn-sm btn-secondary" id="map-fit">Fit</button>
      <button type="button" class="btn btn-sm btn-secondary" id="map-reset">Reset view</button>
      <div class="pfas-map-legend" aria-label="Node kinds">
        <span><i class="k-method"></i>Method</span>
        <span><i class="k-matrix"></i>Matrix and settings</span>
        <span><i class="k-worksheet"></i>Worksheet</span>
        <span><i class="k-sample"></i>Sample and result</span>
        <span><i class="k-lot"></i>Lots</span>
      </div>
    </div>

    <div class="pfas-map" id="pfas-map"
         tal:attributes="data-url view/data_url;
                         data-root view/root_json">
      <div class="pfas-map-view" tabindex="0" aria-label="System map: drag to move, use the buttons on a node to open it">
        <!-- without script: the first level as a list -->
        <div class="pfas-tree pfas-map-fallback" tal:define="root view/root">
          <div class="pfas-tree-nodes">
            <div class="pfas-tree-row"><span class="pfas-tree-node is-path" tal:content="root/node/label">Laboratory</span></div>
            <div class="pfas-tree-row pfas-map-indent" tal:repeat="n root/children">
              <span class="pfas-tree-elbow"></span>
              <a class="pfas-tree-node" tal:condition="n/url" tal:attributes="href n/url"
                 tal:content="n/label">Method</a>
              <span class="pfas-tree-node" tal:condition="not:n/url" tal:content="n/label">Lots</span>
            </div>
          </div>
        </div>
      </div>
      <aside class="pfas-map-card" aria-live="polite">
        <div class="pfas-map-kind"><i></i><span>Select a node</span></div>
        <h3></h3>
        <span class="badge pfas-map-badge" hidden="hidden"></span>
        <dl></dl>
        <div class="pfas-map-acts">
          <a class="btn btn-sm btn-primary pfas-map-open" hidden="hidden">Open</a>
          <button type="button" class="btn btn-sm btn-secondary pfas-map-pathbtn" hidden="hidden">Path to here</button>
        </div>
      </aside>
    </div>

  </div>
  </div><!-- /content slot -->
</body>
</html>
