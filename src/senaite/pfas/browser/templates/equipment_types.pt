<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Equipment Types</title>
  <metal:fill fill-slot="header-title">Equipment Types</metal:fill>
  <tal:r metal:fill-slot="header-right">
    <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-equipment">Equipment</a>
    <a class="btn-sm btn-primary" tal:condition="view/can_configure" tal:attributes="href view/add_type_url">+ Add type</a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body" tal:define="purl view/portal_url">

    <div class="alert alert-success" tal:condition="view/saved">Saved.</div>
    <div class="alert alert-danger" tal:repeat="e view/errors|nothing" tal:content="e">error</div>

    <p class="form-note">What every instrument of a type owes. Blank means not set. <tal:h define="hid string:equipment-types"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></p>

    <form method="post" tal:attributes="action string:${purl}/@@pfas-equipment-types"
          tal:define="types view/types; kinds view/kinds">
      <input type="hidden" name="action" value="save_types" tal:condition="view/can_configure" />
      <!-- read-only for roles that cannot save -->
      <fieldset class="pfas-ro" tal:attributes="disabled python:None if view.can_configure() else 'disabled'">
      <table class="pfas-table pfas-table-form">
        <thead>
          <tr><th>Type</th><th>Kind</th><th>Check every (days)</th>
              <th>Correction factor</th><th>External certificate</th><th>Unit</th>
              <th>Tolerance (%)</th><th>In worksheets</th></tr>
        </thead>
        <tbody>
          <tr tal:repeat="t types">
            <td><strong tal:content="t/title">Balance</strong>
                <div class="cf-hint" tal:condition="not:t/req/configured">not set up yet</div></td>
            <td><select tal:attributes="name string:kind.${t/uid}">
                  <option tal:repeat="k kinds"
                          tal:attributes="value k/key; selected python:'selected' if k['key'] == t['req']['kind'] else None"
                          tal:content="k/label">Balance</option>
                </select></td>
            <td><input type="number" min="1" step="1"
                       tal:attributes="name string:cal_frequency_days.${t/uid};
                                       value python:t['req']['cal_frequency_days'] or ''" /></td>
            <td><input type="checkbox" value="on"
                       tal:attributes="name string:correction_factor_required.${t/uid};
                                       checked python:'checked' if t['req']['correction_factor_required'] else None" /></td>
            <td><input type="checkbox" value="on"
                       tal:attributes="name string:external_cert_required.${t/uid};
                                       checked python:'checked' if t['req']['external_cert_required'] else None" /></td>
            <td><input type="text"
                       tal:attributes="name string:unit.${t/uid}; value t/req/unit;
                                       readonly python:'readonly' if t['req']['kind'] in ('balance_analytical', 'balance_prep') else None" /></td>
            <td><input type="number" min="0" step="any"
                       tal:attributes="name string:tolerance_pct.${t/uid};
                                       value python:'' if t['req']['tolerance_pct'] is None else t['req']['tolerance_pct']" /></td>
            <td><input type="checkbox" value="on"
                       tal:attributes="name string:in_worksheets.${t/uid};
                                       checked python:'checked' if t['req']['in_worksheets'] else None" /></td>
          </tr>
        </tbody>
      </table>
      </fieldset>
      <button class="btn btn-primary" type="submit" tal:condition="view/can_configure">Save types</button>
    </form>

    <div class="section-group-hdr" tal:condition="view/can_configure">Lab-wide facility defaults</div>
    <form method="post" tal:condition="view/can_configure"
          tal:attributes="action string:${purl}/@@pfas-equipment-types"
          tal:define="d view/facility_defaults">
      <input type="hidden" name="action" value="save_defaults" />
      <p class="form-note">
        Starting weight points for a new balance, one per line: grams, label (e.g. <code>10.0, 10 g</code>).
      </p>
      <div tal:repeat="bt view/balance_unit_types" class="field-row">
        <label tal:content="bt/label">Balance</label>
        <textarea rows="4" tal:attributes="name string:bal_points.${bt/key}"
                  tal:content="python:d['balance_points_text'].get(bt['key'], '')"></textarea>
      </div>
      <table class="pfas-table">
        <tr><td>Eye wash temperature range (&#176;C)</td>
            <td><input type="number" step="0.1" name="eyewash_temp_min" tal:attributes="value d/eyewash_temp_min" />
                to <input type="number" step="0.1" name="eyewash_temp_max" tal:attributes="value d/eyewash_temp_max" /></td></tr>
        <tr><td>Type 1 water, maximum conductivity (&#181;S/cm)</td>
            <td><input type="number" step="0.01" name="water_conductivity_max" tal:attributes="value d/water_conductivity_max" /></td></tr>
        <tr><td>Type 1 water, maximum TOC (ppb)</td>
            <td><input type="number" step="1" name="water_toc_max" tal:attributes="value d/water_toc_max" /></td></tr>
        <tr><td>Temperature-mapping study tolerance (&#176;C)</td>
            <td><input type="number" step="0.1" name="study_tolerance" tal:attributes="value d/study_tolerance" /></td></tr>
      </table>
      <button class="btn btn-primary" type="submit">Save defaults</button>
    </form>

    <tal:key condition="view/can_site_admin">
      <div class="section-group-hdr">Sensor ingest API key</div>
      <p class="form-note">
        Set on the Raspberry Pi in <code>/etc/pfas_sensor.conf</code> as
        <code>api_key = ...</code>; the Pi sends it with every reading.
      </p>
      <form method="post" tal:attributes="action string:${purl}/@@pfas-equipment-types">
        <input type="hidden" name="action" value="save_api_key" />
        <input type="text" name="api_key" placeholder="paste generated key here"
               tal:attributes="value view/api_key" />
        <button type="submit" class="btn btn-primary">Save key</button>
      </form>
    </tal:key>
  </div>
  </div>
</html>
