<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Equipment Types</title>
  <metal:fill fill-slot="header-title">Equipment Types</metal:fill>
  <tal:r metal:fill-slot="header-right">
    <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-equipment">Equipment</a>
    <a class="btn-sm btn-primary" tal:condition="view/can_configure" tal:attributes="href view/add_type_url">+ New type</a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body" tal:define="purl view/portal_url">

    <div class="alert alert-success" tal:condition="view/saved">Saved.</div>
    <div class="alert alert-danger" tal:repeat="e view/errors|nothing" tal:content="e">error</div>

    <nav class="pfas-seg pfas-seg-strip is-spaced" data-tabs="data-tabs" data-hash="data-hash" role="tablist" aria-label="Equipment Types sections">
      <button type="button" class="pfas-seg-item" role="tab" data-pane="et-types" aria-selected="true">Types</button>
      <button type="button" class="pfas-seg-item" role="tab" data-pane="et-defaults" aria-selected="false"
              tal:condition="view/can_configure">Lab-wide defaults</button>
      <button type="button" class="pfas-seg-item" role="tab" data-pane="et-sensor" aria-selected="false"
              tal:condition="view/can_site_admin">Sensor key</button>
    </nav>

    <div class="pfas-pane is-active" id="et-types">
    <p class="form-note">What every instrument of a type owes. Blank means not set. <tal:h define="hid string:equipment-types"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></p>

    <form method="post" tal:attributes="action string:${purl}/@@pfas-equipment-types"
          tal:define="types view/types; kinds view/kinds">
      <input type="hidden" name="action" value="save_types" tal:condition="view/can_configure" />
      <!-- read-only for roles that cannot save -->
      <fieldset class="pfas-ro" tal:attributes="disabled python:None if view.can_configure() else 'disabled'">
      <table class="pfas-table pfas-table-form is-sticky-first is-name-rest" data-col-resize="equipment-types-1">
        <!-- each column of controls is as wide as its longest value (the
             longest kind, a number, a switch, the two-word correction
             choice, the unit list's own "Choose") or its longest heading
             word; the type's name takes what is left and wraps -->
        <colgroup><col class="is-name" /><col width="268" /><col width="76" /><col width="86" /><col width="202" /><col width="84" /><col width="120" /><col width="80" /></colgroup>
        <thead>
          <tr><th>Type</th><th>Kind</th><th>Check every (days)</th>
              <th class="is-center">Correction factor</th><th>Correction</th><th class="is-center">External certificate</th><th>Unit</th>
              <th>Tolerance (%)</th></tr>
        </thead>
        <tbody>
          <tr tal:repeat="t types" tal:attributes="id string:et-type-${t/uid}">
            <td><strong tal:content="t/title">Balance</strong>
                <div class="cf-hint" tal:condition="not:t/req/configured">not set up yet</div></td>
            <td><select tal:attributes="name string:kind.${t/uid}; aria-label string:Kind, ${t/title}">
                  <option tal:repeat="k kinds"
                          tal:attributes="value k/key; selected python:'selected' if k['key'] == t['req']['kind'] else None"
                          tal:content="k/label">Balance</option>
                </select></td>
            <td><input type="number" min="1" step="1"
                       tal:attributes="name string:cal_frequency_days.${t/uid};
                                       value python:t['req']['cal_frequency_days'] or '';
                                       aria-label string:Check every, days, ${t/title}" /></td>
            <td class="is-center"><label class="pfas-switch"><input type="checkbox" value="on"
                       tal:attributes="name string:correction_factor_required.${t/uid};
                                       checked python:'checked' if t['req']['correction_factor_required'] else None;
                                       aria-label string:Correction factor, ${t/title}" /><span class="pfas-switch-track"></span></label></td>
            <td><input type="hidden" tal:attributes="id string:cm-${t/uid}; name string:correction_model.${t/uid};
                                                     value python:t['req'].get('correction_model')" />
                <div class="pfas-seg pfas-seg-sm is-fit" role="group" data-field="data-field" data-quiet="data-quiet"
                     tal:attributes="data-input string:cm-${t/uid}; aria-label string:Correction, ${t/title}">
                  <button type="button" class="pfas-seg-item" tal:repeat="m view/correction_models"
                          tal:attributes="data-value python:m[0];
                                          aria-pressed python:'true' if t['req'].get('correction_model') == m[0] else 'false'"
                          tal:content="python:m[1]">Single factor</button>
                </div></td>
            <td class="is-center"><label class="pfas-switch"><input type="checkbox" value="on"
                       tal:attributes="name string:external_cert_required.${t/uid};
                                       checked python:'checked' if t['req']['external_cert_required'] else None;
                                       aria-label string:External certificate, ${t/title}" /><span class="pfas-switch-track"></span></label></td>
            <td tal:define="is_bal python:t['req']['kind'] in ('balance_analytical', 'balance_prep')">
              <input type="hidden" tal:condition="is_bal" tal:attributes="name string:unit.${t/uid}; value t/req/unit" />
              <select tal:attributes="name python:None if is_bal else 'unit.%s' % t['uid']; aria-label string:Unit, ${t/title};
                                      disabled python:'disabled' if is_bal else None">
                <option value="">Choose</option>
                <optgroup tal:repeat="g python:view.unit_choices(t['req']['unit'])" tal:attributes="label python:g[0]">
                  <option tal:repeat="u python:g[1]" tal:attributes="value u; selected python:'selected' if u == t['req']['unit'] else None"
                          tal:content="u">g</option>
                </optgroup>
              </select></td>
            <td><input type="number" min="0" step="any"
                       tal:attributes="name string:tolerance_pct.${t/uid}; aria-label string:Tolerance, ${t/title};
                                       value python:'' if t['req']['tolerance_pct'] is None else t['req']['tolerance_pct']" /></td>
          </tr>
        </tbody>
      </table>
      </fieldset>
      <button class="btn btn-primary section-gap" type="submit" tal:condition="view/can_configure">Save types</button>
    </form>
    </div>

    <div class="pfas-pane" id="et-defaults" tal:condition="view/can_configure">
    <form method="post"
          tal:attributes="action string:${purl}/@@pfas-equipment-types"
          tal:define="d view/facility_defaults">
      <input type="hidden" name="action" value="save_defaults" />
      <div class="pfas-settings-grid">
      <div class="pfas-card is-wide">
        <h3 class="pfas-card-head">Balance check weights</h3>
        <div class="pfas-cols-2">
          <div tal:repeat="bt view/balance_unit_types">
            <div class="pfas-label" tal:content="bt/label">Analytical balance</div>
            <div class="pfas-rows" data-rows="data-rows" tal:define="key bt/key">
              <div class="pfas-rows-list" data-row-list="data-row-list">
                <div class="pfas-rows-item" data-row="data-row" tal:repeat="r python:d['balance_rows'].get(key, [])">
                  <input type="number" step="any" min="0" class="pfas-input is-num no-stepper"
                         tal:attributes="name string:bal_w.${key}.${r/i}; value r/value; aria-label string:${bt/label} weight" />
                  <input type="hidden" tal:attributes="id string:bal_u-${key}-${r/i}; name string:bal_u.${key}.${r/i}; value r/unit" />
                  <div class="pfas-seg pfas-seg-sm is-fit" role="group" aria-label="Unit" data-field="data-field" data-quiet="data-quiet"
                       tal:attributes="data-input string:bal_u-${key}-${r/i}">
                    <button type="button" class="pfas-seg-item" data-value="mg"
                            tal:attributes="aria-pressed python:'true' if r['unit'] == 'mg' else 'false'">mg</button>
                    <button type="button" class="pfas-seg-item" data-value="g"
                            tal:attributes="aria-pressed python:'true' if r['unit'] == 'g' else 'false'">g</button>
                  </div>
                  <button type="button" class="pfas-row-remove" data-row-remove="data-row-remove" aria-label="Remove weight">&#215;</button>
                </div>
              </div>
              <template data-row-template="data-row-template">
                <div class="pfas-rows-item" data-row="data-row">
                  <input type="number" step="any" min="0" class="pfas-input is-num no-stepper"
                         tal:attributes="name string:bal_w.${key}.__i__; aria-label string:${bt/label} weight" />
                  <input type="hidden" value="g" tal:attributes="id string:bal_u-${key}-__i__; name string:bal_u.${key}.__i__" />
                  <div class="pfas-seg pfas-seg-sm is-fit" role="group" aria-label="Unit" data-field="data-field" data-quiet="data-quiet"
                       tal:attributes="data-input string:bal_u-${key}-__i__">
                    <button type="button" class="pfas-seg-item" data-value="mg" aria-pressed="false">mg</button>
                    <button type="button" class="pfas-seg-item" data-value="g" aria-pressed="true">g</button>
                  </div>
                  <button type="button" class="pfas-row-remove" data-row-remove="data-row-remove" aria-label="Remove weight">&#215;</button>
                </div>
              </template>
              <button type="button" class="btn-sm btn-secondary pfas-add-row" data-row-add="data-row-add">+ Add weight</button>
            </div>
          </div>
        </div>
      </div>
        <div class="pfas-card">
          <h3 class="pfas-card-head">Eye wash station</h3>
          <div class="pfas-form-field"><label>Temperature range (&deg;C)</label>
            <div data-range="data-range" data-scale="0,50" data-unit="&#176;C">
              <input type="number" step="0.1" name="eyewash_temp_min" aria-label="Eye wash lowest temperature" tal:attributes="value d/eyewash_temp_min" />
              <input type="number" step="0.1" name="eyewash_temp_max" aria-label="Eye wash highest temperature" tal:attributes="value d/eyewash_temp_max" /></div></div>
        </div>
        <div class="pfas-card">
          <h3 class="pfas-card-head">Type 1 water</h3>
          <div class="pfas-form-row">
            <div class="pfas-form-field"><span class="pfas-label">Conductivity unit</span>
              <input type="hidden" name="water_conductivity_unit" id="et-wunit" tal:attributes="value d/water_conductivity_unit|string:uS/cm" />
              <div class="pfas-seg pfas-seg-sm is-fit" role="group" aria-label="Conductivity unit" data-field="data-field" data-quiet="data-quiet" data-input="et-wunit">
                <button type="button" class="pfas-seg-item" tal:repeat="c view/conductivity_units"
                        tal:attributes="data-value python:c[0]; aria-pressed python:'true' if c[0] == (d.get('water_conductivity_unit') or 'uS/cm') else 'false'"
                        tal:content="python:c[1]">uS/cm</button>
              </div></div>
            <label class="pfas-form-field">Maximum conductivity (&micro;S/cm)
              <input type="number" step="0.01" name="water_conductivity_max" tal:attributes="value d/water_conductivity_max" /></label>
            <label class="pfas-form-field">Maximum TOC (ppb)
              <input type="number" step="1" name="water_toc_max" tal:attributes="value d/water_toc_max" /></label>
          </div>
        </div>
        <div class="pfas-card">
          <h3 class="pfas-card-head">Thermometers</h3>
          <label class="pfas-form-field">Correction factor tolerance (&deg;C)
            <input type="number" step="0.1" name="study_tolerance" tal:attributes="value d/study_tolerance" /></label>
        </div>
      <div class="pfas-card">
        <h3 class="pfas-card-head">Pipette calibration</h3>
        <p class="pfas-hint">Volumes use the water temperature: Kell equation density with the ISO 8655-6 air buoyancy correction.</p>
      </div>
      </div>
      <div class="form-actions"><button class="btn btn-primary" type="submit">Save defaults</button></div>
    </form>
    </div>

    <div class="pfas-pane" id="et-sensor" tal:condition="view/can_site_admin">
      <div class="pfas-card">
        <h3 class="pfas-card-head">How readings arrive <tal:h define="hid string:sensor-key"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></h3>
        <p class="form-note">Set on each Raspberry Pi in <code>/etc/pfas_sensor.conf</code>.</p>
      </div>
      <form method="post" tal:attributes="action string:${purl}/@@pfas-equipment-types">
        <input type="hidden" name="action" value="save_api_key" />
        <div class="pfas-form-row page-body-narrow">
          <label class="pfas-form-field">API key
            <input type="text" name="api_key" placeholder="paste generated key here"
                   tal:attributes="value view/api_key" /></label>
        </div>
        <div class="form-actions"><button type="submit" class="btn btn-primary">Save key</button></div>
      </form>
    </div>
  </div>
  </div>
</html>
