<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Deviations &amp; CARs</title>
  <metal:extra metal:fill-slot="head-extra">
  <style>
    /* ── Layout ─────────────────────────────────────────────── */
    .dev-page { padding: 0 0 40px; }   /* gutter comes from .pfas-content-area */
    .dev-empty { text-align:center; padding:40px; color:var(--s-secondary);
                 font-size:var(--fs-base); }
    /* ── Badges (page-specific — base .badge is global) ─────── */
    .badge-deviation  { background:var(--s-info-lt); color:var(--s-info-text); }
    .badge-car        { background:var(--s-light); color: var(--text); border:1px solid var(--s-border); }
    .badge-open       { background:var(--s-warn-lt); color:var(--s-warn-text); }
    .badge-in_progress{ background:var(--s-info-lt); color:var(--s-info-text); }
    .badge-closed     { background:var(--s-success-lt); color:var(--s-success-text); }
    /* the risk scale, from the site's tokens: mint low, amber, a mix of the two flags, coral high */
    .risk-green  { background:var(--s-success-lt); color:var(--s-success-text); }
    .risk-yellow { background:var(--s-warn-lt); color:var(--s-warn-text); }
    .risk-orange { background:color-mix(in srgb, var(--s-warn-lt), var(--s-danger-lt)); color:var(--s-danger-dk); }
    .risk-red    { background:var(--s-danger-lt); color:var(--s-danger-dk); }
    /* ── Detail view ────────────────────────────────────────── */
    .dev-detail-header { display:flex; align-items:center; gap:10px;
                         margin-bottom:18px; flex-wrap:wrap; }
    .dev-detail-id { font-size:var(--fs-xl); font-weight:var(--fw-heading); color:var(--s-body); }
    .dev-filed-meta { font-size:var(--fs-sm); color:var(--s-secondary); margin-left:auto; }
    .dev-grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:start; }
    .dev-grid-2.is-tight { gap:16px; align-items:stretch; }
    /* ── Tab content ─────────────────────────────────────────── */
    .dev-section-label { font-size:var(--fs-xs); font-weight:var(--fw-heading); text-transform:uppercase;
                         letter-spacing:.08em; color:var(--s-secondary);
                         margin-bottom:4px; margin-top:16px; }
    .dev-section-value { font-size:var(--fs-base); color:var(--s-body);
                         margin-bottom:12px; white-space:pre-wrap; }
    .dev-form-group { margin-bottom:14px; }
    .dev-form-group label { display:block; font-size:var(--fs-sm); font-weight:var(--fw-strong);
                            color:var(--s-secondary); margin-bottom:4px; }
    .dev-form-group input, .dev-form-group textarea, .dev-form-group select {
      width:100%; padding:7px 10px; border:1px solid var(--s-input-border);
      border-radius:4px; font-size:var(--fs-base); color:var(--s-input-text);
      background:var(--surface); box-sizing:border-box; }
    .dev-form-group input:focus, .dev-form-group textarea:focus,
    .dev-form-group select:focus { outline:none; border-color:var(--s-primary);
                                   box-shadow:0 0 0 3px var(--s-focus-ring); }
    .dev-form-group textarea { min-height:80px; resize:vertical; }
    .dev-form-group label .pfas-aux { font-weight:var(--fw-body); }
    .dev-ws-row { display:flex; gap:8px; margin-bottom:8px; align-items:flex-end; }
    .dev-ws-cell { flex:1; }
    .dev-mini-label { font-size:var(--fs-xs); color:var(--s-secondary); margin-bottom:3px; }
    .dev-ws-results { margin-bottom:8px; font-size:var(--fs-sm); }
    .dev-ws-results .is-error { color:var(--s-danger-dk); }
    .dev-ws-results .is-muted { color:var(--s-secondary); }
    .dev-ws-count { color:var(--s-secondary); margin-bottom:4px; }
    .dev-ws-list { max-height:160px; overflow-y:auto; border:1px solid var(--s-border);
                   border-radius:4px; padding:6px 8px; }
    .dev-ws-list label { display:block; padding:2px 0; cursor:pointer; font-weight:var(--fw-body); }
    .dev-ws-list code { font-size:var(--fs-sm); }
    /* ── Risk matrix ─────────────────────────────────────────── */
    .risk-matrix-wrap { overflow-x:auto; margin:16px 0; }
    .risk-matrix { border-collapse:collapse; }
    .risk-matrix td, .risk-matrix th {
      width:56px; height:44px; text-align:center; font-size:var(--fs-sm);
      border:1px solid var(--surface); cursor:default; }
    .risk-matrix .rm-axis { background:var(--s-light); font-size:var(--fs-xs); font-weight:var(--fw-heading);
                             color:var(--s-secondary); cursor:default; }
    .rm-sub { font-weight:var(--fw-body); font-size:var(--fs-xs); }
    .rm-cell { font-weight:var(--fw-heading); transition:outline .1s; }
    .rm-cell.clickable { cursor:pointer; }
    .rm-cell.clickable:hover { outline:3px solid var(--text); outline-offset:-2px; }
    .rm-cell.rm-selected { outline:3px solid var(--text); outline-offset:-2px; }
    .rm-cell.risk-green  { background:var(--s-success); color:var(--on-accent); }
    .rm-cell.risk-yellow { background:var(--s-warning); color: var(--text); }
    .rm-cell.risk-orange { background:color-mix(in srgb, var(--s-warning), var(--s-danger)); color:var(--on-accent); }
    .rm-cell.risk-red    { background:var(--s-danger); color:var(--on-accent); }
    .risk-score-display { display:inline-block; padding:5px 14px; border-radius:6px;
                          font-weight:var(--fw-heading); font-size:var(--fs-base); margin-top:8px; }
    .risk-score-display[hidden] { display:none; }
    /* ── Corrective actions ──────────────────────────────────── */
    .ca-card { border:1px solid var(--s-border); border-radius:6px;
               padding:14px 16px; margin-bottom:12px; }
    .ca-card-header { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
    .ca-type-label { font-size:var(--fs-xs); font-weight:var(--fw-heading); text-transform:uppercase;
                     letter-spacing:.06em; padding:2px 8px; border-radius:10px; }
    .ca-sop_revision  { background:var(--s-info-lt); color:var(--s-info-text); }
    .ca-training      { background:var(--s-light); color: var(--text); }
    .ca-notification  { background:var(--s-warn-lt); color:var(--s-warn-text); }
    .ca-desc { font-size:var(--fs-base); color:var(--s-body); margin-bottom:10px; }
    .ca-meta { font-size:var(--fs-sm); color:var(--s-secondary); margin-bottom:8px; }
    .ca-note-box { font-size:var(--fs-sm); color:var(--s-secondary); background:var(--s-light);
                   padding:8px; border-radius:4px; white-space:pre-wrap; margin-bottom:8px; }
    .ca-actions { display:flex; gap:8px; align-items:center; }
    .ca-ack-list { margin:8px 0; font-size:var(--fs-sm); }
    .ca-ack-title { font-size:var(--fs-xs); font-weight:var(--fw-heading); color:var(--s-secondary);
                    text-transform:uppercase; margin-bottom:4px; }
    .ca-ack-item { display:flex; align-items:center; gap:6px; padding:2px 0; }
    .ca-ack-check { color: var(--s-success-text); font-weight:var(--fw-heading); }
    .ca-ack-pend  { color:var(--s-secondary); }
    .ca-icon { display:inline-block; vertical-align:-2px; margin-right:4px; }
    /* ── Add CA form ─────────────────────────────────────────── */
    .ca-add-section { border:1px dashed var(--s-border); border-radius:6px;
                      padding:16px; margin-top:16px; }
    .ca-add-title { font-size:var(--fs-base); font-weight:var(--fw-heading); color:var(--s-body); margin-bottom:12px; }
    .ca-type-options { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:12px; }
    .ca-type-opt { padding:6px 14px; border:1px solid var(--s-border);
                   border-radius:20px; font-size:var(--fs-sm); cursor:pointer;
                   background:var(--surface); color:var(--s-body); }
    .ca-type-opt.selected { background:var(--s-primary-dk); color:var(--on-accent);
                            border-color:var(--s-primary); }
    /* ── Closure ─────────────────────────────────────────────── */
    .closure-title { font-size:var(--fs-base); font-weight:var(--fw-heading); color:var(--s-body); margin-bottom:10px; }
    .closure-check { display:flex; align-items:center; gap:8px; font-size:var(--fs-base);
                     padding:6px 0; }
    .closure-check .icon-ok  { color: var(--s-success-text); font-size:var(--fs-lg); }
    .closure-check .icon-nok { color: var(--s-danger-dk); font-size:var(--fs-lg); }
    .closure-note { margin-left:10px; font-size:var(--fs-sm); color:var(--s-danger-dk); }
  </style>
  </metal:extra>
</head>
<body>

<tal:t metal:fill-slot="header-title">Deviations &amp; CARs</tal:t>

<tal:hr metal:fill-slot="header-right">
  <tal:mgr tal:condition="view/can_edit">
    <button type="button" class="btn-sm btn-primary"
            onclick="openDevModal('deviation')">+ New Deviation</button>
    <button type="button" class="btn-sm btn-secondary"
            onclick="openDevModal('car')">+ New CAR</button>
  </tal:mgr>
</tal:hr>

<metal:content metal:fill-slot="content">
<div class="dev-page">

  <!-- Flash message -->
  <tal:flash tal:condition="view/msg">
    <div tal:define="mtype view/msg_type"
         tal:attributes="class python:'alert alert-' + mtype">
      <tal:text tal:replace="view/msg_text"/>
    </div>
  </tal:flash>

  <!-- ══ DETAIL VIEW ══════════════════════════════════════════════════════ -->
  <tal:detail tal:condition="view/is_detail_view">
  <tal:dev tal:define="dev view/current_deviation">

    <tal:found tal:condition="dev">
      <!-- Breadcrumb -->
      <nav class="pfas-crumb is-inline" aria-label="Record">
        <a class="btn-sm btn-secondary btn-back" tal:attributes="href string:${view/portal_url}/@@pfas-deviations">Deviations &amp; CARs</a>
        <span class="pfas-crumb-sep">&#8250;</span>
        <span class="pfas-crumb-here" tal:content="dev/dev_id">DEV-001</span>
      </nav>

      <!-- Record header -->
      <div class="dev-detail-header">
        <span class="dev-detail-id" tal:content="dev/dev_id"/>
        <span tal:define="dtype dev/type"
              tal:attributes="class python:'badge badge-' + dtype">
          <tal:v tal:replace="python:dtype.upper()"/>
        </span>
        <span tal:define="dstatus dev/status"
              tal:attributes="class python:'badge badge-' + dstatus">
          <tal:v tal:replace="python:dstatus.replace('_', ' ').title()"/>
        </span>
        <span tal:define="rscore dev/risk_score"
              tal:attributes="class python:'badge risk-' + dev['risk_colour']">
          Risk: <tal:v tal:replace="rscore"/> — <tal:v tal:replace="dev/risk_label"/>
        </span>
        <span class="dev-filed-meta">
          Filed by <strong tal:content="dev/filed_by"/> on <tal:v tal:replace="dev/filed_at"/>
        </span>
      </div>

      <!-- Tabs: the shared segmented control in links mode -->
      <nav class="pfas-seg pfas-seg-strip is-spaced" aria-label="Record sections">
        <a class="pfas-seg-item"
           tal:attributes="aria-selected python:'true' if view.active_tab() == 'overview' else 'false';
                           href string:${view/portal_url}/@@pfas-deviations?dev_id=${dev/dev_id}&amp;tab=overview">
          Overview
        </a>
        <a class="pfas-seg-item"
           tal:attributes="aria-selected python:'true' if view.active_tab() == 'rootcause' else 'false';
                           href string:${view/portal_url}/@@pfas-deviations?dev_id=${dev/dev_id}&amp;tab=rootcause">
          Scale &amp; Root Cause
        </a>
        <a class="pfas-seg-item"
           tal:attributes="aria-selected python:'true' if view.active_tab() == 'actions' else 'false';
                           href string:${view/portal_url}/@@pfas-deviations?dev_id=${dev/dev_id}&amp;tab=actions">
          Corrective Actions
          <tal:pending tal:condition="python:dev.get('corrective_actions')">
            <tal:count tal:define="nc python:sum(1 for ca in dev.get('corrective_actions',[]) if ca.get('status') != 'complete')">
              <tal:show tal:condition="nc">
                <span class="pfas-seg-count">(<tal:v tal:replace="nc"/> pending)</span>
              </tal:show>
            </tal:count>
          </tal:pending>
        </a>
        <a class="pfas-seg-item"
           tal:attributes="aria-selected python:'true' if view.active_tab() == 'closure' else 'false';
                           href string:${view/portal_url}/@@pfas-deviations?dev_id=${dev/dev_id}&amp;tab=closure">
          Closure
        </a>
      </nav>

      <!-- ── Tab: Overview ──────────────────────────────────── -->
      <tal:tab_overview tal:condition="python:view.active_tab() == 'overview'">
        <div class="dev-grid-2">
          <div>
            <div class="dev-section-label">Event Type</div>
            <div class="dev-section-value" tal:content="dev/event_label"/>

            <div class="dev-section-label">Event Date</div>
            <div class="dev-section-value" tal:content="dev/event_date"/>

            <div class="dev-section-label">Description</div>
            <div class="dev-section-value" tal:content="dev/description"/>
          </div>

          <!-- Risk matrix display -->
          <div>
            <div class="dev-section-label">Risk Assessment Matrix
              (L=<tal:v tal:replace="dev/likelihood"/>,
               S=<tal:v tal:replace="dev/severity"/>)
            </div>
            <div class="risk-matrix-wrap">
              <table class="risk-matrix">
                <tr>
                  <td class="rm-axis">L\S</td>
                  <td class="rm-axis">S=1</td>
                  <td class="rm-axis">S=2</td>
                  <td class="rm-axis">S=3</td>
                  <td class="rm-axis">S=4</td>
                  <td class="rm-axis">S=5</td>
                </tr>
                <tal:lrow tal:repeat="li python:[5,4,3,2,1]">
                  <tr>
                    <td class="rm-axis">
                      L=<tal:v tal:replace="li"/>
                    </td>
                    <tal:scol tal:repeat="si python:[1,2,3,4,5]">
                      <td tal:define="score python:li * si;
                                      colour python:view.risk_colour_for(li, si);
                                      is_sel python:dev.get('likelihood') == li and dev.get('severity') == si"
                          tal:attributes="class python:'rm-cell risk-' + colour + (' rm-selected' if is_sel else '')">
                        <tal:v tal:replace="score"/>
                      </td>
                    </tal:scol>
                  </tr>
                </tal:lrow>
              </table>
            </div>
            <div tal:define="rscore dev/risk_score"
                 tal:attributes="class python:'risk-score-display risk-' + dev['risk_colour']">
              Score <tal:v tal:replace="rscore"/> — <tal:v tal:replace="dev/risk_label"/>
            </div>
          </div>
        </div>
      </tal:tab_overview>

      <!-- ── Tab: Scale & Root Cause ────────────────────────── -->
      <tal:tab_rc tal:condition="python:view.active_tab() == 'rootcause'">
        <tal:editable tal:condition="python:dev.get('status') != 'closed' and view.can_edit()">
          <form method="post"
                tal:attributes="action string:${view/portal_url}/@@pfas-deviations">
            <input type="hidden" name="action" value="update_scale_rootcause"/>
            <input type="hidden" name="dev_id"
                   tal:attributes="value dev/dev_id"/>
            <input type="hidden" name="likelihood" id="detail-likelihood"
                   tal:attributes="value dev/likelihood"/>
            <input type="hidden" name="severity" id="detail-severity"
                   tal:attributes="value dev/severity"/>

            <!-- Interactive risk matrix -->
            <div class="dev-form-group">
              <label>Risk assessment (tap cell to change)</label>
              <div class="risk-matrix-wrap">
                <table class="risk-matrix" id="detail-risk-matrix">
                  <tr>
                    <td class="rm-axis">L\S</td>
                    <td class="rm-axis">S=1</td><td class="rm-axis">S=2</td>
                    <td class="rm-axis">S=3</td><td class="rm-axis">S=4</td>
                    <td class="rm-axis">S=5</td>
                  </tr>
                  <tal:lrow tal:repeat="li python:[5,4,3,2,1]">
                    <tr>
                      <td class="rm-axis">L=<tal:v tal:replace="li"/></td>
                      <tal:scol tal:repeat="si python:[1,2,3,4,5]">
                        <td tal:define="score python:li * si;
                                        colour python:view.risk_colour_for(li, si)"
                            tal:attributes="class python:'rm-cell clickable risk-' + colour;
                                            data-l string:${li};
                                            data-s string:${si}">
                          <tal:v tal:replace="score"/>
                        </td>
                      </tal:scol>
                    </tr>
                  </tal:lrow>
                </table>
              </div>
              <div id="detail-score-display"
                   tal:attributes="class python:'risk-score-display risk-' + dev['risk_colour']">
                L=<tal:v tal:replace="dev/likelihood"/> &#215;
                S=<tal:v tal:replace="dev/severity"/> = Score
                <tal:v tal:replace="dev/risk_score"/> &#8212;
                <tal:v tal:replace="dev/risk_label"/>
              </div>
            </div>

            <div class="dev-grid-2 is-tight">
              <div class="dev-form-group">
                <label>Affected date from</label>
                <input type="date" name="affected_date_from" id="ws_date_from"
                       tal:attributes="value dev/affected_date_from"/>
              </div>
              <div class="dev-form-group">
                <label>Affected date to</label>
                <input type="date" name="affected_date_to" id="ws_date_to"
                       tal:attributes="value dev/affected_date_to"/>
              </div>
            </div>
            <div class="dev-form-group">
              <label>Affected worksheets</label>
              <!-- Method selector drives the worksheet lookup (not a saved field) -->
              <div class="dev-ws-row">
                <div class="dev-ws-cell">
                  <div class="dev-mini-label">Method</div>
                  <select id="ws_lookup_method">
                    <option value="">&#8212; select method &#8212;</option>
                    <tal:m tal:repeat="m view/available_methods">
                      <option tal:attributes="value m/id"
                              tal:content="m/title"/>
                    </tal:m>
                  </select>
                </div>
                <button type="button" id="ws_find_btn" onclick="findWorksheets()"
                        class="btn-sm btn-secondary">
                  Find Worksheets
                </button>
              </div>
              <!-- Results rendered by JS -->
              <div id="ws_results" class="dev-ws-results"></div>
              <!-- Actual saved field — auto-populated from checklist or manual -->
              <textarea name="affected_worksheets" id="ws_textarea" rows="2"
                        placeholder="IDs appear here automatically, or enter manually..."
                        tal:attributes="value python:', '.join(dev.get('affected_worksheets',[]))"/>
            </div>
            <div class="dev-form-group">
              <label>Scale description
                <span class="pfas-aux">(extent of affected data)</span>
              </label>
              <textarea name="scale_description" rows="3"
                        tal:content="dev/scale_description"/>
            </div>
            <div class="dev-form-group">
              <label>Root cause analysis</label>
              <textarea name="root_cause" rows="5"
                        tal:content="dev/root_cause"/>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
          </form>
        </tal:editable>

        <!-- Read-only view for closed records or users without edit rights -->
        <tal:readonly tal:condition="python:dev.get('status') == 'closed' or not view.can_edit()">
          <div class="dev-section-label">Affected Worksheets</div>
          <div class="dev-section-value">
            <tal:none tal:condition="python:not dev.get('affected_worksheets')">
              <em class="pfas-muted">None recorded</em>
            </tal:none>
            <tal:ws tal:condition="python:bool(dev.get('affected_worksheets'))">
              <tal:row tal:repeat="ws dev/affected_worksheets">
                <span class="cf-hint" tal:content="string:${ws} "/>
              </tal:row>
            </tal:ws>
          </div>
          <div class="dev-section-label">Date Range</div>
          <div class="dev-section-value">
            <tal:v tal:replace="dev/affected_date_from"/> — <tal:v tal:replace="dev/affected_date_to"/>
          </div>
          <div class="dev-section-label">Scale Description</div>
          <div class="dev-section-value">
            <tal:v tal:replace="dev/scale_description"/>
          </div>
          <div class="dev-section-label">Root Cause</div>
          <div class="dev-section-value">
            <tal:v tal:replace="dev/root_cause"/>
          </div>
        </tal:readonly>
      </tal:tab_rc>

      <!-- ── Tab: Corrective Actions ────────────────────────── -->
      <tal:tab_ca tal:condition="python:view.active_tab() == 'actions'">
        <tal:no_cas tal:condition="python:not dev.get('corrective_actions')">
          <div class="dev-empty">No corrective actions recorded yet.</div>
        </tal:no_cas>

        <tal:ca_list tal:repeat="ca dev/corrective_actions">
          <div class="ca-card">
            <div class="ca-card-header">
              <span tal:define="catype ca/type"
                    tal:attributes="class python:'ca-type-label ca-' + catype">
                <tal:v tal:replace="python:catype.replace('_',' ').title()"/>
              </span>
              <span tal:define="castatus ca/status"
                    tal:attributes="class python:'badge badge-' + ('closed' if castatus == 'complete' else 'open')">
                <tal:v tal:replace="python:'Complete' if castatus == 'complete' else 'Pending'"/>
              </span>
            </div>
            <div class="ca-desc" tal:content="ca/description"/>

            <!-- SOP Revision CA -->
            <tal:ca_sop tal:condition="python:ca.get('type') == 'sop_revision'">
              <tal:sop_id tal:condition="ca/sop_id">
                <div class="ca-meta">
                  SOP: <strong tal:content="ca/sop_id"/>
                  <tal:rev tal:condition="ca/new_rev_num">
                    — Rev <tal:v tal:replace="ca/new_rev_num"/>
                  </tal:rev>
                </div>
              </tal:sop_id>
              <tal:complete_btn tal:condition="python:ca.get('status') != 'complete' and view.can_manage() and dev.get('status') != 'closed'">
                <form method="post" class="pfas-inline-form"
                      tal:attributes="action string:${view/portal_url}/@@pfas-deviations">
                  <input type="hidden" name="action" value="complete_ca"/>
                  <input type="hidden" name="dev_id" tal:attributes="value dev/dev_id"/>
                  <input type="hidden" name="ca_id"  tal:attributes="value ca/ca_id"/>
                  <button type="submit" class="btn-sm btn-secondary">Mark Complete</button>
                </form>
              </tal:complete_btn>
            </tal:ca_sop>

            <!-- Training CA -->
            <tal:ca_training tal:condition="python:ca.get('type') == 'training'">
              <div class="ca-ack-list">
                <div class="ca-ack-title">
                  Required Acknowledgments
                </div>
                <tal:req_users tal:repeat="uid ca/required_users">
                  <div class="ca-ack-item"
                       tal:define="acks python:ca.get('acknowledgments',{});
                                    is_acked python:uid in acks">
                    <span tal:attributes="class python:'ca-ack-check' if is_acked else 'ca-ack-pend'">
                      <tal:y tal:condition="is_acked">&#10003;</tal:y>
                      <tal:n tal:condition="python:not is_acked">&#9675;</tal:n>
                    </span>
                    <span tal:content="uid"/>
                    <tal:acked tal:condition="is_acked">
                      <span class="pfas-aux">
                        (<tal:v tal:replace="python:acks[uid].get('acked_at','')[:10]"/>)
                      </span>
                    </tal:acked>
                  </div>
                </tal:req_users>
              </div>
              <!-- Acknowledge button for current user if required and not yet acked -->
              <tal:ack_btn tal:define="uid view/current_user_id;
                                       req python:ca.get('required_users',[]);
                                       acks python:ca.get('acknowledgments',{});
                                       can_ack python:uid in req and uid not in acks and ca.get('status') != 'complete'">
                <tal:show_ack tal:condition="can_ack">
                  <form method="post"
                        tal:attributes="action string:${view/portal_url}/@@pfas-deviations">
                    <input type="hidden" name="action" value="acknowledge_training"/>
                    <input type="hidden" name="dev_id" tal:attributes="value dev/dev_id"/>
                    <input type="hidden" name="ca_id"  tal:attributes="value ca/ca_id"/>
                    <button type="submit" class="btn-sm btn-primary">
                      I acknowledge this training
                    </button>
                  </form>
                </tal:show_ack>
              </tal:ack_btn>
              <!-- Manager complete override -->
              <tal:mgr_complete tal:condition="python:ca.get('status') != 'complete' and view.can_manage() and dev.get('status') != 'closed'">
                <form method="post" class="pfas-inline-form"
                      tal:attributes="action string:${view/portal_url}/@@pfas-deviations">
                  <input type="hidden" name="action" value="complete_ca"/>
                  <input type="hidden" name="dev_id" tal:attributes="value dev/dev_id"/>
                  <input type="hidden" name="ca_id"  tal:attributes="value ca/ca_id"/>
                  <button type="submit" class="btn-sm btn-secondary">Mark Complete</button>
                </form>
              </tal:mgr_complete>
            </tal:ca_training>

            <!-- Notification CA -->
            <tal:ca_notif tal:condition="python:ca.get('type') == 'notification'">
              <div class="ca-meta">
                <strong>Subtype:</strong>
                <span tal:replace="python:'Retest Offer' if ca.get('subtype') == 'retest' else 'Impact Notification'"/>
                &nbsp;&bull;&nbsp;
                <strong>Affected:</strong>
                <tal:ws tal:repeat="ws python:ca.get('affected_worksheets',[])">
                  <span class="cf-hint" tal:content="string:${ws} "/>
                </tal:ws>
              </div>
              <tal:notif_text tal:condition="ca/notification_text">
                <div class="ca-note-box"
                     tal:content="ca/notification_text"/>
              </tal:notif_text>
              <div class="ca-actions">
                <!-- View/print notification letter -->
                <a target="_blank"
                   tal:attributes="href string:${view/portal_url}/@@pfas-deviations?action=generate_notification&dev_id=${dev/dev_id}&ca_id=${ca/ca_id}"
                   class="btn-sm btn-secondary">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2"
                       stroke-linecap="round" stroke-linejoin="round"
                       class="ca-icon"
                       aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                    <line x1="10" y1="9" x2="8" y2="9"/>
                  </svg>
                  View Notification Letter
                </a>
                <!-- Mark sent button -->
                <tal:mark_sent tal:condition="python:ca.get('status') != 'complete' and view.can_manage() and dev.get('status') != 'closed'">
                  <form method="post" class="pfas-inline-form"
                        tal:attributes="action string:${view/portal_url}/@@pfas-deviations">
                    <input type="hidden" name="action" value="mark_notification_sent"/>
                    <input type="hidden" name="dev_id" tal:attributes="value dev/dev_id"/>
                    <input type="hidden" name="ca_id"  tal:attributes="value ca/ca_id"/>
                    <button type="submit" class="btn-sm btn-primary">
                      Mark as Sent
                    </button>
                  </form>
                </tal:mark_sent>
                <tal:sent_at tal:condition="ca/sent_at">
                  <span class="pfas-aux">
                    Sent <tal:v tal:replace="python:ca.get('sent_at','')[:10]"/>
                  </span>
                </tal:sent_at>
              </div>
            </tal:ca_notif>

            <tal:completed_info tal:condition="python:ca.get('completed_at')">
              <div class="pfas-aux">
                Completed <tal:v tal:replace="python:ca.get('completed_at','')[:10]"/>
                by <tal:v tal:replace="python:ca.get('completed_by','')"/>
              </div>
            </tal:completed_info>
          </div><!-- /ca-card -->
        </tal:ca_list>

        <!-- Add CA form (manager, non-closed) -->
        <tal:add_ca_section tal:condition="python:view.can_manage() and dev.get('status') != 'closed'">
          <div class="ca-add-section">
            <div class="ca-add-title">+ Add Corrective Action</div>
            <form method="post" id="add-ca-form"
                  tal:attributes="action string:${view/portal_url}/@@pfas-deviations">
              <input type="hidden" name="action" value="add_corrective_action"/>
              <input type="hidden" name="dev_id" tal:attributes="value dev/dev_id"/>

              <!-- CA type selector -->
              <div class="dev-form-group">
                <label>Type</label>
                <div class="ca-type-options">
                  <button type="button" class="ca-type-opt selected"
                          onclick="selectCAType(this,'sop_revision')">SOP Revision</button>
                  <button type="button" class="ca-type-opt"
                          onclick="selectCAType(this,'training')">Training</button>
                  <button type="button" class="ca-type-opt"
                          onclick="selectCAType(this,'notification')">Notification</button>
                </div>
                <input type="hidden" name="ca_type" id="ca_type_input" value="sop_revision"/>
              </div>

              <div class="dev-form-group">
                <label>Description</label>
                <textarea name="ca_description" rows="3"
                          placeholder="Describe this corrective action..."></textarea>
              </div>

              <!-- SOP Revision fields -->
              <div id="ca-fields-sop_revision">
                <div class="dev-form-group">
                  <label>SOP reference (optional)</label>
                  <input type="text" name="ca_sop_id"
                         placeholder="e.g. SOP-001"/>
                </div>
              </div>

              <!-- Training fields -->
              <div id="ca-fields-training" hidden="hidden">
                <div class="dev-form-group">
                  <label>Required users
                    <span class="pfas-aux">(comma-separated user IDs)</span>
                  </label>
                  <input type="text" name="ca_required_users"
                         placeholder="e.g. jsmith, bjones"/>
                </div>
              </div>

              <!-- Notification fields -->
              <div id="ca-fields-notification" hidden="hidden">
                <div class="dev-form-group">
                  <label>Notification type</label>
                  <select name="ca_subtype">
                    <option value="impact">Impact Notification</option>
                    <option value="retest">Retest Offer</option>
                  </select>
                </div>
                <div class="dev-form-group">
                  <label>Affected worksheets
                    <span class="pfas-aux">(comma-separated)</span>
                  </label>
                  <input type="text" name="ca_affected_ws"
                         tal:attributes="value python:', '.join(dev.get('affected_worksheets',[]))"/>
                </div>
                <div class="dev-form-group">
                  <label>Notification text</label>
                  <textarea name="ca_notification_text" rows="5"
                            placeholder="Text to be included in the notification letter..."></textarea>
                </div>
              </div>

              <button type="submit" class="btn-sm btn-primary">Add Corrective Action</button>
            </form>
          </div>
        </tal:add_ca_section>
      </tal:tab_ca>

      <!-- ── Tab: Closure ───────────────────────────────────── -->
      <tal:tab_closure tal:condition="python:view.active_tab() == 'closure'">
        <tal:already_closed tal:condition="python:dev.get('status') == 'closed'">
          <div class="alert alert-success">
            This record was closed on
            <strong tal:content="python:dev.get('closed_at','')[:10]"/>
            by <strong tal:content="dev/closed_by"/>.
          </div>
          <tal:notes tal:condition="dev/closure_notes">
            <div class="dev-section-label">Closure Notes</div>
            <div class="dev-section-value" tal:content="dev/closure_notes"/>
          </tal:notes>
        </tal:already_closed>

        <tal:not_closed tal:condition="python:dev.get('status') != 'closed'">
          <!-- CA completion checklist -->
          <div class="pfas-mt">
            <div class="closure-title">Corrective Action Status</div>
            <tal:no_cas tal:condition="python:not dev.get('corrective_actions')">
              <div class="closure-check">
                <span class="icon-nok">&#10007;</span>
                No corrective actions defined
              </div>
            </tal:no_cas>
            <tal:cas tal:repeat="ca dev/corrective_actions">
              <div class="closure-check">
                <span tal:attributes="class python:'icon-ok' if ca.get('status') == 'complete' else 'icon-nok'">
                  <tal:y tal:condition="python:ca.get('status') == 'complete'">&#10003;</tal:y>
                  <tal:n tal:condition="python:ca.get('status') != 'complete'">&#10007;</tal:n>
                </span>
                <span tal:content="python:ca.get('type','').replace('_',' ').title()"/>:
                <span class="pfas-muted" tal:content="ca/description"/>
              </div>
            </tal:cas>
          </div>

          <!-- Closure form (manager only, all CAs complete) -->
          <tal:mgr_close tal:condition="view/can_manage">
            <form method="post"
                  tal:attributes="action string:${view/portal_url}/@@pfas-deviations">
              <input type="hidden" name="action" value="close_deviation"/>
              <input type="hidden" name="dev_id" tal:attributes="value dev/dev_id"/>
              <div class="dev-form-group">
                <label>Closure notes / QAO sign-off</label>
                <textarea name="closure_notes" rows="4"
                          placeholder="Confirm all corrective actions are effective and the non-conformance is resolved..."></textarea>
              </div>
              <button type="submit" class="btn btn-danger"
                      tal:attributes="disabled python:'' if dev.get('all_cas_complete') else 'disabled'">
                Close <tal:v tal:replace="python:dev.get('type','').upper()"/> (QAO Sign-off)
              </button>
              <tal:pending_msg tal:condition="python:not dev.get('all_cas_complete')">
                <span class="closure-note">
                  All corrective actions must be complete before closure.
                </span>
              </tal:pending_msg>
            </form>
          </tal:mgr_close>
        </tal:not_closed>
      </tal:tab_closure>

    </tal:found>

    <tal:notfound tal:condition="python:not dev">
      <div class="alert alert-error">Record not found.</div>
    </tal:notfound>
  </tal:dev>
  </tal:detail>

  <!-- ══ LIST VIEW ════════════════════════════════════════════════════════ -->
  <tal:listview tal:condition="python:not view.is_detail_view()">

    <!-- Filters: status and type as segmented links -->
    <div class="pfas-filterbar">
      <div class="pfas-field">
        <span>Status</span>
        <nav class="pfas-seg" aria-label="Status">
          <a class="pfas-seg-item" tal:repeat="o python:(('', u'All'), ('open', u'Open'), ('in_progress', u'In Progress'), ('closed', u'Closed'))"
             tal:attributes="aria-selected python:'true' if view.filter_status() == o[0] else 'false';
                             href python:view.filter_url(status=o[0])"
             tal:content="python:o[1]">All</a>
        </nav>
      </div>
      <div class="pfas-field">
        <span>Type</span>
        <nav class="pfas-seg" aria-label="Type">
          <a class="pfas-seg-item" tal:repeat="o python:(('', u'All'), ('deviation', u'Deviations'), ('car', u'CARs'))"
             tal:attributes="aria-selected python:'true' if view.filter_type() == o[0] else 'false';
                             href python:view.filter_url(type_=o[0])"
             tal:content="python:o[1]">All</a>
        </nav>
      </div>
    </div>

    <!-- List table -->
    <tal:devs tal:define="devs view/list_deviations">
      <tal:empty tal:condition="python:not devs">
        <div class="dev-empty">No records found.</div>
      </tal:empty>

      <tal:notempty tal:condition="devs">
        <div class="table-wrap">
        <table class="pfas-table dev-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Type</th>
              <th>Filed</th>
              <th>Event</th>
              <th>Risk</th>
              <th>CAs</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tal:row tal:repeat="dev devs">
              <tr>
                <td class="pfas-cell-name"
                    tal:content="dev/dev_id"/>
                <td>
                  <span tal:define="dtype dev/type"
                        tal:attributes="class python:'badge badge-' + dtype">
                    <tal:v tal:replace="python:dtype.upper()"/>
                  </span>
                </td>
                <td class="pfas-muted"
                    tal:content="dev/filed_at"/>
                <td tal:content="dev/event_label"/>
                <td>
                  <span tal:define="rscore dev/risk_score"
                        tal:attributes="class python:'badge risk-' + dev['risk_colour']">
                    <tal:v tal:replace="rscore"/>
                  </span>
                </td>
                <td>
                  <tal:pending tal:condition="python:dev.get('ca_pending', 0) > 0">
                    <span class="exp-warning">
                      <tal:v tal:replace="dev/ca_pending"/> / <tal:v tal:replace="dev/ca_count"/>
                    </span>
                  </tal:pending>
                  <tal:done tal:condition="python:dev.get('ca_pending', 0) == 0">
                    <span class="pfas-muted">
                      <tal:v tal:replace="dev/ca_count"/> total
                    </span>
                  </tal:done>
                </td>
                <td>
                  <span tal:define="dstatus dev/status"
                        tal:attributes="class python:'badge badge-' + dstatus">
                    <tal:v tal:replace="python:dstatus.replace('_',' ').title()"/>
                  </span>
                </td>
                <td>
                  <a class="btn-sm btn-secondary"
                     tal:attributes="href string:${view/portal_url}/@@pfas-deviations?dev_id=${dev/dev_id}">
                    View &#8594;
                  </a>
                </td>
              </tr>
            </tal:row>
          </tbody>
        </table>
        </div>
      </tal:notempty>
    </tal:devs>
  </tal:listview>

</div><!-- /dev-page -->
</metal:content>

<!-- ══ New Deviation/CAR modal ══════════════════════════════════════════ -->
<metal:extra metal:fill-slot="body-extra">
<div class="pfas-modal" id="new-dev-modal">
  <div class="pfas-modal-box">
    <h2 id="new-dev-modal-title">File New Deviation</h2>
    <form method="post"
          tal:attributes="action string:${view/portal_url}/@@pfas-deviations">
      <input type="hidden" name="action" value="file_deviation"/>
      <input type="hidden" name="type" id="new-dev-type" value="deviation"/>

      <div class="dev-form-group">
        <label>Event type</label>
        <select name="event_type">
          <tal:opts tal:repeat="evt view/event_types">
            <option tal:attributes="value python:evt[0]"
                    tal:content="python:evt[1]"/>
          </tal:opts>
        </select>
      </div>

      <div class="dev-form-group">
        <label>Event date</label>
        <input type="date" name="event_date"
               id="new-dev-date"/>
      </div>

      <div class="dev-form-group">
        <label>Description</label>
        <textarea name="description" rows="4" required="required"
                  placeholder="Describe the non-conformance or event..."></textarea>
      </div>

      <!-- Interactive risk matrix -->
      <div class="dev-form-group">
        <label>Risk assessment — click a cell to set likelihood × severity</label>
        <div class="risk-matrix-wrap">
          <table class="risk-matrix" id="new-dev-risk-matrix">
            <tr>
              <td class="rm-axis">L\S</td>
              <td class="rm-axis">S=1<br/><span class="rm-sub">Insig.</span></td>
              <td class="rm-axis">S=2<br/><span class="rm-sub">Minor</span></td>
              <td class="rm-axis">S=3<br/><span class="rm-sub">Moderate</span></td>
              <td class="rm-axis">S=4<br/><span class="rm-sub">Major</span></td>
              <td class="rm-axis">S=5<br/><span class="rm-sub">Catastrop.</span></td>
            </tr>
            <tal:lrow tal:repeat="li python:[5,4,3,2,1]">
              <tr>
                <td class="rm-axis">
                  L=<tal:v tal:replace="li"/><br/>
                  <span class="rm-sub"
                        tal:replace="python:view.likelihood_label(li).split(' — ')[1] if ' — ' in view.likelihood_label(li) else ''"/>
                </td>
                <tal:scol tal:repeat="si python:[1,2,3,4,5]">
                  <td tal:define="score python:li * si;
                                   colour python:view.risk_colour_for(li, si)"
                      tal:attributes="class python:'rm-cell clickable risk-' + colour;
                                      data-l string:${li};
                                      data-s string:${si}">
                    <tal:v tal:replace="score"/>
                  </td>
                </tal:scol>
              </tr>
            </tal:lrow>
          </table>
        </div>
        <div class="risk-score-display risk-green" id="new-dev-score-display"
             hidden="hidden">
          Score — —
        </div>
        <input type="hidden" name="likelihood" id="new-dev-likelihood" value="3"/>
        <input type="hidden" name="severity"   id="new-dev-severity"   value="3"/>
      </div>

      <div class="form-actions is-end">
        <button type="button" class="btn btn-secondary"
                onclick="closeDevModal()">Cancel</button>
        <button type="submit" class="btn btn-primary">File Record</button>
      </div>
    </form>
  </div>
</div>
</metal:extra>

<metal:scripts metal:fill-slot="scripts">
<script>
(function() {
  var _x  = String.fromCharCode(215);   // multiplication sign ×
  var _nd = String.fromCharCode(8211);  // en dash –

  // ── Modal ─────────────────────────────────────────────────────────────
  /* the top bar's "+" menu lands here with ?new=deviation */
  window.pfasOpenNew = function (kind) { openDevModal(kind === 'car' ? 'car' : 'deviation'); };
  function openDevModal(type) {
    var modal = document.getElementById('new-dev-modal');
    var title = document.getElementById('new-dev-modal-title');
    var typeInput = document.getElementById('new-dev-type');
    var dateInput = document.getElementById('new-dev-date');
    if (!modal) return;
    typeInput.value = type;
    title.textContent = type === 'car' ? 'File New CAR' : 'File New Deviation';
    var today = new Date().toISOString().split('T')[0];
    if (dateInput && !dateInput.value) { dateInput.value = today; }
    modal.classList.add('open');
    document.addEventListener('keydown', escHandler);
  }
  function closeDevModal() {
    var modal = document.getElementById('new-dev-modal');
    if (modal) { modal.classList.remove('open'); }
    document.removeEventListener('keydown', escHandler);
  }
  function escHandler(e) {
    if (e.key === 'Escape') { closeDevModal(); }
  }
  // Click outside to close
  document.addEventListener('click', function(e) {
    var modal = document.getElementById('new-dev-modal');
    if (modal && modal.classList.contains('open') && e.target === modal) {
      closeDevModal();
    }
  });
  // Expose to global scope
  window.openDevModal = openDevModal;
  window.closeDevModal = closeDevModal;

  // ── Interactive risk matrix ────────────────────────────────────────────
  // the risk scale in the site's tokens: mint low, amber, coral high
  var colours = {green:'var(--s-success-lt)',yellow:'var(--s-warn-lt)',orange:'var(--s-warning)',red:'var(--s-danger-dk)'};
  var textColours = {green:'var(--s-success-text)',yellow:'var(--s-warn-text)',orange:'var(--s-body)',red:'var(--s-bg)'};
  function scoreToColour(s) {
    return s <= 4 ? 'green' : s <= 9 ? 'yellow' : s <= 14 ? 'orange' : 'red';
  }
  function scoreToLabel(s) {
    return s <= 4 ? 'Low' : s <= 9 ? 'Medium' : s <= 14 ? 'High' : 'Critical';
  }
  var matrix = document.getElementById('new-dev-risk-matrix');
  if (matrix) {
    matrix.addEventListener('click', function(e) {
      var cell = e.target.closest('[data-l]');
      if (!cell) { return; }
      var l = parseInt(cell.getAttribute('data-l'), 10);
      var s = parseInt(cell.getAttribute('data-s'), 10);
      var score = l * s;
      var colour = scoreToColour(score);
      // Update hidden inputs
      document.getElementById('new-dev-likelihood').value = l;
      document.getElementById('new-dev-severity').value = s;
      // Clear previous selection highlight
      var cells = matrix.querySelectorAll('[data-l]');
      for (var i = 0; i < cells.length; i++) {
        cells[i].classList.remove('rm-selected');
      }
      cell.classList.add('rm-selected');
      // Update score display
      var disp = document.getElementById('new-dev-score-display');
      if (disp) {
        disp.hidden = false;
        disp.className = 'risk-score-display risk-' + colour;
        disp.textContent = 'L=' + l + ' ' + _x + ' S=' + s + ' = Score ' + score + ' (' + _nd + ' ' + scoreToLabel(score) + ')';
      }
    });
  }

  // ── Add CA type switcher ───────────────────────────────────────────────
  function selectCAType(btn, type) {
    // Deselect all
    var btns = document.querySelectorAll('.ca-type-opt');
    for (var i = 0; i < btns.length; i++) {
      btns[i].classList.remove('selected');
    }
    btn.classList.add('selected');
    document.getElementById('ca_type_input').value = type;
    // Show/hide conditional fields
    var types = ['sop_revision', 'training', 'notification'];
    for (var j = 0; j < types.length; j++) {
      var el = document.getElementById('ca-fields-' + types[j]);
      if (el) { el.hidden = types[j] !== type; }
    }
  }
  window.selectCAType = selectCAType;

  // ── Detail view risk matrix (Scale & Root Cause tab) ───────────────────
  var detailMatrix = document.getElementById('detail-risk-matrix');
  if (detailMatrix) {
    var dlInput = document.getElementById('detail-likelihood');
    var dsInput = document.getElementById('detail-severity');
    var dDisp   = document.getElementById('detail-score-display');

    function initDetailMatrix() {
      var curL = parseInt(dlInput.value, 10);
      var curS = parseInt(dsInput.value, 10);
      var dcells = detailMatrix.querySelectorAll('[data-l]');
      for (var i = 0; i < dcells.length; i++) {
        var cl = parseInt(dcells[i].getAttribute('data-l'), 10);
        var cs = parseInt(dcells[i].getAttribute('data-s'), 10);
        if (cl === curL && cs === curS) {
          dcells[i].classList.add('rm-selected');
        } else {
          dcells[i].classList.remove('rm-selected');
        }
      }
    }
    initDetailMatrix();

    detailMatrix.addEventListener('click', function(e) {
      var cell = e.target.closest('[data-l]');
      if (!cell) { return; }
      var l = parseInt(cell.getAttribute('data-l'), 10);
      var s = parseInt(cell.getAttribute('data-s'), 10);
      var score = l * s;
      var colour = scoreToColour(score);
      dlInput.value = l;
      dsInput.value = s;
      var dcells = detailMatrix.querySelectorAll('[data-l]');
      for (var i = 0; i < dcells.length; i++) {
        dcells[i].classList.remove('rm-selected');
      }
      cell.classList.add('rm-selected');
      if (dDisp) {
        dDisp.hidden = false;
        dDisp.className = 'risk-score-display risk-' + colour;
        dDisp.textContent = 'L=' + l + ' ' + _x + ' S=' + s + ' = Score ' + score + ' ' + _nd + ' ' + scoreToLabel(score);
      }
    });
  }

  // ── Worksheet auto-lookup ──────────────────────────────────────────────
  var _pfasBase = '';
  try {
    var _b = document.querySelector('base');
    _pfasBase = _b ? _b.href.replace(/\/$/, '') : window.location.origin;
  } catch(e) {}

  function findWorksheets() {
    var sel   = document.getElementById('ws_lookup_method');
    var dfrom = document.getElementById('ws_date_from');
    var dto   = document.getElementById('ws_date_to');
    var btn   = document.getElementById('ws_find_btn');
    var res   = document.getElementById('ws_results');
    if (!sel || !sel.value) {
      res.innerHTML = '<em class="is-error">Please select a method first.</em>';
      return;
    }
    var url = _pfasBase + '/@@pfas-deviations?action=lookup_worksheets'
      + '&method_id=' + encodeURIComponent(sel.value)
      + '&date_from=' + encodeURIComponent(dfrom ? dfrom.value : '')
      + '&date_to='   + encodeURIComponent(dto   ? dto.value   : '');
    btn.disabled = true;
    btn.textContent = 'Searching...';
    res.innerHTML = '';
    fetch(url)
      .then(function(r) { return r.json(); })
      .then(function(data) { renderWsResults(data.results || []); })
      .catch(function() { res.innerHTML = '<em class="is-error">Search failed.</em>'; })
      .finally(function() { btn.disabled = false; btn.textContent = 'Find Worksheets'; });
  }

  function renderWsResults(worksheets) {
    var res      = document.getElementById('ws_results');
    var textarea = document.getElementById('ws_textarea');
    var current  = textarea
      ? (textarea.value || '').split(',').map(function(s) { return s.trim(); }).filter(Boolean)
      : [];
    if (!worksheets.length) {
      res.innerHTML = '<em class="is-muted">No worksheets found for this method and date range.</em>';
      return;
    }
    var html = '<div class="dev-ws-count">'
             + worksheets.length + ' worksheet(s) found \u2014 check to include:</div>'
             + '<div class="dev-ws-list">';
    worksheets.forEach(function(ws) {
      var checked = current.indexOf(ws.id) >= 0 ? 'checked' : '';
      html += '<label>'
            + '<input type="checkbox" class="ws-check" value="' + ws.id + '" '
            + checked + ' onchange="syncWorksheets()">&nbsp;'
            + '<code>' + ws.id + '</code>'
            + (ws.created ? ' <span class="pfas-aux">(' + ws.created + ')</span>' : '')
            + '</label>';
    });
    html += '</div>';
    res.innerHTML = html;
  }

  function syncWorksheets() {
    var textarea = document.getElementById('ws_textarea');
    if (!textarea) return;
    var checks = document.querySelectorAll('.ws-check:checked');
    var ids = [];
    for (var i = 0; i < checks.length; i++) { ids.push(checks[i].value); }
    textarea.value = ids.join(', ');
  }
  window.findWorksheets   = findWorksheets;
  window.syncWorksheets   = syncWorksheets;

})();
</script>
</metal:scripts>

</body>
</html>
