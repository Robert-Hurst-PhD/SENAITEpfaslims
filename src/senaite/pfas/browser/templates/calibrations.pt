<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Calibration Review</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
  .cal-page { max-width:1400px; }

  /* Stats row */
  .stat-bar { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px; }
  .stat-box { background:var(--s-bg); border-radius:6px; padding:10px 16px;
              border:1px solid var(--s-border);
              box-shadow:0 1px 3px rgba(0,0,0,.06); min-width:80px; text-align:center; }
  .stat-box .sv { font-size:var(--fs-xl); font-weight:700; color:var(--s-dark); }
  .stat-box .sl { font-size:var(--fs-xs); color:var(--s-secondary); text-transform:uppercase;
                  letter-spacing:.05em; margin-top:2px; }
  .stat-box.good .sv { color:var(--s-success); }
  .stat-box.warn .sv { color:var(--s-warning); }

  /* Filter bar */
  .filter-bar { background:var(--s-bg); border-radius:6px;
                border:1px solid var(--s-border);
                padding:10px 14px; margin-bottom:14px;
                display:flex; flex-wrap:wrap; gap:10px; align-items:flex-end; }
  .filter-bar label { font-size:var(--fs-xs); color:var(--s-secondary); font-weight:700;
                      text-transform:uppercase; display:block; margin-bottom:2px; }
  .filter-bar select, .filter-bar input[type=number] {
    padding:5px 8px; border:1px solid var(--s-input-border); border-radius:4px;
    font-size:var(--fs-base); background:#fafafa; color:var(--s-input-text); }

  /* Run-date pills */
  .run-pills { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; }
  .run-pill { padding:5px 14px; border-radius:20px; border:1px solid var(--s-border);
              font-size:var(--fs-sm); font-weight:600; cursor:pointer; background:var(--s-bg);
              color:var(--s-body); transition:all .15s; }
  .run-pill:hover { border-color:var(--s-primary); color:var(--s-primary); }
  .run-pill.active { background:var(--s-primary); color:#fff; border-color:var(--s-primary); }

  /* Run section */
  .run-section { margin-bottom:28px; }
  .run-header { display:flex; align-items:center; gap:12px; flex-wrap:wrap;
                padding:10px 0; border-bottom:2px solid var(--s-border);
                margin-bottom:14px; }
  .run-header h3 { margin:0; font-size:var(--fs-md); font-weight:700; flex:1; }
  .run-header .run-meta { font-size:var(--fs-sm); color:var(--s-secondary); }
  .pass-badge { padding:3px 12px; border-radius:12px; font-size:var(--fs-sm); font-weight:700;
                white-space:nowrap; }
  .pass-ok   { background:var(--s-primary-lt); color:var(--s-primary); }
  .pass-fail { background:#f8d7da; color:#721c24; }

  /* Analyte card grid */
  .analyte-grid { display:grid;
                  grid-template-columns:repeat(auto-fill, minmax(360px, 1fr));
                  gap:14px; margin-bottom:14px; }
  .analyte-card { background:var(--s-bg); border:1px solid var(--s-border);
                  border-radius:8px; box-shadow:0 1px 4px rgba(0,0,0,.07);
                  overflow:hidden; }
  .card-head { padding:10px 14px 8px; border-bottom:1px solid var(--s-border);
               display:flex; align-items:center; gap:8px; }
  .card-head .analyte-name { font-size:var(--fs-base); font-weight:700; flex:1; color:var(--s-dark); }
  .r2-badge { padding:2px 10px; border-radius:10px; font-size:var(--fs-xs); font-weight:700; }
  .r2-ok   { background:var(--s-primary-lt); color:var(--s-primary); }
  .r2-fail { background:#f8d7da; color:#721c24; }
  .r2-na   { background:var(--s-bg-alt); color:var(--s-secondary); }
  /* .badge base is global; page-specific badge colours: */
  .badge-pending  { background:#fff3cd; color:#856404; }
  .badge-approved { background:#d4edda; color:#155724; }
  .badge-rejected { background:#f8d7da; color:#721c24; }

  /* Controls strip */
  .card-controls { display:flex; gap:8px; align-items:center; flex-wrap:wrap;
                   padding:6px 14px; background:#f8f9fa;
                   border-bottom:1px solid var(--s-border); }
  .card-controls label { font-size:var(--fs-xs); color:var(--s-secondary); font-weight:700;
                         text-transform:uppercase; }
  .card-controls select { font-size:var(--fs-xs); padding:3px 6px;
                          border:1px solid var(--s-input-border); border-radius:3px;
                          background:#fff; color:var(--s-input-text); }
  .save-ovr { font-size:var(--fs-xs); padding:3px 10px; border:none; border-radius:3px;
              cursor:pointer; background:var(--s-primary); color:#fff; }
  .save-ovr:hover { opacity:.85; }

  /* Plots */
  .card-plots { padding:10px 12px; }
  .plot-section { margin-bottom:10px; }
  .plot-label { font-size:var(--fs-xs); font-weight:700; color:var(--s-secondary);
                text-transform:uppercase; letter-spacing:.04em; margin-bottom:4px; }
  .plot-canvas-wrap { position:relative; height:170px; }
  .plot-canvas-wrap.plot-sm { height:110px; }
  .plot-empty { height:80px; display:flex; align-items:center; justify-content:center;
                font-size:var(--fs-xs); color:var(--s-secondary); font-style:italic; }

  .eq-line { font-size:var(--fs-xs); color:var(--s-secondary); font-family: var(--font-mono);
             padding:4px 14px 8px; overflow:hidden; text-overflow:ellipsis;
             white-space:nowrap; }

  /* Response-ratio info icon */
  .rr-info { color:var(--s-secondary); cursor:help; font-size:var(--fs-xs);
             margin-left:3px; border:1px solid var(--s-border);
             border-radius:50%; padding:0 3px; font-style:normal; }

  /* CCB blank chips */
  .ccb-chips { display:flex; gap:6px; flex-wrap:wrap;
               padding:3px 12px 6px; }
  .ccb-chip { padding:2px 10px; border-radius:12px; font-size:var(--fs-xs); font-weight:600; }
  .ccb-chip.pass { background:#d4edda; color:#155724; }
  .ccb-chip.fail { background:#f8d7da; color:#721c24; }

  /* Point-detail modal */
  .cal-detail-modal { position:fixed; top:0; left:0; width:100%; height:100%;
    background:rgba(0,0,0,.48); z-index:9999;
    display:none; align-items:center; justify-content:center; }
  .cal-detail-modal.open { display:flex; }
  .cal-detail-box { background:#fff; border-radius:10px; padding:22px 24px;
    max-width:400px; width:92%; box-shadow:0 8px 32px rgba(0,0,0,.22); }
  .cal-detail-box h4 { margin:0 0 14px; font-size:var(--fs-base); display:flex;
    align-items:center; gap:8px; }
  .cal-detail-close { margin-left:auto; background:none; border:none;
    cursor:pointer; font-size:var(--fs-xl); color:#666; line-height:1; }
  .cal-detail-table { width:100%; border-collapse:collapse; }
  .cal-detail-table td { padding:4px 0; font-size:var(--fs-sm); }
  .cal-detail-table td:first-child { font-weight:600; color:#666;
    padding-right:14px; white-space:nowrap; width:42%; }

  /* Approve bar */
  .approve-bar { display:flex; align-items:center; gap:12px; flex-wrap:wrap;
                 padding:10px 14px; background:var(--s-bg);
                 border:1px solid var(--s-border); border-radius:6px; margin-top:4px; }
  .approve-bar .approve-label { font-size:var(--fs-sm); font-weight:600; flex:1; }

  .save-banner { background:#d4edda; border:1px solid #c3e6cb; border-radius:4px;
                 padding:8px 14px; margin-bottom:12px; color:#155724; font-weight:600; }
  .empty-state { text-align:center; padding:48px; color:var(--s-secondary); }
  .pf-path { font-size:var(--fs-xs); color:var(--s-secondary); margin-top:12px; }
  </style>
  </tal:styles>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Calibration Review</tal:t>
  <tal:r metal:fill-slot="header-context">
    <span class="header-meta" tal:define="r2 view/r2_minimum; pct view/cal_pct_max">
      <tal:m condition="view/selected_method">
        R&sup2; min <strong tal:content="python:r2 if r2 is not None else 'not set'">0.99</strong>
        &bull; Max dev <strong tal:content="python:('%g%%' % pct) if pct is not None else 'not set'">20%</strong>
      </tal:m>
      <tal:all condition="not:view/selected_method">Limits: each run&#8217;s method profile</tal:all>
    </span>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="cal-page page-body">

    <div class="save-banner" tal:condition="view/save_message">
      <tal:sm tal:replace="python:'Run approved.' if 'approved' in view.save_message() else 'Calibration updated.'">Updated.</tal:sm>
    </div>

    <!-- Summary stats -->
    <tal:stats tal:define="stats view/summary_stats">
      <div class="stat-bar" tal:condition="stats">
        <div class="stat-box">
          <div class="sv" tal:content="stats/total">0</div>
          <div class="sl">Total</div>
        </div>
        <div class="stat-box good">
          <div class="sv" tal:content="stats/r2_pass">0</div>
          <div class="sl">R&sup2; Pass</div>
        </div>
        <div class="stat-box warn">
          <div class="sv" tal:content="stats/pending">0</div>
          <div class="sl">Pending</div>
        </div>
        <div class="stat-box good">
          <div class="sv" tal:content="stats/approved">0</div>
          <div class="sl">Approved</div>
        </div>
        <div class="stat-box warn">
          <div class="sv" tal:content="stats/rejected">0</div>
          <div class="sl">Rejected</div>
        </div>
      </div>
    </tal:stats>

    <!-- Filter bar -->
    <form method="GET" class="filter-bar"
          tal:attributes="action string:${context/absolute_url}/@@pfas-calibrations">
      <div>
        <label>Analyte</label>
        <select name="analyte">
          <option value="">&#8212; All &#8212;</option>
          <tal:opts tal:repeat="a view/analytes">
            <option tal:content="a"
                    tal:attributes="value a; selected python:a == view.selected_analyte()">PFOA</option>
          </tal:opts>
        </select>
      </div>
      <div>
        <label>Status</label>
        <select name="status">
          <option value="">&#8212; All &#8212;</option>
          <option value="pending"
                  tal:attributes="selected python:view.selected_status()=='pending'">Pending</option>
          <option value="approved"
                  tal:attributes="selected python:view.selected_status()=='approved'">Approved</option>
          <option value="rejected"
                  tal:attributes="selected python:view.selected_status()=='rejected'">Rejected</option>
        </select>
      </div>
      <div>
        <label>Show last</label>
        <input type="number" name="limit" min="1" max="300"
               tal:attributes="value view/selected_limit"
               style="width:72px" />
      </div>
      <button type="submit" class="btn btn-primary">Apply</button>
    </form>

    <!-- Run-date pills -->
    <tal:rdates tal:define="run_dates view/run_dates; sel_rd view/selected_run_date">
    <div class="run-pills" tal:condition="run_dates">
      <span tal:attributes="class python:'run-pill active' if not sel_rd else 'run-pill'"
            onclick="filterRun('')">All runs</span>
      <tal:rp tal:repeat="rd run_dates">
        <tal:rpill tal:define="rd_json python:rd; is_active python:rd == sel_rd">
          <span tal:attributes="class python:'run-pill active' if is_active else 'run-pill';
                                onclick string:filterRun('${rd_json}')"
                tal:content="rd">2026-06-08</span>
        </tal:rpill>
      </tal:rp>
    </div>
    </tal:rdates>

    <!-- Card area: populated from embedded JSON by JS -->
    <div id="cal-runs-area"></div>

    <p class="pf-path">
      /data/qc/pfas_qc_results.db &rarr; calibrations + calibration_levels + qc_results
    </p>

  </div>

  <!-- Embed run data as JSON -->
  <tal:rjson tal:define="runs_json view/calibration_runs_json">
  <script>
  var CAL_RUNS  = <tal:x tal:replace="runs_json">[]</tal:x>;
  var CAL_URL   = '<tal:u tal:replace="context/absolute_url">.</tal:u>/@@pfas-calibrations';
  /* Limits come from each analyte's own run method profile (cal.limits,
     cal.r2_min); null = the method sets none -> not judged, no limit line. */
  var CAL_BY_UID = {};
  function limFor(uid) {
    var c = CAL_BY_UID[uid] || {};
    var L = c.limits || {};
    return {CAL: L.CAL || {}, ICV: L.ICV || {}, CCV: L.CCV || {}, r2: c.r2_min};
  }
  var IS_MGR    = <tal:x tal:replace="python:'true' if view.is_manager() else 'false'">false</tal:x>;
  </script>
  </tal:rjson>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/vendor/chartjs-plugin-annotation-3.1.0.min.js"></script>
  <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/vendor/ml-matrix-6.12.1.umd.js"></script>
  <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/calibration_fit.js?v=1"></script>
  <script>
  //<![CDATA[
  // ── Weighted regression helpers ───────────────────────────────────────────
  /* Curve maths: static/calibration_fit.js (least squares by ml-matrix QR,
     closed-form inverse, R² with the fit's own weights; REUSE_REVIEW U2).
     computeFn returns a callable curve carrying its model, so the plotting
     code below draws it as before. */
  function computeFn(pts, fitType, wtype, origin) {
    var m = PFASCalFit.fit(pts, {type: fitType, weight: wtype, origin: origin});
    if (!m) return null;
    var f = function (x) { return m.f(x); };
    f.model = m;
    return f;
  }

  function computeR2(pts, fn) {
    return fn ? PFASCalFit.r2(pts, fn.model) : null;
  }

  function backCalc(fn, y) {
    if (!fn || y == null) return null;
    var x = fn.model.inverse(y);
    return (x != null && x >= 0) ? x : null;
  }

  // ── Chart colours — derived from site CSS tokens so they track the theme ───
  var _css = getComputedStyle(document.documentElement);
  function _tok(n){ return (_css.getPropertyValue(n)||'').trim(); }
  function _rgba(cssVar, a){
    var h = _tok(cssVar).replace('#','');
    if (!h||h.length<6) return 'rgba(128,128,128,'+a+')';
    return 'rgba('+parseInt(h.substr(0,2),16)+','+parseInt(h.substr(2,2),16)+','+parseInt(h.substr(4,2),16)+','+a+')';
  }
  var cOK   = _rgba('--s-success',   0.85);
  var cFail = _rgba('--s-danger',    0.85);
  var cLine = _rgba('--s-primary',   0.85);
  var cIdeal= _rgba('--s-secondary', 0.40);

  // ── Chart registry ────────────────────────────────────────────────────────
  var _ch = {};
  function destroyCard(uid) {
    ['c1','c2','c3'].forEach(function(k){
      var key=uid+k; if(_ch[key]){_ch[key].destroy();delete _ch[key];}
    });
  }

  // ── Helpers ───────────────────────────────────────────────────────────────
  function _fmtCoeff(v, first) {
    var s = v.toExponential(4);
    if (first) return s;
    return v < 0 ? ' − '+Math.abs(v).toExponential(4) : ' + '+s;
  }
  function formatEquation(fn, fitType) {
    if (!fn) return '';
    var ft = (fitType||'').toLowerCase().replace(/\s/g,'');
    if (ft==='averagerf'||ft==='avg_rf') {
      return 'y = '+fn(1).toExponential(4)+' × x  (Avg RF)';
    }
    var co = fn.model.coef;
    if (ft==='quadratic') {
      return 'y = '+co.c2.toExponential(3)+'x\u00B2'+_fmtCoeff(co.c1,false)+'x'+_fmtCoeff(co.c0,false);
    }
    var slope = co.c1, intercept = co.c0;
    return 'y = '+slope.toExponential(4)+'x'+_fmtCoeff(intercept,false);
  }

  function showPointDetail(cal, point, ptType) {
    var modal = document.getElementById('pfas-cal-modal');
    var titleEl = document.getElementById('pfas-modal-title');
    var tbody   = document.querySelector('#pfas-modal-table tbody');
    if (!modal||!titleEl||!tbody) return;
    titleEl.childNodes[0].textContent = 'Point Detail — '+cal.analyte+' ';
    var rows;
    if (ptType==='CAL') {
      rows = [
        ['Analyte',      cal.analyte],
        ['Level',        'L'+(point.level||'?')],
        ['Expected',     (point.expected||'?')+' ng/mL'],
        ['Response Ratio', point.response_ratio!=null ? point.response_ratio.toExponential(4) : 'N/A'],
        ['Back-calc',    point.calculated!=null ? point.calculated.toFixed(3)+' ng/mL' : 'N/A'],
        ['% Deviation',  point.pct_deviation!=null ? (point.pct_deviation>0?'+':'')+point.pct_deviation.toFixed(2)+'%' : 'N/A'],
        ['Result',       point.passed ? '✓ Pass' : '✗ Fail'],
        ['Run date',     cal.run_date],
        ['Batch',        cal.batch_id||'—'],
      ];
    } else {
      rows = [
        ['Analyte',      cal.analyte],
        ['QC Type',      point.qc_type],
        ['Expected',     (point.expected_value||'?')+' ng/mL'],
        ['Measured',     (point.value!=null?parseFloat(point.value).toFixed(3):'?')+' ng/mL'],
        ['Response Ratio', point.response_ratio!=null ? point.response_ratio.toExponential(4) : 'N/A'],
        ['% Deviation',  point.pct_dev!=null ? (point.pct_dev>0?'+':'')+point.pct_dev.toFixed(2)+'%' : 'N/A'],
        ['Result',       point.passed ? '✓ Pass' : '✗ Fail'],
        ['Run date',     cal.run_date],
        ['Batch',        cal.batch_id||'—'],
      ];
    }
    tbody.innerHTML = rows.map(function(r){
      return '<tr><td>'+r[0]+'</td><td>'+r[1]+'</td></tr>';
    }).join('');
    modal.classList.add('open');
  }

  // ── Zone-background inline plugin (draws pass/warn/fail bands on bar charts) ─
  /* Pass / warn / fail bands behind a %-deviation plot, drawn by
     chartjs-plugin-annotation (REUSE_REVIEW U4; it replaced a hand-written
     Chart.js plugin). A null limit draws nothing: the method sets none. */
  function zoneAnnotations(limit, warn) {
    if (!limit) return {};
    var w = (warn && warn < limit) ? warn : limit;
    function band(yMin, yMax, token, alpha) {
      var b = {type: 'box', drawTime: 'beforeDatasetsDraw', borderWidth: 0,
               backgroundColor: _rgba(token, alpha)};
      if (yMin != null) b.yMin = yMin;
      if (yMax != null) b.yMax = yMax;
      return b;
    }
    var out = {failHi: band(limit, null, '--s-danger', 0.07),
               failLo: band(null, -limit, '--s-danger', 0.07),
               pass:   band(-w, w, '--s-success', 0.06)};
    if (w < limit) {
      out.warnHi = band(w, limit, '--s-warning', 0.08);
      out.warnLo = band(-limit, -w, '--s-warning', 0.08);
    }
    return out;
  }

  // ── Plot 1: response ratio (or calculated) vs expected concentration ───────
  function drawPlot1(uid, cal, fitType, wtype, origin) {
    var canvas = document.getElementById(uid+'_p1');
    if (!canvas) return;
    var lvs = cal.levels || [];

    var useResp = lvs.some(function(l){ return l.response_ratio != null; });
    var pts = lvs.filter(function(l){
      return l.expected != null && (useResp ? l.response_ratio != null : l.calculated != null);
    }).map(function(l){
      return {x:l.expected, y:useResp?l.response_ratio:l.calculated,
              passed:l.passed, _lv:l};
    });

    if (pts.length === 0) {
      canvas.parentNode.innerHTML = '<div class="plot-empty">No calibration level data</div>';
      return;
    }

    var fn = computeFn(pts.map(function(p){return{x:p.x,y:p.y};}), fitType, wtype, origin);
    if (!fn) return;
    var r2c = computeR2(pts.map(function(p){return{x:p.x,y:p.y};}), fn);

    // Update R\u00B2 badge
    var r2el = document.getElementById(uid+'_r2');
    if (r2el && r2c !== null) {
      r2el.textContent = 'R\u00B2 ' + r2c.toFixed(4);
      var r2min = limFor(uid).r2;
      r2el.className = 'r2-badge ' + (r2min == null ? 'r2-na' : (r2c >= r2min ? 'r2-ok' : 'r2-fail'));
    }
    // Update equation line
    var eqEl = document.getElementById(uid+'_eq');
    if (eqEl) eqEl.textContent = formatEquation(fn, fitType);

    var xmax = Math.max.apply(null, pts.map(function(p){return p.x;}));
    var nLine = 40;
    var linePts = [];
    for (var i=0; i<=nLine; i++) {
      var xv = xmax*i/nLine;
      linePts.push({x:xv, y:fn(xv)});
    }
    var idealPts = useResp ? null : [{x:0,y:0},{x:xmax,y:xmax}];
    var yLabel = useResp ? 'Response Ratio (analyte/IS peak area)' : 'Calculated (ng/mL)';
    var dotFill   = pts.map(function(p){ return p.passed ? cOK : cFail; });
    var dotBorder = pts.map(function(p){ return p.passed ? _rgba('--s-success',1) : _rgba('--s-danger',1); });
    var datasets = [
      {label:'Cal Standard', data:pts.map(function(p){return{x:p.x,y:p.y};}),
       type:'scatter',
       pointStyle:'rectRot', pointRadius:4, pointHoverRadius:6,
       pointBackgroundColor:dotFill, pointBorderColor:dotBorder, pointBorderWidth:1.5},
      {label:'Fit', data:linePts, type:'line', borderColor:cLine, borderWidth:2,
       pointRadius:0, tension:0, fill:false},
    ];
    if (idealPts) datasets.push(
      {label:'y = x', data:idealPts, type:'line', borderColor:cIdeal, borderWidth:1,
       borderDash:[5,4], pointRadius:0, tension:0, fill:false}
    );

    var _lvs = lvs;
    var _cal = cal;
    var key = uid+'c1';
    if (_ch[key]) _ch[key].destroy();
    _ch[key] = new Chart(canvas, {
      type:'scatter',
      data:{datasets:datasets},
      options:{
        responsive:true, maintainAspectRatio:false,
        onClick: function(evt, elems) {
          if (elems && elems.length > 0 && elems[0].datasetIndex===0) {
            showPointDetail(_cal, _lvs[elems[0].index], 'CAL');
          }
        },
        plugins:{
          legend:{display:true, position:'top',
                  labels:{boxWidth:9, font:{size:9}, usePointStyle:true}},
          tooltip:{callbacks:{label:function(ctx){
            if (ctx.datasetIndex===0) {
              var lv = _lvs[ctx.dataIndex] || {};
              var lines = ['L'+(lv.level||'?')+' — '+lv.expected+' ng/mL'];
              if (lv.response_ratio != null)
                lines.push('RR: '+lv.response_ratio.toExponential(3));
              else if (lv.calculated != null)
                lines.push('Calc: '+lv.calculated.toFixed(3)+' ng/mL');
              if (lv.pct_deviation != null)
                lines.push('%Dev: '+(lv.pct_deviation>0?'+':'')+lv.pct_deviation.toFixed(1)+'%');
              lines.push(lv.passed ? '✓ Pass' : '✗ Fail (click for detail)');
              return lines;
            }
            return '';
          }}}
        },
        scales:{
          x:{title:{display:true, text:'Expected concentration (ng/mL)', font:{size:9}},
             ticks:{font:{size:9}}, min:0},
          y:{title:{display:true, text:yLabel, font:{size:9}},
             ticks:{font:{size:9}}, min:0}
        }
      }
    });
  }

  // ── Shared helper: draw a limit-line dataset pair (±) on a bar chart ────────
  // ── Plot 2: % deviation per calibration level ─────────────────────────────
  function drawPlot2(uid, cal) {
    var canvas = document.getElementById(uid+'_p2');
    if (!canvas) return;
    var lvs = (cal.levels||[]).filter(function(l){ return l.pct_deviation != null; });
    if (lvs.length === 0) {
      canvas.parentNode.innerHTML = '<div class="plot-empty">No % deviation data</div>';
      return;
    }
    var labels = lvs.map(function(l){ return 'L'+l.level; });
    var devs   = lvs.map(function(l){ return l.pct_deviation; });
    var colors = lvs.map(function(l){ return l.passed ? cOK : cFail; });
    var calLim  = limFor(uid).CAL.max;
    var calWarn = limFor(uid).CAL.warn;

    // Y scale: data range with some padding, always showing full ±limit
    var absDevs = devs.filter(function(v){return v!=null;}).map(Math.abs);
    var dMax = absDevs.length > 0 ? Math.max.apply(null, absDevs) : 0;
    var yMax = Math.max(dMax * 1.3, (calLim || 0) * 1.1, 1);

    var _lvs2 = lvs;
    var _cal2 = cal;
    var key = uid+'c2';
    if (_ch[key]) _ch[key].destroy();
    _ch[key] = new Chart(canvas, {
      type:'bar',
      data:{labels:labels, datasets:[
        {label:'Cal Level', data:devs, backgroundColor:colors, borderWidth:0, borderRadius:2}
      ]},
      options:{
        responsive:true, maintainAspectRatio:false,
        onClick: function(evt, elems) {
          if (elems && elems.length > 0 && elems[0].datasetIndex===0) {
            showPointDetail(_cal2, _lvs2[elems[0].index], 'CAL');
          }
        },
        plugins:{
          annotation:{ annotations: zoneAnnotations(calLim, calWarn) },
          legend:{display:false},
          tooltip:{callbacks:{label:function(ctx){
            if (ctx.datasetIndex===0){
              var lv = _lvs2[ctx.dataIndex]||{};
              var dev = ctx.parsed.y;
              return [
                'L'+(lv.level||'?')+' — '+(lv.expected||'?')+' ng/mL',
                '%Dev: '+(dev>0?'+':'')+dev.toFixed(2)+'%',
                lv.passed ? '✓ Pass' : '✗ Fail (click for detail)',
              ];
            }
            return '';
          }}}
        },
        scales:{
          x:{ticks:{font:{size:9}},
             grid:{display:false}},
          y:{title:{display:true, text:'% Deviation', font:{size:9}},
             ticks:{font:{size:9}},
             min:-yMax, max:yMax}
        }
      }
    });
  }

  // ── Plot 3: % deviation of ICV/CCV; CCB shown as pass/fail chips ───────────
  function drawPlot3(uid, cal) {
    var canvas = document.getElementById(uid+'_p3');
    if (!canvas) return;

    // CCB: blank sample — show as pass/fail chips (% deviation from zero is undefined)
    var ccbRows = (cal.qc||[]).filter(function(r){ return r.qc_type==='CCB'; });
    var chipWrap = document.getElementById(uid+'_ccb');
    // Store refs for chip onclick (use indexed lookup to avoid JSON quoting issues)
    window['_calRef_'+uid]  = cal;
    window['_ccbRef_'+uid]  = ccbRows;
    if (chipWrap) {
      if (ccbRows.length > 0) {
        chipWrap.innerHTML = ccbRows.map(function(r, i) {
          var cls = r.passed ? 'ccb-chip pass' : 'ccb-chip fail';
          var val = r.value!=null ? parseFloat(r.value).toFixed(4) : '—';
          return '<span class="'+cls+'" title="Click for detail" style="cursor:pointer" '
            +"onclick=\"showPointDetail(window['_calRef_"+uid+"'],window['_ccbRef_"+uid+"']["+i+"],'QC')\">"
            +'CCB'+(i>0?' '+(i+1):'')+': '+val+' ng/mL '+(r.passed?'✓':'✗')
            +'</span>';
        }).join('');
        chipWrap.style.display = 'flex';
      } else {
        chipWrap.style.display = 'none';
      }
    }

    // ICV/CCV: % deviation from expected
    var qcRows = (cal.qc||[]).filter(function(r){
      return r.qc_type==='ICV'||r.qc_type==='CCV';
    });
    if (qcRows.length === 0) {
      var p3w = document.getElementById(uid+'_p3w');
      if (p3w) p3w.innerHTML = '<div class="plot-empty">No ICV/CCV data for this run</div>';
      return;
    }

    var counts = {};
    var labels=[], devs=[], barColors=[], _qcRows=qcRows;
    qcRows.forEach(function(r){
      var qt = r.qc_type||'?';
      counts[qt] = (counts[qt]||0)+1;
      var lbl = qt+(counts[qt]>1?' '+counts[qt]:'');
      var expStr = r.expected_value!=null ? ' ('+parseFloat(r.expected_value).toFixed(1)+')' : '';
      labels.push(lbl+expStr);
      devs.push(r.pct_dev!=null ? r.pct_dev : null);
      barColors.push(r.passed ? cOK : cFail);
    });

    var icvLim  = limFor(uid).ICV.max;
    var ccvLim  = limFor(uid).CCV.max;
    var ccvWarn = limFor(uid).CCV.warn;
    var limMax  = (icvLim == null && ccvLim == null) ? null : Math.max(icvLim || 0, ccvLim || 0);
    var absDevs = devs.filter(function(v){return v!=null;}).map(Math.abs);
    var dMax = absDevs.length > 0 ? Math.max.apply(null, absDevs) : 0;
    var yMax = Math.max(dMax * 1.3, (limMax || 0) * 1.1, 1);

    var _cal3 = cal;
    var key = uid+'c3';
    if (_ch[key]) _ch[key].destroy();
    _ch[key] = new Chart(canvas, {
      type:'bar',
      data:{labels:labels, datasets:[
        {label:'Check Standard', data:devs,
         backgroundColor:barColors, borderWidth:0, borderRadius:2}
      ]},
      options:{
        responsive:true, maintainAspectRatio:false,
        onClick: function(evt, elems) {
          if (elems && elems.length > 0 && elems[0].datasetIndex===0) {
            showPointDetail(_cal3, _qcRows[elems[0].index], 'QC');
          }
        },
        plugins:{
          annotation:{ annotations: zoneAnnotations(limMax, ccvWarn) },
          legend:{display:false},
          tooltip:{callbacks:{label:function(ctx){
            if (ctx.datasetIndex===0){
              var r = _qcRows[ctx.dataIndex]||{};
              var dev = ctx.parsed.y;
              var lines = [
                r.qc_type+' — '+(r.expected_value!=null?r.expected_value:'?')+' ng/mL',
                '%Dev: '+(dev>0?'+':'')+dev.toFixed(2)+'%',
              ];
              if (r.response_ratio!=null)
                lines.push('RR: '+r.response_ratio.toExponential(3));
              lines.push(r.passed ? '✓ Pass' : '✗ Fail (click for detail)');
              return lines;
            }
            return '';
          }}}
        },
        scales:{
          x:{ticks:{font:{size:9}}, grid:{display:false}},
          y:{title:{display:true, text:'% Deviation', font:{size:9}},
             ticks:{font:{size:9}},
             min:-yMax, max:yMax}
        }
      }
    });
  }

  function renderCard(cal) {
    drawPlot1(cal._uid, cal,
              cal.fit_type_override||cal.fit_type||'Linear',
              cal.weight_override||cal.weight_type||'',
              cal.origin_override||'exclude');
    drawPlot2(cal._uid, cal);
    drawPlot3(cal._uid, cal);
  }

  function cardHTML(cal) {
    var uid = 'c'+cal.id;
    cal._uid = uid;
    var r2disp = cal.r2 != null ? 'R\u00B2 '+cal.r2.toFixed(4) : 'R\u00B2 —';
    CAL_BY_UID[uid] = cal;
    var r2cls  = cal.r2_ok == null ? 'r2-na' : (cal.r2_ok ? 'r2-ok' : 'r2-fail');
    var sttcls = 'badge badge-'+(cal.status||'pending');
    var eqText = cal.fit_type_override
      ? (cal.fit_type_override+(cal.weight_override?' / '+cal.weight_override:'')
         +' (orig: '+cal.equation+')')
      : (cal.equation||'');

    var approvedBadge = cal.approved_by
      ? '<span>Approved</span>'
      : '<span class="badge badge-pending">Pending</span>';

    var ctrlHtml = '';
    if (IS_MGR) {
      var fitOpts = ['Linear','Quadratic','Average RF'].map(function(f){
        var s=(cal.fit_type_override||cal.fit_type||'Linear')===f?' selected':'';
        return '<option value="'+f+'"'+s+'>'+f+'</option>';
      }).join('');
      var wtOpts = ['','1/x','1/x2'].map(function(w){
        var l=w||'None'; var s=(cal.weight_override||cal.weight_type||'')===w?' selected':'';
        return '<option value="'+w+'"'+s+'>'+l+'</option>';
      }).join('');
      var origOpts = ['exclude','include','force'].map(function(o){
        var s=(cal.origin_override||'exclude')===o?' selected':'';
        return '<option value="'+o+'"'+s+'>Origin: '+o+'</option>';
      }).join('');
      ctrlHtml = '<div class="card-controls">'
        +'<label>Fit</label><select id="'+uid+'_ft" onchange="refit(\''+uid+'\')">'+fitOpts+'</select>'
        +'<label>Weight</label><select id="'+uid+'_wt" onchange="refit(\''+uid+'\')">'+wtOpts+'</select>'
        +'<select id="'+uid+'_ori" onchange="refit(\''+uid+'\')">'+origOpts+'</select>'
        +'<button class="save-ovr" onclick="saveOverride('+cal.id+',\''+uid+'\')">Save</button>'
        +'</div>';
    }

    return [
      '<div class="analyte-card" id="'+uid+'">',
      '  <div class="card-head">',
      '    <span class="analyte-name">'+cal.analyte+'</span>',
      '    <span class="r2-badge '+r2cls+'" id="'+uid+'_r2">'+r2disp+'</span>',
      '    '+approvedBadge,
      '  </div>',
      ctrlHtml,
      '  <div class="card-plots">',
      '    <div class="plot-section">',
      '      <div class="plot-label">',
      '        Calibration curve (response vs concentration)',
      '        <i class="rr-info" title="Response Ratio = Analyte peak area ÷ Internal Standard peak area. The calibration curve fits RR vs expected concentration.">?</i>',
      '      </div>',
      '      <div class="plot-canvas-wrap"><canvas id="'+uid+'_p1"></canvas></div>',
      '    </div>',
      '    <div class="plot-section">',
      '      <div class="plot-label">Calibration level % deviation</div>',
      '      <div class="plot-canvas-wrap plot-sm" id="'+uid+'_p2w"><canvas id="'+uid+'_p2"></canvas></div>',
      '    </div>',
      '    <div class="plot-section">',
      '      <div class="plot-label">Instrument checks — % deviation (ICV / CCV)</div>',
      '      <div class="plot-canvas-wrap plot-sm" id="'+uid+'_p3w"><canvas id="'+uid+'_p3"></canvas></div>',
      '      <div class="ccb-chips" id="'+uid+'_ccb" style="display:none"></div>',
      '    </div>',
      '  </div>',
      '  <div class="eq-line" id="'+uid+'_eq" title="Computed equation">'+eqText+'</div>',
      '</div>',
    ].join('\n');
  }

  function renderRun(run) {
    var n  = run.analytes.length;
    var np = run.analytes.filter(function(a){return a.r2_ok;}).length;
    var allApproved = run.analytes.every(function(a){return a.approved_by;});
    var anyApproved = run.analytes.some(function(a){return a.approved_by;});
    var meta = [run.instrument_id, run.analyst, run.method].filter(Boolean).join(' • ');
    var passBadge = '<span class="pass-badge '+(np===n?'pass-ok':'pass-fail')+'">'+np+'/'+n+' R\u00B2</span>';

    var approveBar = '';
    if (IS_MGR) {
      if (allApproved) {
        approveBar = '<div class="approve-bar"><span class="approve-label">Run '+run.run_date+'</span>'
                    +'<span style="color:var(--s-success);font-size:var(--fs-sm);font-weight:700">✓ All analytes approved</span></div>';
      } else {
        approveBar = '<form class="approve-bar" method="POST" action="'+CAL_URL+'">'
                    +'<input type="hidden" name="action" value="approve_run">'
                    +'<input type="hidden" name="run_date" value="'+run.run_date+'">'
                    +(run.analytes[0]&&run.analytes[0].method ? '<input type="hidden" name="method" value="'+run.analytes[0].method+'">' : '')
                    +'<span class="approve-label">Approve run '+run.run_date+'</span>'
                    +(anyApproved ? '<span style="font-size:var(--fs-xs);color:var(--s-warning)">Partial approval</span>' : '')
                    +'<button type="submit" class="btn btn-success btn-approve-run"'
                    +' onclick="return confirm(\'Approve all '+n+' analytes in run '+run.run_date+'?\')">Approve run (✓ '+n+')</button>'
                    +'</form>';
      }
    }

    var runsHTML = [
      '<div class="run-section" id="run-'+run.run_date.replace(/-/g,'')+'">',
      '<div class="run-header">',
      '  <h3>'+run.run_date+(run.run_time?' <span style="font-weight:400;color:var(--s-secondary);font-size:var(--fs-base)">@ '+run.run_time+'</span>':'')+'</h3>',
      (meta ? '<span class="run-meta">'+meta+'</span>' : ''),
      passBadge,
      '</div>',
      '<div class="analyte-grid">',
      run.analytes.map(cardHTML).join('\n'),
      '</div>',
      approveBar,
      '</div>',
    ].join('\n');
    return runsHTML;
  }

  function renderAll(runs) {
    var area = document.getElementById('cal-runs-area');
    if (!runs||runs.length===0) {
      area.innerHTML = '<div class="empty-state"><p style="font-size:var(--fs-2xl)">▶</p>'
                      +'<p>No calibration records found.</p>'
                      +'<p style="font-size:var(--fs-xs)">Import instrument data to populate calibrations.</p></div>';
      return;
    }
    area.innerHTML = runs.map(renderRun).join('\n');
    setTimeout(function(){
      runs.forEach(function(run){ run.analytes.forEach(renderCard); });
    }, 0);
  }

  function filterRun(rd) {
    var url = new URL(window.location.href);
    if (rd) url.searchParams.set('run_date', rd);
    else url.searchParams.delete('run_date');
    window.location.href = url.toString();
  }

  function refit(uid) {
    var calId = parseInt(uid.replace('c',''), 10);
    var cal = null;
    for (var ri=0; ri<CAL_RUNS.length&&!cal; ri++)
      for (var ci=0; ci<CAL_RUNS[ri].analytes.length&&!cal; ci++)
        if (CAL_RUNS[ri].analytes[ci].id===calId) cal=CAL_RUNS[ri].analytes[ci];
    if (!cal) return;
    var ftEl  = document.getElementById(uid+'_ft');
    var wtEl  = document.getElementById(uid+'_wt');
    var oriEl = document.getElementById(uid+'_ori');
    var ft  = ftEl  ? ftEl.value  : (cal.fit_type   || 'Linear');
    var wtp = wtEl  ? wtEl.value  : (cal.weight_type || '');
    var ori = oriEl ? oriEl.value : 'exclude';
    // Redraw Plot 1 with new fit
    drawPlot1(uid, cal, ft, wtp, ori);

    // Recompute Plot 2 % deviations using back-calculation from the new fit
    // (only if response_ratio data is available; otherwise show stored values)
    var lvs = cal.levels || [];
    var useResp = lvs.some(function(l){ return l.response_ratio != null; });
    // pts2 defined here so it's also accessible for the Plot 3 QC refit below
    var pts2 = lvs.filter(function(l){
      return l.expected != null && l.response_ratio != null;
    }).map(function(l){ return {x:l.expected, y:l.response_ratio}; });
    if (useResp) {
      var fn2 = computeFn(pts2.slice(), ft, wtp, ori);
      var updLvs = lvs.map(function(l) {
        if (l.response_ratio == null || l.expected == null || l.expected === 0) return l;
        var xBack = backCalc(fn2, l.response_ratio);
        var pctDev = xBack != null
          ? Math.round((xBack - l.expected) / l.expected * 10000) / 100
          : l.pct_deviation;
        return {level:l.level, expected:l.expected, calculated:l.calculated,
                response_ratio:l.response_ratio,
                pct_deviation:pctDev,
                passed: (pctDev != null && limFor(uid).CAL.max != null)
                        ? Math.abs(pctDev) <= limFor(uid).CAL.max : l.passed};
      });
      drawPlot2(uid, {levels: updLvs});
    } else {
      drawPlot2(uid, cal);
    }

    // Recompute Plot 3 (ICV/CCV) deviations from response_ratio using new fit
    var icvccvWithRR = (cal.qc||[]).filter(function(r){
      return (r.qc_type==='ICV'||r.qc_type==='CCV') && r.response_ratio != null && r.expected_value;
    });
    if (icvccvWithRR.length > 0 && useResp) {
      var fn3 = computeFn(pts2.slice(), ft, wtp, ori);
      var l3 = limFor(uid);
      var limMax3 = (l3.ICV.max == null && l3.CCV.max == null) ? null
                    : Math.max(l3.ICV.max || 0, l3.CCV.max || 0);
      var updQC = (cal.qc||[]).map(function(r) {
        if ((r.qc_type!=='ICV'&&r.qc_type!=='CCV') || r.response_ratio==null || !r.expected_value) return r;
        var xBack = backCalc(fn3, r.response_ratio);
        var pctDev = xBack != null
          ? Math.round((xBack - r.expected_value) / r.expected_value * 10000) / 100
          : r.pct_dev;
        return {qc_type:r.qc_type, qc_level:r.qc_level, value:r.value,
                expected_value:r.expected_value, pct_dev:pctDev,
                response_ratio:r.response_ratio, flag:r.flag,
                passed: (pctDev != null && limMax3 != null) ? Math.abs(pctDev) <= limMax3 : r.passed};
      });
      drawPlot3(uid, {qc: updQC});
    } else {
      drawPlot3(uid, cal);
    }
  }

  function saveOverride(calId, uid) {
    var ft  = (document.getElementById(uid+'_ft') ||{}).value||'';
    var wtp = (document.getElementById(uid+'_wt') ||{}).value||'';
    var ori = (document.getElementById(uid+'_ori')||{}).value||'';
    var fd = new FormData();
    fd.append('action','override');
    fd.append('calibration_id',calId);
    fd.append('fit_type_override',ft);
    fd.append('weight_override',wtp);
    fd.append('origin_override',ori);
    fetch(CAL_URL,{method:'POST',body:fd})
      .then(function(r){return r.json();})
      .then(function(d){
        if (d.ok) {
          var el=document.getElementById(uid);
          if(el){el.style.outline='2px solid var(--s-success)';
                 setTimeout(function(){el.style.outline='';},1200);}
        }
      }).catch(function(e){console.error('saveOverride:',e);});
  }

  renderAll(CAL_RUNS);
  //]]>
  </script>

  <!-- Point-detail modal (shared, populated by JS) -->
  <div id="pfas-cal-modal" class="cal-detail-modal"
       onclick="if(event.target===this)this.classList.remove('open')">
    <div class="cal-detail-box">
      <h4 id="pfas-modal-title">Point Detail
        <button class="cal-detail-close"
                onclick="document.getElementById('pfas-cal-modal').classList.remove('open')">&times;</button>
      </h4>
      <table class="cal-detail-table" id="pfas-modal-table"><tbody></tbody></table>
    </div>
  </div>

  </div><!-- /content slot -->
</body>
</html>
