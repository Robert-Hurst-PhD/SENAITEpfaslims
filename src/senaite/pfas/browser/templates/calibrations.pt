<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">PFAS Calibration Review</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
    /* ── Calibration-specific styles ──────────────────────────────────── */
    .page-body { max-width: 1280px; }

    .stat-bar { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
    .stat-box { background: var(--s-bg); border-radius: 6px; padding: 12px 18px;
                border: 1px solid var(--s-border);
                box-shadow: 0 1px 3px rgba(0,0,0,.06); min-width: 100px; text-align: center; }
    .stat-box .sv { font-size: 22px; font-weight: 700; color: var(--s-dark); }
    .stat-box .sl { font-size: 10px; color: var(--s-secondary); text-transform: uppercase;
                    letter-spacing: .05em; margin-top: 2px; }
    .stat-box.good  .sv { color: var(--s-success); }
    .stat-box.warn  .sv { color: var(--s-warning); }
    .stat-box.info  .sv { color: var(--s-primary); }

    .filter-bar { background: var(--s-bg); border-radius: 6px;
                  border: 1px solid var(--s-border);
                  box-shadow: 0 1px 3px rgba(0,0,0,.06);
                  padding: 14px 18px; margin-bottom: 18px;
                  display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
    .filter-bar label { font-size: 11px; color: var(--s-secondary); font-weight: 700;
                        text-transform: uppercase; display: block; margin-bottom: 3px; }
    .filter-bar select, .filter-bar input[type=number] {
      padding: 6px 10px; border: 1px solid var(--s-input-border); border-radius: 4px;
      font-size: 13px; background: #fafafa; color: var(--s-input-text); }

    .cal-card { background: var(--s-bg); border-radius: 6px;
                border: 1px solid var(--s-border);
                box-shadow: 0 1px 3px rgba(0,0,0,.06); margin-bottom: 14px; overflow: hidden; }
    .cal-head { padding: 10px 16px; display: flex; align-items: center;
                gap: 10px; cursor: pointer; background: var(--s-light);
                border-bottom: 1px solid var(--s-border); }
    .cal-head h3 { flex: 1; font-size: 13px; font-weight: 700; color: var(--s-body); }
    .cal-body { padding: 14px 16px; }
    .cal-card.collapsed .cal-body { display: none; }

    .badge { font-size: 10px; padding: 2px 8px; border-radius: 10px;
             font-weight: 700; text-transform: uppercase; }
    .badge-pending  { background: #fff3cd; color: #856404; }
    .badge-approved { background: #d4edda; color: #155724; }
    .badge-rejected { background: #f8d7da; color: #721c24; }
    .badge-r2-ok    { background: var(--s-primary-lt); color: var(--s-primary); }
    .badge-r2-fail  { background: #f8d7da; color: #721c24; }

    .meta-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
                 gap: 8px 16px; margin-bottom: 12px; }
    .meta-item { font-size: 12px; }
    .meta-item .mk { color: var(--s-secondary); font-weight: 700; text-transform: uppercase;
                     font-size: 10px; letter-spacing: .04em; }
    .meta-item .mv { color: var(--s-body); margin-top: 1px; }

    .level-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 8px; }
    .level-table th { background: var(--s-light); padding: 5px 10px; text-align: left;
                      font-size: 11px; color: var(--s-secondary); text-transform: uppercase;
                      font-weight: 700; letter-spacing: .04em;
                      border-bottom: 2px solid var(--s-border); }
    .level-table td { padding: 5px 10px; border-bottom: 1px solid var(--s-border); }
    .level-table tr:last-child td { border-bottom: none; }
    .lv-pass { color: var(--s-success); font-weight: 700; }
    .lv-fail { color: var(--s-danger); font-weight: 700; }

    .approve-form { display: flex; gap: 10px; align-items: flex-end; margin-top: 12px;
                    padding-top: 12px; border-top: 1px solid var(--s-border); flex-wrap: wrap; }
    .approve-form label { font-size: 11px; color: var(--s-secondary); font-weight: 700;
                          text-transform: uppercase; display: block; margin-bottom: 3px; }
    .approve-form select, .approve-form input[type=text] {
      padding: 6px 8px; border: 1px solid var(--s-input-border); border-radius: 4px;
      font-size: 13px; color: var(--s-input-text); }
    .approve-form input[type=text] { min-width: 220px; }
    .btn-approve { background: var(--s-success); color: #fff; border: none; border-radius: 4px;
                   padding: 8px 18px; cursor: pointer; font-size: 13px; font-weight: 600; }
    .btn-approve:hover { background: #218838; }

    .empty-state { text-align: center; padding: 48px; color: var(--s-secondary); }
    .empty-state .ei { font-size: 36px; margin-bottom: 8px; }
    .save-banner { background: #d4edda; border: 1px solid #c3e6cb; border-radius: 4px;
                   padding: 10px 16px; margin-bottom: 16px; color: #155724; font-weight: 600; }
  </style>
  </tal:styles>
</head>
<body>
  <tal:t metal:fill-slot="header-title">PFAS Calibration Review</tal:t>
  <tal:r metal:fill-slot="header-right">
    <span class="header-meta">
      Calibration curve review &bull;
      R&sup2; minimum: <strong tal:content="view/r2_minimum">0.995</strong> &bull;
      Max % deviation: <strong tal:content="view/cal_pct_max">20</strong>%
    </span>
    <a class="back-link" tal:attributes="href string:${context/absolute_url}/@@lims-setup">
      Site Setup
    </a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <div class="save-banner" tal:condition="view/save_message">
      Calibration status updated.
    </div>

    <!-- Summary stats -->
    <tal:stats tal:define="stats view/summary_stats">
      <div class="stat-bar" tal:condition="stats">
        <div class="stat-box">
          <div class="sv" tal:content="stats/total">0</div>
          <div class="sl">Total</div>
        </div>
        <div class="stat-box good">
          <div class="sv" tal:content="stats/r2_pass">0</div>
          <div class="sl">R&sup2; Pass</div>
        </div>
        <div class="stat-box warn">
          <div class="sv" tal:content="stats/pending">0</div>
          <div class="sl">Pending</div>
        </div>
        <div class="stat-box good">
          <div class="sv" tal:content="stats/approved">0</div>
          <div class="sl">Approved</div>
        </div>
        <div class="stat-box warn">
          <div class="sv" tal:content="stats/rejected">0</div>
          <div class="sl">Rejected</div>
        </div>
        <div class="stat-box info">
          <div class="sv" tal:content="stats/avg_r2">&#8212;</div>
          <div class="sl">Avg R&sup2;</div>
        </div>
      </div>
    </tal:stats>

    <!-- Filter bar -->
    <form method="GET" action="" class="filter-bar"
          tal:attributes="action string:${context/absolute_url}/@@pfas-calibrations">
      <div>
        <label>Analyte</label>
        <select name="analyte">
          <option value="">&#8212; All &#8212;</option>
          <tal:opts tal:repeat="a view/analytes">
            <option tal:content="a"
                    tal:attributes="value a; selected python:a == view.selected_analyte()">PFOA</option>
          </tal:opts>
        </select>
      </div>
      <div>
        <label>Analyst</label>
        <select name="analyst">
          <option value="">&#8212; All &#8212;</option>
          <tal:opts tal:repeat="a view/analysts">
            <option tal:content="a"
                    tal:attributes="value a; selected python:a == (view.selected_analyst() or '')">&#8212;</option>
          </tal:opts>
        </select>
      </div>
      <div>
        <label>Instrument</label>
        <select name="instrument_id">
          <option value="">&#8212; All &#8212;</option>
          <tal:opts tal:repeat="i view/instruments">
            <option tal:content="i"
                    tal:attributes="value i; selected python:i == (view.selected_instrument() or '')">&#8212;</option>
          </tal:opts>
        </select>
      </div>
      <div>
        <label>Status</label>
        <select name="status">
          <option value="">&#8212; All &#8212;</option>
          <option value="pending"
                  tal:attributes="selected python:view.selected_status()=='pending'">Pending</option>
          <option value="approved"
                  tal:attributes="selected python:view.selected_status()=='approved'">Approved</option>
          <option value="rejected"
                  tal:attributes="selected python:view.selected_status()=='rejected'">Rejected</option>
        </select>
      </div>
      <div>
        <label>Show last</label>
        <input type="number" name="limit" min="1" max="300"
               tal:attributes="value view/selected_limit"
               style="width:80px" />
      </div>
      <button type="submit" class="btn btn-primary">Apply</button>
    </form>

    <!-- Calibration cards -->
    <tal:cals tal:define="cals view/calibrations">
      <div class="empty-state" tal:condition="not:cals">
        <div class="ei">&#9654;</div>
        <p>No calibration records found.</p>
        <p style="font-size:11px;margin-top:6px">
          Import an instrument data file to populate calibrations.
        </p>
      </div>

      <tal:cal tal:repeat="cal cals">
        <tal:define tal:define="cal_id cal/id">
        <div class="cal-card" tal:attributes="id string:cal-${cal_id}">
          <div class="cal-head"
               tal:attributes="onclick string:toggleCard('cal-${cal_id}')">
            <h3>
              <span tal:replace="cal/analyte">PFOA</span>
              &mdash;
              <span tal:replace="cal/run_date">2026-01-01</span>
              &nbsp;
              <span class="badge badge-r2-ok"  tal:condition="cal/r2_ok">R&sup2; OK</span>
              <span class="badge badge-r2-fail" tal:condition="not:cal/r2_ok">R&sup2; LOW</span>
            </h3>
            <span tal:attributes="class python:'badge badge-' + cal['status']"
                  tal:content="cal/status">pending</span>
          </div>

          <div class="cal-body">
            <div class="meta-grid">
              <div class="meta-item">
                <div class="mk">Batch</div>
                <div class="mv" tal:content="cal/batch_id">&#8212;</div>
              </div>
              <div class="meta-item">
                <div class="mk">Analyst</div>
                <div class="mv" tal:content="cal/analyst">&#8212;</div>
              </div>
              <div class="meta-item">
                <div class="mk">Instrument</div>
                <div class="mv" tal:content="cal/instrument_id">&#8212;</div>
              </div>
              <div class="meta-item">
                <div class="mk">Method</div>
                <div class="mv" tal:content="cal/method">&#8212;</div>
              </div>
              <div class="meta-item">
                <div class="mk">Fit Type</div>
                <div class="mv" tal:content="cal/fit_type">&#8212;</div>
              </div>
              <div class="meta-item">
                <div class="mk">Weighting</div>
                <div class="mv" tal:content="cal/weight_type">&#8212;</div>
              </div>
              <div class="meta-item">
                <div class="mk">R&sup2;</div>
                <div class="mv" tal:content="cal/r2">&#8212;</div>
              </div>
              <div class="meta-item">
                <div class="mk">Levels (n)</div>
                <div class="mv" tal:content="cal/n_levels">&#8212;</div>
              </div>
              <div class="meta-item">
                <div class="mk">Range</div>
                <div class="mv">
                  <tal:rng tal:condition="cal/min_level">
                    <span tal:replace="cal/min_level">0</span>
                    &ndash;
                    <span tal:replace="cal/max_level">0</span>
                    ng/mL
                  </tal:rng>
                  <span tal:condition="not:cal/min_level">&#8212;</span>
                </div>
              </div>
              <div class="meta-item" style="grid-column: 1 / -1">
                <div class="mk">Equation</div>
                <div class="mv" style="font-family:monospace" tal:content="cal/equation">&#8212;</div>
              </div>
              <div class="meta-item" style="grid-column: 1 / -1"
                   tal:condition="cal/notes">
                <div class="mk">Notes</div>
                <div class="mv" tal:content="cal/notes">&#8212;</div>
              </div>
            </div>

            <tal:levels tal:define="levels python:view.calibration_levels(cal['id'])">
              <div tal:condition="levels" style="overflow-x:auto">
                <table class="level-table">
                  <thead>
                    <tr>
                      <th>Level</th><th>Expected (ng/mL)</th>
                      <th>Calculated (ng/mL)</th><th>% Deviation</th><th>Pass?</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tal:lv tal:repeat="lv levels">
                      <tr>
                        <td tal:content="lv/level">1</td>
                        <td tal:content="lv/expected">&#8212;</td>
                        <td tal:content="lv/calculated">&#8212;</td>
                        <td>
                          <span tal:condition="python:lv['pct_deviation'] is not None"
                                tal:attributes="class python:'lv-pass' if lv['passed'] else 'lv-fail'"
                                tal:content="python:'{:+.2f}%'.format(lv['pct_deviation'])">0%</span>
                          <span tal:condition="python:lv['pct_deviation'] is None">&#8212;</span>
                        </td>
                        <td tal:attributes="class python:'lv-pass' if lv['passed'] else 'lv-fail'"
                            tal:content="python:'Pass' if lv['passed'] else 'FAIL'">&#8212;</td>
                      </tr>
                    </tal:lv>
                  </tbody>
                </table>
              </div>
              <p tal:condition="not:levels" style="color:var(--s-secondary);font-size:11px;margin-top:4px">
                No per-level data recorded.
              </p>
            </tal:levels>

            <form method="POST" class="approve-form"
                  tal:condition="view/is_manager"
                  tal:attributes="action string:${context/absolute_url}/@@pfas-calibrations">
              <input type="hidden" name="calibration_id" tal:attributes="value cal/id" />
              <div>
                <label>Update Status</label>
                <select name="new_status">
                  <option value="approved">Approved</option>
                  <option value="rejected">Rejected</option>
                  <option value="pending">Pending</option>
                </select>
              </div>
              <div>
                <label>Notes</label>
                <input type="text" name="notes" placeholder="Optional reviewer note"
                       tal:attributes="value cal/notes" />
              </div>
              <button type="submit" class="btn-approve">Update</button>
            </form>

          </div>
        </div>
        </tal:define>
      </tal:cal>
    </tal:cals>

  </div>

  <script>
  function toggleCard(id) {
    var el = document.getElementById(id);
    if (el) el.classList.toggle('collapsed');
  }
  (function() {
    var cards = document.querySelectorAll('.cal-card');
    if (cards.length > 5) {
      cards.forEach(function(c, i) { if (i > 0) c.classList.add('collapsed'); });
    }
  })();
  </script>

  </div><!-- /content slot -->
</body>
</html>
