<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Type 1 Water QC Log</title>
</head>
<body>
<tal:t metal:fill-slot="header-title">Type 1 Water QC Log</tal:t>
  <!-- the form's Save, pinned at the foot of the window -->
  <tal:ab metal:fill-slot="action-bar"><tal:sb tal:define="sb_form string:water-form; sb_label string:Save Entry"><div
      metal:use-macro="context/@@pfas-macros/macros/save-bar"></div></tal:sb></tal:ab>

<metal:content metal:fill-slot="content">
  <tal:def tal:define="purl view/portal_url; defs python:view.defaults(request.get('unit_id'))">
  <div class="alert alert-danger" tal:condition="view/error|nothing" tal:content="view/error">error</div>

  <div class="pfas-card">
    <h3>New Entry</h3>
    <form method="POST" id="water-form" tal:attributes="action string:${purl}/@@pfas-water-log">
      <div class="pfas-form-row">
        <div class="pfas-form-field" tal:condition="view/water_units"><label>Water system</label>
          <select name="unit_id" required="required">
            <option value="">— select system —</option>
            <option tal:repeat="u view/water_units"
                    tal:attributes="value u/id; selected python:'selected' if request.get('unit_id','')==u['id'] else None"
                    tal:content="u/name"></option>
          </select>
        </div>
        <div class="pfas-form-field"><label>Date</label>
          <input type="date" name="log_date" id="wDate" required/></div>
        <div class="pfas-form-field"><label>Time</label>
          <input type="time" name="log_time" id="wTime"/></div>
        <div class="pfas-form-field"><label>Operator</label>
          <input type="text" name="operator" readonly="readonly" tal:attributes="value view/signed_in" /></div>
      </div>
      <div class="pfas-form-row">
        <div class="pfas-form-field">
          <label for="w-cond">Conductivity (<tal:u tal:replace="view/conductivity_label">&micro;S/cm</tal:u>)</label>
          <input type="number" step="0.01" name="conductivity" id="w-cond" required/>
          <span class="pfas-hint" tal:content="view/conductivity_limit">Limit &le; 1 &micro;S/cm</span>
        </div>
        <div class="pfas-form-field">
          <label for="w-toc">TOC (ppb)</label>
          <input type="number" step="1" name="toc" id="w-toc" required/>
          <span class="pfas-hint" tal:content="python:u'Limit \u2264 %g ppb' % defs['toc_max']">Limit &le; 500 ppb</span>
        </div>
      </div>
      <div class="pfas-form-row">
        <div class="pfas-form-field is-full"><label>Notes</label>
          <input type="text" name="notes"/></div>
      </div>
    </form>
  </div>

  <div class="pfas-card">
    <h3>Recent Log</h3>
    <tal:none tal:condition="python:not view.logs()">
      <p class="pfas-note-sm">No entries yet.</p>
    </tal:none>
    <table class="pfas-table log-table" data-col-resize="facility-water-log-table" tal:condition="python:bool(view.logs())">
      <thead><tr>
        <th>Date</th><th>Time</th><th>System</th><th>Operator</th>
        <th>Conductivity (&mu;S/cm)</th><th>TOC (ppb)</th><th>Result</th><th>Notes</th>
      </tr></thead>
      <tbody>
      <tal:each tal:repeat="r view/logs">
        <tr>
          <td tal:content="r/log_date"></td>
          <td tal:content="r/log_time"></td>
          <td tal:content="python:r['system'] or u'\u2014'"></td>
          <td tal:content="r/operator"></td>
          <td tal:attributes="class python:'pfas-text-bad' if r.get('conductivity') and r['conductivity']>r['conductivity_max'] else None"
              tal:content="python:'{:.2f}'.format(r['conductivity']) if r.get('conductivity') is not None else '—'"></td>
          <td tal:attributes="class python:'pfas-text-bad' if r.get('toc') and r['toc']>r['toc_max'] else None"
              tal:content="python:'{:.0f}'.format(r['toc']) if r.get('toc') is not None else '—'"></td>
          <td><span tal:attributes="class python:'badge badge-ok' if r['passed'] else 'badge badge-fail'"
                    tal:content="python:'Pass' if r['passed'] else 'Fail'"></span></td>
          <td class="pfas-muted-cell" tal:content="python:r.get('notes','')"></td>
        </tr>
      </tal:each>
    </tbody>
    </table>
  </div>

  </tal:def>
</metal:content>
<tal:scripts metal:fill-slot="scripts">
<script>
//<![CDATA[
(function(){
  var d = new Date();
  var dd = document.getElementById('wDate');
  var dt = document.getElementById('wTime');
  var today = PFAS.components.labToday();
  if (dd) { if (today) { dd.value = today; } else { dd.valueAsDate = d; } }
  if (dt) dt.value = ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);
})();
//]]>
</script>
</tal:scripts>
</body>
</html>
