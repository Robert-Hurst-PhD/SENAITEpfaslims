<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title" tal:content="view/logbook_title">Logbook</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
    .lb-form { max-width: 900px; }
    .lb-section { margin-bottom: 24px; }
    .lb-section h3 { font-size: 14px; font-weight: 700; color: var(--s-dark);
                     margin-bottom: 10px; padding-bottom: 6px;
                     border-bottom: 2px solid var(--s-border); }
    .lb-fields-row { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 12px; }
    .lb-field { display: flex; flex-direction: column; min-width: 160px; }
    .lb-field label { font-size: 12px; font-weight: 600; color: var(--s-dark); margin-bottom: 3px; }
    .lb-field-wide { width: 100%; }
    .lb-input, .lb-textarea {
      padding: 7px 10px; font-size: 13px; border: 1px solid var(--s-input-border);
      border-radius: 6px; color: var(--s-body);
    }
    .lb-input:focus, .lb-textarea:focus { outline: none; border-color: var(--s-primary); }
    .lb-input-sm { width: 110px; }
    .lb-input-md { width: 180px; }
    .lb-input-lg { width: 260px; }
    .lb-textarea { width: 100%; min-height: 70px; resize: vertical; }
    .dyn-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .dyn-table th { background: #f8f9fa; padding: 6px 10px; text-align: left;
                    border-bottom: 2px solid var(--s-border); font-weight: 700; }
    .dyn-table td { padding: 4px 6px; border-bottom: 1px solid var(--s-border); }
    .dyn-table td input { width: 100%; padding: 5px 8px; font-size: 12px;
                          border: 1px solid var(--s-input-border); border-radius: 4px; }
    .dyn-table td input:focus { outline: none; border-color: var(--s-primary); }
    .btn-add-row { margin-top: 8px; padding: 5px 14px; background: #f8f9fa;
                   border: 1px dashed var(--s-border); border-radius: 6px;
                   font-size: 12px; cursor: pointer; color: var(--s-secondary); }
    .btn-add-row:hover { background: #e9ecef; color: var(--s-dark); }
    .btn-del-row { background: none; border: none; cursor: pointer;
                   color: #dc3545; font-size: 14px; padding: 2px 6px; }
    .lot-ac-wrap { position: relative; display: inline-block; }
    .lot-ac-dropdown { display: none; position: absolute; top: 100%; left: 0;
                       min-width: 260px; background: #fff;
                       border: 1px solid var(--s-border); border-radius: 4px;
                       box-shadow: 0 4px 12px rgba(0,0,0,.12); z-index: 200;
                       max-height: 200px; overflow-y: auto; }
    .lot-ac-dropdown.open { display: block; }
    .lot-ac-item { padding: 7px 10px; font-size: 12px; cursor: pointer; }
    .lot-ac-item:hover { background: var(--s-primary-lt); }
    .lot-ac-sub { font-size: 10px; color: var(--s-secondary); }
    .form-actions { margin-top: 28px; padding-top: 16px;
                    border-top: 1px solid var(--s-border);
                    display: flex; gap: 12px; align-items: center; }
    .btn-save { padding: 9px 24px; background: var(--s-primary); color: #fff;
                border: none; border-radius: 7px; font-size: 13px;
                font-weight: 600; cursor: pointer; }
    .btn-save:hover { background: var(--s-primary-dk); }
    .btn-print-preview { padding: 9px 18px; background: #f8f9fa;
                         color: var(--s-secondary); border: 1px solid var(--s-border);
                         border-radius: 7px; font-size: 13px; cursor: pointer; }
    .alert-ok    { background: #d4edda; border: 1px solid #c3e6cb; color: #155724;
                   padding: 10px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 13px; }
    .alert-error { background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24;
                   padding: 10px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 13px; }
    .empty-schema { color: var(--s-secondary); font-style: italic;
                    padding: 24px; text-align: center; }
    @media print {
      .btn-save, .btn-print-preview, .btn-add-row, .btn-del-row { display: none !important; }
      .corr-panel { display: none !important; }
      .form-actions { display: none !important; }
    }
  </style>
  </tal:styles>
</head>
<body>
  <tal:t metal:fill-slot="header-title" tal:content="view/logbook_title">Logbook</tal:t>
  <tal:r metal:fill-slot="header-right">
    <a class="header-meta"
       tal:attributes="href string:${view/batch_url}/@@pfas-logbook-index">
      &#8592; All Logbooks
    </a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <!-- Breadcrumb -->
    <div class="lb-breadcrumb">
      <a tal:attributes="href view/portal_url">Lab</a>
      <span class="lb-bc-sep">&#8250;</span>
      <a tal:attributes="href string:${view/batch_url}/@@pfas-logbook-index"
         tal:content="view/batch_title">Batch</a>
      <span class="lb-bc-sep">&#8250;</span>
      <strong tal:content="view/logbook_code">Logbook</strong>
    </div>

    <div class="alert-ok"    tal:condition="view/ok_msg"    tal:content="view/ok_msg"></div>
    <div class="alert-error" tal:condition="view/error_msg" tal:content="view/error_msg"></div>

    <!-- Empty schema notice -->
    <tal:noschema condition="not:view/field_schema">
      <div class="empty-schema">
        No field schema defined for this logbook.
        <a tal:attributes="href string:${view/portal_url}/@@pfas-prep-logbooks">
          Configure in Prep Logbooks &#8594;
        </a>
      </div>
    </tal:noschema>

    <!-- Main form (only when schema is defined) -->
    <tal:hasschema condition="view/field_schema">
    <form class="lb-form" method="post"
          tal:attributes="action string:${view/batch_url}/@@pfas-logbook-dynamic?slug=${view/slug}">

      <!-- Render each field in the schema -->
      <!-- `field` (from the repeat) and `view` are what the macro reads;
           both are in scope here, on the element wrapping the use-macro. -->
      <tal:fields repeat="field python:view.field_schema()">
        <tal:m metal:use-macro="context/@@pfas-logbook-macros/macros/logbook_field" />
      </tal:fields>

      <!-- QA attestation. The schema-driven path never invoked this, so
           250/251/253 (which all route here) printed without it. -->
      <tal:signoff tal:define="signoff_noun view/signoff_noun;
                               signoff_prepared_name view/signoff_name;
                               signoff_prepared_date view/signoff_date;
                               signoff_prepared_initials view/signoff_name">
        <tal:m metal:use-macro="context/@@pfas-macros/macros/signoff" />
      </tal:signoff>

      <div class="form-actions">
        <button class="btn-save" type="submit">Save Logbook</button>
        <button type="button" class="btn-print-preview" onclick="window.print()">&#128438; Print Preview</button>
      </div>

    </form>
    </tal:hasschema>

  </div><!-- /page-body -->

  <script>
  /* Server data only; the widget code lives in a static resource so
     Chameleon never has to parse it as markup. */
  var SAVED_DATA    = <tal:sd tal:replace="structure view/data_json" />;
  var FIELD_SCHEMA  = <tal:fs tal:replace="structure view/field_schema_json" />;
  </script>
  <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/logbook_runtime.js?v=1"></script>

  </div><!-- /content slot -->
</body>
</html>
