<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      lang="en"
      metal:use-macro="here/prefs_main_template/macros/master"
      i18n:domain="senaite.core">

  <body>

    <metal:override fill-slot="top_slot"
                    tal:define="disable_column_one python:request.set('disable_plone.leftcolumn', 1);
                                disable_column_two python:request.set('disable_plone.rightcolumn', 1);"/>

    <metal:block fill-slot="senaite_legacy_js"
                 tal:define="portal context/@@plone_portal_state/portal;">
      <script type="text/javascript"
              src="senaite.core.setupview.js"
              tal:attributes="src string:${portal/absolute_url}/++plone++senaite.core.static/js/senaite.core.setupview.js"></script>
    </metal:block>

    <div metal:fill-slot="prefs_configlet_main" id="lims-controlpanel"
         tal:define="sect view/current_section; purl view/portal_url">

      <!-- Back link + section heading in filtered mode -->
      <tal:filtered tal:condition="sect">
        <div class="pfas-page-head">
          <a class="btn btn-sm btn-secondary btn-back" tal:attributes="href string:${purl}/@@lims-setup"
            >All Configuration</a>
        </div>
      </tal:filtered>

      <div id="setupview">

        <!-- Search box: shown in the full view; drawn hidden in a section's view,
             since core's setup script binds to it on every page -->
        <div class="pfas-filterbar" tal:attributes="hidden python:'hidden' if sect else None">
          <div class="pfas-field">
            <input id="searchbox"
                   autofocus
                   type="text"
                   class="pfas-input pfas-input-wide"
                   placeholder="Type to filter ..."
                   aria-label="Filter"
                   i18n:attributes="placeholder" />
          </div>
        </div>

        <!-- ── Grouped setup items ───────────────────────────────────────── -->
        <tal:groups tal:repeat="group view/grouped_setup_items">

          <!-- Group heading — only shown in the full view (filtered view has back link) -->
          <div class="pfas-section-head"
               tal:condition="python:not sect"
               tal:attributes="id group/id"
               tal:content="group/title">Group</div>

          <!-- Rich tile — same structure for both core items and PFAS tools -->
          <div class="pfas-tiles">
          <tal:tiles tal:repeat="item group/tiles">
            <div class="tilewrapper">
              <a class="pfas-tile"
                 tal:attributes="href item/absolute_url; title item/Title"
                 i18n:attributes="title">

                <!-- Icon: <img> for core items, <i class="fas"> for PFAS tools -->
                <div class="pfas-tile-icon">
                  <tal:icon tal:replace="structure python:view.get_icon_for(item, css_class='icon')" />
                </div>

                <!-- Title -->
                <span class="title pfas-tile-title"
                     i18n:translate=""
                     tal:content="item/Title">
                  Setup Item Title
                </span>

                <!-- Description -->
                <div class="pfas-tile-desc"
                     tal:content="python:view.get_description(item)">
                  Description
                </div>

                <!-- Item count — shown for core items with content, hidden for PFAS tools -->
                <div class="pfas-tile-meta"
                     tal:define="cnt python:view.get_count(item)"
                     tal:condition="cnt">
                  <span tal:content="cnt"></span>
                  <tal:sing i18n:translate="label_setupview_item"
                            tal:condition="python:cnt == 1">Item</tal:sing>
                  <tal:plur i18n:translate="label_setupview_items"
                            tal:condition="python:cnt != 1">Items</tal:plur>
                </div>

              </a>
            </div>
          </tal:tiles>
          </div>

        </tal:groups>

      </div><!-- /#setupview -->

    </div><!-- /#lims-controlpanel -->

  </body>
</html>
