<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Equipment checks</title>
</head>
<body>
<tal:t metal:fill-slot="header-title">Equipment checks</tal:t>
<metal:content metal:fill-slot="content">
  <tal:def tal:define="
    summary  view/summary;
    purl     view/portal_url;
  ">
  <p class="pfas-lead">
    Daily equipment and facility checks.
    <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-equipment"
      >Equipment</a>
  </p>

  <tal:no-units tal:condition="python:not summary">
    <div class="pfas-empty is-boxed">
      No equipment yet: each item is a SENAITE instrument with a type.
      <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-equipment"
        >Equipment</a>
    </div>
  </tal:no-units>

  <tal:groups tal:condition="python:bool(summary)">

    <!-- Temperature units -->
    <tal:temp-units tal:define="
      temp_units python:[u for u in summary if u['unit_type'] in ('refrigerator','freezer','water_bath','room_sensor')]">
      <tal:show tal:condition="python:bool(temp_units)">
        <div class="pfas-section-head">Temperature &amp; Humidity</div>
        <div class="pfas-tiles">
          <tal:each tal:repeat="unit temp_units">
            <div class="pfas-tile is-static is-left">
              <div class="pfas-tile-head">
                <span class="pfas-tile-icon"><svg class="pfas-ico" aria-hidden="true"><use tal:attributes="href python:'#' + view.unit_icon(unit['unit_type'])"/></svg></span>
                <div>
                  <div class="pfas-tile-title" tal:content="unit/name">Unit</div>
                  <div class="pfas-sub" tal:content="python:unit.get('location','')"></div>
                </div>
              </div>
              <tal:reading tal:define="r python:unit.get('last_reading')">
                <tal:has-reading tal:condition="r">
                  <div class="pfas-tile-stat is-md">
                    <tal:t tal:condition="python:r.get('temperature') is not None">
                      <tal:v tal:replace="python:'{:.1f}'.format(r['temperature'])"/>
                      <small>&deg;C</small>
                    </tal:t>
                    <tal:h tal:condition="python:r.get('humidity') is not None">
                      &nbsp;
                      <tal:v tal:replace="python:'{:.0f}'.format(r['humidity'])"/>
                      <small>% RH</small>
                    </tal:h>
                  </div>
                  <div class="pfas-tile-meta">
                    Range:
                    <tal:mn tal:replace="python:unit.get('temp_min','—')"/>–<tal:mx tal:replace="python:unit.get('temp_max','—')"/>&deg;C
                    &bull; Last: <tal:ts tal:replace="python:view.lab_at(r['ts'], r['ts'][:16].replace('T',' '))"/>
                  </div>
                </tal:has-reading>
                <tal:no-reading tal:condition="python:not r">
                  <div class="pfas-tile-stat is-quiet">No data yet</div>
                </tal:no-reading>
              </tal:reading>
              <span class="pfas-unit-state" tal:define="mk python:view.status_icon(unit['status'])" tal:condition="mk"><tal:m
                    tal:define="ic context/@@pfas-icons" tal:replace="structure python:ic.svg(mk, hidden=True, size='md')" /><span
                    tal:content="python:view.status_label(unit['status'])">Due</span></span>
              <div class="pfas-tile-foot">
                <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-temperature-log?unit_id=${unit/id}">View chart / temperature study</a>
              </div>
            </div>
          </tal:each>
        </div>
      </tal:show>
    </tal:temp-units>

    <!-- Balance units -->
    <tal:bal-units tal:define="
      bal_units python:[u for u in summary if u['unit_type'] in ('balance_analytical','balance_prep')]">
      <tal:show tal:condition="python:bool(bal_units)">
        <div class="pfas-section-head">Balances</div>
        <div class="pfas-tiles">
          <tal:each tal:repeat="unit bal_units">
            <div class="pfas-tile is-static is-left">
              <div class="pfas-tile-head">
                <span class="pfas-tile-icon"><svg class="pfas-ico" aria-hidden="true"><use tal:attributes="href python:'#' + view.unit_icon(unit['unit_type'])"/></svg></span>
                <div>
                  <div class="pfas-tile-title" tal:content="unit/name">Balance</div>
                  <div class="pfas-sub" tal:content="python:unit.get('location','')"></div>
                </div>
              </div>
              <tal:bv tal:define="bv python:unit.get('last_balance')">
                <tal:has tal:condition="bv">
                  <div class="pfas-tile-meta">
                    Checked by <tal:op tal:replace="python:bv['operator']"/> at
                    <tal:d tal:replace="python:bv['verified_date']"/>
                  </div>
                </tal:has>
                <tal:none tal:condition="python:not bv">
                  <div class="pfas-tile-meta">Not checked today</div>
                </tal:none>
              </tal:bv>
              <span class="pfas-unit-state" tal:define="mk python:view.status_icon(unit['status'])" tal:condition="mk"><tal:m
                    tal:define="ic context/@@pfas-icons" tal:replace="structure python:ic.svg(mk, hidden=True, size='md')" /><span
                    tal:content="python:view.status_label(unit['status'])">Due</span></span>
              <div class="pfas-tile-foot">
                <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-balance-log?unit_id=${unit/id}">Enter check</a>
              </div>
            </div>
          </tal:each>
        </div>
      </tal:show>
    </tal:bal-units>

    <!-- Eye wash stations: due once the type's frequency has passed since the
         last check; Enter check opens the check over the checklist -->
    <tal:ew-units tal:define="ew_units python:[u for u in summary if u['unit_type'] == 'eyewash']">
      <tal:show tal:condition="ew_units">
        <div class="pfas-section-head">Eye wash stations</div>
        <div class="pfas-tiles">
          <tal:each tal:repeat="unit ew_units">
            <div class="pfas-tile is-static is-left">
              <div class="pfas-tile-head">
                <span class="pfas-tile-icon"><svg class="pfas-ico" aria-hidden="true"><use tal:attributes="href python:'#' + view.unit_icon(unit['unit_type'])"/></svg></span>
                <div>
                  <div class="pfas-tile-title" tal:content="unit/name">Unit</div>
                  <div class="pfas-sub" tal:content="python:unit.get('location','')"></div>
                </div>
              </div>
              <div class="pfas-tile-meta" tal:define="ew python:unit.get('last_eyewash')">
                <tal:has tal:condition="ew">Last checked <tal:d tal:replace="ew/log_date"/></tal:has>
                <tal:none tal:condition="not:ew">Not checked yet</tal:none>
              </div>
              <span class="pfas-unit-state" tal:define="mk python:view.status_icon(unit['status'])" tal:condition="mk"><tal:m
                    tal:define="ic context/@@pfas-icons" tal:replace="structure python:ic.svg(mk, hidden=True, size='md')" /><span
                    tal:content="python:view.status_label(unit['status'])">Due</span></span>
              <div class="pfas-tile-foot">
                <button type="button" class="btn-sm btn-secondary"
                        tal:attributes="data-modal-open string:ew-modal-${unit/id}">Enter check</button>
              </div>
            </div>
            <div class="pfas-modal" tal:attributes="id string:ew-modal-${unit/id}">
              <div class="pfas-modal-box is-md" role="dialog" aria-modal="true"
                   tal:attributes="aria-labelledby string:ew-title-${unit/id}">
                <h2 tal:attributes="id string:ew-title-${unit/id}">Eye wash check <span tal:replace="unit/name">EW-1</span></h2>
                <form method="post" tal:attributes="action string:${purl}/@@pfas-eyewash-log">
                  <input type="hidden" name="unit_id" tal:attributes="value unit/id" />
                  <input type="hidden" name="return_to" value="checklist" />
                  <input type="hidden" name="log_date" tal:attributes="value view/today" />
                  <div class="pfas-form-row">
                    <div class="pfas-form-field"><span class="pfas-label">Operator</span>
                      <span tal:content="view/signed_in">Operator</span></div>
                    <div class="pfas-form-field"><span class="pfas-label">Working order</span>
                      <div class="pfas-radios">
                        <label class="pfas-check"><input type="radio" name="working" value="yes" checked="checked" /> <tal:m tal:define="ic context/@@pfas-icons" tal:replace="structure python:ic.svg('pass', hidden=True)" />Operational</label>
                        <label class="pfas-check"><input type="radio" name="working" value="no" /> <tal:m tal:define="ic context/@@pfas-icons" tal:replace="structure python:ic.svg('fail', hidden=True)" />Fault noted</label>
                      </div></div>
                    <label class="pfas-form-field">Flush water temp (&deg;C)
                      <input type="number" step="0.1" name="temperature" class="is-short" required="required" /></label>
                    <label class="pfas-form-field">Notes <input type="text" name="notes" /></label>
                  </div>
                  <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Save check</button>
                    <button class="btn btn-secondary" type="button" data-modal-close="data-modal-close">Cancel</button>
                  </div>
                </form>
              </div>
            </div>
          </tal:each>
        </div>
      </tal:show>
    </tal:ew-units>

    <!-- Water / Waste / Eye wash -->
    <tal:other-units tal:define="
      other_units python:[u for u in summary if u['unit_type'] == 'water_system']">
      <tal:show tal:condition="python:bool(other_units)">
        <div class="pfas-section-head">Other Daily Checks</div>
        <div class="pfas-tiles">
          <tal:each tal:repeat="unit other_units">
            <div class="pfas-tile is-static is-left">
              <div class="pfas-tile-head">
                <span class="pfas-tile-icon"><svg class="pfas-ico" aria-hidden="true"><use tal:attributes="href python:'#' + view.unit_icon(unit['unit_type'])"/></svg></span>
                <div>
                  <div class="pfas-tile-title" tal:content="unit/name">Unit</div>
                  <div class="pfas-sub" tal:content="python:unit.get('location','')"></div>
                </div>
              </div>
              <span class="pfas-unit-state" tal:define="mk python:view.status_icon(unit['status'])" tal:condition="mk"><tal:m
                    tal:define="ic context/@@pfas-icons" tal:replace="structure python:ic.svg(mk, hidden=True, size='md')" /><span
                    tal:content="python:view.status_label(unit['status'])">Due</span></span>
              <div class="pfas-tile-foot">
                <a class="btn-sm btn-secondary" tal:condition="python:unit['unit_type']=='water_system'"
                   tal:attributes="href string:${purl}/@@pfas-water-log">Enter reading</a>
              </div>
            </div>
          </tal:each>
          <!-- Waste log shortcut -->
          <div class="pfas-tile is-static is-left">
            <div class="pfas-tile-head">
              <span class="pfas-tile-icon"><svg class="pfas-ico" aria-hidden="true"><use href="#ico-waste"/></svg></span>
              <div>
                <div class="pfas-tile-title">Waste Containers (SAA)</div>
              </div>
            </div>
            <div class="pfas-tile-foot">
              <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-waste-log">Enter log</a>
            </div>
          </div>
        </div>
      </tal:show>
    </tal:other-units>

  </tal:groups>
  </tal:def>
</metal:content>
</body>
</html>
