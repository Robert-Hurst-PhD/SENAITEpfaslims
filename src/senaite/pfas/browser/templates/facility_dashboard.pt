<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Facility QC — Daily Checklist</title>
</head>
<body>
<tal:t metal:fill-slot="header-title">Facility QC — Daily Checklist</tal:t>
<metal:content metal:fill-slot="content">
  <tal:def tal:define="
    summary  view/summary;
    purl     view/portal_url;
  ">
  <p class="pfas-lead">
    ISO 17025 daily instrument and environmental verifications.
    <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-equipment"
      >Equipment</a>
  </p>

  <tal:no-units tal:condition="python:not summary">
    <div class="pfas-empty is-boxed">
      No equipment yet: each item is a SENAITE instrument with a type.
      <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-equipment"
        >Equipment</a>
    </div>
  </tal:no-units>

  <tal:groups tal:condition="python:bool(summary)">

    <!-- Temperature units -->
    <tal:temp-units tal:define="
      temp_units python:[u for u in summary if u['unit_type'] in ('refrigerator','freezer','room_sensor')]">
      <tal:show tal:condition="python:bool(temp_units)">
        <div class="pfas-section-head">Temperature &amp; Humidity</div>
        <div class="pfas-tiles">
          <tal:each tal:repeat="unit temp_units">
            <div class="pfas-tile is-static is-left">
              <div class="pfas-tile-head">
                <span class="pfas-tile-icon"><i tal:attributes="class python:view.unit_icon(unit['unit_type'])"></i></span>
                <div>
                  <div class="pfas-tile-title" tal:content="unit/name">Unit</div>
                  <div class="pfas-sub" tal:content="python:unit.get('location','')"></div>
                </div>
              </div>
              <tal:reading tal:define="r python:unit.get('last_reading')">
                <tal:has-reading tal:condition="r">
                  <div class="pfas-tile-stat is-md">
                    <tal:t tal:condition="python:r.get('temperature') is not None">
                      <tal:v tal:replace="python:'{:.1f}'.format(r['temperature'])"/>
                      <small>&deg;C</small>
                    </tal:t>
                    <tal:h tal:condition="python:r.get('humidity') is not None">
                      &nbsp;
                      <tal:v tal:replace="python:'{:.0f}'.format(r['humidity'])"/>
                      <small>% RH</small>
                    </tal:h>
                  </div>
                  <div class="pfas-tile-meta">
                    Range:
                    <tal:mn tal:replace="python:unit.get('temp_min','—')"/>–<tal:mx tal:replace="python:unit.get('temp_max','—')"/>&deg;C
                    &bull; Last: <tal:ts tal:replace="python:r['ts'][:16].replace('T',' ')"/>
                  </div>
                </tal:has-reading>
                <tal:no-reading tal:condition="python:not r">
                  <div class="pfas-tile-stat is-quiet">No data yet</div>
                </tal:no-reading>
              </tal:reading>
              <span tal:attributes="class python:'badge '+view.status_class(unit['status']).replace('fqc-','badge-')"
                    tal:content="python:view.status_label(unit['status'])"></span>
              <div class="pfas-tile-foot">
                <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-temperature-log?unit_id=${unit/id}">View chart / temperature study</a>
              </div>
            </div>
          </tal:each>
        </div>
      </tal:show>
    </tal:temp-units>

    <!-- Balance units -->
    <tal:bal-units tal:define="
      bal_units python:[u for u in summary if u['unit_type'] in ('balance_analytical','balance_prep')]">
      <tal:show tal:condition="python:bool(bal_units)">
        <div class="pfas-section-head">Balances</div>
        <div class="pfas-tiles">
          <tal:each tal:repeat="unit bal_units">
            <div class="pfas-tile is-static is-left">
              <div class="pfas-tile-head">
                <span class="pfas-tile-icon"><i tal:attributes="class python:view.unit_icon(unit['unit_type'])"></i></span>
                <div>
                  <div class="pfas-tile-title" tal:content="unit/name">Balance</div>
                  <div class="pfas-sub" tal:content="python:unit.get('location','')"></div>
                </div>
              </div>
              <tal:bv tal:define="bv python:unit.get('last_balance')">
                <tal:has tal:condition="bv">
                  <div class="pfas-tile-meta">
                    Verified by <tal:op tal:replace="python:bv['operator']"/> at
                    <tal:d tal:replace="python:bv['verified_date']"/>
                  </div>
                </tal:has>
                <tal:none tal:condition="python:not bv">
                  <div class="pfas-tile-meta">Not verified today</div>
                </tal:none>
              </tal:bv>
              <span tal:attributes="class python:'badge '+view.status_class(unit['status']).replace('fqc-','badge-')"
                    tal:content="python:view.status_label(unit['status'])"></span>
              <div class="pfas-tile-foot">
                <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-balance-log?unit_id=${unit/id}">Enter verification</a>
              </div>
            </div>
          </tal:each>
        </div>
      </tal:show>
    </tal:bal-units>

    <!-- Water / Waste / Eye wash -->
    <tal:other-units tal:define="
      other_units python:[u for u in summary if u['unit_type'] in ('water_system','eyewash')]">
      <tal:show tal:condition="python:bool(other_units)">
        <div class="pfas-section-head">Other Daily Checks</div>
        <div class="pfas-tiles">
          <tal:each tal:repeat="unit other_units">
            <div class="pfas-tile is-static is-left">
              <div class="pfas-tile-head">
                <span class="pfas-tile-icon"><i tal:attributes="class python:view.unit_icon(unit['unit_type'])"></i></span>
                <div>
                  <div class="pfas-tile-title" tal:content="unit/name">Unit</div>
                  <div class="pfas-sub" tal:content="python:unit.get('location','')"></div>
                </div>
              </div>
              <span tal:attributes="class python:'badge '+view.status_class(unit['status']).replace('fqc-','badge-')"
                    tal:content="python:view.status_label(unit['status'])"></span>
              <div class="pfas-tile-foot">
                <a class="btn-sm btn-secondary" tal:condition="python:unit['unit_type']=='water_system'"
                   tal:attributes="href string:${purl}/@@pfas-water-log">Enter reading</a>
                <a class="btn-sm btn-secondary" tal:condition="python:unit['unit_type']=='eyewash'"
                   tal:attributes="href string:${purl}/@@pfas-eyewash-log?unit_id=${unit/id}">Enter check</a>
              </div>
            </div>
          </tal:each>
          <!-- Waste log shortcut -->
          <div class="pfas-tile is-static is-left">
            <div class="pfas-tile-head">
              <span class="pfas-tile-icon"><i class="fas fa-trash-alt"></i></span>
              <div>
                <div class="pfas-tile-title">Waste Containers (SAA)</div>
              </div>
            </div>
            <div class="pfas-tile-foot">
              <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-waste-log">Enter log</a>
            </div>
          </div>
        </div>
      </tal:show>
    </tal:other-units>

  </tal:groups>
  </tal:def>
</metal:content>
</body>
</html>
