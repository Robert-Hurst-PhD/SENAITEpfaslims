<!-- shared by the page and its packet PDF: one study's results per level
     and what approval writes to the method profile -->
<metal:results define-macro="results" tal:define="rec view/record; applied view/applied">
  <tal:lv repeat="lv view/level_rows">
  <h3 class="bench-h" tal:condition="python:lv[0]" tal:content="python:u'%s (%s)' % (lv[0], view.fmt(view.fortified(lv[0])))">Low</h3>
  <table class="pfas-table" tal:condition="python:rec['kind'] == 'pt'">
    <thead><tr><th>Analyte</th><th>Reported</th><th>Assigned</th><th>Verdict</th></tr></thead>
    <tbody><tr tal:repeat="row python:lv[1]">
      <td tal:content="python:row[0]">PFOA</td><td tal:content="python:row[1].get('reported')">5</td>
      <td tal:content="python:row[1].get('assigned')">5.2</td><td tal:content="python:row[1].get('verdict')">acceptable</td></tr></tbody>
  </table>
  <table class="pfas-table" tal:condition="python:rec['kind'] != 'pt'">
    <thead><tr><th>Analyte</th><th>n</th><th>Mean</th><th>s</th><th>Figure</th><th>Value</th><th>In force</th><th>Verdict</th><th>Notes</th></tr></thead>
    <tbody>
      <tr tal:repeat="row python:lv[1]">
        <tal:d define="kw python:row[0]; res python:row[1]">
          <td tal:content="kw">PFOA</td>
          <td tal:content="python:res.get('n_spikes', res.get('n'))">7</td>
          <td tal:content="python:view.fmt(res.get('mean_spikes', res.get('mean')))">1.0</td>
          <td tal:content="python:view.fmt(res.get('sd_spikes', res.get('sd')))">0.1</td>
          <td tal:content="python:{'mdl': u'MDL (MDLs / MDLb)', 'mrl': u'PIR upper / lower %', 'pa': u'RSD % / recovery %', 'dl': u'DL'}.get(rec['kind'])">MDL</td>
          <td tal:content="python:{'mdl': u'%s (%s / %s)' % (view.fmt(res.get('mdl')), view.fmt(res.get('mdl_s')), view.fmt(res.get('mdl_b'))), 'mrl': u'%s / %s' % (view.fmt(res.get('upper_pir_pct')), view.fmt(res.get('lower_pir_pct'))), 'pa': u'%s / %s' % (view.fmt(res.get('rsd_pct')), view.fmt(res.get('mean_recovery_pct'))), 'dl': view.fmt(res.get('dl'))}.get(rec['kind'])">0.3</td>
          <td tal:content="python:view.fmt(view.existing().get(kw)) if rec['kind'] == 'mdl' else u''">0.25</td>
          <td tal:content="res/verdict">pass</td>
          <td tal:content="python:u'; '.join([x for x in (res.get('reason'), res.get('mdl_b_rule')) if x] + list(res.get('notes') or []) + ([u'may keep the MDL in force (App. B 4(f))'] if res.get('may_keep_existing') else []))">notes</td>
        </tal:d>
      </tr>
    </tbody>
  </table>
  </tal:lv>
  <h3 class="bench-h" tal:condition="applied">Reporting Limits on approval</h3>
  <table class="pfas-table" tal:condition="applied">
    <tbody><tr tal:repeat="item python:sorted(applied.items())">
      <td tal:content="python:item[0]">PFOA</td>
      <td tal:content="python:u', '.join(u'%s %s' % (k, v) for k, v in sorted(item[1].items()))">mdl 0.3</td></tr></tbody>
  </table>
</metal:results>
