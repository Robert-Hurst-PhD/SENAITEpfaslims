<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Reference Definition Setup</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
    /* ── Setup refs page-specific ─────────────────────────────────────── */
    .info-card { background: var(--s-bg); border-radius: 6px;
                 border: 1px solid var(--s-border);
                 box-shadow: 0 1px 3px rgba(0,0,0,.06);
                 padding: 16px 20px; margin-bottom: 18px; }
    .info-card h2 { font-size: 14px; font-weight: 700; margin-bottom: 10px;
                    color: var(--s-primary); }
    .info-card p  { font-size: 12px; color: var(--s-secondary); line-height: 1.6; margin-bottom: 6px; }

    .ref-table { width: 100%; border-collapse: collapse; font-size: 12px;
                 background: var(--s-bg); border-radius: 6px;
                 box-shadow: 0 1px 3px rgba(0,0,0,.06); overflow: hidden; }
    .ref-table th { background: var(--s-dark); color: #fff; padding: 8px 12px;
                    text-align: left; font-size: 11px; text-transform: uppercase;
                    letter-spacing: .05em; font-weight: 700; }
    .ref-table td { padding: 8px 12px; border-bottom: 1px solid var(--s-border); }
    .ref-table tr:last-child td { border-bottom: none; }
    .ref-table tr:hover td { background: var(--s-primary-lt); }

    /* .badge base is global (pfas_macros) — page-specific colours: */
    .badge-blank    { background: var(--s-primary-lt); color: var(--s-primary); }
    .badge-control  { background: #f3e5f5; color: #6a1b9a; }
    .badge-recovery { background: #d4edda; color: #155724; }
    .badge-cal      { background: #fff3cd; color: #856404; }
    .badge-rpd      { background: #f8d7da; color: #721c24; }

    .existing-list { background: var(--s-bg); border-radius: 6px;
                     border: 1px solid var(--s-border);
                     box-shadow: 0 1px 3px rgba(0,0,0,.06);
                     padding: 14px 18px; margin-bottom: 18px; }
    .existing-list h2 { font-size: 13px; font-weight: 700; margin-bottom: 8px; color: var(--s-body); }
    .existing-list ul { list-style: none; margin: 0; }
    .existing-list li { font-size: 12px; color: var(--s-success); padding: 2px 0; }
    .existing-list li::before { content: "\2713  "; }

    .action-bar { background: var(--s-bg); border-radius: 6px;
                  border: 1px solid var(--s-border);
                  box-shadow: 0 1px 3px rgba(0,0,0,.06);
                  padding: 16px 18px; margin-top: 20px;
                  display: flex; gap: 12px; align-items: center; }
    .btn-run { background: var(--s-primary); color: #fff; border: none; border-radius: 4px;
               padding: 12px 32px; cursor: pointer; font-size: 14px; font-weight: 700; }
    .btn-run:hover { background: var(--s-primary-dk); }
    .btn-run:disabled { background: var(--s-secondary); cursor: not-allowed; }
    .action-note { font-size: 11px; color: var(--s-secondary); line-height: 1.5; }
  </style>
  </tal:styles>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Reference Definition Setup</tal:t>
  <tal:r metal:fill-slot="header-right">
    <span class="role-badge">LabManager</span>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <div class="alert alert-success" tal:condition="view/save_message">
      Reference definitions updated:
      <strong tal:content="python:view.save_message().replace('_', ' ')">&#8212;</strong>
    </div>

    <div class="alert alert-error" tal:condition="not:view/is_manager">
      You do not have the Manager or LabManager role. The setup button is disabled.
    </div>

    <div class="info-card">
      <h2>What this does</h2>
      <p>
        Creates one <strong>ReferenceDefinition</strong> in SENAITE for each QC type
        (MB, LRB, MxB, CAL, ICV, CCV, LCS, LFSM, LFSMD, Dup). Each definition is
        populated with per-analyte expected values, acceptance ranges, and error
        tolerances derived from the current QC rules.
      </p>
      <p>
        This operation is <strong>idempotent</strong> &#8212; running it again after changing
        a rule simply updates the existing definitions without creating duplicates.
      </p>
      <p>
        <strong>Prerequisite:</strong> the GenericSetup profile must have been
        installed first to create the AnalysisService objects.
        This view reports how many services it found.
      </p>
      <p>
        Analyte services found: <strong tal:content="view/analyte_count">0</strong>
      </p>
    </div>

    <div class="existing-list">
      <h2>Existing Reference Definitions</h2>
      <tal:ex tal:define="existing view/existing_ref_defs">
        <ul tal:condition="existing">
          <tal:it tal:repeat="t existing">
            <li tal:content="t">PFAS CCV</li>
          </tal:it>
        </ul>
        <p tal:condition="not:existing" style="font-size:12px;color:var(--s-secondary)">
          None found yet &#8212; run the setup below to create them.
        </p>
      </tal:ex>
    </div>

    <div class="table-wrap">
    <table class="ref-table">
      <thead>
        <tr>
          <th>QC Type</th>
          <th>Reference Definition Title</th>
          <th>Type</th>
          <th>Acceptance Criteria</th>
        </tr>
      </thead>
      <tbody>
        <tal:rows tal:repeat="row view/qc_type_specs">
          <tr>
            <td><strong tal:content="row/code">CCV</strong></td>
            <td tal:content="row/title">PFAS CCV</td>
            <td>
              <span class="badge badge-blank"    tal:condition="row/is_blank">Blank</span>
              <span tal:condition="not:row/is_blank">
                <span class="badge badge-recovery"
                      tal:condition="python:row['strategy'] in ('recovery','recovery_dup')">Recovery</span>
                <span class="badge badge-cal"
                      tal:condition="python:row['strategy'] in ('cal_dev','cal_dev_tight')">Cal Check</span>
                <span class="badge badge-rpd"
                      tal:condition="python:row['strategy'] == 'rpd'">RPD</span>
              </span>
            </td>
            <td tal:content="row/spec">&#8212;</td>
          </tr>
        </tal:rows>
      </tbody>
    </table>
    </div>

    <div class="action-bar">
      <form method="POST" action=""
            tal:attributes="action string:${context/absolute_url}/@@pfas-setup-references"
            onsubmit="return confirm('Create/update all Reference Definitions now?')">
        <button type="submit" class="btn-run"
                tal:attributes="disabled python:not view.is_manager()">
          Create / Update Reference Definitions
        </button>
      </form>
      <span class="action-note">
        Safe to run repeatedly. Analyte values are refreshed from the current QC
        rules each time. To change acceptance criteria, edit them in
        <a tal:attributes="href string:${context/absolute_url}/@@pfas-qc-rules">
          QC Rule Configuration
        </a>
        first, then run this setup again.
      </span>
    </div>

  <div class="pane-footer">
    <span>Creates/updates SENAITE ReferenceDefinitions from QC rules</span>
    <span class="pf-path" tal:content="view/rules_path">/data/qc/qc_rules.json</span>
  </div>
  </div>
  </div><!-- /content slot -->
</body>
</html>
