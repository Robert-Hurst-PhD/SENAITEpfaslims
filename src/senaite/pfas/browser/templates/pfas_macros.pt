<!DOCTYPE html>
<html metal:define-macro="page" lang="en"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      tal:define="dummy python:context.restrictedTraverse('@@pfas-macros').require_login()"
      tal:attributes="data-lab-today context/@@pfas-macros/data_lab_today">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="pfas-lab-name" tal:attributes="content context/@@pfas-macros/lab_name" />
  <title metal:define-slot="title">LIMS Tool</title>
  <link rel="icon" type="image/x-icon" tal:attributes="href string:${context/portal_url}/++resource++senaite.pfas/favicon.ico" />
  <link rel="apple-touch-icon" tal:attributes="href string:${context/portal_url}/++resource++senaite.pfas/favicon-180.png" />
  <!-- the icon set core pages already have (Font Awesome 5 Free, served by SENAITE) -->
  <link rel="stylesheet"
        tal:attributes="href string:${context/portal_url}/++plone++senaite.impress.static/modules/fontawesome-free/css/all.min.css" />
  <link rel="stylesheet" type="text/css"
        tal:attributes="href string:${context/portal_url}/++resource++senaite.pfas/pfas-tokens.css?v=${context/@@pfas-macros/asset_version}" />
  <!-- the shared components (segmented control, switch, filter bar, tree, action menu,
       drawer ...): one file for PFAS and core pages alike (decided 2026-10-11) -->
  <link rel="stylesheet" type="text/css"
        tal:attributes="href string:${context/portal_url}/++resource++senaite.pfas/pfas-components.css?v=${context/@@pfas-macros/asset_version}" />
  <script tal:attributes="src string:${context/portal_url}/++resource++senaite.pfas/pfas-components.js?v=${context/@@pfas-macros/asset_version}"></script>
  <!-- controlled documents on paper: the lab theme, the control block and the footer -->
  <link rel="stylesheet" type="text/css" media="print"
        tal:attributes="href string:${context/portal_url}/++resource++senaite.pfas/pfas-print.css?v=${context/@@pfas-macros/asset_version}" />
  <script tal:attributes="src string:${context/portal_url}/++resource++senaite.pfas/pfas-print.js?v=${context/@@pfas-macros/asset_version}"></script>
  <!-- the one top toolbar, shared with core pages -->
  <link rel="stylesheet" type="text/css"
        tal:attributes="href string:${context/portal_url}/++resource++senaite.pfas/vendor/adminlte-topbar-3.2.0.css" />
  <link rel="stylesheet" type="text/css"
        tal:attributes="href string:${context/portal_url}/++resource++senaite.pfas/pfas-topbar.css?v=${context/@@pfas-macros/asset_version}" />
  <script tal:attributes="src string:${context/portal_url}/++resource++senaite.pfas/pfas-topbar.js?v=${context/@@pfas-macros/asset_version}"></script>
  <link rel="stylesheet" type="text/css"
        tal:attributes="href string:${context/portal_url}/++resource++senaite.pfas/pfas-shell.css?v=${context/@@pfas-macros/asset_version}" />
  <link rel="stylesheet" type="text/css"
        tal:attributes="href string:${context/portal_url}/++resource++senaite.pfas/pfas-sidebar.css?v=${context/@@pfas-macros/asset_version}" />
  <tal:head-extra metal:define-slot="head-extra" />
</head>
<body class="pfas-app">
  <a class="pfas-skip" href="#pfas-content-area">Skip to content</a>
  <!-- ── Shared print header/footer — settings at Configuration → Print
       Settings (@@pfas-print-settings). Hidden on screen; renders on EVERY
       print so a standard form and a CoC produce consistent audit copies.
       Standalone templates (receipt.pt) reuse via macros/printhead. ──── -->
  <!-- "?" for one section: define hid (a help_dictionary id) where used. A
       button that opens the entry in the Help panel beside the page
       (pfas-components.js), named by the entry's term; the same markup as
       help_dictionary.help_button. Wrapped so the definition itself never
       renders inside the page. -->
  <tal:defs tal:condition="nothing"><button metal:define-macro="help" type="button" class="btn-help"
     aria-haspopup="dialog"
     tal:define="hterm python:context.restrictedTraverse('@@pfas-macros').help_term(hid)"
     tal:attributes="data-help-entry hid; aria-label string:Help: ${hterm}">?</button></tal:defs>

  <!-- A pass / fail result as a symbol: define pf_ok (True, False, or None
       for not judged). The word is its accessible name and tooltip. -->
  <tal:defs tal:condition="nothing"><tal:pf metal:define-macro="pass-mark"><span
     tal:condition="python:pf_ok is not None"
     tal:attributes="class python:'badge badge-ok pfas-mark' if pf_ok else 'badge badge-fail pfas-mark';
                     title python:'Pass' if pf_ok else 'Fail'; aria-label python:'Pass' if pf_ok else 'Fail'"
     role="img" tal:content="python:u'\u2713' if pf_ok else u'\u2717'">&#10003;</span><span
     tal:condition="python:pf_ok is None" class="pfas-muted">&#8212;</span></tal:pf></tal:defs>

  <!-- A status badge that can need attention: define attn_label (the
       status), attn_cls (its badge class) and attn_reasons (a list, empty
       when nothing needs doing). With reasons the badge turns amber and a
       "!" beside it names them, on hover and to a screen reader. -->
  <tal:defs tal:condition="nothing"><tal:attn metal:define-macro="status-attention"><span
     tal:attributes="class python:'badge badge-warn' if attn_reasons else attn_cls"
     tal:content="attn_label">Active</span><span tal:condition="attn_reasons" class="pfas-attn" role="img" tabindex="0"
     tal:attributes="title python:u'\u003b '.join(attn_reasons); aria-label python:u'\u003b '.join(attn_reasons)">!</span></tal:attn></tal:defs>

  <!-- QC values as judged (qc_cells): one cell, and one table of cells.
       qc_value: define qv_cell = {text, word, cls, tip, notes, n}
       (cell_display, code_cell): a pass plain, Review and Fail a chip with
       the word after the value. qc_values: define qv_group = {title,
       columns, rows, notes} (qc_cells.tables) and qv_method (named in the
       notes): numbers end at the right, a row with a failing value carries
       the coral edge, one for review only the amber. Data Review's Spike QC
       and Final Data draw their values with these.
       Wrapped so the definitions never render inside the page. -->
  <tal:defs tal:condition="nothing">
    <tal:cell metal:define-macro="qc_value"><span
        tal:attributes="class string:qv ${qv_cell/cls}; title qv_cell/tip; aria-label qv_cell/tip;
                        data-prov python:(qv_cell.get('prov') or [None])[0];
                        role python:'button' if qv_cell.get('prov') else None;
                        tabindex python:0 if qv_cell.get('prov') else None"
        ><tal:t tal:replace="qv_cell/text">98</tal:t><span class="qv-word" tal:condition="qv_cell/word|nothing"
        tal:content="qv_cell/word">Fail</span></span><sup class="qv-cite"
        tal:condition="qv_cell/notes|nothing" tal:content="python:u','.join(str(n) for n in qv_cell['notes'])">2</sup><span
        class="qv-n" tal:condition="python:(qv_cell.get('n') or 1) > 1"
        tal:attributes="title python:u'This cell summarises %d injections and shows the worst' % qv_cell['n']"
        tal:content="python:u'worst of %d' % qv_cell['n']">worst of 2</span></tal:cell>

    <section class="qv-group" metal:define-macro="qc_values">
      <h3 class="qv-group-title" tal:content="qv_group/title">Extracted QC</h3>
      <div class="table-wrap">
        <table class="pfas-table qv-table" data-col-resize="pfas-macros-qv-table">
          <thead>
            <tr>
              <th>Analyte</th>
              <th class="is-right num" tal:repeat="col qv_group/columns">
                <span tal:replace="col/key">LFSM</span>
                <span class="qv-unit" tal:condition="col/unit" tal:content="string:(${col/unit})">(Recovery %)</span><sup class="qv-cite"
                     tal:condition="col/notes" tal:content="python:u','.join(str(n) for n in col['notes'])">1</sup>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr tal:repeat="row qv_group/rows"
                tal:attributes="class python:{'fail': 'is-fail', 'review': 'is-review'}.get(row.get('state'))">
              <td class="qv-analyte" tal:content="row/analyte">analyte</td>
              <td class="is-right num" tal:repeat="col qv_group/columns">
                <tal:c tal:define="qv_cell python:row['display'].get(col['key'])">
                  <tal:d tal:condition="qv_cell"><metal:m use-macro="context/@@pfas-macros/macros/qc_value" /></tal:d>
                  <span class="pfas-muted" tal:condition="not:qv_cell">&#8212;</span>
                </tal:c>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <ol class="qv-notes" tal:condition="qv_group/notes">
        <li tal:repeat="n qv_group/notes" tal:attributes="value python:n[0]"
            tal:content="python:u'%s (%s method profile)' % (n[1], qv_method or u'the')">LFSM recovery 70-130 %</li>
      </ol>
    </section>
  </tal:defs>

  <!-- The printed header: lab, title and the control block (document, revision,
       date, printed), with the footer rule as page margin boxes. A view says what
       document it is through `print_control` (a dict or a method; see
       pfas_macros.print_block); a page that does not prints under its own title. -->
  <div class="pfas-printhead pd" id="pfas-printhead" metal:define-macro="printhead"
       tal:define="v nocall:view|nothing;
                   pc python:context.restrictedTraverse('@@pfas-macros').print_block(getattr(v, 'print_control', None))"
       tal:attributes="data-auto python:'1' if pc['auto'] else '0'; data-foot pc/foot">
    <style id="pfas-pagefoot" tal:content="structure pc/css">@page {}</style>
    <tal:h tal:replace="structure pc/head" />
  </div>

  <!-- ── Shared QA sign-off attestation ────────────────────────────────────
       Rendered 3-tier attestation (Analyst prepared → QAO verified → Lab
       Director authorized) with signature stamps, for controlled printable
       records (SOP, prep logs FM-ENV-25x, prepared standards). Define-once
       (§6C/§7). QAO + Director come from Print Settings; the preparer + date
       are passed by the calling template. A missing stamp prints a ruled line
       for wet signature. Caller sets: signoff_noun, signoff_prepared_name,
       signoff_prepared_date, signoff_prepared_initials (any may be omitted).
         <tal:s metal:use-macro="context/@@pfas-macros/macros/signoff"
                tal:define="signoff_noun string:reagent;
                            signoff_prepared_name python:view.data().get('prepared_by','');
                            signoff_prepared_date python:view.data().get('prepared_date','');
                            signoff_prepared_initials python:view.data().get('prepared_by','')" />
       ──────────────────────────────────────────────────────────────────── -->
  <div class="pfas-signoff" metal:define-macro="signoff"
       tal:define="nn signoff_noun|nothing;
                   ps python:context.restrictedTraverse('@@pfas-macros').print_settings();
                   render python:bool(nn) and ps.get('show_signoff', True);
                   signers python:context.restrictedTraverse('@@pfas-macros').signoff_signers();
                   noun python:nn or 'document';
                   prep_name signoff_prepared_name|string:;
                   prep_date signoff_prepared_date|string:;
                   prep_ini signoff_prepared_initials|string:;
                   prep_sig python:context.restrictedTraverse('@@pfas-macros').signature_for_initials(prep_ini);
                   qao signers/qao;
                   director signers/director"
       tal:condition="render">
    <div class="pfas-signoff-title">Quality Assurance Documentation</div>
    <table class="pfas-signoff-tbl no-mobile-scroll">
      <tbody>
      <tr>
        <td class="so-role">Prepared&nbsp;by</td>
        <td class="so-who">
          This <tal:n tal:replace="noun">document</tal:n> was prepared by
          <strong tal:content="python:prep_name or (prep_sig and prep_sig['fullname']) or '—'">analyst</strong>.
        </td>
        <td class="so-sig">
          <img class="so-stamp" tal:condition="prep_sig/signature_url|nothing"
               tal:attributes="src prep_sig/signature_url; alt prep_sig/fullname"/>
          <span class="so-line" tal:condition="not:prep_sig/signature_url|python:True">&nbsp;</span>
        </td>
        <td class="so-date">Date:
          <tal:d tal:condition="prep_date" tal:replace="prep_date"/>
          <span class="so-line" tal:condition="not:prep_date">&nbsp;</span>
        </td>
      </tr>
      <tr>
        <td class="so-role">Verified&nbsp;by</td>
        <td class="so-who">
          Reviewed and verified by
          <strong tal:content="python:(qao and qao['fullname']) or '—'">QAO</strong>,
          <span class="so-title">Quality Assurance Officer</span>.
        </td>
        <td class="so-sig">
          <img class="so-stamp" tal:condition="qao/signature_url|nothing"
               tal:attributes="src qao/signature_url; alt qao/fullname"/>
          <span class="so-line" tal:condition="not:qao/signature_url|python:True">&nbsp;</span>
        </td>
        <td class="so-date">Date: <span class="so-line">&nbsp;</span></td>
      </tr>
      <tr>
        <td class="so-role">Authorized&nbsp;by</td>
        <td class="so-who">
          Authorized by
          <strong tal:content="python:(director and director['fullname']) or '—'">Director</strong>,
          <span class="so-title">Laboratory Director</span>.
        </td>
        <td class="so-sig">
          <img class="so-stamp" tal:condition="director/signature_url|nothing"
               tal:attributes="src director/signature_url; alt director/fullname"/>
          <span class="so-line" tal:condition="not:director/signature_url|python:True">&nbsp;</span>
        </td>
        <td class="so-date">Date: <span class="so-line">&nbsp;</span></td>
      </tr>
      </tbody>
    </table>
    <div class="pfas-signoff-foot" tal:condition="python:(qao and qao['placeholder']) or (director and director['placeholder']) or not qao or not director">
      Set the Quality Assurance Officer and Laboratory Director (with
      uploaded signature images) at Configuration &#8594; Print Settings.
    </div>
  </div>

<!-- ── Top toolbar: the one bar every page draws (templates/pfas_topbar.pt).
     header-title names the page; header-context holds a chip saying what the
     page is about (method, batch, state) and nothing clickable. Page actions
     and back buttons go in header-right, drawn in the sub-bar below. -->
<metal:topbar use-macro="context/@@pfas-topbar/macros/topbar">
  <tal:t metal:fill-slot="bar-title"><tal:t metal:define-slot="header-title">LIMS Tool</tal:t></tal:t>
  <tal:c metal:fill-slot="bar-context"><tal:c metal:define-slot="header-context" /></tal:c>
</metal:topbar>

<!-- ── Shell ───────────────────────────────────────────────────────────────── -->
<div class="pfas-shell" id="pfas-shell">

  <!-- Unified sidebar — suppressed for anonymous users (Client Tracker / public pages).
       Authenticated staff always see the full sidebar regardless of page. -->
  <tal:sb tal:define="is_anon python:context.portal_membership.isAnonymousUser()"
          tal:condition="python:not is_anon"
          tal:replace="structure context/@@pfas-macros/render_sidebar" />

  <!-- Main: tabs + content + action bar -->
  <div class="pfas-main">

    <!-- Sub-bar: breadcrumb + page actions, fixed above the tabs so neither
         scrolls away. The crumb is drawn on the server from the navigation
         map (view/crumb_trail), so it names the page's place and can never
         disagree with the nav. -->
    <div class="pfas-subbar">
      <nav class="pfas-crumb" id="pfas-crumb" aria-label="Breadcrumb"
           tal:define="is_anon python:context.portal_membership.isAnonymousUser(); trail context/@@pfas-macros/crumb_trail">
        <ol class="pfas-crumb-list" tal:condition="python:trail and not is_anon">
          <tal:c tal:repeat="c trail"><li class="pfas-crumb-item"
            ><a class="btn-sm btn-secondary" tal:condition="python:c['kind'] == 'link'"
                tal:attributes="href string:${context/portal_url}/${c/url}" tal:content="c/label">Section</a
            ><span tal:condition="python:c['kind'] == 'text'" tal:content="c/label">Section</span
            ><span class="pfas-crumb-here" aria-current="page" tal:condition="python:c['kind'] == 'here'" tal:content="c/label">Page</span
            ><span class="pfas-crumb-here" aria-current="page" tal:condition="python:c['kind'] == 'title'"><tal:t metal:define-slot="header-title">LIMS Tool</tal:t></span
          ></li></tal:c>
        </ol>
      </nav>
      <div class="pfas-subbar-actions"><tal:r metal:define-slot="header-right" /></div>
    </div>

    <!-- Top tabs: the page's own tabs slot. -->
    <div class="pfas-tabs-wrap">
      <tal:tabs metal:define-slot="tabs">
        <!-- Default: no tabs; the wrap is present but takes no visual space -->
      </tal:tabs>
    </div>

    <!-- Stable content area; the Help panel docks at its right edge, beside
         the page and not over it (a section's "?" opens it, pfas-components.js) -->
    <div class="pfas-content-row">
    <main class="pfas-content-area" id="pfas-content-area" tabindex="-1">
      <tal:body metal:define-slot="content">
        <div class="page-body">
          <p>No content.</p>
        </div>
      </tal:body>
    </main>
    <aside class="pfas-help-panel" id="pfas-help-panel" hidden="hidden" role="dialog" aria-modal="false"
           aria-labelledby="pfas-help-title"
           tal:attributes="data-help-url string:${context/portal_url}/@@pfas-help">
      <div class="pfas-help-head">
        <h2 class="pfas-help-title" id="pfas-help-title" tabindex="-1">Help</h2>
        <button type="button" class="btn-sm btn-secondary pfas-help-close">Close</button>
      </div>
      <div class="pfas-help-body"></div>
    </aside>
    </div>

    <!-- Pinned action bar (outside scroll area — always visible) -->
    <div class="pfas-action-bar-wrap">
      <tal:ab metal:define-slot="action-bar">
        <!-- Default: empty; forms fill this slot with a .pfas-action-bar div -->
      </tal:ab>
    </div>

  </div><!-- /pfas-main -->
</div><!-- /pfas-shell -->

<script tal:attributes="src string:${context/portal_url}/++resource++senaite.pfas/pfas-shell.js?v=${context/@@pfas-macros/asset_version}"></script>

<!-- Backward-compat JS slots (placed before </body> so scripts can reference DOM) -->
<tal:body-extra metal:define-slot="body-extra" />
<tal:scripts metal:define-slot="scripts" />

</body>
</html>
