<!DOCTYPE html>
<html metal:define-macro="page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      tal:define="dummy python:context.restrictedTraverse('@@pfas-macros').require_login()">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title metal:define-slot="title">LIMS Tool</title>
  <!-- Font Awesome 5 Solid — font face + icon glyphs used by the PFAS sidebar.
       senaite.core.css is not loaded on PFAS workspace pages (they bypass
       Plone's main_template), so we inline the @font-face, the .fas base
       rule, and the content codes for every icon used in the sidebar here. -->
  <style>
    @font-face {
      font-family: 'Font Awesome 5 Free';
      font-style: normal;
      font-weight: 900;
      font-display: block;
      src: url('/senaite/++plone++senaite.core.static/fonts/fa-solid-900.woff2') format('woff2'),
           url('/senaite/++plone++senaite.core.static/fonts/fa-solid-900.woff') format('woff');
    }
    .fas {
      font-family: 'Font Awesome 5 Free';
      font-weight: 900;
      display: inline-block;
      font-style: normal;
      font-variant: normal;
      text-rendering: auto;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      line-height: 1;
    }
    /* Sidebar icon glyphs (extracted from senaite.core.css FA5 bundle) */
    .fa-book:before{content:"\f02d"}
    .fa-book-open:before{content:"\f518"}
    .fa-building:before{content:"\f1ad"}
    .fa-chart-line:before{content:"\f201"}
    .fa-clipboard-list:before{content:"\f46d"}
    .fa-code-branch:before{content:"\f126"}
    .fa-cog:before{content:"\f013"}
    .fa-cogs:before{content:"\f085"}
    .fa-comments:before{content:"\f086"}
    .fa-file-alt:before{content:"\f15c"}
    .fa-file-export:before{content:"\f56e"}
    .fa-file-upload:before{content:"\f574"}
    .fa-flask:before{content:"\f0c3"}
    .fa-globe:before{content:"\f0ac"}
    .fa-hashtag:before{content:"\f292"}
    .fa-layer-group:before{content:"\f5fd"}
    .fa-map-marker-alt:before{content:"\f3c5"}
    .fa-microscope:before{content:"\f610"}
    .fa-search:before{content:"\f002"}
    .fa-sign-out-alt:before{content:"\f2f5"}
    .fa-sliders-h:before{content:"\f1de"}
    .fa-tasks:before{content:"\f0ae"}
    .fa-th:before{content:"\f00a"}
    .fa-times:before{content:"\f00d"}
    .fa-toggle-on:before{content:"\f205"}
    .fa-tools:before{content:"\f7d9"}
    .fa-user-cog:before{content:"\f4fe"}
    .fa-vial:before{content:"\f492"}
    .fa-vials:before{content:"\f493"}
    .fa-warehouse:before{content:"\f494"}
    .fa-wrench:before{content:"\f0ad"}
  </style>
  <style>
    /* ── SENAITE palette tokens (senaite.core 2.6 Bootstrap 4 base) ─────── */
    :root {
      --s-primary:      #428aaf;
      --s-primary-dk:   #387493;
      --s-primary-lt:   #e8f4f8;
      --s-dark:         #343a40;
      --s-body:         #293333;
      --s-secondary:    #6c757d;
      --s-light:        #f8f9fa;
      --s-bg:           #ffffff;
      --s-border:       #dee2e6;
      --s-input-border: #ced4da;
      --s-input-text:   #495057;
      --s-success:      #28a745;
      --s-danger:       #dc3545;
      --s-warning:      #fd7e14;
      --s-focus-ring:   rgba(66,138,175,.25);

      --pfas-panel-width:  220px;
      --pfas-rail-width:   48px;
      --pfas-header-h:     52px;
    }

    /* ── Reset ───────────────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── App shell layout ────────────────────────────────────────────────── */
    body.pfas-app {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: 14px;
      background: var(--s-light);
      color: var(--s-body);
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    /* ── Top header bar ──────────────────────────────────────────────────── */
    .pfas-header {
      flex: 0 0 var(--pfas-header-h);
      height: var(--pfas-header-h);
      background: var(--s-dark);
      color: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 16px 0 0;
      z-index: 50;
    }
    .pfas-header-toggle {
      flex: 0 0 var(--pfas-rail-width);
      height: var(--pfas-header-h);
      background: none;
      border: none;
      border-right: 1px solid var(--pfas-rail-border);
      color: rgba(255,255,255,.65);
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color .12s, background .12s;
    }
    .pfas-header-toggle:hover { color: #fff; background: rgba(255,255,255,.06); }
    .pfas-header-title {
      flex: 1;
      font-size: 17px;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .pfas-header-right {
      display: flex;
      align-items: center;
      gap: 2px;
      flex-shrink: 0;
    }
    .pfas-header-right a {
      color: rgba(255,255,255,.65);
      font-size: 12px;
      text-decoration: none;
      white-space: nowrap;
    }
    .pfas-header-right a:hover { color: #fff; text-decoration: underline; }
    .pfas-header-right .back-link::before { content: "\2190  "; }

    /* Context badge */
    .header-badge {
      font-family: monospace;
      font-size: 12px;
      background: rgba(255,255,255,.15);
      padding: 3px 9px;
      border-radius: 4px;
    }
    .header-meta { font-size: 12px; color: rgba(255,255,255,.70); }
    .header-meta code {
      background: rgba(255,255,255,.12);
      padding: 1px 5px;
      border-radius: 3px;
      font-size: 11px;
    }

    /* ── Shell: left panel + main ────────────────────────────────────────── */
    .pfas-shell {
      flex: 1;
      display: flex;
      overflow: hidden;
      min-height: 0;
    }

    /* ── Left panel (now the unified #sidebar from @@pfas-sidebar) ─────── */
    /* Sizing + collapse is handled by pfas_sidebar.pt's inline CSS.
       We only need to make #sidebar behave as a flex child of .pfas-shell. */
    .pfas-shell > #sidebar {
      flex-shrink: 0;
    }

    /* ── Main area ───────────────────────────────────────────────────────── */
    .pfas-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      min-height: 0;
    }

    /* ── Top tabs strip ──────────────────────────────────────────────────── */
    .pfas-tabs-wrap {
      flex: 0 0 auto;
    }
    .pfas-tabs {
      background: var(--s-bg);
      border-bottom: 2px solid var(--s-border);
      padding: 0 20px;
      display: flex;
      gap: 0;
      overflow-x: auto;
    }
    .pfas-tab {
      display: inline-block;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 600;
      color: var(--s-secondary);
      text-decoration: none;
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      white-space: nowrap;
      cursor: pointer;
      transition: color .1s;
    }
    .pfas-tab:hover { color: var(--s-body); text-decoration: none; }
    .pfas-tab.active { color: var(--s-primary); border-bottom-color: var(--s-primary); }

    /* ── Stable content area (scrollable) ────────────────────────────────── */
    .pfas-content-area {
      flex: 1;
      overflow-y: auto;
      overflow-x: auto;
      background: var(--s-light);
      min-height: 0;
    }

    /* ── Pane footer — storage path + role note ─────────────────────────── */
    .pane-footer {
      margin-top: 28px;
      padding: 10px 16px;
      border-top: 1px solid var(--s-border);
      background: var(--s-bg);
      border-radius: 0 0 6px 6px;
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
      font-size: 11px;
      color: var(--s-secondary);
    }
    .pane-footer .pf-role {
      background: var(--s-primary-lt);
      color: var(--s-primary);
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 10px;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .pane-footer .pf-path { font-family: monospace; font-size: 11px; }

    /* ── Role badge in header-right ─────────────────────────────────────── */
    .role-badge {
      font-size: 11px;
      font-weight: 700;
      background: rgba(255,255,255,.15);
      color: rgba(255,255,255,.90);
      padding: 2px 9px;
      border-radius: 10px;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    /* ── Pinned action bar ────────────────────────────────────────────────── */
    .pfas-action-bar-wrap { flex: 0 0 auto; }
    .pfas-action-bar {
      background: var(--s-bg);
      border-top: 2px solid var(--s-primary);
      padding: 12px 20px;
      display: flex;
      gap: 12px;
      align-items: center;
      box-shadow: 0 -2px 8px rgba(0,0,0,.08);
    }

    /* ── Flash messages ──────────────────────────────────────────────────── */
    .alert { padding: 10px 16px; border-radius: 4px; margin-bottom: 16px; font-weight: 600; }
    .alert-success { background: #d4edda; border: 1px solid #c3e6cb; color: #155724; }
    .alert-error   { background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; }
    .alert-info    { background: var(--s-primary-lt); border: 1px solid #bee5eb; color: #0c5460; }

    /* ── Content containers ──────────────────────────────────────────────── */
    .page-body        { max-width: 1100px; margin: 0 auto; padding: 20px; }
    .page-body-narrow { max-width: 900px;  margin: 0 auto; padding: 20px; }

    /* ── Cards ───────────────────────────────────────────────────────────── */
    details, .pfas-card {
      background: var(--s-bg);
      border-radius: 6px;
      margin-bottom: 14px;
      border: 1px solid var(--s-border);
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }
    details[open], .pfas-card { box-shadow: 0 2px 6px rgba(0,0,0,.10); }
    summary, .pfas-card-head {
      padding: 11px 16px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
      background: var(--s-light);
      border-radius: 6px;
      color: var(--s-body);
      list-style: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    details[open] summary { border-radius: 6px 6px 0 0; border-bottom: 1px solid var(--s-border); }
    .pfas-card-head { border-radius: 6px 6px 0 0; border-bottom: 1px solid var(--s-border); cursor: default; }
    summary::-webkit-details-marker { display: none; }
    summary::before { content: "\25B6"; font-size: 10px; transition: transform .15s; color: var(--s-secondary); }
    details[open] summary::before { transform: rotate(90deg); }
    .section-body, .pfas-card-body { padding: 16px; }

    /* ── Field layout ────────────────────────────────────────────────────── */
    .field-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 14px;
    }
    .field-row { display: flex; flex-direction: column; }
    .field-row label {
      font-size: 11px;
      color: var(--s-secondary);
      margin-bottom: 4px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .field-row input[type=number],
    .field-row input[type=text],
    .field-row input[type=date],
    .field-row select,
    .field-row textarea {
      padding: 7px 9px;
      border: 1px solid var(--s-input-border);
      border-radius: 4px;
      font-size: 13px;
      background: #fafafa;
      color: var(--s-input-text);
      width: 100%;
    }
    .field-row input:focus, .field-row select:focus, .field-row textarea:focus {
      outline: none;
      border-color: var(--s-primary);
      box-shadow: 0 0 0 3px var(--s-focus-ring);
    }
    .field-row .hint { font-size: 10px; color: var(--s-secondary); margin-top: 3px; }
    .field-row-wide { grid-column: 1 / -1; }

    /* ── Checkboxes ──────────────────────────────────────────────────────── */
    .check-row { display: flex; align-items: center; gap: 8px; padding: 6px 0; }
    .check-row label {
      font-size: 13px; color: var(--s-body); font-weight: normal;
      text-transform: none; letter-spacing: normal;
    }
    .check-row input[type=checkbox] { width: 16px; height: 16px; cursor: pointer; }

    /* ── Toggle switch ───────────────────────────────────────────────────── */
    .toggle-switch { position: relative; display: inline-block; width: 36px; height: 20px; cursor: pointer; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; position: absolute; }
    .toggle-track {
      position: absolute; top: 0; left: 0; right: 0; bottom: 0;
      background: var(--s-input-border); border-radius: 20px; transition: background .15s;
    }
    .toggle-track::before {
      content: ""; position: absolute; width: 14px; height: 14px;
      left: 3px; bottom: 3px; background: #fff; border-radius: 50%;
      transition: transform .15s; box-shadow: 0 1px 3px rgba(0,0,0,.25);
    }
    .toggle-switch input:checked + .toggle-track { background: var(--s-primary); }
    .toggle-switch input:checked + .toggle-track::before { transform: translateX(16px); }

    /* ── Tables ──────────────────────────────────────────────────────────── */
    .pfas-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .pfas-table th {
      background: var(--s-light);
      color: var(--s-secondary);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .04em;
      padding: 8px 12px;
      border-bottom: 2px solid var(--s-border);
      text-align: left;
    }
    .pfas-table td { padding: 8px 12px; border-bottom: 1px solid var(--s-border); vertical-align: middle; }
    .pfas-table tr:last-child td { border-bottom: none; }
    .pfas-table tbody tr:hover td { background: var(--s-primary-lt); }
    .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }

    /* ── Workspace landing grid ──────────────────────────────────────────── */
    .pfas-ws-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 16px;
      padding: 24px;
    }
    .pfas-ws-card {
      background: var(--s-bg);
      border: 1px solid var(--s-border);
      border-radius: 8px;
      padding: 20px 18px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      text-decoration: none;
      color: var(--s-body);
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
      transition: box-shadow .15s, border-color .15s;
    }
    .pfas-ws-card:hover {
      box-shadow: 0 4px 12px rgba(0,0,0,.12);
      border-color: var(--s-primary);
      text-decoration: none;
      color: var(--s-body);
    }
    .pfas-ws-card-icon { font-size: 22px; color: var(--s-primary); line-height: 1; }
    .pfas-ws-card-title { font-size: 15px; font-weight: 600; }
    .pfas-ws-card-desc  { font-size: 12px; color: var(--s-secondary); line-height: 1.4; }

    /* ── Buttons ─────────────────────────────────────────────────────────── */
    .btn {
      display: inline-block; padding: 8px 20px; border-radius: 4px;
      font-size: 13px; font-weight: 600; cursor: pointer;
      border: none; text-decoration: none;
    }
    .btn-primary { background: var(--s-primary); color: #fff; }
    .btn-primary:hover { background: var(--s-primary-dk); text-decoration: none; color: #fff; }
    .btn-secondary {
      background: transparent; color: var(--s-secondary);
      border: 1px solid var(--s-border);
    }
    .btn-secondary:hover { background: var(--s-light); text-decoration: none; }
    .btn-danger  { background: var(--s-danger); color: #fff; }
    .btn-danger:hover { opacity: .85; }
    .btn-link {
      background: none; border: none; color: var(--s-primary);
      padding: 0; cursor: pointer; font-size: 13px; text-decoration: underline;
    }

    /* ── Legacy save-bar (inside content slot — stays sticky in scroll area) */
    .save-bar {
      position: sticky;
      bottom: 0;
      background: var(--s-bg);
      border-top: 2px solid var(--s-primary);
      padding: 12px 20px;
      display: flex;
      gap: 12px;
      align-items: center;
      box-shadow: 0 -2px 8px rgba(0,0,0,.08);
    }

    /* ── Generic status badges ──────────────────────────────────────────── */
    .badge {
      display: inline-block; font-size: 10px; font-weight: 700;
      padding: 2px 8px; border-radius: 10px; white-space: nowrap;
      text-transform: uppercase; letter-spacing: .03em;
    }
    .badge-active     { background: #d4edda; color: #155724; }
    .badge-draft      { background: #e2e3e5; color: #495057; }
    .badge-archived   { background: #e2e3e5; color: #495057; }
    .badge-exhausted  { background: #e2e3e5; color: #495057; }
    .badge-expired    { background: #f8d7da; color: #721c24; }
    .badge-opened     { background: #cce5ff; color: #004085; }
    .badge-quarantine { background: #fff3cd; color: #856404; }

    /* ── Mono badges ─────────────────────────────────────────────────────── */
    .mono-badge {
      font-family: monospace; font-size: 12px; color: var(--s-primary);
      background: var(--s-primary-lt); padding: 2px 7px; border-radius: 3px;
    }
    .status-badge {
      font-size: 11px; padding: 2px 8px; border-radius: 10px;
      font-weight: 700; text-transform: uppercase; letter-spacing: .03em;
    }
    .status-ok   { background: #d4edda; color: #155724; }
    .status-warn { background: #fff3cd; color: #856404; }
    .status-fail { background: #f8d7da; color: #721c24; }

    /* ── Logbook breadcrumb ──────────────────────────────────────────────── */
    .lb-breadcrumb {
      display: flex; align-items: center; gap: 6px;
      font-size: 11px; color: var(--s-secondary);
      padding: 8px 0 16px 0;
    }
    .lb-breadcrumb a { color: var(--s-secondary); text-decoration: none; }
    .lb-breadcrumb a:hover { color: var(--s-primary); text-decoration: underline; }
    .lb-breadcrumb .lb-bc-sep { opacity: .5; }
    .lb-breadcrumb strong { color: var(--s-body); }

    /* ── Print preview button ────────────────────────────────────────────── */
    .btn-print-preview {
      padding: 9px 18px; background: #f8f9fa; color: var(--s-secondary);
      border: 1px solid var(--s-border); border-radius: 7px;
      font-size: 13px; font-weight: 600; cursor: pointer;
    }
    .btn-print-preview:hover { background: #e9ecef; }

    /* ── Mobile (≤768px) ─────────────────────────────────────────────────── */
    @media (max-width: 768px) {
      /* Header: compact — hide plain back-links, keep role badge + context nav */
      .pfas-header { padding: 0 8px 0 0; min-height: 44px; }
      .pfas-header-title { font-size: 13px; }
      .pfas-header-right { gap: 6px; }
      .pfas-header-right .back-link { display: none; }
      .pfas-header-right .header-meta { display: none; }

      /* Sidebar floats as an overlay on mobile */
      .pfas-shell > #sidebar.pfas-sidebar {
        position: absolute;
        top: 0; left: 0; bottom: 0;
        z-index: 100;
        transform: translateX(-100%);
        transition: transform .2s ease;
        box-shadow: none;
        min-width: var(--pfas-panel-width) !important;
        max-width: var(--pfas-panel-width) !important;
      }
      .pfas-shell.panel-open > #sidebar.pfas-sidebar {
        transform: translateX(0);
        box-shadow: 4px 0 16px rgba(0,0,0,.20);
      }
      .pfas-panel-backdrop {
        display: none;
        position: absolute; inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 99;
      }
      .pfas-shell.panel-open .pfas-panel-backdrop { display: block; }
      .pfas-shell { position: relative; }

      /* Content: let it scroll horizontally rather than clip */
      .pfas-content-area { overflow-x: auto; }

      /* Tables: contained scroll. Any table inside .table-wrap scrolls
         sideways as a unit (cells nowrap) so the page chrome never drags.
         Opt a cell out of nowrap with class="col-wrap". */
      .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
      .table-wrap table { display: table; }
      .table-wrap table td,
      .table-wrap table th { white-space: nowrap; }
      .table-wrap table td.col-wrap,
      .table-wrap table th.col-wrap { white-space: normal; max-width: 180px; }
      .pfas-table { min-width: 480px; }

      /* ── EVERY PFAS content table scrolls sideways as its own box on mobile
         (defined once here; every bespoke table — CAS map, EDD-profile editors,
         QC matrix, calibrations, logbooks, factor/spec/units tables — inherits
         it with no per-page markup). Same max-content technique core uses for
         table.contentstable: the table becomes its own horizontal scroll
         container while thead/tbody stay real table rows so columns align, so
         a wide table never drags the page chrome or overflows the viewport.
         Opt a whole table out with class="no-mobile-scroll"; let one cell wrap
         instead of nowrap with class="col-wrap". */
      .pfas-content-area table:not(.no-mobile-scroll) {
        display: block;
        width: 100%; max-width: 100%; min-width: 0;
        overflow-x: auto; -webkit-overflow-scrolling: touch;
      }
      .pfas-content-area table:not(.no-mobile-scroll) > thead,
      .pfas-content-area table:not(.no-mobile-scroll) > tbody,
      .pfas-content-area table:not(.no-mobile-scroll) > tfoot {
        display: table; width: max-content; min-width: 100%;
      }
      .pfas-content-area table:not(.no-mobile-scroll) td.col-wrap,
      .pfas-content-area table:not(.no-mobile-scroll) th.col-wrap {
        white-space: normal; max-width: 180px;
      }
      .hide-mobile { display: none !important; }

      /* Field grids → single column */
      .field-grid { grid-template-columns: 1fr !important; }

      /* Reduce body padding */
      .page-body, .page-body-narrow { padding: 10px 10px; }
      .page-body { max-width: 100% !important; }

      /* Tabs: scrollable, compact */
      .pfas-tabs { padding: 0 6px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
      .pfas-tab { padding: 8px 10px; font-size: 12px; }

      /* Pane footer: stack vertically */
      .pane-footer { flex-direction: column; align-items: flex-start; gap: 6px; }

      /* Stat bars: 2-up grid */
      .stat-bar { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    }

    /* ── Shared print header/footer (see Configuration → Print Settings) ── */
    .pfas-printhead, .pfas-printfoot { display: none; }

    /* ── Shared QA sign-off attestation (screen + print) ─────────────────── */
    .pfas-signoff { margin: 22px 0 6px; border: 1px solid var(--s-border, #ccc);
      border-radius: 6px; padding: 12px 14px; background: #fcfcfd;
      page-break-inside: avoid; }
    .pfas-signoff-title { font-size: 12px; font-weight: 700; letter-spacing: .04em;
      text-transform: uppercase; color: #444; margin-bottom: 8px; }
    .pfas-signoff-tbl { width: 100%; border-collapse: collapse; font-size: 12px; }
    .pfas-signoff-tbl td { padding: 10px 8px; vertical-align: bottom;
      border-top: 1px solid #eee; }
    .pfas-signoff-tbl .so-role { width: 96px; font-weight: 600; color: #555;
      white-space: nowrap; }
    .pfas-signoff-tbl .so-title { color: #666; }
    .pfas-signoff-tbl .so-sig { width: 150px; text-align: center; }
    .pfas-signoff-tbl .so-date { width: 130px; white-space: nowrap; color: #555; }
    .pfas-signoff .so-stamp { max-height: 40px; max-width: 140px; }
    .pfas-signoff .so-line { display: inline-block; min-width: 90px;
      border-bottom: 1px solid #888; }
    .pfas-signoff-foot { margin-top: 8px; font-size: 11px; color: #92400e;
      background: #fff8e1; border-left: 3px solid #f59e0b; padding: 5px 8px;
      border-radius: 3px; }

    /* ── Print ───────────────────────────────────────────────────────────── */
    @media print {
      .pfas-signoff { border-color: #000; background: transparent; }
      .pfas-signoff-foot { display: none !important; }
      .pfas-printhead { display: block !important;
        border-bottom: 2px solid #000; margin: 0 0 12px; padding-bottom: 8px; }
      .pfas-ph-row  { display: flex; gap: 14px; align-items: center; }
      .pfas-ph-logo { max-height: 46px; }
      .pfas-ph-name { font-size: 16px; font-weight: 700; color: #000; }
      .pfas-ph-sub  { font-size: 10px; color: #333; }
      .pfas-ph-date { margin-left: auto; font-size: 10px; color: #333; }
      .pfas-printfoot { display: block !important; position: fixed;
        bottom: 0; left: 0; right: 0; font-size: 9px; color: #444;
        border-top: 1px solid #999; padding-top: 3px; text-align: center; }
      .pfas-header { display: none !important; }
      #sidebar.pfas-sidebar { display: none !important; }
      .pfas-tabs-wrap { display: none !important; }
      .pfas-action-bar-wrap { display: none !important; }
      .lb-breadcrumb { display: none !important; }
      .btn-save, .btn-dl, .btn-print-preview, .btn-add-row,
      .btn-del-row, .form-actions, #add-sample-btn { display: none !important; }
      .pfas-content-area { overflow: visible !important; }
      input[type="text"], input[type="number"], input[type="date"],
      select, textarea {
        border: none !important; background: transparent !important;
        box-shadow: none !important; padding: 2px 0 !important;
      }
      table { page-break-inside: auto; }
      tr { page-break-inside: avoid; }
      .lb-section h3 { border-bottom: 1px solid #999 !important; }
      body { font-size: 11px; overflow: visible !important; height: auto !important; }
    }

    /* ── GLP field correction model (logbooks) ── */
    .btn-correct { background: none; border: none; color: #bbb; font-size: 10px;
                   cursor: pointer; padding: 0 3px; text-decoration: underline;
                   font-weight: normal; margin-left: 5px; vertical-align: middle; }
    .btn-correct:hover { color: var(--s-dark); }
    .corr-existing { display: flex; align-items: baseline; gap: 6px;
                     flex-wrap: wrap; font-size: 12px; margin-bottom: 3px; }
    .corr-struck { text-decoration: line-through; color: #999; }
    .corr-arrow { color: #999; font-size: 11px; }
    .corr-meta { font-size: 10px; color: #856404; background: #fff8e1;
                 border: 1px solid #ffe082; border-radius: 3px;
                 padding: 1px 5px; white-space: nowrap; }
    .corr-panel { display: none; margin-top: 5px; padding: 7px 10px;
                  background: #fff8e1; border: 1px solid #ffc107;
                  border-radius: 6px; gap: 8px; align-items: center; flex-wrap: wrap; }
    .corr-panel.open { display: flex; }
    .corr-panel label { font-size: 11px; color: #856404; font-weight: 600;
                        white-space: nowrap; margin: 0; }
    .corr-panel input { padding: 4px 8px; font-size: 12px;
                        border: 1px solid #ffc107; border-radius: 4px; background: #fff; }
    .corr-initials { width: 52px !important; }
    .corr-cancel { background: none; border: none; cursor: pointer;
                   color: #856404; font-size: 15px; line-height: 1; padding: 0 3px; }
    @media print {
      .btn-correct, .corr-panel { display: none !important; }
      .has-correction > input, .has-correction > textarea,
      .has-correction > select { display: none !important; }
    }

    /* ── Persistent header toolbar actions ───────────────────────────── */
    .pfas-hdr-btn {
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0; padding: 0 6px;
      color: rgba(255,255,255,.65); border-radius: 4px;
      text-decoration: none; transition: color .12s, background .12s;
    }
    .pfas-hdr-btn i.fas { font-size: 19px; }
    .pfas-hdr-btn:hover {
      color: #fff; background: rgba(255,255,255,.1); text-decoration: none;
    }
    .pfas-hdr-userbtn i.fas { font-size: 19px; }
    .pfas-hdr-user { position: static; flex-shrink: 0; }
    .pfas-hdr-userbtn {
      display: flex; align-items: center; gap: 2px;
      background: none; border: none; padding: 4px 6px; border-radius: 4px;
      color: rgba(255,255,255,.75); cursor: pointer; font-size: 15px;
      font-family: inherit; transition: color .12s, background .12s;
    }
    .pfas-hdr-userbtn:hover { color: #fff; background: rgba(255,255,255,.1); }
    /* Bootstrap-identical caret for dropdown buttons */
    .pfas-hdr-userbtn::after {
      display: inline-block; margin-left: 2px; vertical-align: .255em;
      content: ""; border-top: .3em solid; border-right: .3em solid transparent;
      border-bottom: 0; border-left: .3em solid transparent;
    }
    /* Dropdown: position:fixed computed by JS so no ancestor overflow can clip it.
       Matches Bootstrap 4 dropdown-menu style used by SENAITE core. */
    .pfas-hdr-userdrop {
      display: none; position: fixed;
      background: #fff; border: 1px solid rgba(0,0,0,.15);
      border-radius: 0.25rem; min-width: 180px;
      box-shadow: 0 0.5rem 1rem rgba(0,0,0,.175);
      z-index: 9000; overflow: hidden; padding: 0.5rem 0;
    }
    .pfas-hdr-userdrop.open { display: block; }
    /* Higher specificity (drop + a) beats .pfas-header-right a which sets white text */
    .pfas-hdr-userdrop a.pfas-hdr-useritem {
      display: flex; align-items: center; gap: 8px;
      padding: 0.35rem 1.25rem; color: #212529;
      text-decoration: none; font-size: 14px; white-space: nowrap;
      transition: background .1s;
    }
    .pfas-hdr-userdrop a.pfas-hdr-useritem:hover {
      background: #f8f9fa; color: #1a1e21; text-decoration: none;
    }
    .pfas-hdr-userdrop a.pfas-hdr-useritem i.fas { color: #6c757d; font-size: 13px; width: 14px; }
    .pfas-hdr-userdrop a.pfas-hdr-logout { color: #dc3545; }
    .pfas-hdr-userdrop a.pfas-hdr-logout:hover { background: #f8d7da; color: #a71d2a; }
    .pfas-hdr-userdrop a.pfas-hdr-logout i.fas { color: #dc3545; }
    .pfas-hdr-langactive { font-weight: 600; }
    .pfas-hdr-user-sep { height: 0; border-top: 1px solid rgba(0,0,0,.15); margin: 0.5rem 0; }
    @media (max-width: 768px) { .pfas-hdr-userbtn span { display: none; } }
  </style>
  <tal:head-extra metal:define-slot="head-extra" />
</head>
<body class="pfas-app">
  <!-- ── Shared print header/footer — settings at Configuration → Print
       Settings (@@pfas-print-settings). Hidden on screen; renders on EVERY
       print so a standard form and a CoC produce consistent audit copies.
       Standalone templates (receipt.pt) reuse via macros/printhead. ──── -->
  <div class="pfas-printhead" metal:define-macro="printhead"
       tal:define="ps python:context.restrictedTraverse('@@pfas-macros').print_settings()">
    <div class="pfas-ph-row">
      <img class="pfas-ph-logo" tal:condition="ps/logo_url"
           tal:attributes="src ps/logo_url; alt ps/lab_name"/>
      <div class="pfas-ph-id">
        <div class="pfas-ph-name" tal:content="ps/lab_name">Lab name</div>
        <div class="pfas-ph-sub">
          <tal:a tal:condition="ps/lab_address" tal:replace="ps/lab_address"/><tal:p
            tal:condition="ps/lab_phone"> · <tal:x tal:replace="ps/lab_phone"/></tal:p><tal:e
            tal:condition="ps/lab_email"> · <tal:x tal:replace="ps/lab_email"/></tal:e>
        </div>
        <div class="pfas-ph-sub" tal:condition="ps/accreditation"
             tal:content="ps/accreditation">accreditation</div>
      </div>
      <div class="pfas-ph-date" tal:condition="ps/show_print_date">
        Printed: <tal:d tal:replace="ps/print_date">date</tal:d>
      </div>
    </div>
  </div>
  <div class="pfas-printfoot"
       tal:define="ps python:context.restrictedTraverse('@@pfas-macros').print_settings()"
       tal:condition="ps/show_page_footer"
       tal:content="ps/footer_text">footer</div>

  <!-- ── Shared QA sign-off attestation ────────────────────────────────────
       Rendered 3-tier attestation (Analyst prepared → QAO verified → Lab
       Director authorized) with signature stamps, for controlled printable
       records (SOP, prep logs FM-ENV-25x, prepared standards). Define-once
       (§6C/§7). QAO + Director come from Print Settings; the preparer + date
       are passed by the calling template. A missing stamp prints a ruled line
       for wet signature. Caller sets: signoff_noun, signoff_prepared_name,
       signoff_prepared_date, signoff_prepared_initials (any may be omitted).
         <tal:s metal:use-macro="context/@@pfas-macros/macros/signoff"
                tal:define="signoff_noun string:reagent;
                            signoff_prepared_name python:view.data().get('prepared_by','');
                            signoff_prepared_date python:view.data().get('prepared_date','');
                            signoff_prepared_initials python:view.data().get('prepared_by','')" />
       ──────────────────────────────────────────────────────────────────── -->
  <div class="pfas-signoff" metal:define-macro="signoff"
       tal:define="nn signoff_noun|nothing;
                   ps python:context.restrictedTraverse('@@pfas-macros').print_settings();
                   render python:bool(nn) and ps.get('show_signoff', True);
                   signers python:context.restrictedTraverse('@@pfas-macros').signoff_signers();
                   noun python:nn or 'document';
                   prep_name signoff_prepared_name|string:;
                   prep_date signoff_prepared_date|string:;
                   prep_ini signoff_prepared_initials|string:;
                   prep_sig python:context.restrictedTraverse('@@pfas-macros').signature_for_initials(prep_ini);
                   qao signers/qao;
                   director signers/director"
       tal:condition="render">
    <div class="pfas-signoff-title">Quality Assurance Documentation</div>
    <table class="pfas-signoff-tbl no-mobile-scroll">
      <tbody>
      <tr>
        <td class="so-role">Prepared&nbsp;by</td>
        <td class="so-who">
          This <tal:n tal:replace="noun">document</tal:n> was prepared by
          <strong tal:content="python:prep_name or (prep_sig and prep_sig['fullname']) or '—'">analyst</strong>.
        </td>
        <td class="so-sig">
          <img class="so-stamp" tal:condition="prep_sig/signature_url|nothing"
               tal:attributes="src prep_sig/signature_url; alt prep_sig/fullname"/>
          <span class="so-line" tal:condition="not:prep_sig/signature_url|python:True">&nbsp;</span>
        </td>
        <td class="so-date">Date:
          <tal:d tal:condition="prep_date" tal:replace="prep_date"/>
          <span class="so-line" tal:condition="not:prep_date">&nbsp;</span>
        </td>
      </tr>
      <tr>
        <td class="so-role">Verified&nbsp;by</td>
        <td class="so-who">
          Reviewed and verified by
          <strong tal:content="python:(qao and qao['fullname']) or '—'">QAO</strong>,
          <span class="so-title">Quality Assurance Officer</span>.
        </td>
        <td class="so-sig">
          <img class="so-stamp" tal:condition="qao/signature_url|nothing"
               tal:attributes="src qao/signature_url; alt qao/fullname"/>
          <span class="so-line" tal:condition="not:qao/signature_url|python:True">&nbsp;</span>
        </td>
        <td class="so-date">Date: <span class="so-line">&nbsp;</span></td>
      </tr>
      <tr>
        <td class="so-role">Authorized&nbsp;by</td>
        <td class="so-who">
          Authorized by
          <strong tal:content="python:(director and director['fullname']) or '—'">Director</strong>,
          <span class="so-title">Laboratory Director</span>.
        </td>
        <td class="so-sig">
          <img class="so-stamp" tal:condition="director/signature_url|nothing"
               tal:attributes="src director/signature_url; alt director/fullname"/>
          <span class="so-line" tal:condition="not:director/signature_url|python:True">&nbsp;</span>
        </td>
        <td class="so-date">Date: <span class="so-line">&nbsp;</span></td>
      </tr>
      </tbody>
    </table>
    <div class="pfas-signoff-foot" tal:condition="python:(qao and qao['placeholder']) or (director and director['placeholder']) or not qao or not director">
      &#9888; Set the Quality Assurance Officer and Laboratory Director (with
      uploaded signature images) at Configuration &#8594; Print Settings.
    </div>
  </div>

<!-- ── Top header bar ──────────────────────────────────────────────────────── -->
<header class="pfas-header">
  <button class="pfas-header-toggle" id="pfas-header-toggle"
          onclick="pfasTogglePanel()" type="button" aria-label="Toggle navigation">
    &#9776;
  </button>
  <div class="pfas-header-title">
    <tal:t metal:define-slot="header-title">LIMS Tool</tal:t>
  </div>
  <div class="pfas-header-right">
    <tal:r metal:define-slot="header-right" />

    <!-- ── Persistent toolbar actions (always present on PFAS pages) ── -->
    <tal:acts tal:define="
        macros_view python:context.restrictedTraverse('@@pfas-macros');
        purl        python:context.portal_url();
        is_anon     python:context.portal_membership.isAnonymousUser();
        uname       python:'' if is_anon else (context.portal_membership.getAuthenticatedMember().getId() or '');
        roles       python:[] if is_anon else list(context.portal_membership.getAuthenticatedMember().getRolesInContext(context));
        is_mgr      python:'LabManager' in roles or 'Manager' in roles">

      <!-- Global sections (apps grid) — same icon as core: fas fa-th -->
      <div class="pfas-hdr-user" id="pfas-hdr-apps" tal:condition="uname">
        <button class="pfas-hdr-userbtn" type="button"
                onclick="pfasAppsMenuToggle(event)" title="Global sections">
          <i class="fas fa-th"></i>
        </button>
        <div class="pfas-hdr-userdrop" id="pfas-appsdrop"
             tal:content="structure python:macros_view.render_section_items()">
        </div>
      </div>

      <!-- Language selector (globe) — hidden when only 1 language configured -->
      <div class="pfas-hdr-user" id="pfas-hdr-lang"
           tal:condition="python:uname and macros_view.render_lang_available()">
        <button class="pfas-hdr-userbtn" type="button"
                onclick="pfasLangMenuToggle(event)" title="Language">
          <i class="fas fa-globe"></i>
        </button>
        <div class="pfas-hdr-userdrop" id="pfas-langdrop"
             tal:content="structure python:macros_view.render_language_items()">
        </div>
      </div>

      <!-- Spotlight search — same icon as core: fas fa-search -->
      <a class="pfas-hdr-btn" title="Search (Ctrl+Space)"
         tal:condition="uname"
         tal:attributes="href string:${purl}/@@spotlight">
        <i class="fas fa-search"></i>
      </a>

      <!-- LIMS Setup cog — same icon as core: fas fa-cog -->
      <a class="pfas-hdr-btn" title="LIMS Setup"
         tal:condition="is_mgr"
         tal:attributes="href string:${purl}/@@lims-setup">
        <i class="fas fa-cog"></i>
      </a>

      <!-- User/personal bar — same pattern as core: name + dropdown -->
      <div class="pfas-hdr-user" id="pfas-hdr-user" tal:condition="uname">
        <button class="pfas-hdr-userbtn" type="button"
                onclick="pfasUserMenuToggle(event)">
          <span tal:content="uname">User</span>
        </button>
        <div class="pfas-hdr-userdrop" id="pfas-userdrop">
          <a class="pfas-hdr-useritem"
             tal:attributes="href string:${purl}/@@personal-information">
            <i class="fas fa-user-cog"></i> My Profile
          </a>
          <div class="pfas-hdr-user-sep"></div>
          <a class="pfas-hdr-useritem pfas-hdr-logout"
             tal:attributes="href string:${purl}/logout">
            <i class="fas fa-sign-out-alt"></i> Sign Out
          </a>
        </div>
      </div>

    </tal:acts>
  </div>
</header>

<!-- ── Shell ───────────────────────────────────────────────────────────────── -->
<div class="pfas-shell" id="pfas-shell">

  <!-- Mobile backdrop -->
  <div class="pfas-panel-backdrop" id="pfas-panel-backdrop"
       onclick="pfasClosePanel()"></div>

  <!-- Unified sidebar — suppressed for anonymous users (Client Tracker / public pages).
       Authenticated staff always see the full sidebar regardless of page. -->
  <tal:sb tal:define="is_anon python:context.portal_membership.isAnonymousUser()"
          tal:condition="python:not is_anon"
          tal:replace="structure context/@@pfas-macros/render_sidebar" />

  <!-- Main: tabs + content + action bar -->
  <div class="pfas-main">

    <!-- Top tabs -->
    <div class="pfas-tabs-wrap">
      <tal:tabs metal:define-slot="tabs">
        <!-- Default: no tabs; the wrap is present but takes no visual space -->
      </tal:tabs>
    </div>

    <!-- Stable content area -->
    <div class="pfas-content-area" id="pfas-content-area">
      <tal:body metal:define-slot="content">
        <div class="page-body">
          <p>No content.</p>
        </div>
      </tal:body>
    </div>

    <!-- Pinned action bar (outside scroll area — always visible) -->
    <div class="pfas-action-bar-wrap">
      <tal:ab metal:define-slot="action-bar">
        <!-- Default: empty; forms fill this slot with a .pfas-action-bar div -->
      </tal:ab>
    </div>

  </div><!-- /pfas-main -->
</div><!-- /pfas-shell -->

<!-- Backward-compat JS slots (placed before </body> so scripts can reference DOM) -->
<tal:body-extra metal:define-slot="body-extra" />
<tal:scripts metal:define-slot="scripts" />

<script>
(function () {
  var STORAGE_KEY = 'pfas_panel_collapsed';
  var isMobile = function () { return window.innerWidth <= 768; };

  function getShell() { return document.getElementById('pfas-shell'); }

  window.pfasTogglePanel = function () {
    var shell = getShell();
    if (!shell) return;
    if (isMobile()) {
      shell.classList.toggle('panel-open');
    } else {
      var collapsed = shell.classList.toggle('panel-collapsed');
      try { sessionStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0'); } catch (e) {}
    }
  };

  window.pfasClosePanel = function () {
    var shell = getShell();
    if (shell) shell.classList.remove('panel-open');
  };

  /* Restore desktop collapse state */
  (function () {
    if (isMobile()) return;
    try {
      if (sessionStorage.getItem(STORAGE_KEY) === '1') {
        var shell = getShell();
        if (shell) shell.classList.add('panel-collapsed');
      }
    } catch (e) {}
  })();

  /* Close mobile panel on Escape */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      window.pfasClosePanel();
      ['pfas-userdrop', 'pfas-appsdrop', 'pfas-langdrop'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.classList.remove('open');
      });
    }
  });
})();

/* ── Header dropdowns (apps grid, language, user menu) ── */
var _hdrDrops = [
  { btn: 'pfas-hdr-apps', drop: 'pfas-appsdrop' },
  { btn: 'pfas-hdr-lang', drop: 'pfas-langdrop' },
  { btn: 'pfas-hdr-user', drop: 'pfas-userdrop' }
];

function _closeAllHdrDrops(except) {
  _hdrDrops.forEach(function (d) {
    if (d.btn === except) return;
    var el = document.getElementById(d.drop);
    if (el) el.classList.remove('open');
  });
}

/* Position a fixed dropdown below its trigger button, flush with the right
   edge. Uses getBoundingClientRect() so no ancestor overflow can clip it. */
function _positionDrop(drop, trigger) {
  if (!drop || !trigger) return;
  var rect = trigger.getBoundingClientRect();
  drop.style.top  = (rect.bottom + 4) + 'px';
  /* Align right edge of drop with right edge of button; clamp to keep it on screen */
  var rightFromEdge = window.innerWidth - rect.right;
  drop.style.right = Math.max(4, rightFromEdge) + 'px';
  drop.style.left  = 'auto';
}

function _toggleDrop(btnId, dropId, e) {
  if (e) e.stopPropagation();
  _closeAllHdrDrops(btnId);
  var drop    = document.getElementById(dropId);
  var trigger = document.getElementById(btnId);
  if (!drop) return;
  var opening = !drop.classList.contains('open');
  if (opening) {
    /* Position before making visible so size is known */
    drop.classList.add('open');
    _positionDrop(drop, trigger ? trigger.querySelector('button') || trigger : trigger);
  } else {
    drop.classList.remove('open');
  }
}

window.pfasAppsMenuToggle  = function (e) { _toggleDrop('pfas-hdr-apps', 'pfas-appsdrop',  e); };
window.pfasLangMenuToggle  = function (e) { _toggleDrop('pfas-hdr-lang', 'pfas-langdrop',  e); };
window.pfasUserMenuToggle  = function (e) { _toggleDrop('pfas-hdr-user', 'pfas-userdrop',  e); };

/* Close all drops when clicking outside */
document.addEventListener('click', function () { _closeAllHdrDrops(null); });

/* Reposition on scroll/resize in case viewport shifts */
window.addEventListener('resize', function () { _closeAllHdrDrops(null); });
</script>


<script>
/* ── GLP field correction UI (logbooks) ── */
window.initCorrections = function (savedData) {
  var corr = (savedData && savedData._corrections) || {};
  Object.keys(corr).forEach(function (fname) {
    var c = corr[fname];
    var wrap = document.querySelector('.corr-field[data-field="' + fname + '"]');
    if (!wrap) return;
    wrap.classList.add('has-correction');
    var badge = document.createElement('div');
    badge.className = 'corr-existing';
    var curVal = (savedData[fname] != null ? savedData[fname] : '').toString();
    badge.innerHTML =
      '<span class="corr-struck">' + _cEsc(c.original) + '</span>' +
      '<span class="corr-arrow">&#8594;</span>' +
      '<strong>' + _cEsc(curVal) + '</strong>' +
      ' <span class="corr-meta">' + _cEsc(c.corrected_by) +
      ' · ' + _cEsc(c.corrected_at) + '</span>';
    var firstInp = wrap.querySelector('input, textarea, select');
    if (firstInp) wrap.insertBefore(badge, firstInp);
    else wrap.appendChild(badge);
  });
};

window.toggleCorrect = function (fname) {
  var panel = document.getElementById('cp-' + fname);
  if (!panel) return;
  var isOpen = panel.classList.contains('open');
  var mainInp = wrap_inp(fname);
  if (isOpen) {
    panel.classList.remove('open');
    var byInp = document.getElementById('cb-' + fname);
    if (byInp) byInp.value = '';
    var nvInp = document.getElementById('cn-' + fname);
    if (nvInp) nvInp.value = '';
    if (mainInp) mainInp.disabled = false;
  } else {
    panel.classList.add('open');
    var origSpan = document.getElementById('co-' + fname);
    if (origSpan && mainInp) origSpan.textContent = mainInp.value || '(empty)';
    if (mainInp) mainInp.disabled = true;
    var nvInp = document.getElementById('cn-' + fname);
    if (nvInp) { nvInp.value = ''; nvInp.focus(); }
  }
};

function wrap_inp(fname) {
  var w = document.querySelector('.corr-field[data-field="' + fname + '"]');
  return w ? (w.querySelector('input:not([type=hidden]), textarea, select') || null) : null;
}

function _cEsc(s) {
  return (s == null ? '' : String(s))
    .replace(/\x26/g, '&amp;').replace(/\x3c/g, '&lt;').replace(/\x3e/g, '&gt;');
}
</script>
</body>
</html>
