<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title"
         tal:content="string:Edit ${view/display_name}">Edit Method Profile</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
    /* ── Method profile edit page-specific ─────────────────────────────── */
    .page-body { max-width: 900px; }

    /* Textareas for JSON */
    .json-area { width: 100%; min-height: 160px; font-family: "Fira Code", monospace;
                 font-size: 12px; padding: 8px; border: 1px solid var(--s-input-border);
                 border-radius: 4px; background: #fafafa; resize: vertical; }
    .json-area:focus { outline: none; border-color: var(--s-primary);
                       box-shadow: 0 0 0 3px var(--s-focus-ring); }
    .json-hint { font-size: 11px; color: var(--s-secondary); margin-top: 4px;
                 font-family: monospace; line-height: 1.5; }

    /* Factor tables */
    .factor-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 10px; }
    .factor-table th { background: var(--s-light); color: var(--s-secondary);
                       font-size: 11px; font-weight: 700; text-transform: uppercase;
                       letter-spacing: .04em; padding: 7px 10px;
                       border-bottom: 2px solid var(--s-border); text-align: left; }
    .factor-table td { padding: 5px 6px; border-bottom: 1px solid var(--s-border); vertical-align: middle; }
    .factor-table tr:last-child td { border-bottom: none; }
    .factor-table input[type=text],
    .factor-table input[type=number] { padding: 5px 8px; border: 1px solid var(--s-input-border);
                                        border-radius: 4px; font-size: 13px; background: #fafafa;
                                        color: var(--s-input-text); width: 100%; }
    .factor-table input:focus { outline: none; border-color: var(--s-primary);
                                 box-shadow: 0 0 0 2px var(--s-focus-ring); }
    .factor-table .del-btn { background: none; border: none; cursor: pointer; color: var(--s-danger);
                              font-size: 16px; padding: 2px 6px; line-height: 1; }
    .factor-table .del-btn:hover { opacity: .75; }
    .btn-add-row { background: none; border: 1px solid var(--s-primary);
                   color: var(--s-primary); border-radius: 4px;
                   padding: 6px 14px; cursor: pointer; font-size: 12px; font-weight: 600; }
    .btn-add-row:hover { background: var(--s-primary-lt); }

    /* Extraction stage cards */
    .stage-card { border: 1px solid var(--s-border); border-radius: 6px; margin-bottom: 10px;
                  background: #fff; }
    .stage-card.dragging { opacity: .4; }
    .stage-card-hdr { display: flex; align-items: center; gap: 8px; padding: 8px 12px;
                      background: var(--s-light); border-radius: 6px 6px 0 0;
                      border-bottom: 1px solid var(--s-border); }
    .stage-card-hdr .drag-handle { cursor: grab; color: var(--s-secondary); font-size: 16px;
                                    user-select: none; flex-shrink: 0; }
    .stage-card-hdr .stage-card-title { flex: 1; font-size: 13px; font-weight: 600;
                                         color: var(--s-primary); }
    .stage-card-hdr .del-btn { background: none; border: none; cursor: pointer;
                                color: var(--s-danger); font-size: 16px; line-height: 1; padding: 0 4px; }
    .stage-card-body { padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
    .stage-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end; }
    .stage-row label { display: flex; flex-direction: column; gap: 3px;
                       font-size: 11px; font-weight: 600; color: var(--s-secondary); }
    .stage-row label input[type=text],
    .stage-row label input[type=number] { padding: 5px 8px; border: 1px solid var(--s-input-border);
                                           border-radius: 4px; font-size: 13px;
                                           font-family: inherit; background: #fff; }
    .stage-row label input:focus { outline: none; border-color: var(--s-primary); }
    .cb-label { flex-direction: row !important; align-items: center !important; gap: 6px !important;
                font-size: 13px !important; font-weight: 500 !important; color: var(--s-text) !important;
                cursor: pointer; }
    .cb-label input[type=checkbox] { width: 15px; height: 15px; cursor: pointer; }

    /* Analyte × matrix inclusion grid */
    .inclusion-wrap { overflow-x: auto; margin-bottom: 8px; }
    .inclusion-grid { border-collapse: collapse; font-size: 12px; }
    .inclusion-grid th { background: var(--s-light); padding: 5px 10px;
                         border-bottom: 2px solid var(--s-border); text-align: center;
                         font-size: 11px; font-weight: 700; text-transform: uppercase;
                         letter-spacing: .04em; color: var(--s-secondary); white-space: nowrap; }
    .inclusion-grid th.analyte-col { text-align: left; min-width: 130px; padding-left: 6px; }
    .inclusion-grid td { padding: 3px 8px; border-bottom: 1px solid var(--s-border); }
    .inclusion-grid td.analyte-name { font-size: 12px; font-family: "Fira Code", monospace;
                                       color: var(--s-text); white-space: nowrap; }
    .inclusion-grid td.check-cell { text-align: center; min-width: 90px; }
    .inclusion-grid input[type=checkbox] { width: 16px; height: 16px; cursor: pointer; }
    .inclusion-grid tr:last-child td { border-bottom: none; }
    .inclusion-grid tr:hover td { background: var(--s-primary-lt, #f0f4ff); }
    .ami-bulk-btn { background: none; border: 1px solid var(--s-border); border-radius: 3px;
                    cursor: pointer; font-size: 11px; padding: 1px 5px; margin: 0 2px;
                    color: var(--s-secondary); line-height: 1.4; }
    .ami-bulk-btn:hover { border-color: var(--s-primary); color: var(--s-primary); }
    .ami-col-ctrl { display: block; margin-top: 4px; }
    .ami-row-btn { background: none; border: none; cursor: pointer; padding: 0;
                   color: var(--s-text); font-family: "Fira Code", monospace; font-size: 12px;
                   text-align: left; width: 100%; }
    .ami-row-btn:hover { color: var(--s-primary); text-decoration: underline; }
    .ami-excluded { color: var(--s-danger, #c0392b); font-size: 11px; display: block; }

    /* Surrogate IS-lane grid */
    .sur-grid { display: flex; flex-direction: column; gap: 0; }
    .sur-unassigned { border: 1px dashed var(--s-border); border-radius: 6px;
                      padding: 8px 10px; margin-bottom: 10px; background: #fffbf0; }
    .sur-unassigned-label { font-size: 11px; font-weight: 700; text-transform: uppercase;
                             letter-spacing: .04em; color: var(--s-secondary); margin-bottom: 6px; }
    .sur-chip-pool { display: flex; flex-wrap: wrap; gap: 4px; min-height: 26px; }
    .sur-lane { display: flex; align-items: stretch; border-bottom: 1px solid var(--s-border);
                background: #fff; }
    .sur-lane:last-child { border-bottom: none; }
    .sur-lane:nth-child(even) { background: var(--s-light, #f8f9fa); }
    .sur-lane-hdr { flex: 0 0 200px; display: flex; flex-direction: column; justify-content: center;
                    padding: 6px 10px; border-right: 1px solid var(--s-border);
                    background: var(--s-light); }
    .sur-lane-name { font-family: "Fira Code", monospace; font-size: 12px; font-weight: 700;
                     color: var(--s-primary); }
    .sur-lane-label { font-size: 10px; color: var(--s-secondary); margin-bottom: 4px; }
    .sur-chain-sel { font-size: 11px; padding: 2px 4px; border: 1px solid var(--s-input-border);
                     border-radius: 3px; color: var(--s-text); background: #fff;
                     max-width: 140px; margin-top: 2px; }
    .sur-lane-body { flex: 1; padding: 5px 8px; display: flex; flex-wrap: wrap;
                     align-content: center; gap: 4px; min-height: 36px; }
    .sur-lane-body.drag-over { background: var(--s-primary-lt, #e8f0ff);
                                outline: 2px dashed var(--s-primary); outline-offset: -2px; }
    .sur-chip { display: inline-flex; align-items: center; gap: 4px;
                background: var(--s-primary-lt, #e8f0ff); border: 1px solid var(--s-primary);
                border-radius: 12px; padding: 2px 8px; font-size: 11px;
                font-family: "Fira Code", monospace; color: var(--s-primary);
                cursor: grab; user-select: none; white-space: nowrap; }
    .sur-chip:active { cursor: grabbing; opacity: .7; }
    .sur-chip.dragging { opacity: .35; }
    .sur-chip-rm { background: none; border: none; cursor: pointer; padding: 0 0 0 2px;
                   color: var(--s-secondary); font-size: 13px; line-height: 1; }
    .sur-chip-rm:hover { color: var(--s-danger); }
    .sur-unassigned .sur-chip { background: #fff3cd; border-color: #e0a800; color: #7a5800; }

    /* Recovery tier cards */
    .tier-card { border: 1px solid var(--s-border); border-radius: 6px; margin-bottom: 10px; background: #fff; }
    .tier-card-hdr { display: flex; align-items: center; gap: 8px; padding: 7px 12px;
                     background: var(--s-light); border-radius: 6px 6px 0 0;
                     border-bottom: 1px solid var(--s-border); }
    .tier-badge { flex-shrink: 0; background: var(--s-primary); color: #fff; border-radius: 10px;
                  padding: 1px 8px; font-size: 11px; font-weight: 700; white-space: nowrap; }
    .tier-desc { flex: 1; border: 1px solid transparent; border-radius: 4px; padding: 3px 6px;
                 font-size: 13px; font-family: inherit; background: transparent; color: var(--s-text); }
    .tier-desc:focus { outline: none; border-color: var(--s-primary); background: #fff;
                       box-shadow: 0 0 0 2px var(--s-focus-ring); }
    .tier-card-body { padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
    .tier-limits { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 13px; }
    .tier-limits label { display: flex; align-items: center; gap: 5px; font-weight: 600;
                         font-size: 11px; color: var(--s-secondary); }
    .tier-limits input[type=number] { width: 70px; padding: 4px 6px; border: 1px solid var(--s-input-border);
                                       border-radius: 4px; font-size: 13px; background: #fafafa;
                                       color: var(--s-text); }
    .tier-limits input:focus { outline: none; border-color: var(--s-primary); }
    .tier-chipfield { border-top: 1px dashed var(--s-border); padding-top: 7px; }
    .tier-chipfield > label { font-size: 11px; font-weight: 700; text-transform: uppercase;
                               letter-spacing: .04em; color: var(--s-secondary); display: block;
                               margin-bottom: 5px; }
    .tier-chip-row { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
    .tier-chip { display: inline-flex; align-items: center; gap: 3px; border-radius: 10px;
                 padding: 2px 7px; font-size: 11px; font-family: "Fira Code", monospace;
                 background: #e8f5e9; border: 1px solid #81c784; color: #2e7d32;
                 user-select: none; }
    .tier-chip.mat-chip { background: #fff3e0; border-color: #ffb74d; color: #e65100; }
    .tier-chip.nostd-chip { background: #fce4ec; border-color: #ef9a9a; color: #b71c1c; }
    .tier-chip-rm { background: none; border: none; cursor: pointer; padding: 0 0 0 2px;
                    color: inherit; font-size: 13px; line-height: 1; opacity: .7; }
    .tier-chip-rm:hover { opacity: 1; }
    .tier-add-sel { font-size: 11px; padding: 3px 5px; border: 1px dashed var(--s-border);
                    border-radius: 10px; color: var(--s-secondary); background: #fafafa;
                    cursor: pointer; max-width: 200px; }
    .tier-add-sel:focus { outline: none; border-color: var(--s-primary); }

    .btn-save  { background: var(--s-primary); color: #fff; border: none; border-radius: 4px;
                 padding: 10px 28px; cursor: pointer; font-size: 14px; font-weight: 600; }
    .btn-save:hover { background: var(--s-primary-dk); }
    .btn-cancel { color: var(--s-secondary); text-decoration: none; font-size: 14px; padding: 10px 0; }
  </style>
  </tal:styles>
</head>
<body>
  <tal:t metal:fill-slot="header-title"
         tal:content="string:Edit — ${view/display_name}">Edit Method Profile</tal:t>
  <tal:r metal:fill-slot="header-right">
    <span class="header-badge" tal:content="view/method_id">FDA_32PFAS</span>
    <a href="@@pfas-method-profiles" class="back-link">All Methods</a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <div class="alert alert-success" tal:condition="view/saved">
      Profile saved and exported to <code>/data/qc/method_profiles.json</code>.
      The pipeline worker will use the new values on the next batch run.
    </div>

    <div class="alert alert-error" tal:condition="view/error">
      <span tal:content="view/error">Error message</span>
    </div>

    <form method="POST" tal:attributes="action string:@@pfas-method-profile-edit">
      <input type="hidden" name="method_id" tal:attributes="value view/method_id" />

      <!-- Method Information -->
      <details open="open">
        <summary>Method Information</summary>
        <div class="section-body">
          <div class="field-grid">
            <div class="field-row field-row-wide">
              <label for="display_name">Display Name</label>
              <input type="text" id="display_name" name="display_name"
                     tal:attributes="value view/display_name" />
            </div>
            <div class="field-row field-row-wide">
              <label for="description">Description</label>
              <input type="text" id="description" name="description"
                     tal:attributes="value view/description" />
            </div>
            <div class="field-row">
              <label for="surrogate_is">Surrogate IS</label>
              <input type="text" id="surrogate_is" name="surrogate_is"
                     tal:attributes="value view/surrogate_is" />
              <span class="hint">e.g. M4PFOA &#8212; the IS used to quantify all surrogate recoveries</span>
            </div>
          </div>
        </div>
      </details>

      <!-- Calibration -->
      <details open="open">
        <summary>Calibration</summary>
        <div class="section-body">
          <div class="field-grid">
            <div class="field-row">
              <label for="cal_r2_min">R&#178; Minimum</label>
              <input type="number" id="cal_r2_min" name="cal_r2_min"
                     step="0.001" min="0.900" max="1.000"
                     tal:attributes="value python:view.cal().get('r2_min', 0.990)" />
              <span class="hint">e.g. 0.990 (FDA) or 0.995 (generic)</span>
            </div>
            <div class="field-row">
              <label for="cal_point_pct_dev_max">Point % Deviation Max</label>
              <input type="number" id="cal_point_pct_dev_max" name="cal_point_pct_dev_max"
                     step="0.1" min="0"
                     tal:attributes="value python:view.cal().get('point_pct_dev_max', '')" />
              <span class="hint">Each cal point must be within &#177;N% of curve. Leave blank for no limit.</span>
            </div>
            <div class="field-row">
              <label for="cal_low_point_pct_dev_max">Low-Level Point % Dev Max</label>
              <input type="number" id="cal_low_point_pct_dev_max" name="cal_low_point_pct_dev_max"
                     step="0.1" min="0"
                     tal:attributes="value python:view.cal().get('low_point_pct_dev_max') or ''" />
              <span class="hint">Wider limit for lowest calibration level (e.g. 50 for EPA 537.1).</span>
            </div>
            <div class="field-row">
              <div class="check-row">
                <input type="checkbox" id="cal_force_origin" name="cal_force_origin"
                       tal:attributes="checked python:'checked' if view.cal().get('force_origin') else None" />
                <label for="cal_force_origin">Force through origin</label>
              </div>
              <span class="hint">Required by EPA 537.1 IS calibration technique</span>
            </div>
          </div>
        </div>
      </details>

      <!-- CCV -->
      <details open="open">
        <summary>Continuing Calibration Verification (CCV)</summary>
        <div class="section-body">
          <div class="field-grid">
            <div class="field-row">
              <label for="ccv_frequency">CCV Frequency (every N samples)</label>
              <input type="number" id="ccv_frequency" name="ccv_frequency"
                     step="1" min="1"
                     tal:attributes="value python:view.ccv().get('frequency', 10)" />
              <span class="hint">6 for FDA 32-PFAS; 10 for EPA 537.1 / 1633A</span>
            </div>
            <div class="field-row">
              <label for="ccv_recovery_min">Recovery Min %</label>
              <input type="number" id="ccv_recovery_min" name="ccv_recovery_min" step="0.1"
                     tal:attributes="value python:view.ccv().get('recovery_min', 70.0)" />
            </div>
            <div class="field-row">
              <label for="ccv_recovery_max">Recovery Max %</label>
              <input type="number" id="ccv_recovery_max" name="ccv_recovery_max" step="0.1"
                     tal:attributes="value python:view.ccv().get('recovery_max', 130.0)" />
            </div>
            <div class="field-row">
              <label for="ccv_low_level_min">Low-Level Min % (optional)</label>
              <input type="number" id="ccv_low_level_min" name="ccv_low_level_min" step="0.1"
                     tal:attributes="value python:view.ccv().get('low_level_min') or ''" />
              <span class="hint">Wider window for the lowest CCC/CCV level.</span>
            </div>
            <div class="field-row">
              <label for="ccv_low_level_max">Low-Level Max % (optional)</label>
              <input type="number" id="ccv_low_level_max" name="ccv_low_level_max" step="0.1"
                     tal:attributes="value python:view.ccv().get('low_level_max') or ''" />
            </div>
          </div>
        </div>
      </details>

      <!-- IS Response -->
      <details open="open">
        <summary>Internal Standard (IS) / Surrogate Response</summary>
        <div class="section-body">
          <div class="field-grid">
            <div class="field-row">
              <label for="is_vs_ical_avg_min">vs. ICAL Average Min %</label>
              <input type="number" id="is_vs_ical_avg_min" name="is_vs_ical_avg_min" step="0.1"
                     tal:attributes="value python:view.is_section().get('vs_ical_avg_min') or ''" />
            </div>
            <div class="field-row">
              <label for="is_vs_ical_avg_max">vs. ICAL Average Max %</label>
              <input type="number" id="is_vs_ical_avg_max" name="is_vs_ical_avg_max" step="0.1"
                     tal:attributes="value python:view.is_section().get('vs_ical_avg_max') or ''" />
            </div>
            <div class="field-row">
              <label for="is_vs_last_ccv_min">vs. Last CCV Min % (optional)</label>
              <input type="number" id="is_vs_last_ccv_min" name="is_vs_last_ccv_min" step="0.1"
                     tal:attributes="value python:view.is_section().get('vs_last_ccv_min') or ''" />
              <span class="hint">EPA 537.1 &#167;9.3.4 requires this second condition.</span>
            </div>
            <div class="field-row">
              <label for="is_vs_last_ccv_max">vs. Last CCV Max % (optional)</label>
              <input type="number" id="is_vs_last_ccv_max" name="is_vs_last_ccv_max" step="0.1"
                     tal:attributes="value python:view.is_section().get('vs_last_ccv_max') or ''" />
            </div>
            <div class="field-row field-row-wide">
              <label for="is_notes">Notes</label>
              <input type="text" id="is_notes" name="is_notes"
                     tal:attributes="value python:view.is_section().get('notes', '')" />
            </div>
          </div>
        </div>
      </details>

      <!-- Chromatographic Confirmation -->
      <details open="open">
        <summary>Chromatographic Confirmation &amp; Signal Quality</summary>
        <div class="section-body">
          <div class="field-grid">
            <div class="field-row">
              <label for="conf_ion_ratio_tol_pct">Ion Ratio Tolerance &#177; %</label>
              <input type="number" id="conf_ion_ratio_tol_pct" name="conf_ion_ratio_tol_pct"
                     step="0.1" min="0"
                     tal:attributes="value python:view.confirmation().get('ion_ratio_tol_pct') or ''" />
              <span class="hint">30 for FDA; 50 for EPA 1633A; blank for 537.1 (no criterion)</span>
            </div>
            <div class="field-row">
              <label for="conf_rrt_tol_pct">Relative RT Tolerance %</label>
              <input type="number" id="conf_rrt_tol_pct" name="conf_rrt_tol_pct"
                     step="0.1" min="0"
                     tal:attributes="value python:view.confirmation().get('rrt_tol_pct') or ''" />
              <span class="hint">1.0 for FDA (RRT &#177;1% of standard RT).</span>
            </div>
            <div class="field-row">
              <label for="conf_rt_tol_abs_min">Absolute RT Tolerance (min)</label>
              <input type="number" id="conf_rt_tol_abs_min" name="conf_rt_tol_abs_min"
                     step="0.01" min="0"
                     tal:attributes="value python:view.confirmation().get('rt_tol_abs_min') or ''" />
              <span class="hint">0.05 for EPA 537.1.</span>
            </div>
            <div class="field-row">
              <label for="conf_sn_quan_min">S/N Min &#8212; Quantitation Ion</label>
              <input type="number" id="conf_sn_quan_min" name="conf_sn_quan_min"
                     step="0.1" min="0"
                     tal:attributes="value python:view.confirmation().get('sn_quan_min', 3.0)" />
            </div>
            <div class="field-row">
              <label for="conf_sn_confirm_min">S/N Min &#8212; Confirm Ion (optional)</label>
              <input type="number" id="conf_sn_confirm_min" name="conf_sn_confirm_min"
                     step="0.1" min="0"
                     tal:attributes="value python:view.confirmation().get('sn_confirm_min') or ''" />
              <span class="hint">1.0 for EPA 1633A.</span>
            </div>
            <div class="field-row field-row-wide">
              <div class="check-row">
                <input type="checkbox" id="conf_require_confirm_ion_check"
                       name="conf_require_confirm_ion_check"
                       tal:attributes="checked python:'checked' if view.confirmation().get('require_confirm_ion_check') else None" />
                <label for="conf_require_confirm_ion_check">
                  Require qualifier ion check for all analytes
                </label>
              </div>
              <span class="hint">
                ON for FDA 32-PFAS and EPA 1633A; OFF for EPA 537.1.
              </span>
            </div>
          </div>
        </div>
      </details>

      <!-- Duplicate / LFSMD RPD -->
      <details open="open">
        <summary>Duplicate / LFSMD RPD</summary>
        <div class="section-body">
          <div class="field-grid">
            <div class="field-row">
              <label for="dup_rpd_max">Max RPD %</label>
              <input type="number" id="dup_rpd_max" name="dup_rpd_max"
                     step="0.1" min="0"
                     tal:attributes="value python:view.duplicate().get('rpd_max', 20.0)" />
              <span class="hint">20 for FDA; 30 for EPA methods</span>
            </div>
          </div>
        </div>
      </details>

      <!-- Recovery Tiers -->
      <details>
        <summary>Recovery Tiers</summary>
        <div class="section-body">
          <p style="font-size:12px;color:var(--s-secondary);margin-bottom:10px">
            Each tier card sets the recovery window (min/max %) and optional RSD limit.
            <strong>Key Analytes</strong> — analytes subject to this tier's stricter limits.
            <strong>Tight Matrices</strong> — if set, this tier only applies in those matrices.
            <strong>No-Std Analytes</strong> — analytes that always fall to this tier (no labeled IS).
            Leave all three pickers empty for a catch-all default tier.
          </p>
          <div id="recoveryTiersContainer"></div>
          <button type="button" class="btn-add-row" style="margin-top:4px"
                  onclick="addRecoveryTier()">+ Add Tier</button>

          <!-- Serialised tiers (read by JS on load; written by syncRecoveryTiersJson before submit) -->
          <input type="hidden" name="recovery_tiers_json" id="recovery_tiers_json"
                 tal:attributes="value view/recovery_tiers_json" />
        </div>
      </details>

      <!-- Analyte × Matrix Inclusion -->
      <details>
        <summary>Analyte &#215; Matrix Inclusion</summary>
        <div class="section-body">

          <!-- Persistent verification banner for EPA methods (Decision B) -->
          <div class="alert alert-warn"
               tal:condition="view/analyte_matrix_needs_verification"
               style="margin-bottom:12px">
            &#9888; <strong>Lab verification required.</strong>
            The analyte set for this method is seeded from the FDA 32-analyte list
            as a placeholder. Review each row against your purchased method copy
            and uncheck any analytes not reportable under this method before
            production use.
          </div>

          <p style="font-size:12px;color:var(--s-secondary);margin-bottom:10px">
            Each checked cell means the analyte is <strong>reportable</strong> in
            that matrix. Unchecked analytes are excluded from the surrogate map,
            recovery tiers, QC checks, reports, and EDD for that matrix.
            Click an analyte name to toggle its whole row; click &#10003;/&#10007;
            under a matrix column header to check/uncheck the whole column.
          </p>

          <div class="inclusion-wrap">
            <div id="amiGridContainer">
              <em style="color:var(--s-secondary);font-size:12px">Loading&#8230;</em>
            </div>
          </div>

          <!-- Read-only ordered structure for JS; inclusion dict is the live value -->
          <input type="hidden" id="ami_grid_data"
                 tal:attributes="value view/analyte_matrix_grid_data" />
          <input type="hidden" name="analyte_matrix_inclusion_json"
                 id="analyte_matrix_inclusion_json"
                 tal:attributes="value view/analyte_matrix_json" />
        </div>
      </details>

      <!-- Matrix Adjustment Factor (one per method) -->
      <details>
        <summary>Matrix Adjustment Factor</summary>
        <div class="section-body">
          <div class="field-grid">
            <div class="field-row">
              <label for="matrix_factor">Matrix Adjustment Factor</label>
              <div class="field-sublabel">
                Single integer multiplier applied to every result for this method.
                C<sub>reported</sub> = C<sub>instrument</sub> &#215; factor.
                Set to 1 if no adjustment is needed.
              </div>
              <input type="number" id="matrix_factor" name="matrix_factor"
                     step="1" min="1"
                     style="width:100px;"
                     tal:attributes="value view/matrix_factor" />
            </div>
          </div>
        </div>
      </details>

      <!-- Salt Adjustment Factors -->
      <details>
        <summary>Salt Adjustment Factors (per analyte, from CoA)</summary>
        <div class="section-body">
          <p class="json-hint">
            Molar-mass correction for standards supplied as salts.
            Factor = (M.W. free acid) / (M.W. salt form).
          </p>
          <table class="factor-table" id="saltAdjTable">
            <thead>
              <tr>
                <th style="width:35%">Analyte</th>
                <th style="width:20%">Factor</th>
                <th style="width:35%">CoA Reference</th>
                <th style="width:36px"></th>
              </tr>
            </thead>
            <tbody id="saltAdjBody"></tbody>
          </table>
          <button type="button" class="btn-add-row" onclick="addSaltRow()">+ Add row</button>
          <input type="hidden" name="salt_adjustment_factors_json" id="salt_adjustment_factors_json"
                 tal:attributes="value view/salt_adjustment_factors_json" />
        </div>
      </details>

      <!-- Isomer Summation -->
      <details>
        <summary>Isomer Summation (linear + branched &#8594; reported analyte)</summary>
        <div class="section-body">
          <p class="json-hint">
            Define which linear/branched instrument peaks sum into a single reported analyte.
            Summation applied BEFORE salt and matrix adjustment factors.
          </p>
          <table class="factor-table" id="isomerTable">
            <thead>
              <tr>
                <th style="width:25%">Linear peak</th>
                <th style="width:25%">Branched peak</th>
                <th style="width:25%">Reported as</th>
                <th style="width:60px;text-align:center">Active</th>
                <th style="width:36px"></th>
              </tr>
            </thead>
            <tbody id="isomerBody"></tbody>
          </table>
          <button type="button" class="btn-add-row" onclick="addIsomerRow()">+ Add pair</button>
          <input type="hidden" name="isomer_summation_json" id="isomer_summation_json"
                 tal:attributes="value view/isomer_summation_json" />
        </div>
      </details>

      <!-- Spike Levels -->
      <details>
        <summary>Spike Levels (LFB / LFSM)</summary>
        <div class="section-body">
          <p class="json-hint">
            JSON object. Keys are QC types (<code>"LFB"</code>, <code>"LFSM"</code>).
            Each value is an array of <code>{"label": "High", "ppt": 10.0}</code> entries.
            The pipeline uses these to resolve spike concentrations from injection names
            (e.g. <em>"; LFSM High"</em> &rarr; label "High" &rarr; ppt value here).
            LFSMD uses the same levels as LFSM.
            <strong>Enter the lab's actual spike amounts — do not leave at zero.</strong>
          </p>
          <textarea class="json-area" name="spike_levels_json" id="spike_levels_json" rows="12"
                    tal:content="view/spike_levels_json">{"LFB": [], "LFSM": []}</textarea>
        </div>
      </details>

      <!-- Surrogate Map (IS-lane bucket UI) -->
      <details>
        <summary>Surrogate Map (native analyte &#8594; labeled IS &#8594; injection IS)</summary>
        <div class="section-body">
          <p style="font-size:12px;color:var(--s-secondary);margin-bottom:10px">
            Drag a native analyte chip into the IS lane that quantifies it.
            For isotope-dilution methods, also set the <em>Quantified by</em> injection IS
            for each surrogate lane. Analytes with no IS assigned appear in the
            <strong>Unassigned</strong> tray.
          </p>
          <div id="surrogateGridContainer">
            <em style="color:var(--s-secondary);font-size:12px">Loading&#8230;</em>
          </div>

          <!-- Structural data for JS (read-only) -->
          <input type="hidden" id="surrogate_is_data"
                 tal:attributes="value view/surrogate_is_data" />
          <!-- Submitted values written by JS before form submit -->
          <input type="hidden" name="surrogate_map_json"
                 id="surrogate_map_json" value="[]" />
          <input type="hidden" name="surrogate_is_chain_json"
                 id="surrogate_is_chain_json"
                 tal:attributes="value view/surrogate_is_chain_json" />
        </div>
      </details>

      <!-- Per-Analyte Table -->
      <details>
        <summary>Per-Analyte Assignments</summary>
        <div class="section-body">
          <p class="json-hint">
            JSON array. Each row: { "analyte": "PFBA", "surrogate": "M3PFBA",
            "no_labeled_std": false, "is_key_analyte": false,
            "recovery_tier": 2, "confirm_ion_mz": "213.04&gt;18.99", "notes": "" }
          </p>
          <textarea class="json-area" name="per_analyte_json" rows="14"
                    tal:content="view/per_analyte_json">[]</textarea>
        </div>
      </details>

      <!-- EPA 1633A EIS Overrides — hidden for FDA and EPA 537.1 -->
      <details tal:condition="view/show_eis_overrides">
        <summary>EIS Recovery Overrides <span style="font-size:11px;color:var(--s-secondary);font-weight:400">(EPA 1633A only)</span></summary>
        <div class="section-body">
          <div class="alert alert-warn" style="margin-bottom:10px">
            &#9888; <strong>Lab verification required.</strong>
            Per-analyte EIS/OPR recovery windows from EPA 1633A Tables 6 and 8.
            Values shown are placeholders — verify each row against your purchased method copy
            before production use.
          </div>
          <table class="factor-table" id="eisOverrideTable">
            <thead>
              <tr>
                <th>EIS / Surrogate Analyte</th>
                <th>Recovery Min (%)</th>
                <th>Recovery Max (%)</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="eisOverrideBody"></tbody>
          </table>
          <button type="button" class="btn-add-row" onclick="addEisRow()">+ Add row</button>
          <input type="hidden" name="eis_overrides_json" id="eis_overrides_json"
                 tal:attributes="value view/eis_overrides_json" />
        </div>
      </details>

      <!-- Extraction Stages -->
      <details open="open">
        <summary>Extraction Stages</summary>
        <div class="section-body">
          <p class="json-hint">
            Define the guided extraction workflow stages for this method.
            Each stage appears as a step in the <strong>Extraction Guide</strong> on Batch objects.
            Drag rows to reorder (order field updates automatically).
          </p>
          <div id="stage-list"></div>
          <button type="button" class="btn-add-row" onclick="addStageCard()">+ Add stage</button>
          <input type="hidden" name="extraction_stages_json" id="extraction_stages_json"
                 tal:attributes="value view/extraction_stages_json" />
        </div>
      </details>

      <div class="save-bar">
        <button type="submit" class="btn-save">Save &amp; Export to Worker</button>
        <a class="btn-cancel" href="@@pfas-method-profiles">Cancel</a>
      </div>

    </form>
  </div><!-- /page-body -->

  <script>
  function tableToJson(tbodyId, fieldMap) {
    var rows = document.getElementById(tbodyId).querySelectorAll('tr');
    var result = [];
    rows.forEach(function(row) {
      var obj = {}, empty = true;
      fieldMap.forEach(function(f) {
        var el = row.querySelector('[data-field="' + f.key + '"]');
        if (!el) return;
        var val = el.type === 'checkbox' ? el.checked : el.value.trim();
        obj[f.key] = f.type === 'number' ? (parseFloat(val) || 0) : val;
        if (f.type !== 'bool' && val !== '' && val !== '0') empty = false;
        if (f.type === 'bool') empty = false;
      });
      if (!empty) result.push(obj);
    });
    return result;
  }

  function syncJson(tbodyId, hiddenId, fieldMap) {
    document.getElementById(hiddenId).value = JSON.stringify(tableToJson(tbodyId, fieldMap), null, 2);
  }

  var SA_FIELDS = [{key:'analyte',type:'text'},{key:'factor',type:'number'},{key:'source',type:'text'}];
  function addSaltRow(analyte, factor, source) {
    var tbody = document.getElementById('saltAdjBody');
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td><input type="text" data-field="analyte" value="' + (analyte||'') + '" placeholder="e.g. PFOS" /></td>' +
      '<td><input type="number" data-field="factor" step="0.0001" min="0" max="1" value="' + (factor!=null?factor:'') + '" placeholder="0.9815" /></td>' +
      '<td><input type="text" data-field="source" value="' + (source||'') + '" placeholder="CoA lot #" /></td>' +
      '<td><button type="button" class="del-btn" onclick="this.closest(\'tr\').remove();syncSaltJson()">&#215;</button></td>';
    tbody.appendChild(tr);
    tr.querySelectorAll('input').forEach(function(i) { i.addEventListener('change',syncSaltJson); i.addEventListener('input',syncSaltJson); });
  }
  function syncSaltJson() { syncJson('saltAdjBody','salt_adjustment_factors_json',SA_FIELDS); }

  var EIS_FIELDS = [{key:'analyte',type:'text'},{key:'recovery_min',type:'number'},{key:'recovery_max',type:'number'}];
  function addEisRow(analyte, rmin, rmax) {
    var tbody = document.getElementById('eisOverrideBody');
    if (!tbody) return;
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td><input type="text" data-field="analyte" value="' + _esc(analyte||'') + '" placeholder="e.g. M2-4:2FTS" /></td>' +
      '<td><input type="number" data-field="recovery_min" step="0.1" min="0" value="' + (rmin!=null?rmin:'') + '" placeholder="20.0" /></td>' +
      '<td><input type="number" data-field="recovery_max" step="0.1" min="0" value="' + (rmax!=null?rmax:'') + '" placeholder="150.0" /></td>' +
      '<td><button type="button" class="del-btn" onclick="this.closest(\'tr\').remove();syncEisJson()">&#215;</button></td>';
    tbody.appendChild(tr);
    tr.querySelectorAll('input').forEach(function(i) { i.addEventListener('change',syncEisJson); i.addEventListener('input',syncEisJson); });
  }
  function syncEisJson() {
    if (document.getElementById('eis_overrides_json')) {
      syncJson('eisOverrideBody','eis_overrides_json',EIS_FIELDS);
    }
  }

  var IS_FIELDS = [{key:'linear',type:'text'},{key:'branched',type:'text'},{key:'reported',type:'text'},{key:'enabled',type:'bool'}];
  function addIsomerRow(linear, branched, reported, enabled) {
    var tbody = document.getElementById('isomerBody');
    var tr = document.createElement('tr');
    var checked = enabled !== false ? 'checked' : '';
    tr.innerHTML =
      '<td><input type="text" data-field="linear"   value="' + (linear||'')   + '" placeholder="lr-PFOS" /></td>' +
      '<td><input type="text" data-field="branched" value="' + (branched||'') + '" placeholder="br-PFOS" /></td>' +
      '<td><input type="text" data-field="reported" value="' + (reported||'') + '" placeholder="PFOS" /></td>' +
      '<td style="text-align:center"><label class="toggle-switch">' +
        '<input type="checkbox" data-field="enabled" ' + checked + ' />' +
        '<span class="toggle-track"></span></label></td>' +
      '<td><button type="button" class="del-btn" onclick="this.closest(\'tr\').remove();syncIsomerJson()">&#215;</button></td>';
    tbody.appendChild(tr);
    tr.querySelectorAll('input').forEach(function(i) { i.addEventListener('change',syncIsomerJson); i.addEventListener('input',syncIsomerJson); });
  }
  function syncIsomerJson() { syncJson('isomerBody','isomer_summation_json',IS_FIELDS); }

  /* ── Extraction Stages ─────────────────────────────────────── */
  var _stageSeq = 0;
  function addStageCard(s) {
    s = s || {};
    _stageSeq++;
    var id     = 'stage-card-' + _stageSeq;
    var order  = s.order !== undefined ? s.order : _stageSeq;
    var stageId = s.id || '';
    var name   = s.name || '';
    var desc   = s.description || '';
    var roles  = (s.reagent_roles || []).join(', ');
    var equip  = (s.equipment || []).join(', ');
    var crSol  = s.creates_solution ? 'checked' : '';
    var crPed  = s.capture_pedigree ? 'checked' : '';

    var card = document.createElement('div');
    card.className = 'stage-card';
    card.id = id;
    card.setAttribute('draggable', 'true');
    card.innerHTML =
      '<div class="stage-card-hdr">' +
        '<span class="drag-handle" title="Drag to reorder">&#9776;</span>' +
        '<strong class="stage-card-title">' + (name || 'New Stage') + '</strong>' +
        '<button type="button" class="del-btn" onclick="removeStageCard(\'' + id + '\')">&#215;</button>' +
      '</div>' +
      '<div class="stage-card-body">' +
        '<div class="stage-row">' +
          '<label>Order<input type="number" data-field="order" value="' + order + '" min="1" max="99" style="width:60px" /></label>' +
          '<label>ID (slug)<input type="text" data-field="id" value="' + _esc(stageId) + '" placeholder="pre_setup" style="width:130px" /></label>' +
          '<label>Name<input type="text" data-field="name" value="' + _esc(name) + '" placeholder="Stage name" style="flex:1" /></label>' +
        '</div>' +
        '<div class="stage-row">' +
          '<label style="flex:1">Description<input type="text" data-field="description" value="' + _esc(desc) + '" placeholder="What happens at this stage" /></label>' +
        '</div>' +
        '<div class="stage-row">' +
          '<label style="flex:1">Reagent Roles (comma-separated)<input type="text" data-field="reagent_roles" value="' + _esc(roles) + '" placeholder="Methanol (HPLC grade), Acetonitrile, ..." /></label>' +
        '</div>' +
        '<div class="stage-row">' +
          '<label style="flex:1">Equipment (comma-separated)<input type="text" data-field="equipment" value="' + _esc(equip) + '" placeholder="Analytical balance, SPE manifold, ..." /></label>' +
        '</div>' +
        '<div class="stage-row" style="gap:20px">' +
          '<label class="cb-label"><input type="checkbox" data-field="creates_solution" ' + crSol + ' /> Creates Solution</label>' +
          '<label class="cb-label"><input type="checkbox" data-field="capture_pedigree" ' + crPed + ' /> Capture Standard Pedigree</label>' +
        '</div>' +
      '</div>';

    /* update card title on name change */
    card.querySelector('[data-field="name"]').addEventListener('input', function() {
      card.querySelector('.stage-card-title').textContent = this.value || 'New Stage';
      syncStageJson();
    });
    card.querySelectorAll('input').forEach(function(i) {
      i.addEventListener('change', syncStageJson);
      i.addEventListener('input', function() { if (i.type !== 'text') syncStageJson(); });
    });

    /* drag-to-reorder */
    card.addEventListener('dragstart', function(e) {
      e.dataTransfer.setData('text/plain', id);
      card.classList.add('dragging');
    });
    card.addEventListener('dragend', function() {
      card.classList.remove('dragging');
      renumberStages();
      syncStageJson();
    });
    card.addEventListener('dragover', function(e) {
      e.preventDefault();
      var list = document.getElementById('stage-list');
      var dragging = list.querySelector('.dragging');
      if (!dragging || dragging === card) return;
      var rect = card.getBoundingClientRect();
      var mid  = rect.top + rect.height / 2;
      if (e.clientY < mid) {
        list.insertBefore(dragging, card);
      } else {
        list.insertBefore(dragging, card.nextSibling);
      }
    });

    document.getElementById('stage-list').appendChild(card);
    syncStageJson();
  }

  function removeStageCard(id) {
    var el = document.getElementById(id);
    if (el) { el.parentNode.removeChild(el); renumberStages(); syncStageJson(); }
  }

  function renumberStages() {
    document.getElementById('stage-list').querySelectorAll('.stage-card').forEach(function(card, idx) {
      var inp = card.querySelector('[data-field="order"]');
      if (inp) inp.value = idx + 1;
    });
  }

  function syncStageJson() {
    var cards = document.getElementById('stage-list').querySelectorAll('.stage-card');
    var result = [];
    cards.forEach(function(card) {
      var get = function(f) {
        var el = card.querySelector('[data-field="' + f + '"]');
        return el ? el.value.trim() : '';
      };
      var getBool = function(f) {
        var el = card.querySelector('[data-field="' + f + '"]');
        return el ? el.checked : false;
      };
      var splitCsv = function(s) {
        return s ? s.split(',').map(function(x) { return x.trim(); }).filter(Boolean) : [];
      };
      result.push({
        id:               get('id') || ('stage_' + (result.length + 1)),
        order:            parseInt(get('order'), 10) || (result.length + 1),
        name:             get('name'),
        description:      get('description'),
        reagent_roles:    splitCsv(get('reagent_roles')),
        equipment:        splitCsv(get('equipment')),
        creates_solution: getBool('creates_solution'),
        capture_pedigree: getBool('capture_pedigree'),
      });
    });
    document.getElementById('extraction_stages_json').value = JSON.stringify(result, null, 2);
  }

  function _esc(s) {
    return (s || '').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/\u003c/g,'&lt;').replace(/\u003e/g,'&gt;');
  }

  /* ── Recovery Tiers ──────────────────────────────────────────── */

  function _tierChipHtml(val, cssClass, field) {
    return '<span class="tier-chip ' + cssClass + '" data-field="' + field + '" data-val="' + _esc(val) + '">' +
      _esc(val) +
      '<button type="button" class="tier-chip-rm" onclick="removeTierChip(this)">&times;</button>' +
      '</span>';
  }

  function _tierAddSelHtml(allItems, current, field, label) {
    var available = allItems.filter(function(x) { return current.indexOf(x) === -1; });
    var opts = '<option value="">' + _esc(label) + '</option>';
    available.forEach(function(x) { opts += '<option value="' + _esc(x) + '">' + _esc(x) + '</option>'; });
    return '<select class="tier-add-sel" data-field="' + field + '" data-all="' + _esc(JSON.stringify(allItems)) + '"' +
      ' onchange="addTierChip(this)">' + opts + '</select>';
  }

  function _buildTierCard(tier, idx, allAnalytes, allMatrices) {
    var ka  = tier.key_analytes    || [];
    var tm  = tier.tight_matrices  || [];
    var ns  = tier.no_std_analytes || [];

    var kaChips = ka.map(function(v) { return _tierChipHtml(v, '', 'key_analytes'); }).join('');
    var tmChips = tm.map(function(v) { return _tierChipHtml(v, 'mat-chip', 'tight_matrices'); }).join('');
    var nsChips = ns.map(function(v) { return _tierChipHtml(v, 'nostd-chip', 'no_std_analytes'); }).join('');

    return '<div class="tier-card" data-tier-idx="' + idx + '">' +
      '<div class="tier-card-hdr">' +
        '<span class="tier-badge">Tier ' + (idx + 1) + '</span>' +
        '<input type="text" class="tier-desc" value="' + _esc(tier.description || '') + '" placeholder="Describe when this tier applies" />' +
        '<button type="button" class="del-btn" title="Remove tier" onclick="removeTierCard(this)">&#215;</button>' +
      '</div>' +
      '<div class="tier-card-body">' +
        '<div class="tier-limits">' +
          '<label>Min Recovery <input type="number" class="tier-min" step="0.1" min="0" max="100" value="' + (tier.recovery_min != null ? tier.recovery_min : '') + '" oninput="syncRecoveryTiersJson()" /> %</label>' +
          '<label>Max Recovery <input type="number" class="tier-max" step="0.1" min="0" max="200" value="' + (tier.recovery_max != null ? tier.recovery_max : '') + '" oninput="syncRecoveryTiersJson()" /> %</label>' +
          '<label>RSD &#8804; <input type="number" class="tier-rsd" step="0.1" min="0" value="' + (tier.rsd_max != null ? tier.rsd_max : '') + '" oninput="syncRecoveryTiersJson()" /> %</label>' +
        '</div>' +
        '<div class="tier-chipfield" data-field="key_analytes">' +
          '<label>Key Analytes (stricter limits apply to these)</label>' +
          '<div class="tier-chip-row">' + kaChips + _tierAddSelHtml(allAnalytes, ka, 'key_analytes', '+ Add analyte') + '</div>' +
        '</div>' +
        '<div class="tier-chipfield" data-field="tight_matrices">' +
          '<label>Tight Matrices (leave empty = any matrix)</label>' +
          '<div class="tier-chip-row">' + tmChips + _tierAddSelHtml(allMatrices, tm, 'tight_matrices', '+ Add matrix') + '</div>' +
        '</div>' +
        '<div class="tier-chipfield" data-field="no_std_analytes">' +
          '<label>No-Std Analytes (always this tier, no labeled IS)</label>' +
          '<div class="tier-chip-row">' + nsChips + _tierAddSelHtml(allAnalytes, ns, 'no_std_analytes', '+ Add analyte') + '</div>' +
        '</div>' +
      '</div>' +
    '</div>';
  }

  function _tierMeta() {
    var gridData = {};
    try { gridData = JSON.parse((document.getElementById('ami_grid_data') || {value:'{}'}).value || '{}'); }
    catch(e) {}
    return { analytes: gridData.analytes || [], matrices: gridData.matrices || [] };
  }

  function buildRecoveryTiersGrid() {
    var el = document.getElementById('recoveryTiersContainer');
    if (!el) return;

    var tiers = [];
    try { tiers = JSON.parse(document.getElementById('recovery_tiers_json').value || '[]'); }
    catch(e) {}

    var meta = _tierMeta();
    var html = '';
    tiers.forEach(function(t, i) { html += _buildTierCard(t, i, meta.analytes, meta.matrices); });
    el.innerHTML = html;

    /* wire desc/limits inputs for live sync */
    el.querySelectorAll('.tier-desc').forEach(function(inp) {
      inp.addEventListener('input', syncRecoveryTiersJson);
    });
  }

  function addRecoveryTier() {
    var el = document.getElementById('recoveryTiersContainer');
    var meta = _tierMeta();
    var count = el.querySelectorAll('.tier-card').length;
    var frag = document.createElement('div');
    frag.innerHTML = _buildTierCard({}, count, meta.analytes, meta.matrices);
    var card = frag.firstChild;
    el.appendChild(card);
    card.querySelector('.tier-desc').addEventListener('input', syncRecoveryTiersJson);
    _renumberTierBadges();
    syncRecoveryTiersJson();
  }

  function removeTierCard(btn) {
    btn.closest('.tier-card').remove();
    _renumberTierBadges();
    syncRecoveryTiersJson();
  }

  function _renumberTierBadges() {
    document.querySelectorAll('#recoveryTiersContainer .tier-card').forEach(function(card, i) {
      var badge = card.querySelector('.tier-badge');
      if (badge) badge.textContent = 'Tier ' + (i + 1);
      card.setAttribute('data-tier-idx', i);
    });
  }

  function addTierChip(sel) {
    var val = sel.value;
    if (!val) return;
    sel.value = '';
    var field = sel.getAttribute('data-field');
    var chipfield = sel.closest('.tier-chipfield');
    var row = sel.closest('.tier-chip-row');
    var cssClass = field === 'tight_matrices' ? 'mat-chip' : (field === 'no_std_analytes' ? 'nostd-chip' : '');
    var chip = document.createElement('span');
    chip.className = 'tier-chip ' + cssClass;
    chip.setAttribute('data-field', field);
    chip.setAttribute('data-val', val);
    chip.innerHTML = _esc(val) + '<button type="button" class="tier-chip-rm" onclick="removeTierChip(this)">&times;</button>';
    row.insertBefore(chip, sel);
    /* remove from dropdown */
    var opt = sel.querySelector('option[value="' + val.replace(/"/g, '\\"') + '"]');
    if (opt) opt.remove();
    syncRecoveryTiersJson();
  }

  function removeTierChip(btn) {
    var chip = btn.closest('.tier-chip');
    if (!chip) return;
    var val = chip.getAttribute('data-val');
    var field = chip.getAttribute('data-field');
    var row = chip.closest('.tier-chip-row');
    chip.remove();
    /* add back to dropdown (sorted) */
    var sel = row.querySelector('select.tier-add-sel[data-field="' + field + '"]');
    if (sel && val) {
      var opt = document.createElement('option');
      opt.value = val;
      opt.textContent = val;
      /* insert sorted */
      var inserted = false;
      for (var i = 1; i < sel.options.length; i++) {
        if (sel.options[i].value > val) {
          sel.insertBefore(opt, sel.options[i]);
          inserted = true;
          break;
        }
      }
      if (!inserted) sel.appendChild(opt);
    }
    syncRecoveryTiersJson();
  }

  function syncRecoveryTiersJson() {
    var tiers = [];
    document.querySelectorAll('#recoveryTiersContainer .tier-card').forEach(function(card, idx) {
      var tier = { tier: idx + 1 };
      var desc = card.querySelector('.tier-desc');
      if (desc) tier.description = desc.value.trim();
      var minEl = card.querySelector('.tier-min');
      var maxEl = card.querySelector('.tier-max');
      var rsdEl = card.querySelector('.tier-rsd');
      if (minEl && minEl.value !== '') tier.recovery_min = parseFloat(minEl.value);
      if (maxEl && maxEl.value !== '') tier.recovery_max = parseFloat(maxEl.value);
      if (rsdEl && rsdEl.value !== '') tier.rsd_max     = parseFloat(rsdEl.value);
      ['key_analytes', 'tight_matrices', 'no_std_analytes'].forEach(function(field) {
        var chips = card.querySelectorAll('.tier-chip[data-field="' + field + '"]');
        var vals = Array.prototype.map.call(chips, function(c) { return c.getAttribute('data-val'); });
        tier[field] = vals;
      });
      tiers.push(tier);
    });
    var el = document.getElementById('recovery_tiers_json');
    if (el) el.value = JSON.stringify(tiers);
  }

  /* ── Surrogate IS-lane grid ───────────────────────────────────── */

  var _surDragAnalyte = null;
  var _surDragSrc     = null;

  function buildSurrogateGrid() {
    var el = document.getElementById('surrogateGridContainer');
    if (!el) return;

    var d;
    try { d = JSON.parse(document.getElementById('surrogate_is_data').value || '{}'); }
    catch(e) { el.textContent = 'Error loading surrogate data.'; return; }

    var analytes    = d.analytes    || [];
    var surrogates  = d.surrogates  || [];   /* [[kw, name], ...] */
    var injIsList   = d.injection_is || [];  /* [[kw, name], ...] */
    var currentMap  = d.map         || {};   /* {analyte: surrogate_kw} */
    var chain       = d.chain       || {};   /* {surrogate_kw: inj_is_kw} */

    if (!analytes.length) {
      el.innerHTML = '<em style="color:var(--s-secondary);font-size:12px">No analytes configured.</em>';
      return;
    }

    /* ── build injection IS option list; selection applied per-lane below ── */
    var _injIsRows = injIsList.slice();  /* cache for per-lane rendering */

    /* ── figure out which analytes are already assigned ── */
    function assignedTo(kwSur) {
      return analytes.filter(function(a) { return currentMap[a] === kwSur; });
    }
    function unassigned() {
      return analytes.filter(function(a) { return !currentMap[a]; });
    }

    function chipHtml(analyte, inPool) {
      return '<span class="sur-chip' + (inPool ? '' : '') + '" draggable="true"' +
        ' data-analyte="' + _esc(analyte) + '">' +
        _esc(analyte) +
        '<button type="button" class="sur-chip-rm" title="Remove" onclick="surChipRemove(this)">&times;</button>' +
        '</span>';
    }

    /* ── unassigned pool ── */
    var ua = unassigned();
    var html = '<div class="sur-unassigned" id="surUnassigned"' +
      ' ondragover="surDragOver(event)" ondrop="surDrop(event,null)">' +
      '<div class="sur-unassigned-label">Unassigned (' + ua.length + ')</div>' +
      '<div class="sur-chip-pool">';
    ua.forEach(function(a) { html += chipHtml(a, true); });
    html += '</div></div>';

    /* ── IS lanes ── */
    html += '<div class="sur-grid" id="surLanesContainer">';
    surrogates.forEach(function(row) {
      var kw = row[0], name = row[1];
      var assigned = assignedTo(kw);
      var chainVal = chain[kw] || '';
      var selOpts = '<option value="">— None —</option>';
      _injIsRows.forEach(function(ir) {
        selOpts += '<option value="' + _esc(ir[0]) + '"' +
          (ir[0] === chainVal ? ' selected' : '') + '>' +
          _esc(ir[0]) + ' (' + _esc(ir[1]) + ')</option>';
      });
      html += '<div class="sur-lane" data-sur-kw="' + _esc(kw) + '">' +
        '<div class="sur-lane-hdr">' +
          '<div class="sur-lane-name">' + _esc(kw) + '</div>' +
          '<div class="sur-lane-label">' + _esc(name) + '</div>' +
          '<select class="sur-chain-sel" data-sur-kw="' + _esc(kw) + '"' +
            ' title="Quantified by (injection IS)" onchange="syncSurrogateJson()">' +
            selOpts +
          '</select>' +
        '</div>' +
        '<div class="sur-lane-body" data-sur-kw="' + _esc(kw) + '"' +
          ' ondragover="surDragOver(event)" ondrop="surDrop(event,' + JSON.stringify(kw) + ')">';
      assigned.forEach(function(a) { html += chipHtml(a, false); });
      html += '</div></div>';
    });
    html += '</div>';

    el.innerHTML = html;

    /* wire chip drag events (event delegation won't fire on dynamically-added draggable) */
    _surRewireChips(el);
    syncSurrogateJson();
  }

  function _surRewireChips(container) {
    (container || document).querySelectorAll('.sur-chip').forEach(function(chip) {
      chip.addEventListener('dragstart', function(e) {
        _surDragAnalyte = chip.getAttribute('data-analyte');
        _surDragSrc = chip.closest('[data-sur-kw]') || chip.closest('#surUnassigned');
        chip.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
      });
      chip.addEventListener('dragend', function() {
        chip.classList.remove('dragging');
        _surDragAnalyte = null;
        _surDragSrc = null;
      });
    });
  }

  function surDragOver(e) {
    e.preventDefault();
    e.currentTarget.classList.add('drag-over');
    e.dataTransfer.dropEffect = 'move';
  }

  document.addEventListener('dragleave', function(e) {
    var t = e.target;
    if (t && (t.classList.contains('sur-lane-body') || t.id === 'surUnassigned')) {
      t.classList.remove('drag-over');
    }
  });

  function surDrop(e, surKw) {
    e.preventDefault();
    e.currentTarget.classList.remove('drag-over');
    if (!_surDragAnalyte) return;

    /* remove chip from its current home */
    var existing = document.querySelector('.sur-chip[data-analyte="' + _surDragAnalyte + '"]');
    if (existing) existing.remove();

    /* append chip to target */
    var targetBody;
    if (surKw) {
      targetBody = document.querySelector('.sur-lane-body[data-sur-kw="' + surKw + '"]');
    } else {
      targetBody = document.querySelector('#surUnassigned .sur-chip-pool');
    }
    if (targetBody) {
      var chipEl = document.createElement('span');
      chipEl.className = 'sur-chip';
      chipEl.setAttribute('draggable', 'true');
      chipEl.setAttribute('data-analyte', _surDragAnalyte);
      chipEl.innerHTML = _esc(_surDragAnalyte) +
        '<button type="button" class="sur-chip-rm" title="Remove" onclick="surChipRemove(this)">&times;</button>';
      targetBody.appendChild(chipEl);
      _surRewireChips(targetBody);
    }

    /* update unassigned count */
    _surUpdateUnassignedCount();
    syncSurrogateJson();
  }

  function surChipRemove(btn) {
    var chip = btn.closest('.sur-chip');
    if (!chip) return;
    var analyte = chip.getAttribute('data-analyte');
    chip.remove();

    /* move to unassigned pool */
    var pool = document.querySelector('#surUnassigned .sur-chip-pool');
    if (pool) {
      var chipEl = document.createElement('span');
      chipEl.className = 'sur-chip';
      chipEl.setAttribute('draggable', 'true');
      chipEl.setAttribute('data-analyte', analyte);
      chipEl.innerHTML = _esc(analyte) +
        '<button type="button" class="sur-chip-rm" title="Remove" onclick="surChipRemove(this)">&times;</button>';
      pool.appendChild(chipEl);
      _surRewireChips(pool);
    }

    _surUpdateUnassignedCount();
    syncSurrogateJson();
  }

  function _surUpdateUnassignedCount() {
    var pool = document.querySelector('#surUnassigned .sur-chip-pool');
    var label = document.querySelector('#surUnassigned .sur-unassigned-label');
    if (pool && label) {
      label.textContent = 'Unassigned (' + pool.querySelectorAll('.sur-chip').length + ')';
    }
  }

  function syncSurrogateJson() {
    /* build surrogate_map: [{analyte, surrogate_is}] */
    var map = [];
    document.querySelectorAll('#surLanesContainer .sur-lane').forEach(function(lane) {
      var surKw = lane.getAttribute('data-sur-kw');
      lane.querySelectorAll('.sur-chip').forEach(function(chip) {
        map.push({analyte: chip.getAttribute('data-analyte'), surrogate_is: surKw});
      });
    });
    var smEl = document.getElementById('surrogate_map_json');
    if (smEl) smEl.value = JSON.stringify(map);

    /* build surrogate_is_chain: {surKw: injIsKw} */
    var chain = {};
    document.querySelectorAll('.sur-chain-sel').forEach(function(sel) {
      var kw = sel.getAttribute('data-sur-kw');
      if (kw && sel.value) chain[kw] = sel.value;
    });
    var scEl = document.getElementById('surrogate_is_chain_json');
    if (scEl) scEl.value = JSON.stringify(chain);
  }

  /* ── Analyte × Matrix Inclusion grid ─────────────────────────── */

  function buildAMIGrid() {
    var gridEl = document.getElementById('amiGridContainer');
    if (!gridEl) return;

    var gridData, inclusion;
    try {
      gridData  = JSON.parse(document.getElementById('ami_grid_data').value  || '{}');
      inclusion = JSON.parse(document.getElementById('analyte_matrix_inclusion_json').value || '{}');
    } catch(e) {
      gridEl.textContent = 'Error loading grid data.';
      return;
    }

    var analytes = gridData.analytes || [];
    var matrices = gridData.matrices || [];

    if (!analytes.length || !matrices.length) {
      gridEl.innerHTML = '<em style="color:var(--s-secondary);font-size:12px">No analytes configured for this method.</em>';
      return;
    }

    var html = '<table class="inclusion-grid"><thead><tr>';
    html += '<th class="analyte-col">Analyte</th>';
    matrices.forEach(function(mat, ci) {
      html += '<th>' + _esc(mat) +
        '<span class="ami-col-ctrl">' +
        '<button type="button" class="ami-bulk-btn" title="Check all" onclick="amiColAll(' + ci + ',true)">&#10003;</button>' +
        '<button type="button" class="ami-bulk-btn" title="Uncheck all" onclick="amiColAll(' + ci + ',false)">&#10007;</button>' +
        '</span></th>';
    });
    html += '</tr></thead><tbody>';

    analytes.forEach(function(kw, ri) {
      html += '<tr><td class="analyte-name">' +
        '<button type="button" class="ami-row-btn" title="Toggle row" onclick="amiRowToggle(' + ri + ')">' +
        _esc(kw) + '</button></td>';
      matrices.forEach(function(mat) {
        var checked = !(inclusion[kw] && inclusion[kw][mat] === false);
        html += '<td class="check-cell">' +
          '<input type="checkbox" class="ami-cb"' +
          ' data-analyte="' + _esc(kw) + '"' +
          ' data-matrix-idx="' + matrices.indexOf(mat) + '"' +
          (checked ? ' checked' : '') +
          ' onchange="syncAMIJson()" /></td>';
        if (!checked) {
          html += '';  /* ⚠ shown via CSS :not(:checked) sibling if needed */
        }
      });
      html += '</tr>';
    });

    html += '</tbody></table>';
    gridEl.innerHTML = html;
  }

  function amiColAll(colIdx, state) {
    var rows = document.querySelectorAll('.inclusion-grid tbody tr');
    rows.forEach(function(row) {
      var tds = row.querySelectorAll('td.check-cell');
      var cb = tds[colIdx] && tds[colIdx].querySelector('input[type=checkbox]');
      if (cb) cb.checked = state;
    });
    syncAMIJson();
  }

  function amiRowToggle(rowIdx) {
    var rows = document.querySelectorAll('.inclusion-grid tbody tr');
    var row = rows[rowIdx];
    if (!row) return;
    var cbs = row.querySelectorAll('input[type=checkbox]');
    var anyChecked = Array.prototype.some.call(cbs, function(cb) { return cb.checked; });
    Array.prototype.forEach.call(cbs, function(cb) { cb.checked = !anyChecked; });
    syncAMIJson();
  }

  function syncAMIJson() {
    var cbs = document.querySelectorAll('.ami-cb');
    var gridData;
    try { gridData = JSON.parse(document.getElementById('ami_grid_data').value || '{}'); }
    catch(e) { return; }
    var matrices = gridData.matrices || [];

    var result = {};
    Array.prototype.forEach.call(cbs, function(cb) {
      var a = cb.getAttribute('data-analyte');
      var mi = parseInt(cb.getAttribute('data-matrix-idx'), 10);
      var mat = matrices[mi];
      if (!a || mat === undefined) return;
      if (!result[a]) result[a] = {};
      result[a][mat] = cb.checked;
    });
    document.getElementById('analyte_matrix_inclusion_json').value = JSON.stringify(result);
  }

  document.addEventListener('DOMContentLoaded', function() {
    try {
      var sa = JSON.parse(document.getElementById('salt_adjustment_factors_json').value || '[]');
      sa.forEach(function(r) { addSaltRow(r.analyte, r.factor, r.source || ''); });
    } catch(e) {}
    try {
      var iso = JSON.parse(document.getElementById('isomer_summation_json').value || '[]');
      iso.forEach(function(r) { addIsomerRow(r.linear, r.branched, r.reported, r.enabled !== false); });
    } catch(e) {}
    try {
      var stages = JSON.parse(document.getElementById('extraction_stages_json').value || '[]');
      stages.forEach(function(s) { addStageCard(s); });
    } catch(e) {}
    try {
      var eisEl = document.getElementById('eis_overrides_json');
      if (eisEl) {
        var eis = JSON.parse(eisEl.value || '[]');
        eis.forEach(function(r) { addEisRow(r.analyte, r.recovery_min, r.recovery_max); });
      }
    } catch(e) {}
    buildRecoveryTiersGrid();
    buildSurrogateGrid();
    buildAMIGrid();
  });

  document.querySelector('form').addEventListener('submit', function() {
    syncSaltJson(); syncIsomerJson(); syncStageJson(); syncEisJson();
    syncRecoveryTiersJson(); syncSurrogateJson(); syncAMIJson();
  });
  </script>

  </div><!-- /content slot -->
</body>
</html>
