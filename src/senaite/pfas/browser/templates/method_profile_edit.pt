<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title"
         tal:content="view/display_name">Method Profile</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
    /* ── Method profile editor ────────────────────────────────────────── */
    .tab-pane         { display: none; }
    .tab-pane.active  { display: block; }

    .page-body { max-width: 900px; }

    .json-area { width: 100%; min-height: 160px; font-family: "Fira Code", monospace;
                 font-size: 12px; padding: 8px; border: 1px solid var(--s-input-border);
                 border-radius: 4px; background: #fafafa; resize: vertical; }
    .json-area:focus { outline: none; border-color: var(--s-primary);
                       box-shadow: 0 0 0 3px var(--s-focus-ring); }
    /* Descriptive hint text uses the SYSTEM font (was monospace — the source
       of the cross-page font inconsistency). Inline field names use <code>. */
    .json-hint { font-size: 11px; color: var(--s-secondary); margin-top: 4px;
                 line-height: 1.5; }
    .json-hint code { font-family: "Fira Code", monospace; }
    /* Prose intro/description text — system sans-serif, NOT monospace.
       Use for tab descriptions (json-hint is for JSON-field hints only). */
    .pane-intro { font-size: 12px; color: var(--s-secondary); line-height: 1.5;
                  max-width: 760px; margin: 0 0 14px; }
    .pane-intro code { font-family: "Fira Code", monospace; font-size: 11px; }

    /* Pill toggle switch (ported from the original QC Rules page) */
    .toggle-switch { position: relative; display: inline-block;
                     width: 38px; height: 22px; cursor: pointer; margin: 0; vertical-align: middle; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; position: absolute; }
    .toggle-track { position: absolute; top: 0; left: 0; right: 0; bottom: 0;
                    background: var(--s-input-border); border-radius: 22px; transition: background .15s; }
    .toggle-track::before { content: ""; position: absolute; width: 16px; height: 16px;
                             left: 3px; bottom: 3px; background: #fff; border-radius: 50%;
                             transition: transform .15s; box-shadow: 0 1px 3px rgba(0,0,0,.25); }
    .toggle-switch input:checked + .toggle-track { background: var(--s-primary); }
    .toggle-switch input:checked + .toggle-track::before { transform: translateX(16px); }
    .toggle-switch input:focus + .toggle-track { box-shadow: 0 0 0 3px var(--s-focus-ring); }
    /* Param inputs grey out when their rule is toggled off */
    .rule-params.rule-off input { background: var(--s-light); color: var(--s-secondary);
                                  opacity: .55; }
    .rule-params.rule-off label { color: var(--s-secondary); opacity: .7; }

    .factor-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 10px; }
    .factor-table th { background: var(--s-light); color: var(--s-secondary);
                       font-size: 11px; font-weight: 700; text-transform: uppercase;
                       letter-spacing: .04em; padding: 7px 10px;
                       border-bottom: 2px solid var(--s-border); text-align: left; }
    .factor-table td { padding: 5px 6px; border-bottom: 1px solid var(--s-border); vertical-align: middle; }
    .factor-table tr:last-child td { border-bottom: none; }
    .factor-table input[type=text],
    .factor-table input[type=number] { padding: 5px 8px; border: 1px solid var(--s-input-border);
                                        border-radius: 4px; font-size: 13px; background: #fafafa;
                                        color: var(--s-input-text); width: 100%; }
    .factor-table input:focus { outline: none; border-color: var(--s-primary);
                                 box-shadow: 0 0 0 2px var(--s-focus-ring); }
    .factor-table .del-btn { background: none; border: none; cursor: pointer; color: var(--s-danger);
                              font-size: 16px; padding: 2px 6px; line-height: 1; }
    .factor-table .del-btn:hover { opacity: .75; }
    .btn-add-row { background: none; border: 1px solid var(--s-primary);
                   color: var(--s-primary); border-radius: 4px;
                   padding: 6px 14px; cursor: pointer; font-size: 12px; font-weight: 600; }
    .btn-add-row:hover { background: var(--s-primary-lt); }

    .stage-card { border: 1px solid var(--s-border); border-radius: 6px; margin-bottom: 10px;
                  background: #fff; }
    .stage-card.dragging { opacity: .4; }
    .stage-card-hdr { display: flex; align-items: center; gap: 8px; padding: 8px 12px;
                      background: var(--s-light); border-radius: 6px 6px 0 0;
                      border-bottom: 1px solid var(--s-border); }
    .stage-card-hdr .drag-handle { cursor: grab; color: var(--s-secondary); font-size: 16px;
                                    user-select: none; flex-shrink: 0; }
    .stage-card-hdr .stage-card-title { flex: 1; font-size: 13px; font-weight: 600;
                                         color: var(--s-primary); }
    .stage-card-hdr .del-btn { background: none; border: none; cursor: pointer;
                                color: var(--s-danger); font-size: 16px; line-height: 1; padding: 0 4px; }
    .stage-card-body { padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
    .stage-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end; }
    .stage-row label { display: flex; flex-direction: column; gap: 3px;
                       font-size: 11px; font-weight: 600; color: var(--s-secondary); }
    .stage-row label input[type=text],
    .stage-row label input[type=number] { padding: 5px 8px; border: 1px solid var(--s-input-border);
                                           border-radius: 4px; font-size: 13px;
                                           font-family: inherit; background: #fff; }
    .stage-row label input:focus { outline: none; border-color: var(--s-primary); }
    .cb-label { flex-direction: row !important; align-items: center !important; gap: 6px !important;
                font-size: 13px !important; font-weight: 500 !important; color: var(--s-text) !important;
                cursor: pointer; }
    .cb-label input[type=checkbox] { width: 15px; height: 15px; cursor: pointer; }

    .pa-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .pa-table th { background: var(--s-light); padding: 6px 8px; text-align: left;
                   border-bottom: 2px solid var(--s-border); font-size: 11px; font-weight: 700;
                   text-transform: uppercase; letter-spacing: .04em; color: var(--s-secondary);
                   white-space: nowrap; }
    .pa-table td { padding: 4px 6px; border-bottom: 1px solid var(--s-border); vertical-align: middle; }
    .pa-table tr:hover td { background: var(--s-light); }
    .pa-table .pa-name { font-family: "Fira Code", monospace; font-size: 12px; white-space: nowrap; }
    .pa-table input[type=text] { width: 100%; box-sizing: border-box; padding: 3px 5px;
                                  border: 1px solid var(--s-border); border-radius: 3px;
                                  font-size: 11px; font-family: inherit; }
    .pa-table input[type=text].pa-mono { font-family: "Fira Code", monospace; }
    .pa-table select { padding: 3px 5px; border: 1px solid var(--s-border); border-radius: 3px;
                       font-size: 11px; background: #fff; }
    .pa-table input[type=checkbox] { width: 15px; height: 15px; cursor: pointer; }
    .pa-tier-1 { color: var(--s-primary); font-weight: 600; }
    .pa-tier-3 { color: var(--s-secondary); font-style: italic; }

    .inclusion-wrap { overflow-x: auto; margin-bottom: 8px; }
    /* Mobile: wide data tables scroll inside their section instead of
       bleeding past the card border (consistent with .table-wrap). */
    .section-body { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .tab-pane .factor-table, .tab-pane .pfas-table { max-width: 100%; }
    .inclusion-grid { border-collapse: collapse; font-size: 12px; }
    .inclusion-grid th { background: var(--s-light); padding: 5px 10px;
                         border-bottom: 2px solid var(--s-border); text-align: center;
                         font-size: 11px; font-weight: 700; text-transform: uppercase;
                         letter-spacing: .04em; color: var(--s-secondary); white-space: nowrap; }
    .inclusion-grid th.analyte-col { text-align: left; min-width: 130px; padding-left: 6px; }
    .inclusion-grid td { padding: 3px 8px; border-bottom: 1px solid var(--s-border); }
    .inclusion-grid td.analyte-name { font-size: 12px; font-family: "Fira Code", monospace;
                                       color: var(--s-text); white-space: nowrap; }
    .inclusion-grid td.check-cell { text-align: center; min-width: 90px; }
    .inclusion-grid input[type=checkbox] { width: 16px; height: 16px; cursor: pointer; }
    .inclusion-grid tr:last-child td { border-bottom: none; }
    .inclusion-grid tr:hover td { background: var(--s-primary-lt, #f0f4ff); }
    .ami-bulk-btn { background: none; border: 1px solid var(--s-border); border-radius: 3px;
                    cursor: pointer; font-size: 11px; padding: 1px 5px; margin: 0 2px;
                    color: var(--s-secondary); line-height: 1.4; }
    .ami-bulk-btn:hover { border-color: var(--s-primary); color: var(--s-primary); }
    .ami-col-ctrl { display: block; margin-top: 4px; }
    .ami-row-btn { background: none; border: none; cursor: pointer; padding: 0;
                   color: var(--s-text); font-family: "Fira Code", monospace; font-size: 12px;
                   text-align: left; width: 100%; }
    .ami-row-btn:hover { color: var(--s-primary); text-decoration: underline; }
    .ami-excluded { color: var(--s-danger, #c0392b); font-size: 11px; display: block; }

    .section-group-hdr { padding: 7px 14px; background: var(--s-light);
                         border: 1px solid var(--s-border); border-radius: 4px;
                         font-size: 10px; font-weight: 700; letter-spacing: .1em;
                         text-transform: uppercase; color: var(--s-secondary);
                         margin: 22px 0 8px 0; }

    .factor-table select, .sur-map-sel { padding: 4px 6px; border: 1px solid var(--s-input-border);
                                          border-radius: 4px; font-size: 12px; background: #fafafa;
                                          color: var(--s-input-text); width: 100%; }

    .spike-matrix-section { border: 1px solid var(--s-border); border-radius: 6px;
                             margin-bottom: 12px; background: #fff; overflow: hidden; }
    .spike-matrix-hdr { padding: 7px 12px; background: var(--s-light);
                        border-bottom: 1px solid var(--s-border);
                        font-size: 12px; font-weight: 700; color: var(--s-primary); }

    .tier-card { border: 1px solid var(--s-border); border-radius: 6px; margin-bottom: 10px; background: #fff; }
    .tier-card-hdr { display: flex; align-items: center; gap: 8px; padding: 7px 12px;
                     background: var(--s-light); border-radius: 6px 6px 0 0;
                     border-bottom: 1px solid var(--s-border); }
    .tier-badge { flex-shrink: 0; background: var(--s-primary); color: #fff; border-radius: 10px;
                  padding: 1px 8px; font-size: 11px; font-weight: 700; white-space: nowrap; }
    .tier-desc { flex: 1; border: 1px solid transparent; border-radius: 4px; padding: 3px 6px;
                 font-size: 13px; font-family: inherit; background: transparent; color: var(--s-text); }
    .tier-desc:focus { outline: none; border-color: var(--s-primary); background: #fff;
                       box-shadow: 0 0 0 2px var(--s-focus-ring); }
    .tier-card-body { padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
    .tier-limits { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 13px; }
    .tier-limits label { display: flex; align-items: center; gap: 5px; font-weight: 600;
                         font-size: 11px; color: var(--s-secondary); }
    .tier-limits input[type=number] { width: 70px; padding: 4px 6px; border: 1px solid var(--s-input-border);
                                       border-radius: 4px; font-size: 13px; background: #fafafa;
                                       color: var(--s-text); }
    .tier-limits input:focus { outline: none; border-color: var(--s-primary); }
    .tier-chipfield { border-top: 1px dashed var(--s-border); padding-top: 7px; }
    .tier-chipfield > label { font-size: 11px; font-weight: 700; text-transform: uppercase;
                               letter-spacing: .04em; color: var(--s-secondary); display: block;
                               margin-bottom: 5px; }
    .tier-chip-row { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
    .tier-chip { display: inline-flex; align-items: center; gap: 3px; border-radius: 10px;
                 padding: 2px 7px; font-size: 11px; font-family: "Fira Code", monospace;
                 background: #e8f5e9; border: 1px solid #81c784; color: #2e7d32;
                 user-select: none; }
    .tier-chip.mat-chip { background: #fff3e0; border-color: #ffb74d; color: #e65100; }
    .tier-chip.nostd-chip { background: #fce4ec; border-color: #ef9a9a; color: #b71c1c; }
    .tier-chip-rm { background: none; border: none; cursor: pointer; padding: 0 0 0 2px;
                    color: inherit; font-size: 13px; line-height: 1; opacity: .7; }
    .tier-chip-rm:hover { opacity: 1; }
    .tier-add-sel { font-size: 11px; padding: 3px 5px; border: 1px dashed var(--s-border);
                    border-radius: 10px; color: var(--s-secondary); background: #fafafa;
                    cursor: pointer; max-width: 200px; }
    .tier-add-sel:focus { outline: none; border-color: var(--s-primary); }
  </style>
  </tal:styles>
</head>
<body>

  <tal:t metal:fill-slot="header-title"
         tal:content="view/display_name">Method Profile</tal:t>

  <tal:r metal:fill-slot="header-right">
    <span class="header-badge" tal:content="view/method_id">FDA_32PFAS</span>
    <a href="@@pfas-method-profiles" class="back-link">All Methods</a>
  </tal:r>

  <tal:tabs metal:fill-slot="tabs">
    <div class="pfas-tabs" id="method-profile-tabs">
      <a class="pfas-tab" data-pane="pane-toggles" href="#pane-toggles"
         onclick="pfasTabSwitch('pane-toggles'); return false;">Rule Toggles &amp; QC Run</a>
      <a class="pfas-tab" data-pane="pane-qct" href="#pane-qct"
         onclick="pfasTabSwitch('pane-qct'); return false;">QC Types</a>
      <a class="pfas-tab" data-pane="pane-rt" href="#pane-rt"
         onclick="pfasTabSwitch('pane-rt'); return false;">Recovery Tiers</a>
      <a class="pfas-tab" data-pane="pane-mtx" href="#pane-mtx"
         onclick="pfasTabSwitch('pane-mtx'); return false;">Matrices &amp; Units</a>
      <a class="pfas-tab" data-pane="pane-corr" href="#pane-corr"
         onclick="pfasTabSwitch('pane-corr'); return false;">Sample Corrections</a>
      <a class="pfas-tab" data-pane="pane-ami" href="#pane-ami"
         onclick="pfasTabSwitch('pane-ami'); return false;">Analyte &#215; Matrix</a>
      <a class="pfas-tab" data-pane="pane-sur" href="#pane-sur"
         onclick="pfasTabSwitch('pane-sur'); return false;">Surrogate Map</a>
      <a class="pfas-tab" data-pane="pane-eis" href="#pane-eis"
         onclick="pfasTabSwitch('pane-eis'); return false;"
         tal:attributes="style python:'' if view.show_eis_overrides() else 'display:none'">EIS Limits</a>
      <a class="pfas-tab" data-pane="pane-cal" href="#pane-cal"
         onclick="pfasTabSwitch('pane-cal'); return false;">Calibration &amp; CCV</a>
      <a class="pfas-tab" data-pane="pane-lwf" href="#pane-lwf"
         onclick="pfasTabSwitch('pane-lwf'); return false;">Lab Workflow</a>
      <a class="pfas-tab" data-pane="pane-adv" href="#pane-adv"
         onclick="pfasTabSwitch('pane-adv'); return false;">Advanced</a>
    </div>
  </tal:tabs>

  <tal:ab metal:fill-slot="action-bar">
    <div class="pfas-action-bar">
      <button type="submit" form="profile-form" class="btn btn-primary">Save &amp; Export</button>
      <a class="btn btn-secondary" href="@@pfas-method-profiles">Cancel</a>
    </div>
  </tal:ab>

  <div metal:fill-slot="content">

    <div class="alert alert-success" tal:condition="view/saved">
      Profile saved and exported to <code>/data/qc/method_profiles.json</code>.
      The pipeline worker will use the new values on the next batch run.
    </div>
    <div class="alert alert-error" tal:condition="view/error">
      <span tal:content="view/error">Error message</span>
    </div>

    <form id="profile-form" method="POST"
          tal:attributes="action string:@@pfas-method-profile-edit">
      <input type="hidden" name="method_id" tal:attributes="value view/method_id" />
      <!-- marker so a save also writes the qc_rules store (D52); the
           qc_toggles_present marker lives in the QC Types pane below -->
      <input type="hidden" name="qc_rules_present" value="1" />

      <!-- ── Tab: Rule Toggles & QC Run (qc_rules.json, per method) ──────── -->
      <div class="tab-pane" id="pane-toggles">
        <div class="page-body">
          <p class="pane-intro">
            Which QC-engine rules fire for <strong tal:content="view/display_name">this
            method</strong> when the pipeline evaluates a run. Turn a rule off to
            exclude it from automated evaluation; adjust a rule&#8217;s parameters
            inline (blank = inherit the global default). Saved to the QC-engine
            store (<code tal:content="view/qc_rules_path">/data/qc/qc_rules.json</code>),
            read by the pipeline worker.
          </p>
          <div class="table-wrap">
          <table class="factor-table" style="max-width:820px;">
            <thead>
              <tr><th style="width:52px;">On</th><th>Rule</th><th>Parameters</th></tr>
            </thead>
            <tbody>
              <tr tal:repeat="row view/rule_toggle_rows">
                <td style="text-align:center;">
                  <label class="toggle-switch">
                    <input type="checkbox" class="rule-toggle-cb"
                           tal:attributes="name string:ruletoggle.${row/key};
                                           data-rule row/key;
                                           checked python:row['enabled']" />
                    <span class="toggle-track"></span>
                  </label>
                </td>
                <td><strong tal:content="row/label">CCV Recovery</strong></td>
                <td class="rule-params"
                    tal:attributes="data-rule row/key;
                                    class python:'rule-params rule-off' if not row['enabled'] else 'rule-params'">
                  <span tal:condition="not:row/has_params"
                        style="color:var(--s-secondary);font-size:12px;">&#8212;</span>
                  <tal:p tal:repeat="p row/params">
                    <label style="display:inline-flex;align-items:center;gap:5px;
                                  margin:0 12px 4px 0;font-size:12px;">
                      <span tal:content="p/label" style="color:var(--s-secondary);">min</span>
                      <input type="number" step="any" style="width:90px;"
                             tal:attributes="name string:rulelimit.${p/name};
                                             value p/value;
                                             placeholder python:'inherit' if p['inherited'] else ''" />
                    </label>
                  </tal:p>
                </td>
              </tr>
            </tbody>
          </table>
          </div>
        </div>
      </div><!-- /pane-toggles -->

      <!-- ── Tab: Analyte × Matrix ─────────────────────────────────────── -->
      <div class="tab-pane" id="pane-ami">
        <div class="page-body">

          <details open="open">
            <summary>Method Information</summary>
            <div class="section-body">
              <div class="field-grid">
                <div class="field-row field-row-wide">
                  <label for="display_name">Display Name</label>
                  <input type="text" id="display_name" name="display_name"
                         tal:attributes="value view/display_name" />
                </div>
                <div class="field-row field-row-wide">
                  <label for="description">Description</label>
                  <input type="text" id="description" name="description"
                         tal:attributes="value view/description" />
                </div>
              </div>
            </div>
          </details>

          <div class="section-group-hdr">Analyte Configuration</div>

          <details>
            <summary>Analyte &#215; Matrix Inclusion</summary>
            <div class="section-body">
              <div class="alert alert-warn"
                   tal:condition="view/analyte_matrix_needs_verification"
                   style="margin-bottom:12px">
                &#9888; <strong>Lab verification required.</strong>
                The analyte set for this method is seeded from the FDA 32-analyte list
                as a placeholder. Review each row against your purchased method copy
                and uncheck any analytes not reportable under this method before
                production use.
              </div>
              <p style="font-size:12px;color:var(--s-secondary);margin-bottom:10px">
                Each checked cell means the analyte is <strong>reportable</strong> in
                that matrix. Unchecked analytes are excluded from the surrogate map,
                recovery tiers, QC checks, reports, and EDD for that matrix.
                Click an analyte name to toggle its whole row; click &#10003;/&#10007;
                under a matrix column header to check/uncheck the whole column.
              </p>
              <div class="inclusion-wrap">
                <div id="amiGridContainer">
                  <em style="color:var(--s-secondary);font-size:12px">Loading&#8230;</em>
                </div>
              </div>
              <input type="hidden" id="ami_grid_data"
                     tal:attributes="value view/analyte_matrix_grid_data" />
              <input type="hidden" name="analyte_matrix_inclusion_json"
                     id="analyte_matrix_inclusion_json"
                     tal:attributes="value view/analyte_matrix_json" />
            </div>
          </details>

          <details>
            <summary>Per-Analyte Assignments</summary>
            <div class="section-body">
              <p style="font-size:12px;color:var(--s-secondary);margin-bottom:10px">
                <strong>No IS</strong> &#8212; analyte has no labeled IS; its tier is controlled
                entirely by the Recovery Tiers No-Std list.
                <strong>Confirm Ion</strong> &#8212; qualifier MRM transition (precursor&#62;product,
                e.g. 413.04&#62;369.00). Surrogate IS assignment is in the Surrogate Map tab.
              </p>
              <div style="overflow-x:auto">
                <table class="pa-table">
                  <thead>
                    <tr>
                      <th style="min-width:120px">Analyte</th>
                      <th style="width:65px;text-align:center">No IS</th>
                      <th style="min-width:150px">Confirm Ion (m/z)</th>
                      <th>Notes</th>
                    </tr>
                  </thead>
                  <tbody id="perAnalyteBody"></tbody>
                </table>
              </div>
              <input type="hidden" name="per_analyte_json" id="per_analyte_json"
                     tal:attributes="value view/per_analyte_json" />
            </div>
          </details>

          <details>
            <summary>Isomer Summation (linear + branched &#8594; reported analyte)</summary>
            <div class="section-body">
              <p class="json-hint">
                Define which linear/branched instrument peaks sum into a single reported analyte.
                Summation applied BEFORE salt and matrix adjustment factors.
              </p>
              <table class="factor-table" id="isomerTable">
                <thead>
                  <tr>
                    <th style="width:25%">Linear peak</th>
                    <th style="width:25%">Branched peak</th>
                    <th style="width:25%">Reported as</th>
                    <th style="width:60px;text-align:center">Active</th>
                    <th style="width:36px"></th>
                  </tr>
                </thead>
                <tbody id="isomerBody"></tbody>
              </table>
              <button type="button" class="btn-add-row" onclick="addIsomerRow()">+ Add pair</button>
              <input type="hidden" name="isomer_summation_json" id="isomer_summation_json"
                     tal:attributes="value view/isomer_summation_json" />
            </div>
          </details>

        </div>
      </div><!-- /pane-ami -->

      <!-- ── Tab: Surrogate Map ─────────────────────────────────────────── -->
      <div class="tab-pane" id="pane-sur">
        <div class="page-body">

          <details open="open">
            <summary>Surrogate Map (native analyte &#8594; quantifying surrogate)</summary>
            <div class="section-body">
              <style>
                .sur-tag { font-size:10px; padding:1px 7px; border-radius:8px; font-weight:700;
                           display:inline-block; text-decoration:none; }
                .sur-default { background:#e8f4f8; color:#387493; }
                .sur-override { background:#fff3cd; color:#856404; }
                .sur-core { background:#d4edda; color:#155724; margin-left:4px; }
                .sur-nocore { background:#f8d7da; color:#721c24; margin-left:4px; }
              </style>
              <div class="field-grid" style="margin-bottom:14px">
                <div class="field-row">
                  <label for="surrogate_is">Injection IS</label>
                  <div class="field-sublabel">
                    The single IS all surrogate recoveries quantify against
                    (core service, pfas_role=injection_is &#8212; e.g. M4PFOA).
                    Pre-filled from the derived default.
                  </div>
                  <input type="text" id="surrogate_is" name="surrogate_is"
                         tal:attributes="value view/surrogate_is" />
                </div>
              </div>
              <p class="pane-intro">
                Each native is pre-assigned its labeled surrogate from the
                single-source native&#8594;surrogate map; the dropdown shows only
                <strong>this method&#8217;s surrogates</strong> (derived from its
                analyte set), not the global pool. <span class="sur-tag sur-default">default</span>
                = from the master map; <span class="sur-tag sur-override">override</span>
                = reassigned here; <span class="sur-tag sur-core">&#128279; core</span>
                links the surrogate&#8217;s core AnalysisService (pfas_role);
                <span class="sur-tag sur-nocore">&#9888; not in core</span> flags a
                surrogate with no marked core service.
              </p>
              <table class="factor-table" id="surMapTable">
                <thead>
                  <tr>
                    <th style="width:40%">Native Analyte</th>
                    <th style="width:35%">Quantifying Surrogate</th>
                    <th style="width:25%">Source / Core</th>
                  </tr>
                </thead>
                <tbody id="surMapBody"></tbody>
              </table>
              <input type="hidden" name="surrogate_map_json" id="surrogate_map_json"
                     tal:attributes="value view/surrogate_map_json" />
              <input type="hidden" id="surrogate_is_data"
                     tal:attributes="value view/surrogate_is_data" />
            </div>
          </details>

        </div>
      
          <details>
            <summary>Surrogate &#8594; Injection Internal Standard</summary>
            <div class="section-body">
              <p class="json-hint">
                The second half of the quantification chain: native &#8594;
                surrogate (above) &#8594; injection internal standard. A
                <strong>surrogate</strong> is added before extraction, so it is
                diluted along with the sample; the <strong>injection
                standard</strong> is added at reconstitution, after any
                dilution, so its response must not be scaled. Getting this
                backwards makes a dilution&#8217;s surrogates look like
                recovery failures. Under FDA 32-PFAS every surrogate quantifies
                against 13C4-PFOA.
              </p>
              <input type="hidden" name="surrogate_chain_present" value="1" />
              <table class="factor-table">
                <thead>
                  <tr>
                    <th style="width:50%">Surrogate</th>
                    <th style="width:50%">Quantified against</th>
                  </tr>
                </thead>
                <tbody tal:define="opts view/injection_is_options">
                  <tr tal:repeat="row view/surrogate_chain_rows">
                    <td>
                      <span tal:content="row/surrogate"
                            style="font-family:'Fira Code',monospace;font-size:12px;">M8PFOA</span>
                    </td>
                    <td>
                      <select style="width:100%;"
                              tal:attributes="name string:surchain.${row/surrogate}">
                        <option value="">&#8212; not set &#8212;</option>
                        <option tal:repeat="o opts"
                                tal:attributes="value o;
                                                selected python:o == row['injection_is']"
                                tal:content="o">M4PFOA</option>
                      </select>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </details>

</div><!-- /pane-sur -->

      <!-- ── Tab: Recovery Tiers ────────────────────────────────────────── -->
      <div class="tab-pane" id="pane-rt">
        <div class="page-body">

          <div class="section-group-hdr">Spike QC Criteria (LFSM / LFB)</div>
          <p class="pane-intro">
            Spike-based QC is configured here in one place: the spike amounts
            per matrix and the recovery acceptance windows applied to them.
          </p>

          <details open="open">
            <summary>Spike Levels (LFB / LFSM) by Matrix</summary>
            <div class="section-body">
              <p style="font-size:12px;color:var(--s-secondary);margin-bottom:10px">
                Set the spike concentration (ppt) for each level and matrix.
                LFSMD uses the same levels as LFSM.
                The pipeline matches injection names (e.g.
                <em>"; LFSM High"</em> &#8594; label &#8220;High&#8221; &#8594; ppt here)
                for the batch matrix.
                <strong>Enter actual spike amounts before running QC.</strong>
              </p>
              <div id="spikeLevelsContainer"></div>
              <input type="hidden" name="spike_levels_json" id="spike_levels_json"
                     tal:attributes="value view/spike_levels_json" />
              <input type="hidden" id="associated_qc_types_json"
                     tal:attributes="value view/associated_qc_types_json" />
            </div>
          </details>

          <details>
            <summary>Recovery Acceptance (LFSM / LFB / LCS)</summary>
            <div class="section-body">
              <p style="font-size:12px;color:var(--s-secondary);margin-bottom:10px">
                The recovery windows applied to the spike QC above. Each tier
                card sets the recovery window (min/max %) and optional RSD limit.
                <strong>Key Analytes</strong> &#8212; analytes subject to this tier&#39;s stricter limits.
                <strong>Tight Matrices</strong> &#8212; if set, this tier only applies in those matrices.
                <strong>No-Std Analytes</strong> &#8212; analytes that always fall to this tier (no labeled IS).
                Leave all three pickers empty for a catch-all default tier.
              </p>
              <div id="recoveryTiersContainer"></div>
              <button type="button" class="btn-add-row" style="margin-top:4px"
                      onclick="addRecoveryTier()">+ Add Tier</button>
              <input type="hidden" name="recovery_tiers_json" id="recovery_tiers_json"
                     tal:attributes="value view/recovery_tiers_json" />
            </div>
          </details>

          <div class="section-group-hdr">Sample Duplicate (Dup)</div>
          <details open="open">
            <summary>Sample Duplicate RPD</summary>
            <div class="section-body">
              <p style="font-size:12px;color:var(--s-secondary);margin-bottom:10px">
                Precision check on a field sample run in duplicate: the maximum
                Relative Percent Difference between the two results.
                RPD&nbsp;=&nbsp;|A&nbsp;&#8722;&nbsp;B|&nbsp;/&nbsp;((A+B)/2)&nbsp;&#215;&nbsp;100.
                Drives the <code>Dup</code> QC type in the pipeline
                (qc_acceptance.Dup). Enable/disable it on the
                <strong>QC&nbsp;Types</strong> tab.
              </p>
              <div class="field-grid">
                <div class="field-row">
                  <label for="dup_rpd_max">Max RPD %</label>
                  <input type="number" id="dup_rpd_max" name="dup_rpd_max"
                         step="0.1" min="0"
                         tal:attributes="value view/dup_rpd" />
                  <span class="hint">20 for FDA; 30 for EPA methods</span>
                </div>
              </div>
            </div>
          </details>

        </div>
      </div><!-- /pane-rt -->

      <!-- ── Tab: Sample Corrections (per-method, applied to ALL samples) ── -->
      <div class="tab-pane" id="pane-mtx">
        <div class="page-body">
          <p class="pane-intro">
            Which matrices this method supports, and everything the engine
            decides <strong>from the matrix</strong>. All four of these were
            read by the QC engine and writable by nobody &#8212; seeded in code,
            or in the case of the aliases, written by nothing at all.
          </p>

          <details open="open">
            <summary>Matrices, Recovery Tier, Aliases and Reporting Units</summary>
            <div class="section-body">
              <p class="json-hint">
                <strong>Tier&nbsp;1</strong> marks the matrices where the key
                analytes (PFOS, PFOA, PFHxS, PFNA) are held to the tighter
                80&ndash;120% recovery window instead of 65&ndash;135%. Ticking
                the wrong box changes pass/fail on a certificate.<br />
                <strong>Aliases</strong> are the other names a sample may
                arrive under, comma-separated. Matching used to be a substring
                test, so &#8220;deer muscle&#8221; matched no title and silently
                dropped from tier&nbsp;1 to tier&nbsp;2 &#8212; list it here
                instead.<br />
                <strong>Unit</strong> is the reporting unit for this method
                &#215; matrix.<br />
                Clear a matrix&#8217;s name to remove it. Blank rows at the
                bottom add new matrices.
              </p>
              <input type="hidden" name="matrix_settings_present" value="1" />
              <table class="factor-table" id="matrixSettingsTable">
                <thead>
                  <tr>
                    <th style="width:24%">Matrix</th>
                    <th style="width:10%">Tier&nbsp;1</th>
                    <th style="width:44%">Aliases (comma-separated)</th>
                    <th style="width:22%">Reporting Unit</th>
                  </tr>
                </thead>
                <tbody tal:define="units view/unit_options">
                  <tal:rows repeat="row view/matrix_settings_rows">
                    <tr>
                      <td>
                        <input type="text" style="width:100%;"
                               tal:attributes="name string:mtx_name.${repeat/row/index};
                                               value row/matrix" />
                      </td>
                      <td style="text-align:center;">
                        <input type="checkbox" value="1"
                               tal:attributes="name string:mtx_tight.${repeat/row/index};
                                               checked python:row['tight']" />
                      </td>
                      <td>
                        <input type="text" style="width:100%;"
                               placeholder="deer muscle, venison, beef"
                               tal:attributes="name string:mtx_aliases.${repeat/row/index};
                                               value row/aliases" />
                      </td>
                      <td>
                        <select style="width:100%;"
                                tal:attributes="name string:mtx_unit.${repeat/row/index}">
                          <option value="">&#8212; none &#8212;</option>
                          <option tal:repeat="u units"
                                  tal:attributes="value u;
                                                  selected python:u == row['unit']"
                                  tal:content="u">ng/kg</option>
                        </select>
                      </td>
                    </tr>
                  </tal:rows>
                  <tal:blank repeat="n python:range(3)">
                    <tr tal:define="idx python:len(view.matrix_settings_rows()) + n">
                      <td>
                        <input type="text" style="width:100%;"
                               placeholder="new matrix"
                               tal:attributes="name string:mtx_name.${idx}" />
                      </td>
                      <td style="text-align:center;">
                        <input type="checkbox" value="1"
                               tal:attributes="name string:mtx_tight.${idx}" />
                      </td>
                      <td>
                        <input type="text" style="width:100%;"
                               tal:attributes="name string:mtx_aliases.${idx}" />
                      </td>
                      <td>
                        <select style="width:100%;"
                                tal:attributes="name string:mtx_unit.${idx}">
                          <option value="">&#8212; none &#8212;</option>
                          <option tal:repeat="u units"
                                  tal:attributes="value u" tal:content="u">ng/kg</option>
                        </select>
                      </td>
                    </tr>
                  </tal:blank>
                </tbody>
              </table>
            </div>
          </details>
        </div>
      </div>

      <div class="tab-pane" id="pane-corr">
        <div class="page-body">
          <p class="pane-intro">
            Concentration corrections applied to <strong>every sample</strong>
            for this method &#8212; not just QC. These are core method
            corrections (like the reported-value formula), independent of the
            QC engine.
          </p>

          <details open="open">
            <summary>Salt Adjustment Factors (per analyte, from CoA)</summary>
            <div class="section-body">
              <p class="json-hint">
                Molar-mass correction for standards supplied as salts.
                Factor = (M.W. free acid) / (M.W. salt form); default
                <strong>1.0</strong> (no correction). Every analyte is listed.
                The factor seldom changes, but the <strong>CoA lot</strong>
                updates with each new standard lot &#8212; pick it from the
                reagent inventory so the salt correction traces to a specific
                reference-standard lot (golden rule&nbsp;#6).
              </p>
              <input type="hidden" name="salt_present" value="1" />
              <table class="factor-table" id="saltAdjTable">
                <thead>
                  <tr>
                    <th style="width:38%">Analyte</th>
                    <th style="width:18%">Factor</th>
                    <th style="width:44%">CoA Lot (standard / reference material)</th>
                  </tr>
                </thead>
                <tbody tal:define="lots view/standard_lot_options">
                  <tr tal:repeat="row view/salt_adjustment_rows">
                    <td>
                      <span tal:content="row/label"
                            style="font-family:'Fira Code',monospace;font-size:12px;">PFOS</span>
                    </td>
                    <td>
                      <input type="number" step="0.0001" min="0" max="1"
                             style="width:100px;"
                             tal:attributes="name string:salt_factor.${row/analyte};
                                             value row/factor" />
                    </td>
                    <td>
                      <select tal:attributes="name string:salt_lot.${row/analyte}"
                              style="max-width:100%;">
                        <option value="">&#8212; no linked lot &#8212;</option>
                        <option tal:repeat="lot lots"
                                tal:attributes="value lot/uid;
                                                selected python:lot['uid'] == row['lot_uid'];
                                                style python:'color:#a33' if lot['expired'] else ''"
                                tal:content="lot/label">Std — lot 123</option>
                      </select>
                    </td>
                  </tr>
                  <tr tal:condition="not:view/salt_adjustment_rows">
                    <td colspan="3" style="color:var(--s-secondary);font-size:12px;">
                      No analytes in this method&#8217;s master set yet &#8212;
                      configure the Analyte&nbsp;&#215;&nbsp;Matrix tab first.
                    </td>
                  </tr>
                </tbody>
              </table>
              <p tal:condition="not:view/standard_lot_options"
                 style="font-size:11px;color:#856404;margin-top:8px;">
                No <strong>Standard / Reference Material</strong> lots are in the
                Reagent Inventory yet, so the CoA-lot dropdown is empty. Add your
                reference-standard lots there to enable traceability linking.
              </p>
            </div>
          </details>

          <details open="open">
            <summary>Matrix Adjustment Factors (per sample type)</summary>
            <div class="section-body">
              <p class="json-hint">
                C<sub>reported</sub> = C<sub>instrument</sub> &#215; factor;
                default <strong>1.0</strong> (no correction). One row per matrix
                in this method&#8217;s <strong>Analyte&nbsp;&#215;&nbsp;Matrix</strong>
                map &#8212; each tied to a SENAITE core <strong>Sample Type</strong>
                (single source of truth, golden rule&nbsp;#3). Applied to every
                sample of that type.
              </p>
              <input type="hidden" name="matrix_present" value="1" />
              <table class="factor-table" id="matrixFactorsTable">
                <thead>
                  <tr>
                    <th style="width:55%">Sample Type (core)</th>
                    <th style="width:25%">Factor</th>
                    <th style="width:20%"></th>
                  </tr>
                </thead>
                <tbody>
                  <tr tal:repeat="row view/matrix_adjustment_rows">
                    <td tal:content="row/matrix">Meat / Muscle</td>
                    <td>
                      <input type="number" step="0.0001" min="0" style="width:110px;"
                             tal:attributes="name string:matrix_factor.${row/matrix};
                                             value row/factor" />
                    </td>
                    <td>
                      <span tal:condition="row/linked"
                            style="font-size:11px;background:#e8f4f8;color:#387493;padding:2px 8px;border-radius:8px;">&#128279; core type</span>
                      <span tal:condition="not:row/linked"
                            style="font-size:11px;color:#a33;"
                            title="No matrix_uid_map entry ties this matrix to a core SampleType">&#9888; unlinked</span>
                    </td>
                  </tr>
                  <tr tal:condition="not:view/matrix_adjustment_rows">
                    <td colspan="3" style="color:var(--s-secondary);font-size:12px;">
                      No matrices in this method&#8217;s Analyte&nbsp;&#215;&nbsp;Matrix
                      map yet &#8212; configure that tab first.
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </details>

        </div>
      </div><!-- /pane-corr -->

      <!-- ── Tab: EIS Limits ────────────────────────────────────────────── -->
      <div class="tab-pane" id="pane-eis">
        <div class="page-body">
          <tal:eis tal:condition="view/show_eis_overrides">
            <details>
              <summary>EIS Recovery Overrides
                <span style="font-size:11px;color:var(--s-secondary);font-weight:400">(EPA 1633A only)</span>
              </summary>
              <div class="section-body">
                <div class="alert alert-warn" style="margin-bottom:10px">
                  &#9888; <strong>Lab verification required.</strong>
                  Per-analyte EIS/OPR recovery limits from EPA 1633A Tables 6 and 8
                  (EPA 820-R-24-007, December 2024). Verify each value against your
                  purchased method copy before production use.
                </div>
                <table class="factor-table" id="eisOverrideTable">
                  <thead>
                    <tr>
                      <th>EIS / Surrogate Analyte</th>
                      <th>Recovery Min (%)</th>
                      <th>Recovery Max (%)</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody id="eisOverrideBody"></tbody>
                </table>
                <button type="button" class="btn-add-row" onclick="addEisRow()">+ Add row</button>
                <input type="hidden" name="eis_overrides_json" id="eis_overrides_json"
                       tal:attributes="value view/eis_overrides_json" />
              </div>
            </details>

            <details>
              <summary>EIS Recovery Limits per Matrix Class
                <span style="font-size:11px;color:var(--s-secondary);font-weight:400">(EPA 1633A only)</span>
              </summary>
              <div class="section-body">
                <p class="json-hint">
                  1633A publishes EIS recovery limits per matrix CLASS, not per
                  matrix title &#8212; Sediment and Soil are both
                  <em>solid</em>. A limit set here overrides the per-analyte
                  limit above for that class. Clear an analyte name to remove
                  the row; the blank rows at the end of each class add new ones.
                </p>
                <input type="hidden" name="eis_matrix_present" value="1" />
                <tal:group repeat="grp view/eis_matrix_rows">
                  <h4 style="margin:14px 0 6px;font-size:13px;"
                      tal:content="string:${grp/label} (${grp/count})">Solid</h4>
                  <table class="factor-table">
                    <thead>
                      <tr>
                        <th style="width:50%">EIS / Surrogate Analyte</th>
                        <th style="width:25%">Recovery Min (%)</th>
                        <th style="width:25%">Recovery Max (%)</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr tal:repeat="row grp/rows">
                        <td>
                          <input type="text" style="width:100%;"
                                 tal:attributes="name string:eismtx.${grp/key}.${repeat/row/index}.analyte;
                                                 value row/analyte" />
                        </td>
                        <td>
                          <input type="number" step="0.1" style="width:100%;"
                                 tal:attributes="name string:eismtx.${grp/key}.${repeat/row/index}.min;
                                                 value row/recovery_min" />
                        </td>
                        <td>
                          <input type="number" step="0.1" style="width:100%;"
                                 tal:attributes="name string:eismtx.${grp/key}.${repeat/row/index}.max;
                                                 value row/recovery_max" />
                        </td>
                      </tr>
                      <tal:blank repeat="n python:range(2)">
                        <tr tal:define="idx python:grp['blank_start'] + n">
                          <td>
                            <input type="text" style="width:100%;"
                                   placeholder="new analyte"
                                   tal:attributes="name string:eismtx.${grp/key}.${idx}.analyte" />
                          </td>
                          <td>
                            <input type="number" step="0.1" style="width:100%;"
                                   tal:attributes="name string:eismtx.${grp/key}.${idx}.min" />
                          </td>
                          <td>
                            <input type="number" step="0.1" style="width:100%;"
                                   tal:attributes="name string:eismtx.${grp/key}.${idx}.max" />
                          </td>
                        </tr>
                      </tal:blank>
                    </tbody>
                  </table>
                </tal:group>
              </div>
            </details>
          </tal:eis>
        </div>
      </div><!-- /pane-eis -->

      <!-- ── Tab: Calibration ───────────────────────────────────────────── -->
      <div class="tab-pane" id="pane-cal">
        <div class="page-body">
          <div style="background:var(--s-primary-lt);border:1px solid #bee5eb;border-radius:8px;
                      padding:9px 14px;font-size:12px;color:#0c5460;margin-bottom:14px;">
            These tabs (Calibration / CCV / IS Response) hold THIS METHOD&#8217;s
            instrument-verification <strong>acceptance parameters</strong>
            (exported with the profile). Whether each engine <em>rule</em> is
            switched on per method is governed globally in
            <a tal:attributes="href string:${view/portal_url}/@@pfas-qc-rules">QC Rules</a>.
          </div>

          <div class="section-group-hdr">Instrument QC Criteria</div>
          <div class="alert alert-info" style="font-size:12px;margin-bottom:10px;">
            &#8505; QC types (MB, LFB, LFSMD, etc.) must be <strong>enabled</strong> in
            the <a tal:attributes="href string:${view/portal_url}/@@pfas-qc-type-grid"
                   style="color:var(--s-primary);">QC Type Grid</a>
            before the criteria below take effect for this method.
          </div>

          <details>
            <summary>Calibration</summary>
            <div class="section-body">
              <div class="field-grid">
                <div class="field-row">
                  <label for="cal_r2_min">R&#178; Minimum</label>
                  <input type="number" id="cal_r2_min" name="cal_r2_min"
                         step="0.001" min="0.900" max="1.000"
                         tal:attributes="value python:view.cal().get('r2_min', 0.990)" />
                  <span class="hint">e.g. 0.990 (FDA) or 0.995 (generic)</span>
                </div>
                <div class="field-row">
                  <label for="cal_point_pct_dev_max">Point % Deviation Max</label>
                  <input type="number" id="cal_point_pct_dev_max" name="cal_point_pct_dev_max"
                         step="0.1" min="0"
                         tal:attributes="value python:view.cal().get('point_pct_dev_max', '')" />
                  <span class="hint">Each cal point must be within &#177;N% of curve. Leave blank for no limit.</span>
                </div>
                <div class="field-row">
                  <label for="cal_low_point_pct_dev_max">Low-Level Point % Dev Max</label>
                  <input type="number" id="cal_low_point_pct_dev_max" name="cal_low_point_pct_dev_max"
                         step="0.1" min="0"
                         tal:attributes="value python:view.cal().get('low_point_pct_dev_max') or ''" />
                  <span class="hint">Wider limit for lowest calibration level (e.g. 50 for EPA 537.1).</span>
                </div>
                <div class="field-row">
                  <div class="check-row">
                    <input type="checkbox" id="cal_force_origin" name="cal_force_origin"
                           tal:attributes="checked python:'checked' if view.cal().get('force_origin') else None" />
                    <label for="cal_force_origin">Force through origin</label>
                  </div>
                  <span class="hint">Required by EPA 537.1 IS calibration technique</span>
                </div>
              </div>
            </div>
          </details>

          <details>
            <summary>Chromatographic Confirmation &amp; Signal Quality</summary>
            <div class="section-body">
              <div class="field-grid">
                <div class="field-row">
                  <label for="conf_ion_ratio_tol_pct">Ion Ratio Tolerance &#177; %</label>
                  <input type="number" id="conf_ion_ratio_tol_pct" name="conf_ion_ratio_tol_pct"
                         step="0.1" min="0"
                         tal:attributes="value python:view.confirmation().get('ion_ratio_tol_pct') or ''" />
                  <span class="hint">30 for FDA; 50 for EPA 1633A; blank for 537.1 (no criterion)</span>
                </div>
                <div class="field-row">
                  <label for="conf_rrt_tol_pct">Relative RT Tolerance %</label>
                  <input type="number" id="conf_rrt_tol_pct" name="conf_rrt_tol_pct"
                         step="0.1" min="0"
                         tal:attributes="value python:view.confirmation().get('rrt_tol_pct') or ''" />
                  <span class="hint">1.0 for FDA (RRT &#177;1% of standard RT).</span>
                </div>
                <div class="field-row">
                  <label for="conf_rt_tol_abs_min">Absolute RT Tolerance (min)</label>
                  <input type="number" id="conf_rt_tol_abs_min" name="conf_rt_tol_abs_min"
                         step="0.01" min="0"
                         tal:attributes="value python:view.confirmation().get('rt_tol_abs_min') or ''" />
                  <span class="hint">0.05 for EPA 537.1.</span>
                </div>
                <div class="field-row">
                  <label for="conf_sn_quan_min">S/N Min &#8212; Quantitation Ion</label>
                  <input type="number" id="conf_sn_quan_min" name="conf_sn_quan_min"
                         step="0.1" min="0"
                         tal:attributes="value python:view.confirmation().get('sn_quan_min', 3.0)" />
                </div>
                <div class="field-row">
                  <label for="conf_sn_confirm_min">S/N Min &#8212; Confirm Ion (optional)</label>
                  <input type="number" id="conf_sn_confirm_min" name="conf_sn_confirm_min"
                         step="0.1" min="0"
                         tal:attributes="value python:view.confirmation().get('sn_confirm_min') or ''" />
                  <span class="hint">1.0 for EPA 1633A.</span>
                </div>
                <div class="field-row field-row-wide">
                  <div class="check-row">
                    <input type="checkbox" id="conf_require_confirm_ion_check"
                           name="conf_require_confirm_ion_check"
                           tal:attributes="checked python:'checked' if view.confirmation().get('require_confirm_ion_check') else None" />
                    <label for="conf_require_confirm_ion_check">
                      Require qualifier ion check for all analytes
                    </label>
                  </div>
                  <span class="hint">ON for FDA 32-PFAS and EPA 1633A; OFF for EPA 537.1.</span>
                </div>
              </div>
            </div>
          </details>

          <div class="section-group-hdr">Continuing Verification</div>

          <details>
            <summary>Continuing Calibration Verification (CCV)</summary>
            <div class="section-body">
              <div class="field-grid">
                <div class="field-row">
                  <label for="ccv_frequency">CCV Frequency (every N samples)</label>
                  <input type="number" id="ccv_frequency" name="ccv_frequency"
                         step="1" min="1"
                         tal:attributes="value python:view.ccv().get('frequency', 10)" />
                  <span class="hint">6 for FDA 32-PFAS; 10 for EPA 537.1 / 1633A</span>
                </div>
                <div class="field-row">
                  <label for="ccv_recovery_min">Recovery Min %</label>
                  <input type="number" id="ccv_recovery_min" name="ccv_recovery_min" step="0.1"
                         tal:attributes="value python:view.ccv().get('recovery_min', 70.0)" />
                </div>
                <div class="field-row">
                  <label for="ccv_recovery_max">Recovery Max %</label>
                  <input type="number" id="ccv_recovery_max" name="ccv_recovery_max" step="0.1"
                         tal:attributes="value python:view.ccv().get('recovery_max', 130.0)" />
                </div>
                <div class="field-row">
                  <label for="ccv_low_level_min">Low-Level Min % (optional)</label>
                  <input type="number" id="ccv_low_level_min" name="ccv_low_level_min" step="0.1"
                         tal:attributes="value python:view.ccv().get('low_level_min') or ''" />
                  <span class="hint">Wider window for the lowest CCC/CCV level.</span>
                </div>
                <div class="field-row">
                  <label for="ccv_low_level_max">Low-Level Max % (optional)</label>
                  <input type="number" id="ccv_low_level_max" name="ccv_low_level_max" step="0.1"
                         tal:attributes="value python:view.ccv().get('low_level_max') or ''" />
                </div>
              </div>
            </div>
          </details>

          <details>
            <summary>Internal Standard (IS) / Surrogate Response</summary>
            <div class="section-body">
              <div class="field-grid">
                <div class="field-row">
                  <label for="is_vs_ical_avg_min">vs. ICAL Average Min %</label>
                  <input type="number" id="is_vs_ical_avg_min" name="is_vs_ical_avg_min" step="0.1"
                         tal:attributes="value python:view.is_section().get('vs_ical_avg_min') or ''" />
                </div>
                <div class="field-row">
                  <label for="is_vs_ical_avg_max">vs. ICAL Average Max %</label>
                  <input type="number" id="is_vs_ical_avg_max" name="is_vs_ical_avg_max" step="0.1"
                         tal:attributes="value python:view.is_section().get('vs_ical_avg_max') or ''" />
                </div>
                <div class="field-row">
                  <label for="is_vs_last_ccv_min">vs. Last CCV Min % (optional)</label>
                  <input type="number" id="is_vs_last_ccv_min" name="is_vs_last_ccv_min" step="0.1"
                         tal:attributes="value python:view.is_section().get('vs_last_ccv_min') or ''" />
                  <span class="hint">EPA 537.1 &#167;9.3.4 requires this second condition.</span>
                </div>
                <div class="field-row">
                  <label for="is_vs_last_ccv_max">vs. Last CCV Max % (optional)</label>
                  <input type="number" id="is_vs_last_ccv_max" name="is_vs_last_ccv_max" step="0.1"
                         tal:attributes="value python:view.is_section().get('vs_last_ccv_max') or ''" />
                </div>
                <div class="field-row field-row-wide">
                  <label for="is_notes">Notes</label>
                  <input type="text" id="is_notes" name="is_notes"
                         tal:attributes="value python:view.is_section().get('notes', '')" />
                </div>
              </div>
            </div>
          </details>

        </div>
      </div><!-- /pane-cal -->


      <!-- ── Tab: Lab Workflow (guided extraction stages) ───────────────── -->
      <div class="tab-pane" id="pane-lwf">
        <div class="page-body">
          <p class="json-hint" style="max-width:760px;">
            This method&#8217;s bench workflow: the stages defined here become the
            step-by-step <strong>Guided Extraction</strong> inside the batch&#8217;s
            extraction logbook (FM-ENV form set by this method) — edit the
            workflow here once, and every batch&#8217;s extraction log follows it.
          </p>
          <div style="background:var(--s-light);border:1px solid var(--s-border);
                      border-radius:8px;padding:10px 14px;font-size:12px;
                      color:var(--s-secondary);max-width:760px;margin-bottom:14px;">
            <strong style="color:var(--s-body);">Stage flags explained</strong><br/>
            <strong>Creates Solution</strong> — completing this stage records a new
            in-house <em>Prepared Standard</em> lot (it appears in Prepared
            Standards with this stage&#8217;s reagents as its parent lots, and its
            expiry inherits the tightest parent expiry).<br/>
            <strong>Capture Standard Pedigree</strong> — this stage shows the
            Standard/IS pedigree table in the Guided Extraction: the analyst
            records WHICH prepared-standard lots were spiked, completing the
            3-level traceability chain (reagent lot &#8594; prepared standard &#8594;
            result) that Data Review&#8217;s traceability gate checks.
          </div>


          

          <details>
            <summary>Extraction Stages</summary>
            <div class="section-body">
              <p class="json-hint">
                Define the guided extraction workflow stages for this method.
                Each stage appears as a step in the <strong>Extraction Guide</strong> on Batch objects.
                Drag rows to reorder (order field updates automatically).
              </p>
              <div id="stage-list"></div>
              <button type="button" class="btn-add-row" onclick="addStageCard()">+ Add stage</button>
              <input type="hidden" name="extraction_stages_json" id="extraction_stages_json"
                     tal:attributes="value view/extraction_stages_json" />
            </div>
          </details>

        </div>
      </div><!-- /pane-lwf -->
      <!-- ── Tab: QC Types (per-method enable toggles) ─────────────────── -->
      <div class="tab-pane" id="pane-qct">
        <div class="page-body">
          <details open="open">
            <summary>Associated QC Types</summary>
            <div class="section-body">
              <p style="font-size:12px;color:var(--s-secondary);max-width:640px;">
                Toggle which QC types this method runs. Enabled types drive the
                QC engine and auto-sync per-matrix Analysis Specifications;
                disabled types are skipped everywhere. Types marked
                <strong>recovery</strong> carry recovery ranges and generate specs.
              </p>
              <input type="hidden" name="qc_toggles_present" value="1"/>
              <table class="pfas-table" style="max-width:560px;">
                <thead><tr><th>Enabled</th><th>QC Type</th><th>Name</th><th>Spec sync</th></tr></thead>
                <tbody>
                  <tr tal:repeat="q view/qc_type_toggles">
                    <td style="text-align:center;">
                      <input type="checkbox"
                             tal:attributes="name string:qc_enabled_${q/key};
                                             checked q/enabled"/>
                    </td>
                    <td><code tal:content="q/key">LCS</code></td>
                    <td tal:content="q/label">Laboratory Control Sample</td>
                    <td>
                      <span tal:condition="q/has_recovery"
                            style="font-size:11px;background:#e8f4f8;color:#387493;padding:2px 8px;border-radius:8px;">recovery → specs</span>
                      <span tal:condition="not:q/has_recovery"
                            style="font-size:11px;color:var(--s-secondary);">limits only</span>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </details>
        </div>
      </div><!-- /pane-qct -->

      <!-- ── Tab: Advanced (qc_rules global defaults + raw JSON) ─────────── -->
      <div class="tab-pane" id="pane-adv">
        <div class="page-body">
          <details open="open">
            <summary>Global Engine Defaults (all methods)</summary>
            <div class="section-body">
              <p class="json-hint" style="max-width:760px;">
                Cross-method fallback values for the QC engine. A per-method
                override on the <strong>Rule Toggles &amp; QC Run</strong> tab
                always wins over these; edit here only to change the baseline
                every method inherits.
              </p>
              <table class="factor-table" style="max-width:560px;">
                <tbody>
                  <tr tal:repeat="g view/global_criteria_fields">
                    <td><label tal:content="g/label"
                               style="font-size:12px;color:var(--s-secondary);">label</label></td>
                    <td style="width:150px;">
                      <input type="number" step="any" style="width:120px;"
                             tal:attributes="name string:qcglobal.${g/key}; value g/value" />
                      <span tal:condition="g/unit" tal:content="g/unit"
                            style="font-size:11px;color:var(--s-secondary);">%</span>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </details>
          <details>
            <summary>Full QC-rules document (read-only reference)</summary>
            <div class="section-body">
              <p class="json-hint">
                The complete <code tal:content="view/qc_rules_path">qc_rules.json</code>
                as the pipeline sees it. Edit via the tabs above; this is a
                reference view (the store is shared across methods).
              </p>
              <textarea class="json-area" readonly="readonly" rows="20"
                        tal:content="view/qc_rules_json"></textarea>
            </div>
          </details>
        </div>
      </div><!-- /pane-adv -->

    </form>

    <script>
    (function () {
      function pfasTabSwitch(paneId) {
        document.querySelectorAll('.tab-pane').forEach(function (p) {
          p.classList.remove('active');
        });
        document.querySelectorAll('#method-profile-tabs .pfas-tab').forEach(function (t) {
          t.classList.remove('active');
        });
        var pane = document.getElementById(paneId);
        if (pane) pane.classList.add('active');
        var tab = document.querySelector('#method-profile-tabs [data-pane="' + paneId + '"]');
        if (tab) tab.classList.add('active');
        try {
          history.replaceState(null, '', location.pathname + location.search + '#' + paneId);
        } catch (e) {}
      }
      window.pfasTabSwitch = pfasTabSwitch;

      /* Rule Toggles: grey out a rule's param inputs when it is toggled off */
      (function () {
        function sync(cb) {
          var cell = document.querySelector('.rule-params[data-rule="' + cb.getAttribute('data-rule') + '"]');
          if (!cell) return;
          /* grey visually but keep inputs submittable so values persist
             across an off/on toggle (a disabled input would not POST) */
          cell.classList.toggle('rule-off', !cb.checked);
        }
        document.querySelectorAll('.rule-toggle-cb').forEach(function (cb) {
          sync(cb);
          cb.addEventListener('change', function () { sync(cb); });
        });
      })();

      (function () {
        var hash = location.hash.replace('#', '');
        var valid = ['pane-toggles', 'pane-qct', 'pane-rt', 'pane-corr', 'pane-ami',
                     'pane-sur', 'pane-eis', 'pane-cal', 'pane-lwf', 'pane-adv'];
        pfasTabSwitch((hash && valid.indexOf(hash) !== -1) ? hash : 'pane-toggles');
      })();
    })();
    </script>

    <script>
    /* Endpoint for stage action GIFs — shared with the logbook step builder. */
    var MP_MEDIA_URL = "<tal:m tal:replace="string:${view/portal_url}/@@pfas-logbook-media" />";
    </script>
    <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/method_profile_edit.js?v=2"></script>

  </div><!-- /content slot -->

</body>
</html>
