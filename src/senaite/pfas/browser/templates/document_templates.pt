<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Document Templates</title>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Document Templates</tal:t>

  <metal:fill fill-slot="content"
              tal:define="msg view/message; can view/can_configure;
                          token context/@@authenticator/token">
    <div class="alert alert-success" tal:condition="python: msg[0]" tal:content="python: msg[0]">ok</div>
    <div class="alert alert-error" tal:condition="python: msg[1]" tal:content="python: msg[1]">error</div>

    <p class="bench-sub">Draw a document and issue it; until then it prints the form as on screen, with the Print Settings header and footer. <tal:h define="hid string:document-designs"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></p>

    <!-- filters left, the page's one "New" action right; it opens a dialog -->
    <form method="get" class="pfas-filterbar" data-autosubmit="data-autosubmit"
          tal:attributes="action string:${view/portal_url}/@@pfas-document-templates">
      <div class="pfas-field">
        <label for="dt-status">Status</label>
        <select name="status" id="dt-status" class="pfas-select">
          <option value="active" tal:attributes="selected python:'selected' if view.status_filter() == 'active' else None">Active</option>
          <option value="archived" tal:attributes="selected python:'selected' if view.status_filter() == 'archived' else None">Archived</option>
        </select>
      </div>
      <div class="pfas-field">
        <label for="dt-kind">Kind</label>
        <select name="kind" id="dt-kind" class="pfas-select">
          <option tal:repeat="f view/KIND_FILTERS" tal:attributes="value python:f[0]; selected python:'selected' if view.kind_filter() == f[0] else None"
                  tal:content="python:f[1]">All</option>
        </select>
      </div>
      <span class="pfas-filterbar-spacer"></span>
      <button type="button" class="btn btn-primary" tal:condition="python:can and view.new_kinds()"
              onclick="document.getElementById('dt-new').classList.add('open')">+ New template</button>
    </form>

    <tal:t tal:define="rows view/table">
    <p class="bench-sub" tal:condition="not:rows">No document matches the filters.</p>
    <div class="table-wrap" tal:condition="rows">
    <table class="pfas-table" data-col-resize="document-templates-1">
      <thead><tr><th>Document</th><th>Kind</th><th>Size</th><th>Status</th><th>Draft</th>
        <th class="row-plus-cell"><span class="pfas-sr-hide">Actions</span></th></tr></thead>
      <tbody>
        <tr tal:repeat="r rows" tal:attributes="class python: 'dt-archived' if r.get('archived') else None">
          <td><strong tal:content="r/title">Vial label</strong>
            <div class="cf-hint dt-problem" tal:repeat="p r/problems" tal:content="p">lot (2) is not a label data field</div>
            <div class="cf-hint dt-problem" tal:condition="r/issued_problems">
              The issued revision no longer fits and will not print:
              <tal:p repeat="p r/issued_problems"><span tal:replace="p">x</span> </tal:p></div></td>
          <td tal:content="r/kind">Labels</td>
          <td tal:content="r/size">2" x 1"</td>
          <td>
            <span class="badge badge-draft" tal:condition="r/placeholder">Form as on screen</span>
            <tal:real tal:condition="not:r/placeholder" tal:define="st r/status">
              <span class="badge badge-archived" tal:condition="r/archived">Archived</span>
              <tal:live condition="not:r/archived">
                <span class="badge badge-quarantine" tal:condition="st/none_issued">Not issued</span>
                <tal:i condition="not:st/none_issued">
                  <span class="badge badge-active" tal:content="string:Issued rev ${st/rev}">Issued rev 1</span>
                  <span class="badge badge-opened" tal:condition="st/unissued">Unissued changes</span>
                </tal:i>
              </tal:live>
            </tal:real>
          </td>
          <td><span tal:condition="not:r/placeholder"
                    tal:content="python: '%s %s' % (view.lab_at(r['draft_at'], r['draft_at'][:16].replace('T', ' ')), r['draft_by'])">2026-10-04 AN1</span></td>
          <td class="row-plus-cell">
            <details class="row-more">
              <summary class="row-plus" aria-label="Actions for this document" title="Actions">+</summary>
              <div class="row-more-menu">
                <!-- a document not designed yet: Design creates it -->
                <tal:can condition="view/can_configure">
                <form method="post" tal:condition="r/placeholder"
                      tal:attributes="action string:${view/portal_url}/@@pfas-document-templates">
                  <input type="hidden" name="_authenticator" tal:attributes="value token" />
                  <input type="hidden" name="action" value="new" />
                  <input type="hidden" name="kind" tal:attributes="value r/kind_id" />
                  <input type="hidden" name="title" tal:attributes="value r/title" />
                  <input type="hidden" name="size" tal:attributes="value r/default_size" />
                  <button class="btn-sm btn-secondary" type="submit">Design</button>
                </form>
                </tal:can>
                <tal:real tal:condition="not:r/placeholder">
                <a class="btn-sm btn-secondary"
                   tal:attributes="href string:${view/portal_url}/@@pfas-document-designer?id=${r/id}"
                   tal:content="python: 'Design' if can else 'View'">Design</a>
                <a class="btn-sm btn-secondary" tal:condition="r/issued_with"
                   tal:attributes="href string:${view/portal_url}/@@pfas-report-template"
                   title="The certificate design is issued with the Reporting Template">Issue on Reporting Template</a>
                <tal:can condition="view/can_configure">
                <form method="post" class="mp-issue-form" tal:condition="python: not r['archived'] and not r['issued_with']"
                      tal:attributes="action string:${view/portal_url}/@@pfas-document-templates">
                  <input type="hidden" name="_authenticator" tal:attributes="value token" />
                  <input type="hidden" name="id" tal:attributes="value r/id" />
                  <input type="hidden" name="action" value="issue" />
                  <label class="mp-issue-label">Issue: what this revision changes
                    <input type="text" name="note" required="required" class="pfas-input" /></label>
                  <button class="btn-sm btn-primary" type="submit"
                          tal:attributes="disabled python: None if (r['status']['unissued'] and not r['problems']) else 'disabled'">Issue</button>
                </form>
                <!-- a draft only: what prints stays the issued revision -->
                <form method="post" tal:condition="python: r['has_starter'] and not r['archived']"
                      tal:attributes="action string:${view/portal_url}/@@pfas-document-templates"
                      onsubmit="return confirm('Replace the draft with the current starting layout? The issued revision stays as it is.');">
                  <input type="hidden" name="_authenticator" tal:attributes="value token" />
                  <input type="hidden" name="id" tal:attributes="value r/id" />
                  <input type="hidden" name="action" value="from_starter" />
                  <button class="btn-sm btn-secondary" type="submit"
                          title="Writes a draft to preview and issue; nothing prints from it until then">Start a draft from the starting layout</button>
                </form>
                </tal:can>
                <button type="button" class="btn-sm btn-secondary" tal:condition="r/history"
                        tal:attributes="data-revs string:dt-revs-${repeat/r/index};
                                        data-title python:u'%s: issued revisions' % r['title']">Revisions</button>
                <tal:can condition="view/can_configure">
                <form method="post"
                      tal:attributes="action string:${view/portal_url}/@@pfas-document-templates">
                  <input type="hidden" name="_authenticator" tal:attributes="value token" />
                  <input type="hidden" name="id" tal:attributes="value r/id" />
                  <input type="hidden" name="action" tal:attributes="value python: 'restore' if r['archived'] else 'archive'" />
                  <button type="submit" tal:attributes="class python:'btn-sm btn-secondary' if r['archived'] else 'btn-sm btn-danger'"
                          tal:content="python: 'Restore' if r['archived'] else 'Archive'">Archive</button>
                </form>
                </tal:can>
                </tal:real>
              </div>
            </details>
            <template tal:condition="r/history" tal:attributes="id string:dt-revs-${repeat/r/index}">
              <table class="pfas-table" data-col-resize="document-templates-2">
                <thead><tr><th>Revision</th><th>Issued</th><th>By</th><th>Note</th></tr></thead>
                <tbody><tr tal:repeat="h r/history">
                  <td tal:content="h/rev">1</td>
                  <td tal:content="python: view.lab_at(h.get('issued_at'), (h.get('issued_at') or u'')[:16].replace('T', ' '))">2026-10-04 12:00</td>
                  <td tal:content="python: h.get('issued_by')">admin</td>
                  <td tal:content="python: h.get('note')">first issue</td>
                </tr></tbody>
              </table>
            </template>
          </td>
        </tr>
      </tbody>
    </table>
    </div>
    </tal:t>

    <!-- + New template: a dialog -->
    <div class="pfas-modal" id="dt-new" tal:condition="view/can_configure">
      <div class="pfas-modal-box is-narrow">
        <h2>New template</h2>
        <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-document-templates">
          <input type="hidden" name="_authenticator" tal:attributes="value token" />
          <input type="hidden" name="action" value="new" />
          <div class="pfas-form-field"><label for="dt-new-kind">Kind</label>
            <select name="kind" id="dt-new-kind" class="pfas-select" onchange="dtSizes(this.value)">
              <option tal:repeat="k view/new_kinds" tal:attributes="value k/id" tal:content="k/title">Labels</option>
            </select></div>
          <div class="pfas-form-field"><label for="dt-new-title">Name</label>
            <input type="text" name="title" id="dt-new-title" required="required" class="pfas-input" /></div>
          <div class="pfas-form-field"><label for="dt-new-size">Size</label>
            <select name="size" id="dt-new-size" class="pfas-select">
              <tal:k tal:repeat="k view/new_kinds"><option tal:repeat="z k/sizes"
                     tal:attributes="value z/id; data-kind k/id" tal:content="z/title">2x1</option></tal:k>
            </select></div>
          <div class="form-actions is-end">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('dt-new').classList.remove('open')">Cancel</button>
            <button type="submit" class="btn btn-primary">Create</button>
          </div>
        </form>
      </div>
    </div>
    <script>
    /* the size list follows the kind; "Revisions" opens the drawer */
    function dtSizes(kind) {
      var sel = document.getElementById('dt-new-size'), first = null;
      Array.prototype.forEach.call(sel.options, function (o) {
        var mine = o.getAttribute('data-kind') === kind;
        o.hidden = !mine; o.disabled = !mine;
        if (mine ? !first : false) first = o;
      });
      if (first) sel.value = first.value;
    }
    (function () {
      var k = document.getElementById('dt-new-kind');
      if (k) dtSizes(k.value);
      document.addEventListener('click', function (ev) {
        var btn = ev.target.closest ? ev.target.closest('[data-revs]') : null;
        if (!btn) return;
        var tpl = document.getElementById(btn.getAttribute('data-revs'));
        var d = btn.closest('details');
        if (d) d.removeAttribute('open');
        if (tpl) window.PFAS.components.drawer.open(btn.getAttribute('data-title'), tpl.content.cloneNode(true));
      });
    })();
    </script>
  </metal:fill>
</body>
</html>
