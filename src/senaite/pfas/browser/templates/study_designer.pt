<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Study Designer</title>
  <metal:fill fill-slot="header-title">Study Designer</metal:fill>
  <tal:r metal:fill-slot="header-right">
    <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-method-studies">Method Studies</a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body" tal:define="purl view/portal_url; t view/current; mgr view/can_configure">

    <div class="alert alert-success" tal:condition="request/saved|nothing">Saved.</div>
    <div class="alert alert-danger" tal:repeat="e view/errors" tal:content="e">error</div>

    <!-- the list -->
    <tal:list tal:condition="not:t">
      <table class="pfas-table" data-col-resize="study-designer-1" tal:condition="view/templates"
             tal:define="rm context/@@pfas-row-menu">
        <thead><tr><th>Template</th><th>Method</th><th>Matrix</th><th>Elements</th></tr></thead>
        <tbody>
          <tr tal:repeat="x view/templates"
              tal:attributes="data-row-open string:${purl}/@@pfas-study-designer?id=${x/id};
                              data-row-actions python:rm.actions((u'Delete', 'form', u'sd-delete-%s' % x['id'], {'danger': True}) if mgr else None)">
            <td><strong tal:content="x/name">FDA IDC</strong></td>
            <td tal:content="python:view.method_name(x.get('method'))">FDA 32-PFAS in Food</td>
            <td tal:content="python:x.get('matrix') or u'any'">Eggs</td>
            <td tal:content="python:len(x.get('elements') or [])">3</td>
          </tr>
        </tbody>
      </table>
      <tal:dl tal:condition="mgr" tal:repeat="x view/templates">
        <form method="post" hidden="hidden"
              tal:attributes="action string:${purl}/@@pfas-study-designer; id string:sd-delete-${x/id}">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="id" tal:attributes="value x/id" />
          <button class="btn-sm btn-danger" type="submit" name="action" value="delete"
                  tal:attributes="aria-label string:Delete ${x/name}">Delete</button>
        </form>
      </tal:dl>
      <form method="post" tal:condition="mgr" tal:attributes="action string:${purl}/@@pfas-study-designer">
        <input tal:replace="structure context/@@authenticator/authenticator" />
        <div class="section-group-hdr">New template</div>
        <div class="pfas-form-row page-body-narrow">
          <label class="pfas-form-field">Name <input type="text" name="t__name" /></label>
          <div class="pfas-form-field" tal:define="mc_choices python:[{'value': m, 'label': view.method_name(m)} for m in view.methods()];
                                                   mc_value python:(mc_choices[0]['value'] if mc_choices else u''); mc_label string:Method;
                                                   mc_id string:sd-new-method; mc_name string:t__method"><span>Method</span>
            <metal:m use-macro="context/@@pfas-macros/macros/method-choice" /></div>
        </div>
        <div class="form-actions"><button class="btn btn-primary" type="submit" name="action" value="new">Create template</button></div>
      </form>
    </tal:list>

    <!-- one template -->
    <form method="post" tal:condition="t" tal:attributes="action string:${purl}/@@pfas-study-designer?id=${t/id}">
      <input tal:replace="structure context/@@authenticator/authenticator" />
      <input type="hidden" name="id" tal:attributes="value t/id" />
      <ul class="bench-alerts" tal:define="probs view/problems" tal:condition="probs">
        <li tal:repeat="p probs" tal:content="p">problem</li>
      </ul>
      <fieldset class="pfas-ro" tal:attributes="disabled python:None if mgr else 'disabled'">
      <div class="pfas-form-row page-body-narrow">
        <label class="pfas-form-field">Name <input type="text" name="t__name" tal:attributes="value t/name" /></label>
        <div class="pfas-form-field" tal:define="mc_choices python:[{'value': m, 'label': view.method_name(m)} for m in view.methods()];
                                                 mc_value python:t.get('method') or u''; mc_label string:Method;
                                                 mc_id string:sd-method; mc_name string:t__method"><span>Method</span>
          <metal:m use-macro="context/@@pfas-macros/macros/method-choice" /></div>
        <label class="pfas-form-field">Matrix
          <select name="t__matrix">
            <option value="">Any</option>
            <option tal:repeat="m python:view.matrices(t.get('method'))" tal:content="m"
                    tal:attributes="value m; selected python:'selected' if m == t.get('matrix') else None">Eggs</option>
          </select></label>
      </div>

      <tal:el tal:repeat="el python:t.get('elements') or []">
      <fieldset class="study-element" tal:define="p string:e__${el/id}__">
        <legend tal:content="python:u'%s: %s' % (el['id'], dict(view.types())[el['type']])">E1</legend>
        <div class="pfas-form-row">
          <label class="pfas-form-field is-full">Name <input type="text" tal:attributes="name string:${p}name; value el/name" /></label>

          <tal:r tal:condition="python:el['type'] == 'replicates'"><tal:s tal:define="s el/stats">
            <label class="pfas-form-field">Role
              <select tal:attributes="name string:${p}role">
                <option value="">Choose</option>
                <option tal:repeat="r python:view.qc_types(t.get('method'))" tal:content="r"
                        tal:attributes="value r; selected python:'selected' if r == el.get('role') else None">LFB</option>
              </select></label>
            <label class="pfas-form-field">Limits from
              <select tal:attributes="name string:${p}limits_from">
                <option value="" tal:attributes="selected python:'selected' if not el.get('limits_from') else None">Its role's QC type</option>
                <option tal:repeat="q python:view.qc_types(t.get('method'))" tal:content="q"
                        tal:attributes="value q; selected python:'selected' if q == el.get('limits_from') else None">LFSM</option>
              </select></label>
            <label class="pfas-form-field">Sources <input type="number" min="1" step="1" tal:attributes="name string:${p}sources; value el/sources" /></label>
            <label class="pfas-form-field">Levels (comma-separated, matrix unit)
              <input type="text" tal:attributes="name string:${p}levels; value python:view.levels_text(el)" /></label>
            <label class="pfas-form-field">Replicates per source and level
              <input type="number" min="1" step="1" tal:attributes="name string:${p}replicates; value python:view.fmt(el.get('replicates'))" /></label>
            <label class="pfas-switch"><input type="checkbox" value="on"
                   tal:attributes="name string:${p}recovery_on; checked python:'checked' if s['recovery']['on'] else None" /><span class="pfas-switch-track"></span>
              Mean recovery per level</label>
            <label class="pfas-switch"><input type="checkbox" value="on"
                   tal:attributes="name string:${p}rsd_within_on; checked python:'checked' if s['rsd_within']['on'] else None" /><span class="pfas-switch-track"></span>
              RSD within each source</label>
            <label class="pfas-switch"><input type="checkbox" value="on"
                   tal:attributes="name string:${p}rsd_between_on; checked python:'checked' if s['rsd_between']['on'] else None" /><span class="pfas-switch-track"></span>
              RSD between sources, per level</label>
            <label class="pfas-form-field">RSD between sources of
              <select tal:attributes="name string:${p}rsd_between_basis">
                <option value="means" tal:attributes="selected python:'selected' if s['rsd_between'].get('basis') != 'pooled' else None">the source means</option>
                <option value="pooled" tal:attributes="selected python:'selected' if s['rsd_between'].get('basis') == 'pooled' else None">all replicates pooled</option>
              </select></label>
          </tal:s></tal:r>

          <tal:m tal:condition="python:el['type'] == 'mdl'">
            <label class="pfas-form-field">Spiked replicates
              <select tal:attributes="name string:${p}spike_role">
                <option value="">Choose</option>
                <option tal:repeat="r python:view.spike_roles(t.get('method'))" tal:content="r"
                        tal:attributes="value r; selected python:'selected' if r == el.get('spike_role') else None">LFB</option>
              </select></label>
            <label class="pfas-form-field">Blanks
              <select tal:attributes="name string:${p}blank_role">
                <option value="">Choose</option>
                <option tal:repeat="r python:view.qc_types(t.get('method'))" tal:content="r"
                        tal:attributes="value r; selected python:'selected' if r == el.get('blank_role') else None">MB</option>
              </select></label>
          </tal:m>

          <tal:q tal:condition="python:el['type'] == 'qualitative'">
            <label class="pfas-form-field is-full">What the reviewer checks
              <textarea rows="3" tal:attributes="name string:${p}instructions" tal:content="el/instructions"></textarea></label>
            <label class="pfas-form-field">Files accepted <input type="text" tal:attributes="name string:${p}accept; value el/accept" /></label>
          </tal:q>

          <tal:y tal:condition="python:el['type'] == 'typed'">
            <label class="pfas-form-field">How many values <input type="number" min="1" step="1" tal:attributes="name string:${p}count; value el/count" /></label>
            <label class="pfas-form-field">Unit <input type="text" tal:attributes="name string:${p}unit; value el/unit" /></label>
            <label class="pfas-form-field">Lowest <input type="number" step="any" tal:attributes="name string:${p}min; value python:view.fmt(el.get('min'))" /></label>
            <label class="pfas-form-field">Highest <input type="number" step="any" tal:attributes="name string:${p}max; value python:view.fmt(el.get('max'))" /></label>
            <label class="pfas-switch"><input type="checkbox" value="on"
                   tal:attributes="name string:${p}upload; checked python:'checked' if el.get('upload') else None" /><span class="pfas-switch-track"></span>
              Evidence file required</label>
          </tal:y>
        </div>
        <div class="form-actions">
          <button class="btn-sm btn-secondary" type="submit" name="action"
                  tal:attributes="value string:remove:${el/id}; aria-label string:Remove ${el/name}">Remove element</button>
        </div>
      </fieldset>
      </tal:el>

      <div class="pfas-form-row page-body-narrow">
        <label class="pfas-form-field">Add an element
          <select name="new_type">
            <option value="">Choose</option>
            <option tal:repeat="ty view/types" tal:attributes="value python:ty[0]" tal:content="python:ty[1]">Replicates</option>
          </select></label>
      </div>
      <div class="form-actions">
        <button class="btn-sm btn-secondary" type="submit" name="action" value="add">Add element</button>
        <button class="btn btn-primary" type="submit" name="action" value="save">Save template</button>
        <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-study-designer">All templates</a>
      </div>
      </fieldset>
    </form>
  </div>
  </div>
</html>
