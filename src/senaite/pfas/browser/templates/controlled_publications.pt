<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      i18n:domain="senaite.pfas">
<head>
  <title metal:fill-slot="title">Certificates</title>
  <tal:t metal:fill-slot="header-title">Certificates</tal:t>

  <tal:styles metal:fill-slot="head-extra">
  <style>
    .cp-head { margin-bottom: 16px; }
    .cp-title { font-size: var(--fs-lg); font-weight: 700; color: var(--s-text); }
    .cp-sub { color: var(--s-secondary); font-size: var(--fs-base); margin-top: 4px; }
    table.cp-tbl { width: 100%; border-collapse: collapse; font-size: var(--fs-base); }
    table.cp-tbl th { text-align: left; padding: 8px 10px; border-bottom: 2px solid var(--s-border);
      font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .03em; color: var(--s-secondary); }
    table.cp-tbl td { padding: 8px 10px; border-bottom: 1px solid var(--s-border);
      vertical-align: top; }
    .cp-rid { font-weight: 700; font-family: var(--font-mono); }
    .cp-badge { font-size: var(--fs-xs); font-weight: 700; text-transform: uppercase;
      padding: 2px 8px; border-radius: 10px; white-space: nowrap; }
    .cp-current { background: var(--s-success-lt); color: var(--s-success-text); }
    .cp-superseded { background: var(--s-light); color: var(--s-secondary); }
    .cp-flag { background: var(--s-danger-lt); color: var(--s-danger-dk); font-weight: 700;
      padding: 2px 8px; border-radius: 10px; font-size: var(--fs-xs); white-space: nowrap; }
    .cp-reason { color: var(--s-text); }
    .cp-tier { color: var(--s-secondary); }
    .cp-none { color: var(--s-secondary); }
    .cp-interim { background: var(--s-warn-lt); color: var(--s-warn-text); font-weight: var(--fw-strong);
      padding: 2px 8px; border-radius: 10px; font-size: var(--fs-xs); white-space: nowrap; }
    .cp-hash { font-family: var(--font-mono); font-size: var(--fs-xs); }
    .cp-filter { margin: 8px 0 12px; }
  </style>
  </tal:styles>

  <tal:content metal:fill-slot="content"
               tal:define="rows view/publications">
    <div class="cp-head">
      <div class="cp-title" i18n:translate="">Certificates</div>
      <div class="cp-sub" i18n:translate="">
        Register of every issued certificate. Each row is an issue that never changes; an amended reissue supersedes
        the prior revision. The original certificate is never altered.
      </div>
    </div>

    <div tal:repeat="m view/status_messages" tal:attributes="class m/cls" tal:content="m/text"></div>
    <div class="alert alert-success" tal:condition="view/retried" i18n:translate="">The certificate is queued again.</div>
    <div class="alert alert-success" tal:condition="view/deleted" i18n:translate="">The certificate is deleted.</div>

    <!-- certificates stored and not yet issued: a Send held back for its package is retried here -->
    <tal:waiting tal:define="waiting view/awaiting" tal:condition="waiting">
    <h3 class="pfas-section-title" i18n:translate="">Awaiting issue</h3>
    <table class="cp-tbl cp-awaiting" data-col-resize="controlled-publications-cp-awaiting"
           tal:define="rm context/@@pfas-row-menu">
      <thead>
        <tr>
          <th i18n:translate="">Sample</th>
          <th i18n:translate="">Client</th>
          <th i18n:translate="">Created</th>
          <th i18n:translate="">State</th>
          <th i18n:translate="">Certificate</th>
        </tr>
      </thead>
      <tbody>
        <!-- the row opens the sample; the next step (retry the package, or
             Send to issue) leads its menu, then the PDF and Delete -->
        <tr tal:repeat="r waiting"
            tal:attributes="data-row-open r/sample_url;
                            data-row-actions python:rm.actions(
                                (r.get('retry_label') or u'Retry the certificate', 'form', u'cp-retry-%s' % r['report_uid'])
                                    if r['package_retry'] and view.can_retry() else None,
                                (u'Send to issue', 'href', r.get('send_url'), {'note': u'Open the e-mail form: Send issues the certificate'})
                                    if r.get('send_url') and not r['package_retry'] and view.may_change() else None,
                                (u'Open PDF', 'href', r.get('pdf_url'), {'blank': True}),
                                (u'Delete', 'form', u'cp-delete-%s' % r['report_uid'], {'danger': True})
                                    if r.get('may_delete') and view.can_retry() else None)">
          <td tal:content="r/sample_id"></td>
          <td tal:content="r/client"></td>
          <td tal:content="r/created"></td>
          <!-- the state and its next step: Send issues it, a failed package is retried first -->
          <td class="cp-state">
            <div tal:content="r/state">Not yet issued</div>
          </td>
          <td class="cp-package">
            <div class="cp-tier" tal:condition="r/tier_code" tal:content="r/tier_code"></div>
            <div tal:condition="r/package_line" tal:content="r/package_line"></div>
            <span class="cp-none" tal:condition="python:not r['tier_code'] and not r['package_line']">&mdash;</span>
          </td>
        </tr>
      </tbody>
    </table>
    <!-- the awaiting rows' menu: retry the package; a draft never issued, held or not, is deleted -->
    <tal:f repeat="r waiting">
      <form method="post" class="cp-retry-form" hidden="hidden" tal:condition="python:r['package_retry'] and view.can_retry()"
            tal:attributes="action string:${context/portal_url}/@@pfas-package-retry; id string:cp-retry-${r/report_uid}">
        <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token"/>
        <input type="hidden" name="job" tal:attributes="value r/report_uid"/>
        <button type="submit" class="btn-sm btn-primary" i18n:translate=""
                tal:content="python:r.get('retry_label') or 'Retry the certificate'">Retry the certificate</button>
      </form>
      <form method="post" class="cp-delete-form" hidden="hidden" tal:condition="python:r.get('may_delete') and view.can_retry()"
            onsubmit="return confirm('Delete this certificate? It was never issued.');"
            tal:attributes="action string:${context/portal_url}/@@pfas-certificate-delete; id string:cp-delete-${r/report_uid}">
        <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token"/>
        <input type="hidden" name="job" tal:attributes="value r/report_uid"/>
        <button type="submit" class="btn-sm btn-secondary" i18n:translate="">Delete</button>
      </form>
    </tal:f>
    <tal:p define="pg view/awaiting_paging"><metal:p use-macro="context/@@pfas-macros/macros/paging" /></tal:p>
    <h3 class="pfas-section-title" i18n:translate="">Issued</h3>
    </tal:waiting>

    <!-- issued certificates whose e-mail waits, sent again at once by a Manager -->
    <form method="post" tal:condition="python:view.can_retry() and [r for r in rows if r.get('delivery_waiting')]"
          tal:attributes="action string:${context/portal_url}/@@pfas-delivery-send">
      <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token"/>
      <input type="hidden" name="all" value="1"/>
      <button type="submit" class="btn-sm btn-secondary">Send every waiting e-mail</button>
    </form>

    <nav class="pfas-seg pfas-seg-sm is-fit cp-filter" aria-label="Issued certificates"
         tal:define="only view/interim_only" tal:condition="python:rows or only">
      <a class="pfas-seg-item" tal:attributes="href string:${context/portal_url}/@@pfas-controlled-publications;
         aria-selected python:'false' if only else 'true'">All</a>
      <a class="pfas-seg-item" tal:attributes="href string:${context/portal_url}/@@pfas-controlled-publications?show=interim;
         aria-selected python:'true' if only else 'false'">Interim, final pending</a>
    </nav>

    <div class="form-actions" tal:condition="rows">
      <a class="btn-sm btn-secondary" tal:attributes="href view/csv_url">Download the register</a>
    </div>

    <table class="cp-tbl cp-issued" data-col-resize="controlled-publications-cp-tbl" tal:condition="rows"
           tal:define="rm context/@@pfas-row-menu">
      <thead>
        <tr>
          <th i18n:translate="">Certificate ID</th>
          <th i18n:translate="">Sample</th>
          <th i18n:translate="">Client</th>
          <th i18n:translate="">Status</th>
          <th i18n:translate="">Signed by</th>
          <th i18n:translate="">Content</th>
          <th i18n:translate="">Issued</th>
          <th i18n:translate="">Certificate</th>
        </tr>
      </thead>
      <tbody>
        <!-- the row opens the sample; its menu: the PDF (or Print before one is
             stored), a waiting e-mail sent again, a flagged reissue's reason -->
        <tr tal:repeat="r rows"
            tal:attributes="data-row-open r/sample_url;
                            data-row-actions python:rm.actions(
                                (u'Open PDF', 'href', r.get('pdf_url'), {'blank': True}),
                                (u'Print', 'href', r['coa_live'], {'note': u'Generate and print the Certificate of Analysis'})
                                    if not r['pdf_url'] and r['coa_live'] and view.may_change() else None,
                                (u'Send the e-mail', 'form', u'cp-send-%s' % r['report_id'])
                                    if r.get('delivery_waiting') and view.can_retry() else None,
                                (u'Record the reason', 'modal', u'cp-reason-%s' % r['report_id'])
                                    if r['reason_missing'] and view.may_change() else None)">
          <td><span class="cp-rid" tal:content="r/report_id"></span></td>
          <td tal:content="r/sample_id"></td>
          <td tal:content="r/client"></td>
          <td>
            <tal:m tal:define="ic context/@@pfas-icons"
                   tal:replace="structure python:ic.tip('doc-issued', u'Current') if r['status'] == 'current' else (ic.tip('doc-superseded', u'Superseded') if r['status'] == 'superseded' else u'')" />
            <span class="cp-interim" tal:condition="r/interim">INTERIM</span>
            <!-- a flagged reissue: the QAO records the reason from the row's menu -->
            <div class="cp-flag" tal:condition="r/reason_missing" i18n:translate="">Reason not recorded</div>
          </td>
          <td>
            <!-- the ledger's signer; an issue the guard did not catch is flagged;
                 an issue from before signatures names its publisher -->
            <tal:s tal:condition="r/signed_by" tal:content="r/signed_by"></tal:s>
            <span class="cp-flag" tal:condition="python:not r['signed_by'] and r['unsigned']">Not signed</span>
            <tal:p tal:condition="python:not r['signed_by'] and not r['unsigned']" tal:content="r/authorizer"></tal:p>
          </td>
          <td>
            <code class="cp-hash" tal:condition="r/hash_prefix" tal:content="r/hash_prefix"></code>
            <span class="cp-none" tal:condition="not:r/hash_prefix">&mdash;</span>
          </td>
          <td>
            <div tal:content="python:view.lab_at(r['issued_at'], (r['issued_at'] or u'')[:16].replace(u'T', u' '))"></div>
            <!-- the issue's e-mail as it stands, under its date; an issue from before e-mails were recorded names its recipients -->
            <div class="cp-tier" tal:define="line python:r.get('delivery_line')" tal:condition="line" tal:content="line">E-mailed to client@demo.example</div>
            <div class="cp-tier" tal:condition="python:not r.get('delivery_line') and r.get('recipients')" tal:content="r/recipients"></div>
          </td>
          <!-- the tier's code alone; a package that is not ready says so -->
          <td class="cp-package">
            <div tal:condition="r/tier_code" tal:content="r/tier_code"></div>
            <div class="cp-tier" tal:condition="r/package_flag" tal:content="r/package_flag"></div>
            <span class="cp-none" tal:condition="python:not r['tier_code'] and not r['package_flag']">&mdash;</span>
          </td>
        </tr>
      </tbody>
    </table>
    <!-- the issued rows' menu: an e-mail that waits, sent again by a Manager;
         a flagged reissue, whose reason the QAO records in a dialog -->
    <tal:f repeat="r rows">
      <form method="post" hidden="hidden" tal:condition="python:r.get('delivery_waiting') and view.can_retry()"
            tal:attributes="action string:${context/portal_url}/@@pfas-delivery-send; id string:cp-send-${r/report_id}">
        <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token"/>
        <input type="hidden" name="report" tal:attributes="value r/report_uid"/>
        <button type="submit" class="btn-sm btn-primary">Send the e-mail</button>
      </form>
      <div class="pfas-modal" tal:condition="python:r['reason_missing'] and view.may_change()"
           tal:attributes="id string:cp-reason-${r/report_id}">
        <div class="pfas-modal-box is-narrow">
          <h2 tal:content="python:u'Reason for reissue %s' % r['report_id']">Reason for reissue DEMO-0001-R2</h2>
          <form method="post" class="cp-reason-form">
            <input type="hidden" name="action" value="record_reason"/>
            <input type="hidden" name="sample_uid" tal:attributes="value r/sample_uid"/>
            <input type="hidden" name="revision" tal:attributes="value r/revision"/>
            <input type="text" name="reason" required="required" placeholder="Reason for this reissue"/>
            <div class="form-actions is-end">
              <button type="button" class="btn btn-secondary" data-modal-close="data-modal-close">Cancel</button>
              <button type="submit" class="btn btn-primary" i18n:translate="">Record the reason</button>
            </div>
          </form>
        </div>
      </div>
    </tal:f>

    <div class="pfas-empty" tal:condition="python:not rows and view.interim_only()">
      <span i18n:translate="">No interim certificate is awaiting its final.</span>
    </div>
    <div class="pfas-empty is-boxed" tal:condition="python:not rows and not view.interim_only()">
      <span i18n:translate="">No certificate has been issued yet. A certificate is issued from a published
        sample&#8217;s report; the samples that can be published are listed under Published samples.</span>
      <a class="btn-sm btn-secondary" i18n:translate=""
         tal:attributes="href string:${context/portal_url}/samples?samples_review_state=published">Open Published samples</a>
    </div>
  </tal:content>
</head>
</html>
