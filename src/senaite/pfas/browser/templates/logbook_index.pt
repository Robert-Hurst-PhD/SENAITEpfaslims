<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Logbooks</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
    .lb-card {
      display: flex; align-items: center; gap: 20px;
      padding: 18px 22px; border: 1px solid var(--s-border);
      border-radius: 10px; margin-bottom: 12px; background: var(--s-bg);
      text-decoration: none; color: inherit;
    }
    .lb-card:hover { background: #f8f9fa; border-color: var(--s-primary); }
    .lb-num {
      font-size: 11px; font-weight: 700; color: var(--s-secondary);
      background: #e9ecef; padding: 3px 10px; border-radius: 8px;
      white-space: nowrap;
    }
    .lb-title-group { flex: 1; }
    .lb-title { font-size: 14px; font-weight: 600; }
    .lb-subtitle { font-size: 11px; color: var(--s-secondary); margin-top: 2px; }
    .lb-badge-ok      { font-size: 11px; background: #d4edda; color: #155724;
                        padding: 2px 10px; border-radius: 8px; white-space: nowrap; }
    .lb-badge-pending { font-size: 11px; background: #f8f9fa; color: var(--s-secondary);
                        border: 1px solid var(--s-border); padding: 2px 10px;
                        border-radius: 8px; white-space: nowrap; }
    .lb-badge-guided  { font-size: 11px; background: #e8f0fe; color: #1a56db;
                        padding: 2px 10px; border-radius: 8px; white-space: nowrap; }
    .lb-badge-guided-done { font-size: 11px; background: #d4edda; color: #155724;
                        padding: 2px 10px; border-radius: 8px; white-space: nowrap; }
  </style>
  </tal:styles>
</head>
<body>
  <tal:t metal:fill-slot="header-title">
    Batch Logbooks
  </tal:t>
  <tal:r metal:fill-slot="header-right">
    <span class="header-meta"
          tal:content="view/batch_title">Batch</span>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <!-- Breadcrumb -->
    <div class="lb-breadcrumb">
      <a tal:attributes="href view/portal_url">Lab</a>
      <span class="lb-bc-sep">›</span>
      <tal:m tal:condition="view/batch_method">
        <span tal:content="view/batch_method">Method</span>
        <span class="lb-bc-sep">›</span>
      </tal:m>
      <strong tal:content="view/batch_title">Batch</strong>
      <span class="lb-bc-sep">›</span>
      <strong>Logbooks</strong>
    </div>

    <p style="font-size:13px; color:var(--s-body); margin-bottom:24px;">
      Logbooks for this batch.  Fill them in on the bench or tablet before
      extraction and instrument run.
      <!-- Manager-only: the target 403s for bench staff, so showing this to
           everyone was a dead end. -->
      <a tal:condition="view/is_manager"
         tal:attributes="href view/admin_url"
         style="margin-left:12px;font-size:12px;color:var(--s-secondary);">
        <i class="fas fa-cog"></i> Logbook setup
      </a>
    </p>

    <tal:lbs tal:repeat="lb view/logbooks">
      <a class="lb-card" tal:attributes="href lb/url">
        <span class="lb-num" tal:content="lb/num">250</span>
        <span class="lb-title-group">
          <span class="lb-title" tal:content="lb/title">Logbook</span>
          <div class="lb-subtitle" tal:condition="lb/subtitle" tal:content="lb/subtitle"></div>
        </span>

        <!-- Extraction Log (252) — guided extraction status -->
        <tal:eg tal:condition="lb/is_extraction_log">
          <span class="lb-badge-guided-done"
                tal:condition="lb/eg_finalized">&#10003; Extraction Complete</span>
          <span class="lb-badge-guided"
                tal:condition="python:lb['eg_started'] and not lb['eg_finalized']">In Progress</span>
          <span class="lb-badge-pending"
                tal:condition="python:not lb['eg_started'] and not lb['eg_finalized']">Guided Extraction</span>
        </tal:eg>

        <!-- All other logbooks — filled / pending -->
        <tal:std tal:condition="not:lb/is_extraction_log">
          <span class="lb-badge-ok"      tal:condition="lb/filled">Data entered</span>
          <span class="lb-badge-pending" tal:condition="not:lb/filled">Pending</span>
        </tal:std>

        <span style="color:var(--s-secondary);">&#8594;</span>
      </a>
    </tal:lbs>

  </div>
  </div><!-- /content slot -->
</body>
</html>
