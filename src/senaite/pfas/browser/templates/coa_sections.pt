<tal:coa define="sec view/section; s view/settings; lab view/lab"
         i18n:domain="senaite.pfas">
<!-- Compact CoA sections (coa_sections.py). Rendered inside the impress report,
     so styling is inline here: the PFAS macro stylesheet is not loaded on
     published reports. Section wrappers keep impress's "row section-*" classes
     so its paginator places and repeats them as it does core's. -->

<tal:header condition="python:sec == 'header'">
  <style type="text/css" tal:content="structure view/print_css">/* the lab print stylesheet */</style>
  <!-- the lab on the left, its logo beside its name, as tall as the header, when one is set, the
       document on the right over one ruled line; the black-and-white
       variant is the same layout (pfas-print.css) -->
  <div tal:attributes="class string:row section-header no-gutters pfas-coa ${view/variant}">
    <table class="pfas-coa-head"><tr>
      <td class="pfas-coa-logo" tal:condition="lab/logo" tal:attributes="style string:background-image: url('${lab/logo}')"></td>
      <td class="pfas-coa-lab">
        <div class="lab" tal:content="lab/name">Laboratory</div>
        <div class="sub" tal:condition="lab/contact" tal:content="lab/contact">address</div>
      </td>
      <td class="doc" tal:define="meta view/doc_meta">
        <div class="t" i18n:translate="">Certificate of Analysis</div>
        <div class="meta">
          <span tal:condition="meta/report_id"><tal:l i18n:translate="">Report</tal:l> <strong tal:content="meta/report_id">FEED-0002-R2</strong></span>
          <span><tal:l i18n:translate="">Issued</tal:l> <strong tal:content="meta/issued">2026-09-30</strong></span>
        </div>
      </td>
    </tr></table>
  </div>
</tal:header>

<tal:samples condition="python:sec == 'samples'">
  <div tal:attributes="class string:row section-results no-gutters pfas-coa ${view/variant}" tal:repeat="smp view/samples">
    <div class="pfas-coa-sample">
      <div tal:condition="smp/error|nothing" class="pfas-coa-error">
        <tal:i replace="smp/id"/>: this sample could not be rendered (<tal:e replace="smp/error"/>).
      </div>
      <tal:ok condition="not:smp/error|nothing">
      <!-- the two sample IDs large in a tinted band, then the sample's
           facts, label over value, four to a row -->
      <div class="pfas-coa-sec" i18n:translate="">Sample</div>
      <table class="pfas-coa-ids"><tr>
        <td><div class="k" i18n:translate="">Lab sample ID</div><div class="v" tal:content="smp/id">DEMO-0001</div></td>
        <td><div class="k" i18n:translate="">Client sample ID</div><div class="v" tal:content="smp/client_sid">DEMO-CS-01</div></td>
      </tr></table>
      <table class="pfas-coa-info">
        <tr><td><div class="k" i18n:translate="">Client</div><div class="v" tal:content="smp/client"></div></td>
            <td><div class="k" i18n:translate="">Contact</div><div class="v" tal:content="smp/contact"></div></td>
            <td><div class="k" i18n:translate="">Matrix</div><div class="v" tal:content="smp/matrix"></div></td>
            <td><div class="k" i18n:translate="">Batch</div><div class="v" tal:content="smp/batch"></div></td></tr>
        <tr><td><div class="k" i18n:translate="">Sampled</div><div class="v" tal:content="smp/sampled"></div></td>
            <td><div class="k" i18n:translate="">Received</div><div class="v" tal:content="smp/received"></div></td>
            <td><div class="k" i18n:translate="">Analysed</div><div class="v" tal:content="smp/analysed"></div></td>
            <td><div class="k" i18n:translate="">Certificate tier</div><div class="v" tal:content="smp/report_tier"></div></td></tr>
        <tr tal:condition="smp/composite|nothing"><td colspan="4"><div class="k" i18n:translate="">Composite</div>
            <div class="v" tal:content="smp/composite"></div></td></tr>
        <tr tal:condition="smp/receipt|nothing"><td colspan="4"><div class="k" i18n:translate="">Receipt</div>
            <div class="v" tal:content="smp/receipt"></div></td></tr>
        <tr tal:condition="smp/blank_subtracted|nothing"><td colspan="4"><div class="k" i18n:translate="">Method blank</div>
            <div class="v" i18n:translate="">Results are corrected for the batch's method blank.</div></td></tr>
      </table>

      <!-- the method heads its results in a solid band -->
      <div class="pfas-coa-band"><span class="k" i18n:translate="">Method</span>
        <span tal:content="smp/method">EPA 537.1</span>
        <!-- a code the batch or report carries: beside the results heading, its legend line below -->
        <span class="pfas-coa-batch" tal:condition="smp/batch_codes|nothing"
              tal:content="python:u', '.join(smp['batch_codes'])">B</span></div>
      <!-- the lab's column order: Analyte, CAS, Result in the matrix's
           unit, Qualifier, MDL, RL, Dilution; an MDL never set prints a dash -->
      <table class="pfas-coa-res">
        <thead>
          <tr>
            <th i18n:translate="">Analyte</th>
            <th tal:condition="python:smp['fmt'].get('coa_show_cas')" i18n:translate="">CAS No.</th>
            <th class="num"><span i18n:translate="">Result</span>
              <tal:u condition="smp/result_unit|nothing">(<tal:x content="smp/result_unit">ng/L</tal:x>)</tal:u></th>
            <th i18n:translate="">Qual</th>
            <th class="num" tal:condition="python:smp['fmt'].get('coa_show_mdl')" i18n:translate="">MDL</th>
            <th class="num" i18n:translate="">RL</th>
            <th class="num" tal:condition="python:smp['fmt'].get('coa_show_dilution')" i18n:translate="">Dil.</th>
          </tr>
        </thead>
        <tbody>
          <tr tal:repeat="r smp/rows" tal:attributes="class python:'det' if r['detected'] else ''">
            <td tal:content="r/title">PFOA</td>
            <td tal:condition="python:smp['fmt'].get('coa_show_cas')" tal:content="r/cas">335-67-1</td>
            <td class="num res" tal:content="r/result">4.2</td>
            <td tal:content="r/qualifiers"></td>
            <td class="num" tal:condition="python:smp['fmt'].get('coa_show_mdl')"><tal:m
                condition="r/mdl" content="r/mdl"></tal:m><tal:m condition="not:r/mdl">&mdash;</tal:m></td>
            <td class="num" tal:content="r/rl"></td>
            <td class="num" tal:condition="python:smp['fmt'].get('coa_show_dilution')" tal:content="r/dilution"></td>
          </tr>
        </tbody>
      </table>
      <div class="pfas-coa-note" tal:condition="smp/fmt/coa_note" tal:content="smp/fmt/coa_note">Standard note</div>
      <!-- the key: what bold, U, MDL and each code in use mean, boxed; on a
           page of its own where the issued revision says so -->
      <div tal:attributes="class python:'pfas-coa-legend is-page' if smp.get('legend_page') else 'pfas-coa-legend'">
        <div class="h" i18n:translate="">Key</div>
        <span i18n:translate="">Detected results in bold.</span>
        <span i18n:translate="">U = not detected at or above the reporting limit (RL).</span>
        <span i18n:translate="">MDL = method detection limit.</span>
        <!-- a line per code on the page, in the lab's wording (coa_format.legend_lines) -->
        <tal:c repeat="c smp/legend_codes|nothing"><span tal:content="c/line">J = estimated.</span> </tal:c>
        <span tal:condition="not:smp/any_rl" class="pfas-coa-error" i18n:translate="">
          No reporting limits are configured for this method and matrix.</span>
      </div>

      <!-- Surrogates and internal standards: the worker's own verdicts,
           neat injection only (coa_qc_standards.py). -->
      <table class="pfas-coa-res pfas-coa-qcstd" tal:define="qs smp/qc_standards">
        <caption i18n:translate="">Surrogate and internal-standard quality control</caption>
        <thead tal:condition="qs/rows">
          <tr>
            <th tal:condition="python:qs['injections'] &gt; 1" i18n:translate="">Injection</th>
            <th i18n:translate="">Isotope standard</th>
            <th i18n:translate="">Role</th>
            <th i18n:translate="">Measured as</th>
            <th class="num" i18n:translate="">Value (%)</th>
            <th class="num" i18n:translate="">Window (%)</th>
            <th i18n:translate="">Status</th>
          </tr>
        </thead>
        <tbody tal:condition="qs/rows">
          <tr tal:repeat="q qs/rows" tal:attributes="class python:'out' if q['flag'] else ''">
            <td tal:condition="python:qs['injections'] &gt; 1" tal:content="q/injection">DEMO-0001</td>
            <td tal:content="q/standard">13C2-PFDA</td>
            <td tal:content="q/role">Surrogate (SUR)</td>
            <td tal:content="q/measure">% recovery</td>
            <td class="num" tal:content="q/value">98.4</td>
            <td class="num" tal:content="q/window">70-130</td>
            <td class="st" tal:content="q/status">Within</td>
          </tr>
        </tbody>
      </table>
      <div class="pfas-coa-note" tal:content="smp/qc_note">Quality control data specific to this sample</div>
      <div class="pfas-coa-note" tal:condition="smp/qc_error"><strong i18n:translate="">
        The surrogate and internal-standard results could not be read.</strong></div>

      <div class="pfas-coa-note pfas-coa-qs" tal:condition="smp/qs" tal:content="smp/qs">Quality system statement</div>
      <div class="pfas-coa-note pfas-coa-dep" tal:condition="smp/departures|nothing">
        <span i18n:translate="">Quality control criteria for project</span>
        <tal:p replace="smp/project_label">ACME</tal:p>
        <span i18n:translate="">less stringent than the laboratory method:</span>
        <tal:d repeat="d smp/departures"><span tal:replace="d/what">LFSM recovery max %</span>
          <span tal:replace="d/project">140</span> (<span i18n:translate="">method</span>
          <span tal:replace="d/method">135</span>; <span tal:replace="d/where">PFOA in Eggs</span>)<tal:s condition="not:repeat/d/end">; </tal:s></tal:d>.
      </div>

      <!-- Regulatory comparison (verified limits only; regulatory_limits.py). -->
      <div class="pfas-coa-reg" tal:define="reg smp/regulatory" tal:condition="reg">
        <div class="h" i18n:translate="">Regulatory comparison</div>
        <tal:f repeat="f reg/findings">
          <div class="finding" tal:attributes="class python:'finding ' + f['status']">
            <strong tal:content="f/label">PFOA</strong>:
            <tal:e condition="python:f['status'] == 'exceeds'">
              <span tal:content="f/total">5.2 ng/L</span><tal:s condition="f/sum"> (sum of detected values)</tal:s>
              <strong i18n:translate="">meets or exceeds</strong> the
            </tal:e>
            <tal:u condition="python:f['status'] == 'undetermined'">
              <span i18n:translate="">not all contributing analytes were detected at a reporting limit below the</span>
            </tal:u>
            <tal:x condition="python:f['status'] == 'no_unit'">
              <span i18n:translate="">not compared: the result unit cannot be converted to that of the</span>
            </tal:x>
            <span tal:content="string:${f/program} ${f/kind}">US EPA MCL</span>
            of <span tal:content="f/limit">4 ng/L</span><tal:u condition="python:f['status'] == 'undetermined'">;
              <span i18n:translate="">compliance cannot be determined</span></tal:u>.
            <span class="cite" tal:condition="f/citation" tal:content="string:(${f/citation})"></span>
            <em class="cite" tal:condition="f/note" tal:content="f/note"></em>
          </div>
        </tal:f>
        <div tal:condition="python:reg['below'] and reg['findings']" i18n:translate="">
          All other results compared are below the applicable limits.</div>
        <div tal:condition="python:reg['below'] and not reg['findings']" i18n:translate="">
          All results compared are below the applicable limits.</div>
        <div tal:condition="reg/test_data|nothing" i18n:translate="">
          DEMO test data: a limit compared here is an invented value, not a regulatory limit.</div>
        <div class="links" tal:condition="reg/links">
          <span i18n:translate="">For more information:</span>
          <tal:l repeat="l reg/links"><a tal:attributes="href l/url" tal:content="l/label">EPA</a><tal:c condition="not:repeat/l/end"> &middot; </tal:c></tal:l>
        </div>
      </div>
      </tal:ok>
    </div>
  </div>
</tal:samples>

<tal:footer condition="python:sec == 'footer'">
  <!-- the foot of every page: the laboratory's accreditation status on the
       left, the page number in the centre (the page's own counter,
       print_doc.CERTIFICATE_PAGE_CSS), its template
       revision on the right -->
  <div tal:attributes="class string:row section-footer no-gutters pfas-coa-foot ${view/variant}">
    <div id="footer-line"></div>
    <table class="pfas-coa-foot-row" tal:define="meta view/doc_meta"><tr>
      <td class="l" tal:content="lab/accreditation">ISO/IEC 17025</td>
      <td class="c"></td>
      <td class="r"><tal:t condition="meta/template_rev"><tal:l
          i18n:translate="">Template revision</tal:l> <tal:v replace="meta/template_rev">3</tal:v></tal:t></td>
    </tr></table>
  </div>
</tal:footer>
</tal:coa>
