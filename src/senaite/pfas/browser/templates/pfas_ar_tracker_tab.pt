<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="here/main_template/macros/master">

<metal:content-core fill-slot="content-core"
                    tal:define="info view/tracker_info">

  <div class="pfas-card pfas-card-narrow">
    <div class="pfas-card-head">
      <span><i class="fas fa-map-marker-alt pfas-text-accent"></i>
        <strong>PFAS Sample Tracker</strong></span>
    </div>

    <!-- Has tracking number -->
    <tal:hasnum tal:condition="info/tracking_number">
      <div class="pfas-muted">Tracking number<tal:h tal:condition="info/held_by">
        (the slip of <span tal:replace="info/held_by">DW-0012</span>, re-analysed here)</tal:h></div>
      <div class="pfas-id pfas-tracking-number" tal:content="info/tracking_number">
        PF-260611-A3K9
      </div>
      <div class="pfas-btn-row">
        <a class="btn btn-sm btn-secondary" tal:attributes="href info/tracker_url" target="_blank">Open client tracker &#8599;</a>
        <a class="btn btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-receipt?t=${info/tracking_number}">Print receipt</a>
      </div>
    </tal:hasnum>

    <!-- No tracking number yet -->
    <div class="pfas-muted" tal:condition="not:info/tracking_number">
      No tracking number yet: one is issued when the sample is received.
    </div>
  </div>

</metal:content-core>
</html>
