<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Data Review</title>

  <tal:styles metal:fill-slot="head-extra">
    <!-- value provenance: the drawer behind every number -->
    <meta name="pfas-batch-id" tal:attributes="content view/batch_id" />
    <meta name="pfas-provenance-url" tal:attributes="content string:${context/portal_url}/@@pfas-provenance" />
    <link rel="stylesheet" type="text/css"
          tal:attributes="href string:${context/portal_url}/++resource++senaite.pfas/provenance.css?v=${context/@@pfas-macros/asset_version}" />
    <script tal:attributes="src string:${context/portal_url}/++resource++senaite.pfas/provenance.js?v=${context/@@pfas-macros/asset_version}"></script>
  <style>
    /* ── Data Review ────────────────────────────────────────────────────── */
    .dr-header { display:flex; align-items:center; gap:10px; margin-bottom:18px; flex-wrap:wrap; }
    .dr-batch-title { font-size:var(--fs-lg); font-weight:700; color:var(--s-text); }
    .ws-badge { font-size:var(--fs-xs); font-weight:700; text-transform:uppercase;
                padding:3px 9px; border-radius:10px; }
    .ws-open    { background:var(--s-warn-lt); color:var(--s-warn-text); }
    .ws-verify  { background:var(--s-info-lt); color:var(--s-info-text); }
    .ws-verified{ background:var(--s-success-lt); color:var(--s-success-text); }
    .ws-other   { background:var(--s-light); color:var(--s-secondary); }

    /* the tab strip is the shared segmented control (pfas-components.css) */
    .dr-tabs { margin-bottom: var(--sp-5); }
    /* the warnings strip: its count line, open on the Overview, folded elsewhere */
    .dr-strip { margin:0 0 var(--sp-4); border:1px solid var(--line); border-radius:var(--radius-card);
                background:var(--surface-raised); }
    .dr-strip-head { display:flex; align-items:center; gap:var(--sp-3); padding:var(--sp-2) var(--sp-4); }
    .dr-strip-count { flex:1; }
    .dr-strip[data-open="false"] .dr-strip-body { display:none; }
    .dr-strip-lines { margin:var(--sp-1) 0 0; padding-left:var(--sp-5); }
    .dr-verdict { display:flex; flex-wrap:wrap; align-items:center; gap:var(--sp-3); margin-bottom:var(--sp-4); }
    .dr-path { margin:0 0 var(--sp-4); padding:var(--sp-3) var(--sp-4); border:1px solid var(--line);
               border-radius:var(--radius-card); background:var(--surface-raised); }
    .dr-path-title { display:block; margin-bottom:var(--sp-2); }
    .dr-path-nodes { display:flex; flex-wrap:wrap; align-items:center; gap:var(--sp-2); }
    .dr-path-sep { color:var(--text-muted); }
    .dr-path-dash { display:inline-block; width:24px; border-top:2px dashed var(--line-strong); }
    .dr-path-next { border-style:dashed; background:transparent; color:var(--text-muted); }
    .dr-card { margin:0 0 var(--sp-4); padding:var(--sp-4); }
    .dr-card-title { margin:0 0 var(--sp-3); font-size:var(--fs-md); }
    .dr-card-actions { display:flex; flex-wrap:wrap; align-items:center; gap:var(--sp-3); margin-top:var(--sp-3); }
    .dr-inline-form { display:flex; align-items:center; gap:var(--sp-2); margin:0; }
    .dr-initials { width:84px; text-transform:uppercase; }
    .dr-corr-form { display:flex; flex-wrap:wrap; align-items:flex-end; gap:var(--sp-4); }
    .dr-corr-form label { display:flex; flex-direction:column; gap:4px; font-size:var(--fs-xs); color:var(--s-secondary); }
    .dr-corr-form .pfas-input, .dr-corr-form .pfas-select { height:var(--ctl-h); box-sizing:border-box; }
    .dr-corr-reason .pfas-input { width:260px; }
    .dr-signed-as { display:inline-flex; align-items:center; height:var(--ctl-h); font-weight:var(--fw-strong); }
    .dr-request-form { display:flex; flex-wrap:wrap; align-items:flex-end; gap:var(--sp-4); margin-bottom:var(--sp-3); }
    .dr-request-form label { display:flex; flex-direction:column; gap:4px; font-size:var(--fs-xs); color:var(--s-secondary); }
    .dr-request-form .pfas-select, .dr-request-form .pfas-input { height:var(--ctl-h); box-sizing:border-box; border-radius:var(--radius); }
    .dr-request-form input[name=fold] { width:90px; }
    .dr-request-why .pfas-input { width:280px; }
    .dr-ask-choose { flex-basis:100%; margin:0; font-weight:var(--fw-strong); }
    .fd-note { font-size:var(--fs-xs); color:var(--s-secondary); }
    /* an isomer sum's parts: a muted line under the value, joined to its row */
    tr.fd-has-parts td { border-bottom-color:transparent; }
    tr.fd-parts td { padding-top:0; color:var(--text-muted); font-size:var(--fs-sm); }
    .dr-common { margin:0 0 var(--sp-3); }
    .dr-old { text-decoration:line-through; color:var(--s-danger-dk); }
    .fd-qual { font-weight:var(--fw-strong); cursor:help; border-bottom:1px dotted var(--line-strong); }
    .fd-qual[role=button] { cursor:pointer; }
    .ir-upload-row { display:flex; justify-content:center; align-items:center; gap:var(--sp-4); margin-top:var(--sp-3); }
    .dr-mi > li { display:flex; flex-wrap:wrap; align-items:center; gap:var(--sp-3); }
    .dr-tab-pane { display:none; }
    .dr-tab-pane.active { display:block; }

    /* checklist */
    .cl-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:24px; }
    @media (max-width:700px) { .cl-grid { grid-template-columns:1fr; } }
    .cl-card { border:1px solid var(--s-border); border-radius:8px; padding:14px 16px;
               background: var(--surface-raised); display:flex; flex-direction:column; gap:6px; }
    .cl-card.pass { border-left:4px solid var(--s-success); }
    .cl-card.fail { border-left:4px solid var(--s-danger); }
    .cl-card.blocked { border-left:4px solid var(--s-warning); }
    .cl-card.pending { border-left:4px solid var(--s-border); }
    .cl-badge.cl-blocked { background:var(--s-warn-lt); color:var(--s-warn-text); }
    .cl-badge.cl-pending { background:var(--surface-2); color:var(--s-secondary); }
    .cl-qualified { margin-left:var(--sp-1); color:var(--text-muted); font-size:var(--fs-xs); }
    .cl-card-reason { font-size:var(--fs-xs); color:var(--s-warn-text); margin-top:6px;
                      line-height:1.45; }
    .cl-card-title { font-size:var(--fs-base); font-weight:700; color:var(--s-text); }
    .cl-card-sub   { font-size:var(--fs-xs); color:var(--s-secondary); }
    .cl-badge { font-size:var(--fs-xs); font-weight:700; text-transform:uppercase; padding:2px 7px;
                border-radius:8px; display:inline-block; }
    .cl-pass { background:var(--s-success-lt); color:var(--s-success-text); }
    .cl-fail { background:var(--s-danger-lt); color:var(--s-danger-dk); }
    .cl-auto { background:var(--s-info-lt); color:var(--s-info-text); }
    .cl-manual { background:var(--s-warn-lt); color:var(--s-warn-text); }

    /* action bar */
    .dr-action-bar { display:flex; gap:10px; align-items:center; flex-wrap:wrap;
                     padding:14px 0; border-top:1px solid var(--s-border); margin-top:8px; }

    /* msg */
    .dr-msg { padding:10px 14px; border-radius:6px; margin-bottom:14px; font-size:var(--fs-base); }
    .dr-msg.ok    { background:var(--s-success-lt); color:var(--s-success-text); }
    .dr-msg.error { background:var(--s-danger-lt); color:var(--s-danger-dk); }

    /* submission info */
    .dr-sig-row { font-size:var(--fs-sm); color:var(--s-secondary); }
    .dr-sig-row strong { color:var(--s-text); }

    /* traceability */
    .tree-section { margin-bottom:22px; }
    .tree-heading { font-size:var(--fs-base); font-weight:700; color:var(--s-text); margin-bottom:10px;
                    padding-bottom:4px; border-bottom:1px solid var(--s-border); }
    .tree-row  { display:grid; grid-template-columns:180px 1fr; gap:8px; padding:6px 0;
                 border-bottom:1px solid var(--line); font-size:var(--fs-sm); }
    .tree-label { font-weight:600; color:var(--s-secondary); }
    .tree-val   { color:var(--s-text); }
    .tree-sub   { padding-left:20px; }
    .tree-unresolved { color: var(--s-danger-dk); font-weight:600; }
    .tree-warn-box { background:var(--s-danger-lt); color:var(--s-danger-dk); padding:10px 14px; border-radius:6px;
                     margin-bottom:14px; font-size:var(--fs-sm); }
    .tree-warn-box.is-pending { background:var(--s-warn-lt); color:var(--s-warn-text); border-left:4px solid var(--s-warning); }

    /* instrument report */
    .ir-file-list { margin-bottom:20px; }
    .ir-file-row { display:flex; align-items:center; gap:10px; padding:8px 0;
                   border-bottom:1px solid var(--s-border); font-size:var(--fs-sm); }
    .ir-file-name { flex:1; font-weight:600; color:var(--s-text); }
    .ir-upload-box { border:2px dashed var(--s-border); border-radius:8px; padding:20px;
                     text-align:center; background:var(--s-bg-alt); margin-bottom:20px; }
    .ir-upload-box label { font-size:var(--fs-base); font-weight:600; cursor:pointer; color: var(--s-primary-dk); }

    .csv-preview-wrap { overflow:auto; max-height:400px; margin-top:14px; }
    .csv-preview { border-collapse:collapse; font-size:var(--fs-xs); }
    .csv-preview th { background:var(--s-input-text); color:var(--on-accent); padding:4px 8px; }
    .csv-preview td { padding:3px 8px; border-bottom:1px solid var(--s-border); }

    /* CoC */
    .coc-summary { display:grid; grid-template-columns:1fr 1fr; gap:10px 20px;
                   font-size:var(--fs-base); margin-bottom:18px; }
    .coc-field  { display:flex; flex-direction:column; gap:2px; }
    .coc-label  { font-size:var(--fs-xs); color:var(--s-secondary); text-transform:uppercase; }
    .coc-value  { font-weight:600; color:var(--s-text); }
    .coc-bool-ok { color: var(--s-success-text); }
    .coc-bool-fail { color: var(--s-danger-dk); }
      /* Extraction tab */
    .dr-extraction-flags ul { margin:4px 0 8px 18px; }
    .dr-ext-head { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:14px; }
    .dr-section-h { font-size:var(--fs-base); margin:18px 0 8px; }
    .dr-stage { border:1px solid var(--s-border); border-radius:8px; padding:10px 14px; margin-bottom:10px; }
    .dr-stage-h { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:6px; }
    .dr-stage-meta { color:var(--s-secondary); font-size:var(--fs-sm); }
    .dr-line { font-size:var(--fs-sm); margin:4px 0; }
    .dr-warn { margin:2px 0 6px 18px; font-size:var(--fs-sm); }
    .dr-empty { color:var(--s-secondary); font-size:var(--fs-sm); }
</style>
  </tal:styles>
</head>
<body>

  <tal:t metal:fill-slot="header-title">
    Data Review
    <tal:batch tal:condition="view/batch_id">
      — <span tal:replace="view/batch_id">WS-ID</span>
    </tal:batch>
  </tal:t>

  <tal:r metal:fill-slot="header-context">
    <span class="pfas-chip" tal:condition="view/batch_id"><b tal:content="view/batch_id">WS-1</b><tal:m tal:condition="view/batch_method|nothing"><span class="pfas-chip-sep">&#183;</span><tal:x tal:replace="view/batch_method">EPA_537_1</tal:x></tal:m><span class="pfas-chip-sep">&#183;</span><span tal:attributes="class string:ws-badge ws-${view/ws_state}; title view/ws_state"
          tal:content="view/ws_state">open</span></span>
  </tal:r>

  <div metal:fill-slot="content">

  <!-- ── No worksheet selected ─────────────────────────────────────────── -->
  <tal:no_ws tal:condition="not:view/batch_id">
    <div class="page-body">
      <p class="pfas-muted">Open a worksheet&#8217;s review. Each row shows who has it and how long it has been open. <tal:h define="hid string:data-review"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></p>
      <!-- the review queue: compact rows, the worksheet id is the row's
           button, the stage a plain word -->
      <div class="table-wrap">
      <table class="pfas-table dr-queue" data-col-resize="data-review-dr-queue">
        <thead>
          <tr>
            <th>Worksheet</th>
            <th>Analyst</th>
            <th>Review status</th>
            <th class="is-right num">Open since extraction</th>
            <th class="is-right num">Time in review</th>
          </tr>
        </thead>
        <tbody>
          <tr tal:repeat="ws view/recent_worksheets">
            <td><a class="btn-sm btn-secondary" tal:attributes="href ws/url" tal:content="ws/id">WS</a>
              <span class="pfas-muted" tal:condition="python:ws['title'] and ws['title'] != ws['id']"
                    tal:content="ws/title">Title</span></td>
            <td tal:content="ws/analyst">Analyst</td>
            <td tal:content="ws/stage_label">With analyst</td>
            <td class="is-right num" tal:content="ws/open_age">2d 4h</td>
            <td class="is-right num"><tal:a tal:condition="ws/review_age" tal:replace="ws/review_age">5h 20m</tal:a><span
                class="pfas-muted" tal:condition="not:ws/review_age">not yet</span></td>
          </tr>
          <tr class="pfas-empty-row" tal:condition="not:view/recent_worksheets">
            <td colspan="5">No worksheets are currently open or awaiting review.</td>
          </tr>
        </tbody>
      </table>
      </div>
    </div>
  </tal:no_ws>

  <!-- ── Worksheet loaded ──────────────────────────────────────────────── -->
  <tal:with_ws tal:condition="view/batch_id">
  <div class="page-body">

    <!-- message flash -->
    <tal:msg tal:condition="view/save_message">
      <div tal:attributes="class string:dr-msg ${view/save_message_type}">
        <tal:m tal:replace="view/save_message_text">msg</tal:m>
      </div>
    </tal:msg>

    <!-- batch header row -->
    <div class="dr-header">
      <span class="dr-batch-title">
        <span tal:content="view/batch_id">WS-ID</span>
      </span>
      <!-- the worksheet opens here; its core grid is the Results entry tab -->
      <a class="btn-sm btn-secondary" tal:condition="view/batch_url"
         tal:attributes="href string:${view/batch_url}/manage_results">Results entry</a>
      <tal:method tal:condition="view/batch_method">
        <span class="cf-hint" tal:content="view/batch_method">method</span>
      </tal:method>
    </div>

    <!-- Warnings by severity, one strip under the title on every tab
         (view.warnings): the count of what blocks release in coral, the
         notes muted; open on the Overview, folded elsewhere. Opened, a
         table: Severity, What, and the button to where the fix is made.
         The accreditation notes are among them so no reviewer must open a
         particular tab to learn a report is outside accreditation. -->
    <div class="dr-strip" id="dr-strip"
         tal:define="warns view/warnings; wc python:view.warning_counts(warns); opened python:view.active_tab() == 'overview'"
         tal:condition="warns"
         tal:attributes="data-open python:'true' if opened else 'false'">
      <div class="dr-strip-head">
        <span class="dr-strip-count"><span tal:attributes="class python:'pfas-flag-text is-flag' if wc['blocks'] else None"
              tal:content="wc/blocks_text">1 blocks release</span> &#183; <span class="pfas-muted"
              tal:content="wc/notes_text">3 notes</span></span>
        <button type="button" class="btn-sm btn-secondary dr-strip-toggle" aria-controls="dr-strip-body"
                tal:attributes="aria-expanded python:'true' if opened else 'false'"
                tal:content="python:u'Hide' if opened else u'Show'">Hide</button>
      </div>
      <div class="dr-strip-body" id="dr-strip-body">
        <table class="pfas-table dr-strip-table" data-col-resize="data-review-dr-strip-table">
          <thead><tr><th>Severity</th><th>What</th><th>Fix</th></tr></thead>
          <tbody>
            <tr tal:repeat="w warns" tal:attributes="data-severity w/severity">
              <td><span tal:attributes="class python:'pfas-tag is-flag' if w['severity'] == 'blocks' else 'pfas-tag'"
                        tal:content="python:u'Blocks' if w['severity'] == 'blocks' else u'Note'">Note</span></td>
              <td><tal:x tal:replace="w/text">What the reviewer must read.</tal:x>
                <ul class="dr-strip-lines" tal:condition="w/lines">
                  <li tal:repeat="line w/lines" tal:content="line">departure</li>
                </ul></td>
              <td><a class="btn-sm btn-secondary" tal:condition="w/fix_url"
                     tal:attributes="href w/fix_url" tal:content="w/fix_label">QC criteria</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <script>
    /* the strip's toggle: open or fold for this visit, never remembered */
    (function () {
      var strip = document.getElementById('dr-strip');
      if (!strip) return;
      var btn = strip.querySelector('.dr-strip-toggle');
      btn.addEventListener('click', function () {
        var open = strip.getAttribute('data-open') !== 'true';
        strip.setAttribute('data-open', open ? 'true' : 'false');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.textContent = open ? 'Hide' : 'Show';
      });
    })();
    </script>

    <!-- tabs nav: the shared segmented control in links mode (no JS required;
         the server renders the active one; POST-back carries tab param) -->
    <nav class="pfas-seg pfas-seg-strip dr-tabs" aria-label="Review sections">
      <tal:tl tal:define="at view/active_tab;
                          tabs python:(('?tab=overview', u'Overview', u''), ('?tab=coc', u'Chain of Custody', u''),
                                       ('?tab=traceability', u'Traceability', u''),
                                       ('?tab=extraction', u'Extraction', u'The guided extraction of this worksheet\'s batch'),
                                       ('?tab=qc_summary', u'Blanks', u''), ('?tab=calibration', u'Calibration', u''),
                                       ('?tab=spike_qc', u'Spike QC', u'LFSM/LFSMD/LFB/LCS recovery + RPD'),
                                       ('?tab=final_data', u'Final Data', u''), ('?tab=instrument_report', u'Instrument Report', u'')) +
                                      ((('?tab=raw', u'Raw Data', u'The chromatograms this run was integrated from'),) if view.raw_available() else ()) +
                                      (('?tab=compare', u'Comparison', u'The run imported both ways'),)">
        <a class="pfas-seg-item" tal:repeat="t tabs"
           tal:attributes="href python:t[0]; title python:t[2] or None;
                           aria-selected python:'true' if at == t[0][5:] else 'false'"
           tal:content="python:t[1]">Overview</a>
      </tal:tl>
    </nav><!-- /dr-tabs -->


    <!-- ══════ OVERVIEW TAB ════════════════════════════════════════════ -->
    <div class="dr-tab-pane"
         tal:attributes="class python:'dr-tab-pane active' if view.active_tab() == 'overview' else 'dr-tab-pane'"
         tal:condition="python: view.active_tab() == 'overview'">

      <!-- Where this run sits: client, chain of custody, batch, worksheet and
           the stages reached, then a dashed "Run release" until it is done -->
      <div class="dr-path" tal:define="tree view/context_tree" tal:condition="tree">
        <strong class="dr-path-title">Where this run sits</strong>
        <div class="dr-path-nodes"
             tal:define="reached python:[st for st in tree['stages'] if st['status'] != 'pending'];
                         released python:bool([st for st in tree['stages'] if st['num'] == 4 and st['status'] == 'done'])">
          <a class="pfas-tree-node is-path" tal:condition="tree/client" tal:attributes="href tree/client/url"><tal:x tal:replace="tree/client/title">Client</tal:x> <small>Client</small></a>
          <tal:c tal:repeat="c tree/coc"><span class="dr-path-sep" aria-hidden="true">&#8250;</span><a class="pfas-tree-node is-path" tal:attributes="href c/url"><tal:x tal:replace="c/number">COC</tal:x> <small>Chain of custody</small>
            <span class="badge badge-opened" tal:condition="c/status" tal:content="c/status">received</span></a></tal:c>
          <tal:b tal:condition="tree/batch"><span class="dr-path-sep" aria-hidden="true">&#8250;</span><a class="pfas-tree-node is-path" tal:attributes="href tree/batch/url"><tal:x tal:replace="tree/batch/id">B-1</tal:x> <small>Batch</small></a></tal:b>
          <span class="dr-path-sep" aria-hidden="true">&#8250;</span><span class="pfas-tree-node is-selected"><tal:x tal:replace="tree/worksheet/id">WS</tal:x> <small>Worksheet</small>
            <span class="badge badge-quarantine" tal:content="tree/worksheet/state">state</span></span>
          <tal:st tal:repeat="st reached"><span class="dr-path-sep" aria-hidden="true">&#8250;</span><span
              tal:attributes="class python:'pfas-tree-node is-path' if st['status'] == 'done' else 'pfas-tree-node is-selected'">
              <tal:x tal:replace="st/label">Stage</tal:x> <small>Stage</small>
              <span class="badge badge-active" tal:condition="python:st['status'] == 'done'">done</span></span></tal:st>
          <tal:rel tal:condition="not:released"><span class="dr-path-dash" aria-hidden="true"></span><span
              class="pfas-tree-node dr-path-next">Run release <small>not yet</small></span></tal:rel>
          <tal:rel tal:condition="released"><span class="dr-path-sep" aria-hidden="true">&#8250;</span><span
              class="pfas-tree-node is-path">Run release <small>done</small></span></tal:rel>
        </div>
      </div>

      <div class="alert-warn dr-extraction-flags" tal:define="flags view/extraction_flags" tal:condition="flags">
        <strong>Extraction</strong> (must be finished):
        <ul><li tal:repeat="f flags" tal:content="f">x</li></ul>
        <a class="btn-sm btn-secondary" href="?tab=extraction">Open the extraction record</a>
      </div>

      <div class="cl-grid">
        <tal:cl tal:repeat="item view/checklist_status">
          <div tal:define="v item/verdict|string:pending"
               tal:attributes="class python:'cl-card ' + {
                  'pass': 'pass', 'qualified': 'pass', 'fail': 'fail',
                  'blocked': 'blocked'}.get(v, 'pending')">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;">
              <span class="cl-card-title" tal:content="item/label">Label</span>
              <span tal:attributes="class python:'cl-badge cl-auto' if item['auto'] else 'cl-badge cl-manual'"
                    tal:content="python:'Auto' if item['auto'] else 'Manual'">type</span>
            </div>
            <div tal:define="v item/verdict|string:pending">
              <!-- An automatic gate that ran and did not pass is a FAILURE;
                   one that could not run is BLOCKED. Both used to read
                   "PENDING", the state least likely to make anyone look.
                   A qualified pass is a PASS with its word after it. -->
              <span tal:attributes="class python:{
                      'pass': 'cl-badge cl-pass', 'qualified': 'cl-badge cl-pass',
                      'fail': 'cl-badge cl-fail',
                      'blocked': 'cl-badge cl-blocked'}.get(v, 'cl-badge cl-pending')"
                    tal:content="python:{
                      'pass': 'PASS', 'qualified': 'PASS', 'fail': 'FAIL',
                      'blocked': 'NOT EVALUATED'}.get(v, 'PENDING')">status</span><span
                    class="cl-qualified" tal:condition="python:v == 'qualified'">qualified</span>
              <div class="cl-card-reason" tal:condition="item/reason|nothing"
                   tal:content="item/reason">why</div>
            </div>
            <tal:meta tal:condition="item/checked_by">
              <div class="cl-card-sub">
                Reviewed by <strong tal:content="item/checked_by">user</strong>
                <tal:ini tal:condition="item/initials|nothing"
                         tal:define="sig python:view.signature_for(item.get('initials'))">
                  (<strong tal:content="item/initials">AN1</strong>)
                  <img tal:condition="sig/signature_url|nothing"
                       tal:attributes="src sig/signature_url; alt sig/fullname;
                                       title string:Signature — ${sig/fullname}"
                       style="height:26px;vertical-align:middle;margin-left:6px;"/>
                </tal:ini>
                at <tal:t tal:replace="python:view.lab_at(item.get('checked_at'), (item.get('checked_at') or '')[:16], u'%Y-%m-%dT%H:%M')">time</tal:t>
              </div>
            </tal:meta>
            <!-- mark button for manual items — sign-off requires initials -->
            <tal:manual_btn tal:condition="python:not item['auto'] and not item['checked'] and view.can_act()">
              <form method="post" style="display:flex;gap:6px;align-items:center;margin-top:4px;"
                    tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
                <input type="hidden" name="action" value="check_item"/>
                <input type="hidden" name="item_key"
                       tal:attributes="value item/key"/>
                <input type="hidden" name="tab" value="overview"/>
                <input type="text" name="initials" required="required"
                       placeholder="Initials" maxlength="6"
                       style="width:74px;padding:4px 6px;font-size:var(--fs-sm);border:1px solid var(--s-border);border-radius:4px;text-transform:uppercase;"/>
                <button class="btn btn-action" type="submit">
                  Sign &amp; Mark Reviewed
                </button>
              </form>
            </tal:manual_btn>
          </div>
        </tal:cl>
      </div>

      <!-- assign-before-submit process point -->
      <tal:asg tal:condition="python:view.needs_assignment() and view.can_act()">
        <div style="background:var(--s-warn-lt);border:1px solid var(--s-warn-bd);color:var(--s-warn-text);
                    border-radius:8px;padding:12px 16px;margin-bottom:16px;
                    display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
          <div style="flex:1;min-width:260px;font-size:var(--fs-sm);">
            <strong>No analyses are assigned to this worksheet.</strong>
            Assignment must happen <em>before</em> results are submitted —
            afterwards SENAITE's workflow forbids it (already-submitted
            analyses will be skipped and reviewed via the batch join instead).
          </div>
          <form method="post"
                tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
            <input type="hidden" name="action" value="assign_batch_samples"/>
            <input type="hidden" name="batch_id" tal:attributes="value view/batch_id"/>
            <button class="btn btn-warn btn-action" type="submit">
              Receive &amp; assign batch samples
            </button>
          </form>
        </div>
      </tal:asg>

      <!-- corrections noted in the final review (initialed + dated) -->
      <tal:ov_corr tal:define="corr view/corrections" tal:condition="corr">
        <div class="tree-section">
          <div class="tree-heading">Corrections on this worksheet</div>
          <div class="dr-sig-row" tal:repeat="c corr" style="padding:3px 0;">
            <strong tal:content="c/field">field</strong>:
            <span class="dr-old" tal:content="c/old">old</span>
            → <strong tal:content="c/new">new</strong>
            — <strong tal:content="c/initials">AN1</strong>
            (<span tal:content="c/user">user</span>), <span tal:content="python:view.lab_at(c.get('ts'), c.get('ts'))">date</span>
            <tal:r tal:condition="c/reason">· <em tal:content="c/reason">reason</em></tal:r>
          </div>
        </div>
      </tal:ov_corr>

      <!-- client-facing report (COA) — core senaite.impress, PFAS-wired -->
      <tal:coa tal:define="purl view/publish_url"
               tal:condition="python:purl and view.all_items_pass()">
        <div class="tree-section" tal:define="trev view/template_status; verified python: view.ws_state() == 'verified'">
          <div class="tree-heading">Issue certificate</div>
          <p class="dr-line">
            All five review gates passed.
            <tal:v tal:condition="not:verified">A manager still verifies before publishing.</tal:v>
            <tal:r tal:condition="trev">Certificate from reporting-template revision
              <strong tal:content="trev">3</strong>.</tal:r>
          </p>
          <p class="dr-line" tal:condition="not:trev">
            <span class="cl-badge cl-fail">No reporting template issued</span>
            Certificates cannot be published until a Manager issues one.
            <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-report-template">Reporting template</a>
          </p>
          <!-- no certificate layout issued: Issue certificate is held, its
               reason beside it (the publish guard and the certificate
               storage refuse the same) -->
          <p class="dr-line" tal:define="held view/certificate_layout_problem" tal:condition="python:trev and held">
            <button type="button" class="btn btn-success btn-approve" disabled="disabled"
                    aria-describedby="dr-coa-held">Issue certificate</button>
            <span class="text-danger" id="dr-coa-held" tal:content="held"></span>
            <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-report-template">Reporting Setup</a>
          </p>
          <tal:go tal:condition="python:trev and not view.certificate_layout_problem()">
          <p class="dr-line">SENAITE&#8217;s publisher opens with this worksheet&#8217;s samples: preview, publish and
            email the certificate there.</p>
          <!-- First issue: straight to the publisher. -->
          <a class="btn btn-success btn-approve"
             tal:condition="not:view/is_reissue"
             tal:attributes="href purl">Issue certificate →</a>

          <!-- Amended reissue (samples already published): capture the reason
               up front so the controlled register records why. -->
          <tal:reissue tal:condition="view/is_reissue">
            <div style="background:var(--s-warn-lt);border:1px solid var(--s-warn-bd);border-radius:6px;
                        padding:10px 12px;margin-top:6px;">
              <div style="font-weight:600;font-size:var(--fs-base);color:var(--s-warn-text);margin-bottom:6px;">
                Amended reissue — this sample was already published
              </div>
              <p style="font-size:var(--fs-sm);color:var(--s-secondary);margin:0 0 8px;">
                State the reason for reissuing. It is recorded against the new
                revision in the Controlled Publications register. The original
                report is not modified.
              </p>
              <form method="post" style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;"
                    tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
                <input type="hidden" name="action" value="record_amendment_reason"/>
                <input type="hidden" name="batch_uid"
                       tal:attributes="value view/batch_uid"/>
                <textarea name="reason" rows="2" required="required"
                          placeholder="Reason for reissuing this certificate"
                          style="flex:1;min-width:240px;font-size:var(--fs-sm);padding:4px 6px;"></textarea>
                <button type="submit" class="btn btn-success btn-approve">
                  Record reason &amp; issue certificate →
                </button>
              </form>
            </div>
          </tal:reissue>
          </tal:go>
        </div>
      </tal:coa>

      <!-- submission history -->
      <tal:sinfo tal:define="si view/submission_info">
        <div class="tree-section" tal:condition="si/submitted_by">
          <div class="tree-heading">Submission History</div>
          <div class="dr-sig-row">
            Submitted for review by <strong tal:content="si/submitted_by">user</strong>
            at <tal:t tal:replace="si/submitted_at">time</tal:t>
          </div>
          <div class="dr-sig-row" tal:condition="si/approved_by">
            Approved by <strong tal:content="si/approved_by">user</strong>
            at <tal:t tal:replace="si/approved_at">time</tal:t>
          </div>
        </div>
      </tal:sinfo>

      <!-- the changes made on the Raw Data tab: a reason each and the
           analyst's initials once, before submit; countersigned at release -->
      <section class="bench-block" id="dr-manual-changes"
               tal:define="mc view/manual_changes; edit python:view.can_act() and view.ws_state() == 'open'"
               tal:condition="mc/rows">
        <h2 class="bench-h">Manual changes</h2>
        <ul class="bench-alerts">
          <li tal:attributes="class python:'bench-ok' if mc['ok'] else 'bench-bad'">
            <strong tal:content="python:('%d initialled' % mc['initialled']) if mc['ok'] else 'Not ready to submit'">Not ready</strong>
            <span tal:condition="not:mc/ok" tal:content="python:'; '.join(mc['missing'])">missing</span>
            <span tal:condition="python:mc['ok'] and not mc['verify_ok']">: Approve Release countersigns them; the verifier is a different person.</span>
          </li>
        </ul>
        <form method="post" tal:attributes="action string:${view/ws_url}/@@pfas-data-review">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="action" value="save_manual_changes" />
          <table class="pfas-table pfas-table-form pfas-table-fit" data-col-resize="data-review-manual-changes">
            <thead><tr><th>Injection</th><th>Analyte</th><th>Transition</th><th>Change</th>
                       <th>Automatic &#8594; now</th><th>Reason</th><th>Initials</th><th>Countersigned</th>
                       <th></th></tr></thead>
            <tbody>
              <tr tal:repeat="r mc/rows" tal:attributes="data-change r/id">
                <td tal:content="r/injection">S-1</td>
                <td tal:content="r/analyte">PFOA</td>
                <td tal:content="r/transition">quantifier</td>
                <td tal:content="r/kind">re-integrated</td>
                <td tal:content="r/summary">4.10 to 4.40 min</td>
                <td tal:condition="r/no_effect" tal:content="r/no_effect">No effect</td>
                <td tal:condition="not:r/no_effect">
                  <tal:e tal:condition="python:edit and not r['analyst']">
                    <select tal:attributes="name string:${r/id}.reason_id">
                      <option value="">Choose a reason</option>
                      <option tal:repeat="o r/choices" tal:content="o/text"
                              tal:attributes="value o/id; selected python:'selected' if o['id'] == r['reason_id'] else None">reason</option>
                    </select>
                    <input type="text" placeholder="Detail"
                           tal:attributes="name string:${r/id}.detail; value r/detail" />
                  </tal:e>
                  <tal:v tal:condition="python:not edit or r['analyst']"
                         tal:content="python:(r['reason'] + (': ' + r['detail'] if r['detail'] else '')) if r['reason'] else 'not given'">reason</tal:v>
                </td>
                <td tal:content="python:'not needed' if r['no_effect'] else r['analyst']['initials'] if r['analyst'] else 'not initialled'">AN1</td>
                <td tal:content="python:'not needed' if r['no_effect'] else r['verifier']['name'] if r['verifier'] else 'not countersigned'">AN2</td>
                <td><a class="btn-sm btn-secondary"
                       tal:attributes="href r/href">Open in Raw Data</a></td>
              </tr>
            </tbody>
          </table>
          <div class="pfas-action-bar"
               tal:condition="python:edit and [r for r in mc['rows'] if not r['no_effect'] and not r['analyst']]">
            <label>Initials <input type="text" name="initials" maxlength="6" /></label>
            <button type="submit" class="btn btn-primary">Save</button>
          </div>
        </form>
      </section>

      <!-- action bar -->
      <div class="dr-action-bar">
        <!-- Analyst: submit when all pass and ws is open -->
        <tal:submit_btn
            tal:condition="python:view.can_act() and view.ws_state() == 'open'">
          <form method="post"
                tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
            <input type="hidden" name="action" value="submit_for_review"/>
            <button class="btn btn-primary btn-submit" type="submit"
                    tal:attributes="disabled python:None if view.all_items_pass() else 'disabled'">
              Submit for Review
            </button>
          </form>
          <tal:incomplete tal:condition="not:view/all_items_pass">
            <span style="font-size:var(--fs-sm);color: var(--s-danger-dk);">
              Complete all checklist items before submitting.
            </span>
          </tal:incomplete>
        </tal:submit_btn>

        <!-- Manager: approve or reject when to_be_verified -->
        <tal:mgr_btns
            tal:condition="python:view.is_manager() and view.ws_state() == 'to_be_verified'">
          <form method="post"
                tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
            <input type="hidden" name="action" value="approve_release"/>
            <button class="btn btn-success btn-approve" type="submit"
                    tal:attributes="disabled python:None if view.all_items_pass() else 'disabled'">Approve Release</button>
            <span class="text-danger" tal:condition="not:view/all_items_pass">The checklist no longer passes: send it back.</span>
          </form>
          <form method="post"
                tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
            <input type="hidden" name="action" value="reject"/>
            <button class="btn btn-danger btn-reject" type="submit">Reject / Send Back</button>
          </form>
        </tal:mgr_btns>
      </div>

    </div><!-- /overview -->

    <!-- ══════ COC TAB ══════════════════════════════════════════════════ -->
    <div class="dr-tab-pane"
         tal:attributes="class python:'dr-tab-pane active' if view.active_tab() == 'coc' else 'dr-tab-pane'"
         tal:condition="python: view.active_tab() == 'coc'">

      <!-- a study run: no chain of custody; the study's matrix source instead -->
      <tal:study tal:condition="view/study_run"><tal:d tal:define="chk view/study_source_check; d python:chk[3]">
        <div class="coc-summary">
          <div class="coc-field">
            <span class="coc-label">Method study</span>
            <span class="coc-value" tal:content="string:${d/study} part ${d/part}">MS-0001 part P1</span>
          </div>
          <div class="coc-field">
            <span class="coc-label">Matrix source</span>
            <span class="coc-value" tal:content="d/source_label">In-house reagent water system</span>
          </div>
          <div class="coc-field">
            <span class="coc-label" tal:content="python:chk[0]">Reference sample receipt</span>
            <span tal:attributes="class python:'coc-value coc-bool-ok' if chk[1] == 'pass' else 'coc-value coc-bool-fail'"
                  tal:content="python:u'Pass' if chk[1] == 'pass' else chk[2]">Pass</span>
          </div>
          <div class="coc-field">
            <span class="coc-label">Extraction date</span>
            <span class="coc-value" tal:content="python:d['use_date'] or u'not recorded'">date</span>
          </div>
          <div class="coc-field" tal:condition="d/water_check">
            <span class="coc-label">Reagent-water check</span>
            <span class="coc-value" tal:content="python:u'%s %s by %s: %s' % (d['water_check'].get('log_date'), d['water_check'].get('log_time'), d['water_check'].get('operator'), u'passed' if d['water_check'].get('passed') else u'FAILED')">passed</span>
          </div>
          <div class="coc-field" tal:condition="d/lot">
            <span class="coc-label">Lot</span>
            <span class="coc-value" tal:content="python:u'%s %s, received %s, expires %s' % (d['lot'].get('name'), d['lot'].get('lot_number'), d['lot'].get('received') or u'\u2014', d['lot'].get('expiry') or u'\u2014')">lot</span>
          </div>
          <div class="coc-field" tal:condition="d/receipt">
            <span class="coc-label">Receipt</span>
            <span class="coc-value" tal:content="python:u'%s; %s; %s' % (d['receipt'].get('received_by'), d['receipt'].get('condition'), d['receipt'].get('provider_ref') or u'')">receipt</span>
          </div>
        </div>
        <div>
          <a class="btn-sm btn-secondary" tal:condition="python:d['source'].get('kind') == 'reference_lot'"
             tal:attributes="href string:${view/portal_url}/@@pfas-method-studies#rm-${d/source/uid}">Receipt record</a>
          <a class="btn-sm btn-secondary" target="_blank" tal:condition="d/coa"
             tal:attributes="href string:${view/portal_url}/@@pfas-reagents?action=coa&amp;uid=${d/source/uid}">View CoA</a>
          <a class="btn-sm btn-secondary" tal:condition="d/study"
             tal:attributes="href string:${view/portal_url}/@@pfas-method-studies?id=${d/study}">Open study</a>
        </div>
      </tal:d></tal:study>

      <tal:routine tal:condition="not:view/study_run">
      <tal:coc_data tal:define="coc view/coc_summary">

      <!-- one card per subject, each headed -->
      <section class="pfas-card dr-card">
        <h3 class="dr-card-title">Chain of custody</h3>
        <table class="pfas-table" data-col-resize="data-review-1" tal:define="crs python:(coc or {}).get('records')" tal:condition="crs">
          <thead><tr><th>CoC</th><th>Status</th><th>Receipt flags</th><th></th></tr></thead>
          <tbody><tr tal:repeat="c crs">
            <td tal:content="c/number">COC-2026-0001</td>
            <td tal:content="python:c['status'].capitalize()">Received</td>
            <td tal:content="python:u'; '.join(c['flags']) + ((u' ' + c['note']) if c['flags'] else u'')">x</td>
            <td><a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-coc?coc=${c/number}">Open</a></td>
          </tr></tbody>
        </table>
        <div class="dr-card-actions">
          <a class="btn btn-secondary" target="_blank"
             tal:attributes="href string:${view/batch_url}/@@pfas-coc-document">Print CoC</a>
          <a class="btn btn-secondary"
             tal:attributes="href string:${view/batch_url}/@@pfas-logbook-dynamic?slug=coc">Open CoC form</a>
          <tal:coc_check_btn
              tal:condition="python:not [i for i in view.checklist_status() if i['key']=='coc' and i['checked']] and view.can_act()">
            <form method="post" class="dr-inline-form"
                  tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
              <input type="hidden" name="action" value="check_item"/>
              <input type="hidden" name="item_key" value="coc"/>
              <input type="hidden" name="tab" value="coc"/>
              <input type="text" name="initials" required="required" placeholder="Initials" maxlength="6" class="dr-initials"/>
              <button class="btn btn-action" type="submit">Mark CoC reviewed</button>
            </form>
          </tal:coc_check_btn>
        </div>
      </section>

      <tal:with_coc tal:condition="coc/client_name|nothing">
      <section class="pfas-card dr-card">
        <h3 class="dr-card-title">Receipt</h3>
        <div class="coc-summary">
          <div class="coc-field">
            <span class="coc-label">Client / Submitter</span>
            <span class="coc-value" tal:content="coc/client_name">—</span>
          </div>
          <div class="coc-field">
            <span class="coc-label">Project</span>
            <span class="coc-value"
                  tal:content="python:(coc.get('project_name') or '') + (' / ' + coc.get('project_number') if coc.get('project_number') else '')">—</span>
          </div>
          <div class="coc-field">
            <span class="coc-label">Sample collection date</span>
            <span class="coc-value" tal:content="coc/sample_collection_date|string:—">—</span>
          </div>
          <div class="coc-field">
            <span class="coc-label">Received by lab</span>
            <span class="coc-value"
                  tal:content="python:(coc.get('lab_received_by') or '') + (' on ' + coc.get('lab_received_date') if coc.get('lab_received_date') else '')">—</span>
          </div>
          <div class="coc-field">
            <span class="coc-label">Seals intact</span>
            <span tal:attributes="class python:'coc-value coc-bool-ok' if coc.get('seals_intact') else 'coc-value coc-bool-fail'"
                  tal:content="python:'Yes' if coc.get('seals_intact') else 'No'">No</span>
          </div>
          <div class="coc-field">
            <span class="coc-label">Labels legible</span>
            <span tal:attributes="class python:'coc-value coc-bool-ok' if coc.get('labels_legible') else 'coc-value coc-bool-fail'"
                  tal:content="python:'Yes' if coc.get('labels_legible') else 'No'">No</span>
          </div>
          <div class="coc-field" tal:define="nc python:coc.get('n_containers', 0); nt python:coc.get('n_transfers', 0)">
            <span class="coc-label">Containers / Transfers</span>
            <span class="coc-value"
                  tal:content="python:u'%s container%s, %s transfer%s' % (nc, u'' if nc == 1 else u's', nt, u'' if nt == 1 else u's')">—</span>
          </div>
          <tal:cond_notes tal:condition="coc/condition_notes|nothing">
            <div class="coc-field" style="grid-column:1/-1;">
              <span class="coc-label">Condition notes</span>
              <span class="coc-value" tal:content="coc/condition_notes">—</span>
            </div>
          </tal:cond_notes>
          <tal:reviewed_by tal:condition="coc/reviewed_by|nothing">
            <div class="coc-field">
              <span class="coc-label">Reviewed by (QAO)</span>
              <span class="coc-value"
                    tal:content="python:(coc.get('reviewed_by') or '') + (' on ' + coc.get('reviewed_date') if coc.get('reviewed_date') else '')">—</span>
            </div>
          </tal:reviewed_by>
        </div>
      </section>

      <!-- the dates, not the rule: collected, extract by, extracted, time used -->
      <section class="pfas-card dr-card" tal:define="ht view/holding_time_summary; htr view/holding_time_rows">
        <h3 class="dr-card-title">Holding time</h3>
        <div class="coc-summary">
          <div class="coc-field">
            <span class="coc-label">Declared on the CoC</span>
            <span tal:attributes="class python:'coc-value coc-bool-ok' if coc.get('holding_time_ok') else 'coc-value coc-bool-fail'"
                  tal:content="python:'Within holding time' if coc.get('holding_time_ok') else 'Not declared'">No</span>
          </div>
        </div>
        <table class="pfas-table" data-col-resize="data-review-2" tal:condition="htr"
               tal:define="clock_label python:{'sample': (u'Sample', u'collection to extraction'), 'processed': (u'Processed sample', u'homogenisation to extraction'), 'extract': (u'Extract', u'extraction to analysis')}">
          <thead><tr><th>Clock</th><th>Samples</th><th>Starts</th><th>Limit</th><th>Due by</th>
            <th>Ended</th><th>Time used</th></tr></thead>
          <tbody><tr tal:repeat="r htr">
            <td><strong tal:content="python:clock_label[r['clock']][0]">Sample</strong>
                <div class="pfas-sub" tal:content="python:clock_label[r['clock']][1]">collection to extraction</div></td>
            <tal:note condition="r/note">
              <td colspan="6" class="pfas-muted" tal:content="r/note">Not applicable</td>
            </tal:note>
            <tal:clock condition="not:r/note">
            <td tal:content="python:u'All %d samples' % len(r['samples']) if r['clock'] != 'processed' and len([x for x in htr if x['clock'] == r['clock']]) == 1 else u', '.join(r['samples'])">All 4 samples</td>
            <td class="cell-nowrap" tal:content="python:r['start'] and u'%s %s' % (r['start'].isoformat(), r['start_word']) or u'not recorded'">2026-10-09 collected</td>
            <td tal:content="python:r['limit_text'] and u'%s days' % r['limit_text'] or u'not set'">14 days</td>
            <td class="cell-nowrap" tal:content="python:r['due'] and r['due'].isoformat() or u'\u2014'">2026-10-23</td>
            <td class="cell-nowrap" tal:content="python:r['end'] and u'%s %s' % (r['end'].isoformat(), r['end_word']) or u'not recorded'">2026-10-11 extracted</td>
            <td><span tal:condition="python:r['elapsed_days'] is not None"
                      tal:attributes="class python:'qv qv-plain' if r['ok'] else 'qv qv-fail'"
                      tal:content="python:u'%s %s of %s days' % (u'\u2713' if r['ok'] else u'\u2717', r['elapsed_days'], r['limit_text'])">2 of 14 days</span>
                <span tal:condition="python:r['elapsed_days'] is None" class="pfas-muted">&#8212;</span></td>
            </tal:clock>
          </tr></tbody>
        </table>
        <div class="dr-line" tal:condition="python:not htr or ht.get('status') not in ('ok',)"
             tal:attributes="class python:'dr-line coc-bool-fail' if ht.get('blocking') else 'dr-line'"
             tal:content="ht/message">message</div>
      </section>

      <!-- the receipt thermometer and its correction factor -->
      <section class="pfas-card dr-card" tal:define="rt coc/receipt_thermometer|nothing">
        <h3 class="dr-card-title">Temperature at receipt</h3>
        <div class="dr-line">
          <span tal:condition="not:rt">Receipt thermometer not recorded on this CoC.</span>
          <span tal:condition="python:rt and rt.get('status') == 'corrected'" class="coc-bool-ok"
                tal:content="python:u'%s (%s): correction %+.3f \u00b0C from the study of %s, applied' % (rt.get('name'), rt.get('serial') or '?', rt.get('correction'), rt.get('study_date'))">IR gun</span>
          <span tal:condition="python:rt and rt.get('status') == 'uncorrected'" class="coc-bool-fail"
                tal:content="python:u'%s (%s): no passed temperature study on %s; temperatures UNCORRECTED' % (rt.get('name'), rt.get('serial') or '?', rt.get('as_of'))">uncorrected</span>
          <span tal:condition="python:rt and rt.get('status') == 'not_required'"
                tal:content="python:u'%s (%s): no correction required' % (rt.get('name'), rt.get('serial') or '?')">reference</span>
        </div>
        <table class="pfas-table" data-col-resize="data-review-3" tal:condition="coc/receipt_temps|nothing">
          <thead><tr><th>Sample</th><th>Observed (&#176;C)</th><th>Corrected (&#176;C)</th></tr></thead>
          <tbody><tr tal:repeat="r coc/receipt_temps">
            <td tal:content="python:r[0]">S1</td><td tal:content="python:r[1]">4.2</td>
            <td tal:content="python:'' if r[2] is None else r[2]">4.55</td></tr></tbody>
        </table>
      </section>
      </tal:with_coc>
      <tal:no_coc tal:condition="not:coc/client_name|nothing">
        <p class="dr-line">CoC not yet completed for this batch.</p>
      </tal:no_coc>
      </tal:coc_data>
      </tal:routine>

      <!-- Corrections (ISO 17025: signed and dated, old value preserved) -->
      <section class="pfas-card dr-card">
        <h3 class="dr-card-title">Corrections</h3>
        <tal:corr tal:define="corr view/corrections">
          <table class="pfas-table" data-col-resize="data-review-4" tal:condition="corr">
            <thead><tr><th>Field</th><th>Was</th><th>Corrected to</th>
                       <th>By (initials)</th><th>Date</th><th>Reason</th></tr></thead>
            <tbody>
              <tr tal:repeat="c corr">
                <td tal:content="c/field">field</td>
                <td class="dr-old"
                    tal:content="c/old">old</td>
                <td style="font-weight:700;" tal:content="c/new">new</td>
                <td tal:define="sig python:view.signature_for(c.get('initials'))">
                    <span tal:content="c/user">user</span>
                    (<strong tal:content="c/initials">AN1</strong>)
                    <img tal:condition="sig/signature_url|nothing"
                         tal:attributes="src sig/signature_url; alt sig/fullname"
                         style="height:24px;vertical-align:middle;margin-left:5px;"/></td>
                <td tal:content="python:view.lab_at(c.get('ts'), c.get('ts'))">ts</td>
                <td tal:content="c/reason">reason</td>
              </tr>
            </tbody>
          </table>
          <p tal:condition="not:corr" class="dr-line">No corrections recorded.</p>
        </tal:corr>

        <tal:corr_form tal:condition="view/can_act">
          <form method="post" class="dr-corr-form" tal:define="mine view/my_initials"
                tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
            <input type="hidden" name="action" value="correct_field"/>
            <label>Field
              <select name="field" class="pfas-select">
                <option value="lab_received_date">Lab Received Date</option>
              </select>
            </label>
            <label>Corrected value
              <input type="date" name="new_value" required="required" class="pfas-input"/>
            </label>
            <label class="dr-corr-reason">Reason
              <input type="text" name="reason" class="pfas-input"/>
            </label>
            <!-- signed as the signed-in person (their Lab Contact's initials) -->
            <tal:signed tal:condition="mine">
              <input type="hidden" name="initials" tal:attributes="value mine"/>
              <span class="dr-signed-as" tal:content="string:Signed as ${mine}">Signed as AN1</span>
            </tal:signed>
            <label tal:condition="not:mine">Initials
              <input type="text" name="initials" required="required" maxlength="6" class="pfas-input dr-initials"/>
            </label>
            <button class="btn btn-action" type="submit">Sign &amp; correct</button>
          </form>
          <p class="form-note">Corrections never overwrite silently: the previous value, your
            initials and the date are recorded and shown in the final review.</p>
        </tal:corr_form>
      </section>

    </div><!-- /coc -->

    <!-- ══════ TRACEABILITY TAB ═════════════════════════════════════════ -->
    <div class="dr-tab-pane"
         tal:attributes="class python:'dr-tab-pane active' if view.active_tab() == 'traceability' else 'dr-tab-pane'"
         tal:condition="python: view.active_tab() == 'traceability'">

      <tal:tree tal:define="t view/get_traceability_tree">

        <!-- Unresolved lots. Each entry now carries the REASON it blocks, and the
             reason is shown: the entries added for expiry-at-use (§43) name a lot
             that IS in inventory and in date today, so listing it with the old
             blanket advice ("enter it in the inventory") sent the reviewer to fix
             something that was not wrong. Entries written before §41 carry no
             `reason`, hence the `|nothing` default. -->
        <tal:unresl tal:condition="t/unresolved|nothing">
          <div class="tree-warn-box">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>Traceability blocked:</strong>
            <ul style="margin:6px 0 0 18px;padding:0">
              <tal:ur tal:repeat="u t/unresolved">
                <li>
                  <span tal:content="u/lot">lot</span>
                  <tal:src tal:condition="u/source|nothing">
                    (<tal:s tal:replace="python: view.source_label(u['source'])">src</tal:s>)
                  </tal:src>
                  <!-- Every entry carries a reason (see _build_traceability_tree),
                       so there is no fallback branch here and no `not...|nothing`
                       precedence to get wrong. `|nothing` remains only so a stored
                       tree written by an older revision still renders. -->
                  <tal:why tal:condition="u/reason|nothing">
                    &mdash; <tal:r tal:replace="u/reason">reason</tal:r>
                  </tal:why>
                  <!-- a lot pending verification: the reviewer approves or
                       rejects it here (lot_status.review_lot) -->
                  <details class="row-more" tal:condition="python:u.get('pending') and u.get('uid') and view.can_act()">
                    <summary class="btn-sm btn-secondary">Review lot</summary>
                    <div class="row-more-menu">
                      <form method="post" class="mp-issue-form" tal:attributes="action request/URL">
                        <input type="hidden" name="action" value="approve_lot" />
                        <input type="hidden" name="batch_id" tal:attributes="value view/batch_id" />
                        <input type="hidden" name="uid" tal:attributes="value u/uid" />
                        <input type="hidden" name="kind" tal:attributes="value u/kind" />
                        <label class="mp-issue-label">Verified by
                          <select name="how" required="required">
                            <option value="method_blank">Method blank</option>
                            <option value="comparison">Comparison with a fit-for-use lot</option>
                          </select></label>
                        <label class="mp-issue-label">Evidence
                          <input type="text" name="evidence" class="pfas-input" required="required" /></label>
                        <button class="btn-sm btn-primary" type="submit">Approve</button>
                      </form>
                      <form method="post" class="mp-issue-form" tal:attributes="action request/URL">
                        <input type="hidden" name="action" value="reject_lot" />
                        <input type="hidden" name="batch_id" tal:attributes="value view/batch_id" />
                        <input type="hidden" name="uid" tal:attributes="value u/uid" />
                        <input type="hidden" name="kind" tal:attributes="value u/kind" />
                        <input type="hidden" name="source" tal:attributes="value u/source" />
                        <input type="hidden" name="lot" tal:attributes="value u/lot" />
                        <input type="hidden" name="label" tal:attributes="value python:u.get('label') or u.get('name') or ''" />
                        <label class="mp-issue-label">Why
                          <input type="text" name="why" class="pfas-input" required="required" /></label>
                        <button class="btn-sm btn-danger" type="submit">Reject</button>
                      </form>
                    </div>
                  </details>
                </li>
              </tal:ur>
            </ul>
          </div>
        </tal:unresl>

        <!-- Checks that could not be PERFORMED, as distinct from checks that
             failed. Reported rather than enforced (§43.1), and reported here
             rather than nowhere: an unenforceable check that is invisible looks
             exactly like a satisfied one. -->
        <!-- flagged for review: a lot this run used was made from a lot whose
             certificate values were corrected (R5-78) -->
        <tal:rf tal:define="rf view/review_flags" tal:condition="rf">
          <div class="tree-warn-box">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>Flagged:</strong>
            <ul style="margin:6px 0 0 18px;padding:0">
              <li tal:repeat="f rf" tal:content="python:u'%s (%s, %s)' % (f.get('why'), f.get('by') or u'?', view.lab_at(f.get('at'), (f.get('at') or u'').replace(u'T', u' ')))">why</li>
            </ul>
          </div>
        </tal:rf>
        <tal:warn tal:condition="t/warnings|nothing">
          <div class="tree-warn-box" style="border-left-color:var(--s-secondary)">
            <i class="fas fa-info-circle"></i>
            <strong>Not checked:</strong>
            <ul style="margin:6px 0 0 18px;padding:0">
              <li tal:repeat="w t/warnings" tal:content="w">warning</li>
            </ul>
          </div>
        </tal:warn>

        <!-- One table for everything the extraction log names: reagents,
             consumables and the standards used -->
        <section class="pfas-card dr-card" tal:define="rows python:view.trace_rows(t)" tal:condition="rows">
          <h3 class="dr-card-title">Reagents and standards (<tal:f replace="python:view.form_code('252')"/>)</h3>
          <table class="pfas-table" data-col-resize="data-review-5">
            <thead><tr><th>Reagent or standard</th><th>Lot</th><th>Supplier</th><th>Expiry</th>
              <th class="row-plus-cell"><span class="pfas-sr-hide">Actions</span></th></tr></thead>
            <tbody><tr tal:repeat="r rows">
              <td tal:content="r/name">Methanol</td>
              <td class="cell-nowrap"><tal:l tal:content="r/lot">LOT-1</tal:l>
                <div class="tree-unresolved" tal:condition="python:not r['found'] and r['lot']">not in inventory</div></td>
              <td tal:content="r/supplier">Supplier</td>
              <td class="cell-nowrap" tal:content="python:r['expiry'] or u'\u2014'">2027-10-01</td>
              <td class="row-plus-cell">
                <details class="row-more" tal:condition="r/menu">
                  <summary class="row-plus" title="Actions" tal:attributes="aria-label string:Actions for ${r/lot}">+</summary>
                  <div class="row-more-menu">
                    <a class="btn-sm btn-secondary" tal:repeat="m r/menu" target="_blank"
                       tal:attributes="href m/url" tal:content="m/label">Open in Reagent Inventory</a>
                  </div>
                </details>
              </td>
            </tr></tbody>
          </table>
        </section>

        <!-- What the run was loaded with (Run Builder) and the lots each was
             made from: the chain's middle link -->
        <section class="pfas-card dr-card" tal:condition="t/prepared_standards|nothing">
          <h3 class="dr-card-title">Loaded on the instrument</h3>
          <table class="pfas-table" data-col-resize="data-review-6">
            <thead><tr><th>Loaded as</th><th>Standard</th><th>Lot</th><th>Prepared by</th><th>Expiry</th><th>Made from</th></tr></thead>
            <tbody><tr tal:repeat="ps t/prepared_standards">
              <td class="cell-nowrap" tal:content="ps/label|nothing">CAL-1</td>
              <td tal:content="python:ps.get('title') or ps.get('label') or ps.get('field', '')">Standard</td>
              <td class="cell-nowrap" tal:content="ps/lot">LOT</td>
              <td tal:content="ps/prepared_by|nothing">who</td>
              <td class="cell-nowrap" tal:content="ps/expiry_date|nothing">date</td>
              <td>
                <span class="tree-unresolved" tal:condition="not:ps/found">not in inventory</span>
                <div tal:repeat="par ps/parent_reagents|nothing">
                  <tal:t tal:replace="par/name">name</tal:t>
                  <tal:l tal:replace="python:u'\u00b7 lot %s' % par.get('lot')">lot</tal:l>
                  <span class="tree-unresolved" tal:condition="not:par/resolved|nothing">not in inventory</span>
                </div>
              </td>
            </tr></tbody>
          </table>
        </section>

        <tal:empty_tree
            tal:condition="python:not t.get('direct_reagents') and not t.get('direct_standards') and not t.get('prepared_standards')">
          <p style="color:var(--s-secondary);font-size:var(--fs-base);">
            No traceability data found. Choose the lots loaded in the Run Builder and fill in
            <tal:f replace="python:view.form_code('252')"/> for this worksheet.
          </p>
          <div style="display:flex;gap:10px;margin-top:10px;">
            <a class="btn btn-action"
               tal:attributes="href string:${view/portal_url}/@@pfas-run-builder?batch_id=${view/batch_id}">
               Run Builder
            </a>
            <a class="btn btn-action"
               tal:attributes="href string:${view/batch_url}/@@pfas-logbook-dynamic?slug=252">
               Open <tal:f replace="python:view.form_code('252')"/>
            </a>
          </div>
        </tal:empty_tree>

      </tal:tree>
    </div><!-- /traceability -->

    <!-- ══════ EXTRACTION TAB (the guided extraction record) ═══════════════ -->
    <div class="dr-tab-pane"
         tal:attributes="class python:'dr-tab-pane active' if view.active_tab() == 'extraction' else 'dr-tab-pane'"
         tal:condition="python: view.active_tab() == 'extraction'">
    <tal:x tal:condition="python: view.active_tab() == 'extraction'">
    <tal:r tal:define="rec view/extraction_record">
      <p class="dr-empty" tal:condition="not:rec">This worksheet has no batch, so there is no extraction to show.</p>
      <p class="dr-empty" tal:condition="python: rec and not rec['started']">No guided extraction is recorded for
        batch <strong tal:content="rec/batch_id">B-1</strong>.</p>
      <tal:s tal:condition="python: rec and rec['started']">
      <div class="dr-ext-head">
        <span tal:attributes="class python:'cl-badge ' + ('cl-auto' if rec['finalized'] else 'cl-manual')"
              tal:content="python: 'Finalized' if rec['finalized'] else 'Not finalized'">Finalized</span>
        <span>Batch <strong tal:content="rec/batch_id">B-1</strong> &#183;
          started <span tal:replace="python: view.lab_at(rec['started_at'], rec['started_at'][:16].replace('T', ' '))">x</span>
          by <span tal:replace="rec/analyst">AN1</span>
          <tal:f tal:condition="rec/finalized"> &#183; finalized
            <span tal:replace="python: view.lab_at(rec['finalized_at'], rec['finalized_at'][:16].replace('T', ' '))">x</span>
            by <span tal:replace="rec/finalized_by">AN1</span></tal:f></span>
        <a class="btn-sm btn-secondary" target="_blank" tal:attributes="href rec/pdf_url">Logbook PDF</a>
        <a class="btn-sm btn-secondary" tal:attributes="href rec/guide_url">Open the extraction</a>
      </div>

      <!-- the extraction as one trail of steps: what, who, when, and the
           note recorded with each step for the reviewer; lots and equipment
           are on Traceability, samples on Final Data and the CoC -->
      <h3 class="dr-section-h">Steps</h3>
      <table class="pfas-table dr-steps" data-col-resize="data-review-dr-steps">
        <thead><tr><th>Step</th><th>Done by</th><th>At</th><th>Comments</th></tr></thead>
        <tbody><tr tal:repeat="st rec/review/stages">
          <td tal:content="python: u'%s \u00b7 %s' % (st['order'], st['name'])">1 &#183; Setup</td>
          <td tal:content="python: st['analyst'] or u'\u2014'">AN1</td>
          <td class="cell-nowrap">
            <tal:t tal:condition="st/completed_at" tal:replace="python: view.lab_at(st['completed_at'], st['completed_at'][:16].replace('T', ' '))">x</tal:t>
            <span class="cl-badge cl-manual" tal:condition="not:st/completed_at">not recorded</span></td>
          <td>
            <span class="cl-badge cl-fail" tal:condition="python: st['warnings'] and not st['deviations']">needs a note</span>
            <div tal:repeat="w python: st['warnings'] if not st['deviations'] else []" tal:content="w">x</div>
            <div tal:condition="st/deviations" tal:content="st/deviations">note</div>
            <div tal:condition="st/confirmed" tal:content="python: u'Checked: ' + u'; '.join(st['confirmed'])">x</div>
            <div tal:repeat="c st/corrections"
                 tal:content="python: u'Corrected %s by %s: %s' % (view.lab_at(c['at'], c['at'][:16].replace('T', ' ')), c['by'], c['reason'])">x</div>
            <tal:none tal:condition="python: not (st['warnings'] or st['deviations'] or st['confirmed'] or st['corrections'])">&#8212;</tal:none>
          </td>
        </tr></tbody>
      </table>

      <tal:dil tal:condition="rec/dilutions">
      <h3 class="dr-section-h">Dilutions</h3>
      <table class="pfas-table" data-col-resize="data-review-7">
        <thead><tr><th>Diluted from</th><th>Injection</th><th>Fold</th><th>Logged</th></tr></thead>
        <tbody><tr tal:repeat="d rec/dilutions">
          <td tal:content="d/dilution_of">S-1</td><td tal:content="d/sample_id">S-1 x10</td>
          <td><span tal:replace="d/dilution_factor">10</span>
              <span class="cl-badge cl-fail" tal:condition="not:d/fold_ok"
                    title="Dilutions are logged as a total fold (e.g. 10); a ratio is not applied">not a fold</span></td>
          <td tal:content="python: '%s %s' % (view.lab_at(d.get('logged_at'), (d.get('logged_at') or '')[:16].replace('T', ' ')), d.get('logged_by') or '')">x</td>
        </tr></tbody>
      </table>
      </tal:dil>
      </tal:s>
    </tal:r>
    </tal:x>
    </div>

    <!-- ══════ QC SUMMARY TAB ═══════════════════════════════════════════ -->
    <div class="dr-tab-pane"
         tal:attributes="class python:'dr-tab-pane active' if view.active_tab() == 'qc_summary' else 'dr-tab-pane'"
         tal:condition="python: view.active_tab() == 'qc_summary'">

      <tal:qcs tal:define="qc view/get_qc_summary">

        <tal:qc_err tal:condition="qc/error|nothing">
          <p style="color:var(--s-secondary);font-size:var(--fs-base);">
            QC data unavailable:
            <tal:t tal:replace="qc/error">error</tal:t>.
            <tal:no_db tal:condition="python:qc.get('error')=='db_unavailable'">
              The QC database has not been initialised yet — run the pipeline
              to import instrument data.
            </tal:no_db>
          </p>
        </tal:qc_err>

        <tal:qc_ok tal:condition="not:qc/error|nothing">
          <!-- the verdict with its reason beside it and the button to the fix -->
          <div class="dr-verdict" tal:define="why python:view.overall_reason(qc)">
            <span tal:attributes="class python:'cl-badge ' + ('cl-pass' if qc.get('overall_pass') else 'cl-fail')"
                  tal:content="python:'Overall: PASS' if qc.get('overall_pass') else 'Overall: FAIL'">
            </span>
            <tal:why tal:condition="why">
              <span class="dr-verdict-why" tal:content="why/text">FRB limit not set for EPA 537.1</span>
              <a class="btn-sm btn-secondary" tal:condition="why/fix_url"
                 tal:attributes="href why/fix_url" tal:content="why/fix_label">QC criteria</a>
            </tal:why>
            <span class="pfas-muted"
                  tal:content="python:str(qc.get('result_count',0)) + ' QC results'">0 results</span>
            <tal:rd tal:condition="qc/run_date|nothing">
              <span class="pfas-muted"
                    tal:content="python:'Run: ' + str(qc.get('run_date',''))">date</span>
            </tal:rd>
          </div>

          <tal:rp tal:define="plan view/run_plan_items" tal:condition="plan">
            <h3>Run plan</h3>
            <table class="pfas-table" data-col-resize="data-review-8">
              <thead><tr><th>What differs from the plan</th><th>Status</th><th></th></tr></thead>
              <tbody>
                <tr tal:repeat="it plan">
                  <td tal:content="it/flag">DW-1 was planned but did not run</td>
                  <td>
                    <span tal:condition="python:it.get('result_status') == 'cleared'"
                          class="cl-badge cl-pass"
                          tal:content="python:u'Cleared by %s: %s' % (it.get('cleared_by'), it.get('cleared_note'))">Cleared</span>
                    <span tal:condition="python:it.get('result_status') != 'cleared'"
                          class="cl-badge cl-fail">Holds release</span>
                  </td>
                  <td>
                    <form method="post" tal:condition="python:it.get('result_status') != 'cleared' and view.can_act()"
                          tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
                      <input type="hidden" name="action" value="clear_run_plan"/>
                      <input type="hidden" name="tab" value="qc_summary"/>
                      <input type="hidden" name="result_id" tal:attributes="value it/id"/>
                      <input type="text" name="note" required="required" placeholder="Why the run stands"/>
                      <button class="btn btn-action" type="submit">Clear</button>
                    </form>
                  </td>
                </tr>
              </tbody>
            </table>
          </tal:rp>

          <!-- blanks only: each against the limit it was judged by, and how
               close it came; the spikes are on Spike QC, the instrument's
               checks on Calibration. Numbers end at the right; a pass is
               plain; a column with nothing for the whole run stays, greyed,
               its reason under its heading (qc_cells.blank_table). -->
          <tal:bt tal:define="bt python:view.blanks_table(qc)">
          <section class="pfas-card dr-card" tal:condition="bt/rows">
            <h3 class="dr-card-title">Blanks</h3>
            <table class="pfas-table dr-blanks" data-col-resize="data-review-dr-blanks">
              <thead><tr><th>Analyte</th>
                <tal:h tal:repeat="ty bt/types"><tal:n tal:define="hn python:bt['heading_note'].get(ty[0]) or {}">
                  <th tal:attributes="class python:'is-right num is-muted' if hn.get('value') else 'is-right num'"><tal:t
                      tal:replace="python:u'%s (%s)' % (ty[0], ty[1]) if ty[1] else ty[0]">LRB (ng/L)</tal:t><span
                      class="pfas-th-note" tal:condition="hn/value|nothing" tal:content="hn/value">not judged</span></th>
                  <th tal:attributes="class python:'is-right num is-muted' if hn.get('limit') else 'is-right num'"><tal:t
                      tal:replace="python:u'%s limit (%s)' % (ty[0], ty[1]) if ty[1] else u'%s limit' % ty[0]">LRB limit (ng/L)</tal:t><span
                      class="pfas-th-note" tal:condition="hn/limit|nothing" tal:content="hn/limit">not set</span></th>
                  <th tal:attributes="class python:'is-right num is-muted' if hn.get('pct') else 'is-right num'"><tal:t
                      tal:replace="python:u'%s (%% of limit)' % ty[0]">LRB (% of limit)</tal:t><span
                      class="pfas-th-note" tal:condition="hn/pct|nothing" tal:content="hn/pct">not judged</span></th>
                </tal:n></tal:h></tr></thead>
              <tbody><tr tal:repeat="r bt/rows"
                         tal:attributes="class python:{'fail': 'is-fail', 'review': 'is-review'}.get(r.get('state'))">
                <td><strong tal:content="r/analyte">PFOA</strong></td>
                <tal:c tal:repeat="c r/cells">
                  <td tal:attributes="class python:'is-right num is-muted' if c['heading_note'].get('value') else 'is-right num'"><span
                        tal:attributes="class python:'qv ' + c['cls'] if c['cls'].startswith('qv') else c['cls']; title python:c['tip'] or None;
                                        data-prov c/prov; role python:'button' if c['prov'] else None;
                                        tabindex python:0 if c['prov'] else None"
                        ><tal:t tal:replace="c/text">N.D.</tal:t><span class="qv-word" tal:condition="c/word"
                        tal:content="c/word">Fail</span></span></td>
                  <td tal:attributes="class python:'is-right num is-muted' if c['heading_note'].get('limit') else ('is-right num pfas-muted' if c['limit'] == u'not set' else 'is-right num')"
                      tal:content="python:u'\u2014' if c['heading_note'].get('limit') else c['limit']">0.667</td>
                  <td tal:attributes="class python:'is-right num is-muted' if c['heading_note'].get('pct') else 'is-right num';
                                      data-prov c/prov; role python:'button' if c['prov'] else None;
                                      tabindex python:0 if c['prov'] else None" tal:content="c/pct">30</td>
                </tal:c>
              </tr></tbody>
            </table>
            <div class="dr-line" tal:repeat="n bt/notes"
                 tal:content="python:u'%s limit: %s' % (n[0], n[1])">LRB limit: below 1/3 x RL</div>
          </section>
          <p class="dr-empty" tal:condition="not:bt/rows">No blanks are recorded for this run.</p>
          </tal:bt>

        </tal:qc_ok>

      </tal:qcs>

      <!-- the method blank results are compared with / subtracted from
           : the batch's default; changed here with a reason -->
      <section class="bench-block" tal:define="mbs view/method_blank_members"
               tal:condition="python:len(mbs) > 1">
        <h3 class="bench-h">Subtraction blank</h3>
        <ul class="bench-alerts" tal:condition="view/subtraction_change_pending">
          <li class="bench-bad"><strong>Reprocess the run:</strong> it still uses the previous blank.</li>
        </ul>
        <form method="post" tal:condition="view/can_act"
              tal:attributes="action string:${view/ws_url}/@@pfas-data-review">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="action" value="choose_subtraction_blank" />
          <select name="member">
            <option tal:repeat="m mbs" tal:attributes="value m/id; selected python:'selected' if m.get('subtract') else None"
                    tal:content="m/injection">WS-1-MB1</option>
          </select>
          <input type="text" name="reason" placeholder="Reason" />
          <button class="btn-sm btn-secondary" type="submit">Change</button>
        </form>
        <table class="pfas-table" data-col-resize="data-review-9" tal:condition="view/subtraction_blank_changes">
          <thead><tr><th>From</th><th>To</th><th>Reason</th><th>By</th><th>When</th></tr></thead>
          <tbody><tr tal:repeat="c view/subtraction_blank_changes">
            <td tal:content="c/from">MB1</td><td tal:content="c/to">MB2</td><td tal:content="c/reason">r</td>
            <td tal:content="c/by">AN1</td><td tal:content="python:view.lab_at(c.get('at'), c.get('at'), u'%Y-%m-%d %H:%M:%S')">t</td></tr></tbody>
        </table>
      </section>
    </div><!-- /qc_summary -->

    <!-- Calibration: this run's curves, approved at review -->
    <div class="dr-tab-pane"
         tal:attributes="class python:'dr-tab-pane active' if view.active_tab() == 'calibration' else 'dr-tab-pane'"
         tal:condition="python: view.active_tab() == 'calibration'">
      <tal:cal tal:define="cal view/calibration_review">
        <link rel="stylesheet" tal:attributes="href string:${view/portal_url}/++resource++senaite.pfas/calibration_review.css?v=${context/@@pfas-macros/asset_version}" />
        <p tal:condition="python:cal['source'] == 'reused'"
           tal:content="python:u'Reused curve: %s %s' % (cal['run_date'], cal.get('from') or u'')"></p>
        <div id="cal-runs-area"></div>
        <script>
        var CAL_RUNS  = <tal:x tal:replace="view/calibration_cards_json">[]</tal:x>;
        var CAL_URL   = '<tal:u tal:replace="view/portal_url">.</tal:u>/@@pfas-calibrations';
        var CAL_BY_UID = {};
        function limFor(uid) {
          var c = CAL_BY_UID[uid] || {};
          var L = c.limits || {};
          return {CAL: L.CAL || {}, ICV: L.ICV || {}, CCV: L.CCV || {}, r2: c.r2_min};
        }
        var IS_MGR = <tal:x tal:replace="python:'true' if view.is_manager() else 'false'">false</tal:x>;
        var CAL_APPROVE = <tal:x tal:replace="view/calibration_approve_json">null</tal:x>;
        </script>
        <script tal:attributes="src string:${context/portal_url}/++resource++senaite.pfas/vendor/chart.js-4.4.3.umd.min.js"></script>
        <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/vendor/chartjs-plugin-annotation-3.1.0.min.js"></script>
        <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/vendor/ml-matrix-6.12.1.umd.js"></script>
        <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/calibration_fit.js?v=${context/@@pfas-macros/asset_version}"></script>
        <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/calibration_review.js?v=${context/@@pfas-macros/asset_version}"></script>
        <script>renderAll(CAL_RUNS);</script>
      </tal:cal>
    </div><!-- /calibration -->

    <!-- ══════ SAMPLES TAB (per-result verification) ═══════════════════════ -->

    <!-- ══════ SPIKE QC TAB (recovery + RPD vs spec) ═══════════════════════ -->
    <div class="dr-tab-pane"
         tal:attributes="class python:'dr-tab-pane active' if view.active_tab() == 'spike_qc' else 'dr-tab-pane'"
         tal:condition="python: view.active_tab() == 'spike_qc'">
      <tal:sq tal:define="page view/spike_qc_page">
        <p class="pfas-muted">Spike recoveries and RPDs; windows cited below. <tal:h define="hid string:judged-value"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></p>
        <!-- A spike that was run but has no recorded level cannot be
             evaluated. Ask for the value rather than skipping it. -->
        <div class="tree-warn-box is-pending" tal:condition="page/pending_spikes">
          <strong>Spike level needed before these can be evaluated.</strong>
          <p style="font-size:var(--fs-sm);margin:6px 0 12px;">Enter the amount added; it is saved on the batch&#8217;s extraction record.</p>
          <tal:rec tal:repeat="p page/pending_spikes">
          <!-- not in the extraction's spike record: the record is the only
               source of a spike's sample and level, so it is recorded there -->
          <p class="tree-warn-line" tal:condition="p/unrecorded">
            <strong tal:content="p/injection">injection</strong>: not in the batch&#8217;s QC.
            <a class="btn-sm" tal:attributes="href view/extraction_guide_url">Batch QC</a>
          </p>
          <form method="post" tal:condition="not:p/unrecorded"
                style="display:flex;gap:10px;align-items:center;margin-bottom:8px;flex-wrap:wrap;">
            <input type="hidden" name="action" value="record_spike_level" />
            <input type="hidden" name="injection"
                   tal:attributes="value p/injection" />
            <input type="hidden" name="level" tal:attributes="value p/level" />
            <span style="font-size:var(--fs-sm);min-width:260px;">
              <strong tal:content="p/injection">injection</strong>
              <em tal:condition="p/parent"
                  style="color:var(--s-secondary);">
                &#8212; spiked into <span tal:content="p/parent">parent</span>
              </em>
              <em tal:condition="python:p.get('recorded_in')">
                (in <span tal:replace="p/unit">ng/g</span>, not <span tal:replace="p/recorded_in">ppt</span>)
              </em>
            </span>
            <input type="number" step="any" min="0" name="spike_ppt"
                   tal:attributes="placeholder python:p.get('unit') or 'unit not set'" required="required"
                   style="width:110px;padding:4px 8px;" />
            <label style="font-size:var(--fs-xs);color:var(--s-secondary);"
                   tal:condition="view/is_manager" class="pfas-switch">
              <input type="checkbox" name="set_method_nominal" value="yes" /><span class="pfas-switch-track"></span>
              also set as this method's nominal level
            </label>
            <button type="submit" class="btn-sm">Record</button>
          </form>
          </tal:rec>
        </div>

        <div class="dr-empty"
             tal:condition="python:not page['groups'] and not page['pending_spikes']">
          No spike QC results for this worksheet yet.
        </div>
        <tal:has tal:condition="page/groups">
          <div class="qv-legend">
            <span class="qv qv-review">Review</span><span class="qv qv-fail">Fail</span>
          </div>
          <p class="hint" tal:define="req python:[t for t in page['types'] if page['specs'][t]['required']]"
             tal:condition="req">Required every run: <span tal:replace="python:u', '.join(req)">LFSM</span></p>
          <tal:g tal:repeat="qv_group page/groups"><tal:m tal:define="qv_method view/batch_method">
            <metal:m use-macro="context/@@pfas-macros/macros/qc_values" />
          </tal:m></tal:g>
        </tal:has>
      </tal:sq>
    </div><!-- /spike_qc -->

    <!-- ══════ FINAL DATA TAB ════════════════════════════════════════════ -->
    <div class="dr-tab-pane"
         tal:attributes="class python:'dr-tab-pane active' if view.active_tab() == 'final_data' else 'dr-tab-pane'"
         tal:condition="python: view.active_tab() == 'final_data'">

      <p class="pfas-muted">
        Results as recorded on this worksheet&#8217;s samples. A neat reading
        replaced by its dilution appears with its retest.
      </p>

      <!-- core results against the method panel and the worker's push log
           (result_checks.py): flags, not a gate -->
      <ul class="bench-alerts" tal:define="rck view/result_checks"
          tal:condition="python:rck['not_written'] or rck['not_judged'] or rck['panel'] or rck.get('error')">
        <li class="bench-bad" tal:condition="rck/error|nothing">
          <strong>Result checks could not run:</strong> <span tal:content="rck/error">error</span></li>
        <li class="bench-warn" tal:repeat="x rck/not_written">
          <strong>Not written to SENAITE:</strong>
          <span tal:content="python:'%s / %s: %s' % (x['injection'], x['analyte'], x['reason'])">S-1 / PFOA: why</span></li>
        <li class="bench-warn" tal:repeat="x rck/not_judged">
          <strong>Not judged by the pipeline:</strong>
          <span tal:content="python:'%s %s = %s (%s)' % (x['sample'], x['keyword'], x['result'], x['why'])">S-1 PFOA</span></li>
        <li class="bench-warn" tal:repeat="x rck/panel">
          <strong tal:content="string:${x/sample} differs from its method panel:">S-1</strong>
          <span tal:condition="x/missing" tal:content="python:'missing ' + ', '.join(x['missing'])">missing</span>
          <span tal:condition="x/extra" tal:content="python:'; not in the panel ' + ', '.join(x['extra'])">extra</span></li>
      </ul>

      <tal:fd tal:define="rows view/get_final_data;
                          asks python:bool(view.can_act() and view.request_targets())">
        <!-- When empty, say WHY (which link in the chain has no data) -->
        <div class="dr-msg error" tal:condition="python:not rows and view.final_data_diagnosis()"
             tal:content="view/final_data_diagnosis">diagnosis</div>
        <tal:has_rows tal:condition="rows|nothing">
          <!-- a qualifier every result carries is said once above the table;
               a row shows a chip only for the codes beyond it -->
          <p class="dr-common" tal:define="common python:view.common_codes_line(rows)"
             tal:condition="common" tal:content="common">All results carry H</p>
          <div class="table-wrap" tal:define="meanings view/qualifier_meanings; iu view/instrument_unit">
            <table class="pfas-table dr-final" data-col-resize="data-review-dr-final">
              <thead>
                <tr>
                  <th>Sample ID</th>
                  <th>Analyte</th>
                  <th>Qualifier</th>
                  <th class="is-right num">Result</th>
                  <th>Unit</th>
                  <th class="is-right num" tal:content="python:u'Instrument result (%s)' % iu if iu else u'Instrument result'">Instrument result (ng/L)</th>
                  <th class="is-right num">RT (min)</th>
                  <th class="is-slim" tal:condition="asks"><span class="pfas-sr-hide">Ask the preparer</span></th>
                </tr>
              </thead>
              <tbody>
                <tal:row tal:repeat="row rows">
                  <!-- the value in its number column; an isomer sum's parts
                       on the muted line under it (tr.fd-parts) -->
                  <tr tal:define="parted python:bool(row.get('instrument_parts') or row.get('rt_parts'))"
                      tal:attributes="class python:u' '.join(c for c in ({'review': u'is-review'}.get(row.get('state')), u'fd-has-parts' if parted else None) if c) or None">
                    <td tal:content="row/sample_id">SID</td>
                    <td class="qv-analyte" tal:content="row/analyte">analyte</td>
                    <!-- a qualifier explains itself: its meaning and why it was
                         applied on hover; a click opens the QC record behind it -->
                    <td><tal:q tal:condition="row/qualifier|nothing"><span class="fd-qual"
                          tal:define="why python:u': '.join(x for x in (meanings.get(row['qualifier']), row.get('qc_reasons')) if x)"
                          tal:attributes="title python:why or None; aria-label python:why or None;
                                          data-prov python:(row.get('qc_cell') or {}).get('prov') and row['qc_cell']['prov'][0] or None;
                                          role python:'button' if (row.get('qc_cell') or {}).get('prov') else None;
                                          tabindex python:0 if (row.get('qc_cell') or {}).get('prov') else None"
                          tal:content="row/qualifier">J</span></tal:q>
                        <tal:c tal:condition="python:not row.get('qualifier') and row.get('qc_cell')"><tal:d
                          tal:define="qv_cell row/qc_cell"><metal:m use-macro="context/@@pfas-macros/macros/qc_value" /></tal:d></tal:c></td>
                    <td class="is-right num" tal:attributes="data-prov row/result_prov|nothing;
                                        role python:'button' if row.get('result_prov') else None;
                                        tabindex python:0 if row.get('result_prov') else None"><tal:r tal:replace="row/result|string:—">—</tal:r>
                        <div class="fd-note" tal:condition="row/reported|nothing" tal:content="row/reported">reported</div></td>
                    <td tal:content="row/unit|string:—">—</td>
                    <td class="is-right num" tal:attributes="data-prov row/instrument_prov|nothing;
                                        role python:'button' if row.get('instrument_prov') else None;
                                        tabindex python:0 if row.get('instrument_prov') else None"
                        tal:content="python:row.get('instrument') or (u'' if parted else u'\u2014')">0.42</td>
                    <td class="is-right num" tal:content="python:row.get('rt') or (u'' if parted else u'\u2014')">7.82</td>
                    <td class="is-slim" tal:condition="asks"><button type="button" class="btn-sm btn-secondary dr-ask"
                        tal:attributes="data-ask-injection python:view.ask_target(row.get('injection'));
                                        aria-label string:Ask the preparer about ${row/sample_id} ${row/analyte}">Ask…</button></td>
                  </tr>
                  <tr class="fd-parts" tal:condition="python:row.get('instrument_parts') or row.get('rt_parts')">
                    <td colspan="5"></td>
                    <td class="is-right num" tal:content="row/instrument_parts|nothing">lr 4.896 · br 1.224</td>
                    <td class="is-right num" tal:content="row/rt_parts|nothing">lr 8.10 · br 7.95</td>
                    <td tal:condition="asks"></td>
                  </tr>
                </tal:row>
              </tbody>
            </table>
          </div>
        </tal:has_rows>
        <tal:no_rows tal:condition="not:rows|nothing">
          <p class="dr-empty">No results found for this worksheet.</p>
        </tal:no_rows>

        <!-- what was asked of the preparer from a row's Ask… -->
        <section class="pfas-card dr-card" tal:condition="view/run_requests">
          <h3 class="dr-card-title">Requests to the preparer</h3>
          <table class="pfas-table" data-col-resize="data-review-10">
            <thead><tr><th>Injection</th><th>Asked for</th><th>Why</th><th>Status</th><th>Made as</th></tr></thead>
            <tbody><tr tal:repeat="r view/run_requests">
              <td tal:content="r/injection">DW-0012</td>
              <td tal:content="python:('Dilution 1 in %s' % r['fold']) if r['kind'] == 'dilution' else 'Re-injection'">Dilution</td>
              <td tal:content="r/reason">why</td><td tal:content="python:(r['status'] or u'').capitalize()">Open</td>
              <td tal:content="python:r.get('new_injection') or u'\u2014'">DW-0012-D10</td>
            </tr></tbody>
          </table>
        </section>

        <!-- the request form: a row's Ask… opens it in the centred dialog
             with that row's injection chosen -->
        <template id="dr-ask-form" tal:condition="asks"
                  data-title="Ask the preparer for a dilution or re-injection">
          <form method="post" class="dr-request-form">
            <input type="hidden" name="action" value="request_run" />
            <!-- shown when the row's injection is none of the batch's: nothing is chosen for the reviewer -->
            <p class="dr-ask-choose" hidden="hidden">Choose the injection.</p>
            <label>Injection
              <select name="injection" class="pfas-select" required="required"><option value=""></option><option
                tal:repeat="t view/request_targets" tal:attributes="value t" tal:content="t">DW-0012</option></select></label>
            <label>Asked for
              <select name="kind" class="pfas-select"><option value="dilution">Dilution</option><option value="reinjection">Re-injection</option></select></label>
            <label>Fold
              <input type="number" name="fold" min="1.01" step="any" class="pfas-input no-stepper" /></label>
            <label class="dr-request-why">Why
              <input type="text" name="reason" required="required" class="pfas-input" /></label>
            <button class="btn btn-primary" type="submit">Send to the preparer</button>
          </form>
        </template>
        <script tal:condition="asks">
        /* a row's Ask… opens the request form in the centred dialog, the
           row's injection chosen; a row whose injection is none of the
           batch's chooses nothing and asks for it */
        (function () {
          var tpl = document.getElementById('dr-ask-form');
          if (!tpl) return;
          document.addEventListener('click', function (e) {
            var btn = e.target.closest ? e.target.closest('button[data-ask-injection]') : null;
            var C = window.PFAS && window.PFAS.components;
            if (!btn || !C || !C.drawer) return;
            var form = tpl.content.firstElementChild.cloneNode(true);
            var inj = btn.getAttribute('data-ask-injection') || '';
            var select = form.querySelector('select[name="injection"]');
            var opts = select.querySelectorAll('option'), found = false;
            for (var i = 0; i < opts.length; i++) {
              var on = inj !== '' && opts[i].value === inj;
              if (on) { opts[i].setAttribute('selected', 'selected'); found = true; }
              else { opts[i].removeAttribute('selected'); }
            }
            if (!found) {
              select.querySelector('option[value=""]').setAttribute('selected', 'selected');
              form.querySelector('.dr-ask-choose').removeAttribute('hidden');
            }
            C.drawer.open(tpl.getAttribute('data-title'), form,
                          { cls: 'is-dialog', opener: btn,
                            focus: found ? form.querySelector('select[name="kind"]') : select });
          });
        })();
        </script>
      </tal:fd>

      <!-- Mark reviewed -->
      <div style="margin-top:16px;">
        <tal:fd_check
            tal:condition="python:not [i for i in view.checklist_status() if i['key']=='final_data' and i['checked']] and view.can_act()">
          <form method="post"
                tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
            <input type="hidden" name="action" value="check_item"/>
            <input type="hidden" name="item_key" value="final_data"/>
            <input type="hidden" name="tab" value="final_data"/>
            <input type="text" name="initials" required="required" placeholder="Initials" maxlength="6" style="width:74px;padding:4px 6px;font-size:var(--fs-sm);border:1px solid var(--s-border);border-radius:4px;text-transform:uppercase;margin-right:6px;"/>
            <button class="btn btn-action" type="submit">Mark Final Data Reviewed</button>
          </form>
        </tal:fd_check>
      </div>

    </div><!-- /final_data -->

    <!-- ══════ RAW DATA TAB (a run imported from raw data) ═══════════════ -->
    <div class="dr-tab-pane active"
         tal:condition="python: view.active_tab() == 'raw' and view.raw_available()">
      <link rel="stylesheet" tal:attributes="href string:${view/portal_url}/++resource++senaite.pfas/raw_data.css?v=${context/@@pfas-macros/asset_version}" />
      <script type="application/json" id="raw-data-json" tal:content="structure view/raw_tab_json">{}</script>
      <p class="pfas-muted raw-help"><tal:h define="hid string:raw-review"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></p>
      <div id="raw-data"></div>
      <!-- asked over the open card when its change is not applied: Previous, Next, Escape -->
      <div class="pfas-modal is-top" id="raw-leave">
        <div class="pfas-modal-box is-narrow" role="alertdialog" aria-modal="true" aria-labelledby="raw-leave-h">
          <h2 id="raw-leave-h">Leave the change?</h2>
          <div class="form-actions">
            <button type="button" class="btn btn-secondary" data-role="stay">Keep editing</button>
            <button type="button" class="btn btn-primary" data-role="leave">Leave it</button>
          </div>
        </div>
      </div>
      <form id="raw-edit" method="post" class="raw-edit-form" hidden="hidden"
            tal:condition="view/can_act" tal:attributes="action string:${view/ws_url}/@@pfas-data-review">
        <input tal:replace="structure context/@@authenticator/authenticator" />
        <input type="hidden" name="action" value="raw_edit" />
        <input type="hidden" name="kind" value="integrate" />
        <input type="hidden" name="mode" value="injection" />
        <input type="hidden" name="injection" />
        <input type="hidden" name="analyte" />
        <input type="hidden" name="transition" value="" />
        <input type="hidden" name="baseline" value="" />
        <input type="hidden" name="level_start" value="" />
        <input type="hidden" name="level_end" value="" />
        <input type="hidden" name="apex" value="" />
        <input type="hidden" name="confirm" value="" />
        <label>Start, min <input type="number" name="start" step="0.001" required="required" /></label>
        <label>End, min <input type="number" name="end" step="0.001" required="required" /></label>
        <button class="btn-sm btn-primary" type="submit">Re-integrate</button>
      </form>
      <script tal:attributes="src string:${context/portal_url}/++resource++senaite.pfas/vendor/chart.js-4.4.3.umd.min.js"></script>
      <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/vendor/chartjs-plugin-annotation-3.1.0.min.js"></script>
      <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/raw_data.js?v=${context/@@pfas-macros/asset_version}"></script>
    </div><!-- /raw -->

    <!-- ══════ COMPARISON TAB (Validation: the run imported both ways) ═══ -->
    <!-- the tab is always listed: a run with nothing to compare says why
         and where the method keeps both -->
    <div class="dr-tab-pane active"
         tal:condition="python: view.active_tab() == 'compare' and not view.comparison_available()">
      <div class="pfas-empty is-boxed" tal:define="why view/comparison_empty">
        <p tal:condition="python:why == 'no_run'">No run has been imported for this worksheet yet.</p>
        <p tal:condition="python:why == 'not_integrated'">This run&#8217;s raw data were not integrated, so there is nothing to compare the results with.</p>
        <p tal:condition="python:why == 'no_export'">This run&#8217;s instrument export was not imported, so there is nothing to compare the results with.</p>
        <tal:vendor tal:condition="python:why == 'vendor'">
          <p>No comparison for this run: its results come from the instrument software, so there is nothing to compare them with.</p>
          <p>To keep both, set Results come from to Validation on the method&#8217;s Run &amp; reporting tab before the next run.</p>
          <a class="btn-sm btn-secondary" tal:condition="python:view.editor_url('pane-run')"
             tal:attributes="href python:view.editor_url('pane-run')">Open Run &amp; reporting</a>
        </tal:vendor>
      </div>
    </div>
    <div class="dr-tab-pane active"
         tal:condition="python: view.active_tab() == 'compare' and view.comparison_available()">
     <tal:c tal:define="cmp view/comparison">
      <div class="dr-compare-summary">
        <tal:x tal:replace="python:u'%d peaks compared, %d disagree' % (cmp['summary']['compared'], cmp['summary']['disagree'])">n</tal:x><tal:x
          tal:condition="python:cmp['summary']['max_area_pct'] is not None"
          tal:replace="python:u'; the largest area difference is %.1f %%' % cmp['summary']['max_area_pct']">m</tal:x>.
        <a class="btn-sm btn-secondary" href="?tab=compare&amp;export=comparison">Download CSV</a>
      </div>
      <table class="dr-table" data-col-resize="data-review-dr-table">
        <thead><tr><th tal:repeat="h view/comparison_headings" tal:content="h">Injection</th></tr></thead>
        <tbody>
          <tr tal:repeat="l cmp/lines" tal:attributes="class python:'row-fail' if l['disagree'] else None">
            <td tal:content="l/injection">S1</td><td tal:content="l/analyte">PFOA</td>
            <td tal:content="python:'%.0f' % l['vendor_area'] if l['vendor_area'] is not None else u'\u2014'">1</td>
            <td tal:content="python:'%.0f' % l['raw_area'] if l['raw_area'] is not None else u'\u2014'">1</td>
            <td tal:content="python:'%.1f' % l['area_pct'] if l['area_pct'] is not None else u'\u2014'">0</td>
            <td tal:content="python:'%.3f' % l['vendor_rt'] if l['vendor_rt'] is not None else u'\u2014'">4.2</td>
            <td tal:content="python:'%.3f' % l['raw_rt'] if l['raw_rt'] is not None else u'\u2014'">4.2</td>
            <td tal:content="python:'%.4g' % l['vendor_conc'] if l['vendor_conc'] is not None else u'\u2014'">1</td>
            <td tal:content="python:'%.4g' % l['raw_conc'] if l['raw_conc'] is not None else u'\u2014'">1</td>
            <td tal:content="python:'%.1f' % l['conc_pct'] if l['conc_pct'] is not None else u'\u2014'">0</td>
            <td tal:content="l/vendor_verdict">pass</td>
            <td tal:content="python:(u'\u2717 ' if l['disagree'] else u'') + l['raw_verdict']">pass</td>
          </tr>
        </tbody>
      </table>
     </tal:c>
    </div><!-- /compare -->

    <!-- ══════ INSTRUMENT REPORT TAB ═════════════════════════════════════ -->
    <div class="dr-tab-pane"
         tal:attributes="class python:'dr-tab-pane active' if view.active_tab() == 'instrument_report' else 'dr-tab-pane'"
         tal:condition="python: view.active_tab() == 'instrument_report'">

      <tal:st tal:define="st view/raw_run_status">
        <div class="alert-warn" tal:condition="python:st.get('state') in ('waiting', 'failed')">
          <tal:x tal:replace="st/text">Waiting for the raw data</tal:x>
          <form method="post" tal:condition="python:st.get('state') == 'failed' and view.can_act()"
                tal:attributes="action string:${view/ws_url}/@@pfas-data-review">
            <input tal:replace="structure context/@@authenticator/authenticator" />
            <input type="hidden" name="action" value="raw_pull_again" />
            <button class="btn-sm btn-secondary" type="submit">Pull again</button>
          </form>
        </div>
      </tal:st>
      <!-- a run imported from raw data: its raw files are the raw data file -->
      <tal:raw tal:define="rf view/raw_run_files" tal:condition="rf">
        <div class="ir-file-list">
          <div class="tree-heading">Raw data</div>
          <div tal:content="rf/read">Read from the MassLynx folder</div>
          <div tal:condition="rf/out_of_order" tal:content="rf/out_of_order">Acquired out of sequence order: S3</div>
          <table class="dr-table" data-col-resize="data-review-dr-table-1">
            <thead><tr><th>Injection</th><th>Raw folder</th><th>Files</th><th>Read as</th><th>SHA-256</th></tr></thead>
            <tbody>
              <tr tal:repeat="i rf/injections">
                <td tal:content="i/name">S1</td>
                <td tal:content="i/folder">S1.raw</td>
                <td tal:content="python:u', '.join(u'%s (%s)' % (f['name'], f['sha256'][:12]) for f in i['files'])">files</td>
                <td tal:content="i/read">S1.mzML</td>
                <td><code tal:content="python:i['sha256'][:16]">sha</code></td>
              </tr>
            </tbody>
          </table>
        </div>
      </tal:raw>

      <!-- existing files -->
      <tal:files tal:define="files view/get_instrument_reports">
        <tal:has_files tal:condition="files|nothing">
          <div class="ir-file-list">
            <div class="tree-heading">Uploaded Files</div>
            <tal:f tal:repeat="f files">
              <div class="ir-file-row">
                <span class="ir-file-name" tal:content="f/filename">file.pdf</span>
                <span style="color:var(--s-secondary);font-size:var(--fs-xs);"
                      tal:content="python:str(f.get('size_kb','?')) + ' KB'">—</span>
                <span style="color:var(--s-secondary);font-size:var(--fs-xs);"
                      tal:content="f/uploaded_at">—</span>
                <form method="post"
                      tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
                  <input type="hidden" name="action" value="download_report"/>
                  <input type="hidden" name="filename"
                         tal:attributes="value f/filename"/>
                  <button class="btn btn-action" type="submit">
                    <i class="fas fa-download" style="font-size:var(--fs-xs);"></i> Download
                  </button>
                </form>
              </div>
            </tal:f>
          </div>
        </tal:has_files>
      </tal:files>

      <!-- upload form -->
      <tal:can_upload tal:condition="view/can_act">
        <div class="ir-upload-box">
          <form method="post" enctype="multipart/form-data"
                tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
            <input type="hidden" name="action" value="upload_instrument_report"/>
            <label for="ir-file-input">
              <i class="fas fa-cloud-upload-alt" style="font-size:var(--fs-xl);display:block;margin-bottom:6px;"></i>
              Click to upload instrument report (PDF, CSV, TSV)
            </label>
            <div class="ir-upload-row">
              <input id="ir-file-input" type="file" name="report_file" accept=".pdf,.csv,.tsv,.txt"/>
              <button class="btn btn-action" type="submit">Upload</button>
            </div>
          </form>
        </div>
      </tal:can_upload>

      <!-- CSV preview -->
      <tal:prev tal:define="preview view/get_csv_preview">
        <tal:has_prev tal:condition="preview|nothing">
          <div class="tree-heading" style="margin-top:14px;">
            Data Preview (first 100 rows)
          </div>
          <div class="csv-preview-wrap">
            <table class="csv-preview" data-col-resize="data-review-csv-preview">
              <thead tal:condition="python:len(preview) > 0">
                <tr>
                  <tal:th tal:repeat="h python:preview[0]">
                    <th tal:content="h">H</th>
                  </tal:th>
                </tr>
              </thead>
              <tbody>
                <tal:row tal:repeat="row python:preview[1:]">
                  <tr>
                    <tal:cell tal:repeat="cell row">
                      <td tal:content="cell">v</td>
                    </tal:cell>
                  </tr>
                </tal:row>
              </tbody>
            </table>
          </div>
        </tal:has_prev>
      </tal:prev>

      <!-- manual integrations -->
      <section class="bench-block" tal:define="g view/mi_gate; ws python:view._get_worksheet()" tal:condition="python:ws is not None">
        <h2 class="bench-h">Manual integration</h2>
        <ul class="bench-alerts dr-mi">
          <li tal:attributes="class python:'bench-ok' if g[0] else 'bench-bad'">
            <strong tal:content="python:('%d listed; complete' % g[2]) if g[0] and g[2] else ('None listed' if g[0] else 'Not complete')">None</strong>
            <span tal:condition="not:python:g[0]" tal:content="python:'; '.join(g[1])">missing</span>
            <a class="btn-sm btn-secondary" tal:attributes="href python:ws.absolute_url() + '/@@pfas-manual-integration'">Open manual integration review</a>
            <a class="btn-sm btn-secondary" target="_blank" tal:condition="python:g[3]"
               tal:attributes="href python:ws.absolute_url() + '/@@pfas-mi-report?which=stamped'">Stamped copy</a>
            <tal:h define="hid string:manual-integration"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h>
          </li>
        </ul>
      </section>

      <!-- mark reviewed -->
      <div style="margin-top:16px;">
        <tal:ir_check
            tal:condition="python:not [i for i in view.checklist_status() if i['key']=='instrument_report' and i['checked']] and view.can_act()">
          <form method="post"
                tal:attributes="action string:${view/batch_url}/@@pfas-data-review">
            <input type="hidden" name="action" value="check_item"/>
            <input type="hidden" name="item_key" value="instrument_report"/>
            <input type="hidden" name="tab" value="instrument_report"/>
            <input type="text" name="initials" required="required" placeholder="Initials" maxlength="6" style="width:74px;padding:4px 6px;font-size:var(--fs-sm);border:1px solid var(--s-border);border-radius:4px;text-transform:uppercase;margin-right:6px;"/>
            <button class="btn btn-action" type="submit">Mark Instrument Report Reviewed</button>
          </form>
        </tal:ir_check>
      </div>

    </div><!-- /instrument_report -->

  </div><!-- /page-body -->
  </tal:with_ws>

  </div><!-- /content -->
</body>
</html>
