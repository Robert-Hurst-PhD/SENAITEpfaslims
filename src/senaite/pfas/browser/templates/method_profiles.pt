<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">PFAS Method Profiles</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
    /* ── Method profiles page-specific ────────────────────────────────── */
    .lead { color: var(--s-secondary); margin-bottom: 20px; font-size: 13px; }

    .method-id { font-family: monospace; font-size: 12px; color: var(--s-primary);
                 background: var(--s-primary-lt); padding: 2px 6px; border-radius: 3px; }
    .badge { font-size: 10px; padding: 2px 7px; border-radius: 10px;
             font-weight: 700; text-transform: uppercase; }
    .badge-custom  { background: #d4edda; color: #155724; }
    .badge-default { background: #fff3cd; color: #856404; }

    .desc { color: var(--s-secondary); font-size: 12px; margin-top: 2px; }
  </style>
  </tal:styles>
</head>
<body>
  <tal:t metal:fill-slot="header-title">PFAS Method Profiles</tal:t>
  <tal:r metal:fill-slot="header-right">
    <a class="back-link" tal:attributes="href string:${view/portal_url}/@@pfas-control-chart">
      Control Charts
    </a>
    <a class="back-link" tal:attributes="href string:${context/absolute_url}/@@lims-setup">
      Site Setup
    </a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <p class="lead">
      Configure per-method QC acceptance criteria. Changes are saved immediately
      to the database and exported to the pipeline worker automatically.
      Managers and Lab Managers may edit; bench analysts have read-only access via
      the normal SENAITE views.
    </p>

    <table class="pfas-table" style="border-radius:6px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.08)">
      <thead>
        <tr>
          <th>Method ID</th>
          <th>Display Name</th>
          <th>Description</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <tr tal:repeat="m view/methods">
          <td>
            <span class="method-id" tal:content="m/method_id">FDA_32PFAS</span>
          </td>
          <td tal:content="m/display_name">FDA 32-PFAS in Food</td>
          <td>
            <div class="desc" tal:content="m/description">...</div>
          </td>
          <td>
            <span class="badge badge-custom"  tal:condition="m/is_customised">Customised</span>
            <span class="badge badge-default" tal:condition="not:m/is_customised">Default</span>
          </td>
          <td>
            <a class="btn btn-primary"
               tal:attributes="href string:@@pfas-method-profile-edit?method_id=${m/method_id}">
              Edit
            </a>
          </td>
        </tr>
      </tbody>
    </table>

  </div>
  </div><!-- /content slot -->
</body>
</html>
