<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Extraction Guide</title>
  <tal:styles metal:fill-slot="head-extra">
  <link rel="stylesheet" tal:attributes="href string:${view/portal_url}/++resource++senaite.pfas/logbook_fields.css?v=${context/@@pfas-macros/asset_version}" />
  <style>
    /* Buttons use the shared set (.btn, .btn-sm, .btn-lg + variants); only
       layout that is specific to this page stays here. */
    /* ── Touch-friendly tablet layout ─────────────────────── */
    body { touch-action: manipulation; }
    .eg-layout { display:flex; min-height:80vh; gap:0; }

    /* ── Stage sidebar ──────────────────────────────────────── */
    .eg-sidebar { width:220px; flex-shrink:0; background:var(--surface-2); border-right:1px solid var(--line);
                  padding:16px 0; overflow-y:auto; }
    .eg-sidebar .method-badge { font-size:var(--fs-xs); color:var(--text-muted); text-transform:uppercase;
                                letter-spacing:.5px; padding:0 16px 12px;
                                border-bottom:1px solid var(--line); margin-bottom:8px; }
    .eg-sidebar .method-name { font-size:var(--fs-base); font-weight:var(--fw-heading); color:var(--text); }
    /* the stage list is the shared .pfas-stepper (is-vertical); the link sits inside its step */
    .stage-name { font-size:var(--fs-sm); line-height:1.3; }
    a.stage-item:not([href]) { cursor:default; }
    .pfas-stepper li.is-current .stage-name, .pfas-stepper li.is-viewing .stage-name { font-weight:var(--fw-strong); }

    /* ── Narrow screens: the stage list becomes a stepper on top ── */
    @media (max-width: 1100px) {
      .eg-layout { flex-direction:column; }
      .eg-sidebar { width:auto; padding:10px 0 0; border-right:0; border-bottom:1px solid var(--line); }
      .eg-sidebar .method-badge { border-bottom:0; margin-bottom:0; padding-bottom:6px; }
      .stage-name { font-size:var(--fs-xs); }
      .eg-main { max-width:none; padding:16px; }
      .sample-table { display:block; overflow-x:auto; }
    }

    /* ── Progress bar ────────────────────────────────────────── */
    .progress-bar-wrap { padding:0 16px 12px; border-bottom:1px solid var(--line); }
    .progress-bar { height:4px; background:var(--line); border-radius:2px; margin-top:6px; }
    .progress-fill { height:4px; background:var(--s-success); border-radius:2px;
                     transition:width .4s; }
    .progress-label { font-size:var(--fs-xs); color:var(--text-muted); }

    /* ── Main content area ───────────────────────────────────── */
    .eg-main { flex:1; padding:24px; overflow-y:auto; min-width:0; }   /* fills the page */
    .eg-stage-header { margin-bottom:20px; padding-bottom:12px;
                       border-bottom:2px solid var(--s-border); }
    .eg-stage-header .stage-title { font-size:var(--fs-xl); font-weight:var(--fw-heading); color: var(--text); }
    .eg-stage-header .stage-desc  { font-size:var(--fs-base); color:var(--s-secondary); margin-top:4px; }
    .eg-stage-header .stage-badge { display:inline-block; font-size:var(--fs-xs);
                                    padding:3px 10px; border-radius:10px;
                                    background:var(--s-info-lt); color:var(--s-info-text);
                                    font-weight:var(--fw-heading); margin-bottom:8px; }

    /* ── Cards / sections ────────────────────────────────────── */
    .eg-media-card { text-align:center; }
    .eg-stage-img { image-rendering:pixelated; image-rendering:crisp-edges; max-width:100%; max-height:52vh; object-fit:contain;
                    display:block; margin:0 auto; border-radius:6px; }
    .eg-card { background:var(--surface-raised); border:1px solid var(--s-border); border-radius:10px;
               padding:18px; margin-bottom:16px; }
    .eg-card h3 { font-size:var(--fs-base); font-weight:var(--fw-heading); color: var(--text);
                  margin:0 0 14px; padding-bottom:6px;
                  border-bottom:1px solid var(--s-border); }

    /* ── Reagent confirmation rows ───────────────────────────── */
    .reagent-row { display:flex; gap:12px; align-items:center;
                   padding:10px 0; border-bottom:1px solid var(--line); }
    .reagent-row > .pfas-form-row { flex:1 1 auto; min-width:0; margin:0; }
    .reagent-row:last-child { border-bottom:0; }
    .reagent-role { font-weight:var(--fw-strong); font-size:var(--fs-base); }
    .reagent-lot-sel, .reagent-role-field { font-size:var(--fs-base); padding:7px 10px;
                         border:1px solid var(--s-input-border); border-radius:6px; }
    .reagent-miss { flex-basis:100%; font-size:var(--fs-sm); color:var(--s-danger, var(--s-danger)); }
    .reagent-hint { font-size:var(--fs-sm); color:var(--s-muted, var(--s-secondary)); margin:-6px 0 8px; }
    .reagent-add { margin-top:6px; }
    .eg-alert { margin:12px 16px; }
    .eg-lead { color:var(--s-secondary); margin-bottom:24px; }
    .batch-line { margin-top:3px; }
    .sol-actions { margin-top:10px; display:flex; gap:8px; }
    .stage-analyst-field { font-size:var(--fs-base); padding:9px 12px; border:1px solid var(--s-input-border);
                           border-radius:6px; width:300px; max-width:100%; }
    .receive-box { border:1px dashed var(--s-input-border); border-radius:6px;
                   padding:10px 12px; font-size:var(--fs-sm); }
    .receive-grid { display:flex; flex-wrap:wrap; gap:8px; margin:8px 0; }
    .receive-grid input, .receive-grid select { flex:1 1 160px; padding:6px 8px;
                   border:1px solid var(--s-input-border); border-radius:6px; font-size:var(--fs-sm); }
    .sample-table { width:100%; }
    .sample-table input, .sample-table select { padding:5px 8px; border:1px solid var(--s-input-border);
                   border-radius:6px; width:100%; min-width:80px; box-sizing:border-box; }
    .dilution-form { display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
    .dilution-form input, .dilution-form select { padding:6px 8px; border:1px solid var(--s-input-border);
                   border-radius:6px; flex:1 1 180px; }
    .dilution-card { margin-top:16px; }
    .needs-note { border-left:4px solid var(--s-warning, var(--s-warning)); background:var(--s-warning-bg, var(--s-warn-lt));
                  padding:8px 12px; margin-bottom:10px; font-size:var(--fs-sm); border-radius:4px; }
    .needs-note ul { margin:4px 0 0 18px; padding:0; }
    .reagent-qty-field { font-size:var(--fs-base); padding:7px 10px; border:1px solid var(--s-input-border);
                         border-radius:6px; width:90px; }
    .reagent-status-sel { font-size:var(--fs-sm); padding:6px 8px; border:1px solid var(--s-input-border);
                          border-radius:6px; }
    .reagent-status-sel.flagged { border-color:var(--s-danger); background:var(--s-danger-lt); }
    .exp-warn { color:var(--s-warn-text); font-size:var(--fs-xs); font-weight:var(--fw-heading); }
    .exp-expired { color: var(--s-danger-dk); font-size:var(--fs-xs); font-weight:var(--fw-heading); }
    .inv-match { font-size:var(--fs-xs); color: var(--s-primary-dk); cursor:pointer; }

    /* ── Equipment S/N grid ──────────────────────────────────── */
    .eq-grid { display:flex; flex-wrap:wrap; gap:12px; }
    .eq-field { display:flex; flex-direction:column; flex:1 1 160px; }
    .eq-field label { font-size:var(--fs-sm); font-weight:var(--fw-strong); margin-bottom:3px; color: var(--text); }
    .eq-field input, .eq-field select { padding:7px 10px; font-size:var(--fs-base);
                      border:1px solid var(--s-input-border); border-radius:6px; margin-bottom:4px; }
    .eq-hint { font-size:var(--fs-xs); color:var(--s-muted, var(--s-secondary)); }

    /* ── Solutions prepared ──────────────────────────────────── */
    .sol-card { background:var(--s-success-lt); border:1px solid var(--s-success-bd); border-radius:8px;
                padding:14px; margin-bottom:10px; }
    .sol-card h4 { font-size:var(--fs-sm); font-weight:var(--fw-heading); color:var(--s-success-text); margin:0 0 10px; }
    .sol-fields { display:flex; gap:10px; flex-wrap:wrap; }
    .sol-field { display:flex; flex-direction:column; flex:1 1 120px; }
    .sol-field label { font-size:var(--fs-xs); font-weight:var(--fw-strong); margin-bottom:3px; }
    .sol-field input { padding:6px 8px; font-size:var(--fs-sm);
                       border:1px solid var(--s-input-border); border-radius:5px; }

    /* ── Pedigree section ────────────────────────────────────── */
    .ped-standard { background:var(--s-light); border:1px solid var(--s-border);
                    border-radius:8px; padding:14px; margin-bottom:12px; }
    .ped-standard h4 { font-size:var(--fs-base); font-weight:var(--fw-heading); margin:0 0 10px; color: var(--text); }
    .ped-level { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:8px;
                 padding:8px; background:var(--surface-raised); border-radius:6px;
                 border:1px solid var(--line); }
    .ped-level-badge { font-size:var(--fs-xs); font-weight:var(--fw-heading); padding:2px 8px;
                       border-radius:8px; background:var(--s-info-lt); color: var(--s-primary-dk);
                       white-space:nowrap; align-self:center; min-width:80px;
                       text-align:center; }
    .ped-field { display:flex; flex-direction:column; flex:1 1 110px; max-width:150px; }
    .ped-field label { font-size:var(--fs-xs); font-weight:var(--fw-strong); margin-bottom:3px; }
    .ped-field input { padding:5px 8px; font-size:var(--fs-sm);
                       border:1px solid var(--s-input-border); border-radius:5px; }

    /* ── Deviations ──────────────────────────────────────────── */
    .deviation-field { width:100%; min-height:80px; padding:10px; font-size:var(--fs-base);
                       border:1px solid var(--s-input-border); border-radius:6px;
                       resize:vertical; box-sizing:border-box; }

    /* ── Action buttons ──────────────────────────────────────── */
    .stage-actions { display:flex; gap:12px; margin-top:20px; flex-wrap:wrap;
                     padding-top:16px; border-top:2px solid var(--s-border); }
    /* the stage's primary action stays in reach (6B pinned action bar) */
    #stage-form > .stage-actions { position:sticky; bottom:0; z-index:5; padding:12px 0;
                     background:var(--surface); }
    .recorded-by { margin:-8px 0 14px; font-size:var(--fs-sm); color:var(--s-secondary);
                   display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
    .summary-card h3 { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
    .summary-meta { font-weight:var(--fw-body); font-size:var(--fs-sm); color:var(--s-secondary); }
    .summary-line { font-size:var(--fs-sm); margin:6px 0; }
    .summary-warn { margin:2px 0 6px 18px; font-size:var(--fs-sm); }

    /* ── Start screen ────────────────────────────────────────── */
    .eg-start { margin:40px 24px; text-align:center; }   /* the batch table fills the page */
    .eg-batch-table { width:100%; text-align:left; }
    .eg-start .start-form { max-width:500px; margin:0 auto; }
    .eg-start h2 { font-size:var(--fs-xl); font-weight:var(--fw-heading); margin-bottom:8px; }
    .eg-start p { color:var(--s-secondary); margin-bottom:24px; }
    .start-form { text-align:left; }
    .start-form label { font-size:var(--fs-base); font-weight:var(--fw-strong); display:block; margin-bottom:4px; }
    .start-form select, .start-form input { width:100%; padding:10px 12px; font-size:var(--fs-base);
      border:1px solid var(--s-input-border); border-radius:8px; margin-bottom:14px; box-sizing:border-box; }

    /* ── Done screen ─────────────────────────────────────────── */
    .eg-done { text-align:center; padding:40px 20px; }
    .eg-done .check { font-size:64px; margin-bottom:16px; }
    .eg-done h2 { font-size:var(--fs-2xl); font-weight:var(--fw-heading); margin-bottom:8px; color: var(--s-success-text); }
  </style>
  </tal:styles>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Guided Extraction</tal:t>
  <tal:r metal:fill-slot="header-right">
    <a class="btn-sm btn-secondary btn-back" tal:attributes="href view/batch_url">Worksheet</a>
  </tal:r>

  <div metal:fill-slot="content">

    <div tal:condition="view/ok_msg"    class="alert alert-success eg-alert"    tal:content="view/ok_msg"></div>
    <div tal:condition="view/error_msg" class="alert alert-error eg-alert" tal:content="view/error_msg"></div>
    <div tal:define="notes view/plan_notes" tal:condition="notes" class="alert alert-info eg-alert">
      Stages as started (method <tal:r tal:replace="view/plan_revision"/>). Since then:
      <ul><li tal:repeat="n notes" tal:content="n">note</li></ul>
    </div>

    <!-- ─── JS data ──────────────────────────────────────────── -->
    <script>
    var SESSION     = <tal:d tal:replace="structure view/session_json" />;
    var STAGE_LOTS  = <tal:d tal:replace="structure view/stage_lots_json" />;
    var DRAFT       = <tal:d tal:replace="structure view/stage_draft_json" />;
    var EQUIPMENT   = <tal:d tal:replace="structure view/stage_equipment_json" />;
    var CATEGORIES  = <tal:d tal:replace="structure view/categories_json" />;
    var SUPPLIERS   = <tal:d tal:replace="structure view/suppliers_json" />;
    var SAMPLE_CARD = <tal:d tal:replace="structure view/sample_card_json" />;
    var PEDIGREE    = <tal:d tal:replace="structure view/pedigree_json" />;
    var PORTAL_URL  = "<tal:p tal:replace="view/portal_url" />";
    var BATCH_UID   = "<tal:b tal:replace="view/batch_uid" />";
    var SELF_URL    = PORTAL_URL + "/@@pfas-extraction-guide";
    var LABEL_URL   = PORTAL_URL + "/@@pfas-label";
    </script>

    <!-- ════════════════════════════════════════════════════════════
         START SCREEN — no session yet
         ════════════════════════════════════════════════════════════ -->
    <tal:pick tal:condition="not:view/batch_uid">
    <div class="eg-start" tal:define="pg view/queue_paging; rows view/batch_choices">
      <h2>Choose a worksheet</h2>
      <form method="get" class="pfas-filterbar" data-autosubmit="data-autosubmit"
            tal:attributes="action string:${view/portal_url}/@@pfas-extraction-guide">
        <input type="hidden" name="show" tal:attributes="value view/queue_show" />
        <div class="pfas-form-field"><span>Show</span>
          <nav class="pfas-seg" aria-label="Show">
            <a class="pfas-seg-item" tal:repeat="o view/queue_shows"
               tal:attributes="href o/url; aria-selected python:'true' if o['on'] else 'false'"
               tal:content="o/label">Not finished</a>
          </nav></div>
        <div class="pfas-form-field"><label for="eg-q">Search</label>
          <input type="search" name="q" id="eg-q" class="pfas-input pfas-input-wide"
                 placeholder="Worksheet, CoC or method" tal:attributes="value view/queue_q" /></div>
        <noscript><button type="submit" class="btn btn-primary">Filter</button></noscript>
      </form>
      <table class="pfas-table eg-batch-table" data-col-resize="extraction-guide-eg-batch-table" tal:condition="rows" tal:define="rm context/@@pfas-row-menu">
        <thead><tr><th>Worksheet</th><th>Method</th><th>Extraction</th></tr></thead>
        <tbody>
          <tal:rw tal:repeat="r rows">
          <tr tal:define="act python:view.queue_action(r)"
              tal:attributes="data-row-open python:view.queue_open_url(r);
                              data-row-actions python:rm.actions((act['label'], 'href', act['url']) if act and act['url'] != view.queue_open_url(r) else None)">
            <td><strong tal:content="r/id">B-1</strong>
                <span tal:content="r/title">title</span></td>
            <td tal:content="r/method_label">FDA</td>
            <td tal:content="r/label">Not started</td>
          </tr>
          </tal:rw>
        </tbody>
      </table>
      <p class="form-note" tal:condition="not:rows" tal:content="view/queue_empty_text">None.</p>
      <metal:p use-macro="context/@@pfas-macros/macros/paging" />
    </div>
    </tal:pick>

    <tal:empty tal:condition="python:view.batch_uid() and not view.session() and not view.has_samples()">
    <div class="eg-start">
      <h2>No samples</h2>
      <p tal:content="string:Batch: ${view/batch_title}"></p>
      <a class="btn btn-primary" tal:attributes="href string:${view/batch_url}/@@pfas-worksheet-samples">Add samples</a>
    </div>
    </tal:empty>

    <tal:start tal:condition="python:view.batch_uid() and not view.session() and view.has_samples()">
    <div class="eg-start">
      <h2>Start Extraction</h2>
      <p tal:content="string:Batch: ${view/batch_title}"></p>
      <form method="post" class="start-form"
            tal:attributes="action string:${view/portal_url}/@@pfas-extraction-guide">
        <input type="hidden" name="action"    value="start" />
        <input type="hidden" name="batch_uid" tal:attributes="value view/batch_uid" />

        <span>Method</span>
        <tal:mc tal:define="mc_choices python:[{'value': p[0], 'label': p[1]} for p in view.available_methods()];
                            mc_value view/batch_method_id; mc_label string:Method; mc_id string:eg-method; mc_name string:method_id"><metal:m use-macro="context/@@pfas-macros/macros/method-choice" /></tal:mc>

        <label>Lead analyst</label>
        <input type="text" name="analyst" placeholder="Your name" required="required"
               tal:attributes="value view/current_user_name" />

        <button class="btn-lg btn-primary btn-block" type="submit">Begin Extraction &#8594;</button>
      </form>
    </div>
    </tal:start>

    <!-- ════════════════════════════════════════════════════════════
         FINALIZED — show completion and PDF link
         ════════════════════════════════════════════════════════════ -->
    <tal:done tal:condition="python: view.session() and view.is_finalized()">
    <div class="eg-done">
      <div class="check"><tal:m tal:define="ic context/@@pfas-icons" tal:replace="structure python:ic.svg('pass', hidden=True, size='lg')" /></div>
      <h2>Extraction Complete</h2>
      <p class="eg-lead" tal:define="gap view/finalised_gap">
        <tal:all tal:condition="not:gap">All stages recorded.</tal:all>
        <tal:gap tal:condition="gap" tal:content="string:Finalised, ${gap}."></tal:gap>
        Print the batch record below.
      </p>
      <a class="btn-lg btn-primary" tal:attributes="href view/pdf_url" target="_blank">Download the batch record PDF</a>
      <br/><br/>
      <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-reagents"
        >View Reagent Inventory</a>
    </div>
    </tal:done>

    <!-- ════════════════════════════════════════════════════════════
         ACTIVE SESSION — stage-by-stage UI
         ════════════════════════════════════════════════════════════ -->
    <tal:active tal:condition="python: view.session() and not view.is_finalized()">
    <div class="eg-layout">

      <!-- ── Sidebar ─────────────────────────────────────────────── -->
      <div class="eg-sidebar">
        <div class="method-badge">
          <div class="method-name" tal:content="python:view.method_profile().get('display_name','')"></div>
          <div class="batch-line" tal:content="python:'Batch: ' + view.batch_title()"></div>
        </div>
        <div class="progress-bar-wrap">
          <div class="progress-label"
               tal:content="python:'{0}% complete'.format(view.progress_pct())"></div>
          <div class="progress-bar">
            <div class="progress-fill"
                 tal:attributes="style python:'width:{0}%'.format(view.progress_pct())"></div>
          </div>
        </div>
        <ol class="pfas-stepper is-vertical stage-list">
        <tal:stages tal:repeat="stage view/extraction_stages">
          <tal:define tal:define="status python:view.stage_status(stage);
                                  viewing python:view.view_order() == stage.get('order');
                                  href python:view.stage_url(stage.get('order')) if status == 'done' else (view.stage_url() if status == 'active' else None)">
          <li tal:attributes="class python:' '.join(c for c in ('is-done' if status == 'done' else None, 'is-current' if status == 'active' else None, 'is-viewing' if viewing else None) if c) or None">
            <a tal:attributes="class python:'stage-item ' + status + (' viewing' if viewing else '');
                               href href;
                               title python:'Open this stage' if href else 'Not reached yet'">
              <span class="stage-name" tal:content="python:stage.get('name','')"></span>
            </a>
          </li>
          </tal:define>
        </tal:stages>
        </ol>
      </div>

      <!-- ── Main content ────────────────────────────────────────── -->
      <div class="eg-main">
        <!-- sources that name another method than the batch's (batch_method.py) -->
        <ul class="bench-alerts" tal:define="mc view/method_conflicts" tal:condition="mc">
          <li class="bench-warn" tal:repeat="c mc">
            <strong>Method disagrees:</strong>
            <span tal:content="python:u'%s says %s; this batch is %s.' % (c[0], view.method_name(c[1]), view.method_name(view._method_id()))">x</span></li>
        </ul>

        <!-- ── A completed stage read-only (?stage=N), or the Review &amp; finalize
             screen once every stage is done: one summary per stage. ── -->
        <tal:summary tal:define="mode view/mode"
                     tal:condition="python: mode in ('view', 'review')">
        <tal:d tal:define="rv python: view.review_data() if mode == 'review' else None;
                           stages python: rv['stages'] if rv else [view.viewed_stage()]">
        <div class="eg-stage-header" tal:condition="rv">
          <div class="stage-badge">All stages recorded</div>
          <div class="stage-title">Review &amp; finalize</div>
          <div class="stage-desc">Check everything recorded below, then finalize. A stage can
            still be corrected (open it from the list); after finalizing, a correction is a
            deviation.</div>
        </div>
        <div class="needs-note" tal:condition="python: rv and rv['unnoted']">
          <strong>Needs a note</strong> &#8212; stage(s)
          <span tal:replace="python: ', '.join('%s' % o for o in rv['unnoted'])">2</span>
          have warnings without a deviation note.</div>
        <div class="eg-card summary-card" tal:repeat="st stages">
          <h3>
            <span tal:replace="python: 'Stage %s: %s' % (st['order'], st['name'])">Stage 1</span>
            <span class="summary-meta" tal:condition="st/completed_at"
                  tal:content="python: u'%s \u00b7 %s' % (st['analyst'] or u'\u2014', view.lab_at(st['completed_at'], st['completed_at'][:16].replace('T', ' ')))">AN1</span>
            <a class="btn-sm btn-secondary" tal:condition="python: rv is not None"
               tal:attributes="href python: view.stage_url(st['order'])">Open</a>
          </h3>
          <table class="pfas-table" data-col-resize="extraction-guide-1" tal:condition="python: st['reagents'] or st['consumables']">
            <thead><tr><th>Item</th><th>Lot</th><th>Qty</th></tr></thead>
            <tbody><tr tal:repeat="r python: st['reagents'] + st['consumables']">
              <td tal:content="python: r['name'] or r['role']">Methanol</td>
              <td><span tal:replace="python: r['lot'] or u'\u2014'">L1</span>
                  <span class="exp-warn" tal:condition="python: r['lot'] and not r['from_inventory']">typed</span></td>
              <td tal:content="python: r['qty'] or u'\u2014'">5 mL</td>
            </tr></tbody>
          </table>
          <p class="summary-line" tal:condition="st/equipment">
            <strong>Equipment:</strong>
            <span tal:replace="python: ', '.join('%s %s' % (k, v or '(no serial)') for k, v in st['equipment'])">Balance</span></p>
          <p class="summary-line" tal:condition="st/samples">
            <strong>Per sample:</strong>
            <span tal:replace="python: ', '.join('%s %s %s' % (x['sample_id'], x['value'] or u'\u2014', x['unit']) for x in st['samples'])">S-1 1 g</span></p>
          <tal:w tal:condition="st/warnings">
            <p class="summary-line"><strong>Needed a note:</strong></p>
            <ul class="summary-warn"><li tal:repeat="w st/warnings" tal:content="w">x</li></ul>
          </tal:w>
          <p class="summary-line" tal:condition="st/homogenisation"><strong>Homogenised:</strong>
            <span tal:replace="python: u'; '.join(u'%s %s' % (h['sample_id'], h['method'] or u'\u2014') for h in st['homogenisation'])">x</span></p>
          <p class="summary-line" tal:condition="st/confirmed"><strong>Checked:</strong>
            <span tal:replace="python: u'; '.join(st['confirmed'])">x</span></p>
          <p class="summary-line" tal:condition="st/answers|nothing"><strong>Recorded:</strong>
            <span tal:replace="python: u'; '.join(u'%s: %s' % (a[0], a[1]) for a in st['answers'])">x</span></p>
          <p class="summary-line" tal:condition="st/deviations"><strong>Note:</strong>
            <span tal:replace="st/deviations">text</span></p>
          <p class="summary-line" tal:repeat="c st/corrections"><strong>Corrected</strong>
            <span tal:replace="python: '%s by %s: %s' % (view.lab_at(c['at'], c['at'][:16].replace('T', ' ')), c['by'], c['reason'])">x</span></p>
          <p class="summary-line" tal:condition="python: not st.get('completed_at')"><em>Not recorded.</em></p>
        </div>

        <!-- viewing one completed stage: correct it, or go back -->
        <tal:v tal:condition="python: mode == 'view'">
        <form method="post" class="eg-card correct-form"
              tal:attributes="action string:${view/portal_url}/@@pfas-extraction-guide">
          <h3>Correct this stage</h3>
          <input type="hidden" name="action" value="reopen_stage" />
          <input type="hidden" name="batch_uid" tal:attributes="value view/batch_uid" />
          <input type="hidden" name="stage_order" tal:attributes="value view/view_order" />
          <textarea class="deviation-field" name="reason" required="required"
                    placeholder="Why does this stage need correcting? The current record is kept."></textarea>
          <div class="stage-actions">
            <button class="btn-sm btn-primary" type="submit">Reopen for correction</button>
            <a class="btn-sm btn-secondary" tal:attributes="href python: view.stage_url()">Back to the current stage</a>
          </div>
        </form>
        </tal:v>

        <!-- review: sign off. Finalise opens the sign dialog; its Sign posts
             the form as the signed-in person, the extraction's preparer -->
        <tal:fin tal:condition="rv">
        <form method="post" class="eg-card" id="egFinalizeForm"
              tal:attributes="action string:${view/portal_url}/@@pfas-extraction-guide">
          <h3>Finalize</h3>
          <input type="hidden" name="action" value="finalize" />
          <input type="hidden" name="batch_uid" tal:attributes="value view/batch_uid" />
          <p class="summary-line">Signed as preparer by <strong tal:content="view/current_user_name">name</strong>.
            Creates the extraction logbook PDF.</p>
          <div class="stage-actions">
            <button type="button" class="btn-lg btn-success" data-modal-open="esig-finalize">Finalise and create PDF</button>
          </div>
        </form>
        <div tal:define="esig view/finalize_esig"><metal:d use-macro="context/@@pfas-esig-macros/macros/sign_dialog" /></div>
        </tal:fin>
        </tal:d>
        </tal:summary>

        <tal:current tal:define="stage view/current_stage"
                     tal:condition="python: view.mode() == 'edit'">
        <div class="eg-stage-header">
          <div class="stage-badge"
               tal:content="python:'Stage {0} of {1}'.format(stage.get('order',''), view.total_stages())"></div>
          <div class="stage-title" tal:content="python:stage.get('name','')"></div>
          <div class="stage-desc"  tal:content="python:stage.get('description','')"></div>
          <div class="stage-desc" tal:condition="python:view.is_processing_stage(stage)">
            This stage is the processing stage: the test portion is taken here.</div>
        </div>

        <!-- Action image for this stage (uploaded on the method profile's
             Lab Workflow tab). Same media store as guided logbook steps. -->
        <tal:media tal:define="murl python:view.stage_media_url(stage)"
                   tal:condition="murl">
          <div class="eg-card eg-media-card">
            <img class="eg-stage-img" id="eg-stage-img"
                 tal:attributes="src murl;
                                 alt python:stage.get('media_alt','') or stage.get('name','')" />
            <div>
              <button type="button" class="btn-sm btn-secondary pfas-add-row" id="eg-replay-btn">&#8635; Replay</button>
            </div>
          </div>
        </tal:media>

        <form method="post"
              tal:attributes="action string:${view/portal_url}/@@pfas-extraction-guide"
              id="stage-form">
          <input type="hidden" name="action"       value="complete_stage" />
          <input type="hidden" name="batch_uid"    tal:attributes="value view/batch_uid" />
          <input type="hidden" name="stage_order"  tal:attributes="value python:str(stage.get('order',''))" />
          <input type="hidden" name="reagents_json"        id="reagents_json_field"        value="[]" />
          <input type="hidden" name="equipment_sns_json"   id="equipment_sns_json_field"   value="{}" />
          <input type="hidden" name="solutions_prepared_json" id="solutions_json_field"    value="[]" />

          <!-- ── Who recorded this stage: the login, changeable once ── -->
          <div class="recorded-by" tal:define="who python:view.stage_draft().get('analyst') or view.session().get('analyst','')">
            Recorded by <strong id="recorded-by-name" tal:content="who">name</strong>
            <button type="button" class="btn-sm btn-secondary"
                    onclick="var f=document.getElementById('stage-analyst-field');f.hidden=false;f.focus();this.hidden=true;">Change</button>
            <input type="text" name="stage_analyst" id="stage-analyst-field" class="stage-analyst-field" hidden="hidden"
                   tal:attributes="value who" placeholder="Analyst name" />
          </div>

          <!-- The stage as designed (stage_form.layout): the extraction's blocks at
               their questions' places, the lab's own questions between them -->
          <tal:lay tal:repeat="it python:view.stage_layout(stage)">
          <tal:b tal:condition="python:it.get('block') == 'samples'">
  <!-- ── Per-sample table: written to the extraction record's samples rows ── -->
            <tal:smp tal:define="card python:__import__('json').loads(view.sample_card_json())"
                     tal:condition="card/column">
            <div class="eg-card" id="sample-card">
              <h3 tal:content="python:{'amount': 'Sample amounts', 'spe_port': 'SPE ports'}.get(card['column'], 'Final extract volumes')">Sample amounts</h3>
              <p class="reagent-hint" tal:condition="python:card['column'] == 'amount'">Grams for a solid, mL for a water.</p>
              <p class="reagent-hint" tal:condition="python:card['column'] == 'final_volume_ml'">Each extract's final volume.</p>
              <table class="pfas-table sample-table" data-col-resize="extraction-guide-sample-table">
                <thead><tr><th>Sample</th>
                  <th tal:content="python:'Role' if card['column'] == 'spe_port' else 'Matrix'">Matrix</th>
                  <th tal:content="python:{'amount': 'Amount', 'spe_port': 'SPE port'}.get(card['column'], 'Final volume (mL)')">Amount</th>
                  <th tal:condition="python:card['column'] == 'amount'">Unit</th></tr></thead>
                <tbody id="sample-rows"></tbody>
              </table>
              <button type="button" class="btn-sm btn-secondary reagent-add" onclick="addSampleRow()"
                      tal:condition="python:card['column'] != 'spe_port'">+ Add a sample</button>
              <input type="hidden" name="samples_json" id="samples_json_field" value="[]" />
            </div>
            </tal:smp>
          </tal:b>
          <tal:b tal:condition="python:it.get('block') == 'reagents'">
  <!-- ── Reagent confirmation ── -->
            <tal:rgs tal:condition="python:stage.get('reagent_roles')">
            <div class="eg-card" id="reagent-card">
              <h3>Reagents and standards used</h3>
              <p class="reagent-hint">Pick the lot you used, or scan its label. Only lots that
                are in date and not quarantined are listed.</p>
              <div id="reagent-rows"></div>
              <button type="button" class="btn-sm btn-secondary reagent-add"
                      onclick="addReagentRow('reagent')">+ Add another item</button>
            </div>
            </tal:rgs>
          </tal:b>
          <tal:b tal:condition="python:it.get('block') == 'consumables'">
  <!-- ── Consumables, by lot ── -->
            <tal:cons tal:condition="python:stage.get('consumables')">
            <div class="eg-card" id="consumable-card">
              <h3>Consumables used</h3>
              <p class="reagent-hint">Tubes, vials, syringes and filters are recorded by lot, like reagents.</p>
              <div id="consumable-rows"></div>
              <button type="button" class="btn-sm btn-secondary reagent-add"
                      onclick="addReagentRow('consumable')">+ Add another consumable</button>
            </div>
            </tal:cons>
          </tal:b>
          <tal:b tal:condition="python:it.get('block') == 'equipment'">
  <!-- ── Equipment S/Ns ── -->
            <tal:eqs tal:condition="python:stage.get('equipment')">
            <div class="eg-card">
              <h3>Equipment used</h3>
              <div class="eq-grid" id="eq-grid"></div>
            </div>
            </tal:eqs>
          </tal:b>
          <tal:b tal:condition="python:it.get('block') == 'homogenisation'">
  <!-- ── Each sample's homogenisation (processing stage, H-P4) ── -->
            <tal:hg tal:define="hrows view/homogenisation_rows" tal:condition="hrows">
            <div class="eg-card" id="homogenisation-card">
              <h3>Homogenisation</h3>
              <table class="pfas-table" data-col-resize="extraction-guide-2">
                <thead><tr><th>Sample</th><th>Requested</th><th>Done</th><th>Homogeniser</th>
                           <th>Composite</th><th>By</th><th>When</th></tr></thead>
                <tbody>
                  <tr tal:repeat="h hrows">
                    <td tal:content="h/sample_id">EGG-0001</td>
                    <td tal:content="h/requested">IKA mill</td>
                    <td><span tal:replace="h/method">IKA mill</span>
                        <div class="cf-hint" tal:condition="h/warning" tal:content="h/warning">x</div></td>
                    <td tal:content="h/unit">Mill 1</td>
                    <td><span tal:replace="h/composite">Composite of 12 units</span>
                        <tal:u condition="h/units_combined">(<span tal:replace="h/units_combined">12</span> combined)</tal:u></td>
                    <td tal:content="h/by">AN1</td>
                    <td tal:content="h/at">2026-10-06 10:00</td>
                  </tr>
                </tbody>
              </table>
              <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-homogenisation">Homogenisation</a>
            </div>
            </tal:hg>
          </tal:b>
          <tal:b tal:condition="python:it.get('block') == 'checks'">
  <!-- ── Checks the method asks to be ticked (stage editor) ── -->
            <tal:chk tal:define="checks python:[c for c in stage.get('confirmations') or [] if c.strip()]"
                     tal:condition="checks">
            <div class="eg-card" id="checks-card" tal:define="ticked view/stage_confirmed">
              <h3>Checks</h3>
              <div tal:repeat="c checks"><label class="pfas-switch">
                <input type="checkbox"
                       tal:attributes="name string:confirmed_${repeat/c/index}; value c;
                                       checked python:c in ticked or None" /><span class="pfas-switch-track"></span>
                <span tal:replace="c">Homogeniser cleaned</span></label></div>
            </div>
            </tal:chk>
          </tal:b>
          <tal:b tal:condition="python:it.get('block') == 'solutions'">
  <!-- ── Solutions prepared (if applicable) ── -->
            <tal:sol tal:condition="python:stage.get('creates_solution', False)">
            <div class="eg-card" id="solutions-card">
              <h3>Solutions Prepared at This Stage</h3>
              <div id="sol-rows"></div>
              <button type="button" class="btn-sm btn-secondary pfas-add-row" onclick="addSolutionRow()">
                + Prepare a New Solution / Label
              </button>
            </div>
            </tal:sol>
          </tal:b>
          <tal:b tal:condition="python:it.get('block') == 'pedigree'">
  <!-- ── Pedigree (spike stages) ── -->
            <tal:ped tal:condition="python:stage.get('capture_pedigree', False)">
            <div class="eg-card" id="pedigree-card">
              <h3>Standard / IS Pedigree</h3>
              <p class="reagent-hint">
                Record the full chain: CRM &rarr; Stock &rarr; Working standard.
                This becomes the parentage record in the final PDF.
              </p>
              <div id="ped-rows"></div>
              <button type="button" class="btn-sm btn-secondary pfas-add-row"
                      onclick="addPedigreeStandard()">+ Add Standard</button>
              <input type="hidden" name="pedigree_json_stage" id="pedigree_hidden" value="{}" />
            </div>
            </tal:ped>
          </tal:b>
          <tal:q tal:condition="python:it.get('field')">
            <div tal:define="field python:it['field']"
                 tal:attributes="class python:'eg-question' if field.get('type') == 'section' else 'eg-card eg-question'">
              <tal:m metal:use-macro="context/@@pfas-record-macros/macros/logbook_field" />
            </div>
          </tal:q>
          </tal:lay>

          <!-- ── Additional equipment: a device that performed the stage (an SPE
               system, an evaporator, a pipetting robot) is recorded here; the
               analyst still records and signs the stage ── -->
          <div class="eg-card" id="extra-equipment-card">
            <h3>Additional equipment</h3>
            <p class="reagent-hint">You still sign the stage.</p>
            <div class="eq-grid" id="eq-extra"></div>
            <datalist id="eq-register">
              <option tal:repeat="u view/equipment_register" tal:attributes="value u/serial" tal:content="u/name">DEMO SPE system</option>
            </datalist>
            <button type="button" class="btn-sm btn-secondary pfas-add-row" onclick="addExtraEquipment()">+ Add equipment</button>
          </div>

          <!-- ── Deviations / observations ── -->
          <div class="eg-card" id="deviation-card">
            <h3 id="deviations-title">Deviations / Observations</h3>
            <div class="alert alert-danger" id="cannot-complete"
                 tal:define="blocks python:view.stage_draft().get('blocks') or []"
                 tal:attributes="hidden python:not blocks or None">
              <strong>Cannot complete</strong> &#8212; a note does not change this:
              <ul id="cannot-complete-list">
                <li tal:repeat="w blocks" tal:content="w">Analytical Balance: no balance chosen</li>
              </ul>
            </div>
            <div class="needs-note" id="needs-note"
                 tal:define="warns python:view.stage_draft().get('warnings') or []"
                 tal:attributes="hidden python:not warns or None">
              <strong>Needs a note</strong> &#8212; say what happened and what you did about it:
              <ul id="needs-note-list">
                <li tal:repeat="w warns" tal:content="w">Methanol: no lot recorded</li>
              </ul>
            </div>
            <textarea class="deviation-field" name="deviations" id="deviations-field" aria-labelledby="deviations-title"
                      placeholder="Document any deviations from SOP, unusual observations, or corrective actions taken..."
                      tal:content="python:view.stage_draft().get('deviations') or ''"></textarea>
          </div>

          <!-- ── Stage actions ── -->
          <div class="stage-actions">
            <button class="btn-lg btn-success btn-complete" type="submit"
                    onclick="return prepStageSubmit()">
              Complete Stage
              <tal:next tal:condition="python:(stage.get('order',0) or 0) &lt; view.total_stages()">
                &amp; Next Stage
              </tal:next>
            </button>
          </div>

        </form>


        </tal:current>

      </div><!-- /eg-main -->
    </div><!-- /eg-layout -->
    </tal:active>

    <!-- ════════════════════════════════════════════════════════════
         BATCH QC: the extraction batch's QC and each one's parent and
         level, set before labels on the batch page (extraction_batch.py); shown here, never re-entered.
         ════════════════════════════════════════════════════════════ -->
    <tal:spk tal:condition="python: view.session()">
    <div class="eg-card dilution-card" id="spike-card">
      <h3>Worksheet QC</h3>
      <p class="reagent-hint"><a class="btn-sm" tal:attributes="href view/members_url">Worksheet QC &amp; parents</a></p>
      <table class="pfas-table" data-col-resize="extraction-guide-3" tal:define="rows view/qc_members; ti context/@@pfas-type-icons" tal:condition="rows">
        <thead><tr><th>Injection name</th><th>QC</th><th>Made from</th><th>Level</th><th>Added</th></tr></thead>
        <tbody><tr tal:repeat="r rows">
          <td tal:content="r/injection">WS-1-LFSM1</td><td tal:content="structure python:ti.cell(r['role'])">LFSM</td>
          <td tal:content="python:r.get('parent_injection') or '—'">DW-0001</td>
          <td tal:content="python:r.get('level') or '—'">Mid</td>
          <td tal:content="python:('%s %s' % (r['amount'], r.get('unit') or '')) if r.get('amount') else 'method level'">100 ng/g</td>
        </tr></tbody>
      </table>
    </div>
    </tal:spk>

    <!-- ════════════════════════════════════════════════════════════
         DILUTIONS: logged whenever they are made, also after the
         extraction is finalized (a dilution follows the run). Appended to
         the extraction record, never edited. The optional stage: a
         dilution Data Review asked for is made here, its prep entered
         under the method's dilution rules (dilution_make.py); it is not
         in the stage plan, so finalising never waits on it.
         ════════════════════════════════════════════════════════════ -->
    <tal:dil tal:define="asked view/dilution_requests"
             tal:condition="python: view.session() and (view.mode() in ('review', 'done') or asked)">
    <div class="eg-card dilution-card" id="dilution-card">
      <h3>Dilutions</h3>
      <p class="reagent-hint">Re-injected diluted after reading above the calibration range; the diluted result is added with its own analysis time. <tal:h define="hid string:dilution"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></p>
      <tal:asked tal:condition="asked">
      <table class="pfas-table" data-col-resize="extraction-guide-5">
        <thead><tr><th>Injection</th><th>Asked for</th><th>Why</th><th>Status</th><th>Made as</th></tr></thead>
        <tbody tal:define="rm context/@@pfas-row-menu"><tr tal:repeat="r asked"
            tal:attributes="data-row-actions python:rm.actions((u'Make', 'modal', u'make-%s' % r['id']) if r['status'] == 'open' else None)">
          <td class="pfas-mono" tal:content="r/injection">DW-0001</td>
          <td tal:content="r/asked">Dilution 1:10</td>
          <td tal:content="python:r.get('reason') or '—'">over range</td>
          <td><span tal:attributes="class python:'badge badge-ok' if r['status'] in ('made', 'run') else 'badge badge-pending'"
                    tal:content="python:r['status'].capitalize()">Open</span></td>
          <td class="pfas-mono" tal:content="python:r.get('new_injection') or '—'">DW-0001_DIL10</td>
        </tr></tbody>
      </table>
      <tal:dialogs tal:repeat="r asked" tal:define="opts view/make_options">
        <tal:mk define="make_url string:${view/portal_url}/@@pfas-extraction-guide; make_action string:make_dilution;
                        make_hidden python:[('batch_uid', view.batch_uid())]">
          <metal:d use-macro="context/@@pfas-dilution-make-macros/macros/make-dialog" />
        </tal:mk>
      </tal:dialogs>
      </tal:asked>
      <table class="pfas-table" data-col-resize="extraction-guide-4" tal:define="rows view/dilution_rows" tal:condition="rows">
        <thead><tr><th>Diluted from</th><th>Injection name</th><th>Fold</th><th>Route</th><th>Aliquot</th><th>Logged by</th><th>Logged</th></tr></thead>
        <tbody><tr tal:repeat="r rows">
          <td tal:content="r/dilution_of">S-1</td><td tal:content="r/sample_id">S-1 1:10</td>
          <td tal:content="r/dilution_factor">10</td>
          <td tal:content="python:view.route_label(r.get('route'))">Dilute the extract</td>
          <td tal:content="python:r.get('aliquot') or '—'">25</td>
          <td tal:content="python:r.get('logged_by') or '—'">DEMO</td>
          <td tal:content="python:view.lab_at(r.get('logged_at'), (r.get('logged_at') or '—')[:16].replace('T', ' '))">2026-10-02 14:00</td>
        </tr></tbody>
      </table>
      <form method="post" class="dilution-form"
            tal:attributes="action string:${view/portal_url}/@@pfas-extraction-guide">
        <input type="hidden" name="action" value="log_dilution" />
        <input type="hidden" name="batch_uid" tal:attributes="value view/batch_uid" />
        <select name="dilution_of">
          <option value="">Diluted from&#8230;</option>
          <option tal:repeat="sid view/dilution_parents" tal:attributes="value sid" tal:content="sid">S-1</option>
        </select>
        <input type="text" name="dilution_injection" placeholder="Injection name in the run" />
        <input type="number" name="dilution_factor" min="1.01" step="any" placeholder="Fold, e.g. 2 or 10" />
        <select name="dilution_route" aria-label="Route">
          <option tal:repeat="rt view/dilution_routes" tal:attributes="value python:rt[0]" tal:content="python:rt[1]">Dilute the extract</option>
        </select>
        <input type="number" name="dilution_aliquot" min="0" step="any" placeholder="Aliquot, mL or g" aria-label="Aliquot, mL or g" />
        <input type="text" name="dilution_approval" placeholder="Client approval, who and when" aria-label="Client approval"
               tal:condition="python:view.dilution_settings()['client_approval']" />
        <button class="btn-sm btn-primary" type="submit">Log dilution</button>
      </form>
    </div>
    </tal:dil>


  <script>
  /* ── Utilities ────────────────────────────────────────────────────── */
  var esc = window.PFAS.components.esc;
  /* today is the laboratory's day when the page gives it: an expiry date is
     then expired from its own day on, and "soon" within 30 days of it */
  var DAY_RE = /^\d{4}-\d{2}-\d{2}$/;
  function daysFromLabToday(d) {
    var t = PFAS.components.labToday();
    if (!t || !DAY_RE.test(d || '')) return null;
    return (Date.parse(d + 'T00:00:00Z') - Date.parse(t + 'T00:00:00Z')) / 864e5;
  }
  function todayISO() { return PFAS.components.labToday() || new Date().toISOString().slice(0,10); }
  /* out of date when its expiry is the lab's day or before: a lot is
     expired on its expiry date (lot_expiry.py judges it again) */
  function isExpired(d) {
    var n = daysFromLabToday(d);
    if (n !== null) return n <= 0;
    return !!d && DAY_RE.test(d) && d <= todayISO();
  }
  function expClass(d) {
    if (!d) return '';
    var n = daysFromLabToday(d);
    if (n !== null) return n <= 0 ? 'exp-expired' : (n <= 30 ? 'exp-warn' : '');
    return '';
  }

  /* ═══════════════════════════════════════════════════════════════════
     REAGENT ROWS -- every lot is picked from the inventory ("Bench phase 2"): usable lots only, suggestions first, the
     lab's last pick for the role preselected. Name, lot and expiry come from
     the inventory record; the server re-reads them on completion.
     ═══════════════════════════════════════════════════════════════════ */
  var LOTS = (STAGE_LOTS && STAGE_LOTS.lots) || [];
  var LOT_BY_KEY = {};
  LOTS.forEach(function(l) { LOT_BY_KEY[l.key] = l; });
  var reagentData = [];

  function lotRow(role, key, group) {
    var l = LOT_BY_KEY[key] || null;
    return { group: group || 'reagent',
             role: role || '', key: l ? l.key : '', kind: l ? l.kind : '',
             inventory_uid: l ? l.uid : '', name: l ? l.name : (role || ''),
             lot: l ? l.lot : '', expiry: l ? l.expiry : '',
             qty_used: '', status: 'ok', new_status: '' };
  }

  var ROLE_INFO = (STAGE_LOTS && STAGE_LOTS.roles) || {};
  if (DRAFT && DRAFT.reagents) {
    /* A completion refused for want of a deviation note: reopen on exactly
       what was entered. */
    DRAFT.reagents.forEach(function(d) {
      var row = lotRow(d.role, d.from_inventory ? (d.kind + ':' + d.inventory_uid) : '', d.group);
      if (!d.from_inventory) { row.name = d.name || row.name; row.lot = d.lot || ''; }
      row.qty_used = d.qty_used || '';
      row.new_status = d.new_status || '';
      reagentData.push(row);
    });
  } else {
    /* In the stage's own order (a JSON object's key order is not kept). */
    ((STAGE_LOTS && STAGE_LOTS.role_order) || []).forEach(function(role) {
      reagentData.push(lotRow(role, (ROLE_INFO[role] || {}).default));
    });
    ((STAGE_LOTS && STAGE_LOTS.consumable_order) || []).forEach(function(role) {
      reagentData.push(lotRow(role, (ROLE_INFO[role] || {}).default, 'consumable'));
    });
  }

  function addReagentRow(group) {
    reagentData.push(lotRow('', '', group));
    renderReagents();
  }

  function pickLot(i, key) {
    var keep = reagentData[i];
    var row = lotRow(keep.role, key, keep.group);
    row.qty_used = keep.qty_used;
    reagentData[i] = row;
    renderReagents();
  }

  function lotLabel(l) {
    /* the select shows the lot number only: the item is the row's heading
       (or the group the option sits in) and the expiry is read under it */
    return l.lot || l.name;
  }

  function lotOptions(r) {
    var info = ROLE_INFO[r.role] || {suggested: []};
    var sugg = {}, html = '\u003coption value="">\u2014 choose a lot \u2014\u003c/option>';
    var opt = function(l) {
      return '\u003coption value="' + esc(l.key) + '"' + (l.key === r.key ? ' selected' : '') + '>' +
             esc(lotLabel(l)) + '\u003c/option>';
    };
    if (info.suggested.length) {
      html += '\u003coptgroup label="Suggested">';
      info.suggested.forEach(function(k) { sugg[k] = 1; if (LOT_BY_KEY[k]) html += opt(LOT_BY_KEY[k]); });
      html += '\u003c/optgroup>';
    }
    /* every other usable lot, under the name of its item, so a lot number
       is never read without the item it belongs to */
    var groups = [], by = {};
    LOTS.forEach(function(l) {
      if (sugg[l.key]) return;
      if (!by[l.name]) { by[l.name] = []; groups.push(l.name); }
      by[l.name].push(l);
    });
    groups.forEach(function(name) {
      html += '\u003coptgroup label="' + esc(name) + '">';
      by[name].forEach(function(l) { html += opt(l); });
      html += '\u003c/optgroup>';
    });
    return html;
  }

  /* the chosen lot's expiry on a line under its select, with a chip that
     says whether it is in date (amber within 30 days of its expiry) */
  function lotLine(r) {
    if (!r.key || !r.expiry) return '';
    var ec = expClass(r.expiry);
    var chip = ec === 'exp-expired' ? ['badge-fail', 'Out of date'] : [ec === 'exp-warn' ? 'badge-warn' : 'badge-ok', 'In date'];
    return '\u003cspan class="pfas-hint reagent-lot-line">exp ' + esc(r.expiry) +
           ' \u003cspan class="badge ' + chip[0] + '">' + chip[1] + '\u003c/span>\u003c/span>';
  }

  function renderReagents() {
    var boxes = {reagent: document.getElementById('reagent-rows'),
                 consumable: document.getElementById('consumable-rows')};
    Object.keys(boxes).forEach(function(g) { if (boxes[g]) boxes[g].innerHTML = ''; });
    reagentData.forEach(function(r, i) {
      var el = boxes[r.group] || boxes.reagent;
      if (!el) return;
      var div = document.createElement('div');
      div.className = 'reagent-row';
      /* the fields on the form grid; the remove mark after the grid, at the
         same place on every row */
      div.innerHTML = '\u003cdiv class="pfas-form-row">' +
        (r.role ? '\u003cspan class="reagent-role is-full">' + esc(r.role) + '\u003c/span>'
                : '\u003clabel class="pfas-form-field">\u003cspan>Used for\u003c/span>' +
                  '\u003cinput class="reagent-role-field" type="text"' +
                  ' value="' + esc(r.role) + '" oninput="reagentData[' + i + '].role=this.value;syncReagents()"/>\u003c/label>') +
        '\u003cdiv class="pfas-form-field is-wide">\u003clabel for="eg-lot-' + i + '">Lot\u003c/label>' +
        '\u003cdiv class="pfas-inline is-wrap">' +
        '\u003cselect id="eg-lot-' + i + '" class="reagent-lot-sel" onchange="pickLot(' + i + ',this.value)">' + lotOptions(r) + '\u003c/select>' +
        '\u003cbutton type="button" class="btn-sm btn-secondary" title="Scan the label" onclick="scanReagentLot(' + i + ')">Scan\u003c/button>' +
        '\u003cbutton type="button" class="btn-sm btn-secondary" title="A lot that is not in the inventory yet" onclick="openReceive(' + i + ')">New lot\u003c/button>' +
        '\u003c/div>' + lotLine(r) + '\u003c/div>' +
        /* the unit is part of the caption, so it is read in full and stays
           in view while the amount is typed */
        '\u003clabel class="pfas-form-field">\u003cspan>Quantity used' +
               ((LOT_BY_KEY[r.key] || {}).unit ? ' \u003cspan class="pfas-unit">(' + esc(LOT_BY_KEY[r.key].unit) + ')\u003c/span>' : '') + '\u003c/span>' +
        '\u003cinput class="reagent-qty-field" type="text" title="Amount used, e.g. 5 mL"' +
               ' value="' + esc(r.qty_used) + '"' +
               ' oninput="reagentData[' + i + '].qty_used=this.value;syncReagents()"/>\u003c/label>' +
        (r.kind === 'reagent' ?
          '\u003clabel class="pfas-form-field">\u003cspan>Lot status\u003c/span>' +
          '\u003cselect class="reagent-status-sel' + (r.new_status ? ' flagged' : '') + '"' +
                  ' onchange="flagReagent(' + i + ',this.value)">' +
            '\u003coption value="">Lot OK\u003c/option>' +
            '\u003coption value="exhausted"' + (r.new_status === 'exhausted' ? ' selected' : '') + '>Lot used up\u003c/option>' +
            '\u003coption value="quarantine"' + (r.new_status === 'quarantine' ? ' selected' : '') + '>Quarantine this lot\u003c/option>' +
          '\u003c/select>\u003c/label>' : '') +
        (r.receiving ? receiveForm(i, r.receiving) : '') + '\u003c/div>' +
        '\u003cbutton type="button" class="pfas-row-remove" title="Remove this row" onclick="reagentData.splice(' + i + ',1);renderReagents()">&#215;\u003c/button>';
      el.appendChild(div);
    });
    syncReagents();
  }

  function flagReagent(i, val) {
    reagentData[i].new_status = val;
    renderReagents();
  }

  /* A GS1 label (GTIN, lot, expiry) is read by the vendored parser; any
     other code is matched as it is. */
  function pad2(n) { return (n < 10 ? '0' : '') + n; }
  function readLabel(code) {
    var out = {raw: (code || '').trim(), lot: '', expiry: '', gtin: ''};
    try {
      (parseBarcode(out.raw).parsedCodeItems || []).forEach(function(it) {
        if (it.ai === '10') out.lot = String(it.data);
        if (it.ai === '01') out.gtin = String(it.data);
        if ((it.ai === '17' || it.ai === '15') && it.data instanceof Date && !out.expiry)
          out.expiry = it.data.getFullYear() + '-' + pad2(it.data.getMonth() + 1) + '-' + pad2(it.data.getDate());
      });
    } catch (e) { /* not GS1: matched as typed */ }
    return out;
  }

  /* The lot a label names: its GS1 lot number, else the stored barcode,
     else a lot number the code contains. */
  function findLot(label) {
    var c = label.raw.toLowerCase(), lot = label.lot.toLowerCase(), hit = null;
    LOTS.forEach(function(l) { if (!hit && lot && (l.lot || '').toLowerCase() === lot) hit = l; });
    LOTS.forEach(function(l) { if (!hit && c && (l.barcode || '').toLowerCase() === c) hit = l; });
    LOTS.forEach(function(l) {
      var v = (l.lot || '').toLowerCase();
      if (!hit && !lot && v && c.indexOf(v) !== -1) hit = l;
    });
    return hit;
  }

  function scanReagentLot(i) {
    openScanModal(function(result) {
      var label = readLabel(result), l = findLot(label);
      if (l) { pickLot(i, l.key); return; }
      openReceive(i, label);
    });
  }

  /* DB2: a lot not in the inventory is received here, in the stage. */
  function openReceive(i, label) {
    var r = reagentData[i];
    label = label || {raw: '', lot: '', expiry: '', gtin: ''};
    r.receiving = {name: r.role || '', lot: label.lot || (label.raw && !label.gtin ? label.raw : ''),
                   expiry: label.expiry, barcode: label.raw,
                   category: r.group === 'consumable' ? 'Consumable' : '', supplier: '', cat_number: '',
                   error: ''};
    renderReagents();
  }

  function receiveForm(i, rc) {
    var f = function(k, ph, type) {
      return '\u003cinput type="' + (type || 'text') + '" placeholder="' + ph + '" value="' + esc(rc[k] || '') + '"' +
             ' oninput="reagentData[' + i + '].receiving.' + k + '=this.value"/>';
    };
    return '\u003cdiv class="receive-box is-full">\u003cstrong>Receive a new lot into the inventory\u003c/strong>' +
      '\u003cdiv class="receive-grid">' + f('name', 'Item name') + f('lot', 'Lot number') +
      f('expiry', 'Expiry', 'date') + f('conditions', 'Storage conditions') +
      // a core Supplier (core_lists.py)
      '\u003cselect onchange="reagentData[' + i + '].receiving.supplier=this.value">\u003coption value="">Supplier\u003c/option>' +
      SUPPLIERS.map(function(s) { return '\u003coption' + (s === rc.supplier ? ' selected' : '') + '>' + esc(s) + '\u003c/option>'; }).join('') +
      '\u003c/select>' + f('cat_number', 'Catalogue #') +
      '\u003cselect onchange="reagentData[' + i + '].receiving.category=this.value">\u003coption value="">Category\u003c/option>' +
      CATEGORIES.map(function(c) { return '\u003coption value="' + esc(c[0]) + '"' + (c[0] === rc.category ? ' selected' : '') + '>' + esc(c[1]) + '\u003c/option>'; }).join('') +
      '\u003c/select>\u003c/div>' +
      (rc.error ? '\u003cdiv class="reagent-miss">' + esc(rc.error) + '\u003c/div>' : '') +
      '\u003cbutton type="button" class="btn-sm btn-primary" onclick="submitReceive(' + i + ')">Receive and use this lot\u003c/button> ' +
      '\u003cbutton type="button" class="btn-sm btn-secondary" onclick="reagentData[' + i + '].receiving=null;renderReagents()">Cancel\u003c/button>' +
      '\u003c/div>';
  }

  function submitReceive(i) {
    var rc = reagentData[i].receiving, body = new URLSearchParams();
    body.append('action', 'receive_lot'); body.append('batch_uid', BATCH_UID);
    body.append('name', rc.name || ''); body.append('lot_number', rc.lot || '');
    body.append('expiry', rc.expiry || ''); body.append('supplier', rc.supplier || '');
    body.append('cat_number', rc.cat_number || ''); body.append('category', rc.category || '');
    body.append('barcode', rc.barcode || '');
    body.append('storage_conditions', rc.conditions || '');
    var tok = document.querySelector('input[name=_authenticator]');
    if (tok) body.append('_authenticator', tok.value);
    fetch(SELF_URL, {method: 'POST', body: body, credentials: 'same-origin'})
      .then(function(resp) { return resp.json(); })
      .then(function(res) {
        if (!res.ok) { rc.error = res.error || 'Not received.'; renderReagents(); return; }
        LOTS.push(res.lot); LOT_BY_KEY[res.lot.key] = res.lot;
        reagentData[i].receiving = null;
        pickLot(i, res.lot.key);
      })
      .catch(function() { rc.error = 'Not received: the server did not answer.'; renderReagents(); });
  }

  function syncReagents() {
    var el = document.getElementById('reagents_json_field');
    if (el) el.value = JSON.stringify(reagentData.map(function(r) {
      return {group: r.group, role: r.role, kind: r.kind, inventory_uid: r.inventory_uid, name: r.name,
              lot: r.lot, expiry: r.expiry, qty_used: r.qty_used, status: r.status,
              new_status: r.new_status};
    }));
  }

  /* ═══════════════════════════════════════════════════════════════════
     EQUIPMENT S/N GRID
     ═══════════════════════════════════════════════════════════════════ */
  var equipmentSNs = (DRAFT && DRAFT.equipment_sns) || {};

  /* A balance or pipette is chosen from the units registered in Facility QC,
     with today's verification / calibration shown; anything else (or a unit
     not registered yet) keeps a serial number field. */
  function renderEquipment() {
    var el = document.getElementById('eq-grid');
    if (!el) return;
    el.innerHTML = '';
    (EQUIPMENT || []).forEach(function(eq, i) {
      var label = eq.label, cur = equipmentSNs[label] || '';
      equipmentSNs[label] = cur;
      var known = eq.units.some(function(u) { return u.serial === cur; });
      var div = document.createElement('div');
      div.className = 'eq-field';
      /* the equipment's name labels the control under it: the list of
         units when there is one, else the serial number box */
      var html = '\u003clabel for="eq-' + (eq.units.length ? 'unit' : 'sn') + '-' + i + '">' + esc(label) + '\u003c/label>';
      if (eq.units.length) {
        html += '\u003cselect id="eq-unit-' + i + '" onchange="pickUnit(' + i + ',this.value)">' +
          '\u003coption value="">\u2014 choose the ' + esc(eq.family) + ' \u2014\u003c/option>' +
          eq.units.map(function(u) {
            return '\u003coption value="' + esc(u.serial) + '"' + (u.serial === cur ? ' selected' : '') + '>' +
                   esc(u.name + ' \u00b7 S/N ' + u.serial + ' \u00b7 ' + u.note +
                       (!u.ok && eq.family === 'balance' ? ' \u00b7 cannot be used' : '')) + '\u003c/option>';
          }).join('') +
          '\u003coption value="__other__"' + (cur && !known ? ' selected' : '') + '>Not listed (type the serial)\u003c/option>' +
          '\u003c/select>';
        if (cur && known) {
          var u = eq.units.filter(function(x) { return x.serial === cur; })[0];
          if (!u.ok) html += '\u003cspan class="exp-expired">' + esc(u.note) + '\u003c/span>';
        }
      } else if (eq.family) {
        html += '\u003cspan class="eq-hint">No ' + esc(eq.family) + ' registered under Equipment\u003c/span>';
      }
      if (!eq.units.length || (cur && !known) || eq.other) {
        html += '\u003cinput type="text" id="eq-sn-' + i + '" placeholder="Serial number"' +
                ' aria-label="' + esc(label) + ', serial number" value="' + esc(known ? '' : cur) + '"' +
                ' oninput="equipmentSNs[EQUIPMENT[' + i + '].label]=this.value;syncEquipment()"/>';
      }
      div.innerHTML = html;
      el.appendChild(div);
    });
    syncEquipment();
  }

  function pickUnit(i, serial) {
    var eq = EQUIPMENT[i];
    eq.other = (serial === '__other__');
    equipmentSNs[eq.label] = eq.other ? '' : serial;
    renderEquipment();
    if (SAMPLE_CARD.column === 'spe_port') renderSamples();
  }

  /* Additional equipment: any label the stage does not plan, kept in the
     same label -> serial map the stage stores */
  var extraEquipment = Object.keys(equipmentSNs).filter(function(label) {
    return !(EQUIPMENT || []).some(function(eq) { return eq.label === label; });
  }).map(function(label) { return {name: label, serial: equipmentSNs[label] || ''}; });

  function addExtraEquipment() {
    extraEquipment.push({name: '', serial: ''});
    renderExtraEquipment();
  }

  function removeExtraEquipment(i) {
    extraEquipment.splice(i, 1);
    renderExtraEquipment();
  }

  function renderExtraEquipment() {
    var el = document.getElementById('eq-extra');
    if (!el) return;
    el.innerHTML = '';
    extraEquipment.forEach(function(x, i) {
      var div = document.createElement('div');
      div.className = 'eq-field';
      div.innerHTML =
        '\u003clabel for="eq-extra-name-' + i + '">Equipment\u003c/label>' +
        '\u003cinput type="text" id="eq-extra-name-' + i + '" placeholder="Name" value="' + esc(x.name) + '"' +
        ' oninput="extraEquipment[' + i + '].name=this.value;syncEquipment()"/>' +
        '\u003cinput type="text" list="eq-register" placeholder="Serial number" aria-label="Serial number"' +
        ' value="' + esc(x.serial) + '" oninput="extraEquipment[' + i + '].serial=this.value;syncEquipment()"/>' +
        '\u003cbutton type="button" class="btn-sm btn-secondary" onclick="removeExtraEquipment(' + i + ')">Remove\u003c/button>';
      el.appendChild(div);
    });
    syncEquipment();
  }

  function syncEquipment() {
    var planned = {};
    (EQUIPMENT || []).forEach(function(eq) { planned[eq.label] = equipmentSNs[eq.label] || ''; });
    extraEquipment.forEach(function(x) {
      var name = (x.name || '').trim();
      if (name && !(name in planned)) planned[name] = (x.serial || '').trim();
    });
    equipmentSNs = planned;
    var el = document.getElementById('equipment_sns_json_field');
    if (el) el.value = JSON.stringify(equipmentSNs);
  }

  /* ═══════════════════════════════════════════════════════════════════
     SOLUTIONS PREPARED
     ═══════════════════════════════════════════════════════════════════ */
  var solutionsData = [];

  function addSolutionRow() {
    solutionsData.push({name:'', lot:'', conc:'', volume_ml:'', expiry:'', analyst:''});
    renderSolutions();
  }

  function renderSolutions() {
    var el = document.getElementById('sol-rows');
    if (!el) return;
    el.innerHTML = '';
    solutionsData.forEach(function(s, i) {
      var div = document.createElement('div');
      div.className = 'sol-card';
      div.innerHTML =
        '\u003cbutton type="button" class="pfas-row-remove" onclick="solutionsData.splice('+i+',1);renderSolutions()">&#215;\u003c/button>'+
        '\u003ch4>Solution ' + (i+1) + '\u003c/h4>'+
        '\u003cdiv class="sol-fields">'+
          '\u003cdiv class="sol-field">\u003clabel>Name\u003c/label>'+
            '\u003cinput type="text" value="'+esc(s.name)+'"'+
                   ' oninput="solutionsData['+i+'].name=this.value;autoSolLot('+i+')"/>\u003c/div>'+
          '\u003cdiv class="sol-field">\u003clabel>Lot #\u003c/label>'+
            '\u003cinput type="text" value="'+esc(s.lot)+'" id="sol-lot-'+i+'"'+
                   ' oninput="solutionsData['+i+'].lot=this.value;syncSolutions()"/>\u003c/div>'+
          '\u003cdiv class="sol-field">\u003clabel>Concentration\u003c/label>'+
            '\u003cinput type="text" value="'+esc(s.conc)+'" placeholder="e.g. 100 ng/mL"'+
                   ' oninput="solutionsData['+i+'].conc=this.value;syncSolutions()"/>\u003c/div>'+
          '\u003cdiv class="sol-field">\u003clabel>Volume (mL)\u003c/label>'+
            '\u003cinput type="number" step="0.1" value="'+esc(s.volume_ml)+'"'+
                   ' oninput="solutionsData['+i+'].volume_ml=this.value;syncSolutions()"/>\u003c/div>'+
          '\u003cdiv class="sol-field">\u003clabel>Expiry\u003c/label>'+
            '\u003cinput type="date" value="'+esc(s.expiry)+'" id="sol-exp-'+i+'"'+
                   ' oninput="solutionsData['+i+'].expiry=this.value;syncSolutions()"/>\u003c/div>'+
          '\u003cdiv class="sol-field">\u003clabel>Storage\u003c/label>'+
            '\u003cinput type="text" value="'+esc(s.storage||'')+'" placeholder="-20°C"'+
                   ' oninput="solutionsData['+i+'].storage=this.value;syncSolutions()"/>\u003c/div>'+
        '\u003c/div>'+
        '\u003cdiv class="sol-actions">'+
          '\u003cbutton type="button" class="btn-sm btn-secondary" onclick="printLabel('+i+')">Print Label\u003c/button>'+
          '\u003cbutton type="button" class="btn-sm btn-secondary" onclick="saveSolutionToInventory('+i+')">+ Add to Inventory\u003c/button>'+
        '\u003c/div>';
      el.appendChild(div);
    });
    syncSolutions();
  }

  var MOBILE_PHASE_RE = /methanol|meoh|acetonitrile|acn|water|h2o|mobile.?phase|mph|formic/i;
  function autoSolLot(i) {
    var s = solutionsData[i];
    var t = PFAS.components.labToday(), lot, exp;
    if (t) {
      /* the laboratory's day names the lot and starts its shelf life */
      lot = (s.name||'SOL').toUpperCase().replace(/\W+/g,'_') + '-' + t.slice(2,4) + t.slice(5,7) + t.slice(8,10);
      exp = new Date(t + 'T00:00:00Z');
      if (MOBILE_PHASE_RE.test(s.name||'')) {
        exp.setUTCDate(exp.getUTCDate()+7);
      } else {
        exp.setUTCFullYear(exp.getUTCFullYear()+1);
      }
    } else {
      var d = new Date();
      var yy = String(d.getFullYear()).slice(-2);
      var mm = String(d.getMonth()+1).padStart(2,'0');
      var dd = String(d.getDate()).padStart(2,'0');
      lot = (s.name||'SOL').toUpperCase().replace(/\W+/g,'_') + '-' + yy+mm+dd;
      exp = new Date();
      if (MOBILE_PHASE_RE.test(s.name||'')) {
        exp.setDate(exp.getDate()+7);
      } else {
        exp.setFullYear(exp.getFullYear()+1);
      }
    }
    solutionsData[i].lot = lot;
    document.getElementById('sol-lot-'+i).value = lot;
    solutionsData[i].expiry = exp.toISOString().slice(0,10);
    var expEl = document.getElementById('sol-exp-'+i);
    if (expEl) expEl.value = solutionsData[i].expiry;
    syncSolutions();
  }

  function syncSolutions() {
    var el = document.getElementById('solutions_json_field');
    if (el) el.value = JSON.stringify(solutionsData);
  }

  function printLabel(i) {
    var s = solutionsData[i];
    var params = '?name='+encodeURIComponent(s.name||'')
               + '&lot='+encodeURIComponent(s.lot||'')
               + '&conc='+encodeURIComponent(s.conc||'')
               + '&vol='+encodeURIComponent(s.volume_ml||'')
               + '&exp='+encodeURIComponent(s.expiry||'')
               + '&date='+encodeURIComponent(todayISO())
               + '&back='+encodeURIComponent(window.location.href);
    window.open(LABEL_URL + params, '_blank', 'width=600,height=500');
  }

  function saveSolutionToInventory(i) {
    var s = solutionsData[i];
    /* PARENTAGE. A solution prepared at the bench is a PreparedStandard whose
       parents are this stage's reagent lots -- the
       three-level ISO 17025 6.6 chain. Before this the solution was filed as a
       manufacturer Reagent with no parentage at all.

       inventory_uid is carried through deliberately: it is a real Reagent UID,
       so the link survives a lot-number correction or a rename, which a
       lot-string link does not. Supplier is NOT copied -- the resolved Reagent
       owns it, and duplicating it is what made the old records drift. */
    var parents = [];
    reagentData.forEach(function(r) {
      if (!r.lot && !r.inventory_uid) return;
      parents.push({uid: r.inventory_uid || '', name: r.name || r.role || '',
                    lot: r.lot || '', qty: r.qty_used || '', unit: ''});
    });
    /* a lot out of date today is used only with a reason: the stage's
       deviation note, kept on that parent and checked again when saved */
    var late = reagentData.filter(function(r) { return (r.lot || r.inventory_uid) && isExpired(r.expiry); });
    var reason = ((document.getElementById('deviations-field') || {}).value || '').trim();
    if (late.length && !reason) {
      alert('Out of date: ' + late.map(function(r) { return (r.name || r.role || '') + ' lot ' + (r.lot || ''); }).join('; ') +
            '.\n\nWrite the reason it is used in the deviation note, then save the solution again.');
      return;
    }
    if (!parents.length) {
      alert('Record the reagent lots this solution was made from first.\n\n' +
            'A prepared standard with no parentage cannot be traced back to the ' +
            'manufacturer, and the data-review traceability gate will reject it.');
      return;
    }
    var form = document.createElement('form');
    form.method = 'post';
    form.action = SELF_URL;
    var fields = {action:'prepare_solution', batch_uid:BATCH_UID,
                  sol_name:s.name, sol_lot:s.lot, sol_conc:s.conc,
                  sol_volume:s.volume_ml, sol_storage:s.storage||'',
                  sol_expiry:s.expiry||'', sol_analyst:s.analyst||'',
                  parent_reagents_json:JSON.stringify(parents),
                  sol_expired_reason:late.length ? reason : '',
                  /* The stage's equipment serials, so the solution records what it
                     was MADE WITH without asking the analyst a second time — the
                     information is already on this page. The handler resolves each
                     serial against the Facility QC registry. */
                  equipment_posted:'1',
                  equipment_sns_json:JSON.stringify(equipmentSNs || {})};
    Object.keys(fields).forEach(function(k) {
      var inp = document.createElement('input');
      inp.type = 'hidden'; inp.name = k; inp.value = fields[k]||'';
      form.appendChild(inp);
    });
    document.body.appendChild(form);
    form.submit();
  }

  /* ═══════════════════════════════════════════════════════════════════
     PEDIGREE
     ═══════════════════════════════════════════════════════════════════ */
  var pedData = PEDIGREE || {};  /* {standard_name: [{level, lot, conc, ...}, ...]} */

  var PED_LEVELS = ['CRM / Reference Material', 'Primary Stock', 'Secondary Stock', 'Working Standard'];

  function addPedigreeStandard() {
    var name = prompt('Standard / IS name:');
    if (!name) return;
    pedData[name] = pedData[name] || [];
    if (!pedData[name].length) {
      pedData[name].push({level:'CRM / Reference Material', supplier:'', lot:'', cert_conc:'', cert_date:'', coa:''});
      pedData[name].push({level:'Primary Stock', lot:'', conc:'', volume_ml:'', prepared_by:'', prepared_date:''});
      pedData[name].push({level:'Working Standard', lot:'', conc:'', volume_ml:'', prepared_by:'', prepared_date:''});
    }
    renderPedigree();
  }

  function renderPedigree() {
    var el = document.getElementById('ped-rows');
    if (!el) return;
    el.innerHTML = '';
    Object.keys(pedData).forEach(function(stdName) {
      var levels = pedData[stdName];
      var div = document.createElement('div');
      div.className = 'ped-standard';
      var html = '\u003ch4>' + esc(stdName) +
                 ' \u003cbutton type="button" onclick="deletePedStd(\''+stdName.replace(/'/g,"\\'")+'\')" '+
                 'class="pfas-row-remove">&#215; Remove\u003c/button>\u003c/h4>';
      levels.forEach(function(lvl, li) {
        var isCRM = lvl.level.indexOf('CRM') !== -1 || lvl.level.indexOf('Reference') !== -1;
        html += '\u003cdiv class="ped-level">'+
                '\u003cspan class="ped-level-badge">'+esc(lvl.level)+'\u003c/span>';
        if (isCRM) {
          html += pedField('Supplier', stdName, li, 'supplier', lvl.supplier, 150) +
                  pedField('Lot #', stdName, li, 'lot', lvl.lot, 120) +
                  pedField('Cert. Conc (ng/mL)', stdName, li, 'cert_conc', lvl.cert_conc, 120) +
                  pedField('Cert. Date', stdName, li, 'cert_date', lvl.cert_date, 120, 'date') +
                  pedField('CoA #', stdName, li, 'coa', lvl.coa, 100);
        } else {
          html += pedField('Lot #', stdName, li, 'lot', lvl.lot, 130) +
                  pedField('Conc (ng/mL)', stdName, li, 'conc', lvl.conc, 110) +
                  pedField('Volume (mL)', stdName, li, 'volume_ml', lvl.volume_ml, 90) +
                  pedField('Prep By', stdName, li, 'prepared_by', lvl.prepared_by, 120) +
                  pedField('Prep Date', stdName, li, 'prepared_date', lvl.prepared_date, 120, 'date');
        }
        html += '\u003cbutton type="button" class="pfas-row-remove" '+
                'onclick="deletePedLevel(\''+stdName.replace(/'/g,"\\'")+'\',' + li + ')">&#215;\u003c/button>';
        html += '\u003c/div>';
      });
      html += '\u003cbutton type="button" class="btn-sm btn-secondary" onclick="addPedLevel(\''+stdName.replace(/'/g,"\\'")+'\')">' +
              '+ Add Dilution Level\u003c/button>';
      div.innerHTML = html;
      el.appendChild(div);
    });
    syncPedigree();
  }

  function pedField(label, stdName, li, key, val, w, type) {
    type = type || 'text';
    return '\u003cdiv class="ped-field">' +
           '\u003clabel>'+esc(label)+'\u003c/label>' +
           '\u003cinput type="'+type+'" value="'+esc(val||'')+'" ' +
           'oninput="updatePed(\''+stdName.replace(/'/g,"\\'")+'\',' + li + ',\''+key+'\',this.value)"/>' +
           '\u003c/div>';
  }

  function updatePed(stdName, li, key, val) {
    if (pedData[stdName] && pedData[stdName][li]) {
      pedData[stdName][li][key] = val;
    }
    syncPedigree();
  }

  function addPedLevel(stdName) {
    if (!pedData[stdName]) return;
    pedData[stdName].push({level:'Secondary Stock', lot:'', conc:'', volume_ml:'', prepared_by:'', prepared_date:''});
    renderPedigree();
  }

  function deletePedLevel(stdName, li) {
    if (pedData[stdName]) { pedData[stdName].splice(li,1); renderPedigree(); }
  }

  function deletePedStd(stdName) {
    delete pedData[stdName];
    renderPedigree();
  }

  function syncPedigree() {
    var el = document.getElementById('pedigree_hidden');
    if (el) el.value = JSON.stringify(pedData);
  }

  /* ═══════════════════════════════════════════════════════════════════
     BARCODE SCANNER MINI-MODAL
     ═══════════════════════════════════════════════════════════════════ */
  var _scanCallback = null;
  var _scanReader   = null;

  function openScanModal(cb) {
    _scanCallback = cb;
    var overlay = document.getElementById('scan-mini-overlay');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'scan-mini-overlay';
      overlay.className = 'pfas-modal open';
      overlay.innerHTML =
        '\u003cdiv class="pfas-modal-box is-scan" role="dialog" aria-modal="true" aria-labelledby="scan-mini-h">'+
        '\u003ch2 id="scan-mini-h">Scan Barcode\u003c/h2>'+
        '\u003cvideo id="scan-mini-video" autoplay playsinline muted class="pfas-scan-video">\u003c/video>'+
        '\u003cdiv id="scan-mini-result" class="pfas-scan-result">\u003c/div>'+
        '\u003cdiv class="pfas-scan-actions">'+
          '\u003cbutton type="button" id="scan-mini-use" class="btn btn-primary" disabled onclick="useScanMini()">Use\u003c/button>'+
          '\u003cbutton type="button" class="btn btn-secondary" onclick="closeScanMini()">Cancel\u003c/button>'+
        '\u003c/div>'+
        '\u003c/div>';
      document.body.appendChild(overlay);
    } else {
      overlay.classList.add('open');
    }
    _scanMiniResult = null;
    document.getElementById('scan-mini-result').textContent = 'Point camera at barcode...';
    document.getElementById('scan-mini-use').disabled = true;
    if (typeof ZXingBrowser !== 'undefined') {
      /* @zxing/browser (R11): the returned controls stop the camera. */
      _scanReader = new ZXingBrowser.BrowserMultiFormatReader();
      _scanReader.decodeFromVideoDevice(undefined, 'scan-mini-video', function(res, err) {
        if (res) {
          _scanMiniResult = res.getText();
          document.getElementById('scan-mini-result').innerHTML = '\u003cstrong>' + esc(_scanMiniResult) + '\u003c/strong>';
          document.getElementById('scan-mini-use').disabled = false;
        }
      }).then(function(c) { _scanMiniControls = c; });
    } else {
      document.getElementById('scan-mini-result').textContent = 'ZXing not loaded. Enter lot manually.';
    }
  }

  var _scanMiniResult = null, _scanMiniControls = null;
  function useScanMini() {
    closeScanMini();
    if (_scanCallback && _scanMiniResult) _scanCallback(_scanMiniResult);
  }
  function closeScanMini() {
    if (_scanMiniControls) { try { _scanMiniControls.stop(); } catch(e){} _scanMiniControls = null; }
    _scanReader = null;
    var overlay = document.getElementById('scan-mini-overlay');
    if (overlay) overlay.classList.remove('open');
  }

  /* ═══════════════════════════════════════════════════════════════════
     FORM SUBMISSION
     ═══════════════════════════════════════════════════════════════════ */
  function prepStageSubmit() {
    syncReagents();
    syncEquipment();
    syncSolutions();
    /* Also save pedigree via separate POST if pedigree exists */
    if (Object.keys(pedData).length) {
      syncPedigree();
      /* pedigree_hidden is submitted as part of the stage form */
    }
    return true;
  }

  /* ═══════════════════════════════════════════════════════════════════
     INIT
     ═══════════════════════════════════════════════════════════════════ */
  /* Per-sample table (the extraction record's samples rows): this stage records one
     column; the server merges it by sample id. */
  var sampleRows = ((SAMPLE_CARD && SAMPLE_CARD.rows) || []).map(function(r) {
    return {sample_id: r.sample_id, matrix_type: r.matrix_type || '',
            value: (r[SAMPLE_CARD.column] || ''), unit: r.amount_unit || 'g'};
  });

  /* the SPE manifold's ports: the one picked on this stage, else the one
     an earlier stage recorded (SAMPLE_CARD.ports); none listed, the port
     is typed */
  function portChoices() {
    var found = null;
    (EQUIPMENT || []).forEach(function(eq) {
      if (found || eq.family !== 'SPE manifold') return;
      var u = eq.units.filter(function(x) { return x.serial === equipmentSNs[eq.label]; })[0];
      if (u && u.ports && u.ports.length) found = u.ports;
    });
    return found || SAMPLE_CARD.ports || [];
  }

  function portCell(r, i, ports) {
    var on = ports.some(function(p) { return p.toUpperCase() === String(r.value || '').toUpperCase(); });
    return '\u003cselect aria-label="SPE port" onchange="sampleRows[' + i + '].value=this.value;syncSamples()">' +
      '\u003coption value="">\u2014\u003c/option>' +
      ports.map(function(p) {
        return '\u003coption value="' + esc(p) + '"' + (p.toUpperCase() === String(r.value || '').toUpperCase() ? ' selected' : '') + '>' + esc(p) + '\u003c/option>';
      }).join('') +
      (r.value && !on ? '\u003coption value="' + esc(r.value) + '" selected>' + esc(r.value) + ' (not on the manifold)\u003c/option>' : '') +
      '\u003c/select>';
  }

  function renderSamples() {
    var tb = document.getElementById('sample-rows');
    if (!tb) return;
    var amount = SAMPLE_CARD.column === 'amount';
    var ports = SAMPLE_CARD.column === 'spe_port' ? portChoices() : [];
    tb.innerHTML = sampleRows.map(function(r, i) {
      return '\u003ctr>\u003ctd>' + (r.isNew ?
          '\u003cinput type="text" value="' + esc(r.sample_id) + '" oninput="sampleRows[' + i + '].sample_id=this.value;syncSamples()"/>' :
          esc(r.sample_id)) + '\u003c/td>\u003ctd>' + esc(r.matrix_type) + '\u003c/td>' +
        '\u003ctd>' + (ports.length ? portCell(r, i, ports) : '\u003cinput ' + (SAMPLE_CARD.column === 'spe_port' ? 'type="text" size="6"' : 'type="number" step="any" min="0"') + ' value="' + esc(r.value) + '"' +
        ' oninput="sampleRows[' + i + '].value=this.value;syncSamples()"/>') + '\u003c/td>' +
        (amount ? '\u003ctd>\u003cselect onchange="sampleRows[' + i + '].unit=this.value;syncSamples()">' +
          ['g', 'mL'].map(function(u) { return '\u003coption' + (u === r.unit ? ' selected' : '') + '>' + u + '\u003c/option>'; }).join('') +
          '\u003c/select>\u003c/td>' : '') + '\u003c/tr>';
    }).join('');
    syncSamples();
  }

  function addSampleRow() {
    sampleRows.push({sample_id: '', matrix_type: '', value: '', unit: 'g', isNew: true});
    renderSamples();
  }

  function syncSamples() {
    var el = document.getElementById('samples_json_field');
    if (el) el.value = JSON.stringify(sampleRows.filter(function(r) { return r.sample_id; })
      .map(function(r) { return {sample_id: r.sample_id, value: r.value, unit: r.unit, matrix_type: r.matrix_type}; }));
  }

  /* A balance without a passed verification today blocks the stage; no
     note unlocks it. The server judges again -- a
     correction on the day the stage was first done -- and keeps a draft. */
  function stageBlocks() {
    var out = [];
    (EQUIPMENT || []).forEach(function(eq) {
      if (eq.family !== 'balance') return;
      var cur = (equipmentSNs[eq.label] || '').trim();
      var u = eq.units.filter(function(x) { return x.serial === cur; })[0];
      if (!cur) out.push(eq.label + ': no balance chosen');
      else if (!u) out.push(eq.label + ': no registered balance has serial ' + cur + ' (register it under Equipment)');
      else if (!u.ok) out.push(eq.label + ' (' + u.name + '): ' + u.note);
    });
    /* a lot not in the inventory traces to nothing (bench_queue.stage_lot_blocks) */
    reagentData.forEach(function(r) {
      if (r.lot && !r.inventory_uid)
        out.push((r.role || r.name || 'Item') + ': lot ' + r.lot + ' is not in the inventory. Pick it from the inventory, or receive it first.');
    });
    return out;
  }

  /* DB4 in the browser: what the chemist can see is missing is asked for
     before the form goes; the server checks again, keeping the entries as a
     draft if it refuses. */
  function stageWarnings() {
    var out = [];
    reagentData.forEach(function(r) {
      var what = r.role || r.name || 'Item';
      if (!r.lot) out.push(what + ': no lot recorded');
      else if (expClass(r.expiry) === 'exp-expired') out.push(what + ': lot ' + r.lot + ' is expired');
    });
    document.querySelectorAll('#homogenisation-card .cf-hint').forEach(function(h) {
      out.push(h.textContent.trim());
    });
    document.querySelectorAll('#checks-card input[type=checkbox]').forEach(function(c) {
      if (!c.checked) out.push('Not confirmed: ' + c.value);
    });
    if (SAMPLE_CARD && SAMPLE_CARD.column) sampleRows.forEach(function(r) {
      if (r.sample_id && !String(r.value).trim())
        out.push(r.sample_id + ': no ' + (SAMPLE_CARD.column === 'amount' ? 'sample amount' : 'final extract volume') + ' recorded');
    });
    return out;
  }

  document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('stage-form');
    if (form) form.addEventListener('submit', function(ev) {
      var dev = document.getElementById('deviations-field');
      var blocks = stageBlocks();
      if (blocks.length) {
        ev.preventDefault();
        document.getElementById('cannot-complete-list').innerHTML =
          blocks.map(function(w) { return '\u003cli>' + esc(w) + '\u003c/li>'; }).join('');
        document.getElementById('cannot-complete').hidden = false;
        document.getElementById('deviation-card').scrollIntoView({behavior: 'smooth', block: 'center'});
        return;
      }
      var warns = stageWarnings();
      if (!warns.length || (dev && dev.value.trim())) return;
      ev.preventDefault();
      var box = document.getElementById('needs-note'), list = document.getElementById('needs-note-list');
      list.innerHTML = warns.map(function(w) { return '\u003cli>' + esc(w) + '\u003c/li>'; }).join('');
      box.hidden = false;
      document.getElementById('deviation-card').scrollIntoView({behavior: 'smooth', block: 'center'});
      if (dev) dev.focus();
    });
    renderReagents();
    renderEquipment();
    renderExtraEquipment();
    renderSamples();
    renderSolutions();
    renderPedigree();
    /* Replay the stage action GIF — animated GIFs do not restart on their
       own once they have played through. */
    var rb = document.getElementById('eg-replay-btn');
    var im = document.getElementById('eg-stage-img');
    if (rb && im) {
      rb.addEventListener('click', function() {
        var src = im.getAttribute('src').split('#')[0];
        im.setAttribute('src', src + '#r=' + Date.now());
      });
    }
  });
  </script>

  <!-- ZXing for inline barcode scanning -->
  <!-- @zxing/library is Apache-2.0: CDN only, never vendored (R11) -->
  <script src="https://unpkg.com/@zxing/library@0.23.0/umd/index.min.js"></script>
  <script src="https://unpkg.com/@zxing/browser@0.2.1/umd/zxing-browser.min.js"></script>
  <!-- GS1 label parsing (GTIN, lot, expiry): MIT, vendored (LICENSE beside it) -->
  <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/vendor/gs1-barcode-parser-mod-1.2.1.js"></script>
  </div><!-- /content slot -->
</body>
</html>
