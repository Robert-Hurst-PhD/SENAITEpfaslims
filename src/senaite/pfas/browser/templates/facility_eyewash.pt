<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Eye Wash Station Log</title>
</head>
<body>
<tal:t metal:fill-slot="header-title">Eye Wash Station Log</tal:t>
<metal:content metal:fill-slot="content">
  <tal:def tal:define="purl view/portal_url">

  <div class="pfas-card">
    <h3>New Entry</h3>
    <form method="POST" tal:attributes="action string:${purl}/@@pfas-eyewash-log">
      <input type="hidden" name="unit_id"
             tal:attributes="value python:request.get('unit_id','')"/>
      <div class="pfas-form-row">
        <div class="pfas-form-field"><label>Station</label>
          <select name="unit_id">
            <option value="">— select station —</option>
            <tal:each tal:repeat="u view/eyewash_units">
              <option tal:attributes="value u/id; selected python:'selected' if request.get('unit_id','')==u['id'] else None"
                      tal:content="u/name"></option>
            </tal:each>
          </select>
        </div>
        <div class="pfas-form-field"><label>Date *</label>
          <input type="date" name="log_date" id="ewDate" required/></div>
        <div class="pfas-form-field"><label>Time</label>
          <input type="time" name="log_time" id="ewTime"/></div>
        <div class="pfas-form-field"><label>Operator initials *</label>
          <input type="text" name="operator" maxlength="10" required/></div>
      </div>
      <div class="pfas-form-row">
        <div class="pfas-form-field">
          <label>Working Order? *</label>
          <select name="working" required>
            <option value="yes">Yes — operational</option>
            <option value="no">No — fault noted</option>
          </select>
        </div>
        <div class="pfas-form-field">
          <label>Flush water temp (&deg;C)
            <small>15–25°C required</small>
          </label>
          <input type="number" step="0.1" name="temperature"
                 placeholder="optional"/>
        </div>
      </div>
      <div class="pfas-form-row">
        <div class="pfas-form-field is-grow"><label>Notes / corrective action</label>
          <input type="text" name="notes"/></div>
      </div>
      <button type="submit" class="btn btn-primary">
        Log Entry
      </button>
    </form>
  </div>

  <div class="pfas-card">
    <h3>Recent Log</h3>
    <tal:none tal:condition="python:not view.logs()">
      <p class="pfas-note-sm">No entries yet.</p>
    </tal:none>
    <table class="pfas-table log-table" tal:condition="python:bool(view.logs())">
      <tr>
        <th>Date</th><th>Time</th><th>Station</th><th>Operator</th>
        <th>Working</th><th>Temp (&deg;C)</th><th>Result</th><th>Notes</th>
      </tr>
      <tal:each tal:repeat="r view/logs">
        <tr>
          <td tal:content="r/log_date"></td>
          <td tal:content="r/log_time"></td>
          <td tal:content="python:r.get('unit_name','—')"></td>
          <td tal:content="r/operator"></td>
          <td tal:content="python:'Yes' if r.get('working') else 'No'"></td>
          <td tal:attributes="class python:'pfas-text-bad' if r.get('temperature') is not None and not (15<=r['temperature']<=25) else None"
              tal:content="python:'{:.1f}'.format(r['temperature']) if r.get('temperature') is not None else '—'"></td>
          <td><span tal:attributes="class python:'badge badge-ok' if r['passed'] else 'badge badge-fail'"
                    tal:content="python:'Pass' if r['passed'] else 'Fail'"></span></td>
          <td class="pfas-muted-cell" tal:content="python:r.get('notes','')"></td>
        </tr>
      </tal:each>
    </table>
  </div>

  </tal:def>
</metal:content>
<tal:scripts metal:fill-slot="scripts">
<script>
//<![CDATA[
(function(){
  var d = new Date();
  var dd = document.getElementById('ewDate');
  var dt = document.getElementById('ewTime');
  if (dd) dd.valueAsDate = d;
  if (dt) dt.value = ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);
})();
//]]>
</script>
</tal:scripts>
</body>
</html>
