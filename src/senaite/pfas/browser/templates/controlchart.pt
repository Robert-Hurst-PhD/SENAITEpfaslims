<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">QC Control Charts</title>
  <tal:extras metal:fill-slot="head-extra">
  <script tal:attributes="src string:${context/portal_url}/++resource++senaite.pfas/vendor/chart.js-4.4.3.umd.min.js"></script>
  <script tal:attributes="src string:${context/portal_url}/++resource++senaite.pfas/vendor/chartjs-plugin-annotation-3.1.0.min.js"></script>
  <script tal:attributes="src string:${context/portal_url}/++resource++senaite.pfas/controlchart_overlay.js?v=${context/@@pfas-macros/asset_version}"></script>
  <style>
    /* ── Control chart layout: filters as a top bar ────────────────────── */
    .main { padding: 18px; min-width: 0; }

    /* the filter bar is the shared component (pfas-components.css) */
    .limit-input { width: 80px; min-width: 0; }
    .pfas-filterbar .pfas-select, .pfas-filterbar .pfas-input { min-width: 140px; }

    .cc-note { margin-top: 16px; padding: 12px 14px; background: var(--s-light);
               border: 1px solid var(--s-border); border-radius: 6px;
               font-size: var(--fs-xs); color: var(--s-secondary); line-height: 1.6; text-align: center; }
    .fail-count { color: var(--s-danger-dk); font-weight: 600; }

    .stats-bar { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .stat-box { background: var(--s-bg); border: 1px solid var(--s-border);
                border-radius: 4px; padding: 8px 14px; min-width: 90px; text-align: center; }
    .stat-label { font-size: var(--fs-xs); color: var(--s-secondary); text-transform: uppercase;
                  letter-spacing: .04em; }
    .stat-value { font-size: var(--fs-xl); font-weight: 700; color: var(--text); }
    /* a tile is tinted only for a flag: amber for warnings, coral for a reject */
    .stat-value.is-none { color: var(--text-muted); font-size: var(--fs-base); font-weight: var(--fw-body); }
    .stat-box.warn { border-color: var(--s-warn-bd); background: var(--s-warn-lt); }
    .stat-box.rej  { border-color: var(--s-danger-bd); background: var(--s-danger-lt); }

    .chart-card { background: var(--s-bg); border-radius: 6px;
                  border: 1px solid var(--s-border);
                  box-shadow: 0 1px 3px rgba(0,0,0,.06);
                  padding: 18px; margin-bottom: 18px; }
    .chart-title { font-size: var(--fs-md); font-weight: 600; color: var(--s-body);
                   margin-bottom: 2px; }
    .chart-subtitle { font-size: var(--fs-sm); color: var(--s-secondary); margin-bottom: 14px; }
    /* the heading says what the chart shows; what it plots is the line under it;
       the Download at the card's top right */
    .chart-head { display: flex; align-items: flex-start; gap: var(--sp-3); }
    .chart-head-text { flex: 1 1 auto; min-width: 0; }
    .chart-for { font-size: var(--fs-sm); color: var(--s-body); }
    .cc-few { margin: var(--sp-2) 0 0; }
    .chart-container { position: relative; height: 290px; }
    .no-data { text-align: center; padding: 50px 20px; color: var(--s-secondary); }
    .no-data strong { display: block; font-size: var(--fs-base); margin-bottom: 6px;
                      color: var(--s-secondary); }

    .viol-card { border-radius: 6px; padding: 14px; margin-bottom: 16px; }
    .viol-card h3 { font-size: var(--fs-base); margin-bottom: 8px; }
    /* the Westgard notes: information, never an error */
    .wg-notes { background: var(--s-info-lt); border: 1px solid var(--s-info-bd);
                border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; }
    .wg-head { display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap; }
    .wg-head h3 { margin: 0; font-size: var(--fs-base); color: var(--s-body); }
    .wg-row { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: var(--sp-3); align-items: center;
              padding: 6px 0; border-top: 1px solid var(--s-border); font-size: var(--fs-sm); }
    .wg-rule { font-weight: 700; color: var(--s-info-text); }
    .wg-foot { display: flex; align-items: center; gap: var(--sp-3); border-top: 1px solid var(--s-border);
               padding-top: 8px; margin-top: 4px; color: var(--s-secondary); font-size: var(--fs-sm); }
    .cc-legend { display: flex; flex-wrap: wrap; gap: var(--sp-4); align-items: center; margin-top: var(--sp-2);
                 font-size: var(--fs-sm); color: var(--s-body); }
    .cc-legend > span { display: inline-flex; align-items: center; gap: var(--sp-1); }
    .cc-linetip { position: absolute; right: 0; width: 72px; height: 16px; transform: translateY(-50%); display: block; }
    .cc-print-line { display: none; }
    @media print {
      /* the chart card alone: its filter line, the Westgard notes, the chart and its key */
      body * { visibility: hidden; }
      #cc-print, #cc-print * { visibility: visible; }
      #cc-print { position: absolute; left: 0; top: 0; width: 100%; }
      #cc-print .cc-print-line { display: block; margin: 0 0 var(--sp-2); }
      #cc-print .cc-no-print, #cc-print .wg-row button, #cc-print .wg-foot { display: none; }
      #cc-print .chart-card, #cc-print .wg-notes { box-shadow: none; break-inside: avoid; }
    }
    .pfas-type-slot { display: inline-block; flex: none; width: var(--icon-type); height: var(--icon-type); }
    .cc-sw-kind { color: var(--s-info); }
    .cc-sw-warn { color: var(--ico-warn); }
    .cc-sw-fail { color: var(--ico-fail); }
    .cc-legend svg { width: 18px; height: 18px; }
    .pick-list-items .pick-tools { display: flex; gap: var(--sp-2); align-items: center; }
    .pick-list-items { width: max-content; max-width: calc(100vw - 32px); }
    .pick-list-items .pick-grid { display: grid; grid-template-columns: repeat(2, max-content); gap: 2px var(--sp-3);
                                  border-top: 1px solid var(--s-border); padding-top: var(--sp-2); }
    table.vt { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
    table.vt th { text-align: left; padding: 5px 8px;
                  border-bottom: 1px solid var(--s-border);
                  color: var(--s-secondary); font-weight: 700; }
    table.vt td { padding: 4px 8px; border-bottom: 1px solid var(--s-border); }

    .history-banner { background: var(--s-primary-lt); border: 1px solid var(--s-primary);
                      border-radius: 4px; padding: 8px 14px; margin-bottom: 14px;
                      font-size: var(--fs-sm); color: var(--s-primary-dk); }

    @media (max-width: 768px) {
      .main { padding: 10px 12px; }
      .pfas-form-field { flex: 1 1 100%; }
      .chart-container { height: 220px; }
      .stats-bar { gap: 8px; }
      .stat-box { min-width: 70px; padding: 6px 10px; }
      .stat-value { font-size: var(--fs-md); }
    }
    .cc-act { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
    .cc-act input[type=text] { min-width: 160px; }
  </style>
  </tal:extras>
</head>
<body>
  <tal:t metal:fill-slot="header-title">QC Control Charts</tal:t>
  <tal:r metal:fill-slot="header-right">
    
  </tal:r>

  <div metal:fill-slot="content">

  <!-- ── Top filter bar (was the left sidebar) ──────────────────────────── -->
  <form class="pfas-filterbar" method="GET" action="" id="filterForm"
        tal:attributes="action string:${context/absolute_url}/@@pfas-control-chart">

    <div class="pfas-form-field"
         tal:define="mc_choices python:[{'value': u'', 'label': u'All methods'}] + [{'value': m, 'label': view.method_name(m)} for m in view.methods()];
                     mc_value python:view.selected_method() or u''; mc_label string:Method; mc_id string:method; mc_name string:method;
                     mc_submit python:True">
      <span>Method</span>
      <metal:m use-macro="context/@@pfas-macros/macros/method-choice" />
    </div>

    <div class="pfas-form-field">
      <span id="cc-qt-label">QC kinds</span>
      <details class="pick-list" id="cc-kinds" data-pick-list="qt_none" data-all="All kinds"
               tal:define="picked view/selected_qc_types; avail view/qc_kinds_available">
        <summary aria-labelledby="cc-qt-label cc-qt-text"><span class="pick-list-text" id="cc-qt-text"
                 tal:content="python:view.analyte_button_label([view.kind_name(k) for k in picked], avail, u'All kinds')">CCV</span><span
                 class="pick-list-caret" aria-hidden="true"><tal:m tal:define="ic context/@@pfas-icons" tal:replace="structure python:ic.svg('expand', hidden=True)" /></span></summary>
        <input type="hidden" name="qt_none" value="1" disabled="disabled" />
        <div class="pick-list-items">
          <div class="pick-tools">
            <button type="button" class="btn-sm btn-secondary" data-pick="all">Select all</button>
            <button type="button" class="btn-sm btn-secondary" data-pick="none">Clear</button>
          </div>
          <div class="pick-grid">
            <label tal:repeat="k avail" tal:attributes="title python:view.qc_type_label(k)">
              <input type="checkbox" value="1"
                     tal:attributes="name string:qt.${k}; data-label python:view.kind_name(k); checked python:'checked' if k in picked else None" />
              <tal:i tal:replace="structure python:view.type_icon(k)" />
              <span tal:replace="python:view.kind_name(k)">CCV</span></label>
          </div>
        </div>
      </details>
    </div>

    <div class="pfas-form-field">
      <span id="cc-an-label">Analytes</span>
      <details class="pick-list" id="cc-analytes" data-pick-list="an_none" data-all="All analytes"
               tal:define="picked view/selected_analytes; avail view/selection_analytes">
        <summary aria-labelledby="cc-an-label cc-an-text"><span class="pick-list-text" id="cc-an-text"
                 tal:content="python:view.analyte_button_label(picked, avail)">PFOA</span><span
                 class="pick-list-caret" aria-hidden="true"><tal:m tal:define="ic context/@@pfas-icons" tal:replace="structure python:ic.svg('expand', hidden=True)" /></span></summary>
        <input type="hidden" name="an_none" value="1" disabled="disabled" />
        <div class="pick-list-items">
          <div class="pick-tools">
            <button type="button" class="btn-sm btn-secondary" data-pick="all">Select all</button>
            <button type="button" class="btn-sm btn-secondary" data-pick="none">Clear</button>
          </div>
          <div class="pick-grid">
            <label tal:repeat="a avail">
              <input type="checkbox" value="1"
                     tal:attributes="name string:an.${a}; data-label a; checked python:'checked' if a in picked else None" />
              <span tal:replace="a">PFOA</span></label>
          </div>
        </div>
      </details>
    </div>

    <div class="pfas-form-field" tal:condition="python:not view.asymmetry_mode() and len(view.selected_qc_types()) == 1">
      <label for="qc_level">QC level</label>
      <select id="qc_level" name="qc_level" class="pfas-select" onchange="this.form.submit()">
        <option value="">&#8212; all levels &#8212;</option>
        <tal:levels tal:repeat="lv python:view.qc_levels(view.selected_qc_type(), view.selected_analyte())">
          <option tal:attributes="value python:lv[0];
                                  selected python:lv[0] == view.selected_level()"
                  tal:content="python:lv[1]">Expected 16 &#183; 131 CCVs</option>
        </tal:levels>
      </select>
    </div>

    <div class="pfas-form-field">
      <span id="cc-as-label">Analysts</span>
      <details class="pick-list" id="cc-analysts" data-pick-list="" data-all="All analysts" data-none="All analysts"
               tal:define="picked view/selected_analysts; avail view/analysts">
        <summary aria-labelledby="cc-as-label cc-as-text"><span class="pick-list-text" id="cc-as-text"
                 tal:content="python:view.analyst_filter_label(picked, avail)">All analysts</span><span
                 class="pick-list-caret" aria-hidden="true"><tal:m tal:define="ic context/@@pfas-icons" tal:replace="structure python:ic.svg('expand', hidden=True)" /></span></summary>
        <div class="pick-list-items">
          <div class="pick-tools">
            <button type="button" class="btn-sm btn-secondary" data-pick="all">Select all</button>
            <button type="button" class="btn-sm btn-secondary" data-pick="none">Clear</button>
          </div>
          <div class="pick-grid">
            <label tal:repeat="a avail">
              <input type="checkbox" value="1"
                     tal:attributes="name string:as.${a}; data-label a; checked python:'checked' if a in picked else None" />
              <span tal:replace="a">DEMO</span></label>
          </div>
        </div>
      </details>
    </div>

    <div class="pfas-form-field">
      <label for="instrument_id">Instrument</label>
      <select id="instrument_id" name="instrument_id" class="pfas-select" onchange="this.form.submit()">
        <option value="">&#8212; all instruments &#8212;</option>
        <tal:insts tal:repeat="inst view/instruments">
          <option tal:attributes="value inst;
                                  selected python:inst == (view.selected_instrument() or '')"
                  tal:content="inst">QTOF-1</option>
        </tal:insts>
      </select>
    </div>


    <!-- Date range — bounded to the dates the database actually holds -->
    <div class="pfas-form-field" role="group" aria-labelledby="cc-range" tal:define="bounds view/date_bounds">
      <span id="cc-range">Date range</span>
      <tal:r define="dr_id string:cc; dr_from_name string:date_from; dr_to_name string:date_to;
                     dr_from view/selected_date_from; dr_to view/selected_date_to;
                     dr_min bounds/min; dr_max bounds/max; dr_submit python:True; dr_compact python:True;
                     dr_from_title string:Earliest in database: ${bounds/min};
                     dr_to_title string:Latest in database: ${bounds/max}">
        <metal:r use-macro="context/@@pfas-macros/macros/date_range" /></tal:r>
    </div>

    <div class="pfas-form-field">
      <label for="limit">Runs shown</label>
      <input class="pfas-input limit-input" type="number" id="limit" name="limit"
             min="5" max="300" onchange="this.form.submit()"
             tal:attributes="value view/selected_limit"
             title="Caps the most-recent points within the date range. Default 20; set 200+ for annual review." />
    </div>

    <span class="pfas-filterbar-spacer"></span>
    <!-- top right: the lab overlay and how it shows -->
    <div class="cc-right">
    <div class="cc-overlay" tal:condition="view/overlay_options">
      <span class="pfas-label">Overlay <tal:h define="hid string:chart-overlay"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></span>
      <div class="cf-chips">
        <label class="pfas-switch cf-chip" tal:repeat="o view/overlay_options">
          <input type="checkbox" value="on" onchange="this.form.submit()"
                 tal:attributes="name python:'ov.%s' % o[0]; checked python:'checked' if o[0] in view.selected_overlays() else None" /><span class="pfas-switch-track"></span>
          <span tal:replace="python:o[1]">Lab room humidity</span></label>
      </div>
    </div>
    <nav class="pfas-seg" aria-label="Show as" tal:condition="view/selected_overlays">
      <a class="pfas-seg-item" tal:repeat="l view/show_links"
         tal:attributes="href l/url; aria-selected python:'true' if l['on'] else 'false'" tal:content="l/label">Stacked</a>
    </nav>
    <input type="hidden" name="show" tal:attributes="value view/show" />
    </div>
    <noscript><button class="btn btn-primary" type="submit">Apply</button></noscript>
    <a class="btn-sm btn-secondary"
       tal:attributes="href string:${context/absolute_url}/@@pfas-control-chart">Reset</a>
  </form>

  <div class="layout">

    <!-- ── Main ───────────────────────────────────────────────────────── -->
    <main class="main">

      <tal:nodbwarn tal:condition="not:view/db_available">
        <div class="chart-card">
          <div class="no-data">
            <strong>No QC database found</strong>
            Expected at <code tal:content="view/db_path">/data/qc/pfas_qc_results.db</code>.
            Process a run to populate results.
          </div>
        </div>
      </tal:nodbwarn>

      <tal:content tal:condition="view/db_available"
                   tal:define="chartJson view/chart_json;
                               violations view/westgard_violations;
                               data view/chart_data">

        <div class="history-banner" tal:condition="python:data.get('demo_points')">
          <strong>Example data.</strong>
          <span tal:replace="python:'%d of these %d points are' % (data['demo_points'], data['n_points'])">25 of these points are</span>
          generated example runs (worksheets DEMO-CC-&#8230;), not laboratory results.
          Remove them with <code>tools/demo_control_charts.py --remove</code>.
        </div>

        <div class="stats-bar" tal:condition="python:view.has_data() and not view.is_stacked()">

          <div class="stat-box">
            <div class="stat-label">Points</div>
            <div class="stat-value" tal:content="data/n_points">0</div>
          </div>

          <!-- a threshold chart counts what is above its threshold (tinted
               as the flag it is); the Westgard notes are information -->
          <div class="stat-box"
               tal:define="thr python:data.get('chart_type') == 'threshold';
                           n python:data['point_severity'].count('reject') if thr else len(violations);
                           judged python:not data.get('too_few_points') and not (thr and data.get('threshold') is None)"
               tal:attributes="class python:'stat-box rej' if (thr and n) else 'stat-box'">
            <div class="stat-label" tal:content="python:'Above threshold' if thr else 'Westgard notes'">Westgard notes</div>
            <div class="stat-value" tal:condition="n" tal:content="n">2</div>
            <div class="stat-value is-none" tal:condition="not:n"
                 tal:content="python:'None' if judged else 'not judged'">None</div>
          </div>
        </div>

        <div id="cc-print">
        <p class="cc-print-line" tal:content="view/filter_summary">Filters</p>
        <div class="alert alert-error" tal:condition="request/chart_error|nothing"
             tal:content="request/chart_error">error</div>
        <tal:review define="here_url python:request.get('ACTUAL_URL', '') + ('?' + request.get('QUERY_STRING') if request.get('QUERY_STRING') else '');
                            can view/can_review">
        <!-- the Westgard rules are always evaluated; what they find is a note,
             never a gate: nothing is held or blocked by it -->
        <div class="wg-notes" id="wg-notes" tal:define="ic context/@@pfas-icons"
             tal:condition="view/show_notes">
          <div class="wg-head">
            <tal:i tal:replace="structure python:ic.svg('note', hidden=True)" />
            <h3 tal:content="python:u'Westgard notes \u00b7 %d' % len(violations)">Westgard notes &#183; 2</h3>
            <span class="pfas-muted">For information; nothing is held.</span>
          </div>
          <div class="wg-row" tal:repeat="v violations">
            <b class="wg-rule" tal:content="python:view.rule_label(v['rule'])">2-2S</b>
            <span tal:content="python:view.note_line(v, data)">14 Nov</span>
            <button type="button" class="btn-sm btn-secondary" tal:condition="can"
                    tal:attributes="data-modal-open string:cc-act-${repeat/v/index}">Dismiss</button>
          </div>
          <p class="pfas-muted" tal:condition="not:violations">No open notes.</p>
          <div class="wg-foot" tal:condition="data/dismissed">
            <span tal:content="python:u'%d dismissed' % len(data['dismissed'])">1 dismissed</span>
            <button type="button" class="btn-sm btn-secondary" id="wg-toggle" aria-expanded="false"
                    aria-controls="wg-dismissed">Show dismissed</button>
          </div>
        </div>
        <!-- a note's Dismiss or Remove point: a reason, then either -->
        <tal:d tal:condition="python:can and violations and view.show_notes()">
        <div class="pfas-modal" tal:repeat="v violations" tal:attributes="id string:cc-act-${repeat/v/index}">
          <div class="pfas-modal-box is-narrow">
            <h2 tal:content="python:u'%s \u00b7 %s' % (view.rule_label(v['rule']), v['date'])">1-3S &#183; 2026-10-01</h2>
            <div class="pfas-meta-row"><span class="pfas-muted">Rule</span> <strong tal:content="v/message">Beyond 2 SD</strong></div>
            <div class="pfas-meta-row"><span class="pfas-muted">Worksheet</span> <strong tal:content="v/batch_id">B-1</strong></div>
            <div class="pfas-meta-row"><span class="pfas-muted">Value</span> <strong tal:content="v/value">1.0</strong></div>
            <form method="POST" class="cc-act" tal:attributes="action string:${context/absolute_url}/@@pfas-control-chart">
              <input type="hidden" name="came_from" tal:attributes="value here_url" />
              <input type="hidden" name="result_id" tal:attributes="value v/point_id" />
              <input type="hidden" name="rule" tal:attributes="value v/dismiss_rule" />
              <div class="pfas-form-field is-full">
                <label tal:attributes="for string:cc-act-reason-${repeat/v/index}">Reason</label>
                <input type="text" name="reason" required="required" class="pfas-input"
                       tal:attributes="id string:cc-act-reason-${repeat/v/index}" />
              </div>
              <div class="form-actions is-end">
                <button type="button" class="btn btn-secondary" data-modal-close="data-modal-close">Cancel</button>
                <button type="submit" name="chart_action" value="dismiss" class="btn btn-primary">Dismiss</button>
                <button type="submit" name="chart_action" value="remove" class="btn btn-secondary">Remove point</button>
              </div>
            </form>
          </div>
        </div>
        </tal:d>

        <div class="viol-card cc-no-print" id="wg-dismissed" hidden="hidden" tal:condition="python:data.get('dismissed') and view.show_notes()">
          <h3>Dismissed notes</h3>
          <table class="vt" data-col-resize="controlchart-vt-1" tal:define="rm context/@@pfas-row-menu">
            <thead><tr><th>Rule</th><th>Date</th><th>Worksheet</th><th>Value</th><th>Reason</th><th>By</th><th>When</th></tr></thead>
            <tbody>
              <tr tal:repeat="v data/dismissed"
                  tal:attributes="data-row-actions python:rm.actions(
                                      (u'Undo the dismissal', 'form', u'cc-undismiss-%d' % repeat['v'].index) if can else None)">
                <td tal:content="python:view.rule_label(v['rule'])">1-3S</td><td tal:content="v/date">d</td>
                <td tal:content="v/batch_id">b</td><td tal:content="v/value">v</td>
                <td tal:content="v/note/reason">reason</td><td tal:content="v/note/by_user">who</td>
                <td tal:content="python:view.lab_at(v['note'].get('at'), v['note'].get('at'))">when</td>
              </tr>
            </tbody>
          </table>
          <!-- each row's Undo, sent from its menu -->
          <tal:f tal:condition="can" tal:repeat="v data/dismissed">
          <form method="POST" hidden="hidden" tal:attributes="action string:${context/absolute_url}/@@pfas-control-chart;
                                                              id string:cc-undismiss-${repeat/v/index}">
            <input type="hidden" name="came_from" tal:attributes="value here_url" />
            <input type="hidden" name="result_id" tal:attributes="value v/point_id" />
            <input type="hidden" name="rule" tal:attributes="value v/stored_rule" />
            <button type="submit" name="chart_action" value="undismiss" class="btn-sm btn-secondary">Undo</button>
          </form>
          </tal:f>
        </div>

        <div class="viol-card cc-no-print" tal:condition="python:data.get('removed') and not view.is_stacked()">
          <h3>Removed points (not on the chart, not in the average or the limits)</h3>
          <table class="vt" data-col-resize="controlchart-vt-2" tal:define="rm context/@@pfas-row-menu">
            <thead><tr><th>Date</th><th>Worksheet</th><th>Value</th><th>Reason</th><th>By</th><th>When</th></tr></thead>
            <tbody>
              <tr tal:repeat="p data/removed"
                  tal:attributes="data-row-actions python:rm.actions(
                                      (u'Restore the point', 'form', u'cc-restore-%d' % repeat['p'].index) if can else None)">
                <td tal:content="p/date">d</td><td tal:content="p/batch_id">b</td>
                <td tal:content="p/value">v</td><td tal:content="p/note/reason">reason</td>
                <td tal:content="p/note/by_user">who</td><td tal:content="python:view.lab_at(p['note'].get('at'), p['note'].get('at'))">when</td>
              </tr>
            </tbody>
          </table>
          <!-- each row's Restore, sent from its menu -->
          <tal:f tal:condition="can" tal:repeat="p data/removed">
          <form method="POST" hidden="hidden" tal:attributes="action string:${context/absolute_url}/@@pfas-control-chart;
                                                              id string:cc-restore-${repeat/p/index}">
            <input type="hidden" name="came_from" tal:attributes="value here_url" />
            <input type="hidden" name="result_id" tal:attributes="value p/id" />
            <button type="submit" name="chart_action" value="restore" class="btn-sm btn-secondary">Restore</button>
          </form>
          </tal:f>
          <p class="pfas-muted" tal:condition="data/removed_more">
            <tal:n tal:replace="python:u'%d older removed not listed' % data['removed_more']" />
            <a class="btn-sm btn-secondary" tal:attributes="href python:view._page_url(removed_all=u'1')">Show all removed</a></p>
        </div>
        </tal:review>

        <!-- several analytes: points only, no limits (each analyte's mean
             and SD are its own) -->
        <div class="chart-card" tal:condition="view/is_stacked">
          <div class="chart-title"
               tal:content="python:u'%s: %s' % (view.kinds_label(), u', '.join(view.selected_analytes()))">CCV</div>
          <div class="chart-subtitle">Control limits are drawn for one analyte at a time.</div>
          <div class="chart-container"><canvas id="qcStack"></canvas></div>
          <p class="pfas-muted cc-few" tal:condition="view/left_off_note" tal:content="view/left_off_note">Blanks</p>
        </div>

        <div class="chart-card" tal:condition="not:view/is_stacked">
          <tal:hasdata tal:condition="view/has_data">
            <div class="chart-head">
              <div class="chart-head-text">
                <div class="chart-title" tal:content="data/insight">Two CCVs above +3 SD on 10 Oct</div>
                <div class="chart-for"
                     tal:content="python:u'{0} — {1}'.format(data['analyte'], data['qc_type_label'])">PFOA — CCV</div>
              </div>
              <label class="pfas-switch cc-no-print" title="The Average and the sigma lines">
                <input type="hidden" name="limit_lines_form" value="1" form="filterForm" />
                <input type="checkbox" name="limit_lines" value="1" form="filterForm" onchange="this.form.submit()"
                       tal:attributes="checked python:'checked' if data.get('limit_lines') else None" /><span class="pfas-switch-track"></span>
                <span>Limit lines</span></label>
              <a class="btn-sm btn-secondary cc-no-print" tal:attributes="href view/points_url">Export CSV</a>
              <button type="button" class="btn-sm btn-secondary cc-no-print" id="cc-print-btn">Print chart</button>
            </div>
            <div class="chart-subtitle">
              <tal:sub tal:content="string:${data/n_points} data points"></tal:sub>
              <tal:meth tal:condition="data/method">
                &nbsp;&bull; Method: <strong tal:replace="python:view.method_name(data['method'])">FDA 32-PFAS in Food</strong>
              </tal:meth>
              <tal:lev tal:condition="data/qc_level">
                &nbsp;&bull; Level: <tal:l tal:replace="python:view.level_label(data['qc_level'])">Expected 16</tal:l>
              </tal:lev>
              <tal:lim tal:condition="python:data.get('drawn')">
                &nbsp;&bull; Average <tal:u tal:replace="python:(data['units'] or u'value')[:1].lower() + (data['units'] or u'value')[1:]">recovery (%)</tal:u>:
                <tal:m tal:replace="python:'{:.3g}'.format(data['drawn']['mean'])">0</tal:m>
                &#177; <tal:s tal:replace="python:'{:.3g}'.format(data['drawn']['sd'])">0</tal:s>
              </tal:lim>
              <tal:ov tal:condition="python:data.get('overlay') and data['overlay']['empty']">
                &nbsp;&bull; <tal:o tal:replace="python:data['overlay']['label']">Lab room humidity</tal:o>: no readings on these dates
              </tal:ov>
            </div>
            <div class="chart-container">
              <canvas id="qcChart" tal:attributes="data-review-url string:${context/absolute_url}/@@pfas-data-review"></canvas>
            </div>
            <p class="pfas-muted cc-few" tal:condition="data/too_few_points"
               tal:content="view/few_points_note">Provisional limits</p>
            <p class="pfas-muted cc-few" tal:condition="data/left_off" tal:content="view/left_off_note">Blanks</p>
            <div class="cc-legend" id="qcLegend" aria-label="Key"></div>
            <!-- Stacked: a strip per chosen reading, on the same run axis -->
            <div class="chart-strips" id="qcStrips"></div>
          </tal:hasdata>

          <div class="no-data" tal:condition="not:view/has_data">
            <strong>No data for this selection</strong>
            <tal:asym tal:condition="view/asymmetry_mode">Peak asymmetry is measured on runs integrated from raw data.</tal:asym>
            <tal:nokind tal:condition="not:view/selected_qc_types">Pick a QC kind to view its control chart.</tal:nokind>
            <tal:noanalyte tal:condition="python:view.selected_qc_types() and not view.selected_analyte()">
              Pick an analyte to view its control chart.
            </tal:noanalyte>
            <tal:noqctype tal:condition="python:view.selected_analyte() and not view.selected_qc_type()">
              Pick a QC kind to view data for
              <strong tal:content="view/selected_analyte">PFOA</strong>.
            </tal:noqctype>
            <tal:withboth tal:condition="python:view.selected_analyte() and view.selected_qc_type()">
              No results for <strong tal:content="view/selected_analyte">PFOA</strong>
              (<tal:qt tal:replace="python:u', '.join(view.selected_qc_types())">CCV</tal:qt>)
              with current filters.
            </tal:withboth>
          </div>
        </div>

        </div><!-- /cc-print -->
      </tal:content>

      <!-- Blanks mode: what Blank History showed, on the chart's own page
           (lab, 2026-10-11): the rise against the previous comparable
           blank, the lots that differ, two blanks compared by choice -->
      <tal:blanks tal:condition="view/blanks_mode"
                  tal:define="bruns view/blank_runs; cmp view/blank_comparison; pr view/blank_pair;
                              picked view/selected_analytes">
        <div class="chart-card" tal:condition="bruns">
          <div class="chart-title">Blanks &#8212; what changed</div>
          <div class="chart-subtitle">A dashed marker on the chart is a run whose lots differ from the run before it.
            Below: this blank against the previous comparable one (same kind, method and matrix), what rose, and every lot both used.</div>
          <form method="GET" class="pfas-filterbar" tal:condition="python:len(bruns) > 1"
                tal:attributes="action string:${context/absolute_url}/@@pfas-control-chart">
            <input type="hidden" name="method" tal:attributes="value view/selected_method" />
            <input type="hidden" name="qc_type" tal:attributes="value view/selected_qc_type" />
            <input type="hidden" tal:repeat="a picked" tal:attributes="name string:an.${a}" value="1" />
            <label class="pfas-form-field"><span>This blank</span>
              <select name="a" class="pfas-select" onchange="this.form.submit()">
                <option tal:repeat="r bruns" tal:content="string:${r/run_date} ${r/key}"
                        tal:attributes="value r/key; selected python:pr[0] and r['key'] == pr[0]['key']">run</option>
              </select></label>
            <label class="pfas-form-field"><span>Against</span>
              <select name="b" class="pfas-select" onchange="this.form.submit()">
                <option tal:repeat="r bruns" tal:content="string:${r/run_date} ${r/key}"
                        tal:attributes="value r/key; selected python:pr[1] and r['key'] == pr[1]['key']">run</option>
              </select></label>
            <noscript><button class="btn btn-secondary" type="submit">Compare</button></noscript>
          </form>
          <tal:c tal:condition="cmp">
            <metal:m use-macro="context/@@pfas-blank-history-macros/macros/comparison" />
          </tal:c>
        </div>
      </tal:blanks>

      <div class="cc-note" tal:condition="python:view.db_available and view.asymmetry_mode()">
        Each run's mid-level calibrator, measured at 10 % of the peak height. Tracked, not reviewed.
      </div>
    </main>
  </div>

  <!-- points only: each result is its own measurement, not a trend line;
       colours from the tokens -->
  <tal:script tal:condition="python:view.has_data() or view.is_stacked()">
  <script tal:content="structure string:const CHART_DATA = ${view/chart_json}; const STACK = ${view/stack_json};"></script>
  <script>
  (function () {
    var css = getComputedStyle(document.documentElement);
    function tok(n) { return css.getPropertyValue(n).trim(); }
    var cInfo = tok('--s-info'), cWarn = tok('--s-warning'), cBad = tok('--s-danger'),
        cOk = tok('--s-success'), cMuted = tok('--s-secondary'), cBody = tok('--s-body');
    /* runs stay evenly spaced (one point per run); the axis is labelled by
       date bands beneath it, a day, a week or two weeks wide by the span
       shown; a run's own id is in its point's tooltip */
    var axisX = {type: 'category', title: {display: false}, ticks: {display: false}, grid: {display: false}};
    var DAY = 864e5, MONDAY0 = Date.UTC(1970, 0, 5);
    function dayOf(l) { return String(l || '').slice(0, 10); }
    function ms(d) { return Date.parse(d + 'T00:00:00Z'); }
    function iso(t) { return new Date(t).toISOString().slice(0, 10); }
    function bandUnit(labels) {
      var ds = labels.map(dayOf).filter(Boolean).sort();
      if (!ds.length) return 'day';
      var span = (ms(ds[ds.length - 1]) - ms(ds[0])) / DAY;
      return span >= 120 ? 'fortnight' : (span >= 14 ? 'week' : 'day');
    }
    function bandKey(d, unit) {
      if (unit === 'day') return d;
      var weeks = Math.floor((ms(d) - MONDAY0) / (7 * DAY));
      if (unit === 'fortnight') weeks = weeks - (weeks % 2);
      return iso(MONDAY0 + weeks * 7 * DAY);
    }
    function bandLabel(key, unit) {
      if (unit === 'day') return key;
      if (unit === 'week') return 'Week of ' + key;
      return key + ' to ' + iso(ms(key) + 13 * DAY);
    }
    var bandPlugin = {
      id: 'pfasDateBands',
      afterDraw: function (chart) {
        var x = chart.scales.x, area = chart.chartArea, ctx = chart.ctx;
        var labels = chart.data.labels || [];
        if (!labels.length) return;
        var unit = bandUnit(labels), bands = [];
        labels.forEach(function (l, i) {
          var k = bandKey(dayOf(l), unit), last = bands[bands.length - 1];
          if (last ? last.key === k : false) { last.to = i; } else { bands.push({key: k, from: i, to: i}); }
        });
        var half = labels.length > 1 ? (x.getPixelForValue(1) - x.getPixelForValue(0)) / 2 : 12;
        var y = area.bottom + 10, fam = Chart.defaults.font.family;
        ctx.save();
        ctx.lineWidth = 1.2; ctx.strokeStyle = cMuted; ctx.textAlign = 'center';
        bands.forEach(function (b) {
          var a = x.getPixelForValue(b.from) - half * 0.8, z = x.getPixelForValue(b.to) + half * 0.8;
          ctx.beginPath(); ctx.moveTo(a, y - 4); ctx.lineTo(a, y); ctx.lineTo(z, y); ctx.lineTo(z, y - 4); ctx.stroke();
          var mid = (a + z) / 2, n = b.to - b.from + 1, text = bandLabel(b.key, unit);
          ctx.font = '600 11px ' + fam;
          if (z - a + 2 * half > ctx.measureText(text).width) {
            ctx.fillStyle = cBody; ctx.fillText(text, mid, y + 16);
            ctx.font = '10px ' + fam; ctx.fillStyle = cMuted;
            ctx.fillText(n + (n === 1 ? ' run' : ' runs'), mid, y + 30);
          }
        });
        ctx.restore();
      }
    };

    /* a lot changed between two runs: a dashed marker at the later run,
       labelled with the lot (blank_history.lot_markers) */
    function lotAnnotations(markers) {
      var out = {};
      (markers || []).forEach(function (m, i) {
        out['lot' + i] = {type: 'line', scaleID: 'x', value: m.index, borderColor: cMuted, borderDash: [3, 3],
                          borderWidth: 1, label: {display: true, content: 'lot: ' + m.text, position: 'start',
                          rotation: -90, backgroundColor: tok('--surface'), color: cMuted,
                          font: {size: 10}, padding: {x: 3, y: 1}}};
      });
      return out;
    }
    if (STACK) {
      var el = document.getElementById('qcStack');
      if (!el) return;
      var stackSets = STACK.series.map(function (s, i) {
          var c = tok('--series-' + ((i % 6) + 1));
          return {label: s.analyte, data: s.values, showLine: false, spanGaps: false,
                  pointRadius: 3.5, pointHoverRadius: 6, backgroundColor: c, borderColor: c,
                  pointBackgroundColor: (s.nd || []).map(function (n) { return n ? 'transparent' : c; })};
        });
      var stackScales = {x: axisX, y: {title: {display: true, text: STACK.units || 'Value'}, grace: '8%'}};
      if (STACK.overlay) { stackSets.push(overlaySet(STACK.overlay)); stackScales.y2 = overlayAxis(STACK.overlay); }
      new Chart(el, {
        type: 'line', plugins: [bandPlugin],
        data: {labels: STACK.labels, datasets: stackSets},
        options: {responsive: true, maintainAspectRatio: false, animation: false, layout: {padding: {bottom: 40}},
                  plugins: {legend: {position: 'top', labels: {usePointStyle: true, boxWidth: 8}},
                            annotation: {annotations: lotAnnotations(STACK.lot_markers)}},
                  scales: stackScales}
      });
      return;
    }
    if (!CHART_DATA || !CHART_DATA.labels || !CHART_DATA.labels.length) return;

    /* the lines drawn: the standing limits, or provisional ones (dashed)
       from the results so far; the points are judged only on standing ones */
    var lim         = CHART_DATA.drawn;
    var prov        = !!(lim && lim.provisional);
    var severity    = CHART_DATA.point_severity || [];
    /* a flagged point is its QC type's icon drawn in the flag colour in
       place of the type colour: amber for a warning rule (1-2S), coral for a
       rejection rule; no mark is added beside it */
    var icoWarn = tok('--ico-warn') || cWarn, icoFail = tok('--ico-fail') || cBad;
    var ptColour = CHART_DATA.values.map(function (_, i) {
      return severity[i] === 'reject' ? icoFail : severity[i] === 'warning' ? icoWarn : cInfo;
    });
    /* each point is its QC type's icon, drawn from the page's one drawing
       source (#pfas-type-icons) in the type's colour token. A type with no
       icon is a plain filled dot. */
    var SVGNS = 'http://www.w3.org/2000/svg', ICON = 22;
    var typeSpec = null;
    try { typeSpec = JSON.parse((document.getElementById('pfas-type-icons') || {}).textContent || 'null'); } catch (e) { typeSpec = null; }
    /* each point is the drawing of its own kind's group; colours are read
       from the tokens again whenever the theme changes */
    var pointGroups = CHART_DATA.point_groups || [];
    var groupOf = function (i) { return pointGroups.length ? pointGroups[i] : CHART_DATA.type_group; };
    var drawings = (typeSpec && typeSpec.drawings) || {};
    /* a kind's own drawing (the one icon source), else its group's */
    function drawingFor(kind, g) {
      var k = String(kind || '').toUpperCase(), kinds = (typeSpec && typeSpec.kinds) || {}, map = (typeSpec && typeSpec.kind_of) || {};
      var name = map[k] || map[k.replace(/-/g, ' ').split(/\s+/)[0]];
      return (name && kinds[name]) || drawings[g];
    }
    var canDraw = !!(typeSpec && typeof Image !== 'undefined');
    /* within the checks group the colour follows the code: a CCV olive, an ICV cobalt */
    var codeColours = (typeSpec && typeSpec.colours) || {};
    function kindColourKey(kind) {
      var k = String(kind || '').toUpperCase().replace(/-/g, ' ').split(/\s+/)[0];
      return codeColours[String(kind || '').toUpperCase()] || codeColours[k] || '';
    }
    function groupColour(g, kind) {
      var ck = g === 'checks' ? kindColourKey(kind) : '';
      if (ck === 'ccv') { return tok('--type-ccv') || cInfo; }
      if (ck === 'icv') { return tok('--type-calibration') || cInfo; }
      return g ? (tok(g === 'not_judged' ? '--type-none' : '--type-' + String(g).replace('_', '-')) || cInfo) : cInfo;
    }
    var kindOf = function (i) { var ks = CHART_DATA.point_kinds || []; return ks.length ? ks[i] : CHART_DATA.qc_type; };
    var iconCache, imageFor, chartRef = null;
    function pointColour(sev, g, kind) { return sev === 'reject' ? tok('--ico-fail') || cBad : sev === 'warning' ? tok('--ico-warn') || cWarn : groupColour(g, kind); }
    function iconUrl(sev, hollow, g, kind) {
      var key = (sev || '') + (hollow ? '-h' : '') + '|' + g + '|' + String(kind), colour = pointColour(sev, g, kind), svg;
      if (iconCache[key]) { return iconCache[key]; }
      if (canDraw && g && drawingFor(kind, g)) {
        svg = drawingFor(kind, g).replace(/class="pfas-type-a"/g, hollow ? 'fill="none"' : 'fill="' + colour + '" stroke="none"');
      } else {
        svg = '<circle cx="12" cy="12" r="7" fill="' + (hollow ? 'none' : colour) + '" stroke="' + colour + '"/>';
      }
      iconCache[key] = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent('<svg xmlns="' + SVGNS +
        '" viewBox="0 0 24 24" width="' + ICON + '" height="' + ICON + '" fill="none" stroke="' + colour +
        '" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">' + svg + '</svg>');
      return iconCache[key];
    }
    function pointImage(sev, hollow, g, kind) {
      var key = (sev || '') + (hollow ? '-h' : '') + '|' + g + '|' + String(kind);
      if (!imageFor[key]) {
        var im = new Image(ICON, ICON);
        im.onload = function () { if (chartRef) { chartRef.update('none'); } };
        im.src = iconUrl(sev, hollow, g, kind);
        imageFor[key] = im;
      }
      return imageFor[key];
    }
    function pointStyles() {
      iconCache = {}; imageFor = {};
      return CHART_DATA.values.map(function (_, i) {
        if (canDraw && groupOf(i)) { return pointImage(severity[i], (CHART_DATA.point_nd || [])[i], groupOf(i), kindOf(i)); }
        return 'circle';
      });
    }
    var ptStyle = pointStyles();
    var ptRadius = CHART_DATA.values.map(function () { return 3.5; });

    /* limits are annotation lines across the chart, never data; a label is
       the sigma only, at the right edge */
    var ann = {};
    /* the labels of the Average and sigma lines are drawn in a gutter to the right of the plot (lineLabels below),
       out of the way of the points, except over a relative overlay */
    var gutterLabels = !(CHART_DATA.show === 'relative' && lim && (CHART_DATA.overlays || []).length);
    function hline(key, y, colour, dash, width, text) {
      if (y === null || y === undefined) return;
      /* a label on a white tab, so its own line and the points do not
         strike it through */
      ann[key] = {type: 'line', yMin: y, yMax: y, borderColor: colour, borderDash: dash,
                  borderWidth: width, label: {display: !!text && !gutterLabels, content: text, position: 'end',
                  backgroundColor: tok('--surface'), color: colour, padding: {x: 4, y: 1},
                  font: {size: 10, weight: '600'}, z: 10}};
      ann[key]._tone = colour === cBad ? 'bad' : colour === cWarn ? 'warn' : colour === cBody ? 'body' : '';
    }
    var MINUS = '\u2212', linesOn = CHART_DATA.limit_lines !== false;
    if (CHART_DATA.chart_type === 'threshold') {
      /* the method's threshold, never a stand-in: none set, no line */
      hline('thr', CHART_DATA.threshold, cBad, [5, 3], 1.5, 'Threshold');
    } else if (lim && linesOn) {
      /* provisional lines are dashed alike and the top one says so */
      var dash3 = prov ? [4, 4] : [], dash2 = [6, 3], dashM = prov ? [4, 4] : [];
      var provText = 'Provisional (' + lim.n_baseline + ' of ' + CHART_DATA.baseline_n + ')';
      hline('u3', lim.ucl_3, cBad, dash3, 1.2, prov ? [provText, '+3\u03c3'] : '+3\u03c3');
      hline('l3', lim.lcl_3, cBad, dash3, 1.2, MINUS + '3\u03c3');
      hline('u2', lim.ucl_2, cWarn, dash2, 1, '+2\u03c3');
      hline('l2', lim.lcl_2, cWarn, dash2, 1, MINUS + '2\u03c3');
      hline('m', lim.mean, cBody, dashM, 1.2, 'Average');
    }
    var ovs = CHART_DATA.overlays || [];
    var relativeMode = CHART_DATA.show === 'relative' ? (lim ? ovs.length : 0) : 0;
    var lotAnn = lotAnnotations(CHART_DATA.lot_markers);
    for (var lk in lotAnn) ann[lk] = lotAnn[lk];

    /* the chosen environmental reading, on its own axis at the right */
    function overlaySet(ov) {
      var c = tok('--series-4');
      return {label: ov.label + ' (' + ov.unit + ')', data: ov.values, yAxisID: 'y2', spanGaps: true,
              borderColor: c, backgroundColor: c, borderWidth: 1.5, pointRadius: 2, tension: 0, order: 2};
    }
    function overlayAxis(ov) {
      return {position: 'right', grid: {display: false}, grace: '10%',
              title: {display: true, text: ov.label + ' (' + ov.unit + ')', font: {size: 11}}};
    }
    var main = {
      label: CHART_DATA.analyte + ' (' + (CHART_DATA.qc_type_label || CHART_DATA.qc_type) + ')',
      data: CHART_DATA.values, showLine: false,
      backgroundColor: ptColour, borderColor: ptColour,
      /* hollow: a blank that detected nothing (charted at 0) */
      pointBackgroundColor: CHART_DATA.values.map(function (_, i) {
        return (CHART_DATA.point_nd || [])[i] ? 'transparent' : ptColour[i]; }),
      pointBorderColor: ptColour, pointStyle: ptStyle, pointRadius: ptRadius, pointHoverRadius: 7,
    };
    var tooltipPlugin = {
      callbacks: {
        /* a flagged point's tooltip leads with its rule ("Westgard 1-3S:
           above +3 SD"), then the run and its value */
        title: function (items) {
          var idx = items[0].dataIndex;
          /* the analyte's rules, never on an overlay reading's point */
          if (items[0].datasetIndex) return [items[0].label];
          return ((CHART_DATA.point_rules || [])[idx] || []).concat([items[0].label]);
        },
        afterBody: function (items) {
          var idx = items[0].dataIndex, lines = [];
          var g = function (k) { return (CHART_DATA[k] || [])[idx] || ''; };
          lines.push('Type: ' + (CHART_DATA.qc_type_label || CHART_DATA.qc_type));
          if (g('injections'))  lines.push('Injection: ' + g('injections'));
          if (g('batch_ids'))   lines.push('Worksheet: ' + g('batch_ids'));
          if (g('analysts'))    lines.push('Analyst: ' + g('analysts'));
          if (g('instruments')) lines.push('Instrument: ' + g('instruments'));
          if ((CHART_DATA.point_nd || [])[idx]) lines.push('Not detected');
          if (g('flags'))       lines.push('Flag: ' + g('flags'));
          if (relativeMode) lines.push('Value: ' + (CHART_DATA.values || [])[idx]);
          ovs.forEach(function (o) {
            var v = (o.values || [])[idx];
            if (v !== null) lines.push(o.label + ': ' + v + ' ' + o.unit);
          });
          return lines;
        }
      }
    };
    /* the page's font, and one label per point: several CCVs of one run
       printed the same "date worksheet" side by side */
    Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
    var seenLabel = {};
    var labels = (CHART_DATA.labels || []).map(function (l) {
      seenLabel[l] = (seenLabel[l] || 0) + 1;
      return seenLabel[l] > 1 ? l + ' #' + seenLabel[l] : l;
    });
    /* a point is a run: click opens that run's Data Review on the value
       (its provenance record); hover says so */
    var canvas = document.getElementById('qcChart');
    var reviewUrl = canvas.getAttribute('data-review-url') || '';
    function pointUrl(idx) {
      var b = (CHART_DATA.batch_ids || [])[idx], k = (CHART_DATA.prov_keys || [])[idx];
      if (!b || !reviewUrl) return '';
      return reviewUrl + '?batch_id=' + encodeURIComponent(b) + '&tab=qc_summary' +
             (k ? '#prov=' + encodeURIComponent(k) : '');
    }
    tooltipPlugin.callbacks.footer = function (items) {
      return pointUrl(items[0].dataIndex) ? 'Click: open the run\u2019s Data Review' : '';
    };
    /* hovering or focusing a line's label says the value it is drawn at, in
       the chart's unit, in the house tooltip (data-pfas-tip) the points'
       icons use; the label itself stays the sigma only */
    var tipDefs = [];
    if (lim && linesOn && CHART_DATA.chart_type !== 'threshold' && !relativeMode) {
      var unitWords = CHART_DATA.unit === '%' ? '% recovery' : (CHART_DATA.unit || ''),
          pv = prov ? ', provisional' : '',
          pooled = (CHART_DATA.qc_types || []).length > 1 ? ' \u00b7 ' + CHART_DATA.qc_types.join(', ') : '';
      [['ucl_3', '+3\u03c3', 'fail'], ['ucl_2', '+2\u03c3', 'warn'], ['mean', 'Average', 'body'], ['lcl_2', MINUS + '2\u03c3', 'warn'], ['lcl_3', MINUS + '3\u03c3', 'fail']]
        .forEach(function (d) {
          if (lim[d[0]] === undefined || lim[d[0]] === null) { return; }
          var v = Math.round(lim[d[0]] * 10) / 10;
          tipDefs.push({value: lim[d[0]], tone: d[2],
                        label: [d[1]],
                        words: d[1] + pv + ': ' + v.toFixed(1) + (unitWords ? ' ' + unitWords : '') + pooled});
        });
    }
    var tipEls = [], GUTTER_GAP = 8 + ICON / 2;
    var lineTips = {
      id: 'pfasLineTips',
      /* the labels, in the gutter right of the plot: a pill on the page's own
         surface, the text in the line's token colour (read at each draw, so a
         theme switch recolours them) */
      afterDatasetsDraw: function (chart) {
        var ctx = chart.ctx, a = chart.chartArea;
        if (!tipDefs.length || !ctx || !ctx.measureText || !a) { return; }
        var tones = {fail: tok('--ico-fail'), warn: tok('--ico-warn'), body: tok('--s-body')}, H = 16, GAP = 2,
            x = a.right + GUTTER_GAP, boxes;
        ctx.save();
        ctx.font = '600 10px ' + Chart.defaults.font.family; ctx.textBaseline = 'middle'; ctx.textAlign = 'left';
        /* each pill at its line's height where it fits; the rest are pushed
           apart by the least that stops them touching, with a leader to
           their line; the provisional label sits above the stack */
        boxes = tipDefs.map(function (d) {
          var at = chart.scales.y.getPixelForValue(d.value);
          return {d: d, line: at, y: at - H / 2, w: ctx.measureText(d.label[0]).width + 8};
        }).sort(function (p, q) { return p.line - q.line; });
        boxes.forEach(function (b, i) { if (i && b.y < boxes[i - 1].y + H + GAP) { b.y = boxes[i - 1].y + H + GAP; } });
        for (var k = boxes.length - 1; k >= 0; k--) {
          var limit = k === boxes.length - 1 ? a.bottom + 20 - H : boxes[k + 1].y - H - GAP;
          if (boxes[k].y > limit) { boxes[k].y = limit; }
        }
        boxes.forEach(function (b) {
          if (Math.abs(b.y + H / 2 - b.line) > 1) {
            ctx.strokeStyle = tones[b.d.tone]; ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(a.right, b.line); ctx.lineTo(x, b.y + H / 2); ctx.stroke();
          }
          ctx.fillStyle = tok('--surface'); ctx.strokeStyle = tones[b.d.tone]; ctx.lineWidth = 1;
          ctx.beginPath(); ctx.rect(x, b.y, b.w, H); ctx.fill(); ctx.stroke();
          ctx.fillStyle = tones[b.d.tone];
          ctx.fillText(b.d.label[0], x + 4, b.y + H / 2);
        });
        if (prov && boxes.length) {
          var text = 'Provisional (' + lim.n_baseline + ' of ' + CHART_DATA.baseline_n + ')', top = boxes[0].y - H - GAP;
          ctx.fillStyle = tok('--surface'); ctx.strokeStyle = tok('--s-body'); ctx.lineWidth = 1;
          ctx.beginPath(); ctx.rect(x, top, ctx.measureText(text).width + 8, H); ctx.fill(); ctx.stroke();
          ctx.fillStyle = tok('--s-body'); ctx.fillText(text, x + 4, top + H / 2);
        }
        ctx.restore();
      },
      afterRender: function (chart) {
        var holder = canvas.parentNode;
        if (!tipDefs.length || !holder || !holder.appendChild || !document.createElement) { return; }
        tipDefs.forEach(function (d, i) {
          var el = tipEls[i];
          if (!el) {
            el = tipEls[i] = document.createElement('span');
            el.className = 'pfas-tip cc-linetip'; el.tabIndex = 0; el.setAttribute('role', 'img');
            el.setAttribute('aria-label', d.words); el.setAttribute('data-pfas-tip', d.words);
            holder.appendChild(el);
          }
          el.style.top = chart.scales.y.getPixelForValue(d.value) + 'px';
        });
      }
    };
    var sets = [main], scales = {x: axisX,
             y: {title: {display: true, text: CHART_DATA.units || 'Value', font: {size: 11}}, grace: '8%'}};
    /* fewer than two points, so no limit to fit to: the axis is the method's
       window for this QC type (a point outside still shows). With limits
       drawn, provisional or not, the axis fits the data and the lines */
    if (CHART_DATA.too_few_points && CHART_DATA.window && !lim) {
      scales.y.suggestedMin = CHART_DATA.window[0];
      scales.y.suggestedMax = CHART_DATA.window[1];
    }
    /* Relative overlay: the analyte in SDs from its mean, each reading in its
       own units on its own axis; the 2SD / 3SD lines read for the analyte */
    if (prov && linesOn && !relativeMode) {
      /* annotation lines never stretch the axis: keep the provisional limits in view */
      scales.y.suggestedMin = lim.lcl_3;
      scales.y.suggestedMax = lim.ucl_3;
    }
    if (relativeMode) {
      var rel = window.PFAS.chartOverlay.relativeSets(CHART_DATA.values, lim.mean, lim.sd, ovs);
      main.data = rel.values;
      sets = sets.concat(rel.sets);
      for (var sk in rel.scales) scales[sk] = rel.scales[sk];
      scales.y.title.text = 'SDs from the average';
      ann = {};
      if (linesOn) { hline('r3u', 3, cBad, [6, 4], 1.2, prov ? ['Provisional (' + lim.n_baseline + ' of ' + CHART_DATA.baseline_n + ')', '+3\u03c3'] : '+3\u03c3'); hline('r3l', -3, cBad, [6, 4], 1.2, MINUS + '3\u03c3');
      hline('r2u', 2, cWarn, [4, 4], 1, '+2\u03c3'); hline('r2l', -2, cWarn, [4, 4], 1, MINUS + '2\u03c3');
      hline('r0', 0, cBody, [], 1.2, 'Average'); }
    }
    chartRef = new Chart(canvas, {
      type: 'line', plugins: [bandPlugin, lineTips],
      data: {labels: labels, datasets: sets},
      options: {
        responsive: true, maintainAspectRatio: false, animation: false, layout: {padding: {bottom: 40, right: tipDefs.length ? GUTTER_GAP + (prov ? 124 : 52) : 0}},
        interaction: {mode: 'nearest', intersect: true},
        onClick: function (evt, els) {
          if (!els.length) return;
          var url = pointUrl(els[0].index);
          if (url) window.location.href = url;
        },
        onHover: function (evt, els) {
          evt.native.target.style.cursor = els.length && pointUrl(els[0].index) ? 'pointer' : 'default';
        },
        plugins: {tooltip: tooltipPlugin, annotation: {annotations: ann},
                  /* the analyte's legend mark is a plain point, never a
                     flagged one's triangle or diamond */
                  legend: {display: relativeMode > 0, position: 'top', align: 'end',
                           labels: {usePointStyle: true, boxWidth: 8, font: {size: 11},
                                    generateLabels: function (chart) {
                                      return Chart.defaults.plugins.legend.labels.generateLabels(chart).map(function (it) {
                                        if (it.datasetIndex === 0) it.pointStyle = 'circle';
                                        return it;
                                      });
                                    }}}},
        scales: scales,
      },
    });
    /* the key: each kind on the chart as its icon and word, then the two
       flag colours; inline drawings in currentColor, so a theme switch
       recolours them with the page */
    var legend = document.getElementById('qcLegend');
    function drawLegend() {
      if (!legend || !legend.appendChild || !document.createElement) { return; }
      var fresh = [], seen = {};
      var addKey = function (svg, text) {
        var span = document.createElement('span');
        span.innerHTML = svg; span.appendChild(document.createTextNode(text)); fresh.push(span);
      };
      var dot = function (cls) {
        return '<svg class="' + cls + '" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="3.5" fill="currentColor"/></svg>';
      };
      (CHART_DATA.point_kinds || []).forEach(function (k, i) {
        if (seen[k]) { return; }
        seen[k] = true;
        var g = groupOf(i);
        var ck = g === 'checks' ? kindColourKey(k) : '';
        addKey(g && drawingFor(k, g) ? '<svg class="pfas-type is-' + String(g).replace('_', '-') + (ck ? ' is-' + ck : '') + '" viewBox="0 0 24 24" aria-hidden="true">' + drawingFor(k, g) + '</svg>'
                                : dot('cc-sw-kind'), k === 'ASYM' ? (CHART_DATA.qc_type_label || k) : k);
      });
      if (!fresh.length) { addKey(dot('cc-sw-kind'), CHART_DATA.qc_type_label || CHART_DATA.qc_type); }
      /* the flag colours mean something only where points are judged */
      if (CHART_DATA.limits || CHART_DATA.chart_type === 'threshold') {
        addKey(dot('cc-sw-warn'), 'Warning');
        addKey(dot('cc-sw-fail'), 'Exceeding rule tolerance');
      }
      if (legend.replaceChildren) { legend.replaceChildren.apply(legend, fresh); }
      else { fresh.forEach(function (k) { legend.appendChild(k); }); }
    }
    drawLegend();
    /* a light/dark switch recolours the points (their icons are drawn onto
       the canvas from the tokens) without a reload */
    function retheme() {
      var st = pointStyles();
      main.pointStyle = st;
      ptColour = CHART_DATA.values.map(function (_, i) {
        return severity[i] === 'reject' ? tok('--ico-fail') : severity[i] === 'warning' ? tok('--ico-warn') : cInfo; });
      main.backgroundColor = main.borderColor = main.pointBorderColor = ptColour;
      /* the limit lines and their labels, from the tokens of the theme now on */
      var toneNow = {bad: tok('--s-danger'), warn: tok('--s-warning'), body: tok('--s-body')};
      Object.keys(ann).forEach(function (k) {
        var a = ann[k], c = a._tone ? toneNow[a._tone] : null;
        if (!c) { return; }
        a.borderColor = c;
        if (a.label) { a.label.color = c; a.label.backgroundColor = tok('--surface'); }
      });
      if (chartRef) { chartRef.update('none'); }
    }
    /* Print chart: the chart card alone, in the light colours whatever theme is
       on; the points are redrawn from their new images, and printing waits for
       every one to load */
    var printBtn = document.getElementById('cc-print-btn');
    if (printBtn && typeof window.print === 'function') {
      printBtn.addEventListener('click', function () {
        var root = document.documentElement, theme = root.getAttribute && root.getAttribute('data-theme');
        var restore = function () {
          if (theme) { root.setAttribute('data-theme', theme); retheme(); }
          window.removeEventListener('afterprint', restore);
        };
        if (theme) { root.removeAttribute('data-theme'); retheme(); window.addEventListener('afterprint', restore); }
        var waits = Object.keys(imageFor).map(function (k) {
          var im = imageFor[k];
          return new Promise(function (done) {
            if (im.complete) { done(); return; }
            im.addEventListener('load', done); im.addEventListener('error', done);
          });
        });
        Promise.all(waits).then(function () {
          if (chartRef) { chartRef.update('none'); }
          window.print();
        });
      });
    }
    if (typeof MutationObserver !== 'undefined' && document.documentElement && document.documentElement.nodeType) {
      new MutationObserver(retheme).observe(document.documentElement, {attributes: true, attributeFilter: ['data-theme']});
    }
    /* Stacked: each chosen reading as a strip under the chart */
    if (!relativeMode) window.PFAS.chartOverlay.drawStrips(document.getElementById('qcStrips'), labels, ovs,
                                                           CHART_DATA.westgard, axisX);
  })();
  </script>
  </tal:script>
  <script>
  (function () {
    /* the pick-lists (Analytes, QC kinds): the button names what is picked,
       Select all and Clear act on the boxes, and closing the list applies the
       choice; nothing picked posts its marker so the page says so */
    var form = document.getElementById('filterForm');
    Array.prototype.forEach.call(document.querySelectorAll('details.pick-list[data-pick-list]'), function (box) {
      var label = box.querySelector('.pick-list-text');
      var boxes = function () { return Array.prototype.slice.call(box.querySelectorAll('input[type=checkbox]')); };
      var names = function (c) { return c.getAttribute('data-label') || (c.parentNode.textContent || '').replace(/^\s+|\s+$/g, ''); };
      var changed = false, marker = box.getAttribute('data-pick-list'),
          none = marker ? box.querySelector('input[name=' + marker + ']') : null;
      var refresh = function () {
        var on = boxes().filter(function (c) { return c.checked; }).map(names), n = on.length;
        if (none) { none.disabled = n > 0; }
        label.textContent = !n ? (box.getAttribute('data-none') || 'None picked') : (n === boxes().length && (n > 2 || box.getAttribute('data-none'))) ? box.getAttribute('data-all') :
          n <= 2 ? on.join(', ') : on.slice(0, 2).join(', ') + ' +' + (n - 2);
      };
      box.addEventListener('change', function () { changed = true; refresh(); });
      box.addEventListener('click', function (e) {
        var b = e.target.closest ? e.target.closest('[data-pick]') : null;
        if (!b) { return; }
        boxes().forEach(function (c) { c.checked = b.getAttribute('data-pick') === 'all'; });
        changed = true; refresh();
      });
      box.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && box.open) { box.open = false; box.querySelector('summary').focus(); }
      });
      document.addEventListener('click', function (e) { if (box.open && !box.contains(e.target)) { box.open = false; } });
      box.addEventListener('toggle', function () { if (!box.open && changed && form) { changed = false; form.submit(); } });
    });
    /* the dismissed notes stay folded until asked for */
    var tg = document.getElementById('wg-toggle'), dis = document.getElementById('wg-dismissed');
    if (tg && dis) {
      tg.addEventListener('click', function () {
        var open = dis.hidden;
        dis.hidden = !open; tg.setAttribute('aria-expanded', open ? 'true' : 'false');
        tg.textContent = open ? 'Hide dismissed' : 'Show dismissed';
      });
    }
  })();
  </script>
  </div><!-- /content slot -->
</body>
</html>
