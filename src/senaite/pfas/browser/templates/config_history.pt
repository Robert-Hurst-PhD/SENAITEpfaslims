<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Configuration History</title>
  <metal:fill fill-slot="header-title">Configuration History</metal:fill>

  <div metal:fill-slot="content" tal:define="editable view/can_configure">
  <div class="page-body">

    <div tal:condition="view/message"
         tal:attributes="class python:'alert alert-success' if view.message['ok'] else 'alert alert-error'"
         tal:content="view/message/text">message</div>

    <p class="form-note">Every configuration save: who, when and each value before and after. A revert puts one change back. <tal:h define="hid string:config-history"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></p>

    <form method="get" class="pfas-filterbar" data-autosubmit="data-autosubmit">
      <div class="pfas-form-field"><label for="ch-store">Setting</label>
      <select name="store" id="ch-store" class="pfas-select">
        <option value="">All settings</option>
        <option tal:repeat="s view/stores"
                tal:attributes="value python:s[0]; selected python:s[0] == view.store_filter()"
                tal:content="python:s[1]">Method profile</option>
      </select></div>
      <div class="pfas-form-field"><label for="ch-key">Key</label>
      <input type="text" name="key" id="ch-key" class="pfas-input" placeholder="e.g. EPA_537_1" tal:attributes="value view/key_filter" /></div>
      <div class="pfas-form-field"><label>When</label>
        <input type="hidden" name="when" tal:attributes="value view/when_filter" />
        <nav class="pfas-seg" aria-label="When">
          <a class="pfas-seg-item" tal:repeat="w view/when_links"
             tal:attributes="href w/url; aria-selected python:'true' if w['on'] else 'false'"
             tal:content="w/label">7 days</a>
        </nav></div>
      <div class="pfas-form-field" role="group" aria-labelledby="ch-range"><span id="ch-range">Date range</span>
        <tal:r define="dr_id string:ch; dr_from_name string:from; dr_to_name string:to; dr_from view/date_from; dr_to view/date_to">
          <metal:r use-macro="context/@@pfas-macros/macros/date_range" /></tal:r></div>
      <noscript><button type="submit" class="btn btn-primary">Filter</button></noscript>
    </form>

    <tal:p tal:define="pg view/paging; rows view/rows">
    <p tal:condition="not:rows" class="form-note">No changes recorded for these filters.</p>

    <!-- one line per change; a click shows the whole change in its dialog,
         and the row's menu offers Revert and this setting's history -->
    <table class="pfas-table ch-table" data-col-resize="config-history-ch-table" tal:condition="rows"
           tal:define="rm context/@@pfas-row-menu">
      <thead>
        <tr><th>When</th><th>Who</th><th>Setting</th><th>What changed</th></tr>
      </thead>
      <tbody>
        <tr tal:repeat="r rows"
            tal:attributes="data-row-dialog string:ch-${r/id};
                            data-row-actions python:rm.actions(
                                (u'Open the full change', 'modal', u'ch-%s' % r['id']),
                                (u'Revert this change', 'form', u'ch-revert-%s' % r['id']) if editable and r['revertable'] else None,
                                (u'Show this setting\'s history', 'href', r['history_url']))">
          <td class="cell-nowrap" tal:content="r/at">2026-09-30 12:00:00</td>
          <td tal:content="r/who">admin</td>
          <td><strong tal:content="r/label">EPA 537.1</strong>
            <span class="form-note" tal:condition="python:r['store'] != r['label']" tal:content="r/store">Method profile</span></td>
          <td tal:content="r/brief">Nominal amounts: 3 entries set</td>
        </tr>
      </tbody>
    </table>

    <!-- the whole change, value by value, in the shared centred dialog; Revert at its foot -->
    <tal:d repeat="r rows">
    <div class="pfas-modal" tal:attributes="id string:ch-${r/id}">
      <div class="pfas-modal-box is-wide">
        <h2 tal:content="r/brief">Nominal amounts: 3 entries set</h2>
        <dl class="rc-facts">
          <div><dt>When</dt><dd tal:content="r/at">2026-09-30 12:00:00</dd></div>
          <div><dt>Who</dt><dd tal:content="r/who">admin</dd></div>
          <div><dt>Setting</dt><dd tal:content="r/label">EPA 537.1</dd></div>
          <div><dt>Kind</dt><dd tal:content="r/store">Method profile</dd></div>
          <div tal:condition="r/note"><dt>Note</dt><dd tal:content="r/note">Revert of 12</dd></div>
        </dl>
        <table class="pfas-table" data-col-resize="config-history-change" tal:condition="r/detail">
          <thead><tr><th>Value</th><th>Before</th><th>After</th></tr></thead>
          <tbody><tr tal:repeat="c r/detail">
            <td tal:content="c/setting">Nominal amounts / Groundwater</td>
            <td class="pfas-muted" tal:content="c/before">not set</td>
            <td><strong tal:content="c/after">250.0</strong></td>
          </tr></tbody>
        </table>
        <form method="post" class="form-actions is-end" tal:condition="python:editable and r['revertable']"
              tal:attributes="id string:ch-revert-${r/id}">
          <input type="hidden" name="action" value="revert" />
          <input type="hidden" name="store" tal:attributes="value view/store_filter" />
          <input type="hidden" name="key" tal:attributes="value view/key_filter" />
          <input type="hidden" name="eid" tal:attributes="value r/id" />
          <button type="button" class="btn btn-secondary" data-modal-close="data-modal-close">Close</button>
          <button type="submit" class="btn btn-warn">Revert this change</button>
        </form>
        <div class="form-actions is-end" tal:condition="python:not (editable and r['revertable'])">
          <button type="button" class="btn btn-secondary" data-modal-close="data-modal-close">Close</button>
        </div>
      </div>
    </div>
    </tal:d>

    <metal:p use-macro="context/@@pfas-macros/macros/paging" />
    </tal:p>
  </div>
  </div>
</html>
