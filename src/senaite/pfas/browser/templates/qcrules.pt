
<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">QC Rule Configuration</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
    /* ── QC Rules page-specific ────────────────────────────────────────── */
    .save-banner { background: #d4edda; border: 1px solid #c3e6cb; border-radius: 4px;
                   padding: 10px 16px; margin-bottom: 16px; color: #155724; font-weight: 600; }

    .tab-pane         { display: none; }
    .tab-pane.active  { display: block; }

    /* QC-type collapsible cards (within the QC Types tab pane) */
    .section { background: var(--s-bg); border-radius: 6px;
               border: 1px solid var(--s-border);
               box-shadow: 0 1px 3px rgba(0,0,0,.06); margin-bottom: 18px; overflow: hidden; }
    .section-head { background: var(--s-light); padding: 10px 16px;
                    display: flex; align-items: center; gap: 10px; cursor: pointer;
                    border-bottom: 1px solid var(--s-border); user-select: none; }
    .section-head h2 { font-size: 14px; font-weight: 600; flex: 1; color: var(--s-body); }
    .section-head .section-meta { font-size: 11px; color: var(--s-secondary); }
    .section-body { padding: 16px; }
    .section.collapsed .section-body { display: none; }

    .chart-badge { font-size: 10px; padding: 2px 8px; border-radius: 10px;
                   font-weight: 700; text-transform: uppercase; }
    .badge-lj        { background: var(--s-primary-lt); color: var(--s-primary); }
    .badge-threshold { background: #fff3e0; color: #e65100; }

    .field-with-unit { display: flex; align-items: center; gap: 6px; }
    .field-with-unit input { flex: 1; min-width: 0; }
    .unit-label { font-size: 12px; color: var(--s-secondary); font-weight: 600;
                  white-space: nowrap; }
    .field-readonly { font-size: 13px; color: var(--s-secondary); padding: 6px 0; }

.path-info { font-size: 11px; color: var(--s-secondary); }
    .path-info code { background: var(--s-light); padding: 1px 5px; border-radius: 3px; }

    .json-editor { width: 100%; height: 400px; font-family: monospace; font-size: 12px;
                   padding: 10px; border: 1px solid var(--s-input-border); border-radius: 4px;
                   background: #fafafa; resize: vertical; }

    /* Rule Toggle Grid */
    .toggle-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .toggle-table th { background: var(--s-light); color: var(--s-secondary);
                       font-size: 11px; font-weight: 700; text-transform: uppercase;
                       letter-spacing: .04em; padding: 8px 12px; text-align: center;
                       border-bottom: 2px solid var(--s-border); }
    .toggle-table th.rule-col { text-align: left; min-width: 200px; }
    .toggle-table td { padding: 7px 12px; border-bottom: 1px solid var(--s-border); }
    .toggle-table tr:last-child td { border-bottom: none; }
    .toggle-table tr:hover td { background: var(--s-light); }
    .toggle-table td.rule-name { font-size: 13px; color: var(--s-body); }
    .toggle-table td.check-cell { text-align: center; }

    .toggle-switch { position: relative; display: inline-block;
                     width: 38px; height: 22px; cursor: pointer; margin: 0; vertical-align: middle; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; position: absolute; }
    .toggle-track { position: absolute; top: 0; left: 0; right: 0; bottom: 0;
                    background: var(--s-input-border); border-radius: 22px; transition: background .15s; }
    .toggle-track::before { content: ""; position: absolute; width: 16px; height: 16px;
                             left: 3px; bottom: 3px; background: #fff; border-radius: 50%;
                             transition: transform .15s; box-shadow: 0 1px 3px rgba(0,0,0,.25); }
    .toggle-switch input:checked + .toggle-track { background: var(--s-primary); }
    .toggle-switch input:checked + .toggle-track::before { transform: translateX(16px); }
    .toggle-switch input:focus + .toggle-track { box-shadow: 0 0 0 3px var(--s-focus-ring); }

    /* Method tabs */
    .method-tabs { display: flex; gap: 0; border-bottom: 2px solid var(--s-primary);
                   margin-bottom: 16px; flex-wrap: wrap; }
    .method-tab  { padding: 8px 18px; cursor: pointer; font-size: 13px;
                   border: 1px solid transparent; border-bottom: none;
                   border-radius: 4px 4px 0 0; color: var(--s-secondary); background: var(--s-light); }
    .method-tab.active { background: var(--s-bg); border-color: var(--s-border) var(--s-border) var(--s-bg);
                         color: var(--s-primary); font-weight: 600; }
    .method-panel { display: none; }
    .method-panel.active { display: block; }

    .limit-rule-group { margin-bottom: 14px; background: var(--s-primary-lt);
                        border: 1px solid var(--s-primary); border-radius: 4px;
                        padding: 10px 14px; opacity: 1; transition: opacity .15s; }
    .limit-rule-group.disabled { opacity: .4; background: var(--s-light);
                                  border-color: var(--s-border); }
    .limit-rule-title { font-size: 12px; font-weight: 700; color: var(--s-primary);
                        text-transform: uppercase; margin-bottom: 8px;
                        display: flex; align-items: center; gap: 8px; }
    .limit-rule-title.disabled { color: var(--s-secondary); }
    .disabled-badge { background: var(--s-border); color: var(--s-secondary); font-size: 9px;
                      padding: 2px 6px; border-radius: 8px; }
    .override-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
    .override-row label { font-size: 11px; color: var(--s-secondary); font-weight: 600;
                          min-width: 200px; }
    .override-input { padding: 5px 8px; border: 1px solid var(--s-input-border); border-radius: 4px;
                      font-size: 13px; background: var(--s-bg); width: 100px; }
    .override-input.is-overridden { border-color: var(--s-primary); background: var(--s-primary-lt); }
    .inherited-hint { font-size: 10px; color: var(--s-secondary); }

    .matrix-card { background: var(--s-light); border: 1px solid var(--s-border);
                   border-radius: 4px; padding: 12px 16px; margin-bottom: 10px; }
    .matrix-card-title { font-size: 13px; font-weight: 700; text-transform: uppercase;
                         color: var(--s-secondary); margin-bottom: 8px; }
    .form-note { font-size: 12px; color: var(--s-secondary); line-height: 1.5; margin-bottom: 14px; }

    /* ── Right-click context menu ───────────────────────────────────────── */
    #pfas-ctx-menu {
      position: fixed; z-index: 9999; display: none;
      background: var(--s-bg); border: 1px solid var(--s-border);
      border-radius: 6px; box-shadow: 0 4px 20px rgba(0,0,0,.18);
      min-width: 210px; overflow: hidden; padding: 4px 0;
    }
    .ctx-item {
      display: block; width: 100%; text-align: left;
      padding: 8px 16px; background: none; border: none;
      cursor: pointer; font-size: 13px; color: var(--s-body);
      white-space: nowrap;
    }
    .ctx-item:hover { background: var(--s-light); }
    .ctx-item.danger { color: #dc3545; }
    .ctx-sep { height: 1px; background: var(--s-border); margin: 4px 0; }
    .ctx-label {
      display: block; padding: 4px 16px 2px;
      font-size: 10px; font-weight: 700; letter-spacing: .06em;
      text-transform: uppercase; color: var(--s-secondary);
    }
  </style>
  </tal:styles>
</head>
<body>
  <tal:t metal:fill-slot="header-title">QC Rules</tal:t>
  <tal:r metal:fill-slot="header-right">
    <span class="role-badge">LabManager</span>
  </tal:r>

  <div metal:fill-slot="tabs">
    <div class="pfas-tabs" id="qc-rules-tabs">
      <a class="pfas-tab" data-pane="pane-global" href="#pane-global"
         onclick="qcTabSwitch('pane-global'); return false;">Global Criteria</a>
      <a class="pfas-tab" data-pane="pane-qctypes" href="#pane-qctypes"
         onclick="qcTabSwitch('pane-qctypes'); return false;">QC Types</a>
      <a class="pfas-tab" data-pane="pane-toggles" href="#pane-toggles"
         onclick="qcTabSwitch('pane-toggles'); return false;">Rule Toggles</a>
      <a class="pfas-tab" data-pane="pane-limits" href="#pane-limits"
         onclick="qcTabSwitch('pane-limits'); return false;">Method Limits</a>
      <a class="pfas-tab" data-pane="pane-json" href="#pane-json"
         onclick="qcTabSwitch('pane-json'); return false;">JSON</a>
    </div>
  </div>

  <div metal:fill-slot="content">

  <!-- Floating context menu (populated by JS on right-click) -->
  <div id="pfas-ctx-menu" role="menu"></div>

  <div class="save-banner" tal:condition="view/save_message">
    Rules saved successfully.
  </div>

    <form id="rulesForm" method="POST" action=""
          tal:attributes="action string:${context/absolute_url}/@@pfas-qc-rules">

      <!-- ── GLOBAL CRITERIA ─────────────────────────────────────────────── -->
      <div class="tab-pane active" id="pane-global">
        <div style="background:var(--s-primary-lt);border:1px solid #bee5eb;border-radius:8px;
                padding:10px 16px;font-size:12.5px;color:#0c5460;margin-bottom:16px;">
      <strong>Scope of this page:</strong> global <em>instrument-verification</em>
      rule library — which engine rules are ON per method (exported to
      <code>qc_rules.json</code> for the pipeline). Method-science acceptance —
      recovery tiers, QC-type limits &amp; toggles, spike levels, matrices —
      lives in <a href="@@pfas-method-profiles">Method Profiles</a>.
    </div>
        <div class="field-grid">
          <tal:gfields tal:repeat="item view/global_fields">
            <div class="field-row">
              <label tal:content="item/label">Calibration r&#178; Minimum</label>
              <div class="field-with-unit">
                <input type="number" step="any"
                       tal:attributes="name string:global.${item/key}; value item/value" />
                <span class="unit-label" tal:condition="item/unit" tal:content="item/unit">%</span>
              </div>
            </div>
          </tal:gfields>
        </div>
        <div class="pane-footer">
          <span>Global instrument pass/fail thresholds applied to all methods</span>
          <span class="pf-path" tal:content="view/rules_path">/data/qc/qc_rules.json</span>
        </div>
      </div>

      <!-- ── QC TYPES ────────────────────────────────────────────────────── -->
      <div class="tab-pane" id="pane-qctypes">
        <tal:qcsections tal:repeat="qtype view/qc_types">
          <div class="section" tal:attributes="id string:sec-${qtype}">
            <div class="section-head"
                 tal:attributes="onclick string:toggleSection('sec-${qtype}')">
              <h2 tal:content="python:'{} — {}'.format(qtype, view.qc_label(qtype))">CCV</h2>
            </div>
            <div class="section-body">
              <div class="field-grid">
                <tal:fields tal:repeat="item python:view.qc_type_fields(qtype)">
                  <tal:skip tal:condition="python:item['key'] not in ('label', 'chart_type', 'note')">
                    <div class="field-row">
                      <label tal:content="item/label">Max % Deviation</label>
                      <div class="field-with-unit">
                        <input type="number" step="any"
                               tal:condition="python:isinstance(item['value'], (int, float))"
                               tal:attributes="name string:qc_types.${qtype}.${item/key}; value item/value" />
                        <input type="text"
                               tal:condition="python:not isinstance(item['value'], (int, float)) and item['value'] is not None"
                               tal:attributes="name string:qc_types.${qtype}.${item/key}; value item/value" />
                        <span class="field-readonly"
                              tal:condition="python:item['value'] is None">(per-analyte Reporting Limit)</span>
                        <span class="unit-label"
                              tal:condition="python:item['unit'] and item['value'] is not None"
                              tal:content="item/unit">%</span>
                      </div>
                    </div>
                  </tal:skip>
                  <tal:show tal:condition="python:item['key'] == 'note'">
                    <div class="field-row" style="grid-column:1/-1">
                      <label>Note</label>
                      <span class="field-readonly" tal:content="item/value">-</span>
                    </div>
                  </tal:show>
                </tal:fields>
              </div>
            </div>
          </div>
        </tal:qcsections>
        <div class="pane-footer">
          <span>Per-QC-type acceptance limits</span>
          <span class="pf-path" tal:content="view/rules_path">/data/qc/qc_rules.json</span>
        </div>
      </div>


      <!-- ── RULE TOGGLES ───────────────────────────────────────────────── -->
      <div class="tab-pane" id="pane-toggles">
          <p class="form-note">
            Toggle a rule off to exclude it from automated engine evaluation for that method.
            Rules marked <em>UI only</em> affect whether the check appears in the analyst
            review queue but have no automated engine flag-check yet.
          </p>
          <table class="toggle-table">
            <thead>
              <tr>
                <th class="rule-col">Rule</th>
                <tal:mhdrs tal:repeat="m view/methods">
                  <th tal:content="m/label">Method</th>
                </tal:mhdrs>
              </tr>
            </thead>
            <tbody>
              <tal:rows tal:repeat="row view/toggle_grid">
                <tr>
                  <td class="rule-name" tal:content="row/rule_label">IS Response</td>
                  <tal:cells tal:repeat="state row/states">
                    <td class="check-cell">
                      <label class="toggle-switch"
                             tal:attributes="title python:'%s | %s' % (row['rule_label'], state['method_label'])">
                        <input type="checkbox" class="toggle-cb"
                               tal:attributes="id python:'toggle_{}_{}'.format(state['method_id'], row['rule_key']);
                                               data-method state/method_id;
                                               data-rule row/rule_key;
                                               checked state/enabled" />
                        <span class="toggle-track"></span>
                      </label>
                    </td>
                  </tal:cells>
                </tr>
              </tal:rows>
            </tbody>
          </table>
        <div class="pane-footer">
          <span>Enable/disable each QC rule per method; disabled rules skip engine evaluation</span>
          <span class="pf-path" tal:content="view/rules_path">/data/qc/qc_rules.json</span>
        </div>
      </div>

      <!-- ── METHOD LIMITS ─────────────────────────────────────────────── -->
      <div class="tab-pane" id="pane-limits">
          <p class="form-note">Override rule parameters per method. Leave unchanged to inherit from Global Criteria.
            Highlighted border = active override.</p>
          <div class="method-tabs" id="methodTabBar">
            <tal:tabs tal:repeat="sec view/method_limit_sections">
              <div class="method-tab"
                   tal:attributes="id string:mtab-${sec/method_id};
                                   onclick string:selectMethod('${sec/method_id}')"
                   tal:content="sec/method_label">FDA 32-PFAS</div>
            </tal:tabs>
            <button type="button" class="method-tab-add" title="Add method override tab"
                    onclick="addMethodTab()" style="
                      margin-left:6px; padding:4px 10px; cursor:pointer;
                      background:var(--s-primary); color:#fff; border:none;
                      border-radius:4px 4px 0 0; font-size:13px; font-weight:700;
                      align-self:flex-end; margin-bottom:0;">
              +
            </button>
          </div>
          <tal:panels tal:repeat="sec view/method_limit_sections">
            <div class="method-panel" tal:attributes="id string:mpanel-${sec/method_id}">
              <tal:groups tal:repeat="grp sec/param_groups">
                <div tal:attributes="class python:'limit-rule-group' + ('' if grp['enabled'] else ' disabled');
                                     data-rule-key grp/rule_key">
                  <div tal:attributes="class python:'limit-rule-title' + ('' if grp['enabled'] else ' disabled')">
                    <span tal:content="grp/rule_label">IS Response</span>
                    <span class="disabled-badge" tal:condition="python:not grp['enabled']">disabled for this method</span>
                  </div>
                  <tal:params tal:repeat="p grp/params">
                    <div class="override-row">
                      <label tal:content="p/label">Max deviation</label>
                      <input type="number" step="any"
                             tal:attributes="class python:'override-input' + (' is-overridden' if p['overridden'] else '');
                                             data-method sec/method_id;
                                             data-param p/name;
                                             data-inherited p/inherited;
                                             value p/value"
                             onchange="markOverridden(this)" />
                      <span class="inherited-hint">
                        (global: <span tal:replace="p/inherited">50</span>)
                      </span>
                    </div>
                  </tal:params>
                </div>
              </tal:groups>
            </div>
          </tal:panels>
        <div class="pane-footer">
          <span>Per-method overrides of global limits; highlighted border = active override</span>
          <span class="pf-path" tal:content="view/rules_path">/data/qc/qc_rules.json</span>
        </div>
      </div>

      <!-- ── RAW JSON ───────────────────────────────────────────────────── -->
      <div class="tab-pane" id="pane-json">
          <p class="form-note">Advanced: edit the full QC rules document as raw JSON, then click Apply to populate the form.</p>
          <textarea id="rawJson" class="json-editor"
                    tal:content="view/rules_json"></textarea>
          <button type="button" onclick="applyJson()"
                  style="margin-top:8px;padding:6px 14px;cursor:pointer">
            Apply JSON to form
          </button>
        <div class="pane-footer">
          <span>Full rules document — edit directly then Apply to populate form fields</span>
          <span class="pf-path" tal:content="view/rules_path">/data/qc/qc_rules.json</span>
        </div>
      </div>

      <input type="hidden" id="rules_json" name="rules_json" value="" />
    </form>

  <script>
  /* ── Top-tab switching (Global/QC Types/Matrix/Toggles/Limits/JSON) ── */
  function qcTabSwitch(paneId) {
    document.querySelectorAll('#rulesForm .tab-pane').forEach(function(p) {
      p.classList.remove('active');
    });
    document.querySelectorAll('#qc-rules-tabs .pfas-tab').forEach(function(t) {
      t.classList.remove('active');
    });
    var pane = document.getElementById(paneId);
    if (pane) pane.classList.add('active');
    var tab = document.querySelector('#qc-rules-tabs [data-pane="' + paneId + '"]');
    if (tab) tab.classList.add('active');
    try {
      history.replaceState(null, '', location.pathname + location.search + '#' + paneId);
    } catch(e) {}
  }

  /* Restore tab from URL hash or default to first tab */
  (function() {
    var hash = location.hash.replace('#', '');
    var validPanes = ['pane-global','pane-qctypes','pane-toggles','pane-limits','pane-json'];
    var target = validPanes.indexOf(hash) >= 0 ? hash : 'pane-global';
    qcTabSwitch(target);
  })();

  function toggleSection(id) {
    var el = document.getElementById(id);
    if (el) el.classList.toggle('collapsed');
  }

  (function() {
    var tabs = document.querySelectorAll('.method-tab');
    var panels = document.querySelectorAll('.method-panel');
    if (tabs.length > 0) { tabs[0].classList.add('active'); panels[0].classList.add('active'); }
  })();

  function selectMethod(methodId) {
    document.querySelectorAll('.method-tab').forEach(function(t) {
      t.classList.toggle('active', t.id === 'mtab-' + methodId);
    });
    document.querySelectorAll('.method-panel').forEach(function(p) {
      p.classList.toggle('active', p.id === 'mpanel-' + methodId);
    });
  }

  function updateRuleVisibility(methodId, ruleKey, enabled) {
    var panel = document.getElementById('mpanel-' + methodId);
    if (!panel) return;
    panel.querySelectorAll('.limit-rule-group[data-rule-key]').forEach(function(grp) {
      if (grp.dataset.ruleKey !== ruleKey) return;
      var badge = grp.querySelector('.disabled-badge');
      var title = grp.querySelector('.limit-rule-title');
      if (enabled) {
        grp.classList.remove('disabled');
        if (title) title.classList.remove('disabled');
        if (badge) badge.style.display = 'none';
        grp.querySelectorAll('.override-input').forEach(function(i) { i.disabled = false; });
      } else {
        grp.classList.add('disabled');
        if (title) title.classList.add('disabled');
        if (badge) badge.style.display = '';
        grp.querySelectorAll('.override-input').forEach(function(i) { i.disabled = true; });
      }
    });
  }

  function markOverridden(inp) {
    var inherited = parseFloat(inp.dataset.inherited);
    var current   = parseFloat(inp.value);
    inp.classList.toggle('is-overridden',
      !isNaN(current) && (isNaN(inherited) || current !== inherited));
  }

  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.toggle-cb').forEach(function(cb) {
      cb.addEventListener('change', function() {
        updateRuleVisibility(cb.dataset.method, cb.dataset.rule, cb.checked);
      });
    });
    document.querySelectorAll('.toggle-cb').forEach(function(cb) {
      updateRuleVisibility(cb.dataset.method, cb.dataset.rule, cb.checked);
    });
  });

  function buildRulesFromForm() {
    var rules = { "version": 1, "global": {}, "qc_types": {},
                  "method_rule_toggles": {}, "method_overrides": {} };
    document.querySelectorAll('#rulesForm input[name]').forEach(function(inp) {
      var name = inp.name, val = inp.value;
      if (name.indexOf('global.') === 0) {
        var key = name.slice(7);
        var fval = parseFloat(val);
        rules.global[key] = isNaN(fval) ? val : fval;
      } else if (name.indexOf('qc_types.') === 0) {
        var parts = name.slice(9).split('.');
        var qtype = parts[0], field = parts.slice(1).join('.');
        if (!rules.qc_types[qtype]) rules.qc_types[qtype] = {};
        var fval = parseFloat(val);
        rules.qc_types[qtype][field] = isNaN(fval) ? val : fval;
      }
    });
    document.querySelectorAll('.toggle-cb').forEach(function(cb) {
      var method = cb.dataset.method, rule = cb.dataset.rule;
      if (!rules.method_rule_toggles[method]) rules.method_rule_toggles[method] = {};
      rules.method_rule_toggles[method][rule] = cb.checked;
    });
    document.querySelectorAll('.override-input').forEach(function(inp) {
      var method    = inp.dataset.method;
      var param     = inp.dataset.param;
      var inherited = parseFloat(inp.dataset.inherited);
      var current   = parseFloat(inp.value);
      if (!isNaN(current) && (isNaN(inherited) || current !== inherited)) {
        if (!rules.method_overrides[method]) rules.method_overrides[method] = {};
        rules.method_overrides[method][param] = current;
      }
    });
    return rules;
  }

  function prepareSubmit() {
    var rules = buildRulesFromForm();
    document.getElementById('rules_json').value = JSON.stringify(rules, null, 2);
    return true;
  }

  function applyJson() {
    try {
      var parsed = JSON.parse(document.getElementById('rawJson').value);
      document.getElementById('rules_json').value = JSON.stringify(parsed, null, 2);
      document.getElementById('rulesForm').submit();
    } catch(e) { alert('Invalid JSON: ' + e.message); }
  }

  function addMethodTab() {
    var label = prompt('New method label (e.g. "EPA 533"):');
    if (!label) return;
    var mid = label.replace(/[^a-zA-Z0-9]/g, '_');
    if (document.getElementById('mtab-' + mid)) {
      alert('A tab for "' + label + '" already exists.');
      return;
    }
    // Create tab
    var tab = document.createElement('div');
    tab.className = 'method-tab';
    tab.id = 'mtab-' + mid;
    tab.textContent = label;
    tab.onclick = function() { selectMethod(mid); };
    var bar = document.getElementById('methodTabBar');
    bar.insertBefore(tab, bar.querySelector('.method-tab-add'));
    // Create panel with empty placeholder
    var panel = document.createElement('div');
    panel.className = 'method-panel';
    panel.id = 'mpanel-' + mid;
    panel.innerHTML = '<p style="color:var(--s-secondary);font-size:13px;padding:12px 0;">' +
      'No rule parameters defined for this method yet. ' +
      'Add global rule parameters first, then overrides will appear here on next save.' +
      '</p>';
    bar.parentNode.appendChild(panel);
    selectMethod(mid);
  }

  function resetDefaults() {
    document.getElementById('rules_json').value =
      '{"version":1,"global":{},"qc_types":{},"method_rule_toggles":{},"method_overrides":{}}';
    document.getElementById('rulesForm').submit();
  }

  /* ── Context menu ───────────────────────────────────────────────────── */
  var _ctxMenu = document.getElementById('pfas-ctx-menu');

  function showCtxMenu(x, y, sections) {
    _ctxMenu.innerHTML = '';
    sections.forEach(function(section) {
      if (section.label) {
        var lbl = document.createElement('span');
        lbl.className = 'ctx-label';
        lbl.textContent = section.label;
        _ctxMenu.appendChild(lbl);
      }
      (section.items || []).forEach(function(item) {
        if (item === '-') {
          var sep = document.createElement('div'); sep.className = 'ctx-sep';
          _ctxMenu.appendChild(sep);
          return;
        }
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ctx-item' + (item.danger ? ' danger' : '');
        btn.textContent = item.label;
        btn.onclick = function() { hideCtxMenu(); item.action(); };
        _ctxMenu.appendChild(btn);
      });
    });
    _ctxMenu.style.left = x + 'px';
    _ctxMenu.style.top  = y + 'px';
    _ctxMenu.style.display = 'block';
    // Keep in viewport
    var r = _ctxMenu.getBoundingClientRect();
    if (r.right  > window.innerWidth)  _ctxMenu.style.left = (x - r.width)  + 'px';
    if (r.bottom > window.innerHeight) _ctxMenu.style.top  = (y - r.height) + 'px';
  }

  function hideCtxMenu() { _ctxMenu.style.display = 'none'; }

  document.addEventListener('click',       hideCtxMenu);
  document.addEventListener('contextmenu', function(e) {
    // Close any open menu before opening a new one — individual handlers call showCtxMenu
    hideCtxMenu();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') hideCtxMenu();
  });

  /* Helpers */
  function setAllRules(methodId, enabled) {
    document.querySelectorAll('.toggle-cb[data-method="' + methodId + '"]').forEach(function(cb) {
      cb.checked = enabled;
      updateRuleVisibility(methodId, cb.dataset.rule, enabled);
    });
  }

  function resetRuleParams(methodId, ruleKey) {
    var panel = document.getElementById('mpanel-' + methodId);
    if (!panel) return;
    panel.querySelectorAll('.limit-rule-group[data-rule-key="' + ruleKey + '"] .override-input')
      .forEach(function(inp) {
        inp.value = inp.dataset.inherited;
        inp.classList.remove('is-overridden');
      });
  }

  function duplicateRuleParams(srcMethod, ruleKey) {
    var targets = [];
    document.querySelectorAll('.method-tab').forEach(function(t) {
      var mid = t.id.replace('mtab-', '');
      if (mid !== srcMethod) targets.push({ id: mid, label: t.textContent.trim() });
    });
    if (!targets.length) { alert('No other method tabs exist to copy to.'); return; }
    var opts = targets.map(function(t, i) { return (i + 1) + '. ' + t.label + ' (' + t.id + ')'; }).join('\n');
    var ans = prompt('Copy "' + ruleKey + '" params to which method?\n\n' + opts + '\n\nEnter the method ID:');
    if (!ans) return;
    var srcPanel = document.getElementById('mpanel-' + srcMethod);
    if (!srcPanel) return;
    var srcVals = {};
    srcPanel.querySelectorAll('.limit-rule-group[data-rule-key="' + ruleKey + '"] .override-input')
      .forEach(function(inp) { srcVals[inp.dataset.param] = inp.value; });
    var tgtPanel = document.getElementById('mpanel-' + ans.trim());
    if (!tgtPanel) { alert('Method "' + ans.trim() + '" not found.'); return; }
    tgtPanel.querySelectorAll('.limit-rule-group[data-rule-key="' + ruleKey + '"] .override-input')
      .forEach(function(inp) {
        if (srcVals[inp.dataset.param] !== undefined) {
          inp.value = srcVals[inp.dataset.param];
          markOverridden(inp);
        }
      });
  }

  /* Bind right-click handlers after DOM is ready */
  document.addEventListener('DOMContentLoaded', function() {

    /* Method tab bar — right-click on a tab */
    var bar = document.getElementById('methodTabBar');
    if (bar) {
      bar.addEventListener('contextmenu', function(e) {
        var tab = e.target.closest('.method-tab:not(.method-tab-add)');
        if (!tab) return;
        e.preventDefault();
        e.stopPropagation();
        var methodId = tab.id.replace('mtab-', '');
        var methodLabel = tab.textContent.trim();
        showCtxMenu(e.clientX, e.clientY, [{
          label: methodLabel,
          items: [
            { label: 'Enable all rules for this method',  action: function() { setAllRules(methodId, true);  } },
            { label: 'Disable all rules for this method', action: function() { setAllRules(methodId, false); } },
          ]
        }]);
      });
    }

    /* Method panels — right-click on rule groups or override inputs */
    document.querySelectorAll('.method-panel').forEach(function(panel) {
      panel.addEventListener('contextmenu', function(e) {
        var methodId = panel.id.replace('mpanel-', '');

        /* Right-click on an override input (most specific target first) */
        var inp = e.target.closest('.override-input');
        if (inp) {
          e.preventDefault();
          e.stopPropagation();
          showCtxMenu(e.clientX, e.clientY, [{
            items: [
              { label: 'Clear override — revert to inherited (' + inp.dataset.inherited + ')',
                action: function() {
                  inp.value = inp.dataset.inherited;
                  inp.classList.remove('is-overridden');
                }
              }
            ]
          }]);
          return;
        }

        /* Right-click on a rule group */
        var grp = e.target.closest('.limit-rule-group[data-rule-key]');
        if (grp) {
          e.preventDefault();
          e.stopPropagation();
          var ruleKey = grp.dataset.ruleKey;
          var ruleLabel = (grp.querySelector('.limit-rule-title') || {}).textContent || ruleKey;
          var cb = document.querySelector('.toggle-cb[data-method="' + methodId + '"][data-rule="' + ruleKey + '"]');
          var enabled = cb ? cb.checked : true;
          showCtxMenu(e.clientX, e.clientY, [{
            label: ruleLabel.trim(),
            items: [
              { label: (enabled ? 'Disable' : 'Enable') + ' rule for this method',
                action: function() {
                  if (cb) { cb.checked = !enabled; updateRuleVisibility(methodId, ruleKey, !enabled); }
                }
              },
              '-',
              { label: 'Reset all params to global default',
                action: function() { resetRuleParams(methodId, ruleKey); }
              },
              { label: 'Duplicate params to another method',
                action: function() { duplicateRuleParams(methodId, ruleKey); }
              },
            ]
          }]);
        }
      });
    });

  }); /* end DOMContentLoaded */
  </script>

  </div><!-- /content slot -->

  <tal:ab metal:fill-slot="action-bar">
    <div class="pfas-action-bar">
      <button type="submit" form="rulesForm" class="btn btn-primary"
              onclick="return prepareSubmit()">Save Rules</button>
      <button type="button" class="btn btn-secondary"
              onclick="if(confirm('Reset to factory defaults?')) resetDefaults()">
        Reset to Defaults
      </button>
      <span class="path-info">
        Saved to <code tal:content="view/rules_path">/data/qc/qc_rules.json</code>
      </span>
    </div>
  </tal:ab>
</body>
</html>
