<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="here/main_template/macros/master">

<metal:content-core fill-slot="content-core"
                    tal:define="info view/stage_info">

  <style>
    .pfas-stage-card {
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 6px;
      padding: 20px 24px;
      max-width: 600px;
      margin: 16px 0;
    }
    .pfas-stage-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 16px;
    }
    .pfas-stage-label {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .05em;
      padding: 3px 10px;
      border-radius: 10px;
    }
    .pfas-stage-1 { background: #e3f2fd; color: #1565c0; }
    .pfas-stage-2 { background: #fff8e1; color: #f57f17; }
    .pfas-stage-3 { background: #fce4ec; color: #880e4f; }
    .pfas-stage-4 { background: #f3e5f5; color: #6a1b9a; }
    .pfas-stage-5 { background: #e8f5e9; color: #1b5e20; }
    .pfas-stage-meta {
      font-size: 13px;
      color: #546e7a;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .pfas-stage-meta span { color: #212121; font-weight: 600; }
    .pfas-link {
      margin-top: 14px;
    }
    .pfas-link a {
      font-size: 12px;
      color: #1565c0;
    }
  </style>

  <div class="pfas-stage-card">
    <div class="pfas-stage-header">
      <i class="fas fa-layer-group" style="font-size:20px;color:#1a237e;"></i>
      <strong style="font-size:15px;">PFAS Batch Stage</strong>
      <span tal:attributes="class string:pfas-stage-label pfas-stage-${info/stage}"
            tal:content="info/stage_label">Received</span>
    </div>

    <div class="pfas-stage-meta">
      <div tal:condition="info/responsible">
        Responsible: <span tal:content="info/responsible">—</span>
      </div>
      <div>
        Workflow state: <span tal:content="info/ws_state">open</span>
      </div>
    </div>

    <div class="pfas-link">
      <a tal:attributes="href string:${view/portal_url}/@@pfas-sample-status">
        &#8592; All batches (Batch Status page)
      </a>
    </div>
  </div>

</metal:content-core>
</html>
