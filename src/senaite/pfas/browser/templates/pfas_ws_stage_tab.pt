<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="here/main_template/macros/master">

<metal:content-core fill-slot="content-core"
                    tal:define="info view/stage_info">

  <div class="pfas-card pfas-card-narrow">
    <div class="pfas-card-head">
      <strong>Worksheet stage</strong>
      <span class="pfas-stage-now" tal:condition="info/stage_icon|nothing" tal:define="ic context/@@pfas-icons"><tal:m
            tal:replace="structure python:ic.svg(info['stage_icon'], hidden=True, state='now', size='md')" /><span
            tal:content="info/stage_label">Received</span></span>
    </div>

    <div class="pfas-meta-row pfas-muted">
      <div tal:condition="info/responsible">
        Responsible: <strong tal:content="info/responsible">&#8212;</strong>
      </div>
      <div>
        Worksheet state: <strong tal:content="info/ws_state">Open</strong>
      </div>
    </div>

    <div class="pfas-mt">
      <a class="btn btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-sample-status">Worksheet status</a>
    </div>
  </div>

</metal:content-core>
</html>
