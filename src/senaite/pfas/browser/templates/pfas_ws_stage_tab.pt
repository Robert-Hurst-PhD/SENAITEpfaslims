<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="here/main_template/macros/master">

<metal:content-core fill-slot="content-core"
                    tal:define="info view/stage_info">

  <div class="pfas-card pfas-card-narrow">
    <div class="pfas-card-head">
      <span><i class="fas fa-layer-group pfas-text-accent"></i>
        <strong>PFAS Batch Stage</strong></span>
      <span tal:attributes="class python:'badge badge-ok' if info['stage'] == 5 else ('badge badge-info' if info['stage'] in (2, 3, 4) else 'badge badge-pending')"
            tal:content="info/stage_label">Received</span>
    </div>

    <div class="pfas-meta-row pfas-muted">
      <div tal:condition="info/responsible">
        Responsible: <strong tal:content="info/responsible">&#8212;</strong>
      </div>
      <div>
        Workflow state: <strong tal:content="info/ws_state">open</strong>
      </div>
    </div>

    <div class="pfas-mt">
      <a class="btn btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-sample-status">All batches (Batch Status page)</a>
    </div>
  </div>

</metal:content-core>
</html>
