<tal:panel xmlns:tal="http://xml.zope.org/namespaces/tal">
  <style>
    .pfas-mlink { margin:10px 0 16px; border:1px solid var(--s-border);
      border-left:4px solid var(--s-primary); border-radius:8px; background:var(--s-primary-lt);
      padding:12px 16px; display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
    .pfas-mlink-main { flex:1; min-width:220px; }
    .pfas-mlink-label { font-size:var(--fs-xs); font-weight:700; letter-spacing:.05em;
      text-transform:uppercase; color:var(--s-secondary); }
    .pfas-mlink-title { font-size:var(--fs-md); font-weight:700; color:var(--s-body); margin-top:2px; }
    .pfas-mlink-id { font-family: var(--font-mono); font-size:var(--fs-xs); color: var(--s-primary-dk); background:#fff;
      border:1px solid var(--s-border); padding:1px 6px; border-radius:3px; margin-left:6px; }
    .pfas-mlink-meta { font-size:var(--fs-sm); color:var(--s-secondary); margin-top:3px; }
    .pfas-mlink-btn { background:var(--s-primary-dk); color:#fff; text-decoration:none; font-weight:600;
      font-size:var(--fs-base); padding:8px 16px; border-radius:5px; white-space:nowrap; }
    .pfas-mlink-btn:hover { background:var(--s-primary-xdk); color:#fff; text-decoration:none; }
  </style>
  <div class="pfas-mlink">
    <div class="pfas-mlink-main">
      <div class="pfas-mlink-label">PFAS Method Profile</div>
      <div class="pfas-mlink-title">
        <span tal:content="view/profile_title">FDA 32-PFAS in Food</span>
        <span class="pfas-mlink-id" tal:content="view/profile_id">FDA_32PFAS</span>
      </div>
      <div class="pfas-mlink-meta">
        Governs <strong tal:content="view/n_services">32</strong> analytes ·
        <strong tal:content="view/n_sampletypes">6</strong> matrices ·
        QC recovery tiers &amp; per-analyte tolerances
      </div>
    </div>
    <a class="pfas-mlink-btn" tal:attributes="href view/edit_url">Configure QC ranges &#8594;</a>
  </div>
</tal:panel>
