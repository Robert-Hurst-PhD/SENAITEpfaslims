<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Client Tracker</title>
  <tal:styles metal:fill-slot="head-extra">
  <link rel="stylesheet" type="text/css"
        tal:attributes="href string:${context/portal_url}/++resource++senaite.pfas/pfas-tracker.css?v=${context/@@pfas-macros/asset_version}" />
  </tal:styles>
</head>
<body>
  <!-- Staff only: one search for a tracking number, a sample ID or a CoC
       number. A client and a signed-out visitor get the standalone page,
       tracker_public.pt. -->
  <tal:t metal:fill-slot="header-title">Client Tracker</tal:t>
  <tal:r metal:fill-slot="header-context">
    <span class="header-meta">Track your sample through the laboratory</span>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body is-staff">
    <div class="search-card">
      <h2>Find a sample</h2>
      <form method="get" action="">
        <div class="search-row">
          <input class="search-input" type="search" name="q" autocomplete="off"
                 aria-label="Tracking number, sample ID or CoC number"
                 placeholder="Tracking number, sample ID or CoC number" />
          <button class="search-btn" type="submit">Find</button>
        </div>
      </form>
    </div>
  </div>
  </div><!-- /content slot -->
</body>
</html>
