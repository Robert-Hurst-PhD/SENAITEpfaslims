<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">FM-ENV-251: Calibration Curve Prep Log</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
    .lb-form { max-width: 860px; }
    .lb-section { margin-bottom: 28px; }
    .lb-section h3 { font-size: 14px; font-weight: 700; color: var(--s-dark);
                     margin-bottom: 12px; padding-bottom: 6px;
                     border-bottom: 2px solid var(--s-border); }
    .lb-row { display: flex; gap: 16px; margin-bottom: 12px; flex-wrap: wrap; }
    .lb-field { display: flex; flex-direction: column; }
    .lb-field label { font-size: 12px; font-weight: 600; color: var(--s-dark); margin-bottom: 3px; }
    .lb-input, .lb-select { padding: 7px 10px; font-size: 13px;
                              border: 1px solid var(--s-input-border); border-radius: 6px; }
    .lb-input:focus, .lb-select:focus { outline: none; border-color: var(--s-primary); }
    .lb-input-sm { width: 100px; }
    .lb-input-md { width: 180px; }
    .lb-input-lg { width: 260px; }
    .lb-lot { width: 200px; }
    /* Cal table */
    .cal-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .cal-table th { background: #f8f9fa; padding: 7px 10px; text-align: left;
                    border-bottom: 2px solid var(--s-border); font-weight: 700; }
    .cal-table td { padding: 5px 8px; border-bottom: 1px solid var(--s-border); }
    .cal-table td:first-child { font-weight: 600; color: var(--s-dark); }
    .cal-table td input[type="number"] { width: 110px; padding: 4px 8px; font-size: 12px;
                                          border: 1px solid var(--s-input-border); border-radius: 4px; }
    .cal-table td input[type="text"]   { width: 160px; padding: 4px 8px; font-size: 12px;
                                          border: 1px solid var(--s-input-border); border-radius: 4px; }
    /* PDS section */
    .pds-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
    /* Actions */
    .form-actions { margin-top: 28px; padding-top: 16px; border-top: 1px solid var(--s-border);
                    display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
    .btn-save { padding: 9px 24px; background: var(--s-primary); color: #fff;
                border: none; border-radius: 7px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .btn-save:hover { background: var(--s-primary-dk); }
    .btn-dl { padding: 9px 18px; background: #28a745; color: #fff;
              border: none; border-radius: 7px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .btn-dl:hover { background: #1e7e34; }
    .sig-block { display: flex; gap: 40px; flex-wrap: wrap; margin-top: 8px; }
    .sig-field { display: flex; flex-direction: column; }
    .sig-field label { font-size: 12px; font-weight: 600; margin-bottom: 3px; }
    .alert-ok    { background: #d4edda; border: 1px solid #c3e6cb; color: #155724;
                   padding: 10px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 13px; }
    .alert-error { background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24;
                   padding: 10px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 13px; }
    .inj-builder-note {
      background: #d1ecf1; border: 1px solid #bee5eb; color: #0c5460;
      padding: 10px 16px; border-radius: 8px; font-size: 12px; margin-top: 8px;
    }
  </style>
  </tal:styles>
</head>
<body>
  <tal:t metal:fill-slot="header-title">FM-ENV-251: Calibration Curve Prep Log</tal:t>
  <tal:r metal:fill-slot="header-right">
    <a class="header-meta"
       tal:attributes="href string:${view/batch_url}/@@pfas-logbook-index">
      &#8592; All Logbooks
    </a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <!-- Breadcrumb -->
    <div class="lb-breadcrumb">
      <a tal:attributes="href view/portal_url">Lab</a>
      <span class="lb-bc-sep">›</span>
      <tal:m tal:condition="view/batch_method">
        <span tal:content="view/batch_method">Method</span>
        <span class="lb-bc-sep">›</span>
      </tal:m>
      <a tal:attributes="href string:${view/batch_url}/@@pfas-logbook-index"
         tal:content="view/batch_title">Batch</a>
      <span class="lb-bc-sep">›</span>
      <strong>FM-ENV-251</strong>
    </div>

    <div class="alert-ok"    tal:condition="view/ok_msg"    tal:content="view/ok_msg"></div>
    <div class="alert-error" tal:condition="view/error_msg" tal:content="view/error_msg"></div>

    <form class="lb-form" method="post"
          tal:attributes="action string:${view/batch_url}/@@pfas-logbook-251">
      <input type="hidden" id="cal_points_json" name="cal_points_json" value="[]" />

      <!-- Header -->
      <div class="lb-section">
        <h3>Preparation Details</h3>
        <div class="lb-row">
          <div class="lb-field">
            <label>Method</label>
            <select name="method" class="lb-select lb-input-lg">
              <tal:opts tal:repeat="mid python:['FDA_32PFAS', 'EPA_537_1', 'EPA_1633A']">
                <option tal:attributes="value mid;
                                        selected python:view.data().get('method','FDA_32PFAS') == mid"
                        tal:content="mid">Method</option>
              </tal:opts>
            </select>
          </div>
          <div class="lb-field corr-field" data-field="prepared_by">
            <label>Prepared By <button class="btn-correct" type="button" onclick="toggleCorrect('prepared_by')">correct</button></label>
            <input class="lb-input lb-input-lg" type="text" name="prepared_by"
                   tal:attributes="value python:view.data().get('prepared_by','')" />
            <div class="corr-panel" id="cp-prepared_by">
              <label>Original: <span id="co-prepared_by" style="text-decoration:line-through;color:#999;font-weight:normal;"></span></label>
              <label>Correction: <input type="text" id="cn-prepared_by" name="_newval_prepared_by" style="width:160px;" /></label>
              <label>Initials: <input type="text" id="cb-prepared_by" name="_corr_by_prepared_by" class="corr-initials" placeholder="JS" /></label>
              <button type="button" class="corr-cancel" onclick="toggleCorrect('prepared_by')">&#215;</button>
            </div>
          </div>
          <div class="lb-field corr-field" data-field="prepared_date">
            <label>Date Prepared <button class="btn-correct" type="button" onclick="toggleCorrect('prepared_date')">correct</button></label>
            <input class="lb-input lb-input-md" type="date" name="prepared_date"
                   tal:attributes="value python:view.data().get('prepared_date','')" />
            <div class="corr-panel" id="cp-prepared_date">
              <label>Original: <span id="co-prepared_date" style="text-decoration:line-through;color:#999;font-weight:normal;"></span></label>
              <label>Correction: <input type="date" id="cn-prepared_date" name="_newval_prepared_date" /></label>
              <label>Initials: <input type="text" id="cb-prepared_date" name="_corr_by_prepared_date" class="corr-initials" placeholder="JS" /></label>
              <button type="button" class="corr-cancel" onclick="toggleCorrect('prepared_date')">&#215;</button>
            </div>
          </div>
        </div>
      </div>

      <!-- PDS / Standard Lots -->
      <div class="lb-section">
        <h3>Standard Solutions — Lot Numbers</h3>
        <div class="pds-grid">
          <div class="lb-field corr-field" data-field="pds_a_lot">
            <label>IS/SUR PDS-A Lot # <button class="btn-correct" type="button" onclick="toggleCorrect('pds_a_lot')">correct</button></label>
            <input class="lb-input lb-lot" type="text" name="pds_a_lot"
                   tal:attributes="value python:view.data().get('pds_a_lot','')" />
            <div class="corr-panel" id="cp-pds_a_lot">
              <label>Original: <span id="co-pds_a_lot" style="text-decoration:line-through;color:#999;font-weight:normal;"></span></label>
              <label>Correction: <input type="text" id="cn-pds_a_lot" name="_newval_pds_a_lot" style="width:120px;" /></label>
              <label>Initials: <input type="text" id="cb-pds_a_lot" name="_corr_by_pds_a_lot" class="corr-initials" placeholder="JS" /></label>
              <button type="button" class="corr-cancel" onclick="toggleCorrect('pds_a_lot')">&#215;</button>
            </div>
          </div>
          <div class="lb-field corr-field" data-field="pds_b_lot">
            <label>IS/SUR PDS-B Lot # <button class="btn-correct" type="button" onclick="toggleCorrect('pds_b_lot')">correct</button></label>
            <input class="lb-input lb-lot" type="text" name="pds_b_lot"
                   tal:attributes="value python:view.data().get('pds_b_lot','')" />
            <div class="corr-panel" id="cp-pds_b_lot">
              <label>Original: <span id="co-pds_b_lot" style="text-decoration:line-through;color:#999;font-weight:normal;"></span></label>
              <label>Correction: <input type="text" id="cn-pds_b_lot" name="_newval_pds_b_lot" style="width:120px;" /></label>
              <label>Initials: <input type="text" id="cb-pds_b_lot" name="_corr_by_pds_b_lot" class="corr-initials" placeholder="JS" /></label>
              <button type="button" class="corr-cancel" onclick="toggleCorrect('pds_b_lot')">&#215;</button>
            </div>
          </div>
          <div class="lb-field corr-field" data-field="analyte_pds_lot">
            <label>Analyte PDS Lot # <button class="btn-correct" type="button" onclick="toggleCorrect('analyte_pds_lot')">correct</button></label>
            <input class="lb-input lb-lot" type="text" name="analyte_pds_lot"
                   tal:attributes="value python:view.data().get('analyte_pds_lot','')" />
            <div class="corr-panel" id="cp-analyte_pds_lot">
              <label>Original: <span id="co-analyte_pds_lot" style="text-decoration:line-through;color:#999;font-weight:normal;"></span></label>
              <label>Correction: <input type="text" id="cn-analyte_pds_lot" name="_newval_analyte_pds_lot" style="width:120px;" /></label>
              <label>Initials: <input type="text" id="cb-analyte_pds_lot" name="_corr_by_analyte_pds_lot" class="corr-initials" placeholder="JS" /></label>
              <button type="button" class="corr-cancel" onclick="toggleCorrect('analyte_pds_lot')">&#215;</button>
            </div>
          </div>
          <div class="lb-field corr-field" data-field="analyte_spike_lot">
            <label>Analyte Spike Lot # <button class="btn-correct" type="button" onclick="toggleCorrect('analyte_spike_lot')">correct</button></label>
            <input class="lb-input lb-lot" type="text" name="analyte_spike_lot"
                   tal:attributes="value python:view.data().get('analyte_spike_lot','')" />
            <div class="corr-panel" id="cp-analyte_spike_lot">
              <label>Original: <span id="co-analyte_spike_lot" style="text-decoration:line-through;color:#999;font-weight:normal;"></span></label>
              <label>Correction: <input type="text" id="cn-analyte_spike_lot" name="_newval_analyte_spike_lot" style="width:120px;" /></label>
              <label>Initials: <input type="text" id="cb-analyte_spike_lot" name="_corr_by_analyte_spike_lot" class="corr-initials" placeholder="JS" /></label>
              <button type="button" class="corr-cancel" onclick="toggleCorrect('analyte_spike_lot')">&#215;</button>
            </div>
          </div>
          <div class="lb-field corr-field" data-field="cal_a_lot">
            <label>CAL-A Lot # <button class="btn-correct" type="button" onclick="toggleCorrect('cal_a_lot')">correct</button></label>
            <input class="lb-input lb-lot" type="text" name="cal_a_lot"
                   tal:attributes="value python:view.data().get('cal_a_lot','')" />
            <div class="corr-panel" id="cp-cal_a_lot">
              <label>Original: <span id="co-cal_a_lot" style="text-decoration:line-through;color:#999;font-weight:normal;"></span></label>
              <label>Correction: <input type="text" id="cn-cal_a_lot" name="_newval_cal_a_lot" style="width:120px;" /></label>
              <label>Initials: <input type="text" id="cb-cal_a_lot" name="_corr_by_cal_a_lot" class="corr-initials" placeholder="JS" /></label>
              <button type="button" class="corr-cancel" onclick="toggleCorrect('cal_a_lot')">&#215;</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Calibration Points -->
      <div class="lb-section">
        <h3>Calibration Ladder</h3>
        <p style="font-size:12px; color:var(--s-secondary); margin-bottom:8px;">
          Default concentrations follow the FDA 32-PFAS serial dilution
          (20 &#8594; 0.039 ng/mL).  Edit concentrations if your prep differs.
          This data is exported to the injection builder.
        </p>
        <table class="cal-table" id="cal-table">
          <thead>
            <tr>
              <th>Level</th>
              <th>Name</th>
              <th>Conc. (ng/mL)</th>
            </tr>
          </thead>
          <tbody id="cal-body"></tbody>
        </table>
      </div>

      <!-- CCV / ICV / Diluent -->
      <div class="lb-section">
        <h3>CCV / ICV / Diluent</h3>
        <div class="lb-row">
          <div class="lb-field corr-field" data-field="icv_conc_ng_ml">
            <label>ICV Concentration (ng/mL) <button class="btn-correct" type="button" onclick="toggleCorrect('icv_conc_ng_ml')">correct</button></label>
            <input class="lb-input lb-input-sm" type="number" step="0.001"
                   name="icv_conc_ng_ml"
                   tal:attributes="value python:view.data().get('icv_conc_ng_ml','1.25')" />
            <div class="corr-panel" id="cp-icv_conc_ng_ml">
              <label>Original: <span id="co-icv_conc_ng_ml" style="text-decoration:line-through;color:#999;font-weight:normal;"></span></label>
              <label>Correction: <input type="text" id="cn-icv_conc_ng_ml" name="_newval_icv_conc_ng_ml" style="width:80px;" /></label>
              <label>Initials: <input type="text" id="cb-icv_conc_ng_ml" name="_corr_by_icv_conc_ng_ml" class="corr-initials" placeholder="JS" /></label>
              <button type="button" class="corr-cancel" onclick="toggleCorrect('icv_conc_ng_ml')">&#215;</button>
            </div>
          </div>
          <div class="lb-field corr-field" data-field="ccv_conc_ng_ml">
            <label>CCV Concentration (ng/mL) <button class="btn-correct" type="button" onclick="toggleCorrect('ccv_conc_ng_ml')">correct</button></label>
            <input class="lb-input lb-input-sm" type="number" step="0.001"
                   name="ccv_conc_ng_ml"
                   tal:attributes="value python:view.data().get('ccv_conc_ng_ml','1.25')" />
            <div class="corr-panel" id="cp-ccv_conc_ng_ml">
              <label>Original: <span id="co-ccv_conc_ng_ml" style="text-decoration:line-through;color:#999;font-weight:normal;"></span></label>
              <label>Correction: <input type="text" id="cn-ccv_conc_ng_ml" name="_newval_ccv_conc_ng_ml" style="width:80px;" /></label>
              <label>Initials: <input type="text" id="cb-ccv_conc_ng_ml" name="_corr_by_ccv_conc_ng_ml" class="corr-initials" placeholder="JS" /></label>
              <button type="button" class="corr-cancel" onclick="toggleCorrect('ccv_conc_ng_ml')">&#215;</button>
            </div>
          </div>
          <div class="lb-field corr-field" data-field="diluent_is_conc">
            <label>Diluent IS/SUR Concentration (ng/mL) <button class="btn-correct" type="button" onclick="toggleCorrect('diluent_is_conc')">correct</button></label>
            <input class="lb-input lb-input-sm" type="number" step="0.001"
                   name="diluent_is_conc"
                   tal:attributes="value python:view.data().get('diluent_is_conc','1.0')" />
            <div class="corr-panel" id="cp-diluent_is_conc">
              <label>Original: <span id="co-diluent_is_conc" style="text-decoration:line-through;color:#999;font-weight:normal;"></span></label>
              <label>Correction: <input type="text" id="cn-diluent_is_conc" name="_newval_diluent_is_conc" style="width:80px;" /></label>
              <label>Initials: <input type="text" id="cb-diluent_is_conc" name="_corr_by_diluent_is_conc" class="corr-initials" placeholder="JS" /></label>
              <button type="button" class="corr-cancel" onclick="toggleCorrect('diluent_is_conc')">&#215;</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Notes -->
      <div class="lb-section">
        <h3>Notes</h3>
        <div class="corr-field" data-field="notes">
          <textarea name="notes" style="width:100%; min-height:60px; padding:8px; font-size:13px; border:1px solid var(--s-input-border); border-radius:6px;"
                    tal:content="python:view.data().get('notes','')"></textarea>
          <div style="margin-top:4px;">
            <button class="btn-correct" type="button" onclick="toggleCorrect('notes')">correct notes</button>
          </div>
          <div class="corr-panel" id="cp-notes">
            <label>Original: <span id="co-notes" style="text-decoration:line-through;color:#999;font-weight:normal;max-width:300px;display:inline-block;"></span></label>
            <label>Correction: <input type="text" id="cn-notes" name="_newval_notes" style="width:220px;" /></label>
            <label>Initials: <input type="text" id="cb-notes" name="_corr_by_notes" class="corr-initials" placeholder="JS" /></label>
            <button type="button" class="corr-cancel" onclick="toggleCorrect('notes')">&#215;</button>
          </div>
        </div>
      </div>

      <!-- Sign-off -->
      <div class="lb-section">
        <h3>Sign-off</h3>
        <div class="sig-block">
          <div class="sig-field corr-field" data-field="reviewed_by">
            <label>Reviewed By <button class="btn-correct" type="button" onclick="toggleCorrect('reviewed_by')">correct</button></label>
            <input class="lb-input lb-input-lg" type="text" name="reviewed_by"
                   tal:attributes="value python:view.data().get('reviewed_by','')" />
            <div class="corr-panel" id="cp-reviewed_by">
              <label>Original: <span id="co-reviewed_by" style="text-decoration:line-through;color:#999;font-weight:normal;"></span></label>
              <label>Correction: <input type="text" id="cn-reviewed_by" name="_newval_reviewed_by" style="width:160px;" /></label>
              <label>Initials: <input type="text" id="cb-reviewed_by" name="_corr_by_reviewed_by" class="corr-initials" placeholder="JS" /></label>
              <button type="button" class="corr-cancel" onclick="toggleCorrect('reviewed_by')">&#215;</button>
            </div>
          </div>
          <div class="sig-field corr-field" data-field="reviewed_date">
            <label>Date Reviewed <button class="btn-correct" type="button" onclick="toggleCorrect('reviewed_date')">correct</button></label>
            <input class="lb-input lb-input-md" type="date" name="reviewed_date"
                   tal:attributes="value python:view.data().get('reviewed_date','')" />
            <div class="corr-panel" id="cp-reviewed_date">
              <label>Original: <span id="co-reviewed_date" style="text-decoration:line-through;color:#999;font-weight:normal;"></span></label>
              <label>Correction: <input type="date" id="cn-reviewed_date" name="_newval_reviewed_date" /></label>
              <label>Initials: <input type="text" id="cb-reviewed_date" name="_corr_by_reviewed_date" class="corr-initials" placeholder="JS" /></label>
              <button type="button" class="corr-cancel" onclick="toggleCorrect('reviewed_date')">&#215;</button>
            </div>
          </div>
        </div>
      </div>

      <tal:signoff tal:define="signoff_noun string:standard;
                    signoff_prepared_name python:view.data().get('prepared_by','');
                    signoff_prepared_date python:view.data().get('prepared_date','');
                    signoff_prepared_initials python:view.data().get('prepared_by','')">
        <tal:m metal:use-macro="context/@@pfas-macros/macros/signoff"/>
      </tal:signoff>

      <div class="form-actions">
        <button class="btn-save" type="submit">Save Logbook</button>
        <button class="btn-dl" type="submit" name="action" value="download_csv">
          &#8595; Download Cal Ladder CSV
        </button>
        <button type="button" class="btn-print-preview" onclick="window.print()">
          &#128438; Print Preview
        </button>
      </div>
    </form>

    <div class="inj-builder-note" tal:condition="view/ok_msg">
      <strong>Injection Builder:</strong> Cal data has been exported to
      <code>/data/qc/batches/</code>.  Run
      <code>pfas-pipeline build-sequence --batch-id <tal:bid tal:replace="view/batch_id" /></code>
      to generate the full autosampler injection sequence.
    </div>

  </div>

  <script>
  var SAVED_DATA = <tal:d tal:replace="structure view/data_json" />;
  var DEFAULTS = <tal:dd tal:replace="structure view/default_cal_points_json" />;

  var calData = (SAVED_DATA.cal_points && SAVED_DATA.cal_points.length)
                ? SAVED_DATA.cal_points
                : DEFAULTS;

  function renderCal() {
    var tbody = document.getElementById('cal-body');
    tbody.innerHTML = '';
    calData.forEach(function(row, i) {
      var tr = document.createElement('tr');
      tr.innerHTML =
        '\u003ctd>' + esc(row.level||'') + '\u003c/td>' +
        '\u003ctd>\u003cinput type="text" value="' + esc(row.name||'') + '" oninput="calData['+i+'].name=this.value;syncCal()"/>\u003c/td>' +
        '\u003ctd>\u003cinput type="number" step="0.0001" value="' + esc(row.conc_ng_ml||'') + '" oninput="calData['+i+'].conc_ng_ml=parseFloat(this.value);syncCal()"/>\u003c/td>';
      tbody.appendChild(tr);
    });
    syncCal();
  }

  function syncCal() {
    document.getElementById('cal_points_json').value = JSON.stringify(calData);
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/\u003c/g,'&lt;');
  }

  document.addEventListener('DOMContentLoaded', function() {
    renderCal();
    initCorrections(SAVED_DATA);
  });
  </script>
  </div><!-- /content slot -->
</body>
</html>
