<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Prepared Standards</title>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Prepared Standards</tal:t>
  <tal:r metal:fill-slot="header-right">
    <button type="button" class="btn-sm btn-primary" onclick="pfasOpenNew()">+ New Prepared Standard</button>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <!-- with a lot's record open, its card shows the message -->
    <tal:m condition="not:view/record">
    <div class="alert alert-success" tal:condition="view/ok_msg"    tal:content="view/ok_msg"></div>
    <div class="alert alert-error"   tal:condition="view/error_msg" tal:content="view/error_msg"></div>
    </tal:m>

    <!-- Filters: one bar, applies on change -->
    <form method="GET" class="pfas-filterbar" id="ps-filters" data-autosubmit="data-autosubmit"
          tal:attributes="action string:${context/absolute_url}/@@pfas-prep-standards">
      <div class="pfas-form-field">
        <label for="ps-q">Search</label>
        <input type="text" id="ps-q" name="q" class="pfas-input pfas-input-wide"
               placeholder="Name, lot, record..."
               tal:attributes="value python:request.form.get('q','')" />
      </div>
      <div class="pfas-form-field">
        <label for="ps-status">Status</label>
        <select id="ps-status" name="status" class="pfas-select">
          <option value="all"       tal:attributes="selected python:'selected' if not view.status_filter() else None">All statuses</option>
          <option tal:repeat="s view/statuses" tal:attributes="value python:s[0]; selected python:view.status_filter()==s[0]"
                  tal:content="python:s[1]">Active</option>
        </select>
      </div>
      <div class="pfas-form-field">
        <label for="ps-type">Type</label>
        <select id="ps-type" name="type" class="pfas-select">
          <option value="">&#8212; All Types &#8212;</option>
          <tal:opts tal:repeat="t view/standard_types">
            <option tal:content="python:t[1]" tal:attributes="value python:t[0]; selected python:request.form.get('type')==t[0]">type</option>
          </tal:opts>
        </select>
      </div>
      <noscript><button type="submit" class="btn btn-primary">Apply</button></noscript>
      <span class="pfas-filterbar-spacer"></span>
    </form>

    <tal:stds tal:define="stds view/prepared_standards">

      <div class="pfas-empty" tal:condition="not:stds">
        <p class="pfas-empty-glyph"><svg class="pfas-ico" aria-hidden="true"><use href="#ico-prep-standards"/></svg></p>
        <p>No prepared standards recorded yet.</p>
        <button type="button" class="btn btn-primary" onclick="pfasOpenNew()">
          Record First Standard
        </button>
      </div>

      <div class="table-wrap" tal:condition="stds">
        <table class="pfas-table pfas-table-fixed" data-col-resize="prep-standards-1" tal:define="rm context/@@pfas-row-menu">
          <thead>
            <tr>
              <th class="pfas-col-name">Name / Lot</th>
              <th class="pfas-col-text">Type</th>
              <th class="pfas-col-text">Prep Logbook</th>
              <th class="pfas-col-text">Prepared By</th>
              <th class="pfas-col-date">Prepared Date</th>
              <th class="pfas-col-expiry">Expiry</th>
              <th class="pfas-col-status">Status</th>
            </tr>
          </thead>
          <tbody>
            <tal:rows tal:repeat="std stds">
              <!-- the row opens the lot's record (recipe, parentage, steps,
                   labels); every other action is in its menu, as on Reagent
                   Inventory. Edit is filled from the row's data-std -->
              <tr tal:define="std_json python:__import__('json').dumps(std).replace('&amp;', '\\u0026').replace('&lt;', '\\u003c').replace('&gt;', '\\u003e')"
                  tal:attributes="data-std std_json;
                                  data-row-open string:${view/portal_url}/@@pfas-prep-standards?record=${std/uid};
                                  data-row-actions python:rm.actions(
                                      (u'Edit', 'event', 'ps-edit'),
                                      (u'Usage', 'href', u'%s/@@pfas-lot-usage?kind=prepared_standard&amp;uid=%s' % (context.absolute_url(), std['uid'])),
                                      (u'Certificate', 'href', u'%s/@@pfas-prep-standards?action=cert&amp;uid=%s' % (context.absolute_url(), std['uid']), {'blank': True}),
                                      (u'Print label', 'href', view.label_url(std), {'blank': True}),
                                      (u'Request extension', 'href', u'%s/@@pfas-lot-extensions?lot=%s' % (view.portal_url(), std['uid'])),
                                      (u'Mark emptied', 'form', u'ps-status-%s' % std['uid'], {'confirm': u'Mark this lot as emptied? It will no longer be offered in the lot pickers.', 'off': None if std.get('status') == 'active' else u'Only an active lot can be marked emptied, this one is %s' % std.get('status')}) if std.get('status') != 'exhausted' else None,
                                      (u'Reactivate', 'form', u'ps-status-%s' % std['uid'], {'note': u'Offer this lot in the lot pickers again'}) if std.get('status') == 'exhausted' else None)">
                <td>
                  <strong tal:content="std/lot_number">LOT</strong>
                  <div class="pfas-sub" tal:content="std/title">Name</div>
                </td>
                <td class="pfas-muted" tal:content="std/standard_type">—</td>
                <td>
                  <span class="pfas-mono" tal:condition="std/entry_id" tal:content="std/entry_id">PDS-A-261105-01</span>
                  <span class="pfas-muted" tal:condition="python:std['logbook_slug'] and not std['entry_id']">
                    <tal:x tal:replace="std/logbook_title">Logbook</tal:x>
                    rev <tal:x tal:replace="std/logbook_revision">1</tal:x>
                  </span>
                </td>
                <td tal:content="std/prepared_by">—</td>
                <td class="cell-nowrap" tal:content="std/prepared_date">—</td>
                <td tal:attributes="class python:'cell-nowrap ' + view.expiry_class(std)">
                  <span tal:content="std/effective_expiry|std/expiry_date">—</span>
                  <div class="pfas-sub exp-warning" tal:condition="std/expiry_inherited_from|nothing"
                       tal:attributes="title string:Tighter parent-lot expiry inherited from ${std/expiry_inherited_from}">
                    &#8675; inherited: <span tal:content="std/expiry_inherited_from">parent</span>
                  </div>
                </td>
                <!-- the next step each reason asks for: the row opens the
                     record; Request extension is in its menu -->
                <td tal:define="attn_label python:(std.get('status') or u'').capitalize();
                                attn_cls python:'badge badge-' + std['status'];
                                attn_reasons python:view.attention(std)">
                  <metal:a use-macro="context/@@pfas-macros/macros/status-attention" />
                </td>
              </tr>
            </tal:rows>
          </tbody>
        </table>
      </div>

      <!-- Emptied lots must leave the logbook lot picker; the row menu's
           Mark emptied / Reactivate sends this. -->
      <tal:sf repeat="std stds">
      <form method="POST" hidden="hidden"
            tal:attributes="action string:${view/portal_url}/@@pfas-prep-standards; id string:ps-status-${std/uid}">
        <input type="hidden" name="action" value="status" />
        <input type="hidden" name="uid" tal:attributes="value std/uid" />
        <input type="hidden" name="new_status"
               tal:attributes="value python:'active' if std.get('status') == 'exhausted' else 'exhausted'" />
        <button type="submit" class="btn-sm btn-secondary"
                tal:condition="python:std.get('status') != 'exhausted'"
                tal:attributes="disabled python:None if std.get('status') == 'active' else 'disabled'">Mark emptied</button>
        <button type="submit" class="btn-sm btn-secondary" tal:condition="python:std.get('status') == 'exhausted'">Reactivate</button>
      </form>
      </tal:sf>

    </tal:stds>

    <!-- ── Create/Edit modal ─────────────────────────────────────────── -->
    <div class="pfas-modal" id="psModal">
      <div class="pfas-modal-box is-wide">
        <h2 id="psModalTitle">Edit Prepared Standard</h2>

        <div data-tabs="data-tabs">
        <!-- Tab bar -->
        <div class="pfas-seg" id="ps-tabs">
          <button type="button" class="pfas-seg-item" data-pane="tabBasic" aria-selected="true">Details</button>
          <button type="button" class="pfas-seg-item" data-pane="tabParents" aria-selected="false">Parent Reagents</button>
          <button type="button" class="pfas-seg-item" data-pane="tabAnalytes" aria-selected="false">Analyte Concentrations</button>
        </div>

        <form method="POST"
              tal:attributes="action string:${view/portal_url}/@@pfas-prep-standards">
          <input type="hidden" name="action" value="edit" id="psFormAction" />
          <input type="hidden" name="uid" id="psUid" value="" />
          <input type="hidden" name="parent_reagents_json" id="parentJson" value="[]" />
          <input type="hidden" name="analyte_concentrations_json" id="analyteJson" value="[]" />

          <!-- Tab 1: Basic details -->
          <div class="pfas-pane is-active" id="tabBasic">
            <div class="pfas-form-row">
              <div class="pfas-form-field is-wide">
                <label>Standard name</label>
                <input type="text" name="title" id="psTitle" required
                       placeholder="e.g. Native Mix 100 ng/mL" />
              </div>
              <div class="pfas-form-field">
                <label>In-house lot #</label>
                <input type="text" name="lot_number" id="psLot" required
                       placeholder="2026-06-22-001" />
              </div>
            </div>
            <div class="pfas-form-row">
              <div class="pfas-form-field">
                <label>Standard type</label>
                <select name="standard_type" id="psType">
                  <option value="">— Select —</option>
                  <tal:opts tal:repeat="t view/standard_types">
                    <option tal:content="python:t[1]" tal:attributes="value python:t[0]">type</option>
                  </tal:opts>
                </select>
              </div>
            </div>
            <div class="pfas-form-row">
              <div class="pfas-form-field">
                <label>Prepared by</label>
                <input type="text" name="prepared_by" id="psPrepBy" />
              </div>
              <div class="pfas-form-field">
                <label>Date prepared</label>
                <input type="date" name="prepared_date" id="psPrepDate" />
              </div>
            </div>
            <div class="pfas-form-row">
              <div class="pfas-form-field">
                <label>Expiry date</label>
                <input type="date" name="expiry_date" id="psExpiry" />
              </div>
              <div class="pfas-form-field">
                <label>Volume / amount prepared</label>
                <input type="text" name="volume_prepared" id="psVol" placeholder="e.g. 10 mL" />
              </div>
              <div class="pfas-form-field">
                <label>Storage location</label>
                <!-- core Storage Locations (core_lists.py) -->
                <select name="storage_location" id="psStorage">
                  <option value="">Choose a location</option>
                  <option tal:repeat="s view/core_storage" tal:attributes="value s" tal:content="s">Location</option>
                </select>
              </div>
              <div class="pfas-form-field">
                <label for="psCond">Storage conditions</label>
                <input type="text" name="storage_conditions" id="psCond" required="required" />
              </div>
            </div>
            <!-- Equipment. A prepared standard's assigned value rests on a mass
                 and a volume, so under ISO 17025 §6.5 the balance and pipette that
                 measured them belong to its traceability. The certificate used to
                 print "equipment is not recorded against this lot" and point at the
                 logbook; now it names them and resolves each one's
                 calibration as of the PREPARED date. `equipment_posted` marks that
                 this form owns the field, so a form that does not post it cannot
                 wipe the record. -->
            <input type="hidden" name="equipment_posted" value="1" />
            <div class="pfas-form-row">
              <div class="pfas-form-field">
                <label>Balance used</label>
                <select name="equip_balance_unit_id" id="psBalance">
                  <option value="">&#8212; not recorded &#8212;</option>
                  <option tal:repeat="b view/facility_balances"
                          tal:attributes="value b/id"
                          tal:content="string:${b/name} (${b/serial_number})">Bal</option>
                </select>
                <span class="pfas-hint" tal:condition="not:view/facility_balances">
                  No balance registered under Equipment.
                </span>
              </div>
              <div class="pfas-form-field">
                <label>Pipette used</label>
                <select name="equip_pipette_unit_id" id="psPipette">
                  <option value="">&#8212; not recorded &#8212;</option>
                  <option tal:repeat="p view/facility_pipettes"
                          tal:attributes="value p/id"
                          tal:content="string:${p/name} (${p/serial_number})">Pip</option>
                </select>
              </div>
            </div>
            <div class="pfas-form-row">
              <div class="pfas-form-field is-full">
                <label>Notes</label>
                <textarea name="notes" id="psNotes" rows="2"></textarea>
              </div>
            </div>
          </div>

          <!-- Tab 2: Parent reagents (parentage) -->
          <div class="pfas-pane" id="tabParents">
            <p class="pfas-hint" id="parentsPinned" hidden="hidden">Recorded by its prep entry.</p>
            <div id="parentsEdit">
              <div class="pfas-suggest reagent-lookup">
                <input type="text" id="reagentSearch" class="pfas-input" placeholder="Search reagent inventory..."
                       oninput="lookupReagent(this.value)" autocomplete="off" />
                <div class="pfas-suggest-list" id="lookupResults"></div>
              </div>
              <table class="pfas-mini-table" data-col-resize="prep-standards-parentsTable" id="parentsTable">
                <thead>
                  <tr>
                    <th>Reagent Name</th><th>Supplier</th><th>Lot #</th>
                    <th>Qty Used</th><th>Unit</th><th></th>
                  </tr>
                </thead>
                <tbody id="parentsBody"></tbody>
              </table>
              <div class="pfas-form-field is-full">
                <label for="psEditExpiredReason">Reason for using a lot out of date</label>
                <textarea id="psEditExpiredReason" name="expired_reason" rows="2"></textarea>
                <span class="pfas-hint">Needed only for a parent added here that was out of date on the date prepared.</span>
              </div>
            </div>
          </div>

          <!-- Tab 3: Analyte concentrations: typed on a lot made before recipes;
               a lot made from its recipe has them calculated, never edited -->
          <div class="pfas-pane" id="tabAnalytes">
            <p class="pfas-hint" id="analytesPinned" hidden="hidden">Calculated from its recipe.</p>
            <div id="analytesEdit">
              <table class="pfas-mini-table" data-col-resize="prep-standards-analytesTable" id="analytesTable">
                <thead>
                  <tr><th>Analyte</th><th>Concentration</th><th>Unit</th><th></th></tr>
                </thead>
                <tbody id="analytesBody"></tbody>
              </table>
              <button type="button" class="btn-sm btn-secondary" onclick="addAnalyteRow()">+ Add Analyte</button>
            </div>
          </div>

          <div class="form-actions is-end">
            <button type="button" class="btn btn-secondary" onclick="closePsModal()">Cancel</button>
            <button type="submit" class="btn btn-primary" onclick="serializeAll()">Save &amp; Generate Certificate</button>
          </div>
        </form>
        </div>
      </div>
    </div>

    <!-- ── The lot record (?record=<uid>): recipe, parentage, steps, labels ── -->
    <tal:rec condition="view/record">
    <div class="pfas-modal open" id="psRecord" tal:define="r view/record">
      <div class="pfas-modal-box is-wide" role="dialog" aria-modal="true" aria-labelledby="psRecordTitle">
        <h2 id="psRecordTitle" tal:content="r/title">Lot DEMO-PS-L3 &#183; DEMO 537.1 CAL-3</h2>
        <dl class="rc-facts">
          <div tal:condition="r/recipe"><dt>Recipe, pinned</dt><dd tal:content="r/recipe">537_CAL Rev 1</dd></div>
          <div tal:condition="r/recorded_on"><dt>Recorded on</dt><dd class="pfas-mono" tal:content="r/recorded_on">PDS-A r2 &#183; PDS-A-261105-01</dd></div>
          <div><dt>Made</dt><dd tal:content="r/made">2026-10-13 by DEMO analyst</dd></div>
          <div><dt>Expires</dt><dd><tal:x replace="r/expires">2026-11-12</tal:x><tal:n condition="r/expiry_note"> &#183;
            <tal:x replace="r/expiry_note">the recipe's shelf life</tal:x></tal:n></dd></div>
          <div tal:condition="python:r.get('extension')"><dt>Extended</dt><dd tal:content="python:r['extension']">2027-03-13, extended from 2026-09-13, approved by DEMO QA on 2026-11-10</dd></div>
        </dl>
        <!-- a parent used out of date on the prep date, with the reason the preparer signed -->
        <div class="alert alert-warning" tal:condition="r/expired_parents" tal:content="r/expired_parents">Used out of date: lot DEMO-P1 expired 2026-09-13. Reason: DEMO reason</div>
        <!-- the preparation record's signatures, read from the ledger against its content now -->
        <tal:sg condition="r/entry_id" define="sigs r/signatures">
          <h4 class="rc-h">Signatures</h4>
          <div class="alert alert-success" tal:condition="view/ok_msg" tal:content="view/ok_msg">Signatures checked</div>
          <div class="alert alert-error" tal:condition="view/error_msg" tal:content="view/error_msg">Signed content changed</div>
          <div tal:define="sig_rows sigs; sig_resize string:prep-standards-signatures;
                           sig_verify python:{'url': u'%s/@@pfas-prep-standards?action=verify_prep&amp;entry=%s&amp;record=%s' % (view.portal_url(), r['entry_id'], r['uid']),
                                              'title': u'Recompute the record\u2019s content hash and check each signature in the ledger'}"><metal:s
               use-macro="context/@@pfas-esig-macros/macros/signature_list" /></div>
        </tal:sg>
        <h4 class="rc-h">Made from</h4>
        <ul class="lr-tree">
          <li tal:repeat="n r/tree" tal:attributes="class python:'lr-row d%d%s' % (min(n['depth'], 5), ' is-problem' if n['problem'] else '')">
            <span class="pfas-mono" tal:content="n/lot">DEMO-PS-L3</span>
            <span tal:content="n/name">DEMO 537.1 CAL-3</span>
            <small tal:content="n/note">this lot</small>
          </li>
        </ul>
        <tal:s condition="r/steps">
          <h4 class="rc-h">Steps</h4>
          <table class="pfas-table">
            <tbody><tr tal:repeat="st r/steps">
              <td class="pfas-num" tal:content="python:st[0]">1</td><td tal:content="python:st[1]">Take the stock</td>
              <td><tal:m tal:define="ic context/@@pfas-icons" tal:replace="structure python:ic.svg('sig-signed', u'Signed')" /> <tal:x replace="python:st[2]">DEMO analyst</tal:x></td>
            </tr></tbody>
          </table>
        </tal:s>
        <tal:c condition="r/conc">
          <h4 class="rc-h">Concentrations</h4>
          <table class="pfas-table" data-col-resize="prep-standards-3">
            <thead><tr><th>Analyte</th><th>Concentration</th><th>How</th></tr></thead>
            <tbody><tr tal:repeat="c r/conc">
              <td tal:content="c/analyte">PFOA</td><td tal:content="python:c['value'] or u'&#8212;'">2 ng/mL</td>
              <td class="pfas-muted" tal:content="c/how">calculated, as acid</td>
            </tr></tbody>
          </table>
        </tal:c>
        <h4 class="rc-h">Labels</h4>
        <dl class="rc-facts" tal:condition="r/sitting_text">
          <div><dt>Made in the same sitting</dt><dd tal:content="r/sitting_text">DEMO-PS-L1 to DEMO-PS-L7</dd></div>
        </dl>
        <div class="form-actions">
          <a class="btn btn-secondary" target="_blank" tal:attributes="href r/label_url">Print label</a>
          <a class="btn btn-secondary" target="_blank" tal:condition="r/labels_url" tal:attributes="href r/labels_url"
             tal:content="python:u'Print all %d labels' % len(r['sitting'])">Print all 7 labels</a>
          <a class="btn btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-lot-extensions?lot=${r/uid}">Request extension</a>
          <span class="pfas-filterbar-spacer"></span>
          <a class="btn btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-prep-standards">Close</a>
          <a class="btn btn-primary" target="_blank" tal:attributes="href r/cert_url">Print certificate</a>
        </div>
      </div>
    </div>
    </tal:rec>

    <!-- ── New Prepared Standard: one sitting, made from its recipe ──── -->
    <div id="psNewData" hidden="hidden" tal:attributes="data-new view/new_standard_json"></div>
    <div class="pfas-modal" id="psNew">
      <div class="pfas-modal-box is-wide" role="dialog" aria-modal="true" aria-labelledby="psNewTitle">
        <h2 id="psNewTitle">New Prepared Standard</h2>
        <form method="POST" id="psNewForm" tal:attributes="action string:${view/portal_url}/@@pfas-prep-standards">
          <input type="hidden" name="action" value="make_recipe" />
          <input type="hidden" name="make_nonce" tal:attributes="value view/make_nonce" />
          <div class="pfas-form-row">
            <div class="pfas-form-field">
              <label for="psNewMethod">Method</label>
              <select id="psNewMethod" name="method"></select>
            </div>
            <div class="pfas-form-field">
              <label for="psNewRecipe">Standard
                <tal:h define="hid string:recipes"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></label>
              <select id="psNewRecipe" name="recipe"></select>
            </div>
          </div>
          <div class="pfas-empty" id="psNewEmpty" hidden="hidden">
            <p>This method has no recipe yet.</p>
            <a class="btn btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-recipes">Recipes</a>
          </div>

          <div data-tabs="data-tabs" id="psNewBody">
            <div class="pfas-seg" id="psNewTabs">
              <button type="button" class="pfas-seg-item" data-pane="psNewDetails" aria-selected="true">Details</button>
              <button type="button" class="pfas-seg-item" data-pane="psNewParentsPane" aria-selected="false">Parent Reagents</button>
              <button type="button" class="pfas-seg-item" data-pane="psNewConc" aria-selected="false">Analyte Concentrations</button>
            </div>
            <div class="pfas-pane is-active" id="psNewDetails">
              <div class="pfas-form-row">
                <div class="pfas-form-field is-wide">
                  <label for="psNewName">Standard name</label>
                  <input type="text" id="psNewName" readonly="readonly" />
                  <span class="pfas-hint" id="psNewSitting"></span>
                </div>
                <div class="pfas-form-field">
                  <label for="psNewLot">In-house lot # <span class="badge">from recipe</span></label>
                  <input type="text" id="psNewLot" readonly="readonly" />
                </div>
              </div>
              <div class="pfas-form-row">
                <div class="pfas-form-field">
                  <label for="psNewType">Standard type</label>
                  <select id="psNewType" name="standard_type" required="required">
                    <option value="">&#8212; Select &#8212;</option>
                    <option tal:repeat="t view/standard_types" tal:attributes="value python:t[0]" tal:content="python:t[1]">type</option>
                  </select>
                </div>
                <div class="pfas-form-field">
                  <label for="psNewBy">Prepared by <span class="badge">signed in</span></label>
                  <input type="text" id="psNewBy" readonly="readonly" />
                </div>
                <div class="pfas-form-field">
                  <label for="psNewDate">Date prepared</label>
                  <input type="date" id="psNewDate" name="prepared_date" required="required" />
                </div>
              </div>
              <div class="pfas-form-row">
                <div class="pfas-form-field">
                  <label for="psNewExpiry">Expiry date <span class="badge">from recipe</span></label>
                  <input type="text" id="psNewExpiry" readonly="readonly" />
                  <span class="pfas-hint">Prep date + the recipe's shelf life, no later than the earliest parent's expiry.</span>
                </div>
                <div class="pfas-form-field">
                  <label for="psNewFinal">Volume / amount prepared <span class="badge">from recipe</span></label>
                  <span class="pfas-inline"><input type="text" class="pfas-input is-num" id="psNewFinal" name="final" />
                    <span id="psNewFinalUnit">mL</span></span>
                </div>
              </div>
              <div class="pfas-form-row">
                <div class="pfas-form-field">
                  <label for="psNewStorage">Storage location <span class="badge">from recipe</span></label>
                  <select id="psNewStorage" name="storage_location">
                    <option value="">Choose a location</option>
                    <option tal:repeat="l view/core_storage" tal:attributes="value l" tal:content="l">Fridge</option>
                  </select>
                </div>
                <div class="pfas-form-field">
                  <label for="psNewCond">Storage conditions <span class="badge">from recipe</span></label>
                  <input type="text" id="psNewCond" name="storage_conditions" required="required" />
                </div>
              </div>
              <div class="pfas-form-row">
                <div class="pfas-form-field" tal:define="units view/facility_balances">
                  <label for="psNewBalance">Balance used</label>
                  <select id="psNewBalance" name="equip_balance_unit_id">
                    <option value="">&#8212; not recorded &#8212;</option>
                    <option tal:repeat="b units"
                            tal:attributes="value b/id; selected python:'selected' if len(units) == 1 else None"
                            tal:content="string:${b/name} (${b/serial_number})">Bal</option>
                  </select>
                </div>
                <div class="pfas-form-field" tal:define="units view/facility_pipettes">
                  <label for="psNewPipette">Pipette used</label>
                  <select id="psNewPipette" name="equip_pipette_unit_id">
                    <option value="">&#8212; not recorded &#8212;</option>
                    <option tal:repeat="u units"
                            tal:attributes="value u/id; selected python:'selected' if len(units) == 1 else None"
                            tal:content="string:${u/name} (${u/serial_number})">Pip</option>
                  </select>
                </div>
              </div>
              <div class="pfas-form-row">
                <div class="pfas-form-field is-full">
                  <label for="psNewNotes">Notes</label>
                  <textarea id="psNewNotes" name="notes" rows="2"></textarea>
                </div>
              </div>
            </div>
            <div class="pfas-pane" id="psNewParentsPane">
              <table class="pfas-mini-table" data-col-resize="prep-standards-pfas-mini-table">
                <thead><tr><th>Made from</th><th>Lot</th><th>Amount taken</th><th>Unit</th></tr></thead>
                <tbody id="psNewParents"></tbody>
              </table>
              <div class="pfas-form-field is-full" id="psNewExpiredField" hidden="hidden">
                <label for="psNewExpiredReason">Reason for using a lot out of date</label>
                <textarea id="psNewExpiredReason" name="expired_reason" rows="2" disabled="disabled"></textarea>
                <span class="pfas-hint">Out of date on the prep date: <span id="psNewExpiredLots"></span>. The reason prints on the preparation record.</span>
              </div>
            </div>
            <div class="pfas-pane" id="psNewConc">
              <p class="pfas-hint">Calculated when saved from the lots and volumes used.</p>
              <a class="btn-sm btn-secondary" id="psNewRecipeCard" target="_blank"
                 tal:attributes="data-base string:${view/portal_url}/@@pfas-recipes; href string:${view/portal_url}/@@pfas-recipes">Open the recipe</a>
            </div>
          </div>

          <div class="form-actions is-end">
            <button type="button" class="btn btn-secondary" data-modal-close="data-modal-close">Cancel</button>
            <button type="button" class="btn btn-primary" id="psNewSave" data-modal-open="esig-make_recipe">Save &amp; Generate Certificate</button>
          </div>
        </form>
      </div>
    </div>
    <!-- Save opens the sign dialog; its Sign posts the form: a record is saved signed or not at all -->
    <div tal:define="esig view/make_esig"><metal:d use-macro="context/@@pfas-esig-macros/macros/sign_dialog" /></div>
    <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/prep_standard_new.js?v=${context/@@pfas-macros/asset_version}"></script>

    <div class="pane-footer">
      <span>In-house prepared standards with full preparation parentage and auto-generated internal certificates</span>
    </div>

  </div>

  <script>
  /* Absolute portal URL —
     the Zope root, where there is no portal_url tool. */
  var LOOKUP_URL = '<tal:u replace="view/portal_url">/senaite</tal:u>'
                 + '/@@pfas-reagents?action=lookup_json&q=';

  /* ── Tab switching ────────────────────────────────────────────────── */
  /* the shared segmented control switches the pane; its pill is placed again
     once the modal is open (it measured zero while closed) */
  function switchTab(id) {
    var seg = document.getElementById('ps-tabs');
    var item = seg.querySelector('[data-pane="' + id + '"]');
    if (item) { item.click(); }
    if (window.PFAS && PFAS.components) { PFAS.components.placePill(seg); }
  }

  /* ── Edit dialog ─────────────────────────────────────────────────── */
  function closePsModal() { document.getElementById('psModal').classList.remove('open'); }
  document.getElementById('psModal').addEventListener('click', function(e) {
    if (e.target === this) closePsModal();
  });

  function editStandard(data) {
    if (typeof data === 'string') { try { data = JSON.parse(data); } catch(e) { return; } }
    document.getElementById('psUid').value = data.uid || '';
    document.getElementById('psTitle').value = data.title || '';
    document.getElementById('psLot').value = data.lot_number || '';
    document.getElementById('psType').value = data.standard_type || '';
    document.getElementById('psPrepBy').value = data.prepared_by || '';
    document.getElementById('psPrepDate').value = data.prepared_date || '';
    document.getElementById('psExpiry').value = data.expiry_date || '';
    document.getElementById('psVol').value = data.volume_prepared || '';
    document.getElementById('psStorage').value = data.storage_location || '';
    document.getElementById('psCond').value = data.storage_conditions || '';
    document.getElementById('psNotes').value = data.notes || '';
    /* a lot made from its recipe keeps the parents and the calculated
       concentrations of its prep entry: neither is posted, so neither changes */
    var pinned = !!(data.recipe && data.recipe.id);
    ['parentJson', 'analyteJson'].forEach(function (id) { document.getElementById(id).disabled = pinned; });
    ['parentsEdit', 'analytesEdit'].forEach(function (id) { document.getElementById(id).hidden = pinned; });
    ['parentsPinned', 'analytesPinned'].forEach(function (id) { document.getElementById(id).hidden = !pinned; });
    /* Parent reagents */
    document.getElementById('parentsBody').innerHTML = '';
    (data.parent_reagents || []).forEach(function(p) {
      addParentRow(p.name, p.supplier, p.lot, p.qty, p.unit, p.uid);
    });
    /* Analytes */
    document.getElementById('analytesBody').innerHTML = '';
    (data.analyte_concentrations || []).forEach(function(a) {
      addAnalyteRow(a.analyte, a.concentration, a.unit);
    });
    document.getElementById('psModal').classList.add('open');
    switchTab('tabBasic');
  }
  /* a lot row's menu: Edit, filled from the row's data-std */
  document.addEventListener('pfas:row-action', function(e) {
    if (e.detail && e.detail.name === 'ps-edit' && e.detail.row) {
      editStandard(e.detail.row.getAttribute('data-std'));
    }
  });

  /* ── Reagent lookup ────────────────────────────────────────────────── */
  var _lookupTimer = null;
  function lookupReagent(q) {
    clearTimeout(_lookupTimer);
    if (!q.trim()) { document.getElementById('lookupResults').classList.remove('open'); return; }
    _lookupTimer = setTimeout(function() {
      fetch(LOOKUP_URL + encodeURIComponent(q))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var box = document.getElementById('lookupResults');
          var items = data.items || [];
          if (!items.length) { box.classList.remove('open'); return; }
          /* built as DOM nodes: a lot's JSON in an onclick attribute broke the
             attribute on its first quote, so no reagent could be picked */
          box.innerHTML = '';
          items.forEach(function(it) {
            var row = document.createElement('div');
            row.className = 'pfas-suggest-item';
            var nm = document.createElement('strong'); nm.textContent = it.name || '';
            var lot = document.createElement('span'); lot.className = 'pfas-id';
            lot.textContent = 'Lot: ' + (it.lot_number || '');
            row.appendChild(nm);
            row.appendChild(document.createTextNode(' '));
            row.appendChild(lot);
            row.appendChild(document.createTextNode(' \u2014 ' + (it.supplier || '')));
            row.addEventListener('click', function() { selectReagent(it); });
            box.appendChild(row);
          });
          box.classList.add('open');
        });
    }, 280);
  }
  function selectReagent(it) {
    addParentRow(it.name, it.supplier, it.lot_number, '', '', it.uid);
    document.getElementById('reagentSearch').value = '';
    document.getElementById('lookupResults').classList.remove('open');
  }
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.reagent-lookup')) {
      document.getElementById('lookupResults').classList.remove('open');
    }
  });

  /* ── Parent reagent rows ──────────────────────────────────────────── */
  function addParentRow(name, supplier, lot, qty, unit, uid) {
    var tbody = document.getElementById('parentsBody');
    var tr = document.createElement('tr');
    tr.setAttribute('data-uid', uid || '');
    var T='\x3ctd\x3e', ET='\x3c/td\x3e', INP='\x3cinput type="text" ';
    tr.innerHTML = T+INP+'class="p-name" value="'+escHtml(name||'')+'" /\x3e'+ET
      + T+INP+'class="p-sup" value="'+escHtml(supplier||'')+'" /\x3e'+ET
      + T+INP+'class="p-lot" value="'+escHtml(lot||'')+'" /\x3e'+ET
      + T+INP+'class="p-qty" value="'+escHtml(qty||'')+'" placeholder="5" /\x3e'+ET
      + T+INP+'class="p-unit" value="'+escHtml(unit||'')+'" placeholder="mL" /\x3e'+ET
      + T+'\x3cbutton type="button" class="pfas-row-remove" onclick="this.closest(\'tr\').remove()"\x3e\u00d7\x3c/button\x3e'+ET;
    tbody.appendChild(tr);
  }

  /* ── Analyte rows ─────────────────────────────────────────────────── */
  function addAnalyteRow(analyte, conc, unit) {
    var tbody = document.getElementById('analytesBody');
    var tr = document.createElement('tr');
    var T2='\x3ctd\x3e', ET2='\x3c/td\x3e', I2='\x3cinput type="text" ';
    tr.innerHTML = T2+I2+'class="a-name" value="'+escHtml(analyte||'')+'" placeholder="PFOA" /\x3e'+ET2
      + T2+I2+'class="a-conc" value="'+escHtml(conc||'')+'" placeholder="100" /\x3e'+ET2
      + T2+I2+'class="a-unit" value="'+escHtml(unit||'')+'" placeholder="ng/mL" /\x3e'+ET2
      + '\x3ctd\x3e\x3cbutton type="button" class="pfas-row-remove" onclick="this.closest(\'tr\').remove()"\x3e\u00d7\x3c/button\x3e\x3c/td\x3e';
    tbody.appendChild(tr);
  }

  /* ── Serialize before submit ──────────────────────────────────────── */
  function serializeAll() {
    /* Parents */
    var parents = [];
    document.querySelectorAll('#parentsBody tr').forEach(function(tr) {
      var n = tr.querySelector('.p-name').value.trim();
      if (n) parents.push({
        uid:      tr.getAttribute('data-uid') || '',
        name:     n,
        supplier: tr.querySelector('.p-sup').value.trim(),
        lot:      tr.querySelector('.p-lot').value.trim(),
        qty:      tr.querySelector('.p-qty').value.trim(),
        unit:     tr.querySelector('.p-unit').value.trim(),
      });
    });
    document.getElementById('parentJson').value = JSON.stringify(parents);
    /* Analytes */
    var analytes = [];
    document.querySelectorAll('#analytesBody tr').forEach(function(tr) {
      var a = tr.querySelector('.a-name').value.trim();
      if (a) analytes.push({
        analyte: a,
        concentration: tr.querySelector('.a-conc').value.trim(),
        unit: tr.querySelector('.a-unit').value.trim(),
      });
    });
    document.getElementById('analyteJson').value = JSON.stringify(analytes);
  }

  var escHtml = window.PFAS.components.esc;
  </script>

  </div><!-- /content slot -->
</body>
</html>
