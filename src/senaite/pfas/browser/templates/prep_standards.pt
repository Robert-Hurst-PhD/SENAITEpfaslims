<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Prepared Standards</title>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Prepared Standards</tal:t>
  <tal:r metal:fill-slot="header-right">
    
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <div class="alert alert-success" tal:condition="view/ok_msg"    tal:content="view/ok_msg"></div>
    <div class="alert alert-error"   tal:condition="view/error_msg" tal:content="view/error_msg"></div>

    <!-- Filters: one bar, applies on change -->
    <form method="GET" class="pfas-filterbar" id="ps-filters" data-autosubmit="data-autosubmit"
          tal:attributes="action string:${context/absolute_url}/@@pfas-prep-standards">
      <div class="pfas-field">
        <label for="ps-q">Search</label>
        <input type="text" id="ps-q" name="q" class="pfas-input pfas-input-wide"
               placeholder="Name, lot, logbook..."
               tal:attributes="value python:request.form.get('q','')" />
      </div>
      <div class="pfas-field">
        <label for="ps-status">Status</label>
        <select id="ps-status" name="status" class="pfas-select">
          <option value="">&#8212; All Status &#8212;</option>
          <option value="active"    tal:attributes="selected python:request.form.get('status')=='active'">Active</option>
          <option value="exhausted" tal:attributes="selected python:request.form.get('status')=='exhausted'">Exhausted</option>
          <option value="expired"   tal:attributes="selected python:request.form.get('status')=='expired'">Expired</option>
        </select>
      </div>
      <div class="pfas-field">
        <label for="ps-type">Type</label>
        <select id="ps-type" name="type" class="pfas-select">
          <option value="">&#8212; All Types &#8212;</option>
          <tal:opts tal:repeat="t view/standard_types">
            <option tal:content="python:t[1]" tal:attributes="value python:t[0]; selected python:request.form.get('type')==t[0]">type</option>
          </tal:opts>
        </select>
      </div>
      <noscript><button type="submit" class="btn btn-primary">Apply</button></noscript>
      <span class="pfas-filterbar-spacer"></span>
      <button type="button" class="btn btn-primary" onclick="openModal()">
        + New Prepared Standard
      </button>
    </form>

    <tal:stds tal:define="stds view/prepared_standards">

      <div class="pfas-empty" tal:condition="not:stds">
        <p class="pfas-empty-glyph">&#129514;</p>
        <p>No prepared standards recorded yet.</p>
        <button type="button" class="btn btn-primary" onclick="openModal()">
          Record First Standard
        </button>
      </div>

      <div class="table-wrap" tal:condition="stds">
        <table class="pfas-table pfas-table-fixed">
          <thead>
            <tr>
              <th class="pfas-col-name">Name / Lot</th>
              <th class="pfas-col-text">Type</th>
              <th class="pfas-col-text">Prep Logbook</th>
              <th class="pfas-col-text">Prepared By</th>
              <th class="pfas-col-date">Prepared Date</th>
              <th class="pfas-col-expiry">Expiry</th>
              <th class="pfas-col-status">Status</th>
              <th class="pfas-col-actions-sm">Actions</th>
            </tr>
          </thead>
          <tbody>
            <tal:rows tal:repeat="std stds">
              <tr tal:define="std_json python:__import__('json').dumps(std).replace('&amp;', '\\u0026').replace('&lt;', '\\u003c').replace('&gt;', '\\u003e')">
                <td>
                  <div class="pfas-cell-name" tal:content="std/title">Name</div>
                  <div class="pfas-sub" tal:content="std/lot_number">LOT</div>
                </td>
                <td class="pfas-muted" tal:content="std/standard_type">—</td>
                <td>
                  <span class="pfas-muted" tal:condition="std/logbook_slug">
                    <tal:x tal:replace="std/logbook_title">Logbook</tal:x>
                    rev <tal:x tal:replace="std/logbook_revision">1</tal:x>
                  </span>
                </td>
                <td tal:content="std/prepared_by">—</td>
                <td class="cell-nowrap" tal:content="std/prepared_date">—</td>
                <td tal:attributes="class python:'cell-nowrap ' + view.expiry_class(std)">
                  <span tal:content="std/effective_expiry|std/expiry_date">—</span>
                  <div class="pfas-sub exp-warning" tal:condition="std/expiry_inherited_from|nothing"
                       tal:attributes="title string:Tighter parent-lot expiry inherited from ${std/expiry_inherited_from}">
                    &#8675; inherited: <span tal:content="std/expiry_inherited_from">parent</span>
                  </div>
                </td>
                <td>
                  <span tal:attributes="class python:'badge badge-' + std['status']"
                        tal:content="std/status">active</span>
                </td>
                <!-- Same layout as Reagent Inventory: Edit, and More for
                     everything else. -->
                <td class="row-actions-cell pfas-col-actions-sm">
                  <div class="row-actions">
                    <button type="button" class="btn-sm btn-secondary" title="Edit this standard's preparation record"
                            tal:attributes="onclick string:editStandard(${std_json})">Edit</button>
                    <details class="row-more">
                      <summary class="btn-sm btn-secondary" title="Where used, the certificate, a label, mark emptied">More &#9662;</summary>
                      <div class="row-more-menu">
                        <a class="btn-sm btn-secondary" title="Every batch and stage that used this lot"
                           tal:attributes="href string:${context/absolute_url}/@@pfas-lot-usage?kind=prepared_standard&amp;uid=${std/uid}">Where used</a>
                        <a class="btn-sm btn-secondary" target="_blank" title="Open the preparation certificate (PDF)"
                           tal:attributes="href string:${context/absolute_url}/@@pfas-prep-standards?action=cert&amp;uid=${std/uid}">Certificate</a>
                        <a class="btn-sm btn-secondary" target="_blank" title="Print a label for this lot (the issued label template, or the built-in layout)"
                           tal:attributes="href python:view.label_url(std)">Print label</a>
                        <!-- Emptied lots must leave the logbook lot picker; this
                             is how an analyst says a standard is used up. -->
                        <form method="POST" tal:attributes="action string:${view/portal_url}/@@pfas-prep-standards">
                          <input type="hidden" name="action" value="status" />
                          <input type="hidden" name="uid" tal:attributes="value std/uid" />
                          <input type="hidden" name="new_status"
                                 tal:attributes="value python:'active' if std.get('status') == 'exhausted' else 'exhausted'" />
                          <button type="submit" class="btn-sm btn-secondary"
                                  tal:condition="python:std.get('status') != 'exhausted'"
                                  tal:attributes="disabled python:None if std.get('status') == 'active' else 'disabled';
                                                  title python:'No longer offered when filling a logbook' if std.get('status') == 'active' else 'Only an active lot can be marked emptied (this one is %s)' % std.get('status')"
                                  onclick="return confirm('Mark this lot as emptied? It will no longer be offered when filling a logbook.')">Mark emptied</button>
                          <button type="submit" class="btn-sm btn-secondary" tal:condition="python:std.get('status') == 'exhausted'"
                                  title="Offer this lot in logbooks again">Reactivate</button>
                        </form>
                      </div>
                    </details>
                  </div>
                </td>
              </tr>
            </tal:rows>
          </tbody>
        </table>
      </div>

    </tal:stds>

    <!-- ── Create/Edit modal ─────────────────────────────────────────── -->
    <div class="pfas-modal" id="psModal">
      <div class="pfas-modal-box is-wide">
        <h2 id="psModalTitle">New Prepared Standard</h2>

        <div data-tabs="data-tabs">
        <!-- Tab bar -->
        <div class="pfas-seg" id="ps-tabs">
          <button type="button" class="pfas-seg-item" data-pane="tabBasic" aria-selected="true">Details</button>
          <button type="button" class="pfas-seg-item" data-pane="tabParents" aria-selected="false">Parent Reagents</button>
          <button type="button" class="pfas-seg-item" data-pane="tabAnalytes" aria-selected="false">Analyte Concentrations</button>
        </div>

        <form method="POST"
              tal:attributes="action string:${view/portal_url}/@@pfas-prep-standards">
          <input type="hidden" name="action" value="add" id="psFormAction" />
          <input type="hidden" name="uid" id="psUid" value="" />
          <input type="hidden" name="parent_reagents_json" id="parentJson" value="[]" />
          <input type="hidden" name="analyte_concentrations_json" id="analyteJson" value="[]" />

          <!-- Tab 1: Basic details -->
          <div class="pfas-pane is-active" id="tabBasic">
            <div class="pfas-form-row">
              <div class="pfas-form-field is-wide">
                <label>Standard name *</label>
                <input type="text" name="title" id="psTitle" required
                       placeholder="e.g. Native Mix 100 ng/mL" />
              </div>
              <div class="pfas-form-field">
                <label>In-house lot # *</label>
                <input type="text" name="lot_number" id="psLot" required
                       placeholder="2026-06-22-001" />
              </div>
            </div>
            <div class="pfas-form-row">
              <div class="pfas-form-field">
                <label>Standard type</label>
                <select name="standard_type" id="psType">
                  <option value="">— Select —</option>
                  <tal:opts tal:repeat="t view/standard_types">
                    <option tal:content="python:t[1]" tal:attributes="value python:t[0]">type</option>
                  </tal:opts>
                </select>
              </div>
              <div class="pfas-form-field">
                <label>Prep logbook</label>
                <select name="logbook_slug" id="psLogbookSlug" onchange="onLogbookChange(this)">
                  <option value="">— None —</option>
                  <tal:lbs tal:repeat="lb view/prep_logbooks">
                    <option tal:attributes="value lb/logbook_slug;
                                            data-revision lb/revision;
                                            data-title lb/title;
                                            data-expiry lb/default_expiry_days"
                            tal:content="python:'{} (Rev {})'.format(lb['title'], lb['revision'])">Logbook</option>
                  </tal:lbs>
                </select>
              </div>
              <input type="hidden" name="logbook_revision" id="psLogbookRevision" value="" />
              <input type="hidden" name="logbook_title" id="psLogbookTitle" value="" />
            </div>
            <div class="pfas-form-row">
              <div class="pfas-form-field">
                <label>Prepared by</label>
                <input type="text" name="prepared_by" id="psPrepBy" />
              </div>
              <div class="pfas-form-field">
                <label>Date prepared</label>
                <input type="date" name="prepared_date" id="psPrepDate"
                       onchange="autoExpiry()" />
              </div>
            </div>
            <div class="pfas-form-row">
              <div class="pfas-form-field">
                <label>Expiry date</label>
                <input type="date" name="expiry_date" id="psExpiry" />
                <span class="pfas-hint">Auto-filled from logbook default. Adjust if needed.</span>
              </div>
              <div class="pfas-form-field">
                <label>Volume / amount prepared</label>
                <input type="text" name="volume_prepared" id="psVol" placeholder="e.g. 10 mL" />
              </div>
              <div class="pfas-form-field">
                <label>Storage location</label>
                <!-- core Storage Locations (core_lists.py) -->
                <select name="storage_location" id="psStorage">
                  <option value="">Choose a location</option>
                  <option tal:repeat="s view/core_storage" tal:attributes="value s" tal:content="s">Location</option>
                </select>
              </div>
            </div>
            <!-- Equipment. A prepared standard's assigned value rests on a mass
                 and a volume, so under ISO 17025 §6.5 the balance and pipette that
                 measured them belong to its traceability. The certificate used to
                 print "equipment is not recorded against this lot" and point at the
                 logbook; now it names them and resolves each one's
                 calibration as of the PREPARED date. `equipment_posted` marks that
                 this form owns the field, so a form that does not post it cannot
                 wipe the record. -->
            <input type="hidden" name="equipment_posted" value="1" />
            <div class="pfas-form-row">
              <div class="pfas-form-field">
                <label>Balance used</label>
                <select name="equip_balance_unit_id" id="psBalance">
                  <option value="">&#8212; not recorded &#8212;</option>
                  <option tal:repeat="b view/facility_balances"
                          tal:attributes="value b/id"
                          tal:content="string:${b/name} (${b/serial_number})">Bal</option>
                </select>
                <span class="pfas-hint" tal:condition="not:view/facility_balances">
                  No balance registered under Facility QC &#8594; Units.
                </span>
              </div>
              <div class="pfas-form-field">
                <label>Pipette used</label>
                <select name="equip_pipette_unit_id" id="psPipette">
                  <option value="">&#8212; not recorded &#8212;</option>
                  <option tal:repeat="p view/facility_pipettes"
                          tal:attributes="value p/id"
                          tal:content="string:${p/name} (${p/serial_number})">Pip</option>
                </select>
              </div>
            </div>
            <div class="pfas-form-row">
              <div class="pfas-form-field is-full">
                <label>Expiry justification (required if not default)</label>
                <input type="text" name="expiry_notes" id="psExpiryNotes"
                       placeholder="e.g. Extended per supervisor review — see audit trail" />
              </div>
            </div>
            <div class="pfas-form-row">
              <div class="pfas-form-field is-full">
                <label>Notes</label>
                <textarea name="notes" id="psNotes" rows="2"></textarea>
              </div>
            </div>
          </div>

          <!-- Tab 2: Parent reagents (parentage) -->
          <div class="pfas-pane" id="tabParents">
            <p class="pfas-lead">
              Record the procured reagents consumed to prepare this standard.
              Search your inventory and add each reagent used.
            </p>
            <div class="pfas-suggest reagent-lookup">
              <input type="text" id="reagentSearch" class="pfas-input" placeholder="Search reagent inventory..."
                     oninput="lookupReagent(this.value)" autocomplete="off" />
              <div class="pfas-suggest-list" id="lookupResults"></div>
            </div>
            <table class="pfas-mini-table" id="parentsTable">
              <thead>
                <tr>
                  <th>Reagent Name</th><th>Supplier</th><th>Lot #</th>
                  <th>Qty Used</th><th>Unit</th><th></th>
                </tr>
              </thead>
              <tbody id="parentsBody"></tbody>
            </table>
          </div>

          <!-- Tab 3: Analyte concentrations -->
          <div class="pfas-pane" id="tabAnalytes">
            <p class="pfas-lead">
              Record the final analyte concentrations in this standard.
              These are printed on the internal certificate.
            </p>
            <table class="pfas-mini-table" id="analytesTable">
              <thead>
                <tr><th>Analyte</th><th>Concentration</th><th>Unit</th><th></th></tr>
              </thead>
              <tbody id="analytesBody"></tbody>
            </table>
            <button type="button" class="btn-sm btn-secondary" onclick="addAnalyteRow()">+ Add Analyte</button>
          </div>

          <div class="form-actions is-end">
            <button type="button" class="btn btn-secondary" onclick="closePsModal()">Cancel</button>
            <button type="submit" class="btn btn-primary" onclick="serializeAll()">Save &amp; Generate Certificate</button>
          </div>
        </form>
        </div>
      </div>
    </div>

    <div class="pane-footer">
      <span>In-house prepared standards with full preparation parentage and auto-generated internal certificates</span>
    </div>

  </div>

  <script>
  /* Absolute portal URL —
     the Zope root, where there is no portal_url tool. */
  var LOOKUP_URL = '<tal:u replace="view/portal_url">/senaite</tal:u>'
                 + '/@@pfas-reagents?action=lookup_json&q=';
  var currentLogbookExpiry = 365;

  /* ── Tab switching ────────────────────────────────────────────────── */
  /* the shared segmented control switches the pane; its pill is placed again
     once the modal is open (it measured zero while closed) */
  function switchTab(id) {
    var seg = document.getElementById('ps-tabs');
    var item = seg.querySelector('[data-pane="' + id + '"]');
    if (item) { item.click(); }
    if (window.PFAS && PFAS.components) { PFAS.components.placePill(seg); }
  }

  /* ── Modal open/close ─────────────────────────────────────────────── */
  /* the top bar's "+" menu lands here with ?new=1 */
  window.pfasOpenNew = function () { openModal(); };
  function openModal() {
    document.getElementById('psFormAction').value = 'add';
    document.getElementById('psUid').value = '';
    document.getElementById('psTitle').value = '';
    document.getElementById('psLot').value = '';
    document.getElementById('psType').value = '';
    document.getElementById('psLogbookSlug').value = '';
    document.getElementById('psLogbookRevision').value = '';
    document.getElementById('psLogbookTitle').value = '';
    document.getElementById('psPrepBy').value = '';
    document.getElementById('psPrepDate').value = '';
    document.getElementById('psExpiry').value = '';
    document.getElementById('psExpiryNotes').value = '';
    document.getElementById('psVol').value = '';
    document.getElementById('psStorage').value = '';
    document.getElementById('psNotes').value = '';
    document.getElementById('parentsBody').innerHTML = '';
    document.getElementById('analytesBody').innerHTML = '';
    document.getElementById('psModal').classList.add('open');
    switchTab('tabBasic');
  }
  function closePsModal() { document.getElementById('psModal').classList.remove('open'); }
  document.getElementById('psModal').addEventListener('click', function(e) {
    if (e.target === this) closePsModal();
  });

  function editStandard(data) {
    if (typeof data === 'string') { try { data = JSON.parse(data); } catch(e) { return; } }
    document.getElementById('psFormAction').value = 'edit';
    document.getElementById('psUid').value = data.uid || '';
    document.getElementById('psTitle').value = data.title || '';
    document.getElementById('psLot').value = data.lot_number || '';
    document.getElementById('psType').value = data.standard_type || '';
    document.getElementById('psLogbookSlug').value = data.logbook_slug || '';
    document.getElementById('psLogbookRevision').value = data.logbook_revision || '';
    document.getElementById('psLogbookTitle').value = data.logbook_title || '';
    document.getElementById('psPrepBy').value = data.prepared_by || '';
    document.getElementById('psPrepDate').value = data.prepared_date || '';
    document.getElementById('psExpiry').value = data.expiry_date || '';
    document.getElementById('psExpiryNotes').value = data.expiry_notes || '';
    document.getElementById('psVol').value = data.volume_prepared || '';
    document.getElementById('psStorage').value = data.storage_location || '';
    document.getElementById('psNotes').value = data.notes || '';
    /* Parent reagents */
    document.getElementById('parentsBody').innerHTML = '';
    (data.parent_reagents || []).forEach(function(p) {
      addParentRow(p.name, p.supplier, p.lot, p.qty, p.unit, p.uid);
    });
    /* Analytes */
    document.getElementById('analytesBody').innerHTML = '';
    (data.analyte_concentrations || []).forEach(function(a) {
      addAnalyteRow(a.analyte, a.concentration, a.unit);
    });
    document.getElementById('psModal').classList.add('open');
    switchTab('tabBasic');
  }

  /* ── Logbook selection ─────────────────────────────────────────────── */
  function onLogbookChange(sel) {
    var opt = sel.options[sel.selectedIndex];
    var rev = opt.getAttribute('data-revision') || '';
    var title = opt.getAttribute('data-title') || '';
    var expiry = parseInt(opt.getAttribute('data-expiry') || '365');
    document.getElementById('psLogbookRevision').value = rev;
    document.getElementById('psLogbookTitle').value = title;
    currentLogbookExpiry = expiry;
    autoExpiry();
    /* Load analyte template for this logbook */
    if (rev) {
      /* Analytes from logbook template could be loaded via AJAX, but for now
         just note the logbook reference — user fills concentrations manually */
    }
  }

  function autoExpiry() {
    var pd = document.getElementById('psPrepDate').value;
    if (!pd) return;
    var d = new Date(pd);
    d.setDate(d.getDate() + currentLogbookExpiry);
    var iso = d.toISOString().slice(0,10);
    document.getElementById('psExpiry').value = iso;
  }

  /* ── Reagent lookup ────────────────────────────────────────────────── */
  var _lookupTimer = null;
  function lookupReagent(q) {
    clearTimeout(_lookupTimer);
    if (!q.trim()) { document.getElementById('lookupResults').classList.remove('open'); return; }
    _lookupTimer = setTimeout(function() {
      fetch(LOOKUP_URL + encodeURIComponent(q))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var box = document.getElementById('lookupResults');
          var items = data.items || [];
          if (!items.length) { box.classList.remove('open'); return; }
          /* built as DOM nodes: a lot's JSON in an onclick attribute broke the
             attribute on its first quote, so no reagent could be picked */
          box.innerHTML = '';
          items.forEach(function(it) {
            var row = document.createElement('div');
            row.className = 'pfas-suggest-item';
            var nm = document.createElement('strong'); nm.textContent = it.name || '';
            var lot = document.createElement('span'); lot.className = 'pfas-id';
            lot.textContent = 'Lot: ' + (it.lot_number || '');
            row.appendChild(nm);
            row.appendChild(document.createTextNode(' '));
            row.appendChild(lot);
            row.appendChild(document.createTextNode(' \u2014 ' + (it.supplier || '')));
            row.addEventListener('click', function() { selectReagent(it); });
            box.appendChild(row);
          });
          box.classList.add('open');
        });
    }, 280);
  }
  function selectReagent(it) {
    addParentRow(it.name, it.supplier, it.lot_number, '', '', it.uid);
    document.getElementById('reagentSearch').value = '';
    document.getElementById('lookupResults').classList.remove('open');
  }
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.reagent-lookup')) {
      document.getElementById('lookupResults').classList.remove('open');
    }
  });

  /* ── Parent reagent rows ──────────────────────────────────────────── */
  function addParentRow(name, supplier, lot, qty, unit, uid) {
    var tbody = document.getElementById('parentsBody');
    var tr = document.createElement('tr');
    tr.setAttribute('data-uid', uid || '');
    var T='\x3ctd\x3e', ET='\x3c/td\x3e', INP='\x3cinput type="text" ';
    tr.innerHTML = T+INP+'class="p-name" value="'+escHtml(name||'')+'" /\x3e'+ET
      + T+INP+'class="p-sup" value="'+escHtml(supplier||'')+'" /\x3e'+ET
      + T+INP+'class="p-lot" value="'+escHtml(lot||'')+'" /\x3e'+ET
      + T+INP+'class="p-qty" value="'+escHtml(qty||'')+'" placeholder="5" /\x3e'+ET
      + T+INP+'class="p-unit" value="'+escHtml(unit||'')+'" placeholder="mL" /\x3e'+ET
      + T+'\x3cbutton type="button" class="pfas-row-remove" onclick="this.closest(\'tr\').remove()"\x3e\u00d7\x3c/button\x3e'+ET;
    tbody.appendChild(tr);
  }

  /* ── Analyte rows ─────────────────────────────────────────────────── */
  function addAnalyteRow(analyte, conc, unit) {
    var tbody = document.getElementById('analytesBody');
    var tr = document.createElement('tr');
    var T2='\x3ctd\x3e', ET2='\x3c/td\x3e', I2='\x3cinput type="text" ';
    tr.innerHTML = T2+I2+'class="a-name" value="'+escHtml(analyte||'')+'" placeholder="PFOA" /\x3e'+ET2
      + T2+I2+'class="a-conc" value="'+escHtml(conc||'')+'" placeholder="100" /\x3e'+ET2
      + T2+I2+'class="a-unit" value="'+escHtml(unit||'')+'" placeholder="ng/mL" /\x3e'+ET2
      + '\x3ctd\x3e\x3cbutton type="button" class="pfas-row-remove" onclick="this.closest(\'tr\').remove()"\x3e\u00d7\x3c/button\x3e\x3c/td\x3e';
    tbody.appendChild(tr);
  }

  /* ── Serialize before submit ──────────────────────────────────────── */
  function serializeAll() {
    /* Parents */
    var parents = [];
    document.querySelectorAll('#parentsBody tr').forEach(function(tr) {
      var n = tr.querySelector('.p-name').value.trim();
      if (n) parents.push({
        uid:      tr.getAttribute('data-uid') || '',
        name:     n,
        supplier: tr.querySelector('.p-sup').value.trim(),
        lot:      tr.querySelector('.p-lot').value.trim(),
        qty:      tr.querySelector('.p-qty').value.trim(),
        unit:     tr.querySelector('.p-unit').value.trim(),
      });
    });
    document.getElementById('parentJson').value = JSON.stringify(parents);
    /* Analytes */
    var analytes = [];
    document.querySelectorAll('#analytesBody tr').forEach(function(tr) {
      var a = tr.querySelector('.a-name').value.trim();
      if (a) analytes.push({
        analyte: a,
        concentration: tr.querySelector('.a-conc').value.trim(),
        unit: tr.querySelector('.a-unit').value.trim(),
      });
    });
    document.getElementById('analyteJson').value = JSON.stringify(analytes);
  }

  function escHtml(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/\x3c/g,'&lt;').replace(/\x3e/g,'&gt;').replace(/"/g,'&quot;');
  }
  </script>

  </div><!-- /content slot -->
</body>
</html>
