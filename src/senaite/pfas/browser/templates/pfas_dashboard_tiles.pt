<tal:pfas-section define="tiles view/tiles; portal_url view/portal_url"
                  tal:condition="tiles">

  <style>
    .pfas-section {
      margin-top: 20px;
    }
    .pfas-section-head {
      padding: 8px 16px;
      background: #1a237e;
      color: #fff;
      border-radius: 4px 4px 0 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .pfas-section-head h2 {
      font-size: 14px;
      font-weight: 700;
      margin: 0;
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .pfas-section-head .pfas-badge {
      background: rgba(255,255,255,.2);
      border-radius: 3px;
      font-size: 11px;
      padding: 1px 7px;
    }
    .pfas-tiles {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      background: #fff;
      border: 1px solid #c5cae9;
      border-top: none;
      border-radius: 0 0 4px 4px;
    }
    .pfas-tile-link {
      flex: 1 1 170px;
      min-width: 150px;
      max-width: 220px;
      text-decoration: none;
      color: inherit;
      border-right: 1px solid #e8eaf6;
      border-bottom: 1px solid #e8eaf6;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      transition: background .12s;
    }
    .pfas-tile-link:hover {
      background: #e8eaf6;
      text-decoration: none;
    }
    .pfas-tile-icon {
      font-size: 20px;
      color: #1a237e;
    }
    .pfas-tile-title {
      font-size: 13px;
      font-weight: 700;
      color: #212121;
    }
    .pfas-tile-desc {
      font-size: 11px;
      color: #616161;
      line-height: 1.4;
    }
  </style>

  <div class="pfas-section">
    <div class="pfas-section-head">
      <i class="fas fa-flask"></i>
      <h2>PFAS Tools</h2>
      <span class="pfas-badge">senaite.pfas</span>
    </div>
    <div class="pfas-tiles">
      <a tal:repeat="tile tiles"
         tal:attributes="href tile/url; class string:pfas-tile-link pfas-tile-${tile/id}"
         class="pfas-tile-link">
        <div class="pfas-tile-icon">
          <i tal:attributes="class string:fas ${tile/icon}"></i>
        </div>
        <div class="pfas-tile-title" tal:content="tile/title">Batch Status</div>
        <div class="pfas-tile-desc" tal:content="tile/desc">Description</div>
      </a>
    </div>
  </div>

</tal:pfas-section>
