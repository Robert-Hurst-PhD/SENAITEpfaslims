<tal:pfas-section define="tiles view/tiles; portal_url view/portal_url"
                  tal:condition="tiles">

  <div class="pfas-section-head">
    <i class="fas fa-flask"></i> PFAS Tools
    <span class="badge badge-info">senaite.pfas</span>
  </div>
  <div class="pfas-tiles">
    <a tal:repeat="tile tiles" class="pfas-tile" tal:attributes="href tile/url">
      <div class="pfas-tile-icon">
        <i tal:attributes="class string:fas ${tile/icon}"></i>
      </div>
      <div class="pfas-tile-title" tal:content="tile/title">Batch Status</div>
      <div class="pfas-tile-desc" tal:content="tile/desc">Description</div>
    </a>
  </div>

</tal:pfas-section>
