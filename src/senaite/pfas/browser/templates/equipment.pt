<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Equipment</title>
  <metal:fill fill-slot="header-title">Equipment</metal:fill>
  <tal:r metal:fill-slot="header-right">
    <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-equipment-types">Equipment types</a>
    <a class="btn-sm btn-primary" tal:attributes="href view/add_url">+ New equipment</a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body" tal:define="rows view/rows">

    <p class="form-note">Each item is a SENAITE instrument; its type sets what it owes. <tal:h define="hid string:equipment-types"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></p>

    <p class="form-note" tal:condition="not:rows">No equipment yet.</p>

    <table class="pfas-table" data-col-resize="equipment-1" tal:condition="rows" tal:define="rm context/@@pfas-row-menu">
      <thead>
        <tr><th>Equipment</th><th>Type</th><th>Location</th><th>Equipment check</th>
            <th>External certificate</th><th>Status</th></tr>
      </thead>
      <tbody>
        <tr tal:repeat="r rows"
            tal:attributes="data-row-open r/url;
                            data-row-actions python:rm.actions(
                                (u'Set check frequency', 'href', u'%s#et-type-%s' % (view.types_url(), r['type_uid']),
                                 {'note': u'Opens Equipment types at %s' % r['type_title']}) if not r['due']['internal'] and r['type_uid'] else None,
                                (u'Equipment checks', 'href', view.checklist_url()) if r['daily'] else None,
                                (u'Settings', 'href', u'%s/@@pfas-equipment-settings?uid=%s' % (view.portal_url(), r['id'])),
                                (u'Edit', 'href', u'%s/base_edit' % r['url']),
                                (u'Records', 'href', r['records_url']))">
          <td><strong tal:content="r/name">Balance 1</strong>
              <div class="cf-hint" tal:condition="r/serial_number" tal:content="r/serial_number">123</div>
              <span class="badge badge-archived" tal:condition="not:r/active">inactive</span></td>
          <td><span tal:replace="r/type_title">Balance</span>
              <div class="cf-hint" tal:content="r/kind_label">Balance, analytical</div></td>
          <td tal:content="r/location">Prep room</td>
          <td tal:define="i r/due/internal">
            <tal:i condition="i">
              <div tal:content="python:'last %s' % (i['last'] or 'none')">last 2026-09-01</div>
              <div class="cf-hint" tal:condition="i/due" tal:content="string:due ${i/due}">due 2026-12-01</div>
            </tal:i>
            <tal:n condition="not:i">
              <span class="cf-hint">No frequency: set on its type</span>
            </tal:n>
            <div tal:condition="r/daily">
              <span class="cf-hint" tal:content="string:Daily check: ${r/daily_label}">Daily</span>
            </div>
          </td>
          <td tal:define="x r/due/external">
            <tal:x condition="x">
              <span tal:replace="python:x['valid_to'] and ('valid to %s' % x['valid_to']) or 'none on file'">valid to 2027-01-01</span>
            </tal:x>
            <span class="cf-hint" tal:condition="not:x">not required</span>
          </td>
          <td tal:define="ic context/@@pfas-icons; mk python:{'badge-quarantine': 'warn', 'badge-expired': 'fail'}.get(r['status_cls'])"><tal:m
              tal:condition="mk" tal:replace="structure python:ic.tip(mk, r['status_label'])" /></td>
        </tr>
      </tbody>
    </table>
  </div>
  </div>
</html>
