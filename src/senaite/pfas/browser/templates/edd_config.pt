<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">EDD Export</title>
</head>
<body>
<tal:t metal:fill-slot="header-title">EDD Export</tal:t>
<div metal:fill-slot="content"
     tal:define="pid view/profile_id; prof view/profile; tab view/active_tab; msg view/message;
                 base string:${view/portal_url}/@@pfas-edd-config?profile=${pid}">
  <!-- the export is one tool; each delivery format is a profile, and every
       setting below is the selected profile's -->
  <form method="get" class="pfas-filterbar" data-autosubmit="data-autosubmit"
        tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
    <input type="hidden" name="tab" tal:attributes="value tab" />
    <div class="pfas-field">
    <span>Profile</span>
    <select name="profile" class="pfas-select" aria-label="Profile">
      <option tal:repeat="p view/profile_options" tal:content="p/name"
              tal:attributes="value p/id; selected python:'selected' if p['id'] == pid else None">profile</option>
    </select>
    </div>
    <tal:h define="hid string:edd-profiles"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h>
    <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-edd-batches">Batch EDDs</a>
  </form>

  <ul class="bench-alerts" tal:condition="python:msg['ok'] or msg['error']">
    <li tal:condition="msg/ok" class="bench-ok" tal:content="msg/ok">Saved.</li>
    <li tal:condition="msg/error" class="bench-bad" tal:content="msg/error">error</li>
  </ul>

  <nav class="pfas-seg pfas-seg-strip is-spaced" aria-label="Profile settings">
    <a class="pfas-seg-item" tal:repeat="t view/tabs"
       tal:attributes="href python:'%s&tab=%s' % (base, t['id']);
                       aria-selected python:'true' if tab == t['id'] else 'false'"
       tal:content="python:t['label'] + ((' (%d to code)' % view.blocking_count()) if t['id'] == 'analytes' and view.blocking_count() else '')">Defaults</a>
  </nav>

  <!-- a column-mapped profile: what stops its delivery -->
  <ul class="bench-alerts" tal:define="probs view/problems" tal:condition="probs">
    <li class="bench-warn" tal:repeat="p probs" tal:content="p">problem</li>
  </ul>

  <!-- files: the delivery's files, each one's name, rows and layout -->
  <section class="bench-block" tal:condition="python:tab == 'files' and view.mapped()">
    <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="section" value="files" />
      <div class="table-wrap">
      <table class="pfas-table pfas-table-form">
        <thead><tr><th>File name</th><th>Rows</th><th>Delimiter</th><th>Header</th><th>Header prefix</th>
          <th>Line ending</th><th>Columns</th><th>Remove</th></tr></thead>
        <tbody>
          <tr tal:repeat="f view/file_rows">
            <td><input type="text" tal:attributes="name string:f${f/i}__name; value f/name; aria-label string:File ${f/i} name" /></td>
            <td><select tal:attributes="name string:f${f/i}__grain; aria-label string:File ${f/i} rows">
              <option tal:repeat="o view/grains" tal:content="o/label"
                      tal:attributes="value o/value; selected python:'selected' if o['value'] == f['grain'] else None">g</option></select></td>
            <td><select tal:attributes="name string:f${f/i}__delimiter; aria-label string:File ${f/i} delimiter">
              <option tal:repeat="o view/delimiters" tal:content="o/label"
                      tal:attributes="value o/value; selected python:'selected' if o['value'] == f['delimiter'] else None">d</option></select></td>
            <td><select tal:attributes="name string:f${f/i}__header; aria-label string:File ${f/i} header row">
              <option tal:repeat="o view/headers" tal:content="o/label"
                      tal:attributes="value o/value; selected python:'selected' if o['value'] == f['header'] else None">h</option></select></td>
            <td><input type="text" size="3" tal:attributes="name string:f${f/i}__header_prefix; value f/header_prefix; aria-label string:File ${f/i} header prefix" /></td>
            <td><select tal:attributes="name string:f${f/i}__newline; aria-label string:File ${f/i} line ending">
              <option tal:repeat="o view/newlines" tal:content="o/label"
                      tal:attributes="value o/value; selected python:'selected' if o['value'] == f['newline'] else None">n</option></select></td>
            <td><a class="btn-sm btn-secondary" tal:attributes="href python:'%s&tab=columns&file=%d' % (base, f['i'])"
                   tal:content="string:${f/n_columns} columns">0</a></td>
            <td><input type="checkbox" value="1" tal:attributes="name string:f${f/i}__remove; aria-label string:Remove file ${f/i}" /></td>
          </tr>
        </tbody>
      </table>
      </div>
      <label class="section-gap">Package name (several files are delivered as one zip)
        <input type="text" name="package" tal:attributes="value view/package" /></label>
      <div class="filter-row section-gap">
        <button class="btn-sm btn-primary" type="submit">Save files</button>
        <tal:h define="hid string:edd-column-mapped"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h>
        <button class="btn-sm btn-secondary" type="submit" name="edd_action" value="add_file">Add file</button>
      </div>
    </form>
  </section>

  <!-- columns: one file's columns in order, each one's source, constant,
       condition, code map, format and checks -->
  <section class="bench-block" tal:condition="python:tab == 'columns' and view.mapped()"
           tal:define="fi view/file_index">
    <form method="get" class="pfas-filterbar" data-autosubmit="data-autosubmit"
          tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="tab" value="columns" />
      <div class="pfas-field"><span>File</span>
      <select name="file" class="pfas-select" aria-label="File">
        <option tal:repeat="f view/file_rows" tal:content="f/name"
                tal:attributes="value f/i; selected python:'selected' if f['i'] == fi else None">file</option>
      </select></div>
    </form>
    <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="section" value="columns" />
      <input type="hidden" name="file" tal:attributes="value fi" />
      <div class="table-wrap">
      <table class="pfas-table pfas-table-form" tal:define="sources view/source_options; maps view/map_names; lists view/list_names">
        <thead><tr><th>Order</th><th>Heading</th><th>Source</th><th>Else</th><th>Constant</th><th>Code map</th>
          <th>Format</th><th>Only when</th><th>Join</th><th>Required</th><th>Value list</th><th>Max length</th><th>Remove</th></tr></thead>
        <tbody>
          <tr tal:repeat="c view/column_rows">
            <td><input type="text" size="3" tal:attributes="name string:c${c/j}__order; value c/order; aria-label string:Column ${c/j} order" /></td>
            <td><input type="text" tal:attributes="name string:c${c/j}__heading; value c/heading; aria-label string:Column ${c/j} heading" /></td>
            <td><select tal:attributes="name string:c${c/j}__source; aria-label string:Column ${c/j} source">
              <option tal:repeat="o sources" tal:content="o/label"
                      tal:attributes="value o/value; selected python:'selected' if o['value'] == c['source'] else None">s</option></select></td>
            <td><select tal:attributes="name string:c${c/j}__fallback; aria-label string:Column ${c/j} source when blank">
              <option tal:repeat="o sources" tal:content="o/label"
                      tal:attributes="value o/value; selected python:'selected' if o['value'] == c['fallback'] else None">s</option></select></td>
            <td><input type="text" size="8" tal:attributes="name string:c${c/j}__constant; value c/constant; aria-label string:Column ${c/j} constant" /></td>
            <td><select tal:attributes="name string:c${c/j}__map; aria-label string:Column ${c/j} code map">
              <option value="">(none)</option>
              <option tal:repeat="m maps" tal:content="m"
                      tal:attributes="value m; selected python:'selected' if m == c['map'] else None">m</option></select></td>
            <td><input type="text" size="12" tal:attributes="name string:c${c/j}__format; value c/format; aria-label string:Column ${c/j} format" /></td>
            <td><input type="text" size="14" tal:attributes="name string:c${c/j}__when; value c/when; aria-label string:Column ${c/j} only when" /></td>
            <td><input type="text" size="2" tal:attributes="name string:c${c/j}__join; value c/join; aria-label string:Column ${c/j} join" /></td>
            <td><input type="checkbox" value="1" tal:attributes="name string:c${c/j}__required; checked python:'checked' if c['required'] else None; aria-label string:Column ${c/j} required" /></td>
            <td><select tal:attributes="name string:c${c/j}__list; aria-label string:Column ${c/j} value list">
              <option value="">(none)</option>
              <option tal:repeat="l lists" tal:content="l"
                      tal:attributes="value l; selected python:'selected' if l == c['list'] else None">l</option></select></td>
            <td><input type="text" size="4" tal:attributes="name string:c${c/j}__max_length; value c/max_length; aria-label string:Column ${c/j} maximum length" /></td>
            <td><input type="checkbox" value="1" tal:attributes="name string:c${c/j}__remove; aria-label string:Remove column ${c/j}" /></td>
          </tr>
        </tbody>
      </table>
      </div>
      <div class="filter-row section-gap">
        <button class="btn-sm btn-primary" type="submit">Save columns</button>
        <tal:h define="hid string:edd-column-mapped"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h>
        <input type="number" name="n_columns" value="1" step="1" min="1" max="200" aria-label="Number of columns to add" />
        <button class="btn-sm btn-secondary" type="submit" name="edd_action" value="add_columns">Add columns</button>
      </div>
    </form>
  </section>

  <!-- code maps: our value to the format's code, keyed by a second source
       where needed -->
  <section class="bench-block" tal:condition="python:tab == 'maps' and view.mapped()">
    <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config"
          tal:define="sources view/source_options; lists view/list_names">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="section" value="maps" />
      <fieldset class="section-gap" tal:repeat="m view/map_blocks">
        <legend tal:content="m/name">map</legend>
        <input type="hidden" tal:attributes="name string:m${m/k}__name; value m/name" />
        <div class="filter-row">
          <label>Also keyed by
            <select tal:attributes="name string:m${m/k}__by; aria-label string:${m/name} also keyed by">
              <option tal:repeat="o sources" tal:content="o/label"
                      tal:attributes="value o/value; selected python:'selected' if o['value'] == m['by'] else None">s</option></select></label>
          <label>Codes from the list
            <select tal:attributes="name string:m${m/k}__list; aria-label string:${m/name} codes from the list">
              <option value="">(any)</option>
              <option tal:repeat="l lists" tal:content="l"
                      tal:attributes="value l; selected python:'selected' if l == m['list'] else None">l</option></select></label>
          <label class="pfas-check"><input type="checkbox" value="1" tal:attributes="name string:m${m/k}__remove; aria-label string:Remove the map ${m/name}" /> Remove the map</label>
        </div>
        <table class="pfas-table pfas-table-form">
          <thead><tr><th>Ours</th><th>Code</th><th>Description</th><th>Remove</th></tr></thead>
          <tbody>
            <tr tal:repeat="r m/rows">
              <td><input type="text" tal:attributes="name string:m${m/k}__r${r/n}__ours; value r/ours; aria-label string:${m/name} row ${r/n} ours" /></td>
              <td><input type="text" tal:attributes="name string:m${m/k}__r${r/n}__code; value r/code; aria-label string:${m/name} row ${r/n} code" /></td>
              <td><input type="text" tal:attributes="name string:m${m/k}__r${r/n}__description; value r/description; aria-label string:${m/name} row ${r/n} description" /></td>
              <td><input type="checkbox" value="1" tal:attributes="name string:m${m/k}__r${r/n}__remove; aria-label string:${m/name} remove row ${r/n}" /></td>
            </tr>
          </tbody>
        </table>
      </fieldset>
      <div class="filter-row section-gap">
        <button class="btn-sm btn-primary" type="submit">Save maps</button>
        <tal:h define="hid string:edd-column-mapped"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h>
        <input type="text" name="new_map" placeholder="New map name" aria-label="New map name" />
        <button class="btn-sm btn-secondary" type="submit" name="edd_action" value="add_map">Add map</button>
      </div>
    </form>
  </section>

  <!-- value lists: the format's valid codes, a column at a time from the
       agency's workbook, or pasted -->
  <section class="bench-block" tal:condition="python:tab == 'lists' and view.mapped()">
    <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="section" value="lists" />
      <table class="pfas-table">
        <thead><tr><th>List</th><th>Codes</th><th>First codes</th><th>Remove</th></tr></thead>
        <tbody>
          <tr tal:repeat="l view/list_rows">
            <td tal:content="l/name">rt_unit.unit_code</td><td tal:content="l/count">3</td><td tal:content="l/sample">ng/l</td>
            <td><input type="hidden" tal:attributes="name string:l${l/n}__name; value l/name" />
              <input type="checkbox" value="1" tal:attributes="name string:l${l/n}__remove; aria-label string:Remove the list ${l/name}" /></td>
          </tr>
        </tbody>
      </table>
      <button class="btn-sm btn-secondary section-gap" type="submit">Remove the ticked lists</button>
    </form>
    <form method="post" enctype="multipart/form-data" class="section-gap"
          tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="section" value="lists" />
      <div class="field-grid">
        <label>List name <input type="text" name="list_name" /></label>
        <label>Workbook (.xlsx) <input type="file" name="upload" accept=".xlsx" /></label>
        <label>Sheet <input type="text" name="sheet" /></label>
        <label>Column <input type="text" name="column" /></label>
        <label>Or paste the codes, one per line <textarea name="pasted" rows="4"></textarea></label>
      </div>
      <button class="btn-sm btn-primary" type="submit" name="edd_action" value="import">Import list</button>
      <tal:h define="hid string:edd-column-mapped"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h>
    </form>
  </section>

  <!-- lab values: the lab's identity in this format, named for the columns -->
  <section class="bench-block" tal:condition="python:tab == 'named_defaults' and view.mapped()">
    <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="section" value="named_defaults" />
      <table class="pfas-table pfas-table-form">
        <thead><tr><th>Name</th><th>Value</th><th>Remove</th></tr></thead>
        <tbody>
          <tr tal:repeat="d view/named_rows">
            <td><input type="text" tal:attributes="name string:d${d/n}__name; value d/name; aria-label string:Lab value ${d/n} name" /></td>
            <td><input type="text" tal:attributes="name string:d${d/n}__value; value d/value; aria-label string:Lab value ${d/n} value" /></td>
            <td><input type="checkbox" value="1" tal:attributes="name string:d${d/n}__remove; aria-label string:Remove lab value ${d/n}" /></td>
          </tr>
        </tbody>
      </table>
      <button class="btn-sm btn-primary section-gap" type="submit">Save lab values</button>
    </form>
  </section>

  <!-- client fields: what a client gives for this format -->
  <section class="bench-block" tal:condition="python:tab == 'client_fields' and view.mapped()">
    <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config"
          tal:define="lists view/list_names">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="section" value="client_fields" />
      <table class="pfas-table pfas-table-form">
        <thead><tr><th>Key</th><th>Label</th><th>Value list</th><th>Remove</th></tr></thead>
        <tbody>
          <tr tal:repeat="f view/client_field_rows">
            <td><input type="text" tal:attributes="name string:cf${f/n}__key; value f/key; aria-label string:Client field ${f/n} key" /></td>
            <td><input type="text" tal:attributes="name string:cf${f/n}__label; value f/label; aria-label string:Client field ${f/n} label" /></td>
            <td><select tal:attributes="name string:cf${f/n}__list; aria-label string:Client field ${f/n} value list">
              <option value="">(none)</option>
              <option tal:repeat="l lists" tal:content="l"
                      tal:attributes="value l; selected python:'selected' if l == f['list'] else None">l</option></select></td>
            <td><input type="checkbox" value="1" tal:attributes="name string:cf${f/n}__remove; aria-label string:Remove client field ${f/n}" /></td>
          </tr>
        </tbody>
      </table>
      <button class="btn-sm btn-primary section-gap" type="submit">Save client fields</button>
    </form>
  </section>

  <!-- defaults: the lab's identity and default values in this format -->
  <section class="bench-block" tal:condition="python:tab == 'defaults'">
    <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="section" value="defaults" />
      <div class="field-grid" tal:define="fields view/default_fields"><metal:m use-macro="template/macros/field" /></div>
      <button class="btn-sm btn-primary" type="submit">Save defaults</button>
    </form>
  </section>

  <!-- methods: each method's codes in this format -->
  <section class="bench-block" tal:condition="python:tab == 'methods'">
    <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="section" value="methods" />
      <tal:m tal:repeat="m view/method_rows">
        <h2 class="bench-h" tal:content="m/method_id">EPA_537_1</h2>
        <div class="field-grid" tal:define="fields m/fields"><metal:x use-macro="template/macros/field" /></div>
      </tal:m>
      <button class="btn-sm btn-primary" type="submit">Save method codes</button>
    </form>
  </section>

  <!-- analytes: the format's name and, where it has its own, its code -->
  <section class="bench-block" tal:condition="python:tab == 'analytes'" tal:define="lab view/analyte_labels">
    <ul class="bench-alerts">
      <li class="bench-warn" tal:repeat="r python:[r for r in view.analyte_rows() if r['guidance']]"
          tal:content="r/guidance">guidance</li>
    </ul>
    <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="section" value="analytes" />
      <div class="table-wrap">
      <table class="pfas-table">
        <thead><tr><th>Analyte</th><th tal:content="lab/code">Code</th><th>Code override</th>
          <th tal:content="lab/name">Name</th><th>Note</th><th>Tentatively identified</th><th></th></tr></thead>
        <tbody>
          <tr tal:repeat="r view/analyte_rows">
            <td tal:content="r/keyword">PFOA</td>
            <td tal:content="r/code">335671</td>
            <td><input type="text" tal:attributes="name string:code_${r/safe}; value r/override" /></td>
            <td><input type="text" tal:attributes="name string:name_${r/safe}; value r/name" /></td>
            <td><input type="text" tal:attributes="name string:note_${r/safe}; value r/note" /></td>
            <td><input type="checkbox" value="1"
                       tal:attributes="name string:tic_${r/safe}; checked python:'checked' if r['tic'] else None;
                                       aria-label string:${r/keyword} is reported as tentatively identified" /></td>
            <td><span class="badge badge-expired" tal:condition="r/blocking">no code</span></td>
          </tr>
        </tbody>
      </table>
      </div>
      <button class="btn-sm btn-primary" type="submit">Save analytes</button>
    </form>
  </section>

  <!-- qualifiers / QC types: our code to the format's -->
  <tal:maps tal:repeat="mp python:[('qualifiers', 'our_qualifier', 'Our qualifier', view.qualifier_rows(), view.qualifier_codes()), ('qc_types', 'our_qc_type', 'Our QC type', view.qc_type_rows(), view.qc_type_codes())]">
  <section class="bench-block" tal:condition="python:tab == mp[0]">
    <form method="post" class="code-map" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config; data-our python:mp[1]">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="section" tal:attributes="value python:mp[0]" />
      <input type="hidden" name="rows_json" value="[]" />
      <table class="pfas-table">
        <thead><tr><th tal:content="python:mp[2]">Ours</th><th>Code</th><th>Description</th><th></th></tr></thead>
        <tbody>
          <tr tal:repeat="r python:mp[3] + [{}]">
            <td><input type="text" class="cm-our" tal:attributes="value python:r.get(mp[1], '')" /></td>
            <td><select class="cm-code">
              <option value="">&#8212;</option>
              <option tal:repeat="c python:mp[4] if (r.get('code') or '') in mp[4] or not r.get('code') else [r['code']] + mp[4]"
                      tal:content="c" tal:attributes="value c; selected python:'selected' if c == r.get('code') else None">U</option>
            </select></td>
            <td><input type="text" class="cm-desc" tal:attributes="value python:r.get('description', '')" /></td>
            <td><button class="btn-sm btn-secondary" type="button" onclick="this.closest('tr').remove()">Remove</button></td>
          </tr>
        </tbody>
      </table>
      <button class="btn-sm btn-secondary" type="button" onclick="eddAddRow(this)">+ Add row</button>
      <button class="btn-sm btn-primary" type="submit">Save</button>
    </form>
  </section>
  </tal:maps>

  <!-- value lists: the format's valid codes, refreshed from the state's file -->
  <section class="bench-block" tal:condition="python:tab == 'value_lists'" tal:define="src view/value_list_source">
    <table class="pfas-table">
      <thead><tr><th>List</th><th>Codes</th></tr></thead>
      <tbody><tr tal:repeat="v view/value_list_counts"><td tal:content="v/name">tests</td><td tal:content="v/n">10</td></tr></tbody>
    </table>
    <div class="bench-sub section-gap" tal:content="python:u'Last refreshed: %s' % (view.value_list_refreshed() or u'never (seeded)')">Last refreshed</div>
    <form method="post" enctype="multipart/form-data" class="filter-row section-gap" tal:condition="src"
          tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
      <input type="hidden" name="profile" tal:attributes="value pid" />
      <input type="hidden" name="section" value="value_lists" />
      <input type="file" name="upload" accept=".xlsx,.xls" />
      <button class="btn-sm btn-primary" type="submit" tal:content="string:Refresh from ${src/file}">Refresh</button>
      <a class="btn-sm btn-secondary" target="_blank" rel="noopener" tal:condition="src/url"
         tal:attributes="href src/url" tal:content="src/label">Source</a>
    </form>
  </section>

  <!-- test export: a batch's checks without the file -->
  <section class="bench-block" tal:condition="python:tab == 'test'">
    <form class="filter-row" onsubmit="eddPreview(this); return false;">
      <input type="text" name="batch_id" placeholder="Batch ID" />
      <button class="btn-sm btn-primary" type="submit">Check</button>
    </form>
    <pre id="edd-preview" class="mono-area"></pre>
  </section>

  <!-- profiles: clone, name, columns, headings, sample-type codes -->
  <section class="bench-block" tal:condition="python:tab == 'profiles'">
    <form method="post" class="filter-row" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
      <input type="hidden" name="section" value="profiles" />
      <input type="hidden" name="edd_action" value="clone" />
      <select name="source_id">
        <option tal:repeat="p view/profile_options" tal:attributes="value p/id" tal:content="p/name">p</option>
      </select>
      <input type="text" name="new_name" placeholder="New profile name" />
      <button class="btn-sm btn-primary" type="submit">Clone profile</button>
    </form>
    <!-- a profile whose format is its own data, started empty -->
    <form method="post" class="filter-row section-gap" tal:condition="view/new_types"
          tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
      <input type="hidden" name="section" value="profiles" />
      <input type="hidden" name="edd_action" value="new" />
      <select name="new_type" aria-label="Type of the new profile">
        <option tal:repeat="t view/new_types" tal:attributes="value t/id" tal:content="t/name">type</option>
      </select>
      <input type="text" name="new_name" placeholder="New profile name" aria-label="Name of the new profile" />
      <button class="btn-sm btn-primary" type="submit">New profile</button>
    </form>
    <details tal:repeat="p view/profile_rows" class="section-gap">
      <summary tal:content="python:u'%s · %s · %d columns' % (p['name'], p['state'] or u'-', p['n_columns'])">profile</summary>
      <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config">
        <input type="hidden" name="section" value="profiles" />
        <input type="hidden" name="edd_action" value="save" />
        <input type="hidden" name="profile_id" tal:attributes="value p/id" />
        <div class="field-grid">
          <label>Display name <input type="text" name="name" tal:attributes="value p/name" /></label>
          <label>State <input type="text" name="state" tal:attributes="value p/state" /></label>
          <label>Columns (one per line, output order)
            <textarea name="columns" rows="10" class="mono-area" tal:content="p/columns_text"></textarea></label>
          <label>Sample type to code (JSON)
            <textarea name="matrix_map_json" rows="10" class="mono-area" tal:content="p/matrix_map_json"></textarea></label>
          <label>Column headings (JSON)
            <textarea name="aliases_json" rows="5" class="mono-area" tal:content="p/aliases_json"></textarea></label>
        </div>
        <table class="pfas-table pfas-table-form" tal:condition="p/weight_rows">
          <thead><tr><th>Matrix</th><th>Sample type code</th><th>Weight basis</th></tr></thead>
          <tbody>
            <tr tal:repeat="w p/weight_rows">
              <td tal:content="w/matrix">Eggs</td>
              <td tal:content="w/code">EG</td>
              <td><input type="hidden" name="wb_matrix" tal:attributes="value w/matrix" />
                <select name="wb_basis" tal:attributes="aria-label string:Weight basis for ${w/matrix}">
                  <option value="">Choose</option>
                  <option tal:repeat="b view/weight_bases" tal:content="b"
                          tal:attributes="value b; selected python:'selected' if b == w['basis'] else None">DRY</option>
                </select></td>
            </tr>
          </tbody>
        </table>
        <button class="btn-sm btn-primary" type="submit">Save profile</button>
      </form>
      <!-- refused for the default profile and while a client uses it -->
      <form method="post" class="section-gap" tal:attributes="action string:${view/portal_url}/@@pfas-edd-config"
            onsubmit="return confirm('Delete this EDD profile?');">
        <input type="hidden" name="section" value="profiles" />
        <input type="hidden" name="edd_action" value="delete" />
        <input type="hidden" name="profile_id" tal:attributes="value p/id" />
        <button class="btn-sm btn-secondary" type="submit"
                tal:attributes="aria-label string:Delete profile ${p/name}">Delete profile</button>
      </form>
    </details>
  </section>

  <!-- one labelled field per entry of `fields` ({name, label, hint, value,
       options}): a list when the format gives one, else free text -->
  <tal:defs tal:condition="nothing">
    <metal:f define-macro="field">
      <label tal:repeat="f fields">
        <span tal:replace="f/label">Label</span>
        <select tal:condition="f/options" tal:attributes="name f/name">
          <option value="">&#8212;</option>
          <option tal:repeat="o f/options" tal:content="o"
                  tal:attributes="value o; selected python:'selected' if o == f['value'] else None">o</option>
        </select>
        <input type="text" tal:condition="not:f/options" tal:attributes="name f/name; value f/value" />
        <span class="field-hint" tal:condition="f/hint" tal:content="f/hint">hint</span>
      </label>
    </metal:f>
  </tal:defs>

  <script>
  /* a code map's rows are sent as one list */
  document.querySelectorAll('form.code-map').forEach(function (f) {
    f.addEventListener('submit', function () {
      var our = f.getAttribute('data-our'), rows = [];
      f.querySelectorAll('tbody tr').forEach(function (tr) {
        var r = {description: tr.querySelector('.cm-desc').value, code: tr.querySelector('.cm-code').value};
        r[our] = tr.querySelector('.cm-our').value;
        rows.push(r);
      });
      f.querySelector('input[name=rows_json]').value = JSON.stringify(rows);
    });
  });
  function eddAddRow(btn) {
    var tbody = btn.closest('form').querySelector('tbody');
    var last = tbody.querySelector('tr:last-child');
    var tr = last.cloneNode(true);
    tr.querySelectorAll('input').forEach(function (i) { i.value = ''; });
    tr.querySelector('select').selectedIndex = 0;
    tbody.appendChild(tr);
  }
  function eddPreview(form) {
    var out = document.getElementById('edd-preview');
    var url = '<tal:u tal:replace="view/portal_url"/>/@@pfas-edd-export?preview=1&profile=<tal:p tal:replace="view/profile_id"/>&batch_id=' +
              encodeURIComponent(form.batch_id.value.trim());
    out.textContent = 'Checking...';
    fetch(url, {credentials: 'same-origin'}).then(function (r) { return r.json(); }).then(function (d) {
      out.textContent = d.error ? d.error :
        (d.filename + '\n' + d.row_count + ' rows, ' + d.blocking_count + ' blocking, ' +
         d.error_count + ' errors\n\n' + (d.validation_report || ''));
    }).catch(function (e) { out.textContent = 'Request failed: ' + e; });
  }
  </script>
</div>
</body>
</html>
