<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Bench</title>

  <metal:fill fill-slot="header-title">Bench</metal:fill>


  <metal:fill fill-slot="content">
    <section class="bench-block" tal:define="al view/alerts; bal view/balances_today">
      <h2 class="bench-h">Needs attention</h2>
      <ul class="bench-alerts" tal:define="ic context/@@pfas-icons">
        <li tal:repeat="n view/notices" class="bench-bad">
          <span class="pfas-alert-mark" tal:content="structure python:ic.svg('fail', size='md')"></span>
          <strong tal:content="n/title">Run sent back</strong>
          <a class="btn-sm btn-secondary" tal:attributes="href n/url" tal:content="n/ws_id">WS-1</a>
          <span tal:content="n/text">lot rejected</span></li>
        <li tal:repeat="r view/run_requests" class="bench-warn">
          <span class="pfas-alert-mark" tal:content="structure python:ic.svg('warn', size='md')"></span>
          <strong tal:content="python:('Dilution 1 in %s' % r['fold']) if r['kind'] == 'dilution' else 'Re-injection'">Dilution</strong>
          <a class="btn-sm btn-secondary" tal:attributes="href r/url" tal:content="r/injection">DW-0012</a>
          <span tal:content="string:(${r/worksheet})">(WS-1)</span></li>
        <li tal:repeat="it python:al['expired'][:5]" class="bench-bad">
          <span class="pfas-alert-mark" tal:content="structure python:ic.svg('fail', size='md')"></span>
          <strong>Expired</strong> <span tal:content="it/kind_label">Reagent</span>
          <span tal:content="it/name">Methanol</span>, lot <span tal:content="it/lot_number">L1</span>
          (<span tal:content="it/expiry">2026-01-01</span>)</li>
        <li tal:repeat="it python:al['quarantined'][:5]" class="bench-bad">
          <span class="pfas-alert-mark" tal:content="structure python:ic.svg('fail', size='md')"></span>
          <strong>Quarantined</strong> <span tal:content="it/kind_label">Reagent</span>
          <span tal:content="it/name">x</span>, lot <span tal:content="it/lot_number">L1</span></li>
        <li tal:repeat="it python:al['expiring'][:5]" class="bench-warn">
          <span class="pfas-alert-mark" tal:content="structure python:ic.svg('warn', size='md')"></span>
          <strong>Expires <span tal:replace="it/expiry">2026-11-01</span></strong>
          <span tal:content="it/kind_label">Reagent</span> <span tal:content="it/name">x</span>,
          lot <span tal:content="it/lot_number">L1</span></li>
        <li tal:repeat="it python:al['low'][:5]" class="bench-warn">
          <span class="pfas-alert-mark" tal:content="structure python:ic.svg('warn', size='md')"></span>
          <strong>Low stock</strong> <span tal:content="it/name">x</span>, lot
          <span tal:content="it/lot_number">L1</span>:
          <span tal:content="python:'%s %s' % (it.get('quantity_value'), it.get('quantity_unit') or '')">1 L</span> left</li>
        <li class="bench-sub" tal:define="extra python:sum(max(len(v) - 5, 0) for v in al.values())"
            tal:condition="extra">
          <span tal:replace="extra">3</span> more not shown.
          <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-reagents">Reagent inventory</a>
          <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-prep-standards">Prepared standards</a></li>
        <tal:b condition="python:bal is None">
          <li class="bench-warn"><strong>No balances registered</strong> under Equipment, so
            today&#8217;s balance check cannot be shown.</li>
        </tal:b>
        <tal:b condition="bal">
          <li tal:repeat="u bal" tal:attributes="class python:'bench-ok' if u['verified'] else 'bench-warn'">
            <strong tal:content="python:'Checked today' if u['verified'] else 'Not checked today'">Checked</strong>
            balance <span tal:content="u/name">XPR205</span>
            (<span tal:content="u/serial">S/N</span>)</li>
        </tal:b>
        <li class="bench-ok" tal:condition="python:not any(al.values()) and bal and all(u['verified'] for u in bal)">
          Nothing needs attention.</li>
      </ul>
    </section>

    <section class="bench-block" tal:define="pg view/queue_paging; rows view/queue_rows">
      <h2 class="bench-h">Extractions</h2>
      <form method="get" class="pfas-filterbar" data-autosubmit="data-autosubmit"
            tal:attributes="action string:${view/portal_url}/@@pfas-bench">
        <input type="hidden" name="show" tal:attributes="value view/queue_show" />
        <div class="pfas-form-field"><span>Show</span>
          <nav class="pfas-seg" aria-label="Show">
            <a class="pfas-seg-item" tal:repeat="o view/queue_shows"
               tal:attributes="href o/url; aria-selected python:'true' if o['on'] else 'false'"
               tal:content="o/label">Not finished</a>
          </nav></div>
        <div class="pfas-form-field"><label for="bench-q">Search</label>
          <input type="search" name="q" id="bench-q" class="pfas-input pfas-input-wide"
                 placeholder="Worksheet, CoC or method" tal:attributes="value view/queue_q" /></div>
        <noscript><button type="submit" class="btn btn-primary">Filter</button></noscript>
      </form>
      <table class="pfas-table" data-col-resize="pfas-bench-1" tal:condition="rows" tal:define="rm context/@@pfas-row-menu">
        <thead><tr><th>Worksheet</th><th>Method</th><th>Extraction</th><th>Analyst</th></tr></thead>
        <tbody>
          <tal:rw tal:repeat="r rows">
          <tr tal:define="act python:view.queue_action(r)"
              tal:attributes="data-row-open python:view.queue_open_url(r);
                              data-row-actions python:rm.actions(
                                  (act['label'], 'href', act['url']) if act and act['url'] != view.queue_open_url(r) else None,
                                  (u'Remove', 'form', u'bench-remove-%s' % r['uid'], {'danger': True}) if r['can_remove'] else None)">
            <td><strong tal:content="r/id">B-1</strong>
                <span class="bench-sub" tal:content="r/title">title</span></td>
            <td tal:content="r/method_label">FDA 32-PFAS</td>
            <td><span tal:attributes="class python:'bench-state bench-' + r['state']"
                      tal:content="r/label">Not started</span></td>
            <td tal:content="r/analyst">DEMO</td>
          </tr>
          </tal:rw>
        </tbody>
      </table>
      <!-- an empty worksheet is removed by core's own Remove transition -->
      <tal:rv tal:repeat="r rows">
        <form method="post" class="pfas-inline-form" hidden="hidden" tal:condition="r/can_remove"
              tal:attributes="action string:${view/portal_url}/worksheets/workflow_action;
                              id string:bench-remove-${r/uid};
                              onsubmit string:return confirm('Remove ${r/id}? It holds no samples.')">
          <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
          <input type="hidden" name="workflow_action" value="remove" />
          <input type="hidden" name="uids" tal:attributes="value r/uid" />
          <input type="hidden" name="redirect_url" tal:attributes="value string:${view/portal_url}/@@pfas-bench" />
          <button type="submit" class="btn-sm btn-secondary">Remove</button>
        </form>
      </tal:rv>
      <p class="bench-sub" tal:condition="not:rows" tal:content="view/queue_empty_text">None.</p>
      <metal:p use-macro="context/@@pfas-macros/macros/paging" />
    </section>

    <div class="pfas-ws-grid" tal:define="sections view/sections">
      <a class="pfas-ws-card"
         tal:repeat="s sections"
         tal:attributes="href s/url">
        <span class="pfas-ws-card-icon"><svg class="pfas-ico" aria-hidden="true"><use tal:attributes="href string:#${s/icon}"/></svg></span>
        <span class="pfas-ws-card-title" tal:content="s/title">Title</span>
        <span class="pfas-ws-card-desc"  tal:content="s/desc">Description</span>
      </a>
    </div>
  </metal:fill>

</html>
