<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Bench</title>

  <metal:fill fill-slot="header-title">Bench</metal:fill>


  <metal:fill fill-slot="content">
    <section class="bench-block">
      <h2 class="bench-h">Extractions</h2>
      <table class="pfas-table" tal:define="rows view/extractions" tal:condition="rows">
        <thead><tr><th>Batch</th><th>Method</th><th>Extraction</th><th>Analyst</th><th></th></tr></thead>
        <tbody>
          <tr tal:repeat="r rows">
            <td><strong tal:content="r/id">B-1</strong> <span class="bench-sub" tal:content="r/title">title</span></td>
            <td tal:content="r/method_label">FDA 32-PFAS</td>
            <td><span tal:attributes="class python:'bench-state bench-' + r['state']"
                      tal:content="r/label">Not started</span></td>
            <td tal:content="r/analyst">DEMO</td>
            <td><a class="btn-sm btn-primary"
                   tal:attributes="href string:${view/portal_url}/@@pfas-extraction-guide?batch_uid=${r/uid}"
                   tal:content="python:{'not_started': 'Start extraction', 'in_progress': 'Continue'}.get(r['state'], 'View')">Start extraction</a></td>
          </tr>
        </tbody>
      </table>
      <p class="bench-sub" tal:condition="not:view/extractions">No open batches.</p>
    </section>

    <section class="bench-block" tal:define="al view/alerts; bal view/balances_today">
      <h2 class="bench-h">Needs attention</h2>
      <ul class="bench-alerts">
        <li tal:repeat="r view/run_requests" class="bench-warn">
          <strong tal:content="python:('Dilution 1 in %s' % r['fold']) if r['kind'] == 'dilution' else 'Re-injection'">Dilution</strong>
          <span tal:content="string:${r/injection} (${r/worksheet})">DW-0012 (WS-1)</span>
          <a class="btn-sm btn-secondary" tal:attributes="href r/url">Open</a></li>
        <li tal:repeat="it python:al['expired'][:5]" class="bench-bad">
          <strong>Expired</strong> <span tal:content="it/kind_label">Reagent</span>
          <span tal:content="it/name">Methanol</span>, lot <span tal:content="it/lot_number">L1</span>
          (<span tal:content="it/expiry">2026-01-01</span>)</li>
        <li tal:repeat="it python:al['quarantined'][:5]" class="bench-bad">
          <strong>Quarantined</strong> <span tal:content="it/kind_label">Reagent</span>
          <span tal:content="it/name">x</span>, lot <span tal:content="it/lot_number">L1</span></li>
        <li tal:repeat="it python:al['expiring'][:5]" class="bench-warn">
          <strong>Expires <span tal:replace="it/expiry">2026-11-01</span></strong>
          <span tal:content="it/kind_label">Reagent</span> <span tal:content="it/name">x</span>,
          lot <span tal:content="it/lot_number">L1</span></li>
        <li tal:repeat="it python:al['low'][:5]" class="bench-warn">
          <strong>Low stock</strong> <span tal:content="it/name">x</span>, lot
          <span tal:content="it/lot_number">L1</span>:
          <span tal:content="python:'%s %s' % (it.get('quantity_value'), it.get('quantity_unit') or '')">1 L</span> left</li>
        <li class="bench-sub" tal:define="extra python:sum(max(len(v) - 5, 0) for v in al.values())"
            tal:condition="extra">
          <span tal:replace="extra">3</span> more not shown.
          <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-reagents">Reagent inventory</a>
          <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-prep-standards">Prepared standards</a></li>
        <tal:b condition="python:bal is None">
          <li class="bench-warn"><strong>No balances registered</strong> in Facility QC, so
            today&#8217;s balance verification cannot be shown.</li>
        </tal:b>
        <tal:b condition="bal">
          <li tal:repeat="u bal" tal:attributes="class python:'bench-ok' if u['verified'] else 'bench-warn'">
            <strong tal:content="python:'Verified today' if u['verified'] else 'Not verified today'">Verified</strong>
            balance <span tal:content="u/name">XPR205</span>
            (<span tal:content="u/serial">S/N</span>)</li>
        </tal:b>
        <li class="bench-ok" tal:condition="python:not any(al.values()) and bal and all(u['verified'] for u in bal)">
          Nothing needs attention.</li>
      </ul>
    </section>

    <div class="pfas-ws-grid" tal:define="sections view/sections">
      <a class="pfas-ws-card"
         tal:repeat="s sections"
         tal:attributes="href s/url">
        <span class="pfas-ws-card-icon" tal:content="s/icon">i</span>
        <span class="pfas-ws-card-title" tal:content="s/title">Title</span>
        <span class="pfas-ws-card-desc"  tal:content="s/desc">Description</span>
      </a>
    </div>
  </metal:fill>

</html>
