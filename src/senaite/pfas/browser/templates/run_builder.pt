<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">LC-MS Run Builder</title>
</head>
<body>
  <tal:t metal:fill-slot="header-title">LC-MS Run Builder</tal:t>

  <div metal:fill-slot="content">
  <div class="page-body">

    <div class="alert alert-success" tal:condition="view/ok_msg"
         tal:content="view/ok_msg">ok</div>
    <div class="alert alert-error" tal:condition="view/error_msg"
         tal:content="view/error_msg">err</div>
    <ul class="bench-alerts" tal:define="ips view/import_problems" tal:condition="ips">
      <li tal:repeat="ip ips"
          tal:attributes="class python:'bench-bad' if ip['status'] in ('failed', 'refused') else 'bench-warn'">
        <strong tal:content="python:{'failed': u'Import failed:', 'refused': u'Import refused:'}.get(ip['status'], u'Import retrying:')">Import</strong>
        <span tal:condition="python:ip['status'] == 'refused'" tal:content="python:u'%s: %s.' % (ip['file'], ip['error'])">x</span>
        <span tal:condition="python:ip['status'] != 'refused'" tal:content="python:u'%s, attempt %s (%s). %s' % (ip['file'], ip['attempts'], ip['error'], u'Upload the run again.' if ip['status'] == 'failed' else u'The worker tries again shortly.')">x</span></li>
    </ul>
    <div class="alert alert-success" tal:condition="view/built">
      Run built and saved to the worksheet&#8217;s manifest — download the worklist below.
    </div>
    <div class="alert alert-error" tal:define="w request/form/warn|nothing" tal:condition="w" tal:content="w">warning</div>

    <p class="pfas-lead is-narrow" tal:condition="view/selected_batch">The run follows the worksheet: its method&rsquo;s extraction log supplies the samples. Choose the analyst and confirm them.</p>
    <p class="pfas-lead is-narrow" tal:condition="not:view/selected_batch">Pick the worksheet to build a run for.</p>

    <!-- a chosen worksheet: the filter bar switches to another; its blank
         option leads back to the lists -->
    <form method="get" class="pfas-filterbar is-narrow" tal:condition="view/selected_batch"
          tal:attributes="action string:${view/portal_url}/@@pfas-run-builder">
      <div class="pfas-form-field">
        <label for="batch_id">Worksheet</label>
        <select name="batch_id" id="batch_id" class="pfas-select" onchange="this.form.submit()">
          <option value="">— select worksheet —</option>
          <option tal:repeat="b view/batches"
                  tal:attributes="value b/id;
                                  selected python:b['id'] == view.selected_batch()"
                  tal:content="b/title">WS-1</option>
        </select>
      </div>
    </form>

    <!-- no worksheet chosen: two lists, each row opening its worksheet's
         run. Ready to build: the extraction finalized and no run built, or
         the run sent back. In progress: the run built and waiting at a later
         step, which its row names and opens. Each empty list says why; a
         list that cannot be read says so and never reads as empty. -->
    <tal:landing condition="not:view/selected_batch">
    <div class="pfas-card is-spaced" id="rb-ready" tal:define="ready view/ready_to_build">
      <h3>Ready to build</h3>
      <table class="pfas-table" tal:condition="ready">
        <tbody>
          <tr tal:repeat="r ready" tal:attributes="data-row-open r/url">
            <td><strong tal:content="r/id">WS-298</strong>
              <span class="pfas-muted" tal:condition="r/about" tal:content="r/about">COC-2026-0001</span></td>
            <td class="pfas-muted"><tal:s condition="r/sent_back">Sent back: <tal:w replace="r/sent_back">why</tal:w></tal:s></td>
          </tr>
        </tbody>
      </table>
      <p class="pfas-empty" tal:condition="python:ready == []">No worksheet is ready to build: one is listed once its extraction is finalized.
        <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-extraction-guide">Extraction Guide</a></p>
      <p class="pfas-muted" tal:condition="python:ready is None">Could not list the worksheets.</p>
    </div>
    <div class="pfas-card is-spaced" id="rb-going" tal:define="going view/in_progress">
      <h3>In progress</h3>
      <table class="pfas-table" tal:condition="going">
        <tbody>
          <tr tal:repeat="r going" tal:attributes="data-row-open r/url">
            <td><strong tal:content="string:${r/id} &#183; ${r/label}">WS-313 &#183; step 3, import results</strong>
              <span class="pfas-muted" tal:condition="r/about" tal:content="r/about">COC-2026-0001</span></td>
          </tr>
        </tbody>
      </table>
      <p class="pfas-empty" tal:condition="python:going == []">No run is in progress: a built run is listed until its results and dilutions are in.</p>
      <p class="pfas-muted" tal:condition="python:going is None">Could not list the worksheets.</p>
    </div>
    <!-- every other open worksheet: its extraction's state and why it is
         not ready; the row's menu goes to where it moves on -->
    <div class="pfas-card is-spaced" id="rb-other" tal:define="other view/other_worksheets"
         tal:condition="other">
      <h3>Not ready</h3>
      <table class="pfas-table" data-col-resize="run-builder-not-ready" tal:define="rm context/@@pfas-row-menu">
        <thead><tr><th>Worksheet</th><th>Extraction</th><th>Why not ready</th></tr></thead>
        <tbody>
          <tr tal:repeat="r other"
              tal:attributes="data-row-open r/url;
                              data-row-actions python:rm.actions((r['next_label'], 'href', r['next_url']))">
            <td><strong tal:content="r/id">WS-340</strong>
              <span class="pfas-muted" tal:condition="r/about" tal:content="r/about">COC-2026-0001</span></td>
            <td tal:content="r/state">Stage 3 of 7</td>
            <td tal:content="r/reason">Extraction not finalised</td>
          </tr>
        </tbody>
      </table>
    </div>
    </tal:landing>

    <tal:ctx tal:define="ctx view/run_context" tal:condition="ctx">
      <div class="pfas-banner is-plain">
        <span>Method: <b tal:content="python:view.method_name(ctx['method_id'])">FDA</b></span>
        <span>Extraction record: <b tal:content="ctx/extraction_label">the guided extraction</b></span>
        <span>CCV every <b tal:content="ctx/ccv_interval">6</b> samples
              <span class="pfas-muted">set by the method</span></span>
        <span>Samples found: <b tal:content="ctx/n_samples">3</b></span>
        <span>Run template: <b tal:content="python:view.method_name(ctx['method_id'])">FDA</b>
              <span class="pfas-muted">set by the method</span></span>
      </div>
      <!-- the chosen worksheet is not ready: why, and where it moves on -->
      <p class="pfas-banner is-warn" tal:define="nr view/selected_not_ready" tal:condition="nr">
        <span><b tal:content="nr/id"></b> <tal:r replace="nr/reason"></tal:r>
          <span class="pfas-muted" tal:condition="nr/state" tal:content="nr/state"></span></span>
        <a class="btn-sm btn-secondary" tal:attributes="href nr/guide_url">Extraction Guide</a>
      </p>

      <!-- one step at a time -->
      <nav class="pfas-seg is-spaced" role="tablist" aria-label="Run steps" data-tabs="data-tabs"
           tal:define="st view/active_step">
        <button type="button" class="pfas-seg-item" role="tab" tal:repeat="s view/STEPS"
                tal:attributes="data-pane python:'step-%s' % s[0];
                                aria-selected python:'true' if s[0] == st else 'false'"
                tal:content="python:s[1]">1 &#183; Build the run</button>
      </nav>

      <div>
        <!-- ── 1. Build ─────────────────────────────────────────────────── -->
        <div id="step-1" tal:attributes="class python:'pfas-card pfas-pane' + (' is-active' if view.active_step() == '1' else '')">
          <h3>1 · Build the run <tal:h define="hid string:guided-extraction"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></h3>

          <div class="table-wrap" tal:condition="ctx/rows">
            <table class="pfas-table" data-col-resize="run-builder-1">
              <thead><tr><th>Sample</th><th>Matrix</th><th>Spike</th><th>Planned dilution</th><th>Route</th><th>Runs</th></tr></thead>
              <tbody>
                <tr tal:repeat="r ctx/rows">
                  <td tal:content="r/sample_id">DW-1</td>
                  <td tal:content="python:r['matrix'] or '—'">Eggs</td>
                  <td tal:content="python:r['spike'] or '—'">80</td>
                  <!-- a box holds a value or nothing: each box is named by
                       its label outside it, a share or a volume pair -->
                  <td class="rb-pdil">
                    <div class="pfas-inline">
                      <input type="number" min="0" step="any" class="is-short" form="build"
                             tal:attributes="name string:pdil_pct.${r/sample_id}; aria-label string:Share of the extract, %, ${r/sample_id}" />
                      <span class="pfas-unit">%</span>
                      <span class="pfas-muted">or</span>
                      <input type="number" min="0" step="any" class="is-short" form="build"
                             tal:attributes="name string:pdil_take.${r/sample_id}; aria-label string:Volume taken, ${r/sample_id}" />
                      <span class="pfas-unit">taken</span>
                      <span class="pfas-unit">made up to</span>
                      <input type="number" min="0" step="any" class="is-short" form="build"
                             tal:attributes="name string:pdil_to.${r/sample_id}; aria-label string:Made up to, ${r/sample_id}" />
                    </div>
                    <div class="pfas-hint rb-fold"></div></td>
                  <td><select form="build" tal:attributes="name string:proute.${r/sample_id}; aria-label string:Route, ${r/sample_id}">
                        <option tal:repeat="rt view/dilution_routes" tal:attributes="value python:rt[0]"
                                tal:content="python:rt[1]">Dilute the extract</option></select></td>
                  <!-- the segment writes the hidden field the build reads -->
                  <td><input type="hidden" value="with" form="build"
                             tal:attributes="name string:pruns.${r/sample_id}; id string:pruns-${r/sample_id}" />
                    <div class="pfas-seg pfas-seg-sm is-fit" role="group" data-field="data-field" data-quiet="data-quiet"
                         tal:attributes="data-input string:pruns-${r/sample_id}; aria-label string:Runs, ${r/sample_id}">
                      <button type="button" class="pfas-seg-item" data-value="with" aria-pressed="true">With this run</button>
                      <button type="button" class="pfas-seg-item" data-value="separately" aria-pressed="false">Separately</button>
                    </div></td>
                </tr>
              </tbody>
            </table>
            <script type="text/javascript">
            //<![CDATA[
            /* the factor beside a planned dilution, as it is typed */
            document.querySelectorAll('td.rb-pdil').forEach(function (td) {
              var ins = td.querySelectorAll('input'), out = td.querySelector('.rb-fold');
              function show() {
                var p = parseFloat(ins[0].value), t = parseFloat(ins[1].value), v = parseFloat(ins[2].value);
                var f = p ? 100 / p : (t && v ? v / t : 0);
                out.textContent = f > 1 ? '= ' + (Math.round(f * 100) / 100) + '-fold' : '';
              }
              td.addEventListener('input', show);
            });
            //]]>
            </script>
          </div>
          <p tal:condition="not:ctx/rows" class="pfas-banner is-warn">
            No samples found: complete the extraction log, or add sample names below.
          </p>

          <form method="post" id="build"
                tal:attributes="action string:${view/portal_url}/@@pfas-run-builder">
            <input type="hidden" name="action" value="build"/>
            <input type="hidden" name="batch_id"
                   tal:attributes="value view/selected_batch"/>
            <div class="pfas-form-row">
              <div class="pfas-form-field is-spaced" tal:define="staff view/staff_pool">
                <!-- the label names what the box takes: a name from the pool, else initials -->
                <label for="initials" tal:content="python:'Analyst' if staff else 'Analyst initials'">Analyst</label>
                <select name="initials" id="initials" class="pfas-select is-fit" required="required" tal:condition="staff">
                  <option value="">— select analyst —</option>
                  <option tal:repeat="p staff"
                          tal:attributes="value p/initials"
                          tal:content="string:${p/fullname} (${p/initials})">A (AB)</option>
                </select>
                <tal:empty tal:condition="not:staff">
                  <input type="text" name="initials" id="initials" maxlength="4" class="pfas-input is-upper"/>
                  <span class="pfas-hint">No analysts: add Lab Contacts in
                    <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/bika_setup/bika_labcontacts">SENAITE setup</a>
  </span>
                </tal:empty>
              </div>
              <div class="pfas-form-field is-spaced is-full">
                <label for="extra_samples">Additional sample names, one per line</label>
                <textarea name="extra_samples" id="extra_samples" rows="3" class="pfas-textarea"></textarea>
              </div>
              <div class="pfas-form-field is-spaced" tal:condition="view/made_requests">
                <span>Run</span>
                <div class="pfas-radios">
                  <label class="pfas-check"><input type="radio" name="run_kind" value="full"
                         tal:attributes="checked python:None if request.get('run_kind') == 'supplementary' else 'checked'" /> The whole worksheet</label>
                  <label class="pfas-check"><input type="radio" name="run_kind" value="supplementary"
                         tal:attributes="checked python:'checked' if request.get('run_kind') == 'supplementary' else None" />
                    <span tal:replace="python:'Only what review asked for (%d made)' % len(view.made_requests())">Only requests</span></label>
                </div>
              </div>
              <!-- a new calibration curve: the method profile's rule, else the
                   bench chemist answers (run_plan.curve_decision) -->
              <div class="pfas-form-field is-spaced" tal:define="cd view/curve_decision" tal:condition="cd">
                <span>Is a new calibration curve needed?</span>
                <tal:f condition="cd/forced">
                  <strong>Yes</strong> &mdash; <span tal:replace="cd/reason">reason</span>
                  <input type="hidden" name="new_curve" value="yes" />
                </tal:f>
                <tal:a condition="not:cd/forced">
                  <span class="pfas-hint" tal:content="string:${cd/reason}."></span>
                  <div class="pfas-radios">
                    <label class="pfas-check"><input type="radio" name="new_curve" value="yes" required="required" /> Yes, run a new curve</label>
                    <label class="pfas-check"><input type="radio" name="new_curve" value="no"
                                  tal:attributes="checked python:'checked' if cd.get('default') == 'reuse' else None" /> No, use the last curve</label>
                  </div>
                </tal:a>
              </div>
            </div>
            <!-- what the instrument is loaded with: each lot in date on the
                 run date (run_lots.py); the levels and the ICV for a new curve -->
            <tal:l define="mid ctx/method_id; series python:view.series_options(mid)">
            <div class="section-group-hdr">Loaded on the instrument <tal:h define="hid string:calibration-decision"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></div>
            <div class="cf-settings">
              <!-- the levels made on one preparation record load as one: the run records each level's lot -->
              <div class="cf-label"><label for="cal_series">Calibration series</label></div>
              <div class="cf-control">
                <select name="cal_series" id="cal_series">
                  <option value="" tal:content="python:'Choose a series preparation' if series else 'No calibration series has been prepared'">Choose a series preparation</option>
                  <option tal:repeat="e series" tal:attributes="value e/id" tal:content="e/label">CAL-537 &#183; CAL-537-261105-01</option>
                </select>
              </div>
              <tal:s repeat="sl python:[x for x in view.run_slots(mid, True) if not x[0].startswith('CAL-')]">
              <div class="cf-label"><label tal:attributes="for python:'lot__%s' % sl[0]" tal:content="python:sl[1]">CAL-1</label></div>
              <div class="cf-control">
                <select tal:attributes="id python:'lot__%s' % sl[0]; name python:'lot__%s' % sl[0]; data-slot python:sl[0]">
                  <tal:o tal:define="opts python:view.slot_options(sl[0], mid)">
                  <option value="" tal:content="python:'Choose a lot' if opts else 'No lot made for this slot'">Choose a lot</option>
                  <option tal:repeat="o opts" tal:attributes="value python:o[0]" tal:content="python:o[1]">CAL-1 &#183; C1</option>
                  </tal:o>
                </select>
              </div>
              </tal:s>
            </div>
            </tal:l>
            <!-- an extraction not finalised refuses the build (the banner above
                 says why and opens the guide) -->
            <button class="btn btn-primary" type="submit" tal:condition="not:view/selected_not_ready">Build Run Sequence</button>
          </form>
        </div>
      </div>


      <!-- ── 4 · Dilutions and re-injections review asked for ─────────── -->
      <div class="pfas-pane" id="step-4" tal:condition="not:view/review_requests"
           tal:attributes="class python:'pfas-pane' + (' is-active' if view.active_step() == '4' else '')">
        <p class="pfas-note-sm">No dilution or re-injection has been asked for.</p>
      </div>
      <div id="step-4" tal:define="reqs view/review_requests" tal:condition="reqs"
           tal:attributes="class python:'pfas-card is-spaced pfas-pane' + (' is-active' if view.active_step() == '4' else '')">
        <div class="pfas-between">
          <h3>4 &#183; Dilutions and re-injections <tal:h define="hid string:dilution"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></h3>
          <a class="btn btn-secondary" tal:condition="view/made_requests"
             tal:attributes="href string:${view/portal_url}/@@pfas-run-builder?batch_id=${view/selected_batch}&amp;run_kind=supplementary#build">Build follow-up run</a>
        </div>
        <table class="pfas-table" data-col-resize="run-builder-2" tal:define="rm context/@@pfas-row-menu">
          <thead><tr><th>Injection</th><th>Asked for</th><th>Why</th><th>Asked by</th><th>Status</th><th>Made as</th></tr></thead>
          <tbody>
            <tr tal:repeat="r reqs"
                tal:attributes="data-row-actions python:rm.actions(
                                    (u'Make', 'modal', u'make-%s' % r['id']) if r['status'] == 'open' else None)">
              <td class="pfas-mono" tal:content="r/injection">537_GW_GW-0006_261006-01</td>
              <td tal:content="r/asked">Dilution 1:10</td>
              <td tal:content="r/reason">over range</td>
              <td tal:content="r/requested_by">AN1</td>
              <td><span tal:attributes="class python:'badge badge-ok' if r['status'] == 'made' else 'badge badge-pending'"
                        tal:content="python:r['status'].capitalize()">Open</span></td>
              <td class="pfas-mono">
                <tal:m tal:content="r/new_injection">537_GW_GW-0006_261006-01_DIL10</tal:m>
                <tal:pf condition="python:r.get('matches') is not None" define="pf_ok r/matches"><span metal:use-macro="context/@@pfas-macros/macros/pass-mark"></span></tal:pf>
              </td>
            </tr>
          </tbody>
        </table>
        <tal:dialogs tal:repeat="r reqs" tal:define="opts view/make_options">
        <tal:mk define="make_url string:${view/portal_url}/@@pfas-run-builder; make_action string:make_request;
                        make_hidden python:[('batch_id', view.selected_batch())]">
          <metal:d use-macro="context/@@pfas-dilution-make-macros/macros/make-dialog" />
        </tal:mk>
        </tal:dialogs>
      </div>

      <!-- the run template is the method's, edited on its profile's Run Template tab -->
    </tal:ctx>

    <!-- ── Built sequence + download ──────────────────────────────────── -->
    <div class="pfas-pane" id="step-2" tal:condition="python:view.selected_batch() and not view.manifest()"
         tal:attributes="class python:'pfas-pane' + (' is-active' if view.active_step() == '2' else '')">
      <p class="pfas-note-sm">Build the run first.</p>
    </div>
    <tal:man tal:define="m view/manifest" tal:condition="m">
      <div class="pfas-banner is-warn" tal:condition="python:m.get('sent_back')">
        Sent back: <span tal:content="python:m['sent_back'].get('reason')">why</span>
      </div>
      <div id="step-2" tal:attributes="class python:'pfas-card is-spaced pfas-pane' + (' is-active' if view.active_step() == '2' else '')">
        <h3 class="is-row">
          <span>2 &#183; Load on the instrument &#8212; <span tal:content="m/batch_id">B</span></span>
          <span class="pfas-muted">
            <span tal:content="python:view.lab_at(m.get('built_at'), m.get('built_at'))">ts</span> by
            <span tal:content="m/built_by">INI</span> ·
            <span tal:content="python:view.method_name(m.get('method_id'))">FDA</span> ·
            CCV/<span tal:content="m/ccv_interval">6</span>
          </span>
          <a class="btn btn-primary is-end" title="The run in the instrument software's sample-list format: import it on the LC-MS PC"
             tal:attributes="href string:${view/portal_url}/@@pfas-run-builder?action=download_masslynx&batch_id=${m/batch_id}">
            Load Injection List to LC-MS/MS
          </a>
          <a class="btn btn-secondary" title="The same injections as a spreadsheet, with the table's columns, to keep or print"
             tal:attributes="href string:${view/portal_url}/@@pfas-run-builder?action=download_csv&batch_id=${m/batch_id}">
            Backup CSV
          </a>
          <tal:h define="hid string:sequence-export"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h>
        </h3>
        <p class="pfas-note-sm">The LIMS does not send the run to the instrument: load the instrument sample list on its computer.</p>
        <p class="pfas-note-sm" tal:condition="m/loaded|nothing">Loaded on the instrument by
          <b tal:content="m/loaded/by">INI</b>,
          <span tal:content="python:view.lab_at(m['loaded'].get('at'), m['loaded'].get('at'))">2026-11-12 09:30</span>.</p>
        <form method="post" class="is-spaced" tal:condition="python:not m.get('loaded') and view.can_mark_loaded()"
              tal:attributes="action string:${view/portal_url}/@@pfas-run-builder">
          <input type="hidden" name="action" value="mark_loaded"/>
          <input type="hidden" name="batch_id" tal:attributes="value m/batch_id"/>
          <button class="btn btn-primary" type="submit"
                  title="Record that you loaded this run on the instrument">Loaded</button>
        </form>
        <div class="table-wrap">
          <table class="pfas-table" data-col-resize="run-builder-3">
            <thead><tr><th>Vial</th><th>Injection name</th><th>Lot</th>
                       <th>Description</th><th>Type</th></tr></thead>
            <tbody tal:define="std python:m.get('standards') or {}; row_lot python:__import__('senaite.pfas.run_lots', fromlist=['row_lot']).row_lot;
                               ti context/@@pfas-type-icons">
              <tr tal:repeat="r m/rows">
                <td tal:content="r/vial">1</td>
                <td class="pfas-mono" tal:content="r/name">name</td>
                <td class="pfas-mono" tal:content="python:row_lot(r, std)">L1</td>
                <td class="pfas-muted-cell"
                    tal:content="python:r.get('description','')">desc</td>
                <!-- the row's role as its type's icon, named on hover and to a screen reader -->
                <td><span class="pfas-type-cell"><tal:i tal:replace="structure python:ti.svg(r.get('role') or u'')" /><span tal:attributes="class python:{'Standard': 'pfas-text-accent', 'QC': 'pfas-text-warn', 'Sample': 'pfas-text-ok'}.get(r['type'], 'pfas-muted')"
                          tal:content="r/type">QC</span></span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </tal:man>

    <!-- ── 3. Import results ───────────────────────────────────────────── -->
    <div id="step-3" tal:condition="view/selected_batch"
         tal:attributes="class python:'pfas-card is-spaced pfas-pane' + (' is-active' if view.active_step() == '3' else '')">
      <h3>3 &#183; Import results <tal:h define="hid string:import-profiles"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></h3>
      <p class="pfas-note-sm">After the run, upload the instrument&rsquo;s results export; it is read with the instrument&rsquo;s active Import Studio layout.</p>
      <form method="post" enctype="multipart/form-data" class="rb-upload"
            tal:attributes="action string:${view/portal_url}/@@pfas-run-builder">
        <input type="hidden" name="action" value="upload_export"/>
        <input type="hidden" name="batch_id" tal:attributes="value view/selected_batch"/>
        <input type="file" name="export_file" accept=".csv,.txt,.tsv"/>
        <button class="btn btn-primary" type="submit">Upload results</button>
      </form>
    </div>

  </div>
  </div><!-- /content slot -->
</body>
</html>
