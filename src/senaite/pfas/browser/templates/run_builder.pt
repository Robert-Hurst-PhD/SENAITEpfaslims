<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">LC-MS Run Builder</title>
</head>
<body>
  <tal:t metal:fill-slot="header-title">LC-MS Run Builder</tal:t>

  <div metal:fill-slot="content">
  <div class="page-body">

    <div class="alert alert-success" tal:condition="view/ok_msg"
         tal:content="view/ok_msg">ok</div>
    <div class="alert alert-error" tal:condition="view/error_msg"
         tal:content="view/error_msg">err</div>
    <ul class="bench-alerts" tal:define="ips view/import_problems" tal:condition="ips">
      <li tal:repeat="ip ips"
          tal:attributes="class python:'bench-bad' if ip['status'] == 'failed' else 'bench-warn'">
        <strong tal:content="python:u'Import failed:' if ip['status'] == 'failed' else u'Import retrying:'">Import</strong>
        <span tal:content="python:u'%s, attempt %s (%s). %s' % (ip['file'], ip['attempts'], ip['error'], u'Upload the run again.' if ip['status'] == 'failed' else u'The worker tries again shortly.')">x</span></li>
    </ul>
    <div class="alert alert-success" tal:condition="view/built">
      Run built and saved to the batch manifest — download the worklist below.
    </div>

    <p class="pfas-lead is-narrow">The run follows the batch: its method&rsquo;s extraction log supplies the samples. Choose the analyst and confirm them. <tal:h define="hid string:guided-extraction"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></p>

    <form method="get" class="pfas-filterbar is-narrow">
      <div class="pfas-field">
        <label for="batch_id">Extraction batch</label>
        <select name="batch_id" id="batch_id" class="pfas-select" onchange="this.form.submit()">
          <option value="">— select worksheet —</option>
          <option tal:repeat="b view/batches"
                  tal:attributes="value b/id;
                                  selected python:b['id'] == view.selected_batch()"
                  tal:content="b/title">B-1</option>
        </select>
      </div>
    </form>

    <tal:ctx tal:define="ctx view/run_context" tal:condition="ctx">
      <div class="pfas-banner is-plain">
        <span>Method: <b tal:content="ctx/method_id">FDA</b></span>
        <span>Extraction logbook: <b tal:content="string:FM-ENV-${ctx/extraction_slug}">252</b>
              <span class="pfas-muted">(set by method)</span></span>
        <span>CCV every <b tal:content="ctx/ccv_interval">6</b> samples
              <span class="pfas-muted">(method parameter)</span></span>
        <span>Samples found: <b tal:content="ctx/n_samples">3</b></span>
      </div>

      <div class="pfas-cols-2">
        <!-- ── 1. Build ─────────────────────────────────────────────────── -->
        <div class="pfas-card">
          <h3>1 · Build the run</h3>

          <div class="table-wrap" tal:condition="ctx/rows">
            <table class="pfas-table">
              <thead><tr><th>Sample</th><th>Matrix (per sample)</th><th>Spike</th></tr></thead>
              <tbody>
                <tr tal:repeat="r ctx/rows">
                  <td tal:content="r/sample_id">DW-1</td>
                  <td tal:content="python:r['matrix'] or '—'">Eggs</td>
                  <td tal:content="python:r['spike'] or '—'">80</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p tal:condition="not:ctx/rows" class="pfas-banner is-warn">
            No samples found in the method's extraction logbook or linked to
            this batch — complete the extraction log, or add sample names below.
          </p>

          <form method="post"
                tal:attributes="action string:${view/portal_url}/@@pfas-run-builder">
            <input type="hidden" name="action" value="build"/>
            <input type="hidden" name="batch_id"
                   tal:attributes="value view/selected_batch"/>
            <div class="pfas-field is-spaced" tal:define="staff view/staff_pool">
              <label>Analyst (laboratory staff pool) *</label>
              <select name="initials" class="pfas-select" required="required" tal:condition="staff">
                <option value="">— select analyst —</option>
                <option tal:repeat="p staff"
                        tal:attributes="value p/initials"
                        tal:content="string:${p/fullname} (${p/initials})">A (AB)</option>
              </select>
              <tal:empty tal:condition="not:staff">
                <input type="text" name="initials" maxlength="4" class="pfas-input is-upper"
                       placeholder="Initials"/>
                <span class="pfas-hint">Staff pool is empty — add Lab Contacts in
                  <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/bika_setup/bika_labcontacts">SENAITE setup</a>
                  so analysts are selectable instead of typed.</span>
              </tal:empty>
            </div>
            <div class="pfas-field is-spaced">
              <label for="extra_samples">Additional sample names (optional, one per line)</label>
              <textarea name="extra_samples" id="extra_samples" rows="3" class="pfas-textarea"></textarea>
            </div>
            <div class="pfas-field is-spaced" tal:condition="view/made_requests">
              <span>Run</span>
              <div class="pfas-radios">
                <label class="pfas-check"><input type="radio" name="run_kind" value="full" checked="checked" /> The whole batch</label>
                <label class="pfas-check"><input type="radio" name="run_kind" value="supplementary" />
                  <span tal:replace="python:'Only what review asked for (%d made)' % len(view.made_requests())">Only requests</span></label>
              </div>
            </div>
            <!-- a new calibration curve: the method profile's rule, else the
                 bench chemist answers (run_plan.curve_decision) -->
            <div class="pfas-field is-spaced" tal:define="cd view/curve_decision" tal:condition="cd">
              <span>Is a new calibration curve needed?</span>
              <tal:f condition="cd/forced">
                <strong>Yes</strong> &mdash; <span tal:replace="cd/reason">reason</span>
                <input type="hidden" name="new_curve" value="yes" />
              </tal:f>
              <tal:a condition="not:cd/forced">
                <span class="pfas-hint" tal:content="string:${cd/reason}."></span>
                <div class="pfas-radios">
                  <label class="pfas-check"><input type="radio" name="new_curve" value="yes" required="required" /> Yes, run a new curve</label>
                  <label class="pfas-check"><input type="radio" name="new_curve" value="no"
                                tal:attributes="checked python:'checked' if cd.get('default') == 'reuse' else None" /> No, use the last curve</label>
                </div>
              </tal:a>
            </div>
            <button class="btn btn-primary" type="submit">Build Run Sequence</button>
          </form>
        </div>

        <!-- ── 2. Import instrument data ────────────────────────────────── -->
        <div class="pfas-card">
          <h3>2 · Import instrument data</h3>
          <p class="pfas-note-sm">Upload the instrument&rsquo;s finished export; it is imported only with an active Import Studio mapping. <tal:h define="hid string:import-profiles"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></p>
          <form method="post" enctype="multipart/form-data"
                tal:attributes="action string:${view/portal_url}/@@pfas-run-builder">
            <input type="hidden" name="action" value="upload_export"/>
            <input type="hidden" name="batch_id"
                   tal:attributes="value view/selected_batch"/>
            <div class="pfas-field is-spaced">
              <input type="file" name="export_file" accept=".csv,.txt,.tsv"/>
            </div>
            <button class="btn btn-primary" type="submit">Upload to pipeline</button>
          </form>
        </div>
      </div>

      <!-- ── Run template (per-method, editable) ───────────────────────── -->
      <tal:tpl tal:define="tpl view/current_template;
                           vocab view/add_vocabulary;
                           editable view/can_edit_template"
               tal:condition="tpl">
      <div class="pfas-card is-spaced"
           tal:attributes="class python:'pfas-card is-spaced' + ('' if editable else ' is-readonly')">
        <h3>Run template — how this method builds its worklist
          <span class="pfas-muted"
                tal:content="ctx/method_id">FDA</span>
        </h3>
        <p class="pfas-note-sm">One run sequence; drag to reorder. <tal:h define="hid string:ccv-bracketing"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></p>
        <div class="alert alert-success" tal:condition="view/template_saved">
          Run template saved to the method profile.
        </div>

        <form method="post" id="rb-tpl-form"
              tal:attributes="action string:${view/portal_url}/@@pfas-run-builder">
          <input type="hidden" name="action" value="save_template"/>
          <input type="hidden" name="batch_id"
                 tal:attributes="value view/selected_batch"/>
          <input type="hidden" name="method_id" tal:attributes="value ctx/method_id"/>
          <input type="hidden" name="sequence_codes" id="sequence_codes"/>

          <div class="pfas-field is-spaced">
            <label>Run sequence — drag to reorder</label>
            <div class="pfas-seqlist" id="seq-chips">
              <div tal:repeat="c tpl/sequence_labelled"
                   tal:attributes="data-code c/code; data-kind c/kind;
                                   class python:'pfas-seqrow ' + c['kind']">
                <span class="grip" title="Drag to reorder"></span>
                <span class="lbl" tal:content="c/label">Method Blank</span>
                <span class="code"
                      tal:condition="python:c['code'] != 'SAMPLES'"
                      tal:content="string:(${c/code})">(MB)</span>
                <button type="button" class="del" title="Remove"
                        tal:condition="c/removable">&times;</button>
              </div>
            </div>
            <div class="pfas-seq-add">
              <select id="seq-add">
                <option value="">&mdash; add QC / calibrators &mdash;</option>
                <option tal:repeat="v vocab" tal:attributes="value v/code"
                        tal:content="python:(('Calibrator list') if v['code']=='CAL' else (v['label']+' ('+v['code']+')'))">MB</option>
              </select>
              <button type="button" class="btn-sm btn-secondary"
                      id="seq-add-btn">+ add</button>
            </div>
          </div>

          <p class="pfas-note-sm">
            Bracketing: a <b>CCV</b> is inserted automatically every
            <span tal:content="ctx/ccv_interval">6</span> injections
            (interval from the method profile) — you don't add or position it.
          </p>

          <p class="pfas-hint">Calibrator list expands to the calibration standards when the curve is included; Field samples can be moved, not removed.</p>
          <button class="btn btn-primary" type="submit"
                  tal:condition="editable">Save run template</button>
          <p class="pfas-note-sm"
             tal:condition="not:editable">
            Read-only — a Manager can edit this run template.
          </p>
        </form>
      </div>

      <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/vendor/Sortable-1.15.6.min.js"></script>
      <script>
      /* Pure DOM (no innerHTML / no literal markup); and NO bare "less-than",
         "ampersand" or "and-and" operators, so the Chameleon template parser
         never mistakes JS for markup. SortableJS reorders the rows (touch
         screens included;. */
      (function () {
        var form = document.getElementById("rb-tpl-form");
        if (!form) return;
        var list = document.getElementById("seq-chips");

        function makeRow(code, label, kind) {
          var row = document.createElement("div");
          row.className = "pfas-seqrow " + kind;
          row.setAttribute("data-code", code);
          row.setAttribute("data-kind", kind);
          var g = document.createElement("span");
          g.className = "grip"; g.title = "Drag to reorder";
          row.appendChild(g);
          var l = document.createElement("span");
          l.className = "lbl"; l.textContent = label; row.appendChild(l);
          var c = document.createElement("span");
          c.className = "code"; c.textContent = "(" + code + ")";
          row.appendChild(c);
          var d = document.createElement("button");
          d.type = "button"; d.className = "del"; d.title = "Remove";
          d.textContent = "\u00d7"; row.appendChild(d);
          return row;
        }
        function serialize() {
          var codes = [];
          list.querySelectorAll(".pfas-seqrow").forEach(function (r) {
            codes.push(r.getAttribute("data-code")); });
          document.getElementById("sequence_codes").value = codes.join(",");
        }
        // add
        var addBtn = document.getElementById("seq-add-btn");
        if (addBtn) {
          addBtn.addEventListener("click", function () {
            var sel = document.getElementById("seq-add");
            if (!sel.value) return;
            if (sel.value === "SAMPLES") return;
            var label = sel.options[sel.selectedIndex].text
                           .replace(/\s*\([^)]*\)\s*$/, "");
            var kind = (sel.value === "CAL") ? "cal" : "qc";
            list.appendChild(makeRow(sel.value, label, kind));
          });
        }
        // delete
        list.addEventListener("click", function (e) {
          var b = e.target.closest ? e.target.closest("button.del") : null;
          if (!b) return;
          var row = b.parentNode;
          if (row.getAttribute("data-kind") === "samples") return;
          row.remove();
        });
        // drag reorder: SortableJS (mouse and touch); read-only templates stay put
        Sortable.create(list, {
          draggable: ".pfas-seqrow", filter: "button.del", preventOnFilter: false,
          animation: 150, ghostClass: "dragging",
          disabled: !!list.closest(".is-readonly"),
          onEnd: serialize
        });
        form.addEventListener("submit", serialize);
      })();
      </script>
      </tal:tpl>
    </tal:ctx>

    <!-- ── Built sequence + download ──────────────────────────────────── -->
    <tal:man tal:define="m view/manifest" tal:condition="m">
      <div class="pfas-card is-spaced">
        <h3 class="is-row">
          <span>Built run — <span tal:content="m/batch_id">B</span></span>
          <span class="pfas-muted">
            <span tal:content="m/built_at">ts</span> by
            <span tal:content="m/built_by">INI</span> ·
            <span tal:content="m/method_id">FDA</span> ·
            CCV/<span tal:content="m/ccv_interval">6</span>
          </span>
          <a class="btn btn-primary is-end"
             tal:attributes="href string:${view/portal_url}/@@pfas-run-builder?action=download_csv&batch_id=${m/batch_id}">
            Download worklist CSV
          </a>
          <a class="btn btn-secondary"
             tal:attributes="href string:${view/portal_url}/@@pfas-run-builder?action=download_masslynx&batch_id=${m/batch_id};
                             title view/export_source">
            Instrument sample list
          </a>
        </h3>
        <div class="table-wrap">
          <table class="pfas-table">
            <thead><tr><th>Vial</th><th>Injection name (lot)</th>
                       <th>Description</th><th>Type</th></tr></thead>
            <tbody>
              <tr tal:repeat="r m/rows">
                <td tal:content="r/vial">1</td>
                <td class="pfas-mono" tal:content="r/name">name</td>
                <td class="pfas-muted-cell"
                    tal:content="python:r.get('description','')">desc</td>
                <td><span tal:attributes="class python:{'Standard': 'pfas-text-accent', 'QC': 'pfas-text-warn', 'Sample': 'pfas-text-ok'}.get(r['type'], 'pfas-muted')"
                          tal:content="r/type">QC</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </tal:man>

  </div>
  </div><!-- /content slot -->
</body>
</html>
