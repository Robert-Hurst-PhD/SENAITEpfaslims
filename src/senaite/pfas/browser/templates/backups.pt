<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Backups</title>
  <metal:fill fill-slot="header-title">Backups</metal:fill>

  <div metal:fill-slot="content" tal:define="sm view/summary; st view/status; msg view/message">
    <div tal:condition="msg" tal:attributes="class python:'alert ' + ('alert-success' if msg['ok'] else 'alert-danger')"
         tal:content="msg/text">Saved.</div>

    <div class="section-group-hdr">Backup levels</div>
    <table class="pfas-table" data-col-resize="backups-1">
      <thead><tr><th>Level</th><th>What it holds</th><th>When</th><th>Kept</th></tr></thead>
      <tbody><tr tal:repeat="l view/level_rows">
        <td class="pfas-cell-name" tal:content="l/label">Full</td><td tal:content="l/holds">A full copy</td>
        <td tal:content="l/when">First day of each quarter</td><td tal:content="l/kept">5 years</td></tr></tbody>
    </table>

    <div class="section-group-hdr">Status <tal:h define="hid string:backups"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></div>
    <table class="pfas-table">
      <tbody>
        <tr><th>Destination</th><td tal:content="python:st.get('destination') or u'—'">/media/STORAGE</td></tr>
        <tr><th>Free space</th><td tal:content="python:(u'%.0f GB' % st['free_gb']) if st.get('free_gb') is not None else u'—'">1800 GB</td></tr>
        <tr><th>Encrypted to</th><td class="pfas-mono" tal:content="python:u', '.join(st.get('recipients') or []) or u'—'">FPR</td></tr>
        <tr><th>Scheduled</th><td tal:content="python:{True: u'Yes', False: u'No'}.get(st.get('timers'), u'—')">Yes</td></tr>
        <tr tal:condition="view/settings_line"><th>Settings</th><td tal:content="view/settings_line">Saved</td></tr>
        <tr tal:repeat="lv python:(('quarterly', u'Last full'), ('daily', u'Last incremental'), ('full_install', u'Last full install'))">
          <th tal:content="python:lv[1]">Last incremental</th>
          <td tal:define="e python:sm['last_ok'].get(lv[0])"
              tal:content="python:(e['ended'][:16].replace('T', ' ') + u' · ' + (view.level_label(e) if lv[0] == 'daily' else (e.get('point') or u''))) if e else u'—'">2027-02-09 02:10</td></tr>
        <tr><th>Restore test</th>
          <td tal:define="t sm/last_restore_test"
              tal:content="python:(t['ended'][:10] if t else u'none') + (u' · due' if sm['restore_test_due'] else u'')">2027-01-05</td></tr>
      </tbody>
    </table>
    <div class="alert alert-danger" tal:define="f sm/last_failed" tal:condition="f"
         tal:content="python:u'Last backup failed %s: %s' % (f['ended'][:16].replace('T', ' '), u', '.join(f.get('failures') or []))">failed</div>

    <!-- set here by a site administrator, applied by the backup tool at its next run (backup_settings) -->
    <div class="section-group-hdr">Backup settings</div>
    <table class="pfas-table">
      <tbody>
        <tr tal:repeat="r view/setting_rows">
          <th tal:content="r/label">Destination</th>
          <td><span tal:content="r/value">/media/STORAGE</span>
            <div class="pfas-sub" tal:condition="r/waiting" tal:content="string:Next run: ${r/waiting}">Next run</div>
            <details class="row-form" tal:condition="view/can_site_admin">
              <summary class="btn-sm btn-secondary" tal:attributes="aria-label string:Change ${r/label}">Change</summary>
              <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-backups">
                <input type="hidden" name="action" value="save_setting" />
                <input type="hidden" name="setting" tal:attributes="value r/key" />
                <tal:d condition="python:r['key'] == 'dest'">
                  <label class="field-row">Destination <input type="text" name="value" class="pfas-input pfas-input-wide" tal:attributes="value python:r['raw'] or u''" /></label></tal:d>
                <tal:t condition="python:r['key'] == 'run_at'">
                  <label class="field-row">Backup runs at <input type="time" name="value" tal:attributes="value python:r['raw'] or u''" /></label></tal:t>
                <tal:p condition="python:r['key'] == 'prune'">
                  <div class="cf-chips">
                    <label class="pfas-switch cf-chip" tal:repeat="d view/days">
                      <input type="checkbox" value="on" tal:attributes="name string:prune.${d}; checked python:'checked' if d in ((r['raw'] or {}).get('days') or []) else None" /><span class="pfas-switch-track"></span>
                      <span tal:replace="d">Sun</span></label></div>
                  <label class="field-row">At <input type="time" name="prune_at" tal:attributes="value python:(r['raw'] or {}).get('at') or u''" /></label></tal:p>
                <tal:k condition="python:r['key'] == 'recipients'">
                  <div class="pfas-rows" data-rows="data-rows">
                    <div data-row-list="data-row-list">
                      <div class="pfas-rows-item" data-row="data-row" tal:repeat="k python:r['raw'] or []">
                        <input type="text" class="pfas-input" aria-label="Key holder" tal:attributes="name string:key.${repeat/k/index}.holder; value k/holder" />
                        <input type="text" class="pfas-input pfas-mono" aria-label="Fingerprint" tal:attributes="name string:key.${repeat/k/index}.fpr; value k/fpr" />
                        <button type="button" class="pfas-row-remove" data-row-remove="data-row-remove" aria-label="Remove key">&#215;</button>
                      </div>
                    </div>
                    <template data-row-template="data-row-template">
                      <div class="pfas-rows-item" data-row="data-row">
                        <input type="text" class="pfas-input" name="key.__i__.holder" placeholder="Key holder" aria-label="Key holder" />
                        <input type="text" class="pfas-input pfas-mono" name="key.__i__.fpr" placeholder="Fingerprint" aria-label="Fingerprint" />
                        <textarea name="key.__i__.key" rows="2" placeholder="Public key block" aria-label="Public key"></textarea>
                        <button type="button" class="pfas-row-remove" data-row-remove="data-row-remove" aria-label="Remove key">&#215;</button>
                      </div>
                    </template>
                    <button type="button" class="btn-sm btn-secondary pfas-add-row" data-row-add="data-row-add">+ Add a public key</button>
                  </div></tal:k>
                <label class="field-row">Reason for the change <input type="text" name="reason" required="required" /></label>
                <div class="form-actions"><button class="btn-sm btn-primary" type="submit">Save</button></div>
              </form>
            </details></td>
        </tr>
      </tbody>
    </table>

    <tal:c define="chs view/changes" condition="chs">
    <div class="section-group-hdr">Settings changes</div>
    <table class="pfas-table" data-col-resize="backups-2">
      <thead><tr><th>Saved</th><th>Change</th><th>By</th><th>Reason</th><th>State</th><th>Applied</th>
        <th class="row-plus-cell"><span class="pfas-sr-hide">Actions</span></th></tr></thead>
      <tbody>
        <tr tal:repeat="c chs">
          <td class="pfas-mono" tal:content="python:view.lab_at(c.get('at'), c.get('at'))">2026-10-14 15:02</td>
          <td tal:content="c/change">Destination</td>
          <td tal:content="c/by">AD</td>
          <td tal:content="c/reason">New disk</td>
          <td tal:content="c/state_label">Applied</td>
          <td><tal:a condition="python:c['state'] in ('applied', 'refused')" define="pf_ok python:c['state'] == 'applied'">
              <span metal:use-macro="context/@@pfas-macros/macros/pass-mark"></span>
              <span tal:replace="python:c.get('applied_at') or u''">2026-10-15 02:00</span><tal:w condition="c/why|nothing">:
              <span tal:replace="c/why">the disk is not mounted</span></tal:w></tal:a></td>
          <td class="row-plus-cell">
            <details class="row-more" tal:condition="python:c['state'] == 'waiting' and view.can_site_admin()">
              <summary class="row-plus" aria-label="Actions for this change" title="Actions">+</summary>
              <div class="row-more-menu">
                <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-backups">
                  <input type="hidden" name="action" value="withdraw_setting" />
                  <input type="hidden" name="change" tal:attributes="value c/id" />
                  <button type="submit" class="btn-sm btn-secondary">Withdraw</button>
                </form>
              </div>
            </details></td>
        </tr>
      </tbody>
    </table>
    </tal:c>

    <div class="section-group-hdr">Runs</div>
    <table class="pfas-table" data-col-resize="backups-3" tal:define="evs view/events" tal:condition="evs">
      <thead><tr><th>Ended</th><th>What</th><th>Level</th><th>Point</th><th>Who</th><th>Size</th><th class="is-center">Result</th><th>Note</th></tr></thead>
      <tbody>
        <tr tal:repeat="e evs">
          <td class="pfas-mono" tal:content="python:(e.get('ended') or u'')[:16].replace('T', ' ')">2027-02-09 02:10</td>
          <td tal:content="python:(e.get('kind') or u'').replace('_', ' ')">backup</td>
          <td tal:content="python:view.level_label(e) or u'—'">Incremental 6</td>
          <td class="pfas-mono" tal:content="python:e.get('point') or u'—'">20270209T020005-daily</td>
          <td tal:content="python:e.get('who') or u'schedule'">schedule</td>
          <td tal:content="python:(u'%.1f MB' % (e['bytes'] / 1e6)) if e.get('bytes') else u'—'">12 MB</td>
          <td class="is-center" tal:define="pf_ok python:e.get('status') == 'ok'">
            <span metal:use-macro="context/@@pfas-macros/macros/pass-mark"></span></td>
          <td tal:content="python:u', '.join(e.get('failures') or []) or e.get('note') or u''">note</td>
        </tr>
      </tbody>
    </table>
    <p class="form-note" tal:condition="not:view/events">No backups recorded yet.</p>

    <div class="section-group-hdr">Restore a method</div>
    <form method="post" enctype="multipart/form-data" tal:condition="view/can_site_admin"
          tal:attributes="action string:${view/portal_url}/@@pfas-backups">
      <input type="hidden" name="action" value="upload_bundle" />
      <div class="field-row"><label for="bk-bundle">Method bundle</label>
        <input type="file" name="bundle" id="bk-bundle" accept=".json,application/json" required="required" /></div>
      <div class="form-actions"><button class="btn btn-primary" type="submit">Show the changes</button></div>
    </form>

    <tal:p tal:define="b view/pending" tal:condition="b">
      <table class="pfas-table" data-col-resize="backups-4">
        <thead><tr><th>Part</th><th>Of</th><th>Setting</th><th>Now</th><th>From the backup</th></tr></thead>
        <tbody>
          <tr tal:repeat="r view/plan_rows">
            <td tal:content="r/part">profile</td>
            <td class="pfas-mono" tal:content="r/key">EPA_537_1</td>
            <td class="pfas-mono" tal:content="r/path">blank_limits</td>
            <td class="pfas-mono" tal:content="r/before">2.0</td>
            <td class="pfas-mono" tal:content="r/after">1.0</td>
          </tr>
        </tbody>
      </table>
      <form method="post" tal:condition="view/can_site_admin"
            tal:attributes="action string:${view/portal_url}/@@pfas-backups">
        <input type="hidden" name="action" value="apply_restore" />
        <input type="hidden" name="bundle" tal:attributes="value b/bundle_id" />
        <div class="field-row"><label for="bk-reason">Reason</label>
          <input type="text" name="reason" id="bk-reason" required="required" /></div>
        <div class="form-actions"><button class="btn btn-primary" type="submit"
             tal:content="python:u'Restore %s from %s' % (b['method_id'], b['point'])">Restore</button></div>
      </form>
    </tal:p>
  </div>
</html>
