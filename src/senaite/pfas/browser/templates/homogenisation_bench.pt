<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Homogenisation</title>
  <metal:fill fill-slot="header-title">Homogenisation</metal:fill>
  <tal:r metal:fill-slot="header-right">
    <a class="btn-sm btn-secondary" tal:condition="view/can_configure"
       tal:attributes="href string:${view/portal_url}/@@pfas-homogenisation-setup">Techniques</a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body" tal:define="purl view/portal_url; sel view/selected">

    <div class="alert alert-success" tal:condition="view/done">
      Recorded: <span tal:replace="python:', '.join(view.done)">EGG-0001</span></div>
    <div class="alert alert-danger" tal:condition="view/errors">
      <tal:e repeat="e view/errors"><div tal:content="e">error</div></tal:e></div>

    <div class="pfas-filterbar">
      <div class="pfas-form-field"><label>Status</label>
        <nav class="pfas-seg pfas-seg-sm is-fit" aria-label="Status">
          <a class="pfas-seg-item" tal:repeat="w view/status_links"
             tal:attributes="href w/url; aria-selected python:'true' if w['on'] else 'false'"
             tal:content="w/label">Active</a>
        </nav></div>
      <span class="pfas-filterbar-spacer"></span>
      <tal:h define="hid string:homogenisation"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h>
    </div>

    <table class="pfas-table" data-col-resize="homogenisation-bench-1" tal:define="rows view/rows">
      <thead><tr><th>Sample</th><th>Matrix</th><th>Requested</th><th>Items composited</th><th>Technique</th>
                 <th>Homogeniser</th><th>By</th><th>Date</th><th>Status</th></tr></thead>
      <tbody>
        <tr tal:repeat="r rows" tal:attributes="data-row-open python:view.row_url(r)">
          <td><strong tal:content="r/id">DEMO-0107</strong></td>
          <td tal:content="r/matrix">Eggs</td>
          <td tal:content="r/method_title">Blender</td>
          <td tal:content="python:r['last'].get('units_combined') or (r['units'] if r['composite'] else u'')">12</td>
          <td tal:content="r/last_title">Blender</td>
          <td tal:content="python:r['last'].get('unit_name') or u''">Mill 1</td>
          <td tal:content="python:r['last'].get('by') or u''">AN1</td>
          <td class="pfas-mono" tal:content="python:view.lab_at(r['last'].get('at'), (r['last'].get('at') or u'')[:10], u'%Y-%m-%d')">2026-10-12</td>
          <td><span tal:attributes="class python:'badge badge-ok' if r['status'] == 'Recorded' else 'badge badge-pending'"
                    tal:content="r/status">Pending</span></td>
        </tr>
        <tr tal:condition="not:rows"><td colspan="9">Nothing here.</td></tr>
      </tbody>
    </table>

    <div tal:define="row view/open_row" tal:condition="row"
         class="pfas-modal open" id="hg-modal">
      <div class="pfas-modal-box is-wide" role="dialog" aria-modal="true" aria-labelledby="hg-title">
        <h2 id="hg-title">Homogenise <tal:i tal:replace="row/id">DEMO-0107</tal:i>
          <span tal:attributes="class python:'badge badge-ok' if row['status'] == 'Recorded' else 'badge badge-pending'"
                tal:content="row/status">Pending</span></h2>
        <p class="form-note" tal:condition="python:row['coc'] or row['composite']">
          <tal:c tal:condition="row/coc">CoC <tal:n tal:replace="row/coc">COC-2026-0001</tal:n>. </tal:c>
          <tal:c tal:condition="row/composite"><tal:u tal:replace="python:'%s units' % (row['units'] or '?')">12 units</tal:u>: <tal:d tal:replace="row/description">whole egg</tal:d>.</tal:c>
        </p>
        <div class="cf-hint" tal:repeat="p row/problems" tal:content="p">problem</div>
        <form method="post" tal:attributes="action string:${purl}/@@pfas-homogenisation?status=${view/status_filter}">
          <input type="hidden" name="action" value="record" />
          <input type="hidden" name="open" tal:attributes="value row/uid" />
          <input type="hidden" value="on" tal:attributes="name string:sel__${row/uid}" />
          <div class="pfas-cols-2">
            <label class="pfas-form-field">Technique used
              <select name="method" tal:define="mv python:view.method_value(row)">
                <option value="">Choose</option>
                <option tal:repeat="c view/method_choices"
                        tal:attributes="value python:c[0]; selected python:'selected' if c[0] == mv else None"
                        tal:content="python:c[1]">Blender</option>
              </select></label>
            <label class="pfas-form-field">Homogeniser
              <select name="unit_serial" tal:define="units view/units">
                <option value="" tal:content="python:'Choose' if units else 'None registered under Equipment'">Choose</option>
                <option tal:repeat="u units"
                        tal:attributes="value u/serial;
                                        selected python:'selected' if u['serial'] == view.form_value('unit_serial') else None"
                        tal:content="python:u'%s \u00b7 S/N %s' % (u['name'], u['serial'])">Mill 1</option>
              </select></label>
            <label class="pfas-form-field" tal:condition="row/composite">Items composited
              <tal:h define="hid string:homogenisation"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h>
              <input type="number" min="1" step="1"
                     tal:attributes="name string:units__${row/uid};
                                     value python:view.form_value('units__' + row['uid']) or row['units'] or ''" /></label>
            <div class="pfas-form-field" tal:define="others python:view.together_choices(row)">
              <span class="pfas-label">Homogenised together with</span>
              <div class="pfas-multi" data-more="awaiting homogenisation" tal:condition="others">
              <div class="cf-chips">
                <label class="cf-chip" tal:repeat="o others">
                  <input type="checkbox" value="on"
                         tal:attributes="name string:sel__${o/uid};
                                         checked python:'checked' if o['uid'] in view.selected() else None" />
                  <span tal:replace="o/id">DEMO-0108</span></label>
              </div>
              </div>
              <span class="pfas-muted" tal:condition="not:others">No other sample is waiting.</span>
            </div>
          </div>
          <label class="pfas-form-field">Note
            <textarea name="note" rows="2" tal:content="python:view.form_value('note')"></textarea></label>
          <label class="pfas-switch">
            <input type="checkbox" name="cleaned" value="on"
                   tal:attributes="checked python:'checked' if view.form_value('cleaned') else None" />
            <span class="pfas-switch-track"></span>
            <span>Cleaned before use</span>
          </label>
          <div class="form-actions">
            <button class="btn btn-primary" type="submit">Record</button>
            <button class="btn btn-secondary" type="button" data-modal-close="data-modal-close">Cancel</button>
          </div>
        </form>
      </div>
    </div>

  </div>
  </div>
</html>
