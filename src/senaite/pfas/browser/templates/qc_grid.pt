<metal:block use-macro="context/@@pfas-macros/macros/page">
<title metal:fill-slot="title">QC Type Grid</title>
<tal:t metal:fill-slot="header-title">QC Type Grid</tal:t>
<metal:fill fill-slot="content">

<div class="page-body">
  <p class="pfas-lead">Tick the QC types each method runs; unticked types are removed from that method. <tal:h define="hid string:qc-types"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></p>

  <form method="post"
        tal:attributes="action string:${context/absolute_url}/@@pfas-qc-type-grid">
    <input type="hidden" name="action" value="save_grid" />

    <div class="table-wrap">
      <table class="pfas-table pfas-grid-table">
        <thead>
          <tr>
            <th class="pfas-grid-method">Method</th>
            <tal:cols tal:repeat="col view/qc_columns">
              <th class="pfas-grid-col"
                  tal:content="col/code">MB</th>
            </tal:cols>
          </tr>
          <tr class="pfas-grid-sub">
            <td></td>
            <tal:cols tal:repeat="col view/qc_columns">
              <td class="pfas-grid-sublabel"
                  tal:content="col/label">Method Blank</td>
            </tal:cols>
          </tr>
        </thead>
        <tbody>
          <tal:rows tal:define="state view/grid_state">
            <tal:method tal:repeat="m view/grid_methods">
              <tr>
                <td class="pfas-grid-name"
                    tal:content="m/label">FDA 32-PFAS</td>
                <tal:cols tal:repeat="col view/qc_columns">
                  <td class="pfas-grid-check">
                    <tal:block tal:define="mid python:m['id'];
                                           code python:col['code'];
                                           checked python:state.get(mid,{}).get(code, False)">
                      <input type="checkbox"
                             tal:attributes="name python:'qc_enabled_%s_%s' % (mid, code);
                                             checked python:'checked' if checked else None;
                                             value string:1" />
                    </tal:block>
                  </td>
                </tal:cols>
              </tr>
              <!-- Per-spike-level RPD row — LFSMD only (Dup is unfortified, flat RPD) -->
              <tr class="pfas-grid-rpd">
                <td class="pfas-grid-rpd-label">
                  LFSMD spike level RPD
                </td>
                <tal:rpd_cols tal:repeat="col view/qc_columns">
                  <td class="pfas-grid-rpd-cell">
                    <tal:block tal:condition="python:col['criterion'] == 'rpd' and col['code'] == 'LFSMD'"
                               tal:define="mid python:m['id'];
                                           code python:col['code'];
                                           tiers python:view.rpd_tiers(mid, code)">
                      <div class="pfas-grid-stack">
                        <tal:level tal:repeat="level view/spike_levels">
                          <tal:block tal:define="existing python:[t.get('rpd_max','') for t in tiers if t.get('spike_level') == level];
                                                  val python:existing[0] if existing else ''">
                            <label tal:content="level">Low</label>
                            <input type="number" step="0.1" min="0" max="100"
                                   tal:attributes="name python:'rpd__%s__%s_%s' % (mid, code, level);
                                                   value python:val;
                                                   placeholder string:%" />
                          </tal:block>
                        </tal:level>
                      </div>
                    </tal:block>
                    <tal:block tal:condition="python:not (col['criterion'] == 'rpd' and col['code'] == 'LFSMD')">
                      <!-- blank cell for non-LFSMD or non-RPD columns -->
                    </tal:block>
                  </td>
                </tal:rpd_cols>
              </tr>
            </tal:method>
          </tal:rows>
        </tbody>
      </table>
    </div>

    <div class="pfas-grid-actions">
      <button class="btn btn-primary" type="submit">Save Grid</button>
      <a class="btn-sm btn-secondary"
         tal:attributes="href string:${context/absolute_url}/@@pfas-method-profiles">
        &#8592; Back to Method Profiles
      </a>
    </div>
  </form>

  <!-- Column legend -->
  <div class="pfas-legend">
    <h4>Column Legend</h4>
    <dl>
      <tal:cols tal:repeat="col view/qc_columns">
        <dt tal:content="col/code">MB</dt>
        <dd tal:content="col/label">Method Blank</dd>
      </tal:cols>
    </dl>
    <p>Maximum LFSMD RPD per spike level. Spike levels are set per matrix on the method profile. <tal:h define="hid string:qc-types"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></p>
  </div>
  <div class="pane-footer">
  </div>
</div>

</metal:fill>
</metal:block>
