<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Projects</title>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Projects</tal:t>
  <tal:r metal:fill-slot="header-right">
    <button type="button" class="btn-sm btn-primary" data-modal-open="pj-modal" data-new="data-new" tal:condition="view/can_manage">+ New Project</button>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <div tal:condition="view/ok_msg"    class="alert alert-success" tal:content="view/ok_msg"></div>
    <div tal:condition="view/error_msg" class="alert alert-error"   tal:content="view/error_msg"></div>

    <!-- ─── Filters, and the one create action on the right ──────────── -->
    <form method="get" class="pfas-filterbar" data-autosubmit="data-autosubmit"
          tal:attributes="action string:${view/portal_url}/@@pfas-projects">
      <div class="pfas-form-field">
        <label for="pj-f-client">Client</label>
        <select id="pj-f-client" name="client" class="pfas-select">
          <option value="">All clients</option>
          <option tal:repeat="c view/clients"
                  tal:attributes="value c/uid; selected python:view.client_filter() == c['uid']"
                  tal:content="c/title"></option>
        </select>
      </div>
      <div class="pfas-form-field">
        <label for="pj-f-status">Status</label>
        <select id="pj-f-status" name="status" class="pfas-select">
          <option value="">All statuses</option>
          <option tal:repeat="pair view/all_statuses"
                  tal:attributes="value python:pair[0]; selected python:view.status_filter() == pair[0]"
                  tal:content="python:pair[1]"></option>
        </select>
      </div>
      <noscript><button type="submit" class="btn btn-primary">Apply</button></noscript>
      <a class="btn btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-projects">Clear</a>
      <span class="pfas-filterbar-spacer"></span>
    </form>

    <!-- ─── Create / edit dialog, manager only ─────────────────────────── -->
    <div class="pfas-modal" id="pj-modal" tal:condition="view/can_manage"
         tal:define="editing view/edit_project"
         tal:attributes="class python:'pfas-modal open' if view.form_open() else 'pfas-modal'">
      <div class="pfas-modal-box" role="dialog" aria-modal="true" aria-labelledby="pj-modal-title">
        <h2 id="pj-modal-title">
          <tal:n tal:condition="not:editing">New Project</tal:n>
          <tal:e tal:condition="editing">Edit Project <tal:c tal:content="python:editing['project_code']"></tal:c></tal:e>
        </h2>
        <form method="post"
              tal:attributes="action string:${view/portal_url}/@@pfas-projects">
          <input type="hidden" name="action"
                 tal:attributes="value python:'edit' if editing else 'add'"/>
          <input type="hidden" name="uid"
                 tal:attributes="value python:editing['uid'] if editing else ''"/>

          <div class="pfas-form-row">
            <div class="pfas-form-field">
              <label for="pj-title">Project name</label>
              <input type="text" id="pj-title" name="title" required="required"
                     tal:attributes="value python:editing['title'] if editing else ''"/>
            </div>
            <div class="pfas-form-field">
              <label for="pj-code">Project code</label>
              <input type="text" id="pj-code" name="project_code" required="required"
                     tal:attributes="value python:editing['project_code'] if editing else ''"/>
            </div>
            <div class="pfas-form-field">
              <label for="pj-client">Client</label>
              <select id="pj-client" class="pfas-select" name="client_uid" required="required">
                <option value="">Choose a client</option>
                <tal:opts tal:repeat="c view/clients">
                  <option tal:attributes="value c/uid;
                                          selected python:editing and editing['client_uid'] == c['uid']"
                          tal:content="c/title"></option>
                </tal:opts>
              </select>
              <div class="hint" tal:condition="not:view/clients">
                No SENAITE clients yet: create one under Clients first.
              </div>
            </div>
            <div class="pfas-form-field">
              <label for="pj-qapp">QAPP document <tal:h define="hid string:project-qapp"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></label>
              <select id="pj-qapp" class="pfas-select" name="qapp_document_id">
                <option value="">None (internal quality system)</option>
                <tal:opts tal:repeat="q view/qapp_docs">
                  <option tal:attributes="value q/sop_id;
                                          selected python:editing and editing['qapp_document_id'] == q['sop_id']"
                          tal:content="python:u'%s — %s' % (q['sop_id'], q['title'])"></option>
                </tal:opts>
              </select>
            </div>
            <div class="pfas-form-field">
              <label for="pj-standing">Standing</label>
              <label class="pfas-switch">
                <input type="checkbox" id="pj-standing" name="standing" value="on"
                       tal:attributes="checked python:'checked' if editing and editing['standing'] else None"/>
                <span class="pfas-switch-track"></span>
                <span>Used by this client's batches that name no project</span>
              </label>
            </div>
            <div class="pfas-form-field">
              <label for="pj-start">Start date</label>
              <input type="date" id="pj-start" name="start_date"
                     tal:attributes="value python:editing['start_date'] if editing else ''"/>
            </div>
            <div class="pfas-form-field">
              <label for="pj-end">End date</label>
              <input type="date" id="pj-end" name="end_date"
                     tal:attributes="value python:editing['end_date'] if editing else ''"/>
            </div>
            <div class="pfas-form-field">
              <label for="pj-status">Status</label>
              <select id="pj-status" class="pfas-select" name="status">
                <tal:opts tal:repeat="pair view/all_statuses">
                  <option tal:attributes="value python:pair[0];
                                          selected python:(editing['status'] if editing else 'active') == pair[0]"
                          tal:content="python:pair[1]"></option>
                </tal:opts>
              </select>
            </div>
            <div class="pfas-form-field is-full">
              <label for="pj-notes">Notes</label>
              <textarea id="pj-notes" name="notes" rows="3"
                        tal:content="python:editing['notes'] if editing else ''"></textarea>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">
              <span tal:condition="not:editing">Create Project</span>
              <span tal:condition="editing">Save Changes</span>
            </button>
            <button type="button" class="btn btn-secondary" data-modal-close="data-modal-close">Cancel</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ─── Project list ────────────────────────────────────────────────── -->
    <div class="table-wrap">
      <table class="pfas-table" data-col-resize="projects-1" tal:define="rm context/@@pfas-row-menu">
        <thead>
          <tr>
            <th>Project Code</th>
            <th>Project Name</th>
            <th>Client</th>
            <th>QAPP</th>
            <th>Status</th>
            <th>Start</th>
            <th>End</th>
            <th>Notes</th>
          </tr>
        </thead>
        <tbody>
          <tal:rows tal:repeat="pj view/projects">
          <tr tal:attributes="data-row-open python:(u'%s/@@pfas-projects?edit_uid=%s' % (view.portal_url(), pj['uid'])) if view.can_manage() else None;
                              data-row-actions python:rm.actions((u'Specs', 'href', u'%s/@@pfas-project-specs?uid=%s' % (view.portal_url(), pj['uid'])),
                                                                 (u'Delete', 'form', u'pj-delete-%s' % pj['uid'], {'danger': True})) if view.can_manage() else None">
            <td class="pfas-mono pfas-text-accent"><tal:c tal:content="python:pj.get('project_code','')"></tal:c>
              <span class="badge badge-opened" tal:condition="python:pj.get('standing')">Standing</span></td>
            <td tal:content="python:pj.get('title','')"></td>
            <td tal:content="python:pj.get('client_name','') or '—'"></td>
            <td>
              <span tal:condition="python:pj.get('qapp_document_id')"
                    class="mono-badge" tal:content="python:pj.get('qapp_label','')"></span>
              <span tal:condition="not:python:pj.get('qapp_document_id')"
                    class="pfas-muted">none on file</span>
            </td>
            <td>
              <span tal:attributes="class python:'badge ' + ('badge-active' if pj.get('status')=='active' else 'badge-archived')"
                    tal:content="python:pj.get('status','').capitalize()"></span>
            </td>
            <td tal:content="python:pj.get('start_date','') or '—'"></td>
            <td tal:content="python:pj.get('end_date','') or '—'"></td>
            <td class="pfas-muted pfas-col-notes" tal:content="python:pj.get('notes','')"></td>
          </tr>
          </tal:rows>
          <tr tal:condition="not:view/projects">
            <td colspan="8" class="pfas-muted pfas-center">
              No projects yet.
            </td>
          </tr>
        </tbody>
      </table>
      <tal:dl tal:condition="view/can_manage" tal:repeat="pj view/projects">
        <form method="post" class="pfas-inline-form" hidden="hidden"
              tal:attributes="action string:${view/portal_url}/@@pfas-projects; id string:pj-delete-${pj/uid}"
              onsubmit="return confirm('Delete this project? This cannot be undone.')">
          <input type="hidden" name="action" value="delete"/>
          <input type="hidden" name="uid" tal:attributes="value pj/uid"/>
          <button type="submit" class="btn-sm btn-danger">Delete</button>
        </form>
      </tal:dl>
    </div>

  </div>

  </div>
</body>
</html>
