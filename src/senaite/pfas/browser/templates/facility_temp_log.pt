<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Temperature Log</title>
</head>
<body>
<tal:t metal:fill-slot="header-title">Temperature Log</tal:t>
<metal:content metal:fill-slot="content">
  <tal:def tal:define="
    unit       view/unit;
    purl       view/portal_url;
    days       view/days;
    units_nav  view/units_for_nav;
  ">

  <!-- Unit navigation -->
  <nav class="pfas-seg pfas-seg-strip is-spaced" aria-label="Unit">
    <tal:each tal:repeat="u units_nav">
      <a class="pfas-seg-item"
         tal:attributes="
           href string:${purl}/@@pfas-temperature-log?unit_id=${u/id};
           aria-selected python:'true' if unit and unit['id']==u['id'] else 'false'"
         tal:content="u/name">Unit</a>
    </tal:each>
  </nav>

  <tal:no-unit tal:condition="python:not unit">
    <div class="pfas-empty is-boxed">
      Select a unit above, or
      <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-equipment"
        >Equipment</a>.
    </div>
  </tal:no-unit>

  <tal:has-unit tal:condition="unit">

    <!-- Chart -->
    <div class="pfas-card">
      <div class="pfas-between">
        <strong tal:content="unit/name">Unit</strong>
        <div class="pfas-inline">
          <span class="pfas-muted">Show:</span>
          <nav class="pfas-seg pfas-seg-sm" aria-label="Days">
            <tal:each tal:repeat="d python:[7,14,30,90]">
              <a class="pfas-seg-item"
                 tal:attributes="
                   href string:${purl}/@@pfas-temperature-log?unit_id=${unit/id}&amp;days=${d};
                   aria-selected python:'true' if days==d else 'false'"
                 tal:content="string:${d}d">7d</a>
            </tal:each>
          </nav>
        </div>
      </div>
      <div class="pfas-chart-box">
        <canvas id="tempChart"></canvas>
      </div>
      <div class="pfas-chart-note">
        Acceptance range:
        <tal:mn tal:replace="python:unit.get('temp_min','—')"/>–<tal:mx tal:replace="python:unit.get('temp_max','—')"/>&deg;C
        <tal:h tal:condition="python:unit.get('humidity_min') is not None">
          &bull; Humidity:
          <tal:hn tal:replace="python:unit.get('humidity_min','—')"/>–<tal:hx tal:replace="python:unit.get('humidity_max','—')"/>% RH
        </tal:h>
        <tal:c define="cf view/correction" condition="cf/required">
          &bull; Correction factor:
          <strong tal:condition="cf/current"
                  tal:content="python:u'%+.3f \u00b0C (study of %s); the chart and the range check use probe + correction' % (cf['current']['correction'], cf['current']['study_date'])">+0.300 °C</strong>
          <strong tal:condition="not:cf/current">none yet: no passed study, readings are judged uncorrected</strong>
        </tal:c>
      </div>
    </div>

    <!-- Temperature studies -->
    <div class="pfas-card">
      <h3>Quarterly Temperature Studies (NIST Verification)</h3>
      <p class="pfas-note-sm">Four paired readings over two days beside the NIST reference; the correction applies until the next study. <tal:h define="hid string:temperature-study"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></p>

      <!-- Existing studies -->
      <tal:each tal:repeat="s view/studies">
        <div class="pfas-study-row">
          <strong tal:content="s/study_date"></strong>
          <span tal:content="string:NIST: ${s/nist_serial}"></span>
          <span class="pfas-muted-cell" tal:content="string:Tol: ±${s/tolerance}°C"></span>
          <span tal:content="s/operator"></span>
          <span tal:attributes="class python:'badge badge-'+{'pass': 'ok', 'fail': 'fail'}.get(s['status'], 'pending')"
                tal:content="python:s['status'].upper()"></span>
          <span tal:condition="python:s.get('correction') is not None"
                tal:content="python:u'correction %+.3f \u00b0C' % s['correction']">correction +0.300 °C</span>
          <span tal:condition="python:s.get('reference') and not s['reference']['ok']" class="sur-tag sur-nocore"
                tal:content="python:u'reference %s: %s' % (s['reference']['name'], s['reference']['why'])">reference not verified</span>
          <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-temperature-log?unit_id=${unit/id}&amp;study_id=${s/id}"
            >Enter / view data</a>
        </div>
      </tal:each>
      <tal:none tal:condition="python:not view.studies()">
        <p class="pfas-note-sm">No studies recorded yet.</p>
      </tal:none>

      <!-- Study detail -->
      <tal:detail tal:define="det view/study_detail" tal:condition="det">
        <div class="pfas-subpanel">
          <strong>
            Study <tal:d tal:replace="python:det['study']['study_date']"/> —
            NIST <tal:s tal:replace="python:det['study']['nist_serial']"/>
            (tol ±<tal:t tal:replace="python:det['study']['tolerance']"/>&deg;C)
          </strong>
          <tal:ch define="changes view/study_changes" condition="changes">
            <p class="form-note">Readings changed after they were recorded (kept for audit):</p>
            <table class="pfas-table">
              <thead><tr><th>Point</th><th>Was (probe / NIST)</th><th>Recorded</th><th>By</th><th>Changed</th><th>By</th></tr></thead>
              <tbody><tr tal:repeat="c changes">
                <td tal:content="c/time_point">1</td>
                <td tal:content="python:'%s / %s' % (c['old_sensor'], c['old_nist'])">4.0 / 4.4</td>
                <td tal:content="c/old_recorded_at">2026-07-01T09:00</td>
                <td tal:content="c/old_entered_by">AN1</td>
                <td tal:content="c/changed_at">2026-07-02</td>
                <td tal:content="c/changed_by">AN1</td>
              </tr></tbody>
            </table>
          </tal:ch>
          <div class="pfas-point-grid">
            <tal:each tal:repeat="pt python:det['points']">
              <div class="pfas-point-cell">
                <label>Point <tal:n tal:replace="pt/time_point"/></label>
                <div tal:condition="python:pt.get('sensor_reading') is not None">
                  Sensor: <strong tal:content="python:'{:.2f}'.format(pt['sensor_reading'])"/>&deg;C<br/>
                  NIST: <strong tal:content="python:'{:.2f}'.format(pt['nist_reading'])"/>&deg;C<br/>
                  Dev: <span tal:attributes="class python:'pfas-text-bad' if pt.get('passed')==0 else 'pfas-text-ok'"
                             tal:content="python:('+' if pt['deviation']>=0 else '')+'{:.3f}'.format(pt['deviation'])"></span>&deg;C
                </div>
                <form method="POST"
                      tal:attributes="action string:${purl}/@@pfas-temperature-log?unit_id=${unit/id}&amp;study_id=${det/study/id}">
                  <input type="hidden" name="action" value="save_point"/>
                  <input type="hidden" name="study_id"
                         tal:attributes="value python:det['study']['id']"/>
                  <input type="hidden" name="time_point"
                         tal:attributes="value pt/time_point"/>
                  <input type="datetime-local" name="recorded_at" title="When this pair was read (the four span two days)"
                         tal:attributes="value python:pt.get('recorded_at','')[:16] if pt.get('recorded_at') else ''"/>
                  <input type="number" step="0.01" name="sensor_reading" placeholder="Sensor °C"
                         tal:attributes="value python:pt.get('sensor_reading','')"/>
                  <input type="number" step="0.01" name="nist_reading" placeholder="NIST °C"
                         tal:attributes="value python:pt.get('nist_reading','')"/>
                  <button type="submit" class="btn-sm btn-primary">
                    Save
                  </button>
                </form>
              </div>
            </tal:each>
          </div>
        </div>
      </tal:detail>

      <!-- New study form -->
      <details class="pfas-mt-md">
        <summary class="pfas-summary-link">
          + New Temperature Study
        </summary>
        <form method="POST" class="pfas-mt"
              tal:attributes="action string:${purl}/@@pfas-temperature-log?unit_id=${unit/id}">
          <input type="hidden" name="action" value="add_study"/>
          <input type="hidden" name="unit_id" tal:attributes="value unit/id"/>
          <div class="pfas-form-row">
            <div class="pfas-form-field"><label>Study date</label>
              <input type="date" name="study_date"/></div>
            <div class="pfas-form-field"><label>Operator initials</label>
              <input type="text" name="operator" maxlength="10"/></div>
            <div class="pfas-form-field"><label>Reference thermometer</label>
              <select name="reference_uid">
                <option value="">&mdash; not registered: type its serial &mdash;</option>
                <option tal:repeat="r view/reference_thermometers"
                        tal:attributes="value r/id"
                        tal:content="python:'%s (SN %s)' % (r['name'], r['serial_number'] or '?')">Ref 1</option>
              </select></div>
            <div class="pfas-form-field"><label>NIST thermometer serial</label>
              <input type="text" name="nist_serial"/></div>
            <div class="pfas-form-field"><label>NIST cert date</label>
              <input type="date" name="nist_cert_date"/></div>
            <div class="pfas-form-field"><label>Tolerance (&deg;C)</label>
              <input type="number" step="0.1" name="tolerance"
                     tal:attributes="value python:unit.get('study_tolerance',1.0)"/></div>
          </div>
          <div class="pfas-form-field is-spaced"><label>Notes</label>
            <textarea name="notes" rows="2"></textarea></div>
          <button type="submit" class="btn btn-primary">
            Create Study
          </button>
        </form>
      </details>
    </div>

  </tal:has-unit>
  </tal:def>
</metal:content>

<tal:scripts metal:fill-slot="scripts">
<script tal:condition="view/unit"
        tal:define="rjson view/readings_json; ujson view/unit_json">
  <tal:v tal:replace="structure string:var _readings = ${rjson};"/>
  <tal:v tal:replace="structure string:var _unit = ${ujson};"/>
</script>
<script tal:condition="view/unit">
//<![CDATA[
(function(){
  var canvas = document.getElementById('tempChart');
  if (!canvas || !_readings || !_readings.length) {
    if (canvas) canvas.parentNode.innerHTML = '<div class="pfas-empty">No readings in this period.</div>';
    return;
  }

  var _css = getComputedStyle(document.documentElement);
  function tok(n){ return (_css.getPropertyValue(n)||'').trim(); }
  var fsz = parseInt(tok('--fs-xs'), 10) || 11;
  var muted = tok('--text-muted');
  function rgba(v,a){ var h=v.replace('#',''); return 'rgba('+parseInt(h.substr(0,2),16)+','+parseInt(h.substr(2,2),16)+','+parseInt(h.substr(4,2),16)+','+a+')'; }

  var tempData = [], humData = [], hasHum = false;
  _readings.forEach(function(r){
    if (r.temperature != null)
      tempData.push({x: r.ts.replace('T',' '), y: (r.corrected != null ? r.corrected : r.temperature),
                     in_range: r.in_range, humidity: r.humidity});
    if (r.humidity != null) hasHum = true;
  });

  var ptColors = tempData.map(function(p){
    return p.in_range ? rgba(tok('--s-success'),0.9) : rgba(tok('--s-danger'),0.9);
  });

  var datasets = [{
    label: 'Temperature (°C)',
    data: tempData.map(function(p){ return {x:p.x, y:p.y}; }),
    type: 'scatter',
    pointRadius: 3,
    pointHoverRadius: 5,
    pointBackgroundColor: ptColors,
    pointBorderColor: ptColors,
    showLine: true,
    borderColor: rgba(tok('--s-primary'),0.6),
    borderWidth: 1,
    tension: 0,
    fill: false,
    yAxisID: 'yTemp',
  }];

  if (hasHum) {
    var humData2 = _readings.filter(function(r){ return r.humidity!=null; })
                            .map(function(r){ return {x:r.ts.replace('T',' '), y:r.humidity}; });
    datasets.push({
      label: 'Humidity (%RH)',
      data: humData2,
      type: 'scatter',
      pointRadius: 2,
      showLine: true,
      borderColor: rgba(tok('--s-warning'),0.7),
      borderWidth: 1,
      backgroundColor: rgba(tok('--s-warning'),0.3),
      fill: false,
      yAxisID: 'yHum',
    });
  }

  // Limit lines
  var tMin = _unit.temp_min, tMax = _unit.temp_max;
  var xs = tempData.map(function(p){return p.x;});
  if (tMin != null) datasets.push({
    label: 'Min '+tMin+'°C', type:'line',
    data: [{x:xs[0],y:tMin},{x:xs[xs.length-1],y:tMin}],
    borderColor: rgba(tok('--s-danger'),0.6), borderWidth:1.5,
    borderDash:[5,4], pointRadius:0, fill:false, yAxisID:'yTemp'
  });
  if (tMax != null) datasets.push({
    label: 'Max '+tMax+'°C', type:'line',
    data: [{x:xs[0],y:tMax},{x:xs[xs.length-1],y:tMax}],
    borderColor: rgba(tok('--s-danger'),0.6), borderWidth:1.5,
    borderDash:[5,4], pointRadius:0, fill:false, yAxisID:'yTemp'
  });

  var scales = {
    x: { type:'category', ticks:{maxTicksLimit:10, font:{size:fsz}},
         grid:{color:rgba(tok('--s-border'),1)} },
    yTemp: { position:'left', title:{display:true,text:'°C',font:{size:fsz}},
             ticks:{font:{size:fsz}}, grid:{color:rgba(tok('--s-border'),1)} },
  };
  if (hasHum) scales.yHum = {
    position:'right', title:{display:true,text:'% RH',font:{size:fsz}},
    ticks:{font:{size:fsz}}, grid:{display:false}
  };

  Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
  if (muted) Chart.defaults.color = muted;
  new Chart(canvas, {
    type: 'scatter',
    data: {datasets: datasets},
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: {display:true, position:'top', labels:{boxWidth:9,font:{size:fsz}}},
        tooltip: {callbacks:{label:function(ctx){
          var d = tempData[ctx.dataIndex] || {};
          var lines = ['Temp: '+ctx.parsed.y.toFixed(2)+'°C'];
          if (d.humidity!=null) lines.push('RH: '+d.humidity.toFixed(1)+'%');
          return lines;
        }}}
      },
      scales: scales,
    }
  });
})();
//]]>
</script>
</tal:scripts>
</body>
</html>
