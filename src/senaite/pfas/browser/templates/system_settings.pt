<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">System</title>
  <metal:fill fill-slot="header-title">System</metal:fill>

  <div metal:fill-slot="content">
  <div class="page-body-narrow">
    <div class="alert alert-success" tal:condition="view/saved">Saved.</div>
    <div class="alert alert-error" tal:condition="view/failed">Not saved.</div>
    <div class="alert alert-error" tal:condition="view/coc_failed">CoC limits not saved: whole numbers from 1, or blank.</div>
    <div class="alert alert-error" tal:condition="view/signing_failed">Signing rules not saved: whole numbers, a PIN of 4 to 32 digits, the longest not under the shortest.</div>
    <div class="alert alert-error" tal:condition="view/fit_failed">Score to accept a fit not saved: a whole number from 1 to 100, or blank.</div>
    <div class="alert alert-error" tal:condition="view/raw_failed">Raw-data share not saved: an absolute path, and whole minutes from 1.</div>

    <div class="pfas-settings-grid">
    <form method="post" class="pfas-card" id="sec-notifications" tal:attributes="action string:${view/portal_url}/@@pfas-system">
      <input type="hidden" name="action" value="save_notices" tal:condition="view/can_configure" />
      <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
      <h3 class="pfas-card-head">Notifications <tal:h define="hid string:system-page"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></h3>
      <tal:k tal:repeat="k view/notice_kinds">
        <div class="pfas-form-row">
          <div class="pfas-form-field">
            <label class="pfas-switch">
              <input type="checkbox" value="on"
                     tal:attributes="name string:notice_email.${k/kind}; checked python:k['email'] and 'checked' or None;
                                     disabled python:None if view.can_configure() else 'disabled'" />
              <span class="pfas-switch-track"></span>
              <span tal:content="string:${k/title}: e-mail">Run sent back: e-mail</span>
            </label>
          </div>
          <div class="pfas-form-field">
            <label tal:attributes="for string:nh_${k/kind}">Remind every, hours</label>
            <input type="number" min="0" step="1"
                   tal:attributes="name string:notice_hours.${k/kind}; id string:nh_${k/kind}; value k/every_hours;
                                   disabled python:None if view.can_configure() else 'disabled'" />
          </div>
        </div>
      </tal:k>
      <div class="form-actions"><button class="btn btn-primary" type="submit" tal:condition="view/can_configure">Save</button></div>
    </form>

    <form method="post" class="pfas-card" id="sec-coc-limits" tal:define="lim view/coc_limits" tal:attributes="action string:${view/portal_url}/@@pfas-system">
      <h3 class="pfas-card-head">Client CoCs</h3>
      <input type="hidden" name="action" value="save_coc_limits" tal:condition="view/can_configure" />
      <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
      <div class="pfas-form-row">
        <div class="pfas-form-field">
          <label for="coc_daily_cap">New CoCs a client may start in a day</label>
          <input type="number" min="1" step="1" name="coc_daily_cap" id="coc_daily_cap"
                 tal:attributes="value python:lim.get('daily_cap') or ''; disabled python:None if view.can_configure() else 'disabled'" />
        </div>
        <div class="pfas-form-field">
          <label for="coc_unsubmitted_days">Days an unsubmitted CoC is kept</label>
          <input type="number" min="1" step="1" name="coc_unsubmitted_days" id="coc_unsubmitted_days"
                 tal:attributes="value python:lim.get('unsubmitted_days') or ''; disabled python:None if view.can_configure() else 'disabled'" />
        </div>
        <div class="pfas-form-field">
          <label for="coc_unsubmitted_paper_days">Days an unsubmitted paper CoC is kept</label>
          <input type="number" min="1" step="1" name="coc_unsubmitted_paper_days" id="coc_unsubmitted_paper_days"
                 tal:attributes="value view/coc_paper_days; disabled python:None if view.can_configure() else 'disabled'" />
        </div>
      </div>
      <div class="form-actions"><button class="btn btn-primary" type="submit" tal:condition="view/can_configure">Save</button></div>
    </form>

    <form method="post" class="pfas-card" id="sec-signing" tal:define="sr view/signing_rules; off python:None if view.can_configure() else 'disabled'"
          tal:attributes="action string:${view/portal_url}/@@pfas-system">
      <h3 class="pfas-card-head">Signing</h3>
      <input type="hidden" name="action" value="save_signing_rules" tal:condition="view/can_configure" />
      <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
      <div class="pfas-form-row">
        <div class="pfas-form-field">
          <label for="sign_pin_min">Shortest PIN, digits</label>
          <input type="number" min="4" max="32" step="1" name="sign_pin_min" id="sign_pin_min" required="required"
                 tal:attributes="value sr/pin_min; disabled off" />
        </div>
        <div class="pfas-form-field">
          <label for="sign_pin_max">Longest PIN, digits</label>
          <input type="number" min="4" max="32" step="1" name="sign_pin_max" id="sign_pin_max" required="required"
                 tal:attributes="value sr/pin_max; disabled off" />
        </div>
      </div>
      <div class="pfas-form-row">
        <div class="pfas-form-field">
          <label for="sign_lock_tries">Wrong tries before signing locks</label>
          <input type="number" min="1" step="1" name="sign_lock_tries" id="sign_lock_tries" required="required"
                 tal:attributes="value sr/lock_tries; disabled off" />
        </div>
        <div class="pfas-form-field">
          <label for="sign_lock_minutes">Tries counted over, and lock, minutes</label>
          <input type="number" min="1" step="1" name="sign_lock_minutes" id="sign_lock_minutes" required="required"
                 tal:attributes="value sr/lock_minutes; disabled off" />
        </div>
      </div>
      <div class="pfas-form-row">
        <div class="pfas-form-field">
          <label for="sign_expiry_days">Passwords and PINs expire after, days</label>
          <input type="number" min="1" step="1" name="sign_expiry_days" id="sign_expiry_days" placeholder="Never"
                 tal:attributes="value python:sr.get('expiry_days') or ''; disabled off" />
        </div>
      </div>
      <div class="form-actions"><button class="btn btn-primary" type="submit" tal:condition="view/can_configure">Save</button></div>
    </form>

    <form method="post" class="pfas-card" id="sec-fit-accept" tal:define="off python:None if view.can_configure() else 'disabled'"
          tal:attributes="action string:${view/portal_url}/@@pfas-system">
      <h3 class="pfas-card-head">Fit score</h3>
      <input type="hidden" name="action" value="save_fit_accept" tal:condition="view/can_configure" />
      <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
      <div class="pfas-form-row">
        <div class="pfas-form-field">
          <label for="fit_accept_default">Score to accept a fit, where a method sets none</label>
          <input type="number" min="1" max="100" step="1" name="fit_accept_default" id="fit_accept_default"
                 tal:attributes="value view/fit_accept_default; disabled off" />
        </div>
      </div>
      <div class="form-actions"><button class="btn btn-primary" type="submit" tal:condition="view/can_configure">Save</button></div>
    </form>

    </div>
  </div>

  <!-- the raw data folders and their instruments' table: the page's full width -->
  <div class="page-body">
    <form method="post" class="pfas-card" id="sec-raw" tal:define="raw view/raw_share" tal:attributes="action string:${view/portal_url}/@@pfas-system">
      <h3 class="pfas-card-head">Raw data folders</h3>
      <p class="form-note" tal:condition="not:view/can_site_admin">Only a Site Administrator changes where raw data is pulled from.</p>
      <tal:admin tal:condition="view/can_site_admin">
      <input type="hidden" name="action" value="save_raw" />
      <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
      <div class="pfas-form-row">
        <div class="pfas-form-field">
          <label for="raw_share_path">Folder for an instrument without its own</label>
          <input type="text" name="raw_share_path" id="raw_share_path" placeholder="/mnt/lcms/data"
                 tal:attributes="value python:raw.get('share_path') or ''" />
        </div>
        <div class="pfas-form-field">
          <label for="raw_settle_minutes">Unchanged before it is pulled, minutes</label>
          <input type="number" min="1" step="1" name="raw_settle_minutes" id="raw_settle_minutes"
                 tal:attributes="value python:raw.get('settle_minutes') or ''" />
        </div>
      </div>
      <div class="pfas-form-row">
        <div class="pfas-form-field is-wide">
          <label class="pfas-switch"><input type="checkbox" name="raw_delete_reinjection_files" value="yes"
                 tal:attributes="checked python:'checked' if raw.get('delete_reinjection_files') else None" /><span class="pfas-switch-track"></span>
            <span>Delete archived re-injection files not reported and not claimed</span></label>
        </div>
      </div>
      <table class="pfas-table pfas-table-fit" data-col-resize="system-raw-1" tal:define="rows view/raw_instruments">
        <thead><tr><th>Instrument</th><th>Raw data folder</th><th>Status</th><th>Last pull</th></tr></thead>
        <tbody>
          <tr tal:repeat="r rows">
            <td tal:content="r/name">LC-MS 1</td>
            <td tal:content="python:r['folder'] or u'Not set'">/mnt/lcms/data</td>
            <td><span class="badge" tal:attributes="class python:'badge badge-active' if r['status'] == 'Watching' else 'badge badge-quarantine' if r['status'] == 'Default folder' else 'badge badge-expired'"
                      tal:content="r/status">Watching</span></td>
            <td tal:content="python:r['last'] or u'None yet'">2026-11-12 14:05</td>
          </tr>
          <tr tal:condition="not:rows"><td colspan="4">None registered</td></tr>
        </tbody>
      </table>
      <div class="form-actions"><button class="btn btn-primary" type="submit">Save</button>
        <a class="btn btn-secondary" tal:attributes="href view/equipment_url">Equipment</a></div>
      </tal:admin>
    </form>
  </div>

  <div class="page-body-narrow">
    <div class="pfas-settings-grid">
    <div class="pfas-card" id="sec-site-admin" tal:condition="view/can_site_admin">
      <h3 class="pfas-card-head">Site Administrator</h3>
      <p class="form-note">Plone's own control panels.</p>
      <div class="form-actions">
        <a class="btn-sm btn-secondary" tal:repeat="p view/control_panels"
           tal:attributes="href p/href" tal:content="p/label">Mail</a>
      </div>
    </div>
    </div>
  </div>
  </div>
</html>
