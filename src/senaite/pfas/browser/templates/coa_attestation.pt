<tal:attestation define="sig view/signatories"
                 i18n:domain="senaite.pfas">
  <!-- Controlled CoA attestation (D65 A2). Rendered in the impress report
       context, so all styling is inline/scoped here (the PFAS macro stylesheet
       is not loaded on published reports). Actors are the live workflow
       actors resolved in coa_attestation.py. -->
  <div class="pfas-coa-attestation">
    <style type="text/css" tal:content="structure view/print_css">/* the lab print stylesheet */</style>

    <div class="coa-att-title">
      <span i18n:translate="">Certificate authorization &mdash; controlled record</span>
      <span tal:condition="view/meta/report_id" class="coa-att-id">
        <span tal:content="view/meta/report_id"></span>
      </span>
    </div>

    <table class="coa-att-tbl" tal:condition="python:view.style() == 'full'">
      <!-- Prepared by (analyst[s] who submitted) -->
      <tr>
        <td class="role" i18n:translate="">Prepared by</td>
        <td>
          <tal:has condition="sig/prepared">
            <div class="person" tal:repeat="p sig/prepared">
              <img class="sig" tal:condition="p/signature_url"
                   tal:attributes="src p/signature_url"/>
              <div class="sigline" tal:condition="not:p/signature_url"></div>
              <div class="nm" tal:content="p/fullname"></div>
              <div class="jt" tal:condition="p/jobtitle"
                   tal:content="p/jobtitle"></div>
              <div class="jt" tal:condition="not:p/jobtitle"
                   i18n:translate="">Analyst</div>
              <div class="dt" tal:content="p/date"></div>
            </div>
          </tal:has>
          <div class="person" tal:condition="not:sig/prepared">
            <div class="sigline"></div>
            <div class="nm">&mdash;</div>
          </div>
        </td>
      </tr>

      <!-- Verified by (technical reviewer / QAO) -->
      <tr>
        <td class="role" i18n:translate="">Verified by</td>
        <td>
          <tal:has condition="sig/verified">
            <div class="person" tal:repeat="p sig/verified">
              <img class="sig" tal:condition="p/signature_url"
                   tal:attributes="src p/signature_url"/>
              <div class="sigline" tal:condition="not:p/signature_url"></div>
              <div class="nm" tal:content="p/fullname"></div>
              <div class="jt" tal:condition="p/jobtitle"
                   tal:content="p/jobtitle"></div>
              <div class="jt" tal:condition="not:p/jobtitle"
                   i18n:translate="">Technical reviewer</div>
              <div class="dt" tal:content="p/date"></div>
            </div>
          </tal:has>
          <div class="person" tal:condition="not:sig/verified">
            <div class="sigline"></div>
            <div class="nm">&mdash;</div>
          </div>
        </td>
      </tr>

      <!-- Authorized by (the publisher, now) -->
      <tr tal:define="a sig/authorized">
        <td class="role" i18n:translate="">Authorized by</td>
        <td>
          <div class="person">
            <img class="sig" tal:condition="a/signature_url"
                 tal:attributes="src a/signature_url"/>
            <div class="sigline" tal:condition="not:a/signature_url"></div>
            <div class="nm" tal:content="a/fullname"></div>
            <div class="jt" tal:condition="a/jobtitle"
                 tal:content="a/jobtitle"></div>
            <div class="jt" tal:condition="not:a/jobtitle"
                 i18n:translate="">Authorized signatory</div>
            <div class="dt" tal:content="a/date"></div>
          </div>
        </td>
      </tr>
    </table>

    <!-- Compact sign-off (default, Print Settings > Certificate): one row, the
         three tiers side by side; a signature image if one is on file, no
         empty signature space otherwise. -->
    <table class="coa-att-compact" tal:condition="python:view.style() != 'full'">
      <tr>
        <td tal:repeat="tier python:[('Prepared by', sig['prepared']), ('Verified by', sig['verified']), ('Authorized by', [sig['authorized']] if sig['authorized'] else [])]">
          <div class="role" tal:content="python:tier[0]">Prepared by</div>
          <tal:p repeat="p python:tier[1]">
            <img class="sig-sm" tal:condition="p/signature_url" tal:attributes="src p/signature_url"/>
            <div><span class="nm" tal:content="p/fullname"></span>
                 <span class="dt" tal:content="p/date"></span></div>
          </tal:p>
          <div tal:condition="not:python:tier[1]">&mdash;</div>
        </td>
      </tr>
    </table>

    <div class="coa-att-note" i18n:translate="">
      This certificate is issued as a controlled documentation publication. The
      signatories above are the actual personnel who prepared, verified and
      authorized this report under the laboratory's technical review procedure
      (ISO/IEC 17025 §7.8.4).
    </div>
  </div>
</tal:attestation>
