<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Homogenisation Techniques</title>
  <metal:fill fill-slot="header-title">Homogenisation Techniques</metal:fill>
  <tal:r metal:fill-slot="header-right">
    <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-equipment-types">Equipment Types</a>
  </tal:r>

  <!-- the form's Save, pinned at the foot of the window -->
  <tal:ab metal:fill-slot="action-bar"><tal:sb tal:condition="view/can_configure" tal:define="sb_form string:homogenisation-form"><div
      metal:use-macro="context/@@pfas-macros/macros/save-bar"></div></tal:sb></tal:ab>

  <div metal:fill-slot="content">
  <div class="page-body" tal:define="purl view/portal_url">

    <div class="alert alert-success" tal:condition="view/saved">Saved.</div>
    <div class="alert alert-error" tal:repeat="e view/errors|nothing" tal:content="e">error</div>

    <p class="form-note">Techniques, and each matrix's default. <tal:h define="hid string:homogenisation"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></p>

    <form method="post" id="homogenisation-form" tal:attributes="action string:${purl}/@@pfas-homogenisation-setup"
          tal:define="methods view/methods; starter view/starter">
      <fieldset class="pfas-ro" tal:attributes="disabled python:None if view.can_configure() else 'disabled'">
      <nav class="pfas-seg pfas-seg-strip is-spaced" data-tabs="data-tabs" data-hash="data-hash" role="tablist" aria-label="Homogenisation sections">
        <button type="button" class="pfas-seg-item" role="tab" data-pane="hg-methods" aria-selected="true">Techniques</button>
        <button type="button" class="pfas-seg-item" role="tab" data-pane="hg-matrix" aria-selected="false">By matrix</button>
      </nav>
      <div class="pfas-pane is-active" id="hg-methods">
      <div class="pfas-rows" data-rows="data-rows" tal:define="rm context/@@pfas-row-menu">
        <table class="pfas-table pfas-table-form pfas-table-fit is-roomy" data-col-resize="homogenisation-setup-1">
          <thead><tr><th class="is-name">Technique</th><th class="is-center">Homogeniser unit recorded</th><th class="is-center">In use</th></tr></thead>
          <tbody data-row-list="data-row-list">
            <tr class="is-builtin">
              <td><input type="text" value="Not homogenised" disabled="disabled" aria-label="Technique" /></td>
              <td class="is-center"><label class="pfas-switch"><input type="checkbox" disabled="disabled" aria-label="Homogeniser unit recorded, Not homogenised" /><span class="pfas-switch-track"></span></label></td>
              <td class="is-center"><label class="pfas-switch"><input type="checkbox" checked="checked" disabled="disabled" aria-label="In use, Not homogenised" /><span class="pfas-switch-track"></span></label></td>
            </tr>
            <tr data-row="data-row" tal:repeat="m methods"
                tal:attributes="data-row-actions python:rm.actions((u'Remove', 'event', 'remove-row', {'danger': True}))">
              <td><input type="hidden" tal:attributes="name string:m__${repeat/m/index}__id; value m/id" />
                  <input type="text" tal:attributes="name string:m__${repeat/m/index}__title; value m/title; aria-label string:Technique ${repeat/m/number}" /></td>
              <td class="is-center"><label class="pfas-switch"><input type="checkbox" value="on"
                         tal:attributes="name string:m__${repeat/m/index}__unit_required; checked python:'checked' if m.get('unit_required') else None; aria-label string:Homogeniser unit recorded, ${m/title}" /><span class="pfas-switch-track"></span></label></td>
              <td class="is-center"><label class="pfas-switch"><input type="checkbox" value="on"
                         tal:attributes="name string:m__${repeat/m/index}__active; checked python:'checked' if m.get('active', True) else None; aria-label string:In use, ${m/title}" /><span class="pfas-switch-track"></span></label></td>
            </tr>
            <tr data-row="data-row" tal:repeat="t starter"
                tal:attributes="data-row-actions python:rm.actions((u'Remove', 'event', 'remove-row', {'danger': True}))">
              <td><input type="text" tal:attributes="name python:'m__%d__title' % (len(methods) + repeat['t'].index); placeholder t; aria-label string:New technique" /></td>
              <td class="is-center"><label class="pfas-switch"><input type="checkbox" value="on"
                         tal:attributes="name python:'m__%d__unit_required' % (len(methods) + repeat['t'].index); checked string:checked; aria-label string:Homogeniser unit recorded, new technique" /><span class="pfas-switch-track"></span></label></td>
              <td class="is-center"></td>
            </tr>
          </tbody>
        </table>
        <template data-row-template="data-row-template">
          <tr data-row="data-row"
              tal:attributes="data-row-actions python:rm.actions((u'Remove', 'event', 'remove-row', {'danger': True}))">
            <td><input type="text" name="m____i____title" aria-label="New technique" /></td>
            <td class="is-center"><label class="pfas-switch"><input type="checkbox" name="m____i____unit_required" value="on" checked="checked" aria-label="Homogeniser unit recorded, new technique" /><span class="pfas-switch-track"></span></label></td>
            <td class="is-center"></td>
          </tr>
        </template>
        <button type="button" class="btn-sm btn-secondary pfas-add-row" data-row-add="data-row-add" tal:condition="view/can_configure">+ Add technique</button>
      </div>
      </div>

      <div class="pfas-pane" id="hg-matrix">
      <table class="pfas-table pfas-table-form pfas-table-fit" data-col-resize="homogenisation-setup-2">
        <thead><tr><th class="is-center">Matrix</th><th>Starts at</th></tr></thead>
        <tbody>
          <tr tal:repeat="x view/matrices">
            <td class="is-center" tal:content="x/title">Eggs</td>
            <td><select tal:attributes="name string:default__${x/uid}; aria-label string:Starts at, ${x/title}">
                  <option tal:repeat="c x/choices"
                          tal:attributes="value python:c[0]; selected python:'selected' if c[0] == x['current'] else None"
                          tal:content="python:c[1]">IKA mill</option>
                </select></td>
          </tr>
        </tbody>
      </table>
      </div>
      </fieldset>
    </form>

  </div>
  </div>
</html>
