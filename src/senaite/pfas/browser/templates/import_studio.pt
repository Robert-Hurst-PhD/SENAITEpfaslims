<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Import Studio — Instrument Mapping</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
    .btn-save-profile { width: 100%; }   /* look: shared .btn-primary */
    .studio-layout { display: flex; gap: 24px; align-items: flex-start; }
    .studio-main   { flex: 1 1 auto; min-width: 0; }
    .studio-side   { flex: 0 0 260px; }

    /* ── Landing page ─────────────────────────────────────── */
    .instr-list { list-style: none; padding: 0; margin: 0 0 20px; }
    .instr-list li { padding: 10px 14px; border: 1px solid var(--s-border);
                     border-radius: 8px; margin-bottom: 8px; display: flex;
                     justify-content: space-between; align-items: center; }
    .instr-list li .instr-title { font-weight: 600; font-size: var(--fs-base); }
    .profile-badge { font-size: var(--fs-xs); color: var(--s-secondary); margin-left: 8px; }
    .instr-action  { font-size: var(--fs-sm); }

    /* ── Upload area ──────────────────────────────────────── */
    .upload-box { border: 2px dashed var(--s-border); border-radius: 12px;
                  padding: 40px 24px; text-align: center;
                  background: #fafbfc; cursor: pointer;
                  transition: border-color .15s; }
    .upload-box:hover, .upload-box.drag-over { border-color: var(--s-primary); background: var(--s-info-lt); }
    .upload-box .upload-icon { font-size: 36px; margin-bottom: 10px; }
    .upload-box p  { font-size: var(--fs-base); color: var(--s-secondary); margin: 0; }
    /* file input is rendered outside .upload-box; hidden via inline style */
    .upload-chosen { font-size: var(--fs-sm); color: var(--s-primary-dk); margin-top: 8px; font-weight: 600; }

    /* ── Detection banner ─────────────────────────────────── */
    .detect-banner { border-radius: 8px; padding: 12px 16px; margin-bottom: 20px;
                     font-size: var(--fs-base); display: flex; gap: 12px; align-items: center; }
    .detect-banner.high  { background: var(--s-success-lt); border: 1px solid var(--s-success-bd); color: var(--s-success-text); }
    .detect-banner.med   { background: var(--s-warn-lt); border: 1px solid var(--s-warn-bd); color: var(--s-warn-text); }
    .detect-banner.low   { background: var(--s-danger-lt); border: 1px solid var(--s-danger-bd); color: var(--s-danger-dk); }
    .detect-banner strong { font-size: var(--fs-base); }
    .conf-pill { font-size: var(--fs-xs); padding: 2px 8px; border-radius: 10px;
                 background: rgba(0,0,0,.12); font-weight: 700; }

    /* ── Mapping grid ─────────────────────────────────────── */
    .mapping-grid { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
    .mapping-grid th { background: var(--s-light); padding: 8px 10px; text-align: left;
                       border-bottom: 2px solid var(--s-border); font-weight: 700; }
    .mapping-grid td { padding: 5px 8px; border-bottom: 1px solid var(--s-border); vertical-align: middle; }
    .mapping-grid td.col-name  { font-family: var(--font-mono); font-size: var(--fs-xs); color: #333; max-width: 160px;
                                  word-break: break-all; }
    .mapping-grid td.col-preview { font-family: var(--font-mono); font-size: var(--fs-xs); color: #666; max-width: 200px; }
    .mapping-grid select { width: 100%; padding: 4px 6px; font-size: var(--fs-sm);
                           border: 1px solid var(--s-input-border); border-radius: 5px; }
    .mapping-grid select.mapped   { border-color: var(--s-success); background: #f0fff4; }
    .mapping-grid select.ignored  { border-color: #adb5bd; background: var(--s-light); color: var(--s-secondary); }

    /* ── Preview rows ─────────────────────────────────────── */
    .preview-table { width: 100%; border-collapse: collapse; font-size: var(--fs-xs);
                     font-family: var(--font-mono); margin-bottom: 20px; overflow-x: auto; display: block; }
    .preview-table th { background: var(--s-light); padding: 4px 6px;
                        border: 1px solid var(--s-border); font-weight: 700; }
    .preview-table td { padding: 3px 6px; border: 1px solid var(--s-border); white-space: nowrap; }

    /* ── Side: save profile form ─────────────────────────── */
    .profile-card { background: var(--s-light); border: 1px solid var(--s-border);
                    border-radius: 10px; padding: 18px; }
    .profile-card h3 { font-size: var(--fs-base); font-weight: 700; margin: 0 0 14px; }
    .profile-card label { font-size: var(--fs-sm); font-weight: 600; display: block;
                          margin-bottom: 3px; color: var(--s-dark); }
    .profile-card input[type=text],
    .profile-card select,
    .profile-card textarea { width: 100%; padding: 6px 8px; font-size: var(--fs-sm);
                              border: 1px solid var(--s-input-border); border-radius: 5px;
                              margin-bottom: 12px; box-sizing: border-box; }
    .profile-card textarea { min-height: 60px; resize: vertical; }
    .calc-explainer { font-size: var(--fs-xs); color: var(--s-secondary); margin-top: -8px; margin-bottom: 12px;
                      line-height: 1.4; }

    /* ── Existing profiles list ──────────────────────────── */
    .saved-profiles { margin-top: 20px; }
    .saved-profiles h4 { font-size: var(--fs-sm); font-weight: 700; margin-bottom: 8px;
                         color: var(--s-secondary); text-transform: uppercase; letter-spacing: .5px; }
    .profile-row { font-size: var(--fs-xs); padding: 5px 0;
                   border-bottom: 1px solid var(--s-border); display: flex;
                   justify-content: space-between; align-items: center; }
    .profile-row .pv-tag { font-family: var(--font-mono); font-size: var(--fs-xs); font-weight: 700; }
    .profile-row .pv-vendor { color: var(--s-secondary); }
    .pv-calc { font-size: var(--fs-xs); padding: 1px 6px; border-radius: 8px; font-weight: 600; }
    .pv-calc.final { background: var(--s-success-lt); color: var(--s-success-text); }
    .pv-calc.raw   { background: var(--s-info-lt); color: var(--s-info-text); }

    /* ── Alerts ────────────────────────────────────────────── */
    .alert-ok    { background: var(--s-success-lt); border: 1px solid var(--s-success-bd); color: var(--s-success-text);
                   padding: 10px 16px; border-radius: 8px; margin-bottom: 16px; font-size: var(--fs-base); }
    .alert-error { background: var(--s-danger-lt); border: 1px solid var(--s-danger-bd); color: var(--s-danger-dk);
                   padding: 10px 16px; border-radius: 8px; margin-bottom: 16px; font-size: var(--fs-base); }
    .alert-info  { background: var(--s-info-lt); border: 1px solid var(--s-info-bd); color: var(--s-info-text);
                   padding: 10px 16px; border-radius: 8px; margin-bottom: 16px; font-size: var(--fs-base); }

    .section-title { font-size: var(--fs-lg); font-weight: 700; color: var(--s-dark);
                     margin: 0 0 18px; padding-bottom: 8px;
                     border-bottom: 2px solid var(--s-border); }
    .instr-selector { margin-bottom: 20px; }
    .instr-selector label { font-weight: 600; font-size: var(--fs-base); margin-right: 10px; }
    .instr-selector select { padding: 7px 10px; font-size: var(--fs-base);
                              border: 1px solid var(--s-input-border); border-radius: 6px;
                              min-width: 280px; }
  </style>
  <script type="text/javascript">
  //<![CDATA[
  /* All Import Studio JS lives here (head-extra slot) because Plone's
     transform pipeline strips <script> blocks from the body. */
  var colMap = {};
  var CALC_EXPLANATIONS = {
    'final': '<strong>Final mode:</strong> the instrument software already computed the concentration. Map the result column and the pipeline uses it directly.',
    'raw':   '<strong>Raw mode:</strong> map native peak area + IS peak area. The pipeline divides them, applies the calibration curve, salt factor, and matrix factor to compute the final result.'
  };
  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function showLanding() {
    document.getElementById('phase-landing').hidden = false;
    document.getElementById('phase-mapping').hidden = true;
  }
  function showMapping() {
    document.getElementById('phase-landing').hidden = true;
    document.getElementById('phase-mapping').hidden = false;
  }
  function showChosen(inp) {
    var n = inp && inp.files && inp.files[0] ? inp.files[0].name : '';
    var el = document.getElementById('chosen-name');
    if (el && n) { el.textContent = '✔ ' + n; el.hidden = false; }
    var btn = document.getElementById('upload-btn');
    if (btn) { btn.disabled = !n; }
  }
  function handleDrop(e) {
    e.preventDefault();
    var box = document.getElementById('upload-box');
    if (box) box.classList.remove('drag-over');
    var files = e.dataTransfer.files;
    if (!files.length) return;
    var inp = document.getElementById('file-input');
    if (inp) {
      var dt = new DataTransfer();
      dt.items.add(files[0]);
      inp.files = dt.files;
    }
    showChosen(inp);
  }
  function buildPurposeOptions(col) {
    var cur = colMap[col] || 'ignore';
    var html = '';
    if (typeof PURPOSES === 'undefined') return html;
    for (var i = 0; i < PURPOSES.length; i++) {
      var k = PURPOSES[i][0], lbl = PURPOSES[i][1];
      html += '<option value="' + esc(k) + '"' + (k === cur ? ' selected' : '') + '>' + esc(lbl) + '</option>';
    }
    return html;
  }
  function renderMappingGrid(headers, preview) {
    var headTr = document.getElementById('preview-head');
    if (headTr) {
      var headHtml = '<th>#</th>';
      headers.forEach(function(h) { headHtml += '<th>' + esc(h) + '</th>'; });
      headTr.innerHTML = headHtml;
    }
    var bodyEl = document.getElementById('preview-body');
    if (bodyEl) {
      bodyEl.innerHTML = '';
      preview.forEach(function(row, ri) {
        var tr = document.createElement('tr');
        var html = '<td>' + (ri + 1) + '</td>';
        headers.forEach(function(h, ci) { html += '<td>' + esc(row[ci] == null ? '' : row[ci]) + '</td>'; });
        tr.innerHTML = html;
        bodyEl.appendChild(tr);
      });
    }
    var tbody = document.getElementById('mapping-body');
    if (tbody) {
      tbody.innerHTML = '';
      headers.forEach(function(col, ci) {
        var sampleVals = preview.slice(0, 3).map(function(r) { return r[ci]; })
                                .filter(function(v) { return v != null && String(v).trim(); })
                                .slice(0, 3);
        var tr = document.createElement('tr');
        tr.setAttribute('data-col', col);
        tr.innerHTML =
          '<td class="col-name">' + esc(col) + '</td>' +
          '<td><select data-col="' + esc(col) + '">' + buildPurposeOptions(col) + '</select></td>' +
          '<td class="col-preview">' + esc(sampleVals.join(' | ')) + '</td>';
        tbody.appendChild(tr);
        var sel = tr.querySelector('select');
        sel.addEventListener('change', function() { setPurpose(col, this.value); });
        styleSelect(col);
      });
      updateCount(headers);
    }
  }
  function setPurpose(col, val) {
    colMap[col] = val;
    styleSelect(col);
    updateCount(Object.keys(colMap));
    updateColMapJson();
  }
  function styleSelect(col) {
    var sels = document.querySelectorAll('#mapping-body select');
    for (var i = 0; i < sels.length; i++) {
      if (sels[i].getAttribute('data-col') === col) {
        sels[i].className = (colMap[col] || 'ignore') === 'ignore' ? 'ignored' : 'mapped';
      }
    }
  }
  function updateCount(headers) {
    var mapped = 0;
    headers.forEach(function(col) { if ((colMap[col] || 'ignore') !== 'ignore') mapped++; });
    var mc = document.getElementById('mapped-count');
    var tc = document.getElementById('total-count');
    if (mc) mc.textContent = mapped;
    if (tc) tc.textContent = headers.length;
  }
  function autoIgnoreAll() {
    Object.keys(colMap).forEach(function(col) { colMap[col] = 'ignore'; });
    var sels = document.querySelectorAll('#mapping-body select');
    for (var i = 0; i < sels.length; i++) { sels[i].value = 'ignore'; sels[i].className = 'ignored'; }
    updateCount(Object.keys(colMap));
    updateColMapJson();
  }
  function updateColMapJson() {
    /* only this file's columns are saved: never another layout's */
    var out = {};
    var heads = (typeof UPLOAD_RESULT !== 'undefined' && UPLOAD_RESULT) ? (UPLOAD_RESULT.headers || []) : [];
    heads.forEach(function(h) { out[h] = colMap[h] || 'ignore'; });
    var el = document.getElementById('save-col-map');
    if (el) el.value = JSON.stringify(out);
  }
  function updateCalChain() {
    var s = document.getElementById('s-calc');
    var ex = document.getElementById('calc-explainer');
    if (ex) ex.innerHTML = CALC_EXPLANATIONS[s ? s.value : 'final'] || '';
  }
  function setVal(id, v) { var el = document.getElementById(id); if (el && v != null) el.value = v; }
  function prepSave() { updateColMapJson(); return true; }
  document.addEventListener('DOMContentLoaded', function() {
    var btn = document.getElementById('upload-btn');
    if (btn) { btn.disabled = true; }
    var fi = document.getElementById('file-input');
    if (fi) { fi.addEventListener('change', function() { showChosen(this); }); }
    if (typeof UPLOAD_RESULT === 'undefined' || !UPLOAD_RESULT) return;
    var r = UPLOAD_RESULT;
    colMap = r.col_map || {};
    showMapping();
    var mfn = document.getElementById('mapping-filename');
    if (mfn) mfn.textContent = r.filename || '';
    var banner = document.getElementById('detect-banner');
    if (banner) {
      banner.hidden = false;
      banner.textContent = (r.edit_mode ? 'Saved layout, opened for editing. '
          : 'Read ' + (r.rows_read || 0) + ' row(s) and ' + (r.headers || []).length + ' column(s). ') +
        (r.existing_profile && !r.edit_mode ? 'This file fits the saved layout shown below: saving updates it.' :
         (r.edit_mode ? '' : (r.notice ? r.notice + ' ' : 'No saved layout fits this file: ') +
          'The columns start from what was found.'));
    }
    renderMappingGrid(r.headers || [], r.preview || []);
    setVal('save-instr-uid', r.instrument_uid || '');
    setVal('s-instr-display', r.instrument_title || 'any instrument');
    setVal('save-reader', JSON.stringify(r.reader || {}));
    setVal('save-signature', JSON.stringify(r.signature || []));
    setVal('save-columns', JSON.stringify(r.headers || []));
    setVal('save-layout-id', r.layout_id || '');
    var st = r.settings || {};
    setVal('s-name', st.layout_name || '');
    setVal('s-match', st.match || 'within');
    setVal('s-required', st.required_fields || '');
    setVal('s-calc', st.calc_mode || 'final');
    setVal('s-manual', st.manual_markers || '');
    setVal('s-date', st.date_format || '');
    setVal('s-values', st.value_maps || '');
    setVal('s-scales', st.scales || '');
    setVal('s-qual', st.qualifier_suffix || '');
    setVal('s-notes', st.notes || '');
    setVal('s-software', st.software || '');
    var lab = document.getElementById('s-labelled');
    if (lab) lab.checked = !!st.labelled_from_columns;
    updateColMapJson();
    updateCalChain();
  });
  //]]>
  </script>
  </tal:styles>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Import Studio &mdash; Instrument Import Layouts</tal:t>
  <tal:r metal:fill-slot="header-right">
  </tal:r>
  <div metal:fill-slot="content">
  <div class="page-body">
    <div tal:condition="view/ok_msg"    class="alert-ok"    tal:content="view/ok_msg"></div>
    <div tal:condition="view/error_msg" class="alert-error" tal:content="view/error_msg"></div>
    <!-- TAL-driven variables: inject server state for JS to consume -->
    <script type="text/javascript">
    var UPLOAD_RESULT = <tal:d tal:replace="structure view/upload_result_json" />;
    var PURPOSES = <tal:p tal:replace="structure python:__import__('json').dumps(view.purposes())" />;
    </script>
    <!-- PHASE 1: the instrument, the export and how it is laid out -->
    <tal:phase1 tal:define="instruments view/instruments; rf view/reader_form; ch view/layout_choices">
    <div id="phase-landing">
      <h2 class="section-title">Step 1 &mdash; Instrument, export and how it is laid out</h2>
      <p class="field-hint">Upload an export with the options its layout needs.
        <tal:h define="hid string:import-profiles"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></p>
      <p tal:condition="not:view/can_configure">Import layouts are set by a Manager.</p>
      <form method="post" enctype="multipart/form-data"
            tal:condition="view/can_configure"
            tal:attributes="action string:${view/portal_url}/@@pfas-import-studio"
            id="upload-form">
        <input type="hidden" name="action" value="upload" />
        <div class="field-grid">
          <label>Instrument
            <select id="instr-sel" name="instrument_uid">
              <option value="">(any instrument)</option>
              <tal:opts tal:repeat="instr instruments">
                <option tal:attributes="value python:instr['uid'];
                                        selected python:request.form.get('instrument_uid','') == instr['uid']"
                        tal:content="python:instr['title']"></option>
              </tal:opts>
            </select>
          </label>
          <label>Layout
            <select id="r-layout" name="layout">
              <option tal:repeat="o ch/layouts" tal:content="python:o[1]"
                      tal:attributes="value python:o[0]; selected python:'selected' if rf['layout'] == o[0] else None"></option>
            </select>
          </label>
          <label>Delimiter
            <select id="r-delimiter" name="delimiter">
              <option tal:repeat="o ch/delimiters" tal:content="python:o[1]"
                      tal:attributes="value python:o[0]; selected python:'selected' if rf['delimiter'] == o[0] else None"></option>
            </select>
          </label>
          <label>Encoding
            <select id="r-encoding" name="encoding">
              <option tal:repeat="o ch/encodings" tal:content="python:o[1]"
                      tal:attributes="value python:o[0]; selected python:'selected' if rf['encoding'] == o[0] else None"></option>
            </select>
          </label>
          <label>Header row
            <input type="number" min="1" id="r-header-row" name="header_row" tal:attributes="value rf/header_row" />
            <span class="field-hint">Wide layouts: the first of two.</span>
          </label>
          <label>Missing-value markers
            <input type="text" id="r-missing" name="missing" placeholder="e.g. -----, N/A, N/F"
                   tal:attributes="value rf/missing" />
            <span class="field-hint">Read as empty.</span>
          </label>
          <label>Skip rows where the column
            <input type="text" id="r-skip-column" name="skip_column" placeholder="a column name"
                   tal:attributes="value rf/skip_column" />
          </label>
          <label>... holds one of
            <input type="text" id="r-skip-values" name="skip_values" placeholder="e.g. Average, %RSD, Maximum"
                   tal:attributes="value rf/skip_values" />
            <span class="field-hint">Statistics rows and the like.</span>
          </label>
          <label class="field-wide">Wide: a compound's column groups
            <input type="text" id="r-group-pattern" name="group_pattern"
                   placeholder="a pattern with (?P&lt;compound&gt;...)" tal:attributes="value rf/group_pattern" />
          </label>
          <label>Wide: groups that belong to the compound before them
            <input type="text" id="r-attach-pattern" name="attach_pattern" placeholder="a pattern"
                   tal:attributes="value rf/attach_pattern" />
          </label>
          <label>Wide: text removed from a compound's name
            <input type="text" id="r-strip-pattern" name="strip_pattern" placeholder="a pattern"
                   tal:attributes="value rf/strip_pattern" />
          </label>
          <label class="field-wide">Blocks: the line that starts a compound's block
            <input type="text" id="r-block-pattern" name="block_pattern"
                   placeholder="a pattern with (?P&lt;compound&gt;...)" tal:attributes="value rf/block_pattern" />
            <span class="field-hint">Lines before the first block are skipped.</span>
          </label>
        </div>
        <label class="upload-box" id="upload-box" for="file-input"
               ondragover="this.classList.add('drag-over');event.preventDefault()"
               ondragleave="this.classList.remove('drag-over')"
               ondrop="handleDrop(event)">
          <div class="upload-icon">&#128196;</div>
          <p><strong>Drop an instrument export here</strong></p>
          <p>or click to browse (CSV, TXT, TSV)</p>
          <p class="upload-chosen" id="chosen-name" hidden="hidden"></p>
        </label>
        <input type="file" id="file-input" name="upload_file" accept=".csv,.txt,.tsv" hidden="hidden" />
        <div class="form-actions">
          <button type="submit" id="upload-btn" class="btn btn-primary">Read &amp; Map Columns &#8594;</button>
        </div>
      </form>
    </div><!-- /phase-landing -->
    </tal:phase1>
    <!-- PHASE 2: the columns and the layout's settings -->
    <div id="phase-mapping" hidden="hidden">
      <div id="detect-banner" class="alert-info" hidden="hidden"></div>
      <h2 class="section-title" id="mapping-title">
        Column Mapping &mdash; <span id="mapping-filename"></span>
      </h2>
      <div class="studio-layout">
        <div class="studio-main">
          <div class="table-wrap">
            <p class="field-hint">DATA PREVIEW (first 3 rows, as the layout reads them)</p>
            <table class="preview-table" id="preview-table">
              <thead><tr id="preview-head"></tr></thead>
              <tbody id="preview-body"></tbody>
            </table>
          </div>
          <p class="field-hint">
            COLUMN MAPPING &mdash;
            <span id="mapped-count">0</span> of <span id="total-count">0</span> columns assigned
            &nbsp;|&nbsp;
            <button type="button" class="btn-sm btn-secondary" onclick="autoIgnoreAll()">Ignore all</button>
          </p>
          <div class="table-wrap">
          <table class="mapping-grid">
            <thead>
              <tr><th>Column Name</th><th>Purpose</th><th>Sample Values</th></tr>
            </thead>
            <tbody id="mapping-body"></tbody>
          </table>
          </div>
        </div><!-- /studio-main -->
        <div class="studio-side">
          <div class="profile-card" tal:condition="view/can_configure">
            <h3>Save as Import Layout</h3>
            <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-import-studio"
                  id="save-form" onsubmit="return prepSave()">
              <input type="hidden" name="action"         value="save_profile" />
              <input type="hidden" name="instrument_uid" id="save-instr-uid" value="" />
              <input type="hidden" name="col_map_json"   id="save-col-map"   value="{}" />
              <input type="hidden" name="reader_json"    id="save-reader"    value="{}" />
              <input type="hidden" name="signature_json" id="save-signature" value="[]" />
              <input type="hidden" name="columns_json"   id="save-columns"   value="[]" />
              <input type="hidden" name="layout_id"      id="save-layout-id" value="" />
              <div class="field-grid">
                <label class="field-wide">Layout name
                  <input type="text" id="s-name" name="layout_name" required="required" />
                </label>
                <label class="field-wide">Instrument
                  <input type="text" id="s-instr-display" readonly="readonly" />
                </label>
                <label class="field-wide">A file fits this layout when it has
                  <select id="s-match" name="match">
                    <option tal:repeat="o python:view.layout_choices()['match']" tal:content="python:o[1]"
                            tal:attributes="value python:o[0]"></option>
                  </select>
                </label>
                <label class="field-wide">Fields also required
                  <input type="text" id="s-required" name="required_fields" placeholder="e.g. sample_type, acquisition_datetime" />
                </label>
                <label class="field-wide">Software and version (a label)
                  <input type="text" id="s-software" name="software" placeholder="optional" />
                </label>
                <label class="field-wide">Calculation mode
                  <select id="s-calc" name="calc_mode" onchange="updateCalChain()">
                    <option value="final">Final: the file has concentrations</option>
                    <option value="raw">Raw: the file has peak areas</option>
                  </select>
                  <span class="field-hint" id="calc-explainer"></span>
                </label>
                <label class="field-wide">Values meaning manual integration
                  <input type="text" id="s-manual" name="manual_markers" placeholder="e.g. !, m, Manual (blank: any entry)" />
                  <span class="field-hint">In the column mapped to Manual Changes. <tal:h define="hid string:manual-integration"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></span>
                </label>
                <label class="field-wide">Date and time format
                  <input type="text" id="s-date" name="date_format" placeholder="e.g. %m/%d/%Y %I:%M:%S %p" />
                  <span class="field-hint">Tried first (strftime codes).</span>
                </label>
                <label class="field-wide">Words the export uses for the platform's
                  <textarea id="s-values" name="value_maps" rows="3"
                            placeholder="sample_type: Calibrator = Standard"></textarea>
                  <span class="field-hint">field: export's word = platform's</span>
                </label>
                <label class="field-wide">Scales
                  <textarea id="s-scales" name="scales" rows="2" placeholder="ion_ratios = percent"></textarea>
                  <span class="field-hint">field = factor, or percent</span>
                </label>
                <label class="field-wide">Qualifier-ion rows end in
                  <input type="text" id="s-qual" name="qualifier_suffix" placeholder="e.g. a space and 2" />
                </label>
                <label class="field-wide field-check">
                  <input type="checkbox" id="s-labelled" name="labelled_from_columns" value="1" />
                  Labelled standards from the analytes' IS columns
                </label>
                <label class="field-wide">Notes
                  <textarea id="s-notes" name="notes" rows="2" placeholder="export settings, quirks..."></textarea>
                </label>
              </div>
              <button class="btn btn-primary btn-save-profile" type="submit">Save Layout</button>
            </form>
          </div><!-- /profile-card -->
        </div><!-- /studio-side -->
      </div><!-- /studio-layout -->
      <div class="form-actions">
        <button type="button" class="btn-sm btn-secondary" onclick="showLanding()">Upload a different file</button>
      </div>
    </div><!-- /phase-mapping -->
    <!-- the injection list per instrument: what its software reads -->
    <div class="profile-card">
      <h3>Injection list (per instrument) <tal:h define="hid string:sequence-export"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></h3>
      <form method="post" class="dilution-form" tal:repeat="x view/export_configs"
            tal:attributes="action string:${view/portal_url}/@@pfas-import-studio">
        <input type="hidden" name="action" value="save_export" />
        <input type="hidden" name="instrument_uid" tal:attributes="value x/uid" />
        <strong tal:content="x/title">Waters LC-MS</strong>
        <input type="text" name="software" tal:attributes="value x/software" placeholder="Software" />
        <input type="text" name="version" tal:attributes="value x/version" placeholder="Version" required="required" />
        <span tal:condition="x/saved" tal:content="string:saved ${x/saved_at} by ${x/saved_by}">saved</span>
        <span tal:condition="not:x/saved">starter</span>
        <textarea name="columns" rows="8" tal:content="x/columns_text">FILE_NAME = name</textarea>
        <button class="btn-sm btn-primary" type="submit" tal:condition="view/can_configure">Save</button>
      </form>
    </div>
    <!-- saved import layouts: edit, retire / reactivate, delete (audited) -->
    <div class="profile-card" tal:define="profiles view/saved_profiles">
      <h3>Saved Import Layouts <tal:h define="hid string:import-profiles"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></h3>
      <div class="table-wrap" tal:condition="profiles">
      <table class="pfas-table" id="saved-layouts">
        <thead><tr><th>Layout</th><th>Instrument</th><th>Read as</th><th>Columns</th>
                   <th>Status</th>
                   <th tal:condition="view/can_configure">Action</th></tr></thead>
        <tbody>
          <tr tal:repeat="p profiles" tal:attributes="data-layout p/id">
            <td tal:content="p/name">Layout</td>
            <td tal:content="p/instrument">any instrument</td>
            <td tal:content="p/layout">long</td>
            <td tal:content="p/n_columns">8</td>
            <td>
              <span class="badge badge-active" tal:condition="not:p/retired">active</span>
              <span class="badge badge-expired" tal:condition="p/retired">retired</span>
            </td>
            <td tal:condition="view/can_configure">
              <div class="form-actions">
                <a class="btn-sm btn-secondary"
                   tal:attributes="href python:'{0}/@@pfas-import-studio?action=edit_profile&amp;layout_id={1}'.format(view.portal_url(), p['id'])">Edit</a>
                <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-import-studio">
                  <input type="hidden" name="action"
                         tal:attributes="value python:'reactivate_profile' if p['retired'] else 'retire_profile'"/>
                  <input type="hidden" name="layout_id" tal:attributes="value p/id"/>
                  <input type="text" name="reason" placeholder="reason" tal:condition="not:p/retired"/>
                  <button class="btn btn-action" type="submit"
                          tal:content="python:'Reactivate' if p['retired'] else 'Retire'">Retire</button>
                </form>
                <form method="post" onsubmit="return confirm('Delete this import layout? Configuration History keeps what it was.')"
                      tal:attributes="action string:${view/portal_url}/@@pfas-import-studio">
                  <input type="hidden" name="action" value="delete_profile"/>
                  <input type="hidden" name="layout_id" tal:attributes="value p/id"/>
                  <input type="text" name="reason" placeholder="reason"/>
                  <button class="btn btn-action" type="submit">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
      </div>
      <p tal:condition="not:profiles" class="field-hint">No saved layouts yet.</p>
      <tal:log tal:define="log view/studio_audit" tal:condition="log">
        <h4 class="section-group-hdr">Layout audit history</h4>
        <div class="field-hint" tal:repeat="e log">
          <span tal:content="e/ts">ts</span> &mdash;
          <strong tal:content="e/action">retire</strong>
          <code tal:content="python:e.get('name') or u'%s:%s' % (e.get('vendor_key') or u'', e.get('version') or u'')">key</code>
          by <span tal:content="python:e.get('user') or u'system'">user</span>
          <tal:r tal:condition="python:e.get('reason')">&middot; <em tal:content="python:e.get('reason')">reason</em></tal:r>
        </div>
      </tal:log>
    </div>
  </div>
  </div><!-- /content slot -->
</body>
</html>
