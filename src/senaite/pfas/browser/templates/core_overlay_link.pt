<tal:overlay xmlns:tal="http://xml.zope.org/namespaces/tal"
             tal:define="portal context/@@plone_portal_state/portal_url">
  <link rel="stylesheet" type="text/css"
        tal:attributes="href string:${portal}/++resource++senaite.pfas/pfas-tokens.css" />
  <link rel="stylesheet" type="text/css"
        tal:attributes="href string:${portal}/++resource++senaite.pfas/pfas-core-overlay.css" />
  <!-- the one top toolbar, shared with PFAS pages -->
  <link rel="stylesheet" type="text/css"
        tal:attributes="href string:${portal}/++resource++senaite.pfas/vendor/adminlte-topbar-3.2.0.css" />
  <link rel="stylesheet" type="text/css"
        tal:attributes="href string:${portal}/++resource++senaite.pfas/pfas-topbar.css" />
  <script tal:attributes="src string:${portal}/++resource++senaite.pfas/pfas-topbar.js"></script>
</tal:overlay>
