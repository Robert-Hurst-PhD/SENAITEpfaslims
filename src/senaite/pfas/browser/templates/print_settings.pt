<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Print Settings</title>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Print Settings</tal:t>

  <div metal:fill-slot="content">
  <div class="page-body" tal:define="ps view/settings">

    <div class="alert alert-success" tal:condition="view/saved">
      Print settings saved — every printable form (logbooks, CoC, SOP copies)
      now uses the updated header/footer.
    </div>

    <p class="pfas-lead is-narrow">The header and footer printed on every form: logbooks, chain of custody, SOP copies.</p>

    <!-- live preview of the print header -->
    <div class="pfas-print-preview">
      <div class="pfas-print-preview-label">Print header preview</div>
      <div class="pfas-print-head">
        <img class="pfas-print-logo" tal:condition="ps/logo_url" tal:attributes="src python:view.logo_src()"/>
        <div>
          <div class="pfas-print-lab" tal:content="ps/lab_name">Lab</div>
          <div class="pfas-print-line">
            <tal:a tal:replace="ps/lab_address"/><tal:p tal:condition="ps/lab_phone"> · <tal:x tal:replace="ps/lab_phone"/></tal:p><tal:e tal:condition="ps/lab_email"> · <tal:x tal:replace="ps/lab_email"/></tal:e>
          </div>
          <div class="pfas-print-line" tal:condition="ps/accreditation"
               tal:content="ps/accreditation">accreditation</div>
        </div>
        <div class="pfas-print-line is-end"
             tal:condition="ps/show_print_date">Printed: 2026-07-02 12:00</div>
      </div>
      <div class="pfas-print-foot"
           tal:condition="ps/show_page_footer" tal:content="ps/footer_text">footer</div>
    </div>

    <form method="post" class="pfas-form-narrow"
          tal:attributes="action string:${view/portal_url}/@@pfas-print-settings">
      <input type="hidden" name="action" value="save"/>
      <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />

      <div class="pfas-form-field is-spaced"><span class="pfas-label">Laboratory name</span>
        <div tal:content="ps/lab_name">DEMO Laboratory</div></div>
      <div class="pfas-form-field is-spaced"><span class="pfas-label">Address</span>
        <div tal:content="ps/lab_address">address</div></div>
      <div class="pfas-form-field is-spaced"><span class="pfas-label">Phone</span>
        <div tal:content="ps/lab_phone">phone</div></div>
      <div class="pfas-form-field is-spaced"><span class="pfas-label">Email</span>
        <div tal:content="ps/lab_email">email</div></div>
      <div class="pfas-form-field is-spaced"><span class="pfas-label">Accreditation line</span>
        <div tal:content="ps/accreditation">accreditation</div></div>
      <div class="pfas-form-field is-spaced"><span class="pfas-label">Logo</span>
        <div><img class="pfas-print-logo" tal:condition="ps/logo_url" tal:attributes="src python:view.logo_src()"/>
          <span tal:condition="not:ps/logo_url">None</span></div></div>
      <div class="pfas-form-field is-spaced">
        <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-laboratory">Edit on Laboratory</a>
        <span class="pfas-hint">These come from the Laboratory record and the site logo.</span></div>
      <div class="pfas-form-field is-spaced"><label>Footer text</label>
        <input type="text" name="footer_text" tal:attributes="value ps/footer_text"/>
        <span class="pfas-hint">The controlled-copy notice printed at the bottom of every page.</span></div>

      <div class="pfas-check is-spaced">
        <label class="pfas-switch"><input type="checkbox" name="show_form_code" id="sfc"
               tal:attributes="checked ps/show_form_code"/><span class="pfas-switch-track"></span></label>
        <label for="sfc">Show form code block (FM-ENV-xxx)</label></div>
      <div class="pfas-check is-spaced">
        <label class="pfas-switch"><input type="checkbox" name="show_print_date" id="spd"
               tal:attributes="checked ps/show_print_date"/><span class="pfas-switch-track"></span></label>
        <label for="spd">Show print date/time in the header</label></div>
      <div class="pfas-check is-spaced">
        <label class="pfas-switch"><input type="checkbox" name="show_page_footer" id="spf"
               tal:attributes="checked ps/show_page_footer"/><span class="pfas-switch-track"></span></label>
        <label for="spf">Show page footer</label></div>

      <!-- ── QA sign-off attestation signers ──────────────────────────────── -->
      <h3 class="pfas-subhead">QA Sign-off Attestation</h3>
      <p class="pfas-hint is-flush">The Prepared, Verified, Authorized sign-off block on SOPs and prep logs; signatures come from each person&#8217;s Lab Contact. <tal:h define="hid string:sign-rights"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></p>
      <div class="pfas-form-field is-spaced"><label>Quality assurance officer</label>
        <select name="qao_initials" class="pfas-select">
          <option value="">— none —</option>
          <option tal:repeat="s view/staff"
                  tal:attributes="value s/initials;
                                  selected python:s['initials']==ps.get('qao_initials')"
                  tal:content="string:${s/fullname} (${s/initials})">name</option>
        </select></div>
      <div class="pfas-form-field is-spaced"><span class="pfas-label">Laboratory director</span>
        <div><strong tal:content="python:view.director_name() or u'None'">AN3</strong>
          <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-laboratory">Laboratory</a></div></div>
      <div class="pfas-check is-spaced">
        <label class="pfas-switch"><input type="checkbox" name="show_signoff" id="sso"
               tal:attributes="checked ps/show_signoff"/><span class="pfas-switch-track"></span></label>
        <label for="sso">Show QA sign-off block on controlled records</label></div>

      <!-- Certificate of Analysis layout (coa_sections.py / coa_format.py). -->
      <h3 id="certificate" class="pfas-subhead">Certificate of Analysis</h3>
      <p class="pfas-hint">
        The results format is set per method and matrix on the method&#8217;s <em>Reporting</em> tab. <tal:h define="hid string:reporting-format"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h> <a class="btn-sm btn-secondary"
           tal:attributes="href string:${view/portal_url}/@@pfas-method-profiles">Open Method Profiles</a>
      </p>
      <div class="pfas-form-field is-spaced"><label for="qs-int">Quality System: Laboratory QAM</label>
        <textarea id="qs-int" name="coa_qs_internal" rows="3" tal:content="ps/coa_qs_internal"
                  tal:attributes="data-tokens view/qam_tokens_json">text</textarea></div>
      <p class="pfas-hint" tal:define="qam view/lab_qam">
        <tal:q condition="qam">Laboratory QAM: <strong tal:content="python:u'%s %s' % (qam['id'], qam['title'])">QAM-001 Quality Manual</strong></tal:q>
        <tal:q condition="not:qam">No controlled document is marked as the laboratory&#8217;s QAM.</tal:q>
        <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-sop">Controlled Documents</a></p>
      <div class="pfas-banner is-warn" tal:condition="view/qam_missing">The statement names the QAM; certificates print &#8220;QAM not on file&#8221; until one is marked.</div>
      <div class="pfas-form-field is-spaced"><label for="qs-qapp">Quality System: QAPP</label>
        <textarea id="qs-qapp" name="coa_qs_qapp" rows="4" tal:content="ps/coa_qs_qapp"
                  tal:attributes="data-tokens view/qapp_tokens_json">text</textarea></div>
      <p class="pfas-hint">Printed for batches of a project with a QAPP.</p>
      <div class="pfas-form-field is-spaced"><label>Sign-off layout</label>
        <select name="coa_signature_style" class="pfas-select">
          <option value="compact" tal:attributes="selected python:ps.get('coa_signature_style','compact')=='compact'">Compact: one line per signatory</option>
          <option value="full" tal:attributes="selected python:ps.get('coa_signature_style')=='full'">Full: signature space per signatory</option>
        </select></div>

      <button class="btn btn-primary pfas-mt" type="submit">
        Save Print Settings
      </button>
    </form>


  </div>
  </div><!-- /content slot -->
</body>
</html>
