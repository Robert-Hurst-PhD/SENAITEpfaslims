<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Waste Container Log (SAA)</title>
</head>
<body>
<tal:t metal:fill-slot="header-title">Waste Container Log (SAA)</tal:t>
<metal:content metal:fill-slot="content">
  <tal:def tal:define="purl view/portal_url">

  <div class="pfas-card">
    <h3>New Entry</h3>
    <form method="POST" tal:attributes="action string:${purl}/@@pfas-waste-log">
      <div class="pfas-form-row">
        <div class="pfas-form-field"><label>Date *</label>
          <input type="date" name="log_date" id="wstDate" required/></div>
        <div class="pfas-form-field"><label>Time</label>
          <input type="time" name="log_time" id="wstTime"/></div>
        <div class="pfas-form-field"><label>Operator initials *</label>
          <input type="text" name="operator" maxlength="10" required/></div>
        <div class="pfas-form-field"><label>Container</label>
          <select name="unit_id">
            <option value="">— General SAA —</option>
            <tal:each tal:repeat="u view/waste_units">
              <option tal:attributes="value u/id" tal:content="u/name"></option>
            </tal:each>
          </select>
        </div>
        <div class="pfas-form-field"><label>Condition *</label>
          <select name="condition" required>
            <option value="acceptable">Acceptable</option>
            <option value="needs_emptying">Needs Emptying</option>
            <option value="emptied">Emptied to Main Container</option>
          </select>
        </div>
      </div>
      <div class="pfas-form-row">
        <div class="pfas-form-field is-grow"><label>Notes</label>
          <input type="text" name="notes"/></div>
      </div>
      <button type="submit" class="btn btn-primary">
        Log Entry
      </button>
    </form>
  </div>

  <div class="pfas-card">
    <h3>Recent Log</h3>
    <tal:none tal:condition="python:not view.logs()">
      <p class="pfas-note-sm">No entries yet.</p>
    </tal:none>
    <table class="pfas-table log-table" tal:condition="python:bool(view.logs())">
      <tr>
        <th>Date</th><th>Time</th><th>Container</th>
        <th>Operator</th><th>Condition</th><th>Notes</th>
      </tr>
      <tal:each tal:repeat="r view/logs">
        <tr>
          <td tal:content="r/log_date"></td>
          <td tal:content="r/log_time"></td>
          <td tal:content="python:r.get('unit_name') or 'General SAA'"></td>
          <td tal:content="r/operator"></td>
          <td tal:attributes="class python:'pfas-text-ok' if r['condition']=='acceptable' else 'pfas-text-bad'"
              tal:content="python:r['condition'].replace('_',' ').title()"></td>
          <td class="pfas-muted-cell" tal:content="python:r.get('notes','')"></td>
        </tr>
      </tal:each>
    </table>
  </div>

  </tal:def>
</metal:content>
<tal:scripts metal:fill-slot="scripts">
<script>
//<![CDATA[
(function(){
  var d = new Date();
  var dd = document.getElementById('wstDate');
  var dt = document.getElementById('wstTime');
  if (dd) dd.valueAsDate = d;
  if (dt) dt.value = ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);
})();
//]]>
</script>
</tal:scripts>
</body>
</html>
