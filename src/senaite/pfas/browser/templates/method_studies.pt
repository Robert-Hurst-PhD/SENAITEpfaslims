<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Method Studies</title>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Method Studies</tal:t>
  <tal:r metal:fill-slot="header-right">
    <a class="btn-sm btn-primary" tal:condition="view/can_start_new" tal:attributes="href string:${view/portal_url}/@@pfas-method-studies?new=1">+ New study</a>
    <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-study-designer">Study Designer</a>
  </tal:r>
  <tal:t metal:fill-slot="header-context"><span class="pfas-chip" tal:define="rec view/record"
         tal:condition="rec" tal:content="rec/id">MS-0001</span></tal:t>

  <metal:fill fill-slot="content" tal:define="rec view/record; can_approve view/can_configure">
    <ul class="bench-alerts" tal:condition="view/error"><li tal:content="view/error">error</li></ul>
    <div class="bench-sub" tal:condition="view/message" tal:content="view/message">Saved.</div>

    <!-- the list and a new study -->
    <tal:list tal:condition="not:rec">
      <section class="bench-block" tal:define="due python:[d for d in view.idc_due() if d[1]]" tal:condition="python:due and not view.show_form()">
        <h2 class="bench-h">Initial demonstration of capability due</h2>
        <table class="pfas-table" data-col-resize="method-studies-1">
          <thead><tr><th>Method</th><th>Analysts without an approved IDC</th></tr></thead>
          <tbody>
            <tr tal:repeat="d due">
              <td tal:content="python:view.method_name(d[0])">EPA 537.1 Drinking Water</td>
              <td tal:content="python:u', '.join(n for _u, n in d[1])">AN1</td>
            </tr>
          </tbody>
        </table>
      </section>
      <section class="bench-block" tal:define="due view/mdl_due" tal:condition="python:due and not view.show_form()">
        <h2 class="bench-h">MDL check due</h2>
        <table class="pfas-table" data-col-resize="method-studies-2">
          <thead><tr><th>Method</th><th>Matrix</th><th>Last approved</th><th>Due by</th></tr></thead>
          <tbody>
            <tr tal:repeat="d due">
              <td tal:content="python:view.method_name(d['method'])">EPA 537.1 Drinking Water</td>
              <td tal:content="d/matrix">Drinking Water</td>
              <td tal:content="d/approved">2025-08-15</td>
              <td><span tal:content="d/due">2026-09-15</span>
                <span class="badge badge-expired" tal:condition="d/overdue">Overdue</span></td>
            </tr>
          </tbody>
        </table>
      </section>
      <section class="bench-block" tal:condition="not:view/show_form">
        <h2 class="bench-h">Studies <span class="pfas-muted" tal:content="view/counts_text"></span></h2>
        <form method="get" class="pfas-filterbar" data-autosubmit="data-autosubmit"
              tal:attributes="action string:${view/portal_url}/@@pfas-method-studies">
          <input type="hidden" name="show" tal:attributes="value view/show" />
          <nav class="pfas-seg" aria-label="Show">
            <a class="pfas-seg-item" tal:repeat="o view/shows"
               tal:attributes="href o/url; aria-selected python:'true' if o['on'] else 'false'"
               tal:content="o/label">Open</a>
          </nav>
        </form>
        <p class="pfas-empty" tal:condition="not:view/listed">None.</p>
        <table class="pfas-table" data-col-resize="method-studies-3" tal:condition="view/listed"
               tal:define="rm context/@@pfas-row-menu">
          <thead><tr><th>Study</th><th>Kind</th><th>Method</th><th>Matrix</th><th>Status</th><th>Approved</th></tr></thead>
          <tbody>
            <tr tal:repeat="r view/listed"
                tal:attributes="data-row-open string:${view/portal_url}/@@pfas-method-studies?id=${r/id};
                                data-row-actions python:rm.actions((u'Open', 'href', view.portal_url() + '/@@pfas-method-studies?id=' + r['id']))">
              <td class="pfas-mono" tal:content="r/id">MS-0001</td>
              <td tal:content="python:view.kind_label(r['kind'], r)">MDL</td>
              <td tal:content="python:view.method_name(r.get('method'))">EPA 537.1 Drinking Water</td>
              <td tal:content="r/matrix">Drinking Water</td>
              <td><span tal:attributes="class python:'badge badge-active' if r['status'] == 'draft' else 'badge badge-archived'"
                        tal:content="python:view.status_label(r['status'])">Open</span></td>
              <td tal:content="python:view.screen_when(r.get('approved_at'))">date</td>
            </tr>
          </tbody>
        </table>
      </section>
      <section class="bench-block" tal:condition="view/show_form">
        <h2 class="bench-h">New study <tal:h define="hid string:method-studies"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></h2>
        <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-method-studies">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <div class="pfas-form-row">
            <label class="pfas-form-field">Kind
              <select name="kind">
                <option tal:repeat="k view/kinds" tal:attributes="value python:k[0]" tal:content="python:k[1]">MDL</option>
              </select></label>
            <label class="pfas-form-field">Method
              <select name="method">
                <option tal:repeat="m view/method_choices" tal:attributes="value m/id" tal:content="m/label">EPA 537.1 Drinking Water</option>
              </select></label>
            <label class="pfas-form-field" data-enable-if="kind" data-enable-values="idc">Analyst
              <select name="idc_analyst">
                <option value="">Choose</option>
                <option tal:repeat="a view/analysts" tal:attributes="value python:a[0]" tal:content="python:a[1]">AN1</option>
              </select></label>
            <label class="pfas-form-field">Matrix
              <select name="matrix">
                <option tal:repeat="m view/matrices" tal:attributes="value m" tal:content="m">Drinking Water</option>
              </select></label>
            <fieldset class="is-full" data-enable-if="kind" data-enable-values="mdl mrl pa dl idc">
              <legend>Preparations</legend>
              <div class="pfas-pill-row" id="study-preps">
                <button type="button" class="pfas-chip-toggle" aria-pressed="false"
                        tal:repeat="p view/preparations" tal:attributes="data-value python:p[0]"
                        tal:content="python:p[1]">Low</button>
              </div>
              <input type="hidden" name="preparations" id="study-preps-value" />
              <span class="pfas-hint">Tap to include or leave out.</span>
              <div class="study-design">
                <label>Replicates per level <input type="number" name="replicates" min="1" step="1" value="4" /></label>
                <label>Days <input type="number" name="days" min="1" step="1" value="2" /></label>
              </div>
              <table class="pfas-table" data-col-resize="method-studies-study-design-table" id="study-design-table">
                <thead><tr><th>Level</th><th>Concentration</th><th>Replicates</th><th>Days</th><th>Preparations</th></tr></thead>
                <tbody></tbody>
              </table>
            </fieldset>
            <label class="pfas-form-field" data-enable-if="kind" data-enable-values="mdl">Spiked replicates
              <select name="spike_role">
                <option value="">Choose</option>
                <option tal:repeat="r view/spike_roles" tal:attributes="value r" tal:content="r">LFSM</option>
              </select></label>
            <div class="is-full" data-enable-if="kind" data-enable-values="mdl">
              <span class="pfas-label">Period</span>
              <div class="pfas-radios">
                <label class="pfas-check"><input type="radio" name="period" value="last12" checked="checked" /> Last 12 months</label>
                <label class="pfas-check"><input type="radio" name="period" value="custom" /> Custom range</label>
              </div>
              <div class="study-range">
                <label data-enable-if="kind" data-enable-values="mdl">From <input type="date" name="since" tal:attributes="value view/default_since" /></label>
                <label data-enable-if="kind" data-enable-values="mdl">To <input type="date" name="until" /></label>
              </div>
            </div>
            <label class="pfas-form-field">Reference sample
              <select name="reference_sample">
                <option value="">None</option>
                <option tal:repeat="l view/reference_lots" tal:attributes="value l/uid"
                        tal:content="string:${l/name} ${l/lot_number}">CRM lot</option>
              </select></label>
          </div>
          <script type="text/javascript">
          //<![CDATA[
          (function () {
            var box = document.getElementById('study-preps'), out = document.getElementById('study-preps-value');
            var table = document.getElementById('study-design-table');
            if (!box || !out || !table) return;
            var form = box.closest('form');
            function draw() {
              var on = [], rows = '', total = 0;
              var rep = parseInt((form.querySelector('[name="replicates"]') || {}).value, 10) || 0;
              var days = parseInt((form.querySelector('[name="days"]') || {}).value, 10) || 0;
              box.querySelectorAll('button').forEach(function (b) {
                if (b.getAttribute('aria-pressed') !== 'true') return;
                var v = b.getAttribute('data-value'), n = rep * days;
                on.push(v); total += n;
                rows += '<tr><td>' + b.textContent.replace('\u2713 ', '') + '</td><td>' +
                        (v === 'MB' || v === 'MxB' ? 'none' : 'from the method') + '</td><td>' + rep + '</td><td>' + days +
                        '</td><td>' + n + '</td></tr>';
              });
              if (on.length) rows += '<tr><td><strong>Total</strong></td><td></td><td></td><td></td><td><strong>' + total + '</strong></td></tr>';
              table.querySelector('tbody').innerHTML = rows;
              out.value = on.join(',');
            }
            box.addEventListener('click', function (e) {
              var b = e.target.closest('button');
              if (!b) return;
              var p = b.getAttribute('aria-pressed') !== 'true';
              b.setAttribute('aria-pressed', p ? 'true' : 'false');
              b.textContent = (p ? '\u2713 ' : '') + b.textContent.replace('\u2713 ', '');
              draw();
            });
            form.addEventListener('input', draw);
            draw();
            /* the From / To dates only for a custom range */
            var range = form.querySelector('.study-range');
            function period() {
              var custom = form.querySelector('[name="period"][value="custom"]');
              if (range && custom) range.hidden = !custom.checked;
            }
            form.addEventListener('change', period);
            period();
          })();
          //]]>
          </script>
          <div class="form-actions">
            <button class="btn-sm btn-primary" type="submit" name="action" value="create">Create study</button>
            <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-method-studies">Cancel</a>
          </div>
        </form>
      </section>
    </tal:list>

    <!-- one study -->
    <tal:one tal:condition="rec"><tal:d tal:define="draft python:rec['status'] == 'draft'">
      <section class="bench-block">
        <h2 class="bench-h" tal:content="python:view.kind_label(rec['kind'], rec)">MDL</h2>
        <div class="pfas-cols-3">
          <div class="pfas-card">
            <h3 class="pfas-card-title">What was studied</h3>
            <dl class="rc-facts is-stack">
              <div><dt>Method</dt><dd tal:content="python:view.method_name(rec.get('method'))">EPA 537.1 Drinking Water</dd></div>
              <div><dt>Matrix</dt><dd tal:content="rec/matrix">Drinking Water</dd></div>
              <div><dt>Spiking level</dt><dd tal:content="python:view.levels_text(rec)">Mid (80)</dd></div>
              <div><dt>Reference materials</dt><dd tal:content="python:view.materials_text(rec)">None</dd></div>
              <div><dt>Spiked samples</dt><dd tal:content="python:view.spiked_text(rec)">LFB, 7 replicates</dd></div>
              <div tal:condition="python:rec['kind'] == 'mdl'"><dt>Blank samples</dt><dd tal:content="python:view.blanks_text(rec)">LRB, 7 blanks</dd></div>
            </dl>
          </div>
          <div class="pfas-card">
            <h3 class="pfas-card-title">Which runs</h3>
            <dl class="rc-facts is-stack">
              <div><dt>Period</dt><dd tal:content="python:u'%s to %s' % (rec.get('since') or u'\u2014', rec.get('until') or u'today')">period</dd></div>
              <div><dt>Runs</dt><dd>
                <span class="pfas-chip" tal:repeat="w view/run_names" tal:content="w">WS-346</span>
                <tal:none condition="not:view/run_names">&mdash;</tal:none></dd></div>
            </dl>
          </div>
          <div class="pfas-card">
            <h3 class="pfas-card-title">Status</h3>
            <dl class="rc-facts is-stack">
              <div><dt>Status</dt><dd><span tal:attributes="class python:'badge badge-active' if draft else 'badge badge-archived'"
                                            tal:content="python:view.status_label(rec['status'])">Approved</span></dd></div>
              <div><dt>Approved by</dt><dd tal:content="python:rec.get('approved_by') or u'\u2014'">DEMO Review Lab Manager</dd></div>
              <div><dt>Approved on</dt><dd tal:content="python:view.screen_when(rec.get('approved_at')) or u'\u2014'">2026-11-14 07:06</dd></div>
              <div><dt>Control charts</dt><dd tal:content="python:u'Its runs are included' if rec.get('in_charts') else u'Its runs are kept out'">Its runs are kept out</dd></div>
            </dl>
          </div>
        </div>
        <form method="post" class="form-actions" tal:condition="python:can_approve and draft"
              tal:attributes="action string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="id" tal:attributes="value rec/id" />
          <button class="btn-sm btn-danger" type="submit" name="action" value="delete_draft">Delete this draft</button>
        </form>
        <form method="post" class="form-actions" tal:condition="can_approve"
              tal:attributes="action string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="id" tal:attributes="value rec/id" />
          <input type="hidden" name="action" value="charts" />
          <label class="pfas-switch">
            <input type="checkbox" name="in_charts" value="1" onchange="this.form.submit()"
                   tal:attributes="checked python:'checked' if rec.get('in_charts') else None" />
            <span class="pfas-switch-track"></span>
            Include its runs in the charts
          </label>
          <noscript><button class="btn-sm btn-secondary" type="submit">Apply</button></noscript>
        </form>
        <a class="btn-sm btn-secondary" target="_blank"
           tal:attributes="href string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}&amp;pdf=1">Packet PDF</a>
        <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-method-studies">All studies</a>
      </section>

      <ul class="bench-alerts" tal:condition="view/study_warnings">
        <li class="bench-warn" tal:repeat="w view/study_warnings" tal:content="w">warning</li></ul>

      <section class="bench-block" tal:condition="python:view.elements() or view.parts()">
        <h2 class="bench-h" tal:condition="view/parts">Parts and analysts</h2>
        <table class="pfas-table" data-col-resize="method-studies-4" tal:condition="view/parts"
               tal:define="rm context/@@pfas-row-menu">
          <thead><tr><th>Part</th><th>Element</th><th>Analyst</th><th>Level</th><th>Replicates</th>
                     <th>Matrix source</th><th>Worksheet</th></tr></thead>
          <tbody>
            <tr tal:repeat="p view/parts"
                tal:attributes="data-row-actions python:rm.actions(*[
                    (u'Open worksheet %s' % w, 'href', view.worksheet_url(w) + '/@@pfas-extraction-batch')
                    for w in p['worksheets'] if view.worksheet_url(w)])">
              <td tal:content="p/id">P1</td>
              <td tal:content="python:view.element_label(p['element'])">MRL confirmation</td>
              <td tal:content="p/analyst_name">AN1</td>
              <td tal:content="python:p.get('level') or u'—'">MRL</td>
              <td tal:content="p/replicates">7</td>
              <td tal:content="python:u'%s: %s' % (view.source_label(p['source']['kind']), view.source_text(p['source']))">water</td>
              <td tal:content="python:u', '.join(p['worksheets'])">WS-1</td>
            </tr>
          </tbody>
        </table>
        <form method="post" tal:condition="view/can_assign"
              tal:attributes="action string:${view/portal_url}/@@pfas-method-studies">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="id" tal:attributes="value rec/id" />
          <div class="pfas-form-row">
            <label class="pfas-form-field">Part
              <select name="element">
                <option tal:repeat="e view/elements" tal:attributes="value python:e[0]" tal:content="python:e[1]">MRL</option>
              </select></label>
            <label class="pfas-form-field">Analyst
              <select name="analyst" required="required">
                <option value="">Choose</option>
                <option tal:repeat="a view/analysts" tal:attributes="value python:a[0]" tal:content="python:a[1]">AN1</option>
              </select></label>
            <tal:fixed condition="not:view/by_day">
            <label class="pfas-form-field">Spiking level (spiked parts)
              <select name="level">
                <option value="">None (blanks)</option>
                <option tal:repeat="l python:rec.get('levels') or view.level_labels()" tal:attributes="value l" tal:content="l">MRL</option>
              </select></label>
            <label class="pfas-form-field">Replicates <input type="number" min="1" step="1" name="replicates" placeholder="the part's default" /></label>
            </tal:fixed>
            <label class="pfas-form-field">Matrix source
              <select name="source_kind" required="required">
                <option value="">Choose</option>
                <option tal:repeat="k view/sources" tal:attributes="value python:k[0]" tal:content="python:k[1]">Water</option>
              </select></label>
            <label class="pfas-form-field">Vendor reagent water lot
              <select name="source_lot.water_lot">
                <option value="">Not used</option>
                <option tal:repeat="l python:view.lot_options('water_lot')" tal:attributes="value l/uid"
                        tal:content="string:${l/name} ${l/lot_number}">water lot</option>
              </select></label>
            <label class="pfas-form-field">Reference sample lot
              <select name="source_lot.reference_lot">
                <option value="">Not used</option>
                <option tal:repeat="l view/reference_lots" tal:attributes="value l/uid"
                        tal:content="string:${l/name} ${l/lot_number}">RM lot</option>
              </select></label>
          </div>
          <button class="btn-sm btn-primary" type="submit" name="action" value="assign">Assign</button>
          <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-reagents?view=reference">Reference samples</a>
        </form>
      </section>

      <section class="bench-block" tal:condition="python:rec['kind'] == 'designed'"
               tal:define="ov view/design_overall">
        <h2 class="bench-h" tal:content="python:view.kind_label('designed', rec)">Designed study</h2>
        <table class="pfas-table">
          <tbody><tr><th>Overall</th><td tal:content="ov">not evaluated</td></tr></tbody>
        </table>
        <fieldset class="study-element" tal:repeat="er view/design_results">
          <tal:d tal:define="el python:er[0]; r python:er[1]; v python:r.get('verdict') or u'not evaluated'">
          <legend tal:content="el/name">Element</legend>
          <table class="pfas-table"><tbody><tr><th>Verdict</th>
            <td><span tal:attributes="class python:'badge ' + ('badge-active' if v == 'pass' else 'badge-expired' if v == 'fail' else 'badge-quarantine')"
                      tal:content="v">pass</span>
                <span tal:condition="r/reason|nothing" tal:content="r/reason">reason</span></td></tr>
            <tr tal:condition="python:el['type'] == 'replicates'"><th>Limits</th>
              <td tal:content="python:u'Method profile, %s tiers' % view.limits_qc(el)">Method profile, LFSM tiers</td></tr></tbody></table>
          <table class="pfas-table" data-col-resize="method-studies-5" tal:condition="r/rows|nothing">
            <thead><tr><th>Analyte</th><th>Level</th><th>Statistic</th><th>Value</th><th>Limit</th><th>Verdict</th></tr></thead>
            <tbody>
              <tr tal:repeat="row r/rows">
                <td tal:content="row/analyte">PFOA</td>
                <td tal:content="row/level">25</td>
                <td tal:content="row/stat">RSD</td>
                <td tal:content="python:view.fmt(row['value'])">4.2</td>
                <td tal:content="python:view.fmt(row['limit']) if row['limit'] is not None else u'not set in the method profile'">20</td>
                <td tal:content="row/verdict">pass</td>
              </tr>
            </tbody>
          </table>
          <tal:q tal:condition="python:el['type'] in ('qualitative', 'typed')">
            <blockquote tal:condition="el/instructions|nothing" tal:content="el/instructions">instructions</blockquote>
            <div class="form-actions">
              <a tal:repeat="fn python:view.design_files(el['id'])" class="btn-sm btn-secondary" target="_blank"
                 tal:attributes="href string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}&amp;evidence_file=1&amp;eid=${el/id}&amp;file=${fn}"
                 tal:content="fn">chromatogram.pdf</a>
            </div>
            <form method="post" enctype="multipart/form-data" tal:condition="draft"
                  tal:attributes="action string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}">
              <input tal:replace="structure context/@@authenticator/authenticator" />
              <input type="hidden" name="id" tal:attributes="value rec/id" />
              <input type="hidden" name="eid" tal:attributes="value el/id" />
              <div class="pfas-form-row page-body-narrow">
                <tal:v tal:condition="python:el['type'] == 'typed'"
                       tal:define="vals python:((rec.get('entries') or {}).get(el['id']) or {}).get('values') or []">
                  <label class="pfas-form-field" tal:repeat="i python:range(int(el.get('count') or 1))">Value <tal:n tal:replace="python:i + 1">1</tal:n>
                    <input type="number" step="any" tal:attributes="name string:value.${i}; value python:vals[i] if i &lt; len(vals) else u''" /></label>
                </tal:v>
                <label class="pfas-form-field is-full">Evidence (<tal:a tal:replace="python:el.get('accept') or u'pdf'">pdf</tal:a>)
                  <input type="file" name="evidence" /></label>
                <tal:j tal:condition="python:el['type'] == 'qualitative' and can_approve">
                  <label class="pfas-form-field">Reviewer's verdict
                    <select name="verdict">
                      <option value="">Not judged</option>
                      <option value="pass">Pass</option>
                      <option value="fail">Fail</option>
                    </select></label>
                  <label class="pfas-form-field">Note <input type="text" name="note" /></label>
                </tal:j>
              </div>
              <div class="form-actions"><button class="btn-sm btn-primary" type="submit" name="action" value="design_entry">Save</button></div>
            </form>
          </tal:q>
          </tal:d>
        </fieldset>
        <tal:a define="applied view/applied"><metal:a use-macro="context/@@pfas-method-study-macros/macros/applied" /></tal:a>
      </section>

      <section class="bench-block" tal:condition="python:rec['kind'] not in ('idc', 'designed')">
        <h2 class="bench-h">Results</h2>
        <tal:old condition="not:view/is_mdl"><metal:r use-macro="context/@@pfas-method-study-macros/macros/results" /></tal:old>
        <tal:new condition="view/is_mdl"><metal:m use-macro="context/@@pfas-method-study-macros/macros/mdl_levels" /></tal:new>
      </section>

      <section class="bench-block" tal:condition="python:rec['kind'] == 'idc'" tal:define="ov view/idc_overall">
        <h2 class="bench-h">Initial demonstration of capability</h2>
        <table class="pfas-table">
          <tbody>
            <tr><th>Analyst</th><td tal:content="python:dict(view.analysts()).get(rec.get('analyst'), rec.get('analyst'))">AN1</td>
                <th>Overall</th><td tal:content="ov">not evaluated</td></tr>
          </tbody>
        </table>
        <table class="pfas-table" data-col-resize="method-studies-6">
          <thead><tr><th>Element</th><th>Verdict</th><th>Detail</th></tr></thead>
          <tbody>
            <tr tal:repeat="e view/idc_rows">
              <td tal:content="python:e[1]">Element</td>
              <td><span tal:define="v python:e[2].get('verdict') or u'not evaluated'"
                        tal:attributes="class python:'badge ' + ('badge-active' if v == 'pass' else 'badge-expired' if v == 'fail' else 'badge-quarantine')"
                        tal:content="v">pass</span></td>
              <td tal:content="python:view.study_note(e[2].get('reason')) or e[2].get('detail') or (u', '.join(u'%s' % x for x in e[2].get('values') or e[2].get('branched') or e[2].get('failed') or []))">detail</td>
            </tr>
          </tbody>
        </table>
        <form method="post" enctype="multipart/form-data" tal:condition="draft"
              tal:attributes="action string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="id" tal:attributes="value rec/id" />
          <div class="pfas-form-row page-body-narrow" tal:define="asym python:(rec.get('idc') or {}).get('asymmetry') or [u'', u''];
                                                               used python:((rec.get('idc') or {}).get('asymmetry_run') or {}).get('batch')">
            <label class="pfas-form-field is-full">Peak asymmetry measured on run
              <select name="asym_run" class="pfas-select">
                <option value="">None: typed below</option>
                <option tal:repeat="r view/asymmetry_runs" tal:content="r/label"
                        tal:attributes="value r/batch; selected python:'selected' if r['batch'] == used else None">WS-1</option>
              </select></label>
            <label class="pfas-form-field">Peak asymmetry, first eluting peak
              <input type="number" step="0.01" min="0" name="asym.1" tal:attributes="value python:asym[0]" /></label>
            <label class="pfas-form-field">Peak asymmetry, second eluting peak
              <input type="number" step="0.01" min="0" name="asym.2" tal:attributes="value python:asym[1] if len(asym) > 1 else u''" /></label>
            <label class="pfas-form-field is-full">Calculation (PDF)
              <input type="file" name="asymmetry_file" accept="application/pdf" /></label>
          </div>
          <div class="form-actions">
            <button class="btn-sm btn-primary" type="submit" name="action" value="idc_save">Save</button>
            <a class="btn-sm btn-secondary" target="_blank" tal:condition="python:(rec.get('idc') or {}).get('pdf')"
               tal:attributes="href string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}&amp;asymmetry_pdf=1">Open the calculation</a>
          </div>
        </form>
      </section>

      <section class="bench-block" tal:condition="python:rec['kind'] == 'pt'" tal:define="pt rec/pt">
        <h2 class="bench-h">Proficiency test</h2>
        <a class="btn-sm btn-secondary" target="_blank" tal:condition="pt/certificate|nothing"
           tal:attributes="href string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}&amp;certificate=1">Certificate</a>
        <form method="post" enctype="multipart/form-data" tal:condition="draft"
              tal:attributes="action string:${view/portal_url}/@@pfas-method-studies">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="id" tal:attributes="value rec/id" />
          <div class="pfas-form-row">
            <label class="pfas-form-field">Provider <input type="text" name="pt_provider" tal:attributes="value pt/provider|nothing" /></label>
            <label class="pfas-form-field">Scheme <input type="text" name="pt_scheme" tal:attributes="value pt/scheme|nothing" /></label>
            <label class="pfas-form-field">Round <input type="text" name="pt_round" tal:attributes="value pt/round|nothing" /></label>
            <label class="pfas-form-field">PT sample <input type="text" name="pt_sample" tal:attributes="value pt/sample|nothing" /></label>
            <label class="pfas-form-field">Received <input type="date" name="pt_received" tal:attributes="value pt/received|nothing" /></label>
            <label class="pfas-form-field">Certificate (PDF) <input type="file" name="certificate_file" accept="application/pdf" /></label>
          </div>
          <table class="pfas-table" data-col-resize="method-studies-7">
            <thead><tr><th>Analyte</th><th>Reported</th><th>Assigned</th><th>Provider's verdict</th></tr></thead>
            <tbody>
              <tal:r repeat="kw view/pt_analytes"><tr tal:define="row python:(pt.get('results') or {}).get(kw) or {}">
                <td tal:content="kw">PFOA</td>
                <td><input type="text" tal:attributes="name string:rep.${kw}; value row/reported|nothing" /></td>
                <td><input type="text" tal:attributes="name string:asg.${kw}; value row/assigned|nothing" /></td>
                <td><select tal:attributes="name string:ver.${kw}">
                  <option value="">-</option>
                  <option tal:repeat="v view/pt_verdicts" tal:attributes="value python:v[0]; selected python:'selected' if row.get('verdict') == v[0] else None"
                          tal:content="python:v[1]">Acceptable</option></select></td>
              </tr></tal:r>
            </tbody>
          </table>
          <button class="btn-sm btn-primary" type="submit" name="action" value="save_pt">Save</button>
        </form>
        <ul class="bench-alerts" tal:condition="python:draft and view.pt_problems()">
          <li tal:repeat="p view/pt_problems" tal:content="p">problem</li></ul>
      </section>

      <section class="bench-block" tal:condition="python:draft and rec['kind'] != 'pt'">
        <h2 class="bench-h">Replicates</h2>
        <table class="pfas-table" data-col-resize="method-studies-8" tal:define="rm context/@@pfas-row-menu">
          <thead><tr><th>Injection</th><th>Run</th><th>Date</th><th>Used as</th></tr></thead>
          <tbody>
            <tr tal:repeat="r view/replicate_rows"
                tal:attributes="data-row-actions python:rm.actions((u'Exclude\u2026', 'modal', u'exclude-%d' % repeat['r'].index))">
              <td tal:content="r/injection">WS-1-LFB1</td>
              <td tal:content="r/batch">WS-1</td>
              <td tal:content="r/date">date</td>
              <td tal:content="python:u'%s %s' % (r['role'], r.get('level') or u'')">spike</td>
</tr>
          </tbody>
        </table>
        <tal:d repeat="r view/replicate_rows">
        <div class="pfas-modal" tal:attributes="id string:exclude-${repeat/r/index}">
          <div class="pfas-modal-box">
            <h2>Exclude <tal:i replace="r/injection">WS-1-LFB1</tal:i></h2>
            <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-method-studies">
              <input tal:replace="structure context/@@authenticator/authenticator" />
              <input type="hidden" name="id" tal:attributes="value rec/id" />
              <input type="hidden" name="injection" tal:attributes="value python:r.get('key') or r['injection']" />
              <input type="hidden" name="action" value="exclude" />
              <label class="pfas-form-field">Analyte
                <select name="analyte">
                  <option value="*">Every analyte</option>
                  <option tal:repeat="a python:sorted(r['values'])" tal:attributes="value a" tal:content="a">PFOA</option>
                </select></label>
              <label class="pfas-form-field">Reason
                <input type="text" name="reason" placeholder="Reason (gross failure)" /></label>
              <div class="form-actions is-end">
                <button type="button" class="btn btn-secondary" data-modal-close="data-modal-close">Close</button>
                <button class="btn btn-primary" type="submit">Exclude</button>
              </div>
            </form>
          </div>
        </div>
        </tal:d>
        <ul class="bench-alerts" tal:condition="view/left_out">
          <li class="bench-warn"><strong>Left out, not reviewed:</strong>
            <tal:w tal:replace="python:u', '.join(view.left_out)">-</tal:w></li></ul>
      </section>

      <section class="bench-block" tal:condition="rec/exclusions">
        <h2 class="bench-h">Exclusions</h2>
        <table class="pfas-table" data-col-resize="method-studies-9">
          <thead><tr><th>Injection</th><th>Analyte</th><th>Reason</th><th>By</th><th>When</th></tr></thead>
          <tbody>
            <tr tal:repeat="e rec/exclusions">
              <td tal:content="e/injection">WS-1-LFB1</td><td tal:content="e/analyte">PFOA</td>
              <td tal:content="e/reason">cracked vial</td><td tal:content="e/by">AN1</td><td tal:content="python:view.screen_when(e.get('at'))">t</td>
            </tr>
          </tbody>
        </table>
      </section>

      <section class="bench-block" tal:condition="python:draft and can_approve">
        <h2 class="bench-h">QA approval</h2>
        <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-method-studies">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="id" tal:attributes="value rec/id" />
          <p class="pfas-hint" tal:repeat="item python:sorted(view.raised().items())" tal:condition="not:view/is_mdl"
             tal:content="python:u'%s: the MDL is above the RL, so the RL goes from %s to %s.' % (item[0], view.fmt(item[1][0]), view.fmt(item[1][1]))"></p>
          <fieldset tal:define="keep view/keepable" tal:condition="keep">
            <legend>Keep existing MDL</legend>
            <label class="pfas-switch pfas-check" tal:repeat="kw keep">
              <input type="checkbox" tal:attributes="name string:keep_existing.${repeat/kw/index}; value kw" /><span class="pfas-switch-track"></span>
              <span tal:content="python:u'%s, %s in force' % (kw, view.fmt(view.existing().get(kw)))"></span>
            </label>
          </fieldset>
          <label>Statement <input type="text" name="statement" placeholder="Reviewed against the source" /></label>
          <button class="btn-sm btn-primary" type="submit" name="action" value="approve">Approve</button>
        </form>
      </section>
    </tal:d></tal:one>
  </metal:fill>
</body>
</html>
