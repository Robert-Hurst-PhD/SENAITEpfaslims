<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Method Studies</title>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Method Studies</tal:t>
  <tal:t metal:fill-slot="header-context"><span class="header-badge" tal:define="rec view/record"
         tal:condition="rec" tal:content="rec/id">MS-0001</span></tal:t>

  <metal:fill fill-slot="content" tal:define="rec view/record; can_approve view/can_configure">
    <ul class="bench-alerts" tal:condition="view/error"><li tal:content="view/error">error</li></ul>
    <div class="bench-sub" tal:condition="view/message" tal:content="view/message">Saved.</div>

    <!-- the list and a new study -->
    <tal:list tal:condition="not:rec">
      <section class="bench-block" tal:define="due python:[d for d in view.idc_due() if d[1]]" tal:condition="due">
        <h2 class="bench-h">Initial demonstration of capability due</h2>
        <table class="pfas-table">
          <thead><tr><th>Method</th><th>Analysts without an approved IDC</th></tr></thead>
          <tbody>
            <tr tal:repeat="d due">
              <td tal:content="python:d[0]">EPA_537_1</td>
              <td tal:content="python:u', '.join(n for _u, n in d[1])">AN1</td>
            </tr>
          </tbody>
        </table>
      </section>
      <section class="bench-block" tal:define="due view/mdl_due" tal:condition="due">
        <h2 class="bench-h">MDL verification due</h2>
        <table class="pfas-table">
          <thead><tr><th>Method</th><th>Matrix</th><th>Last approved</th><th>Due by</th></tr></thead>
          <tbody>
            <tr tal:repeat="d due">
              <td tal:content="d/method">EPA_537_1</td>
              <td tal:content="d/matrix">Drinking Water</td>
              <td tal:content="d/approved">2025-08-15</td>
              <td><span tal:content="d/due">2026-09-15</span>
                <span class="badge badge-expired" tal:condition="d/overdue">Overdue</span></td>
            </tr>
          </tbody>
        </table>
      </section>
      <section class="bench-block">
        <table class="pfas-table" tal:condition="view/listed">
          <thead><tr><th>Study</th><th>Kind</th><th>Method</th><th>Matrix</th><th>Status</th><th>Approved</th><th></th></tr></thead>
          <tbody>
            <tr tal:repeat="r view/listed">
              <td tal:content="r/id">MS-0001</td>
              <td tal:content="python:view.kind_label(r['kind'])">MDL</td>
              <td tal:content="r/method">EPA_537_1</td>
              <td tal:content="r/matrix">Drinking Water</td>
              <td tal:content="r/status">draft</td>
              <td tal:content="python:r.get('approved_at') or u''">date</td>
              <td><a class="btn-sm btn-secondary"
                     tal:attributes="href string:${view/portal_url}/@@pfas-method-studies?id=${r/id}">Open</a></td>
            </tr>
          </tbody>
        </table>
      </section>
      <section class="bench-block">
        <h2 class="bench-h">New study <tal:h define="hid string:method-studies"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></h2>
        <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-method-studies">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <div class="field-grid">
            <label>Kind
              <select name="kind">
                <option tal:repeat="k view/kinds" tal:attributes="value python:k[0]" tal:content="python:k[1]">MDL</option>
              </select></label>
            <label>Method
              <select name="method">
                <option tal:repeat="m view/methods" tal:attributes="value m" tal:content="m">EPA_537_1</option>
              </select></label>
            <label>Analyst (an IDC only)
              <select name="idc_analyst">
                <option value="">Choose</option>
                <option tal:repeat="a view/analysts" tal:attributes="value python:a[0]" tal:content="python:a[1]">AN1</option>
              </select></label>
            <label>Matrix
              <select name="matrix">
                <option tal:repeat="m view/matrices" tal:attributes="value m" tal:content="m">Drinking Water</option>
              </select></label>
            <label>Fortified concentration (one level) <input type="number" step="any" min="0" name="fortified"
                                                  placeholder="from the spike level" /></label>
            <label>From (MDL) <input type="date" name="since" tal:attributes="value view/default_since" /></label>
            <label>To (MDL) <input type="date" name="until" /></label>
            <label>Worksheets (MRL, precision, DL) <input type="text" name="worksheets" placeholder="WS-101 WS-102" /></label>
            <fieldset class="field-wide">
              <legend>Spiking levels run</legend>
              <div class="cf-chips">
                <label class="cf-chip" tal:repeat="l view/level_labels">
                  <input type="checkbox" value="1" tal:attributes="name string:level.${l}" /> <span tal:replace="l">Low</span></label>
              </div>
            </fieldset>
            <fieldset class="field-wide" tal:condition="view/reference_lots">
              <legend>Reference materials</legend>
              <div class="cf-chips">
                <label class="cf-chip" tal:repeat="l view/reference_lots">
                  <input type="checkbox" value="1" tal:attributes="name string:rm.${l/uid}" />
                  <span tal:replace="string:${l/name} ${l/lot_number}">CRM lot</span></label>
              </div>
            </fieldset>
          </div>
          <div class="form-actions">
            <button class="btn-sm btn-primary" type="submit" name="action" value="create">Create study</button>
          </div>
        </form>
      </section>
      <section class="bench-block" id="reference-samples" tal:define="rss view/reference_samples">
        <h2 class="bench-h">Reference samples: receipt and CoA</h2>
        <div class="bench-sub" tal:condition="not:rss">No usable reference-sample lot.</div>
        <table class="pfas-table" tal:condition="rss">
          <thead><tr><th>Lot</th><th>Received</th><th>Receipt</th><th>CoA</th></tr></thead>
          <tbody tal:repeat="l rss">
            <tr tal:attributes="id string:rm-${l/uid}">
              <td tal:content="string:${l/name} ${l/lot_number}">DEMO RM L-1</td>
              <td tal:content="python:l.get('received') or u'—'">date</td>
              <td tal:define="r l/receipt">
                <tal:r condition="r"><span tal:replace="python:u'%s; %s (recorded by %s, %s)' % (r.get('received_by'), r.get('condition'), r.get('recorded_by'), r.get('recorded_at'))">AN1; intact</span></tal:r>
                <tal:n condition="not:r">not recorded</tal:n></td>
              <td><a class="btn-sm btn-secondary" target="_blank" tal:condition="l/coa"
                     tal:attributes="href string:${view/portal_url}/@@pfas-reagents?action=coa&amp;uid=${l/uid}">View CoA</a>
                  <tal:n condition="not:l/coa">none on file</tal:n></td>
            </tr>
            <!-- the receipt form opens under its lot, across the table -->
            <tr class="row-detail"><td colspan="4">
              <details class="row-form">
                <summary class="btn-sm"
                         tal:content="python:'Update the receipt' if l['receipt'] else 'Record the receipt'">Record the receipt</summary>
                <form method="post" enctype="multipart/form-data"
                      tal:attributes="action string:${view/portal_url}/@@pfas-method-studies">
                  <input tal:replace="structure context/@@authenticator/authenticator" />
                  <input type="hidden" name="uid" tal:attributes="value l/uid" />
                  <div class="field-grid page-body-narrow" tal:define="r python:l['receipt'] or {}">
                    <label>Received <input type="date" name="received_at" required="required"
                                           tal:attributes="value l/received" /></label>
                    <label>Received by <input type="text" name="received_by" required="required"
                                              tal:attributes="value r/received_by|nothing" /></label>
                    <label>Condition on arrival <input type="text" name="condition" required="required"
                                                       tal:attributes="value r/condition|nothing" /></label>
                    <label>Provider's sample or certificate no. <input type="text" name="provider_ref"
                                                                      tal:attributes="value r/provider_ref|nothing" /></label>
                    <label>Stored at <input type="text" name="storage" tal:attributes="value r/storage|nothing" /></label>
                    <label>Note <input type="text" name="note" tal:attributes="value r/note|nothing" /></label>
                    <label>CoA (PDF) <input type="file" name="coa_file" accept="application/pdf" /></label>
                  </div>
                  <div class="form-actions">
                    <button class="btn-sm btn-primary" type="submit" name="action" value="receipt">Record receipt</button>
                  </div>
                </form>
              </details>
            </td></tr>
          </tbody>
        </table>
      </section>
    </tal:list>

    <!-- one study -->
    <tal:one tal:condition="rec"><tal:d tal:define="draft python:rec['status'] == 'draft'">
      <section class="bench-block">
        <h2 class="bench-h" tal:content="python:view.kind_label(rec['kind'])">MDL</h2>
        <table class="pfas-table">
          <tbody>
            <tr><th>Method</th><td tal:content="rec/method">EPA_537_1</td>
                <th>Matrix</th><td tal:content="rec/matrix">Drinking Water</td></tr>
            <tr><th>Spiking levels</th>
                <td tal:content="python:u', '.join(u'%s (%s)' % (l, view.fmt(view.fortified(l))) for l in rec.get('levels') or []) or u'\u2014'">Low (4)</td>
                <th>Reference materials</th>
                <td tal:content="python:u', '.join(u'%s %s' % (m.get('name'), m.get('lot_number')) for m in rec.get('reference_materials') or []) or u'\u2014'">CRM</td></tr>
            <tr><th>Period</th><td tal:content="python:u'%s to %s' % (rec.get('since') or u'\u2014', rec.get('until') or u'today')">period</td>
                <th>Worksheets</th><td tal:content="python:u', '.join(view.all_worksheets()) or u'\u2014'">WS</td></tr>
            <tr><th>Status</th><td tal:content="rec/status">draft</td>
                <th>Approved</th><td tal:content="python:u'%s %s' % (rec.get('approved_by') or u'', rec.get('approved_at') or u'')">by</td></tr>
            <tr><th>Control charts</th>
                <td colspan="3" tal:content="python:u'its runs are included' if rec.get('in_charts') else u'its runs are kept out'">kept out</td></tr>
          </tbody>
        </table>
        <form method="post" class="form-actions" tal:condition="can_approve"
              tal:attributes="action string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="id" tal:attributes="value rec/id" />
          <input type="hidden" name="in_charts" tal:attributes="value python:u'0' if rec.get('in_charts') else u'1'" />
          <button class="btn-sm" type="submit" name="action" value="charts"
                  tal:content="python:u'Keep its runs out of the charts' if rec.get('in_charts') else u'Include its runs in the charts'">Include</button>
        </form>
        <a class="btn-sm btn-secondary" target="_blank"
           tal:attributes="href string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}&amp;pdf=1">Packet PDF</a>
        <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-method-studies">All studies</a>
      </section>

      <section class="bench-block" tal:condition="python:view.elements() or view.parts()">
        <h2 class="bench-h">Parts and analysts</h2>
        <table class="pfas-table" tal:condition="view/parts">
          <thead><tr><th>Part</th><th>Element</th><th>Analyst</th><th>Level</th><th>Replicates</th>
                     <th>Matrix source</th><th>Worksheet</th></tr></thead>
          <tbody>
            <tr tal:repeat="p view/parts">
              <td tal:content="p/id">P1</td>
              <td tal:content="python:view.element_label(p['element'])">MRL confirmation</td>
              <td tal:content="p/analyst_name">AN1</td>
              <td tal:content="python:p.get('level') or u'—'">MRL</td>
              <td tal:content="p/replicates">7</td>
              <td tal:content="python:u'%s: %s' % (view.source_label(p['source']['kind']), view.source_text(p['source']))">water</td>
              <td><tal:w repeat="w p/worksheets"><span tal:replace="w">WS-1</span>
                <a class="btn-sm btn-secondary" tal:define="u python:view.worksheet_url(w)" tal:condition="u"
                   tal:attributes="href string:${u}/@@pfas-extraction-batch">Open</a></tal:w></td>
            </tr>
          </tbody>
        </table>
        <form method="post" tal:condition="view/can_assign"
              tal:attributes="action string:${view/portal_url}/@@pfas-method-studies">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="id" tal:attributes="value rec/id" />
          <div class="field-grid">
            <label>Part
              <select name="element">
                <option tal:repeat="e view/elements" tal:attributes="value python:e[0]" tal:content="python:e[1]">MRL</option>
              </select></label>
            <label>Analyst
              <select name="analyst" required="required">
                <option value="">Choose</option>
                <option tal:repeat="a view/analysts" tal:attributes="value python:a[0]" tal:content="python:a[1]">AN1</option>
              </select></label>
            <label>Spiking level (spiked parts)
              <select name="level">
                <option value="">None (blanks)</option>
                <option tal:repeat="l python:rec.get('levels') or view.level_labels()" tal:attributes="value l" tal:content="l">MRL</option>
              </select></label>
            <label>Replicates <input type="number" min="1" step="1" name="replicates" placeholder="the part's default" /></label>
            <label>Matrix source
              <select name="source_kind" required="required">
                <option value="">Choose</option>
                <option tal:repeat="k view/sources" tal:attributes="value python:k[0]" tal:content="python:k[1]">Water</option>
              </select></label>
            <label>Vendor reagent water lot
              <select name="source_lot.water_lot">
                <option value="">Not used</option>
                <option tal:repeat="l python:view.lot_options('water_lot')" tal:attributes="value l/uid"
                        tal:content="string:${l/name} ${l/lot_number}">water lot</option>
              </select></label>
            <label>Reference sample lot
              <select name="source_lot.reference_lot">
                <option value="">Not used</option>
                <option tal:repeat="l view/reference_lots" tal:attributes="value l/uid"
                        tal:content="string:${l/name} ${l/lot_number}">RM lot</option>
              </select></label>
          </div>
          <button class="btn-sm btn-primary" type="submit" name="action" value="assign">Assign</button>
          <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-method-studies#reference-samples">Reference sample receipts</a>
        </form>
      </section>

      <section class="bench-block" tal:condition="python:rec['kind'] != 'idc'">
        <h2 class="bench-h">Results</h2>
        <metal:r use-macro="context/@@pfas-method-study-macros/macros/results" />
      </section>

      <section class="bench-block" tal:condition="python:rec['kind'] == 'idc'" tal:define="ov view/idc_overall">
        <h2 class="bench-h">Initial demonstration of capability</h2>
        <table class="pfas-table">
          <tbody>
            <tr><th>Analyst</th><td tal:content="python:dict(view.analysts()).get(rec.get('analyst'), rec.get('analyst'))">AN1</td>
                <th>Overall</th><td tal:content="ov">not evaluated</td></tr>
          </tbody>
        </table>
        <table class="pfas-table">
          <thead><tr><th>Element</th><th>Verdict</th><th>Detail</th></tr></thead>
          <tbody>
            <tr tal:repeat="e view/idc_rows">
              <td tal:content="python:e[1]">Element</td>
              <td><span tal:define="v python:e[2].get('verdict') or u'not evaluated'"
                        tal:attributes="class python:'badge ' + ('badge-active' if v == 'pass' else 'badge-expired' if v == 'fail' else 'badge-quarantine')"
                        tal:content="v">pass</span></td>
              <td tal:content="python:e[2].get('reason') or (u', '.join(u'%s' % x for x in e[2].get('values') or e[2].get('branched') or e[2].get('failed') or []))">detail</td>
            </tr>
          </tbody>
        </table>
        <form method="post" enctype="multipart/form-data" tal:condition="draft"
              tal:attributes="action string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="id" tal:attributes="value rec/id" />
          <div class="field-grid page-body-narrow" tal:define="asym python:(rec.get('idc') or {}).get('asymmetry') or [u'', u'']">
            <label>Peak asymmetry, first eluting peak
              <input type="number" step="0.01" min="0" name="asym.1" tal:attributes="value python:asym[0]" /></label>
            <label>Peak asymmetry, second eluting peak
              <input type="number" step="0.01" min="0" name="asym.2" tal:attributes="value python:asym[1] if len(asym) > 1 else u''" /></label>
            <label class="field-wide">Calculation (PDF)
              <input type="file" name="asymmetry_file" accept="application/pdf" /></label>
          </div>
          <div class="form-actions">
            <button class="btn-sm btn-primary" type="submit" name="action" value="idc_save">Save</button>
            <a class="btn-sm btn-secondary" target="_blank" tal:condition="python:(rec.get('idc') or {}).get('pdf')"
               tal:attributes="href string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}&amp;asymmetry_pdf=1">Open the calculation</a>
          </div>
        </form>
      </section>

      <section class="bench-block" tal:condition="python:rec['kind'] == 'pt'" tal:define="pt rec/pt">
        <h2 class="bench-h">Proficiency test</h2>
        <a class="btn-sm btn-secondary" target="_blank" tal:condition="pt/certificate|nothing"
           tal:attributes="href string:${view/portal_url}/@@pfas-method-studies?id=${rec/id}&amp;certificate=1">Certificate</a>
        <form method="post" enctype="multipart/form-data" tal:condition="draft"
              tal:attributes="action string:${view/portal_url}/@@pfas-method-studies">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="id" tal:attributes="value rec/id" />
          <div class="field-grid">
            <label>Provider <input type="text" name="pt_provider" tal:attributes="value pt/provider|nothing" /></label>
            <label>Scheme <input type="text" name="pt_scheme" tal:attributes="value pt/scheme|nothing" /></label>
            <label>Round <input type="text" name="pt_round" tal:attributes="value pt/round|nothing" /></label>
            <label>PT sample <input type="text" name="pt_sample" tal:attributes="value pt/sample|nothing" /></label>
            <label>Received <input type="date" name="pt_received" tal:attributes="value pt/received|nothing" /></label>
            <label>Certificate (PDF) <input type="file" name="certificate_file" accept="application/pdf" /></label>
          </div>
          <table class="pfas-table">
            <thead><tr><th>Analyte</th><th>Reported</th><th>Assigned</th><th>Provider's verdict</th></tr></thead>
            <tbody>
              <tal:r repeat="kw view/pt_analytes"><tr tal:define="row python:(pt.get('results') or {}).get(kw) or {}">
                <td tal:content="kw">PFOA</td>
                <td><input type="text" tal:attributes="name string:rep.${kw}; value row/reported|nothing" /></td>
                <td><input type="text" tal:attributes="name string:asg.${kw}; value row/assigned|nothing" /></td>
                <td><select tal:attributes="name string:ver.${kw}">
                  <option value="">-</option>
                  <option tal:repeat="v view/pt_verdicts" tal:attributes="value python:v[0]; selected python:'selected' if row.get('verdict') == v[0] else None"
                          tal:content="python:v[1]">Acceptable</option></select></td>
              </tr></tal:r>
            </tbody>
          </table>
          <button class="btn-sm btn-primary" type="submit" name="action" value="save_pt">Save</button>
        </form>
        <ul class="bench-alerts" tal:condition="python:draft and view.pt_problems()">
          <li tal:repeat="p view/pt_problems" tal:content="p">problem</li></ul>
      </section>

      <section class="bench-block" tal:condition="python:draft and rec['kind'] != 'pt'">
        <h2 class="bench-h">Replicates</h2>
        <table class="pfas-table">
          <thead><tr><th>Injection</th><th>Run</th><th>Date</th><th>Used as</th><th>Exclude</th></tr></thead>
          <tbody>
            <tr tal:repeat="r view/replicate_rows">
              <td tal:content="r/injection">WS-1-LFB1</td>
              <td tal:content="r/batch">WS-1</td>
              <td tal:content="r/date">date</td>
              <td tal:content="python:u'%s %s' % (r['role'], r.get('level') or u'')">spike</td>
              <td>
                <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-method-studies">
                  <input tal:replace="structure context/@@authenticator/authenticator" />
                  <input type="hidden" name="id" tal:attributes="value rec/id" />
                  <input type="hidden" name="injection" tal:attributes="value python:r.get('key') or r['injection']" />
                  <select name="analyte">
                    <option value="*">Every analyte</option>
                    <option tal:repeat="a python:sorted(r['values'])" tal:attributes="value a" tal:content="a">PFOA</option>
                  </select>
                  <input type="text" name="reason" placeholder="Reason (gross failure)" />
                  <button class="btn-sm btn-secondary" type="submit" name="action" value="exclude">Exclude</button>
                </form>
              </td>
            </tr>
          </tbody>
        </table>
        <ul class="bench-alerts" tal:condition="view/left_out">
          <li class="bench-warn"><strong>Left out, not reviewed:</strong>
            <tal:w tal:replace="python:u', '.join(view.left_out)">-</tal:w></li></ul>
      </section>

      <section class="bench-block" tal:condition="rec/exclusions">
        <h2 class="bench-h">Exclusions</h2>
        <table class="pfas-table">
          <thead><tr><th>Injection</th><th>Analyte</th><th>Reason</th><th>By</th><th>When</th></tr></thead>
          <tbody>
            <tr tal:repeat="e rec/exclusions">
              <td tal:content="e/injection">WS-1-LFB1</td><td tal:content="e/analyte">PFOA</td>
              <td tal:content="e/reason">cracked vial</td><td tal:content="e/by">AN1</td><td tal:content="e/at">t</td>
            </tr>
          </tbody>
        </table>
      </section>

      <section class="bench-block" tal:condition="python:draft and can_approve">
        <h2 class="bench-h">QA approval</h2>
        <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-method-studies">
          <input tal:replace="structure context/@@authenticator/authenticator" />
          <input type="hidden" name="id" tal:attributes="value rec/id" />
          <label>Statement <input type="text" name="statement" placeholder="Reviewed against the source" /></label>
          <button class="btn-sm btn-primary" type="submit" name="action" value="approve">Approve</button>
        </form>
      </section>
    </tal:d></tal:one>
  </metal:fill>
</body>
</html>
