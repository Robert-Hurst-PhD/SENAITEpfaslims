<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Delivered EDDs</title>
  <tal:t metal:fill-slot="header-title">Delivered EDDs</tal:t>
</head>
<body>
  <div metal:fill-slot="content">
  <div class="page-body-narrow">

    <!-- ── BRANCH: per-batch sample type editor ── -->
    <tal:editor tal:condition="view/batch_id">

      <div class="pfas-page-head">
        <a class="btn-sm btn-secondary btn-back" tal:attributes="href string:${view/portal_url}/@@pfas-edd-batches">Batch EDD Dashboard</a>
        <h2>
          Sample Types —
          <span tal:content="view/batch_id">B-001</span>
        </h2>
      </div>

      <tal:saved tal:condition="view/saved_count">
        <div class="alert alert-success">
          <span tal:content="view/saved_count">0</span> sample type(s) saved.
        </div>
      </tal:saved>

      <div class="pfas-section-intro">
        <h3>Per-sample SAMPLE_TYPE overrides</h3>
        <p>Set each sample&#8217;s state sample-type code; the default comes from the client&#8217;s EDD profile. <tal:h define="hid string:edd-profiles"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></p>
      </div>

      <tal:nosamps tal:condition="not:view/batch_sample_types">
        <p class="pfas-lead">
          No samples found in batch <strong tal:content="view/batch_id">B-001</strong>.
        </p>
      </tal:nosamps>

      <form tal:condition="view/batch_sample_types"
            method="POST"
            tal:attributes="action string:${view/portal_url}/@@pfas-edd-batches">
        <input type="hidden" name="batch_id" tal:attributes="value view/batch_id" />

        <table class="pfas-table">
          <thead>
            <tr>
              <th>Sample ID</th>
              <th>Sample Title</th>
              <th>SENAITE Sample Type</th>
              <th>SAMPLE_TYPE</th>
            </tr>
          </thead>
          <tbody>
            <tr tal:repeat="row view/batch_sample_types">
              <td tal:content="row/ar_id" class="pfas-id">AR-001</td>
              <td tal:content="row/ar_title">Sample Title</td>
              <td tal:content="row/senaite_sample_type">Drinking Water</td>
              <td>
                <select class="pfas-select" tal:attributes="name row/field_name">
                  <tal:opt tal:repeat="code view/sample_type_options">
                    <option tal:attributes="
                      value code;
                      selected python:code == row['sample_type_code']"
                      tal:content="code">GW</option>
                  </tal:opt>
                </select>
              </td>
            </tr>
          </tbody>
        </table>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save Sample Types</button>
          <a tal:attributes="href string:${view/portal_url}/@@pfas-edd-export?batch_id=${view/batch_id}"
             class="btn btn-secondary">Download EDD</a>
          <a tal:attributes="href string:${view/portal_url}/@@pfas-edd-export?batch_id=${view/batch_id}&amp;preview=1"
             class="btn-sm btn-secondary" target="_blank">Preview / Validate</a>
        </div>

      </form>

    </tal:editor>

    <!-- ── BRANCH: batch list dashboard ── -->
    <tal:dashboard tal:condition="not:view/batch_id">

      <div class="pfas-page-head">
        <a class="btn-sm btn-secondary btn-back" tal:attributes="href string:${view/portal_url}/@@pfas-edd-config">EDD Configuration</a>
        <h2>Batch EDD Dashboard</h2>
      </div>

      <tal:empty tal:condition="not:view/recent_batches">
        <p class="pfas-lead">No batches found.</p>
      </tal:empty>

      <table class="pfas-table" tal:condition="view/recent_batches">
        <thead>
          <tr>
            <th>Batch ID</th>
            <th>Client</th>
            <th>Created</th>
            <th>EDD</th>
            <th>EDD Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr tal:repeat="b view/recent_batches">
            <td><span class="pfas-id" tal:content="b/batch_id">B-001</span></td>
            <td tal:content="b/client_title">Client A</td>
            <td tal:content="b/created">2026-06-15</td>
            <td>
              <span tal:condition="b/edd_enabled">Enabled</span>
              <span tal:condition="not:b/edd_enabled" class="pfas-muted">Off</span>
            </td>
            <td>
              <tal:nostored tal:condition="not:b/has_edd">
                <span class="cf-hint">Not generated</span>
              </tal:nostored>
              <tal:stored tal:condition="b/has_edd">
                <tal:blocking tal:condition="b/edd_blocking">
                  <span class="badge badge-fail"
                        tal:content="string:${b/edd_blocking} BLOCKING">1 BLOCKING</span>
                </tal:blocking>
                <tal:warn tal:condition="python:b['has_edd'] and not b['edd_blocking'] and b['edd_error_count']">
                  <span class="badge badge-warn"
                        tal:content="string:${b/edd_error_count} warnings">2 warnings</span>
                </tal:warn>
                <tal:ok tal:condition="python:b['has_edd'] and not b['edd_blocking'] and not b['edd_error_count']">
                  <span>Clean</span>
                </tal:ok>
                <br/>
                <span class="pfas-muted"
                      tal:content="b/edd_generated">2026-06-15</span>
              </tal:stored>
            </td>
            <td>
              <div class="pfas-row-actions">
                <!-- the export's profile: the client's preselected, any other chosen here -->
                <form method="get" class="pfas-inline" tal:attributes="action string:${view/portal_url}/@@pfas-edd-export">
                  <input type="hidden" name="batch_id" tal:attributes="value b/batch_id" />
                  <select name="profile" class="pfas-select" tal:attributes="aria-label string:EDD profile for ${b/batch_id}">
                    <option tal:repeat="p view/profile_options" tal:content="p/name"
                            tal:attributes="value p/id; selected python:'selected' if p['id'] == b['edd_profile'] else None">profile</option>
                  </select>
                  <button type="submit" class="btn-sm btn-primary">Download EDD</button>
                </form>
                <a tal:attributes="href b/sampletype_url"
                   class="btn-sm btn-secondary">Sample Types</a>
              </div>
            </td>
          </tr>
        </tbody>
      </table>

    </tal:dashboard>

  </div>
  </div><!-- /content slot -->
</body>
</html>
