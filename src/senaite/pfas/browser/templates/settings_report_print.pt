<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <meta charset="utf-8" />
  <title tal:content="python:view.report()['title']">QC Settings Report</title>
  <!-- Print document for WeasyPrint (settings_report_view._pdf): the generated
       lab-theme stylesheet with the control block and footer (print_doc.py). -->
  <style tal:content="structure view/print_css">@page {}</style>
</head>
<body class="pd" tal:define="report view/report">
  <tal:h tal:replace="structure view/print_head" />
  <metal:b use-macro="view/body_macros/body" />
</body>
</html>
