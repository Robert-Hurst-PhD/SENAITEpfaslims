<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Effective QC</title>
  <metal:fill fill-slot="header-title">Effective QC</metal:fill>

  <tal:c metal:fill-slot="header-context"><span class="pfas-chip" tal:content="view/method_id">FDA_32PFAS</span></tal:c>
  <tal:r metal:fill-slot="header-right">
    <a class="btn-sm btn-secondary btn-back" tal:attributes="href view/editor_url">Method profile</a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">


    <form method="get" class="pfas-filterbar" data-autosubmit="data-autosubmit"
          tal:attributes="action string:${view/portal_url}/@@pfas-effective-qc">
      <div class="pfas-field"><label for="eq-method">Method</label>
        <select name="method" id="eq-method" class="pfas-select">
          <option tal:repeat="mid view/method_ids" tal:content="mid"
                  tal:attributes="value mid; selected python:'selected' if mid == view.method_id() else None">FDA</option>
        </select></div>
      <div class="pfas-field"><label for="eq-matrix">Matrix</label>
        <select name="matrix" id="eq-matrix" class="pfas-select">
          <option tal:repeat="m view/matrices" tal:content="m"
                  tal:attributes="value m; selected python:'selected' if m == view.matrix() else None">Groundwater</option>
        </select></div>
      <div class="pfas-field"><label>Show</label>
        <nav class="pfas-seg" aria-label="Show">
          <a class="pfas-seg-item" tal:repeat="f view/filter_links"
             tal:attributes="href f/url; aria-selected python:'true' if f['on'] else 'false'"
             tal:content="f/label">Show inherited</a>
        </nav></div>
      <noscript><button type="submit" class="btn btn-primary">Show</button></noscript>
    </form>

    <div class="alert alert-warn" tal:condition="not:view/matrices">This method lists no matrices yet.</div>

    <div tal:condition="view/matrices" tal:define="sheet view/sheet">
      <metal:s use-macro="context/@@pfas-grid-macros/macros/sheet" />
    </div>

  </div>
  </div>

</html>
