<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Standard Operating Procedures</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
    /* ── layout ── */
    .sop-toolbar { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:16px; }
    .sop-tabs { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:16px; }
    .sop-tab { padding:5px 14px; border-radius:16px; font-size:12px; font-weight:600;
               text-decoration:none; background:var(--s-light);
               border:1px solid var(--s-border); color:var(--s-body); cursor:pointer; }
    .sop-tab.active { background:var(--s-primary); color:#fff; border-color:var(--s-primary); }

    /* ── table ── */
    .sop-table { width:100%; border-collapse:collapse; font-size:13px; }
    .sop-table th { background:var(--s-light); padding:8px 12px; text-align:left;
                    font-size:11px; font-weight:700; color:var(--s-secondary);
                    text-transform:uppercase; letter-spacing:.04em;
                    border-bottom:2px solid var(--s-border); }
    .sop-table td { padding:9px 12px; border-bottom:1px solid var(--s-border); vertical-align:middle; }
    .sop-table tr:hover > td { background:var(--s-primary-lt); }
    .sop-row-toggle { cursor:pointer; }

    /* ── badges (.badge base is global — only colours here) ── */
    .badge-draft      { background:#e9ecef; color:#495057; }
    .badge-active     { background:#d4edda; color:#155724; }
    .badge-superseded { background:#fff3cd; color:#856404; }
    .badge-ok   { background:#d4edda; color:#155724; }
    .badge-warn { background:#fff3cd; color:#856404; }
    .badge-method { background:var(--s-light); color:var(--s-secondary);
                    font-size:11px; font-weight:600; }

    /* ── detail panel ── */
    .sop-detail { display:none; background:#f8f9fa; border-top:2px solid var(--s-primary);
                  padding:16px; }
    .sop-detail.open { display:block; }
    .sop-detail-tabs { display:flex; gap:6px; margin-bottom:14px; }
    .sop-dtab { padding:5px 14px; border-radius:4px; font-size:12px; font-weight:600;
                background:var(--s-light); border:1px solid var(--s-border); cursor:pointer; }
    .sop-dtab.active { background:var(--s-primary); color:#fff; border-color:var(--s-primary); }
    .sop-dpanel { display:none; }
    .sop-dpanel.active { display:block; }

    /* ── PDF viewer ── */
    .sop-viewer { width:100%; height:calc(100vh - 320px); min-height:400px;
                  border:1px solid var(--s-border); border-radius:4px; background:#fff; }

    /* ── sign-off roster ── */
    .sig-roster { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
    .sig-chip { padding:4px 12px; border-radius:12px; font-size:11px; font-weight:600; }
    .sig-chip.signed   { background:#d4edda; color:#155724; }
    .sig-chip.unsigned { background:#f8d7da; color:#721c24; }

    /* ── rev history ── */
    .rev-table { width:100%; border-collapse:collapse; font-size:12px; margin-top:10px; }
    .rev-table th { background:var(--s-light); padding:6px 10px; text-align:left;
                    font-size:11px; font-weight:700; color:var(--s-secondary);
                    border-bottom:2px solid var(--s-border); }
    .rev-table td { padding:7px 10px; border-bottom:1px solid var(--s-border); }

    /* ── modal ── */
    .sop-modal-overlay { display:none; position:fixed; inset:0;
                         background:rgba(0,0,0,.45); z-index:1000;
                         align-items:center; justify-content:center; }
    .sop-modal-overlay.open { display:flex; }
    .sop-modal { background:#fff; border-radius:8px; padding:24px; width:520px;
                 max-width:95vw; max-height:90vh; overflow-y:auto;
                 box-shadow:0 8px 32px rgba(0,0,0,.2); }
    .sop-modal h3 { margin:0 0 16px; font-size:16px; color:var(--s-body); }
    .fld { display:flex; flex-direction:column; gap:3px; margin-bottom:12px; }
    .fld label { font-size:11px; font-weight:600; color:var(--s-secondary); text-transform:uppercase; }
    .fld input,.fld select,.fld textarea {
      padding:7px 9px; font-size:13px; border:1px solid var(--s-input-border);
      border-radius:4px; }
    .fld textarea { min-height:70px; resize:vertical; }
    .modal-actions { display:flex; gap:8px; justify-content:flex-end; margin-top:16px; }
    .btn-primary { padding:7px 20px; background:var(--s-primary); color:#fff;
                   border:none; border-radius:4px; cursor:pointer; font-weight:600; font-size:13px; }
    .btn-ghost  { padding:7px 16px; background:transparent; color:var(--s-secondary);
                  border:1px solid var(--s-border); border-radius:4px; cursor:pointer; font-size:13px; }
    .btn-sm { padding:4px 12px; font-size:11px; font-weight:600; cursor:pointer;
              border-radius:4px; border:1px solid var(--s-border);
              background:var(--s-light); color:var(--s-body); }
    .btn-sm:hover { background:var(--s-primary); color:#fff; border-color:var(--s-primary); }
    .btn-sign { padding:7px 18px; background:#28a745; color:#fff;
                border:none; border-radius:4px; cursor:pointer;
                font-weight:700; font-size:13px; }

    /* ── alert banner ── */
    .sop-banner { padding:10px 16px; border-radius:6px; margin-bottom:14px;
                  font-size:13px; font-weight:600; display:flex; align-items:center; gap:8px; }
    .sop-banner.warn { background:#fff3cd; color:#856404; border:1px solid #ffc107; }
    .sop-banner.success { background:#d4edda; color:#155724; border:1px solid #28a745; }
    .sop-banner.error { background:#f8d7da; color:#721c24; border:1px solid #dc3545; }
    .sop-banner.info { background:#cce5ff; color:#004085; border:1px solid #007bff; }
  </style>
  </tal:styles>
</head>
<body>
<tal:t metal:fill-slot="header-title">Standard Operating Procedures</tal:t>
<metal:content metal:fill-slot="content">
<tal:def tal:define="
  purl      view/portal_url;
  sops      view/list_sops;
  can_mgr   view/can_manage;
  msg       view/msg;
  msg_type  view/msg_type;
  msg_text  view/msg_text;
  sel_id    view/selected_sop_id;
  active_tab view/active_tab;
  tabs      view/filter_tabs;
  methods   view/method_options;
  unsigned  view/unsigned_sops;
">

  <!-- ── Unsigned SOP banner ──────────────────────────────────────────────── -->
  <tal:unsigned tal:condition="python:unsigned and not msg">
    <div class="sop-banner warn">
      &#9888;
      You have <strong tal:content="python:len(unsigned)">0</strong>
      SOP<tal:pl tal:condition="python:len(unsigned)!=1">s</tal:pl>
      requiring your sign-off.
      Scroll down or use the filter to find them.
    </div>
  </tal:unsigned>

  <!-- ── Flash message ────────────────────────────────────────────────────── -->
  <tal:flash tal:condition="msg">
    <div tal:attributes="class python:'sop-banner ' + msg_type"
         tal:content="msg_text">Message</div>
  </tal:flash>

  <!-- ── Toolbar ──────────────────────────────────────────────────────────── -->
  <div class="sop-toolbar">
    <strong style="font-size:15px;color:var(--s-body)">SOPs</strong>
    <span style="flex:1"></span>
    <tal:mgr tal:condition="can_mgr">
      <button class="btn-primary" onclick="openSOPModal()">+ New SOP</button>
    </tal:mgr>
  </div>

  <!-- ── Method filter tabs ───────────────────────────────────────────────── -->
  <div class="sop-tabs">
    <tal:each tal:repeat="tab tabs">
      <a class="sop-tab"
         tal:attributes="href string:${purl}/@@pfas-sop?method=${tab/key};
                         class python:'sop-tab active' if active_tab == tab['key'] else 'sop-tab'"
         tal:content="tab/label">Tab</a>
    </tal:each>
  </div>

  <!-- ── SOP table ────────────────────────────────────────────────────────── -->
  <div class="table-wrap">
  <table class="sop-table">
    <thead>
      <tr>
        <th>SOP ID</th>
        <th>Title</th>
        <th>Category</th>
        <th>Method</th>
        <th>Rev</th>
        <th>Activated</th>
        <th>Sign-offs</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <tal:nosops tal:condition="python:not sops">
        <tr>
          <td colspan="8" style="text-align:center;padding:32px;color:var(--s-secondary)">
            No SOPs yet.
            <tal:mgr tal:condition="can_mgr">
              <a href="#" onclick="openSOPModal(); return false;"
                 style="color:var(--s-primary)">Upload the first SOP.</a>
            </tal:mgr>
          </td>
        </tr>
      </tal:nosops>
      <tal:rows tal:repeat="sop sops">
        <tal:skip tal:condition="python:
          active_tab == 'general' and sop['method_slug'] or
          (active_tab and active_tab != 'general' and sop['method_slug'] != active_tab)">
        </tal:skip>
        <tal:show tal:condition="python:
          not active_tab or
          (active_tab == 'general' and not sop['method_slug']) or
          (active_tab and active_tab != 'general' and sop['method_slug'] == active_tab)">
          <tr class="sop-row-toggle"
              tal:define="sop_id_js python:sop['sop_id'].replace('-','_')"
              tal:attributes="onclick string:sopToggle('detail-${sop_id_js}')">
            <td><strong tal:content="sop/sop_id">SOP-001</strong></td>
            <td tal:content="sop/title">Title</td>
            <td tal:content="sop/category">—</td>
            <td><span class="badge badge-method" tal:content="sop/method_label">General</span></td>
            <td>
              <tal:rev tal:condition="sop/active_rev">
                Rev <tal:n tal:replace="python:sop['active_rev']['rev_num']">1</tal:n>
              </tal:rev>
              <tal:norev tal:condition="python:not sop['active_rev']">
                <span class="badge badge-draft">No active rev</span>
              </tal:norev>
            </td>
            <td>
              <tal:rev tal:condition="sop/active_rev">
                <tal:d tal:replace="python:sop['active_rev'].get('activated_at','')[:10] or '—'">—</tal:d>
              </tal:rev>
              <tal:norev tal:condition="python:not sop['active_rev']">—</tal:norev>
            </td>
            <td>
              <tal:rev tal:condition="sop/active_rev">
                <span tal:attributes="class python:'badge badge-ok' if sop['user_signed'] else 'badge badge-warn'">
                  <tal:t tal:condition="sop/user_signed">Signed &#10003;</tal:t>
                  <tal:t tal:condition="python:not sop['user_signed']">Not signed</tal:t>
                </span>
              </tal:rev>
              <tal:norev tal:condition="python:not sop['active_rev']">—</tal:norev>
            </td>
            <td onclick="event.stopPropagation()">
              <div style="display:flex;gap:5px;flex-wrap:wrap">
                <tal:hasrev tal:condition="sop/active_rev"
                            tal:define="ar_rev python:sop['active_rev'] and sop['active_rev']['rev_num']">
                  <a class="btn-sm" target="_blank"
                     tal:attributes="href string:${purl}/@@pfas-sop?action=download_sop&amp;sop_id=${sop/sop_id}&amp;rev_num=${ar_rev}&amp;view=0"
                     >Download</a>
                </tal:hasrev>
                <tal:drafts tal:condition="python:can_mgr and sop['draft_revs']">
                  <tal:each tal:repeat="dr python:sop['draft_revs']">
                    <form method="POST" style="display:inline"
                          tal:attributes="action string:${purl}/@@pfas-sop">
                      <input type="hidden" name="action" value="activate_revision"/>
                      <input type="hidden" name="sop_id"
                             tal:attributes="value sop/sop_id"/>
                      <input type="hidden" name="rev_num"
                             tal:attributes="value dr/rev_num"/>
                      <button type="submit" class="btn-sm"
                              style="background:#28a745;color:#fff;border-color:#28a745">
                        Activate Rev <tal:n tal:replace="dr/rev_num">1</tal:n>
                      </button>
                    </form>
                  </tal:each>
                </tal:drafts>
                <tal:mgr tal:condition="can_mgr">
                  <button class="btn-sm"
                          tal:define="sop_id_safe sop/sop_id"
                          tal:attributes="onclick string:openSOPModal('${sop_id_safe}')"
                          >New Revision</button>
                  <form method="POST" style="display:inline"
                        tal:attributes="action string:${purl}/@@pfas-sop"
                        onsubmit="return confirm('Delete this SOP? It will be moved to Archived; its number is not reused.');">
                    <input type="hidden" name="action" value="delete_sop"/>
                    <input type="hidden" name="sop_id" tal:attributes="value sop/sop_id"/>
                    <button type="submit" class="btn-sm"
                            style="background:#dc3545;color:#fff;border-color:#dc3545">Delete</button>
                  </form>
                </tal:mgr>
              </div>
            </td>
          </tr>
          <!-- ── Detail panel ─────────────────────────────────────────────── -->
          <tr>
            <td colspan="8" style="padding:0">
              <div class="sop-detail"
                   tal:define="sop_id_js python:sop['sop_id'].replace('-','_')"
                   tal:attributes="id string:detail-${sop_id_js}">

                <div class="sop-detail-tabs">
                  <button class="sop-dtab active"
                          tal:define="sop_id_js python:sop['sop_id'].replace('-','_')"
                          tal:attributes="onclick string:sopDTab('${sop_id_js}','viewer')"
                          >View Document</button>
                  <button class="sop-dtab"
                          tal:define="sop_id_js python:sop['sop_id'].replace('-','_')"
                          tal:attributes="onclick string:sopDTab('${sop_id_js}','history')"
                          >Revision History</button>
                  <button class="sop-dtab"
                          tal:define="sop_id_js2 python:sop['sop_id'].replace('-','_')"
                          tal:attributes="onclick string:sopDTab('${sop_id_js2}','signoffs')"
                          tal:condition="can_mgr"
                          >Sign-off Roster</button>
                </div>

                <!-- Viewer tab -->
                <div class="sop-dpanel active"
                     tal:define="sop_id_js python:sop['sop_id'].replace('-','_')"
                     tal:attributes="id string:panel-${sop_id_js}-viewer">
                  <tal:hasrev tal:condition="sop/active_rev"
                              tal:define="ar_rev python:sop['active_rev'] and sop['active_rev']['rev_num']">
                    <iframe class="sop-viewer"
                            tal:attributes="src string:${purl}/@@pfas-sop?action=download_sop&amp;sop_id=${sop/sop_id}&amp;rev_num=${ar_rev}&amp;view=1"
                            ></iframe>
                    <!-- Sign button -->
                    <tal:unsigned tal:condition="python:not sop['user_signed']">
                      <div style="margin-top:12px">
                        <form method="POST"
                              tal:attributes="action string:${purl}/@@pfas-sop">
                          <input type="hidden" name="action" value="sign_sop"/>
                          <input type="hidden" name="sop_id"
                                 tal:attributes="value sop/sop_id"/>
                          <button type="submit" class="btn-sign">
                            &#10003; I have read and will follow this SOP to the best of my abilities
                          </button>
                        </form>
                      </div>
                    </tal:unsigned>
                    <tal:signed tal:condition="sop/user_signed">
                      <div style="margin-top:10px;color:#155724;font-size:12px;font-weight:600">
                        &#10003; You have signed this revision.
                      </div>
                    </tal:signed>
                  </tal:hasrev>
                  <tal:norev tal:condition="python:not sop['active_rev']">
                    <p style="color:var(--s-secondary);padding:16px">
                      No active revision.
                      <tal:mgr tal:condition="can_mgr">Upload and activate a revision to make it available.</tal:mgr>
                    </p>
                  </tal:norev>
                </div>

                <!-- History tab -->
                <div class="sop-dpanel"
                     tal:define="sop_id_js python:sop['sop_id'].replace('-','_')"
                     tal:attributes="id string:panel-${sop_id_js}-history">
                  <table class="rev-table">
                    <tr>
                      <th>Rev</th><th>Status</th><th>Uploaded</th>
                      <th>Activated</th><th>By</th><th>Release Notes</th>
                    </tr>
                    <tal:each tal:repeat="rev python:list(reversed(sop['all_revs']))">
                      <tr>
                        <td><strong tal:content="rev/rev_num">1</strong></td>
                        <td>
                          <span tal:attributes="class python:'badge badge-' + rev.get('status','draft')"
                                tal:content="rev/status">draft</span>
                        </td>
                        <td tal:content="python:rev.get('uploaded_at','')">—</td>
                        <td tal:content="python:(rev.get('activated_at') or '')[:10] or '—'">—</td>
                        <td tal:content="python:rev.get('uploaded_by','')">—</td>
                        <td tal:content="python:rev.get('release_notes','') or '—'">—</td>
                      </tr>
                    </tal:each>
                  </table>
                </div>

                <!-- Sign-off roster tab (manager only) -->
                <div class="sop-dpanel"
                     tal:condition="can_mgr"
                     tal:define="sop_id_js python:sop['sop_id'].replace('-','_')"
                     tal:attributes="id string:panel-${sop_id_js}-signoffs">
                  <tal:hasrev tal:condition="sop/active_rev">
                    <p style="font-size:12px;color:var(--s-secondary);margin:0 0 10px">
                      Showing sign-offs for Rev <strong tal:content="python:sop['active_rev']['rev_num']">1</strong>.
                      Activating a new revision clears all sign-offs.
                    </p>
                    <p style="font-size:12px;font-weight:600;color:var(--s-secondary)">
                      <tal:count tal:replace="sop/signer_count">0</tal:count> signed
                    </p>
                    <div class="sig-roster">
                      <!-- Note: for a full roster showing who HASN'T signed,
                           a list of expected users is needed — implement via
                           portal_membership iteration in a future enhancement -->
                    </div>
                  </tal:hasrev>
                  <tal:norev tal:condition="python:not sop['active_rev']">
                    <p style="color:var(--s-secondary)">No active revision.</p>
                  </tal:norev>
                </div>

              </div><!-- /sop-detail -->
            </td>
          </tr>
        </tal:show>
      </tal:rows>
    </tbody>
  </table>
  </div>

  <!-- ── Archived SOPs (Manager) ──────────────────────────────────────────── -->
  <tal:archived tal:condition="python:can_mgr and view.archived_sops()"
                tal:define="arch python:view.archived_sops()">
    <details class="sop-archived" style="margin-top:22px">
      <summary style="cursor:pointer;font-weight:600;color:var(--s-secondary,#6c757d)">
        Archived SOPs (<tal:n tal:replace="python:len(arch)">0</tal:n>)
      </summary>
      <table class="sop-table" style="margin-top:10px;opacity:.85">
        <thead>
          <tr><th>SOP</th><th>Title</th><th>Category</th><th>Method</th>
              <th>Deleted</th><th>By</th><th></th></tr>
        </thead>
        <tbody>
          <tr tal:repeat="a arch">
            <td><strong tal:content="a/sop_id">SOP-002</strong></td>
            <td tal:content="a/title">Title</td>
            <td tal:content="a/category">—</td>
            <td tal:content="a/method_label">General</td>
            <td tal:content="python:a['archived_at'] or '—'">—</td>
            <td tal:content="python:a['archived_by'] or '—'">—</td>
            <td>
              <form method="POST" style="display:inline"
                    tal:attributes="action string:${purl}/@@pfas-sop">
                <input type="hidden" name="action" value="restore_sop"/>
                <input type="hidden" name="sop_id" tal:attributes="value a/sop_id"/>
                <button type="submit" class="btn-sm">Restore</button>
              </form>
            </td>
          </tr>
        </tbody>
      </table>
      <p style="font-size:11px;color:var(--s-secondary,#6c757d);margin-top:6px">
        Deleted SOP numbers are never reused — the next new SOP always takes the
        next number in sequence.
      </p>
    </details>
  </tal:archived>

  <!-- ── New/New Revision Modal ───────────────────────────────────────────── -->
  <tal:mgr tal:condition="can_mgr">
  <div class="sop-modal-overlay" id="sopModalOverlay"
       onclick="if(event.target===this) closeSopModal()">
    <div class="sop-modal">
      <h3 id="sopModalTitle">Upload SOP</h3>
      <form method="POST" enctype="multipart/form-data"
            tal:attributes="action string:${purl}/@@pfas-sop">
        <input type="hidden" name="action" value="upload_sop"/>
        <input type="hidden" name="sop_id" id="sopModalSopId" value=""/>

        <div class="fld" id="sopNewFields">
          <label>Title *</label>
          <input type="text" name="title" id="sopTitle" placeholder="e.g. PFAS Extraction Procedure"/>
        </div>
        <div class="fld">
          <label>Method</label>
          <select name="method_slug">
            <tal:each tal:repeat="m methods">
              <option tal:attributes="value m/slug" tal:content="m/label">Option</option>
            </tal:each>
          </select>
        </div>
        <div class="fld">
          <label>Category</label>
          <input type="text" name="category" placeholder="e.g. Extraction, Calibration, Safety"/>
        </div>
        <div class="fld">
          <label>Description</label>
          <textarea name="description" placeholder="Brief description of this SOP's scope"></textarea>
        </div>
        <div class="fld">
          <label>Release Notes</label>
          <textarea name="release_notes"
                    placeholder="What changed in this revision?"></textarea>
        </div>
        <div class="fld">
          <label>Document File * (PDF only)</label>
          <input type="file" name="sop_file" accept=".pdf,application/pdf" required/>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-ghost" onclick="closeSopModal()">Cancel</button>
          <button type="submit" class="btn-primary">Upload</button>
        </div>
      </form>
    </div>
  </div>
  </tal:mgr>

</tal:def>
</metal:content>

<tal:scripts metal:fill-slot="scripts">
<script>
//<![CDATA[
function sopToggle(id) {
  var el = document.getElementById(id);
  if (!el) return;
  el.classList.toggle('open');
}

function sopDTab(sopId, tab) {
  var panels = document.querySelectorAll('[id^="panel-' + sopId + '-"]');
  panels.forEach(function(p) { p.classList.remove('active'); });
  var btns = document.querySelectorAll('[onclick*="sopDTab(\'' + sopId + '\'"]');
  btns.forEach(function(b) { b.classList.remove('active'); });
  var panel = document.getElementById('panel-' + sopId + '-' + tab);
  if (panel) panel.classList.add('active');
  event.currentTarget.classList.add('active');
}

function openSOPModal(sopId) {
  var overlay = document.getElementById('sopModalOverlay');
  if (!overlay) return;
  var newFields = document.getElementById('sopNewFields');
  var title = document.getElementById('sopModalTitle');
  var idInput = document.getElementById('sopModalSopId');
  if (sopId) {
    idInput.value = sopId;
    if (newFields) newFields.style.display = 'none';
    title.textContent = 'Upload New Revision — ' + sopId;
  } else {
    idInput.value = '';
    if (newFields) newFields.style.display = 'block';
    title.textContent = 'Upload New SOP';
  }
  overlay.classList.add('open');
}

function closeSopModal() {
  var overlay = document.getElementById('sopModalOverlay');
  if (overlay) overlay.classList.remove('open');
}

// Auto-open detail panel for selected SOP after redirect
(function() {
  var qs = new URLSearchParams(window.location.search);
  var sel = qs.get('sop_id');
  if (sel) {
    var id = sel.replace(/-/g, '_');
    var el = document.getElementById('detail-' + id);
    if (el) el.classList.add('open');
  }
})();
//]]>
</script>
</tal:scripts>
</body>
</html>
