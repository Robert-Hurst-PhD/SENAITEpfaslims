<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Controlled Documents</title>
</head>
<body>
<tal:t metal:fill-slot="header-title">Controlled Documents</tal:t>
<metal:content metal:fill-slot="content">
<tal:def tal:define="
  purl      view/portal_url;
  sops      view/list_sops;
  can_mgr   view/can_manage;
  msg       view/msg;
  msg_type  view/msg_type;
  msg_text  view/msg_text;
  sel_id    view/selected_sop_id;
  active_tab view/active_tab;
  tabs      view/filter_tabs;
  methods   view/method_options;
  unsigned  view/unsigned_sops;
  doc_types view/doc_type_options;
  type_tabs view/type_filter_tabs;
  active_type_tab view/active_type_tab;
">

  <!-- ── Unsigned document banner ─────────────────────────────────────────── -->
  <tal:unsigned tal:condition="python:unsigned and not msg">
    <div class="alert alert-warn">
      &#9888;
      You have <strong tal:content="python:len(unsigned)">0</strong>
      document<tal:pl tal:condition="python:len(unsigned)!=1">s</tal:pl>
      requiring your sign-off.
      Scroll down or use the filter to find them.
    </div>
  </tal:unsigned>

  <!-- ── Flash message ────────────────────────────────────────────────────── -->
  <tal:flash tal:condition="msg">
    <div tal:attributes="class python:'alert alert-' + msg_type"
         tal:content="msg_text">Message</div>
  </tal:flash>

  <!-- ── Filters: method and document type as segmented links, archived as a
       switch; the form applies on change ───────────────────────────────── -->
  <form method="get" class="pfas-filterbar" data-autosubmit="data-autosubmit"
        tal:attributes="action string:${purl}/@@pfas-sop">
    <input type="hidden" name="method" tal:condition="active_tab" tal:attributes="value active_tab"/>
    <input type="hidden" name="doc_type" tal:condition="active_type_tab" tal:attributes="value active_type_tab"/>
    <div class="pfas-field">
      <span>Method</span>
      <nav class="pfas-seg pfas-seg-strip" aria-label="Method">
        <a class="pfas-seg-item" tal:repeat="tab tabs"
           tal:attributes="href string:${purl}/@@pfas-sop?method=${tab/key};
                           aria-selected python:'true' if active_tab == tab['key'] else 'false'"
           tal:content="tab/label">Tab</a>
      </nav>
    </div>
    <div class="pfas-field">
      <span>Type</span>
      <nav class="pfas-seg pfas-seg-strip" aria-label="Document type">
        <a class="pfas-seg-item" tal:repeat="ttab type_tabs"
           tal:attributes="href string:${purl}/@@pfas-sop?doc_type=${ttab/key};
                           aria-selected python:'true' if active_type_tab == ttab['key'] else 'false'"
           tal:content="ttab/label">Tab</a>
      </nav>
    </div>
    <label class="pfas-switch" tal:condition="python:can_mgr and view.archived_sops()">
      <input type="checkbox" name="show_archived" value="1"
             tal:attributes="checked python:'checked' if request.form.get('show_archived') == '1' else None"/>
      <span class="pfas-switch-track"></span>
      <span>Show archived</span>
    </label>
    <noscript><button type="submit" class="btn btn-primary">Apply</button></noscript>
    <span class="pfas-filterbar-spacer"></span>
    <tal:mgr tal:condition="can_mgr">
      <button type="button" class="btn btn-primary" onclick="openSOPModal()">+ New Document</button>
    </tal:mgr>
  </form>

  <!-- ── Document table ───────────────────────────────────────────────────── -->
  <div class="table-wrap">
  <table class="pfas-table sop-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Type</th>
        <th>Category</th>
        <th>Method</th>
        <th>Rev</th>
        <th>Activated</th>
        <th>Sign-offs</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <tal:nosops tal:condition="python:not sops">
        <tr>
          <td colspan="9" class="pfas-cell-empty">
            No documents yet.
            <tal:mgr tal:condition="can_mgr">
              <button type="button" class="btn-sm btn-secondary" onclick="openSOPModal()">Upload the first document.</button>
            </tal:mgr>
          </td>
        </tr>
      </tal:nosops>
      <tal:rows tal:repeat="sop sops">
        <tal:skip tal:condition="python:
          active_tab == 'general' and sop['method_slug'] or
          (active_tab and active_tab != 'general' and sop['method_slug'] != active_tab)">
        </tal:skip>
        <tal:show tal:condition="python:
          (not active_tab or
           (active_tab == 'general' and not sop['method_slug']) or
           (active_tab and active_tab != 'general' and sop['method_slug'] == active_tab))
          and
          (not active_type_tab or sop['doc_type'] == active_type_tab)">
          <tr class="pfas-row-toggle"
              tal:define="sop_id_js python:sop['sop_id'].replace('-','_')"
              tal:attributes="onclick string:sopToggle('detail-${sop_id_js}')">
            <td><strong tal:content="sop/sop_id">SOP-001</strong></td>
            <td tal:content="sop/title">Title</td>
            <td tal:content="sop/doc_type_label">SOP</td>
            <td tal:content="sop/category">—</td>
            <td tal:content="sop/method_label">General</td>
            <td>
              <tal:rev tal:condition="sop/active_rev">
                Rev <tal:n tal:replace="python:sop['active_rev']['rev_num']">1</tal:n>
              </tal:rev>
              <tal:norev tal:condition="python:not sop['active_rev']">
                <span class="badge badge-draft">No active rev</span>
              </tal:norev>
            </td>
            <td>
              <tal:rev tal:condition="sop/active_rev">
                <tal:d tal:replace="python:sop['active_rev'].get('activated_at','')[:10] or '—'">—</tal:d>
              </tal:rev>
              <tal:norev tal:condition="python:not sop['active_rev']">—</tal:norev>
            </td>
            <td>
              <tal:rev tal:condition="sop/active_rev">
                <span tal:attributes="class python:'badge badge-ok' if sop['user_signed'] else 'badge badge-warn'">
                  <tal:t tal:condition="sop/user_signed">Signed &#10003;</tal:t>
                  <tal:t tal:condition="python:not sop['user_signed']">Not signed</tal:t>
                </span>
              </tal:rev>
              <tal:norev tal:condition="python:not sop['active_rev']">—</tal:norev>
            </td>
            <td onclick="event.stopPropagation()">
              <div class="row-actions is-wrap">
                <tal:hasrev tal:condition="sop/active_rev"
                            tal:define="ar_rev python:sop['active_rev'] and sop['active_rev']['rev_num']">
                  <a class="btn-sm btn-secondary" target="_blank"
                     tal:attributes="href string:${purl}/@@pfas-sop?action=download_sop&amp;sop_id=${sop/sop_id}&amp;rev_num=${ar_rev}&amp;view=0"
                     >Download</a>
                  <a class="btn-sm btn-secondary" target="_blank"
                     tal:attributes="href string:${purl}/@@pfas-sop-cover?sop_id=${sop/sop_id}"
                     >Cover page</a>
                </tal:hasrev>
                <tal:drafts tal:condition="python:can_mgr and sop['draft_revs']">
                  <tal:each tal:repeat="dr python:sop['draft_revs']">
                    <form method="POST" class="pfas-inline-form"
                          tal:attributes="action string:${purl}/@@pfas-sop">
                      <input type="hidden" name="action" value="activate_revision"/>
                      <input type="hidden" name="sop_id"
                             tal:attributes="value sop/sop_id"/>
                      <input type="hidden" name="rev_num"
                             tal:attributes="value dr/rev_num"/>
                      <button type="submit" class="btn-sm btn-success">
                        Activate Rev <tal:n tal:replace="dr/rev_num">1</tal:n>
                      </button>
                    </form>
                  </tal:each>
                </tal:drafts>
                <tal:mgr tal:condition="can_mgr">
                  <button type="button" class="btn-sm btn-secondary"
                          tal:define="sop_id_safe sop/sop_id"
                          tal:attributes="onclick string:openSOPModal('${sop_id_safe}')"
                          >New Revision</button>
                  <form method="POST" class="pfas-inline-form"
                        tal:attributes="action string:${purl}/@@pfas-sop"
                        onsubmit="return confirm('Delete this document? It will be moved to Archived; its number is not reused.');">
                    <input type="hidden" name="action" value="delete_sop"/>
                    <input type="hidden" name="sop_id" tal:attributes="value sop/sop_id"/>
                    <button type="submit" class="btn-sm btn-danger">Delete</button>
                  </form>
                </tal:mgr>
              </div>
            </td>
          </tr>
          <!-- ── Detail panel ─────────────────────────────────────────────── -->
          <tr>
            <td colspan="9" class="pfas-flush">
              <div class="pfas-detail"
                   tal:define="sop_id_js python:sop['sop_id'].replace('-','_')"
                   tal:attributes="id string:detail-${sop_id_js}">

                <div data-tabs="data-tabs">
                <div class="pfas-seg pfas-seg-sm">
                  <button type="button" class="pfas-seg-item" aria-selected="true"
                          tal:attributes="data-pane string:panel-${sop_id_js}-viewer"
                          >View Document</button>
                  <button type="button" class="pfas-seg-item" aria-selected="false"
                          tal:attributes="data-pane string:panel-${sop_id_js}-history"
                          >Revision History</button>
                  <button type="button" class="pfas-seg-item" aria-selected="false"
                          tal:attributes="data-pane string:panel-${sop_id_js}-signoffs"
                          tal:condition="can_mgr"
                          >Sign-off Roster</button>
                </div>

                <!-- Viewer tab -->
                <div class="pfas-pane is-active"
                     tal:define="sop_id_js python:sop['sop_id'].replace('-','_')"
                     tal:attributes="id string:panel-${sop_id_js}-viewer">
                  <tal:hasrev tal:condition="sop/active_rev"
                              tal:define="ar_rev python:sop['active_rev'] and sop['active_rev']['rev_num']">
                    <iframe class="pfas-viewer"
                            tal:attributes="src string:${purl}/@@pfas-sop?action=download_sop&amp;sop_id=${sop/sop_id}&amp;rev_num=${ar_rev}&amp;view=1"
                            ></iframe>
                    <!-- Sign button -->
                    <tal:unsigned tal:condition="python:not sop['user_signed']">
                      <div class="pfas-mt">
                        <form method="POST"
                              tal:attributes="action string:${purl}/@@pfas-sop">
                          <input type="hidden" name="action" value="sign_sop"/>
                          <input type="hidden" name="sop_id"
                                 tal:attributes="value sop/sop_id"/>
                          <button type="submit" class="btn btn-success btn-sign">
                            &#10003; I have read and will follow this document to the best of my abilities
                          </button>
                        </form>
                      </div>
                    </tal:unsigned>
                    <tal:signed tal:condition="sop/user_signed">
                      <div class="pfas-mt">
                        <span class="badge badge-ok">&#10003; You have signed this revision.</span>
                      </div>
                    </tal:signed>
                  </tal:hasrev>
                  <tal:norev tal:condition="python:not sop['active_rev']">
                    <p class="pfas-muted">
                      No active revision.
                      <tal:mgr tal:condition="can_mgr">Upload and activate a revision to make it available.</tal:mgr>
                    </p>
                  </tal:norev>
                </div>

                <!-- History tab -->
                <div class="pfas-pane"
                     tal:define="sop_id_js python:sop['sop_id'].replace('-','_')"
                     tal:attributes="id string:panel-${sop_id_js}-history">
                  <table class="pfas-table rev-table">
                    <tr>
                      <th>Rev</th><th>Status</th><th>Uploaded</th>
                      <th>Activated</th><th>By</th><th>Release Notes</th>
                    </tr>
                    <tal:each tal:repeat="rev python:list(reversed(sop['all_revs']))">
                      <tr>
                        <td><strong tal:content="rev/rev_num">1</strong></td>
                        <td>
                          <span tal:attributes="class python:'badge badge-' + rev.get('status','draft')"
                                tal:content="rev/status">draft</span>
                        </td>
                        <td tal:content="python:rev.get('uploaded_at','')">—</td>
                        <td tal:content="python:(rev.get('activated_at') or '')[:10] or '—'">—</td>
                        <td tal:content="python:rev.get('uploaded_by','')">—</td>
                        <td tal:content="python:rev.get('release_notes','') or '—'">—</td>
                      </tr>
                    </tal:each>
                  </table>
                </div>

                <!-- Sign-off roster tab (manager only) -->
                <div class="pfas-pane"
                     tal:condition="can_mgr"
                     tal:define="sop_id_js python:sop['sop_id'].replace('-','_')"
                     tal:attributes="id string:panel-${sop_id_js}-signoffs">
                  <tal:hasrev tal:condition="sop/active_rev">
                    <p class="pfas-muted">
                      Showing sign-offs for Rev <strong tal:content="python:sop['active_rev']['rev_num']">1</strong>.
                      Activating a new revision clears all sign-offs.
                    </p>
                    <p class="pfas-muted">
                      <tal:count tal:replace="sop/signer_count">0</tal:count> signed
                    </p>
                    <div class="sig-roster">
                      <!-- Note: for a full roster showing who HASN'T signed,
                           a list of expected users is needed — implement via
                           portal_membership iteration in a future enhancement -->
                    </div>
                  </tal:hasrev>
                  <tal:norev tal:condition="python:not sop['active_rev']">
                    <p class="pfas-muted">No active revision.</p>
                  </tal:norev>
                </div>
                </div><!-- /tabs -->

              </div><!-- /detail -->
            </td>
          </tr>
        </tal:show>
      </tal:rows>
    </tbody>
  </table>
  </div>

  <!-- ── Archived Documents (Manager) ─────────────────────────────────────── -->
  <tal:archived tal:condition="python:can_mgr and request.form.get('show_archived') == '1' and view.archived_sops()"
                tal:define="arch python:view.archived_sops()">
    <section class="pfas-mt">
      <h3 class="pfas-label">
        Archived Documents (<tal:n tal:replace="python:len(arch)">0</tal:n>)
      </h3>
      <table class="pfas-table sop-table">
        <thead>
          <tr><th>ID</th><th>Title</th><th>Type</th><th>Category</th><th>Method</th>
              <th>Deleted</th><th>By</th><th></th></tr>
        </thead>
        <tbody>
          <tr tal:repeat="a arch">
            <td><strong tal:content="a/sop_id">SOP-002</strong></td>
            <td tal:content="a/title">Title</td>
            <td tal:content="a/doc_type_label">SOP</td>
            <td tal:content="a/category">&#8212;</td>
            <td tal:content="a/method_label">General</td>
            <td tal:content="python:a['archived_at'] or u'\u2014'">&#8212;</td>
            <td tal:content="python:a['archived_by'] or u'\u2014'">&#8212;</td>
            <td>
              <form method="POST" class="pfas-inline-form"
                    tal:attributes="action string:${purl}/@@pfas-sop">
                <input type="hidden" name="action" value="restore_sop"/>
                <input type="hidden" name="sop_id" tal:attributes="value a/sop_id"/>
                <button type="submit" class="btn-sm btn-secondary">Restore</button>
              </form>
            </td>
          </tr>
        </tbody>
      </table>
      <p class="pfas-aux">
        Deleted document numbers are never reused &#8212; the next new document of
        that type always takes the next number in its sequence.
      </p>
    </section>
  </tal:archived>

  <!-- ── New/New Revision Modal ───────────────────────────────────────────── -->
  <tal:mgr tal:condition="can_mgr">
  <div class="pfas-modal" id="sopModalOverlay"
       onclick="if(event.target===this) closeSopModal()">
    <div class="pfas-modal-box is-narrow">
      <h2 id="sopModalTitle">Upload Document</h2>
      <form method="POST" enctype="multipart/form-data"
            tal:attributes="action string:${purl}/@@pfas-sop">
        <input type="hidden" name="action" value="upload_sop"/>
        <input type="hidden" name="sop_id" id="sopModalSopId" value=""/>

        <div id="sopNewFields">
          <div class="pfas-form-field is-spaced">
            <label>Title *</label>
            <input type="text" name="title" id="sopTitle" placeholder="e.g. PFAS Extraction Procedure"/>
          </div>
          <div class="pfas-form-field is-spaced">
            <label>Document type</label>
            <select name="doc_type">
              <tal:each tal:repeat="dt doc_types">
                <option tal:attributes="value dt/code; selected dt/is_default"
                        tal:content="dt/label">Option</option>
              </tal:each>
            </select>
          </div>
        </div>
        <div class="pfas-form-field is-spaced">
          <label>Method</label>
          <select name="method_slug">
            <tal:each tal:repeat="m methods">
              <option tal:attributes="value m/slug" tal:content="m/label">Option</option>
            </tal:each>
          </select>
        </div>
        <div class="pfas-form-field is-spaced">
          <label>Category</label>
          <input type="text" name="category" placeholder="e.g. Extraction, Calibration, Safety"/>
        </div>
        <div class="pfas-form-field is-spaced">
          <label>Description</label>
          <textarea name="description" placeholder="Brief description of this document's scope"></textarea>
        </div>
        <div class="pfas-form-field is-spaced">
          <label>Release notes</label>
          <textarea name="release_notes"
                    placeholder="What changed in this revision?"></textarea>
        </div>
        <div class="pfas-form-field is-spaced">
          <label>Document file * (PDF only)</label>
          <input type="file" name="sop_file" accept=".pdf,application/pdf" required/>
        </div>
        <div class="form-actions is-end">
          <button type="button" class="btn btn-secondary" onclick="closeSopModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Upload</button>
        </div>
      </form>
    </div>
  </div>
  </tal:mgr>

</tal:def>
</metal:content>

<tal:scripts metal:fill-slot="scripts">
<script>
//<![CDATA[
/* the pill of a tab strip inside a closed detail row measured zero */
function sopPills(el) {
  if (!(window.PFAS && PFAS.components)) return;
  var segs = el.querySelectorAll('.pfas-seg');
  for (var i = 0; i < segs.length; i++) { PFAS.components.placePill(segs[i]); }
}

function sopToggle(id) {
  var el = document.getElementById(id);
  if (!el) return;
  el.classList.toggle('open');
  sopPills(el);
}

function openSOPModal(sopId) {
  var overlay = document.getElementById('sopModalOverlay');
  if (!overlay) return;
  var newFields = document.getElementById('sopNewFields');
  var title = document.getElementById('sopModalTitle');
  var idInput = document.getElementById('sopModalSopId');
  if (sopId) {
    idInput.value = sopId;
    if (newFields) newFields.hidden = true;
    title.textContent = 'Upload New Revision \u2014 ' + sopId;
  } else {
    idInput.value = '';
    if (newFields) newFields.hidden = false;
    title.textContent = 'Upload New Document';
  }
  overlay.classList.add('open');
}

function closeSopModal() {
  var overlay = document.getElementById('sopModalOverlay');
  if (overlay) overlay.classList.remove('open');
}

// Auto-open detail panel for selected document after redirect
(function() {
  var qs = new URLSearchParams(window.location.search);
  var sel = qs.get('sop_id');
  if (sel) {
    var id = sel.replace(/-/g, '_');
    var el = document.getElementById('detail-' + id);
    if (el) { el.classList.add('open'); sopPills(el); }
  }
})();
//]]>
</script>
</tal:scripts>
</body>
</html>
