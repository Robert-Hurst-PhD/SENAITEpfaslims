<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Manual integration reasons</title>
  <metal:fill fill-slot="header-title">Manual integration reasons</metal:fill>

  <div metal:fill-slot="content" tal:define="s view/settings; editable view/can_configure">
  <div class="page-body">
    <div class="alert alert-success" tal:condition="request/saved|nothing">Saved.</div>
    <div class="alert alert-danger" tal:condition="request/error|nothing" tal:content="request/error">error</div>

    <p class="form-note">Reasons an analyst may give. <tal:h define="hid string:manual-integration"><a metal:use-macro="context/@@pfas-macros/macros/help"></a></tal:h></p>

    <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-mi-reasons">
      <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
      <input type="hidden" name="action" value="save_reasons" />
      <fieldset class="pfas-ro" tal:attributes="disabled python:None if editable else 'disabled'">
      <table class="pfas-table pfas-table-form">
        <thead><tr><th>In use</th><th>Reason</th><th>Source</th></tr></thead>
        <tbody>
          <tr tal:repeat="r python:s['reasons'] + [{'id': '', 'text': '', 'source': '', 'active': True}]">
            <td tal:define="i repeat/r/index">
              <input type="hidden" tal:attributes="name string:r.${i}.id; value r/id" />
              <input type="checkbox" value="1" tal:attributes="name string:r.${i}.active; checked r/active" /></td>
            <td><input type="text" size="70" tal:attributes="name string:r.${repeat/r/index}.text; value r/text;
                       placeholder python:'new reason' if not r['id'] else None" /></td>
            <td><input type="text" size="22" tal:attributes="name string:r.${repeat/r/index}.source; value r/source" /></td>
          </tr>
        </tbody>
      </table>
      <div class="field-row"><label>Report heading of manual-integration pages</label>
        <input type="text" name="heading" tal:attributes="value s/heading" /></div>
      </fieldset>
      <div class="pfas-action-bar" tal:condition="editable">
        <button type="submit" class="btn btn-primary">Save reasons</button>
      </div>
    </form>

    <div class="section-group-hdr">Never acceptable</div>
    <ul class="bench-alerts">
      <li class="bench-bad" tal:repeat="x view/improper" tal:content="x">Peak shaving</li>
    </ul>
  </div>
  </div>
</html>
