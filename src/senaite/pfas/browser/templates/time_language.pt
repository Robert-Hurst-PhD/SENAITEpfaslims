<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">

  <title metal:fill-slot="title">Time &amp; Language</title>
  <metal:fill fill-slot="header-title">Time &amp; Language</metal:fill>

  <!-- the form's Save, pinned at the foot of the window -->
  <tal:ab metal:fill-slot="action-bar"><tal:sb tal:condition="view/can_configure" tal:define="sb_form string:time-language-form"><div
      metal:use-macro="context/@@pfas-macros/macros/save-bar"></div></tal:sb></tal:ab>

  <div metal:fill-slot="content">
  <div class="page-body-narrow">
    <div class="alert alert-success" tal:condition="view/saved">Saved.</div>
    <div class="alert alert-error" tal:condition="view/failed">Not saved: choose one of the languages offered, and a listed time zone.</div>

    <form method="post" id="time-language-form" tal:attributes="action string:${view/portal_url}/@@pfas-time-language">
      <input type="hidden" name="action" value="save" tal:condition="view/can_configure" />
      <input type="hidden" name="_authenticator" tal:attributes="value context/@@authenticator/token" />
      <div class="pfas-settings-grid">
      <div class="pfas-card" id="sec-language">
        <h3 class="pfas-card-head">Language <tal:h define="hid string:time-language"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></h3>
    <p class="form-note">
      The language every page is shown in, for everyone. Changing it here
      replaces any language a browser chose before.
    </p>
      <div class="pfas-form-field">
        <label for="language">Site language</label>
        <select name="language" id="language" tal:attributes="disabled python:None if view.can_configure() else 'disabled'">
          <option tal:repeat="l view/languages"
                  tal:attributes="value python:l[0]; selected python:'selected' if l[0] == view.current() else None"
                  tal:content="python:'%s (%s)' % (l[1], l[0])">English (en)</option>
        </select>
      </div>
      </div>
      <div class="pfas-card" id="sec-timezone">
        <h3 class="pfas-card-head">Laboratory time zone</h3>
      <div class="pfas-form-row">
        <div class="pfas-form-field">
          <label for="timezone">Time zone of the instrument's clock</label>
          <select name="timezone" id="timezone" tal:attributes="disabled python:None if view.can_configure() else 'disabled'">
            <option value="">Default: UTC</option>
            <option tal:repeat="z view/timezones"
                    tal:attributes="value z; selected python:'selected' if z == view.timezone() else None"
                    tal:content="z">America/New_York</option>
          </select>
        </div>
        <div class="pfas-form-field"><span>Now in lab time</span> <strong tal:content="view/lab_now">2026-11-03 09:00</strong></div>
        <div class="pfas-form-field"><span>UTC</span> <strong tal:content="view/utc_now">2026-11-03 14:00</strong></div>
      </div>
      <p class="form-note">Every time is shown in this zone; records stay stored in UTC.</p>
      </div>
      </div>
    </form>
  </div>
  </div>
</html>
