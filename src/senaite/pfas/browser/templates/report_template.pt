<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Reporting Template</title>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Reporting template</tal:t>

  <metal:fill fill-slot="content" tal:define="st view/state; msg view/message">
    <div class="alert alert-success" tal:condition="python: msg[0]" tal:content="python: msg[0]">ok</div>
    <div class="alert alert-error" tal:condition="python: msg[1]" tal:content="python: msg[1]">error</div>

    <section class="bench-block">
      <h2 class="bench-h">Issued revision</h2>
      <p tal:condition="st/none_issued" class="bench-bad rt-line">
        <strong>No revision issued.</strong> Certificates cannot be published until a Manager
        issues the first revision of the reporting template.</p>
      <p tal:condition="not:st/none_issued" class="rt-line">
        Revision <strong tal:content="st/rev">3</strong>, issued
        <span tal:replace="python: view.lab_at(st['issued_at'], st['issued_at'][:16].replace('T', ' '))">x</span>.
        Every certificate is drawn from it and records it.</p>
      <p class="rt-line" tal:condition="python: not st['none_issued'] and not st['unissued']">
        The live settings are the issued revision: nothing to issue.</p>
    </section>

    <section class="bench-block" tal:condition="view/draft_designed">
      <h2 class="bench-h">Designed certificate</h2>
      <p class="alert alert-warn rt-line">
        <strong>Issuing will include the designed certificate layout:</strong> preview it below first;
        archive the design to keep the standard layout. <tal:h define="hid string:document-designs"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></p>
    </section>

    <section class="bench-block" tal:condition="st/unissued">
      <h2 class="bench-h">Unissued changes</h2>
      <form method="post" class="rt-form" tal:omit-tag="not:view/can_issue"
            tal:attributes="action string:${view/portal_url}/@@pfas-report-template">
        <ul class="bench-alerts" tal:condition="not:st/none_issued">
          <li class="bench-warn" tal:repeat="c st/changes" tal:content="c">Print setting lab_name</li>
        </ul>
        <p class="bench-sub" tal:condition="st/none_issued">No revision has been issued yet; the live settings become the first one.</p>
        <tal:issue tal:condition="view/can_issue">
          <input type="hidden" name="action" value="issue" />
          <input type="text" name="note" class="pfas-input rt-note" required="required"
                 aria-label="What this revision changes"
                 placeholder="What this revision changes (recorded with it)" />
          <button class="btn-sm btn-primary" type="submit">Issue revision</button>
        </tal:issue>
      </form>
      <p class="bench-sub">Issuing freezes Print Settings, the Reporting tabs and the layout until the next revision; the laboratory&#8217;s name and address print from Laboratory. <tal:h define="hid string:reporting-template"><metal:b use-macro="context/@@pfas-macros/macros/help" /></tal:h></p>
    </section>

    <section class="bench-block" tal:define="samples view/preview_samples; one view/preview_sample">
      <h2 class="bench-h">Preview</h2>
      <!-- the preview opens in a new tab -->
      <form method="get" class="rt-form" tal:condition="one" tal:attributes="action string:${view/portal_url}/@@pfas-report-template-preview"
            target="_blank">
        <input type="hidden" name="uid" tal:attributes="value one/uid" />
        <span class="pfas-chip">Preview sample <b class="pfas-mono" tal:content="one/label">DW-0012</b></span>
        <button class="btn btn-secondary" type="button" data-modal-open="rt-sample" tal:condition="view/can_issue">Change</button>
        <select name="which" class="pfas-select" aria-label="Which revision">
          <option value="draft">Draft (live settings)</option>
          <option value="issued" tal:condition="not:st/none_issued">Issued revision</option>
        </select>
        <button class="btn btn-secondary" type="submit">Preview</button>
        <button class="btn btn-secondary" type="submit" name="designed" value="1"
                tal:condition="view/has_designed"
                title="The designed certificate (Document Templates), rendered as it would be published">Preview designed certificate</button>
      </form>
      <p class="bench-sub" tal:condition="not:samples">No verified or published sample to preview against.</p>
      <div class="pfas-modal" id="rt-sample" tal:condition="python:samples and view.can_issue()">
        <div class="pfas-modal-box" role="dialog" aria-modal="true" aria-labelledby="rt-sample-h">
          <h2 id="rt-sample-h">Preview sample</h2>
          <form method="post" tal:attributes="action string:${view/portal_url}/@@pfas-report-template">
            <input type="hidden" name="action" value="preview_sample" />
            <div class="cf-settings">
              <div class="cf-label"><label for="rt-sample-uid">Sample</label></div>
              <div class="cf-control">
                <select name="uid" id="rt-sample-uid" class="pfas-select">
                  <option tal:repeat="s samples" tal:attributes="value s/uid; selected python:'selected' if s['uid'] == one['uid'] else None"
                          tal:content="s/label">S-1</option>
                </select>
              </div>
            </div>
            <div class="form-actions">
              <button class="btn btn-primary" type="submit">Save</button>
              <button class="btn btn-secondary" type="button" data-modal-close="data-modal-close">Cancel</button>
            </div>
          </form>
        </div>
      </div>
    </section>


    <section class="bench-block" tal:condition="st/history">
      <h2 class="bench-h">History</h2>
      <table class="pfas-table" data-col-resize="report-template-1">
        <thead><tr><th>Revision</th><th>Issued</th><th>By</th><th>Note</th></tr></thead>
        <tbody><tr tal:repeat="r st/history">
          <td tal:content="r/rev">1</td>
          <td tal:content="python: view.lab_at(r.get('issued_at'), (r.get('issued_at') or '')[:16].replace('T', ' '))">x</td>
          <td tal:content="r/issued_by">admin</td>
          <td tal:content="r/note">first issue</td>
        </tr></tbody>
      </table>
    </section>
  </metal:fill>
</body>
</html>
