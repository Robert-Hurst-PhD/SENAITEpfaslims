<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Labels</title>
  <tal:h metal:fill-slot="head-extra">
    <link rel="stylesheet" tal:attributes="href string:${view/portal_url}/++resource++senaite.pfas/pfas-extraction-labels.css?v=${context/@@pfas-macros/asset_version}" />
  </tal:h>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Labels</tal:t>
  <tal:c metal:fill-slot="header-context"><span class="pfas-chip" tal:content="view/entry_id">FM-ENV-002-261013-01</span></tal:c>
  <tal:r metal:fill-slot="header-right">
    <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-prep-standards">Prepared Standards</a>
  </tal:r>

  <!-- one label per lot the sitting made (lot_record.label_rows) -->
  <metal:fill fill-slot="content" tal:define="rows view/rows">
    <form class="xl-tools" method="get" tal:attributes="action string:${view/portal_url}/@@pfas-sitting-labels">
      <input type="hidden" name="entry" tal:attributes="value view/entry_id" />
      <input type="hidden" name="format" value="sheet" />
      <select name="size" aria-label="Label size">
        <option tal:repeat="s view/sizes" tal:attributes="value python:s[0]; selected python:'selected' if s[0] == view.size()['id'] else None" tal:content="python:s[1]">2 x 1</option>
      </select>
      <button class="btn-sm btn-secondary" type="submit">Size</button>
      <button class="btn-sm btn-primary" type="button" onclick="window.print()">Print</button>
      <span tal:content="python:'%d labels' % len(rows)">7</span>
    </form>
    <div class="xl-sheet" tal:attributes="style view/sheet_style">
      <div class="xl-label" tal:repeat="r rows">
        <span class="xl-name" tal:content="r/name">537_CAL-1</span>
        <svg class="xl-barcode" tal:attributes="data-code r/lot"></svg>
        <span class="xl-line" tal:content="python:u' · '.join(x for x in (r['lot'], r['vol']) if x)">537_CAL-1_261013</span>
        <span class="xl-line" tal:content="python:u' · '.join(x for x in (r['date'] and 'Prep ' + r['date'], r['exp'] and 'Exp ' + r['exp'], r['analyst']) if x)">Prep</span>
        <span class="xl-line" tal:content="r/storage">2-8 C</span>
      </div>
    </div>
  </metal:fill>
  <tal:s metal:fill-slot="scripts">
    <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/vendor/JsBarcode-3.11.5.all.min.js"></script>
    <script>
      document.querySelectorAll('svg.xl-barcode').forEach(function (el) {
        try { JsBarcode(el, el.getAttribute('data-code'), {format: 'CODE128', displayValue: false, margin: 0}); }
        catch (e) { el.remove(); }
      });
    </script>
  </tal:s>
</body>
</html>
