<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Balance Verification Log</title>
</head>
<body>
<tal:t metal:fill-slot="header-title">Balance Verification Log</tal:t>
<metal:content metal:fill-slot="content">
  <tal:def tal:define="
    unit     view/unit;
    purl     view/portal_url;
    bal_units view/balance_units;
    pct       python:(unit and unit.get('tolerance_pct')) or 0;
    wpts      python:[[float(w[0]), w[1], float(w[0]) * pct / 100.0] for w in view.weight_points()];
  ">

  <nav class="pfas-seg pfas-seg-strip is-spaced" aria-label="Balance">
    <tal:each tal:repeat="u bal_units">
      <a class="pfas-seg-item"
         tal:attributes="
           href string:${purl}/@@pfas-balance-log?unit_id=${u/id};
           aria-selected python:'true' if unit and unit['id']==u['id'] else 'false'"
         tal:content="u/name">Balance</a>
    </tal:each>
  </nav>

  <tal:no-unit tal:condition="python:not unit">
    <div class="pfas-empty is-boxed">
      Select a balance above or
      <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-equipment"
        >Equipment</a>.
    </div>
  </tal:no-unit>

  <tal:has-unit tal:condition="unit">
    <!-- Entry form -->
    <div class="pfas-card">
      <h3>New Verification — <tal:n tal:replace="unit/name"/></h3>
      <form method="POST" id="balForm"
            tal:attributes="action string:${purl}/@@pfas-balance-log">
        <input type="hidden" name="unit_id" tal:attributes="value unit/id"/>
        <div class="pfas-form-row">
          <div class="pfas-form-field"><label>Date *</label>
            <input type="date" name="verified_date" id="vDate" required/></div>
          <div class="pfas-form-field"><label>Operator initials *</label>
            <input type="text" name="operator" maxlength="10" required/></div>
          <div class="pfas-form-field is-wide"><label>Reference weight set *</label>
            <select name="weight_set_id" required="required">
              <option value="">&mdash; select the set used &mdash;</option>
              <option tal:repeat="w view/weight_sets"
                      tal:attributes="value w/id"
                      tal:content="string:${w/set_id} (${w/weight_class})">WS</option>
            </select></div>
        </div>
        <!-- Required, not optional. A verification is a MEASUREMENT, and a
             measurement with no reference standard establishes nothing: the
             release gate already treats a missing weight set as blocking
             (facility_qc.equipment_provenance._weight_set_chain). Making the
             field optional would have built it and left the defect in place.
             With no set registered the form cannot be submitted — which is the
             correct outcome, and the hint below says where to go. -->
        <p class="pfas-hint is-bad" tal:condition="not:view/weight_sets">No reference weight set is registered: register the set and its certificate first.
          <a class="btn-sm btn-secondary" tal:attributes="href string:${purl}/@@pfas-weight-sets">Weight Sets</a></p>
        <div class="pfas-form-field is-spaced"><label>Notes</label>
          <input type="text" name="notes"/></div>

        <table class="pfas-table">
          <tr>
            <th>Nominal</th>
            <th>Tolerance (g)</th>
            <th>Actual Reading (g)</th>
            <th>Deviation</th>
            <th>Pass?</th>
          </tr>
          <!-- `i` is defined on the <tr>, NOT on the repeat element. TAL executes
               tal:define BEFORE tal:repeat on the same tag, so `repeat/wp` does
               not exist yet there and the page raises
                   LocationError: (RepeatDictWrapper, 'wp')
               This 500'd the Balance Verification Log for every selected balance
               from the day it was written. It was invisible because the whole
               form sits inside `tal:condition="unit"` and `facility_units` held
               zero rows, so no balance could be selected — the same latency as
               the §40 CoA link. Found by registering the first balance. -->
          <tal:each tal:repeat="wp wpts">
            <tr tal:define="i repeat/wp/index">
              <td><strong tal:content="python:wp[1]">10 mg</strong></td>
              <td class="pfas-muted-cell">
                ±<tal:t tal:replace="python:('%.6f' % wp[2]).rstrip('0').rstrip('.')"/>g
              </td>
              <td>
                <input type="number" step="any" class="pfas-num-in"
                       tal:attributes="name string:actual_${i};
                                       id string:act_${i};
                                       onchange string:calcDev(this,${i})"/>
              </td>
              <td class="pfas-dev" tal:attributes="id string:dev_${i}">—</td>
              <td tal:attributes="id string:pass_${i}">—</td>
            </tr>
          </tal:each>
        </table>

        <div class="pfas-mt-md">
          <button type="submit" class="btn btn-primary">
            Save Verification
          </button>
        </div>
      </form>
    </div>

    <!-- History -->
    <div class="pfas-card">
      <h3>Verification History</h3>
      <tal:no-hist tal:condition="python:not view.history()">
        <p class="pfas-note-sm">No verifications recorded yet.</p>
      </tal:no-hist>
      <tal:each tal:repeat="v view/history" tal:condition="python:bool(view.history())">
        <div class="pfas-entry">
          <div class="pfas-meta-row">
            <strong tal:content="v/verified_date"></strong>
            <span class="pfas-muted"
                  tal:content="string:by ${v/operator}"></span>
            <span tal:attributes="class python:'badge badge-ok' if v['passed'] else 'badge badge-fail'"
                  tal:content="python:'PASS' if v['passed'] else 'FAIL'"></span>
            <span class="pfas-hint"
                  tal:content="python:v.get('notes','')"></span>
          </div>
          <div class="pfas-entry-trace">
            <tal:with tal:condition="v/weight_set_label">
              Performed with weight set
              <strong tal:content="v/weight_set_label">WS-001</strong>
            </tal:with>
            <span tal:condition="not:v/weight_set_label" class="pfas-hint is-bad">
              No reference weight set recorded &mdash; this verification traces to
              nothing and blocks release for any work it supports.
            </span>
          </div>
          <table class="pfas-table history-table">
            <tr><th>Nominal</th><th>Actual (g)</th><th>Deviation (g)</th><th>Tol (g)</th><th>Result</th></tr>
            <tal:each tal:repeat="pt python:v.get('points',[])">
              <tr>
                <td tal:content="pt/label"></td>
                <td tal:content="python:'{:.6g}'.format(pt['actual_g']) if pt.get('actual_g') is not None else '—'"></td>
                <td tal:attributes="class python:'pfas-text-bad' if pt.get('passed')==0 else 'pfas-text-ok'"
                    tal:content="python:('+' if pt['deviation_g']>=0 else '')+'{:.6g}'.format(pt['deviation_g']) if pt.get('deviation_g') is not None else '—'"></td>
                <td tal:content="python:'±{}'.format(pt['tolerance_g']) if pt.get('tolerance_g') is not None else '—'"></td>
                <td><span tal:attributes="class python:'badge badge-ok' if pt.get('passed') else 'badge badge-fail'"
                          tal:content="python:'Pass' if pt.get('passed') else 'Fail'"></span></td>
              </tr>
            </tal:each>
          </table>
        </div>
      </tal:each>
    </div>

  </tal:has-unit>
  </tal:def>
</metal:content>

<tal:scripts metal:fill-slot="scripts">
<script tal:condition="view/unit"
        tal:define="pct python:(view.unit() or {}).get('tolerance_pct') or 0; wps_json python:__import__('json').dumps([[float(w[0]), w[1], float(w[0]) * pct / 100.0] for w in view.weight_points()]).replace('&amp;','\\u0026').replace('<','\\u003c').replace('>','\\u003e')">
  <tal:v tal:replace="structure string:var _WP = ${wps_json};"/>
</script>
<script tal:condition="view/unit">
//<![CDATA[
// Set today's date
document.getElementById('vDate').valueAsDate = new Date();

function calcDev(input, idx) {
  var wp = _WP[idx];
  if (!wp) return;
  var nominal = wp[0], tol = wp[2];
  var actual = parseFloat(input.value);
  if (isNaN(actual)) {
    document.getElementById('dev_'+idx).textContent = '—';
    document.getElementById('pass_'+idx).textContent = '—';
    return;
  }
  var dev = actual - nominal;
  var pass = Math.abs(dev) <= tol;
  var devCell = document.getElementById('dev_'+idx);
  var passCell = document.getElementById('pass_'+idx);
  devCell.textContent = (dev >= 0 ? '+' : '') + dev.toFixed(6) + ' g';
  devCell.className = 'pfas-dev ' + (pass ? 'is-pass' : 'is-fail');
  passCell.innerHTML = pass
    ? '<span class="badge badge-ok">Pass</span>'
    : '<span class="badge badge-fail">Fail</span>';
}
//]]>
</script>
</tal:scripts>
</body>
</html>
