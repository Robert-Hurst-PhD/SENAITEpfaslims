<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Batch Status</title>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Batch Status</tal:t>
  <tal:r metal:fill-slot="header-right">
    <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-track">Client Tracker</a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <p class="pfas-lead">
      Real-time batch progress &#8212; stage is computed from SENAITE worksheet
      workflow state and the batch&#8217;s guided extraction. Batches are sorted newest first.
    </p>

    <div class="pfas-empty" tal:condition="not:view/batches">
      No worksheets found. Create a worksheet in SENAITE to begin tracking.
    </div>

    <div tal:condition="view/batches">

      <div class="pfas-card" tal:repeat="b view/batches">

        <div class="pfas-card-head">
          <span class="pfas-id" tal:content="b/batch_id">WS-001</span>
          <span class="pfas-muted" tal:content="b/method"></span>
          <span class="pfas-muted pfas-card-end" tal:content="b/created">2026-06-11</span>
        </div>

        <ol class="pfas-stepper pfas-stepper-compact">
          <li tal:repeat="step b/steps"
              tal:attributes="class string:is-${step/status}" tal:content="step/label">Received</li>
        </ol>

        <div class="pfas-meta-row">
          <span tal:attributes="class python:'badge badge-ok' if b['stage'] == 5 else ('badge badge-pending' if b['stage'] == 1 else 'badge badge-info')"
                tal:content="b/stage_label">Received</span>
          <span tal:condition="b/responsible">Responsible: <strong tal:content="b/responsible">Jane Smith</strong></span>
          <span tal:condition="b/sample_count">Samples: <strong tal:content="b/sample_count">18</strong></span>
          <span>WS state: <strong tal:content="b/ws_state">open</strong></span>
        </div>

        <div class="pfas-why" tal:condition="b/extraction_started">
          Extraction started:
          <strong tal:content="b/extraction_started">2026-06-11 09:14</strong>
          <tal:done tal:condition="b/extraction_completed">
            &mdash; completed:
            <strong tal:content="b/extraction_completed">2026-06-11 11:30</strong>
          </tal:done>
          <tal:inprog tal:condition="not:b/extraction_completed">
            &mdash; <em>in progress</em>
          </tal:inprog>
        </div>

        <details tal:condition="b/sample_ids">
          <summary class="pfas-summary-link" tal:content="string:Show ${b/sample_count} samples">
            Show samples
          </summary>
          <div class="pfas-mono pfas-muted">
            <tal:sid tal:repeat="sid b/sample_ids">
              <tal:content tal:content="sid">AR-001</tal:content><tal:comma tal:condition="not:repeat/sid/end">,  </tal:comma>
            </tal:sid>
          </div>
        </details>

        <!-- Stage-specific action buttons -->
        <div class="pfas-btn-row" tal:condition="python: b['stage'] in (4, 5)">
          <tal:stage4 tal:condition="python: b['stage'] == 4">
            <a class="btn-sm btn-primary"
               tal:attributes="href string:${view/portal_url}/@@pfas-control-chart?method=${b/method}">
              Charts &#8594;
            </a>
          </tal:stage4>
          <tal:stage5 tal:condition="python: b['stage'] == 5">
            <a class="btn-sm btn-success"
               tal:attributes="href string:${view/portal_url}/@@pfas-edd-batches?batch_id=${b/batch_id}">
              Export EDD &#8594;
            </a>
          </tal:stage5>
        </div>

      </div>

    </div>
  </div>
  </div><!-- /content slot -->
</body>
</html>
