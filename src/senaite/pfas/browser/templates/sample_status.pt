<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Worksheet status</title>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Worksheet status</tal:t>
  <tal:r metal:fill-slot="header-right">
    <a class="btn-sm btn-secondary" tal:attributes="href string:${view/portal_url}/@@pfas-track">Client Tracker</a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <p class="pfas-lead">
      Where each worksheet stands, from receipt to its published report, newest first.
      A client follows a sample on the Client Tracker.
    </p>

    <form method="get" class="pfas-filterbar" data-autosubmit="data-autosubmit"
          tal:attributes="action string:${view/portal_url}/@@pfas-sample-status">
      <input type="hidden" name="show" tal:attributes="value view/show" />
      <div class="pfas-form-field"><span>Show</span>
        <nav class="pfas-seg" aria-label="Show">
          <a class="pfas-seg-item" tal:repeat="o view/shows"
             tal:attributes="href o/url; aria-selected python:'true' if o['on'] else 'false'"
             tal:content="o/label">Not finished</a>
        </nav></div>
      <div class="pfas-form-field"><label for="ss-q">Worksheet</label>
        <input type="search" name="q" id="ss-q" class="pfas-input" placeholder="WS-001"
               tal:attributes="value view/q" /></div>
      <noscript><button type="submit" class="btn btn-primary">Filter</button></noscript>
    </form>

    <div class="pfas-empty" tal:condition="not:view/batches" tal:content="view/empty_text">None.</div>

    <div tal:condition="view/batches" tal:define="pg view/paging">

      <div class="pfas-card" tal:repeat="b view/batches">

        <div class="pfas-card-head">
          <span class="pfas-id" tal:content="b/batch_id">WS-001</span>
          <span class="pfas-muted" tal:content="b/method"></span>
          <span class="pfas-muted pfas-card-end" tal:content="b/created">2026-06-11</span>
        </div>

        <!-- each stage its own picture (icons.py): filled when done, outlined
             where the worksheet is, dashed to come; the stage's words beside it -->
        <ol class="pfas-stages" tal:define="ic context/@@pfas-icons">
          <li tal:repeat="step b/steps"
              tal:attributes="class string:is-${step/status}"><tal:m
              tal:replace="structure python:ic.stage(step['icon'], step['label'], step['status'], size='lg')" /><span
              class="pfas-stages-l" tal:content="step/label">Received</span></li>
        </ol>

        <div class="pfas-meta-row">
          <span tal:condition="b/responsible">Responsible: <strong tal:content="b/responsible">Jane Smith</strong></span>
          <span tal:condition="b/sample_count">Samples: <strong tal:content="b/sample_count">18</strong></span>
          <span>Worksheet state: <strong tal:content="b/ws_state_title">Open</strong></span>
        </div>

        <div class="pfas-why" tal:condition="b/extraction_started">
          Extraction started:
          <strong tal:content="b/extraction_started">2026-06-11 09:14</strong>
          <tal:done tal:condition="b/extraction_completed">
            &mdash; completed:
            <strong tal:content="b/extraction_completed">2026-06-11 11:30</strong>
          </tal:done>
          <tal:inprog tal:condition="not:b/extraction_completed">
            &mdash; <em>in progress</em>
          </tal:inprog>
        </div>

        <details tal:condition="b/sample_ids">
          <summary class="pfas-summary-link" tal:content="string:Show ${b/sample_count} samples">
            Show samples
          </summary>
          <div class="pfas-mono pfas-muted">
            <tal:sid tal:repeat="sid b/sample_ids">
              <tal:content tal:content="sid">AR-001</tal:content><tal:comma tal:condition="not:repeat/sid/end">,  </tal:comma>
            </tal:sid>
          </div>
        </details>

        <!-- Stage-specific action buttons -->
        <div class="pfas-btn-row" tal:condition="python: b['stage'] in (4, 5)">
          <tal:stage4 tal:condition="python: b['stage'] == 4">
            <a class="btn-sm btn-primary"
               tal:attributes="href string:${view/portal_url}/@@pfas-control-chart?method=${b/method}">
              Charts &#8594;
            </a>
          </tal:stage4>
          <tal:stage5 tal:condition="python: b['stage'] == 5">
            <a class="btn-sm btn-success"
               tal:attributes="href string:${view/portal_url}/@@pfas-edd-batches?batch_id=${b/batch_id}">
              Export EDD &#8594;
            </a>
          </tal:stage5>
        </div>

      </div>

      <metal:p use-macro="context/@@pfas-macros/macros/paging" />
    </div>
  </div>
  </div><!-- /content slot -->
</body>
</html>
