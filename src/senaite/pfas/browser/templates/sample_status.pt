<!DOCTYPE html>
<html metal:use-macro="context/@@pfas-macros/macros/page"
      xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
  <title metal:fill-slot="title">Batch Status</title>
  <tal:styles metal:fill-slot="head-extra">
  <style>
    /* ── Batch status page-specific ────────────────────────────────────── */
    .lead { color: var(--s-secondary); margin-bottom: 20px; font-size: 13px; }

    .batches { display: flex; flex-direction: column; gap: 16px; }

    .batch-card { background: var(--s-bg); border-radius: 8px;
                  border: 1px solid var(--s-border);
                  box-shadow: 0 1px 4px rgba(0,0,0,.08); overflow: hidden; }

    .batch-header { padding: 10px 18px; background: var(--s-light);
                    border-bottom: 1px solid var(--s-border);
                    display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .batch-id  { font-family: monospace; font-size: 13px; color: var(--s-primary);
                 background: var(--s-primary-lt); padding: 2px 8px; border-radius: 3px;
                 font-weight: 700; }
    .batch-method { font-size: 12px; color: var(--s-secondary); }
    .batch-date { font-size: 12px; color: var(--s-secondary); margin-left: auto; }

    .batch-body { padding: 14px 18px; }

    .progress-steps { display: flex; align-items: flex-start; margin-bottom: 14px; position: relative; }
    .step { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; }
    .step:not(:last-child)::after {
      content: ""; position: absolute; top: 13px; left: 50%; right: -50%;
      height: 2px; background: var(--s-border); z-index: 0;
    }
    .step.done::after { background: var(--s-primary); }
    .step-dot { width: 28px; height: 28px; border-radius: 50%;
                border: 2px solid var(--s-border); background: var(--s-bg);
                display: flex; align-items: center; justify-content: center;
                font-size: 11px; font-weight: 700; color: var(--s-secondary);
                position: relative; z-index: 1; }
    .step.done    .step-dot { background: var(--s-primary); border-color: var(--s-primary); color: #fff; }
    .step.current .step-dot { background: var(--s-bg); border-color: var(--s-primary);
                               color: var(--s-primary);
                               box-shadow: 0 0 0 4px var(--s-focus-ring); }
    .step-label { font-size: 10px; color: var(--s-secondary); text-align: center;
                  margin-top: 5px; line-height: 1.3; padding: 0 2px; }
    .step.done    .step-label { color: var(--s-primary); }
    .step.current .step-label { color: var(--s-primary); font-weight: 700; }

    .batch-meta { display: flex; gap: 24px; flex-wrap: wrap; font-size: 12px;
                  color: var(--s-secondary); margin-bottom: 8px; }
    .meta-item strong { color: var(--s-body); }

    .stage-badge { display: inline-block; font-size: 11px; font-weight: 700;
                   padding: 2px 9px; border-radius: 10px; text-transform: uppercase;
                   letter-spacing: .03em; }
    .stage-1 { background: var(--s-primary-lt); color: var(--s-primary); }
    .stage-2 { background: #fff3cd; color: #856404; }
    .stage-3 { background: #f8d7da; color: #721c24; }
    .stage-4 { background: #f3e5f5; color: #6a1b9a; }
    .stage-5 { background: #d4edda; color: #155724; }

    details { margin-top: 6px; }
    summary { cursor: pointer; font-size: 11px; color: var(--s-primary);
              user-select: none; outline: none; list-style: none; }
    summary::-webkit-details-marker { display: none; }
    summary::before { content: "\25B6 "; font-size: 9px; }
    details[open] summary::before { content: "\25BC "; }
    .sample-list { margin-top: 6px; font-family: monospace; font-size: 11px;
                   color: var(--s-secondary); line-height: 1.8; padding-left: 4px; }

    .extraction-info { margin-top: 6px; font-size: 11px; color: var(--s-secondary);
                       background: var(--s-light); border: 1px solid var(--s-border);
                       border-radius: 4px; padding: 6px 10px; display: inline-block; }

    .empty-state { text-align: center; color: var(--s-secondary); padding: 48px 0; font-size: 13px; }

    /* ── Mobile ─────────────────────────────────────────────────────── */
    @media (max-width: 600px) {
      .batch-body { padding: 10px 12px; }
      .batch-header { padding: 8px 12px; }
      /* Stepper: smaller dots, hide labels, show only current */
      .step-dot { width: 22px; height: 22px; font-size: 10px; }
      .step-label { font-size: 9px; }
      .step:not(:last-child)::after { top: 11px; }
      /* Meta info: smaller gaps */
      .batch-meta { gap: 12px; }
      /* Extraction info: wrap */
      .extraction-info { display: block; font-size: 10px; }
    }
  </style>
  </tal:styles>
</head>
<body>
  <tal:t metal:fill-slot="header-title">Batch Status</tal:t>
  <tal:r metal:fill-slot="header-right">
    <a class="back-link" tal:attributes="href string:${view/portal_url}/@@pfas-track">
      Client Tracker
    </a>
  </tal:r>

  <div metal:fill-slot="content">
  <div class="page-body">

    <p class="lead">
      Real-time batch progress &#8212; stage is computed from SENAITE worksheet
      workflow state and extraction logs. Batches are sorted newest first.
    </p>

    <div class="empty-state" tal:condition="not:view/batches">
      No worksheets found. Create a worksheet in SENAITE to begin tracking.
    </div>

    <div class="batches" tal:condition="view/batches">

      <div class="batch-card" tal:repeat="b view/batches">

        <div class="batch-header">
          <span class="batch-id"     tal:content="b/batch_id">WS-001</span>
          <span class="batch-method" tal:content="b/method"></span>
          <span class="batch-date"   tal:content="b/created">2026-06-11</span>
        </div>

        <div class="batch-body">

          <div class="progress-steps">
            <div tal:repeat="step b/steps"
                 tal:attributes="class string:step ${step/status}">
              <div class="step-dot" tal:content="step/num">1</div>
              <div class="step-label" tal:content="step/label">Received</div>
            </div>
          </div>

          <div class="batch-meta">

            <div class="meta-item">
              <span tal:attributes="class string:stage-badge stage-${b/stage}"
                    tal:content="b/stage_label">Received</span>
            </div>

            <div class="meta-item" tal:condition="b/responsible">
              Responsible: <strong tal:content="b/responsible">Jane Smith</strong>
            </div>

            <div class="meta-item" tal:condition="b/sample_count">
              Samples: <strong tal:content="b/sample_count">18</strong>
            </div>

            <div class="meta-item">
              WS state: <strong tal:content="b/ws_state">open</strong>
            </div>

          </div>

          <div class="extraction-info" tal:condition="b/extraction_started">
            Extraction started:
            <strong tal:content="b/extraction_started">2026-06-11 09:14</strong>
            <tal:done tal:condition="b/extraction_completed">
              &mdash; completed:
              <strong tal:content="b/extraction_completed">2026-06-11 11:30</strong>
            </tal:done>
            <tal:inprog tal:condition="not:b/extraction_completed">
              &mdash; <em>in progress</em>
            </tal:inprog>
          </div>

          <details tal:condition="b/sample_ids">
            <summary tal:content="string:Show ${b/sample_count} samples">
              Show samples
            </summary>
            <div class="sample-list">
              <tal:sid tal:repeat="sid b/sample_ids">
                <tal:content tal:content="sid">AR-001</tal:content><tal:comma tal:condition="not:repeat/sid/end">,  </tal:comma>
              </tal:sid>
            </div>
          </details>

          <!-- Stage-specific action links -->
          <div class="batch-actions" tal:condition="python: b['stage'] in (4, 5)"
               style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap;">
            <tal:stage4 tal:condition="python: b['stage'] == 4">
              <a class="btn-sm"
                 tal:attributes="href string:${view/portal_url}/@@pfas-control-chart?method=${b/method}"
                 style="display:inline-block; padding:4px 10px; font-size:11px;
                        font-weight:600; border-radius:4px; text-decoration:none;
                        background:var(--s-primary-lt); color:var(--s-primary);">
                Charts &#8594;
              </a>
            </tal:stage4>
            <tal:stage5 tal:condition="python: b['stage'] == 5">
              <a class="btn-sm"
                 tal:attributes="href string:${view/portal_url}/@@pfas-egad-batches?batch_id=${b/batch_id}"
                 style="display:inline-block; padding:4px 10px; font-size:11px;
                        font-weight:600; border-radius:4px; text-decoration:none;
                        background:#d4edda; color:#155724;">
                Export EDD &#8594;
              </a>
            </tal:stage5>
          </div>

        </div>
      </div>

    </div>
  </div>
  </div><!-- /content slot -->
</body>
</html>
