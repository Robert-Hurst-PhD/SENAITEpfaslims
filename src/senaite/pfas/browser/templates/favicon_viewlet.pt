<tal:favicon define="portal_url view/site_url">
    <link rel="shortcut icon" type="image/x-icon" tal:attributes="href string:$portal_url/++resource++senaite.pfas/favicon.ico" />
    <link rel="apple-touch-icon" tal:attributes="href string:$portal_url/++resource++senaite.pfas/favicon-180.png" />
</tal:favicon>
