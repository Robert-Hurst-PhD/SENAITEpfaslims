<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal">
<!--
  Standalone label page — no PFAS METAL macro (this page IS the printed output).
  Open in a popup; analyst presses Ctrl+P to print to label printer.
-->
<head>
  <meta charset="utf-8" />
  <title tal:content="string:Label: ${view/name}">Label</title>
  <style>
    /* ── Screen UI (hidden when printing) ─────────────────── */
    @media screen {
      body { font-family: Arial, sans-serif; background: #f0f0f0;
             margin: 0; padding: 16px; }
      .screen-ui { background: #fff; border-radius: 10px; padding: 16px;
                   max-width: 500px; margin: 0 auto 20px; box-shadow: 0 2px 8px rgba(0,0,0,.15); }
      .screen-ui h2 { font-size: 15px; margin: 0 0 12px; color: #1a1a2e; }
      .size-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 10px; }
      .size-row label { font-size: 13px; font-weight: 600; }
      .size-row select { padding: 6px 8px; font-size: 13px; border: 1px solid #ccc;
                         border-radius: 5px; }
      .custom-size { display: none; gap: 8px; align-items: center; font-size: 13px; }
      .custom-size input { width: 70px; padding: 5px 8px; border: 1px solid #ccc;
                           border-radius: 5px; font-size: 13px; }
      .btn-print { padding: 10px 24px; background: #1a73e8; color: #fff;
                   border: none; border-radius: 7px; font-size: 14px;
                   font-weight: 700; cursor: pointer; }
      .btn-print:hover { background: #1557b0; }
      .btn-back  { padding: 10px 18px; background: #f0f0f0; color: #333;
                   border: 1px solid #ccc; border-radius: 7px; font-size: 13px;
                   cursor: pointer; text-decoration: none; display: inline-block; }
      .preview-label { margin: 16px auto; border: 2px dashed #ccc; border-radius: 4px;
                       background: #fff; box-sizing: border-box; }
    }

    /* ── Label body (both screen and print) ────────────────── */
    .label-body { display: none; } /* hidden until size is chosen */

    @media print {
      .screen-ui { display: none !important; }
      body { margin: 0; padding: 0; background: #fff; }
      .label-body { display: block !important; }
    }

    /* ── Label content styles ──────────────────────────────── */
    .label-wrap { width: 100%; height: 100%; padding: 4mm; box-sizing: border-box;
                  font-family: Arial, Helvetica, sans-serif; overflow: hidden;
                  display: flex; flex-direction: column; justify-content: space-between; }
    .label-name  { font-size: 12pt; font-weight: 800; color: #000;
                   border-bottom: 1pt solid #000; margin-bottom: 2mm; padding-bottom: 1mm;
                   line-height: 1.2; }
    .label-name.small { font-size: 9pt; }
    .label-row   { display: flex; justify-content: space-between; align-items: center;
                   margin-bottom: 1mm; }
    .label-kv    { font-size: 7.5pt; color: #000; }
    .label-kv b  { font-size: 8pt; }
    .label-lot   { font-size: 9pt; font-weight: 700; color: #000; }
    .label-exp   { font-size: 8pt; font-weight: 700; }
    .label-exp.warn   { color: #7a5c00; }
    .label-exp.danger { color: #9b1c1c; }
    .label-barcode-wrap { margin: 1mm 0; text-align: center; }
    .label-barcode-wrap svg { max-width: 100%; height: auto; }
    .label-footer { font-size: 6pt; color: #555; border-top: 0.5pt solid #ccc;
                    padding-top: 1mm; }
    .label-storage { font-size: 7pt; font-weight: 700; background: #000; color: #fff;
                     padding: 0 2mm; border-radius: 1mm; display: inline-block; }
    /* Large-format extras */
    .label-big .label-name { font-size: 16pt; }
    .label-big .label-kv   { font-size: 9pt; }
    .label-big .label-lot  { font-size: 12pt; }
    /* A designed label (Document Templates) is a PDF made here */
    .label-pdf { display: block; width: 100%; height: 260px; border: 1px solid #ccc;
                 border-radius: 4px; margin-top: 12px; background: #fff; }
    [hidden] { display: none !important; }
  </style>
</head>
<body>

  <!-- ── Screen UI ─────────────────────────────────────────────── -->
  <div class="screen-ui">
    <h2>&#127991; Print Reagent Label</h2>

    <div class="size-row" tal:condition="view/designed">
      <label for="layout-sel">Layout:</label>
      <select id="layout-sel" onchange="chooseLayout()">
        <option tal:repeat="d view/designed" tal:attributes="value d/id"
                tal:content="python: u'%s (rev %s, %s)' % (d['title'], d['rev'], d['size'])">Vial label</option>
        <option value="">Built-in layout</option>
      </select>
    </div>

    <div id="builtin-ui">
    <div class="size-row">
      <label for="size-sel">Label size:</label>
      <select id="size-sel" onchange="applySize()">
        <tal:opts tal:repeat="size view/label_sizes">
          <option tal:attributes="value python:size[0];
                                  selected python:view.label_size()==size[0]"
                  tal:content="python:size[1]"></option>
        </tal:opts>
      </select>
    </div>

    <div class="custom-size" id="custom-row">
      <label>W:</label>
      <input type="number" id="custom-w" value="50" min="10" max="300" step="1" />
      <span>mm &nbsp; H:</span>
      <input type="number" id="custom-h" value="25" min="10" max="300" step="1" />
      <span>mm</span>
      <button onclick="applySize()" style="padding:4px 10px;font-size:12px;
              border:1px solid #1a73e8;color:#1a73e8;background:#fff;
              border-radius:5px;cursor:pointer;">Apply</button>
    </div>
    </div>

    <div style="margin-top:10px;display:flex;gap:10px;flex-wrap:wrap;">
      <button class="btn-print" onclick="printLabel()">&#128424; Print Label</button>
      <a class="btn-back" id="open-pdf" target="_blank" hidden="hidden"
         title="Open the label PDF; print it at actual size with no margins">Open PDF</a>
      <a class="btn-back"
         tal:attributes="href view/back_url">&#8592; Back</a>
    </div>

    <!-- Screen preview (just shows the label at scale) -->
    <div class="preview-label" id="preview-frame" style="max-height:200px;overflow:hidden;">
    </div>
    <iframe id="label-pdf" class="label-pdf" title="Label" hidden="hidden"></iframe>
  </div>

  <!-- ── Printable label (shown on print, hidden on screen until rendered) ── -->
  <div class="label-body" id="label-body">
    <div class="label-wrap" id="label-wrap">

      <div class="label-name" id="label-name-el"
           tal:content="view/name">Reagent Name</div>

      <div class="label-row">
        <span class="label-lot">Lot: <tal:v tal:replace="view/lot">—</tal:v></span>
        <span class="label-storage"
              tal:content="view/storage">-20°C</span>
      </div>

      <tal:conc tal:condition="view/conc">
      <div class="label-kv">
        <b>Conc:</b> <tal:v tal:replace="view/conc" />
        <tal:vol tal:condition="view/vol">
          &nbsp;&nbsp;<b>Vol:</b> <tal:v tal:replace="view/vol" />
        </tal:vol>
      </div>
      </tal:conc>

      <div class="label-barcode-wrap" id="barcode-wrap"></div>

      <div class="label-row" style="flex-wrap:wrap;gap:4mm;">
        <span class="label-kv" tal:condition="view/prep_date">
          <b>Prep:</b> <tal:v tal:replace="view/prep_date" />
        </span>
        <span class="label-kv" id="exp-el"
              tal:condition="view/exp">
          <b>Exp:</b> <tal:v tal:replace="view/exp" />
        </span>
        <span class="label-kv" tal:condition="view/analyst">
          <b>By:</b> <tal:v tal:replace="view/analyst" />
        </span>
        <span class="label-kv" tal:condition="view/method">
          <b>Method:</b> <tal:v tal:replace="view/method" />
        </span>
      </div>

      <div class="label-footer">
        Laboratory &mdash; generated by LIMS
      </div>

    </div>
  </div>

  <script>
  var SIZES = <tal:s tal:replace="structure view/size_dict_json" />;

  var LOT = <tal:l tal:replace="structure python: view.js(view.lot())" />;
  var EXP = <tal:e tal:replace="structure python: view.js(view.exp())" />;
  var NAME_LEN = <tal:n tal:replace="python:len(view.name())" />;

  /* ── Expiry colour ─────────────────────────────────────────── */
  function colorExp() {
    var el = document.getElementById('exp-el');
    if (!el || !EXP) return;
    var d = new Date(EXP);
    var now = new Date();
    if (d < now) {
      el.className = 'label-kv label-exp danger';
    } else if ((d - now) < 30 * 24 * 3600 * 1000) {
      el.className = 'label-kv label-exp warn';
    }
  }

  /* ── Barcode rendering (JsBarcode) ─────────────────────────── */
  function renderBarcode() {
    if (!LOT || typeof JsBarcode === 'undefined') return;
    var wrap = document.getElementById('barcode-wrap');
    wrap.innerHTML = '<svg id="bc"></svg>';
    try {
      JsBarcode('#bc', LOT, {
        format:       'CODE128',
        width:        1.5,
        height:       28,
        displayValue: true,
        fontSize:     9,
        margin:       2,
      });
    } catch(e) {
      wrap.innerHTML = '';
    }
  }

  /* ── Label name sizing ─────────────────────────────────────── */
  function setNameSize() {
    var el = document.getElementById('label-name-el');
    if (!el) return;
    if (NAME_LEN > 40) el.className = 'label-name small';
  }

  /* ── Apply size to DOM ─────────────────────────────────────── */
  function applySize() {
    var sel = document.getElementById('size-sel');
    var sid = sel ? sel.value : '2x1';
    var custom = document.getElementById('custom-row');
    if (sid === 'custom') {
      custom.style.display = 'flex';
    } else {
      custom.style.display = 'none';
    }

    var w_mm, h_mm;
    if (sid === 'custom') {
      w_mm = parseFloat(document.getElementById('custom-w').value) || 50;
      h_mm = parseFloat(document.getElementById('custom-h').value) || 25;
    } else {
      var s = SIZES[sid];
      w_mm = s ? s.w : 50.8;
      h_mm = s ? s.h : 25.4;
    }

    /* Apply @page size for print */
    var styleId = 'page-size-style';
    var existing = document.getElementById(styleId);
    if (existing) existing.remove();
    var style = document.createElement('style');
    style.id = styleId;
    var isFullPage = (h_mm > 200);
    if (isFullPage) {
      style.textContent =
        '@page { size: ' + w_mm + 'mm ' + h_mm + 'mm; margin: 10mm; }' +
        '#label-wrap { padding: 8mm; }' +
        '.label-name { font-size: 20pt; }' +
        '.label-kv { font-size: 11pt; }';
    } else {
      style.textContent =
        '@page { size: ' + w_mm + 'mm ' + h_mm + 'mm; margin: 0; }';
    }
    document.head.appendChild(style);

    /* Screen preview: scale to fit the preview frame */
    var body = document.getElementById('label-body');
    var wrap = document.getElementById('label-wrap');
    if (wrap) {
      wrap.style.width  = w_mm + 'mm';
      wrap.style.height = h_mm + 'mm';
    }

    var frame = document.getElementById('preview-frame');
    if (frame) {
      frame.style.width  = (w_mm * 2) + 'px';  /* rough screen px */
      frame.style.height = (h_mm * 2) + 'px';
      frame.innerHTML = '';
      var clone = body.cloneNode(true);
      clone.style.display = 'block';
      clone.style.transform = 'scale(0.7)';
      clone.style.transformOrigin = 'top left';
      frame.appendChild(clone);
    }

    body.style.display = 'block';
    renderBarcode();
  }

  /* ── Designed layouts (Document Templates, issued revisions) ── */
  var DESIGNED = <tal:d tal:replace="structure view/designed_json" />;

  function activeDesigned() {
    var sel = document.getElementById('layout-sel');
    if (!sel || !sel.value) return null;
    for (var i = 0; i < DESIGNED.length; i++) {
      if (DESIGNED[i].id === sel.value) return DESIGNED[i];
    }
    return null;
  }

  /* The layout to start with: the one this browser chose last; else a
     designed label of the size the caller asked for (the extraction guide
     asks for one); else, when a size was asked for and none is designed in
     it, the built-in layout; else the first designed label. */
  var REQ_SIZE = <tal:s tal:replace="structure python: view.js(view.requested_size())" />;
  function startLayout(sel) {
    var saved = null;
    try { saved = localStorage.getItem('pfas.label.layout'); } catch (e) {}
    var ids = [];
    for (var i = 0; i < sel.options.length; i++) ids.push(sel.options[i].value);
    if (saved !== null && ids.indexOf(saved) >= 0) return saved;
    if (REQ_SIZE) {
      for (var j = 0; j < DESIGNED.length; j++) {
        if (DESIGNED[j].size_id === REQ_SIZE) return DESIGNED[j].id;
      }
      return '';
    }
    return ids[0];
  }

  function chooseLayout() {
    var sel = document.getElementById('layout-sel');
    try { localStorage.setItem('pfas.label.layout', sel.value); } catch (e) {}
    applyLayout();
  }

  function applyLayout() {
    var d = activeDesigned();
    var sel = document.getElementById('layout-sel');
    document.getElementById('builtin-ui').hidden = !!d;
    document.getElementById('open-pdf').hidden = true;
    document.getElementById('preview-frame').hidden = !!d;
    document.getElementById('label-body').hidden = !!d;
    var frame = document.getElementById('label-pdf');
    frame.hidden = !d;
    if (!d) { applySize(); return; }
    window.PFASPdfme.generate({ template: d.template, inputs: [d.inputs], plugins: window.PFASPdfme.plugins })
      .then(function (pdf) {
        if (frame.dataset.url) URL.revokeObjectURL(frame.dataset.url);
        frame.dataset.url = URL.createObjectURL(new Blob([pdf.buffer], { type: 'application/pdf' }));
        frame.src = frame.dataset.url;
        var open = document.getElementById('open-pdf');
        open.href = frame.dataset.url;
        open.hidden = false;
      }, function (e) {
        frame.hidden = true;
        alertNote('This layout could not be drawn (' + (e && e.message || e) + '); using the built-in layout.');
        if (sel) sel.value = '';
        applyLayout();
      });
  }

  function alertNote(text) {
    var p = document.createElement('p');
    p.textContent = text;
    document.querySelector('.screen-ui').appendChild(p);
  }

  function printLabel() {
    var frame = document.getElementById('label-pdf');
    if (activeDesigned() && frame.src) {
      frame.contentWindow.focus();
      frame.contentWindow.print();
    } else {
      window.print();
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    colorExp();
    setNameSize();
    applySize();
    var sel = document.getElementById('layout-sel');
    if (sel) {
      sel.value = startLayout(sel);
      applyLayout();
    }
  });
  </script>

  <script tal:condition="view/designed"
          tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/vendor/pdfme/pdfme.min.js"></script>

  <!-- JsBarcode (MIT, static/vendor) for CODE128 rendering -->
  <script tal:attributes="src string:${view/portal_url}/++resource++senaite.pfas/vendor/JsBarcode-3.11.5.all.min.js"></script>

</body>
</html>
