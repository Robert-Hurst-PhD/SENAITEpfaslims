  <symbol id="ico-analyser" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2"/><rect x="6" y="7" width="7" height="5" rx="1"/><path d="M16 8h2"/><path d="M16 11h2"/><path d="M7 16v4"/><path d="M17 16v4"/><path d="M5 20h14"/></symbol>
