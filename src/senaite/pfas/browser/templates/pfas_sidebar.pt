        </a>
      </div>
    </div>

  </div><!-- /pfas-sb-scroll -->

  <!-- Collapse toggle at bottom -->
  <div class="pfas-sb-foot">
    <button class="pfas-sb-collapse-btn" type="button"
            onclick="pfasSidebarCollapseToggle()"
            title="Collapse sidebar">
      <span class="pfas-sb-collapse-arrow">&#8249;</span>
    </button>
  </div>

<script>
(function () {
  var SB_STATE_KEY = 'pfas_sb_groups';

  function restoreGroups() {
    var raw;
    try { raw = sessionStorage.getItem(SB_STATE_KEY); } catch (e) {}
    if (!raw) return;
    var closed;
    try { closed = JSON.parse(raw); } catch (e) { return; }
    if (!Array.isArray(closed)) return;
    for (var i = 0; i < closed.length; i++) {
      var el = document.getElementById(closed[i]);
      if (el) el.classList.add('sg-closed');
    }
  }

  function saveGroups() {
    var closed = [];
    document.querySelectorAll('.pfas-sg.sg-closed').forEach(function (el) {
      if (el.id) closed.push(el.id);
    });
    try { sessionStorage.setItem(SB_STATE_KEY, JSON.stringify(closed)); } catch (e) {}
  }

  window.pfasSgToggle = function (groupId) {
    var el = document.getElementById(groupId);
    if (!el) return;
    el.classList.toggle('sg-closed');
    saveGroups();
  };

  /* pfasSidebarCollapseToggle: collapse the sidebar.
     On PFAS workspace pages, toggles .panel-collapsed on #pfas-shell.
     On core SENAITE pages (no #pfas-shell), toggles .toggled on #sidebar. */
  window.pfasSidebarCollapseToggle = function () {
    var shell = document.getElementById('pfas-shell');
    if (shell) {
      var collapsed = shell.classList.toggle('panel-collapsed');
      try { sessionStorage.setItem('pfas_panel_collapsed', collapsed ? '1' : '0'); } catch (e) {}
    } else {
      var sb = document.getElementById('sidebar');
      if (sb) sb.classList.toggle('toggled');
    }
  };

  restoreGroups();
})();
</script>

</nav>
