    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
          fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <line x1="12" y1="9" x2="12" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <line x1="12" y1="17" x2="12.01" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </symbol>

  <!-- Pin (sidebar pins) -->
  <symbol id="ico-pin" viewBox="0 0 24 24">
    <path d="M9 3h6l-1 6 4 4H6l4-4z"/>
    <line x1="12" y1="13" x2="12" y2="21"/>
  </symbol>

  <!-- Collapse arrow -->
  <symbol id="ico-chevron-left" viewBox="0 0 24 24">
    <polyline points="15 18 9 12 15 6"/>
  </symbol>

</svg>

  <!-- ── Dashboard, then the user's own pins (Windows-Explorer style). Pins
       are filled by the script from data-pins: each is a copy of the user's
       own sidebar link for that path (sidebar_pins.py). ────────────────── -->
  <div class="pfas-sb-pin">
    <a class="pfas-sb-dash" title="Dashboard"
       tal:attributes="href string:${purl}/@@pfas-home;
                       class python:'pfas-sb-dash si-active' if path.rstrip('/').endswith('/senaite') else 'pfas-sb-dash'">
      <span class="pfas-si-icon"><svg><use href="#ico-home"/></svg></span>
      <span class="pfas-sb-dash-label">Dashboard</span>
    </a>
    <div class="pfas-sb-pinned" id="pfas-sb-pinned"></div>
  </div>

  <div class="pfas-sb-scroll">

    <!-- ── OPERATIONS (all staff roles) ────────────────────────────────── -->
    <div class="pfas-sg" id="pfas-sg-operations"
         tal:condition="python:is_mgr or is_ana or is_clk">
      <button class="pfas-sg-head" type="button"
              onclick="pfasSgToggle('pfas-sg-operations')">
        <span class="pfas-sg-label">Operations</span>
        <span class="pfas-sg-arrow">&#9660;</span>
      </button>
      <div class="pfas-sg-items">
        <a class="pfas-si" title="Clients"
           tal:attributes="href string:${purl}/clients;
                           class python:'pfas-si si-active' if '/clients' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-clients"/></svg></span>
          <span class="pfas-si-label">Clients</span>
        </a>
        <a class="pfas-si" title="Samples"
           tal:attributes="href string:${purl}/samples;
                           class python:'pfas-si si-active' if '/samples' in path and '@@' not in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-samples"/></svg></span>
          <span class="pfas-si-label">Samples</span>
        </a>
        <a class="pfas-si" title="Batches"
           tal:attributes="href string:${purl}/batches;
                           class python:'pfas-si si-active' if '/batches' in path and '@@' not in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-batches"/></svg></span>
          <span class="pfas-si-label">Batches</span>
        </a>
        <a class="pfas-si" title="Worksheets"
           tal:attributes="href string:${purl}/worksheets;
                           class python:'pfas-si si-active' if '/worksheets' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-worksheets"/></svg></span>
          <span class="pfas-si-label">Worksheets</span>
        </a>
        <a class="pfas-si" title="Chain of custody: samples entered by samplers, received by the lab"
           tal:attributes="href string:${purl}/@@pfas-coc;
                           class python:'pfas-si si-active' if '@@pfas-coc' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-tracker"/></svg></span>
          <span class="pfas-si-label">Chain of Custody</span>
        </a>
        <a class="pfas-si" title="Sample Tracker"
           tal:attributes="href string:${purl}/@@pfas-track;
                           class python:'pfas-si si-active' if '@@pfas-track' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-tracker"/></svg></span>
          <span class="pfas-si-label">Sample Tracker</span>
        </a>
        <a class="pfas-si" title="Projects"
           tal:attributes="href string:${purl}/@@pfas-projects;
                           class python:'pfas-si si-active' if '@@pfas-projects' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-project"/></svg></span>
          <span class="pfas-si-label">Projects</span>
        </a>
      </div>
    </div>

    <!-- ── QC &amp; METHODS (Manager + Analyst) ──────────────────────────── -->
    <div class="pfas-sg" id="pfas-sg-qc"
         tal:condition="python:is_mgr or is_ana">
      <button class="pfas-sg-head" type="button"
              onclick="pfasSgToggle('pfas-sg-qc')">
        <span class="pfas-sg-label">QC &amp; Methods</span>
        <span class="pfas-sg-arrow">&#9660;</span>
      </button>
      <div class="pfas-sg-items">
        <a class="pfas-si" title="Data Review"
           tal:attributes="href string:${purl}/@@pfas-data-review;
                           class python:'pfas-si si-active' if '@@pfas-data-review' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-data-review"/></svg></span>
          <span class="pfas-si-label">Data Review</span>
        </a>
        <a class="pfas-si" title="Method Profiles &amp; QC Rules — per-method configuration console"
           tal:condition="is_mgr"
           tal:attributes="href string:${purl}/@@pfas-method-profiles;
                           class python:'pfas-si si-active' if ('@@pfas-method-profile' in path or '@@pfas-qc-rules' in path) else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-method-profiles"/></svg></span>
          <span class="pfas-si-label">Method Profiles &amp; QC</span>
        </a>
        <a class="pfas-si" title="Control Charts"
           tal:attributes="href string:${purl}/@@pfas-control-chart;
                           class python:'pfas-si si-active' if '@@pfas-control-chart' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-control-charts"/></svg></span>
          <span class="pfas-si-label">Control Charts</span>
        </a>
        <a class="pfas-si" title="Blanks over time, and the lots behind a change in background"
           tal:attributes="href string:${purl}/@@pfas-blank-history;
                           class python:'pfas-si si-active' if '@@pfas-blank-history' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-control-charts"/></svg></span>
          <span class="pfas-si-label">Blank History</span>
        </a>
        <a class="pfas-si" title="MDL, MRL confirmation, precision and accuracy studies"
           tal:attributes="href string:${purl}/@@pfas-method-studies;
                           class python:'pfas-si si-active' if '@@pfas-method-studies' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-control-charts"/></svg></span>
          <span class="pfas-si-label">Method Studies</span>
        </a>
      </div>
    </div>

    <!-- ── BENCH (all staff roles) ─────────────────────────────────────── -->
    <div class="pfas-sg" id="pfas-sg-bench"
         tal:condition="python:is_mgr or is_ana or is_clk">
      <button class="pfas-sg-head" type="button"
              onclick="pfasSgToggle('pfas-sg-bench')">
        <span class="pfas-sg-label">Bench</span>
        <span class="pfas-sg-arrow">&#9660;</span>
      </button>
      <div class="pfas-sg-items">
        <a class="pfas-si" title="Reagent Inventory"
           tal:attributes="href string:${purl}/@@pfas-reagents;
                           class python:'pfas-si si-active' if ('@@pfas-reagents' in path or '@@pfas-lot-usage' in path or '@@pfas-assigned-levels' in path) else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-reagents"/></svg></span>
          <span class="pfas-si-label">Reagent Inventory</span>
        </a>
        <a class="pfas-si" title="Prepared Standards"
