<nav id="sidebar" class="pfas-nav"
     tal:define="purl view/portal_url;
                 nav  view/nav;
                 me   python:context.portal_membership.getAuthenticatedMember().getId() or ''"
     aria-label="Main navigation"
     tal:attributes="data-section nav/section; data-user me;
                     data-pins python:view.pins_json(nav);
                     data-pins-url string:${purl}/@@pfas-sidebar-pins;
                     data-portal purl;
                     data-token context/@@authenticator/token">
<!-- The rail and the section panel, drawn from the map (page_groups.nav_model):
     who sees a section, what it holds, its label and its icon all come from
     there, and this template decides none of them. The rail is Home and the
     person's sections; the panel holds one tree per rail button, the current
     section's shown. A row is the navigation tree's (pfas-components.css):
     the treeitem is the row link; a row with children owns its group. -->

<!-- SVG icon sprite (Lucide, MIT) -->
<svg xmlns="http://www.w3.org/2000/svg" class="pfas-sprite" aria-hidden="true">

  <!-- Operations -->
  <symbol id="ico-clients" viewBox="0 0 24 24">
    <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/>
    <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/>
    <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/>
    <path d="M10 6h4"/><path d="M10 10h4"/>
    <path d="M10 14h4"/><path d="M10 18h4"/>
  </symbol>

  <symbol id="ico-samples" viewBox="0 0 24 24">
    <path d="M9 2v17.5A2.5 2.5 0 0 1 6.5 22 2.5 2.5 0 0 1 4 19.5V2"/>
    <path d="M15 2v17.5a2.5 2.5 0 0 0 2.5 2.5 2.5 2.5 0 0 0 2.5-2.5V2"/>
    <path d="M3 2h7"/><path d="M14 2h7"/>
    <path d="M4 9h5"/><path d="M15 9h5"/>
  </symbol>

  <symbol id="ico-batches" viewBox="0 0 24 24">
    <path d="M12 2 2 7l10 5 10-5z"/>
    <path d="M2 17l10 5 10-5"/>
    <path d="M2 12l10 5 10-5"/>
  </symbol>

  <symbol id="ico-worksheets" viewBox="0 0 24 24">
    <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
    <path d="M12 11h4"/><path d="M12 15h4"/>
    <path d="M8 11h.01"/><path d="M8 15h.01"/>
  </symbol>

  <symbol id="ico-tracker" viewBox="0 0 24 24">
    <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/>
    <circle cx="12" cy="10" r="3"/>
  </symbol>

  <symbol id="ico-project" viewBox="0 0 24 24">
    <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>
  </symbol>

  <!-- QC and Methods -->
  <symbol id="ico-method-profiles" viewBox="0 0 24 24">
    <line x1="21" x2="14" y1="4" y2="4"/>
    <line x1="10" x2="3" y1="4" y2="4"/>
    <line x1="21" x2="12" y1="12" y2="12"/>
    <line x1="8" x2="3" y1="12" y2="12"/>
    <line x1="21" x2="16" y1="20" y2="20"/>
    <line x1="12" x2="3" y1="20" y2="20"/>
    <line x1="14" x2="14" y1="2" y2="6"/>
    <line x1="8" x2="8" y1="10" y2="14"/>
    <line x1="16" x2="16" y1="18" y2="22"/>
  </symbol>

  <symbol id="ico-qc-rules" viewBox="0 0 24 24">
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
    <path d="m9 12 2 2 4-4"/>
  </symbol>

  <symbol id="ico-control-charts" viewBox="0 0 24 24">
    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
    <polyline points="16 7 22 7 22 13"/>
  </symbol>

  <symbol id="ico-calibrations" viewBox="0 0 24 24">
    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
  </symbol>

  <symbol id="ico-specifications" viewBox="0 0 24 24">
    <path d="m3 17 2 2 4-4"/>
    <path d="m3 7 2 2 4-4"/>
    <path d="m3 12 2 2 4-4"/>
    <path d="M13 17h8"/>
    <path d="M13 12h8"/>
    <path d="M13 7h8"/>
  </symbol>

  <!-- Bench -->
  <symbol id="ico-reagents" viewBox="0 0 24 24">
    <path d="M10 2v7.31"/>
    <path d="M14 9.3V2"/>
    <path d="M8.5 2h7"/>
    <path d="M14 9.3a6.5 6.5 0 1 1-4 0"/>
  </symbol>

  <symbol id="ico-prep-standards" viewBox="0 0 24 24">
    <path d="M14.5 2v17.5c0 1.4-1.1 2.5-2.5 2.5s-2.5-1.1-2.5-2.5V2"/>
    <path d="M8.5 2h7"/>
    <path d="M14.5 13h-5"/>
  </symbol>

  <symbol id="ico-book-open" viewBox="0 0 24 24">
    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
  </symbol>

  <symbol id="ico-book" viewBox="0 0 24 24">
    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
    <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15z"/>
  </symbol>

  <symbol id="ico-extraction" viewBox="0 0 24 24">
    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
  </symbol>

  <!-- Data Review / release checklist -->
  <symbol id="ico-data-review" viewBox="0 0 24 24">
    <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
    <path d="m9 11 2 2 4-4"/>
    <line x1="9" y1="16" x2="15" y2="16"/>
  </symbol>

  <!-- Facility QC -->
  <symbol id="ico-daily-checklist" viewBox="0 0 24 24">
    <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
    <path d="m9 14 2 2 4-4"/>
  </symbol>

  <symbol id="ico-temperature" viewBox="0 0 24 24">
    <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/>
  </symbol>

  <symbol id="ico-balance" viewBox="0 0 24 24">
    <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
    <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
    <path d="M7 21h10"/>
    <path d="M12 3v18"/>
    <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
  </symbol>

  <symbol id="ico-water" viewBox="0 0 24 24">
    <path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>
  </symbol>

  <symbol id="ico-waste" viewBox="0 0 24 24">
    <path d="M3 6h18"/>
    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
    <line x1="10" x2="10" y1="11" y2="17"/>
    <line x1="14" x2="14" y1="11" y2="17"/>
  </symbol>

  <symbol id="ico-eyewash" viewBox="0 0 24 24">
    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
    <circle cx="12" cy="12" r="3"/>
  </symbol>

  <symbol id="ico-unit-registry" viewBox="0 0 24 24">
    <path d="M20 7h-9"/>
    <path d="M14 17H5"/>
    <circle cx="17" cy="7" r="3"/>
    <circle cx="7" cy="17" r="3"/>
  </symbol>

  <!-- Instruments and Import -->
  <symbol id="ico-instruments" viewBox="0 0 24 24">
    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
  </symbol>

  <symbol id="ico-import" viewBox="0 0 24 24">
    <path d="M4 22h14a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v4"/>
    <polyline points="14 2 14 8 20 8"/>
    <path d="M2 15h10"/>
    <path d="m9 18 3-3-3-3"/>
  </symbol>

  <!-- Reporting -->
  <symbol id="ico-edd-edd" viewBox="0 0 24 24">
    <path d="M4 22h14a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v4"/>
    <polyline points="14 2 14 8 20 8"/>
    <path d="M12 18v-6"/>
    <path d="m9 15 3 3 3-3"/>
  </symbol>

  <symbol id="ico-edd-config" viewBox="0 0 24 24">
    <path d="M4 22h14a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v4"/>
    <polyline points="14 2 14 8 20 8"/>
    <path d="M5 13h6"/>
    <path d="M5 17h4"/>
    <path d="M7 13v4"/>
  </symbol>

  <!-- Configuration -->
  <symbol id="ico-sitemap" viewBox="0 0 24 24">
    <rect width="8" height="6" x="8" y="2" rx="1"/>
    <rect width="6" height="6" x="2" y="16" rx="1"/>
    <rect width="6" height="6" x="16" y="16" rx="1"/>
    <path d="M12 8v4"/><path d="M5 16v-2a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v2"/>
  </symbol>

  <symbol id="ico-storage" viewBox="0 0 24 24">
    <path d="M22 8.35V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.35A2 2 0 0 1 3.26 6.5l8-3.2a2 2 0 0 1 1.48 0l8 3.2A2 2 0 0 1 22 8.35Z"/>
    <path d="M6 18h12"/><path d="M6 14h12"/><path d="M6 10h12"/>
  </symbol>

  <symbol id="ico-instrument-setup" viewBox="0 0 24 24">
    <rect width="16" height="16" x="4" y="4" rx="2"/>
    <rect width="6" height="6" x="9" y="9" rx="1"/>
    <path d="M15 2v2"/><path d="M15 20v2"/>
    <path d="M2 15h2"/><path d="M2 9h2"/>
    <path d="M20 15h2"/><path d="M20 9h2"/>
    <path d="M9 2v2"/><path d="M9 20v2"/>
  </symbol>

  <symbol id="ico-method-setup" viewBox="0 0 24 24">
    <path d="M2 15c6.667-6 13.333 0 20-6"/>
    <path d="M2 9c6.667 6 13.333 0 20 6"/>
    <path d="M2 9V7"/><path d="M20 9V7"/>
    <path d="M2 15v2"/><path d="M20 15v2"/>
  </symbol>

  <symbol id="ico-workflow" viewBox="0 0 24 24">
    <circle cx="18" cy="18" r="3"/>
    <circle cx="6" cy="6" r="3"/>
    <path d="M13 6h3a2 2 0 0 1 2 2v7"/>
    <path d="M11 18H8a2 2 0 0 1-2-2V9"/>
  </symbol>

  <symbol id="ico-regulatory" viewBox="0 0 24 24">
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
    <polyline points="14 2 14 8 20 8"/>
    <line x1="16" y1="13" x2="8" y2="13"/>
    <line x1="16" y1="17" x2="8" y2="17"/>
    <line x1="10" y1="9" x2="8" y2="9"/>
  </symbol>

  <!-- Dashboard / General -->
  <symbol id="ico-home" viewBox="0 0 24 24">
    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
    <polyline points="9 22 9 12 15 12 15 22"/>
  </symbol>

  <symbol id="ico-grid" viewBox="0 0 24 24">
    <rect x="3" y="3" width="7" height="7" rx="1"/>
    <rect x="14" y="3" width="7" height="7" rx="1"/>
    <rect x="14" y="14" width="7" height="7" rx="1"/>
    <rect x="3" y="14" width="7" height="7" rx="1"/>
  </symbol>

  <!-- Deviations / CARs — warning triangle with exclamation -->
  <symbol id="ico-warning" viewBox="0 0 24 24">
    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
          fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <line x1="12" y1="9" x2="12" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <line x1="12" y1="17" x2="12.01" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </symbol>

  <!-- Pin (sidebar pins) -->
  <symbol id="ico-pin" viewBox="0 0 24 24">
    <path d="M9 3h6l-1 6 4 4H6l4-4z"/>
    <line x1="12" y1="13" x2="12" y2="21"/>
  </symbol>

  <!-- Collapse arrow -->
  <symbol id="ico-chevron-left" viewBox="0 0 24 24">
    <polyline points="15 18 9 12 15 6"/>
  </symbol>

</svg>

  <div class="pfas-rail">
    <button type="button" class="pfas-rail-btn" tal:repeat="sec nav/sections"
            tal:attributes="data-section sec/id; title sec/label;
                            aria-controls string:pfas-panel-${sec/id};
                            aria-pressed python:'true' if sec['shown'] else 'false';
                            aria-current python:'true' if sec['here'] else None">
      <svg aria-hidden="true"><use tal:attributes="href string:#${sec/icon}"/></svg>
      <span class="pfas-rail-label" tal:content="sec/short">Section</span>
    </button>
  </div>

  <div class="pfas-panel">
    <!-- what became of the last Pin or Unpin, when it was not saved (pfas-sidebar.js) -->
    <p class="pfas-nav-status" role="status"></p>
    <section class="pfas-panel-section" tal:repeat="sec nav/sections"
             tal:attributes="data-section sec/id; id string:pfas-panel-${sec/id};
                             aria-labelledby string:pfas-panel-${sec/id}-title;
                             hidden python:None if sec['shown'] else 'hidden'">
      <h2 class="pfas-panel-title" tal:content="sec/label"
          tal:attributes="id string:pfas-panel-${sec/id}-title">Section</h2>
      <ul role="tree" class="pfas-tree pfas-nav-tree" tal:attributes="aria-label sec/label">
        <li role="none" tal:repeat="it sec/tree">
          <a class="pfas-nav-row" role="treeitem"
             tal:attributes="href string:${purl}/${it/url_path}; data-path it/url_path;
                             data-pinned python:'true' if it['pinned'] else 'false';
                             aria-expanded python:('true' if it['open'] else 'false') if it['children'] else None;
                             aria-owns it/group_id;
                             aria-current python:'page' if it['current'] else None"><span class="pfas-nav-label" tal:content="it/label">Page</span></a>
          <button type="button" class="pfas-nav-twist" tabindex="-1" aria-hidden="true" tal:condition="it/children"></button>
          <button type="button" class="pfas-nav-more" tal:condition="it/pinnable" tabindex="-1" aria-haspopup="menu" aria-expanded="false" aria-label="Row menu"></button>
          <ul role="group" tal:condition="it/children" tal:attributes="id it/group_id">
            <li role="none" tal:repeat="ch it/children">
              <a class="pfas-nav-row" role="treeitem"
                 tal:attributes="href string:${purl}/${ch/url_path}; data-path ch/url_path;
                                 data-pinned python:'true' if ch['pinned'] else 'false';
                                 aria-expanded python:('true' if ch['open'] else 'false') if ch['children'] else None;
                                 aria-owns ch/group_id;
                                 aria-current python:'page' if ch['current'] else None"><span class="pfas-nav-label" tal:content="ch/label">Page</span></a>
              <button type="button" class="pfas-nav-twist" tabindex="-1" aria-hidden="true" tal:condition="ch/children"></button>
              <button type="button" class="pfas-nav-more" tal:condition="ch/pinnable" tabindex="-1" aria-haspopup="menu" aria-expanded="false" aria-label="Row menu"></button>
              <ul role="group" tal:condition="ch/children" tal:attributes="id ch/group_id">
                <li role="none" tal:repeat="ck ch/children">
                  <a class="pfas-nav-row" role="treeitem"
                     tal:attributes="href string:${purl}/${ck/url_path}; data-path ck/url_path;
                                     data-pinned python:'true' if ck['pinned'] else 'false';
                                     aria-current python:'page' if ck['current'] else None"><span class="pfas-nav-label" tal:content="ck/label">Page</span></a>
                  <button type="button" class="pfas-nav-more" tal:condition="ck/pinnable" tabindex="-1" aria-haspopup="menu" aria-expanded="false" aria-label="Row menu"></button>
                </li>
              </ul>
            </li>
          </ul>
        </li>
      </ul>
      <!-- Home: the person's pins, each a page of the map by its label, and
           its place where another pin has the same label; pfas-sidebar.js
           draws the list again from the pins view's reply -->
      <ul role="tree" class="pfas-tree pfas-nav-tree" id="pfas-nav-pins"
          tal:condition="python:sec['pins'] is not None"
          tal:attributes="aria-label sec/pins_label; hidden python:None if sec['pins'] else 'hidden'">
        <li role="none" tal:repeat="pin sec/pins">
          <a class="pfas-nav-row" role="treeitem" data-pinned="true"
             tal:attributes="href string:${purl}/${pin/url_path}; data-path pin/path"><span class="pfas-nav-label" tal:content="pin/label">Page</span><span class="pfas-nav-place" tal:condition="pin/ambiguous" tal:content="pin/place">Place</span></a>
          <button type="button" class="pfas-nav-more" tabindex="-1" aria-haspopup="menu" aria-expanded="false" aria-label="Row menu"></button>
        </li>
      </ul>
    </section>
  </div>
  <!-- behind the panel when it opens as a phone's sheet: a tap closes it -->
  <div class="pfas-nav-scrim" aria-hidden="true"></div>

<script tal:attributes="src string:${purl}/++resource++senaite.pfas/pfas-sidebar.js?v=${context/@@pfas-macros/asset_version}"></script>

</nav>
