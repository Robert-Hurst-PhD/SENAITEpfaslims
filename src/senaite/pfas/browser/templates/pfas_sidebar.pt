<nav id="sidebar" class="pfas-sidebar"
     tal:define="purl    view/portal_url;
                 path    view/current_path;
                 roles   view/user_roles;
                 home    view/landing;
                 me      python:context.portal_membership.getAuthenticatedMember().getId() or '';
                 is_mgr  python:'LabManager' in roles or 'Manager' in roles;
                 is_ana  python:'Analyst' in roles or 'Verifier' in roles;
                 is_clk  python:'LabClerk' in roles;
                 sect    python:request.get('section','')"
     aria-label="Main navigation"
     tal:attributes="data-role-group home/group; data-user me;
                     data-pins view/pins_json;
                     data-pins-url string:${purl}/@@pfas-sidebar-pins;
                     data-portal purl;
                     data-token context/@@authenticator/token">

<style id="pfas-sidebar-css">
/* ── PFAS unified sidebar ───────────────────────────────────────────────── */
#sidebar.pfas-sidebar {
  /* Fixed line-height: without it each host page decided the row pitch
     (34px on core pages at line-height 1.5, 29px on PFAS pages), */
  line-height: 16px;
  font-size: var(--fs-sm);   /* nav: 13px keeps every label on one line */
  min-width: 220px;
  max-width: 220px;
  background: var(--s-light);
  border-right: 1px solid var(--s-border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: min-width .2s ease, max-width .2s ease;
  white-space: nowrap;
  flex-shrink: 0;
}

/* Collapse via PFAS shell (workspace pages) */
#pfas-shell.panel-collapsed #sidebar.pfas-sidebar {
  min-width: 48px;
  max-width: 48px;
}

/* Collapse via core SENAITE toggle (core pages) */
#sidebar.pfas-sidebar.toggled {
  min-width: 48px;
  max-width: 48px;
}

/* Inner scroll container */
.pfas-sb-scroll {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 6px 0;
}

/* ── Group (accordion) ─────────────────────────────────────────────────── */
.pfas-sg-head {
  line-height: 16px;   /* a <button>: does not inherit line-height on PFAS pages */
  font-family: inherit;
  display: flex;
  align-items: center;
  width: 100%;
  background: none;
  border: none;
  padding: 8px 12px 5px 12px;
  cursor: pointer;
  text-align: left;
  color: var(--s-secondary);
  font-size: var(--fs-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .07em;
  user-select: none;
}
.pfas-sg-head:hover { color: var(--s-dark); }
.pfas-sg-label { flex: 1; overflow: hidden; text-overflow: ellipsis; }
.pfas-sg-arrow {
  font-size: var(--fs-xs);
  transition: transform .15s;
  display: inline-block;
  color: #adb5bd;
}
.pfas-sg.sg-closed .pfas-sg-arrow { transform: rotate(-90deg); }

/* Hide group label + arrow when collapsed to rail */
#pfas-shell.panel-collapsed .pfas-sg-label,
#pfas-shell.panel-collapsed .pfas-sg-arrow,
#sidebar.pfas-sidebar.toggled .pfas-sg-label,
#sidebar.pfas-sidebar.toggled .pfas-sg-arrow { opacity: 0; }

/* ── Group items ──────────────────────────────────────────────────────── */
.pfas-sg-items { overflow: hidden; }
.pfas-sg.sg-closed .pfas-sg-items { display: none; }

/* Show all items in icon-rail mode regardless of group state */
#pfas-shell.panel-collapsed .pfas-sg-items,
#sidebar.pfas-sidebar.toggled .pfas-sg-items { display: block; }

/* ── Sidebar item ─────────────────────────────────────────────────────── */
/* ── Sidebar pins (sidebar_pins.py) ─────────────────────────────────── */
.pfas-sb-pinned.has-pins { border-top: 1px solid var(--s-border); padding: 4px 0; }
.pfas-pin-btn {
  /* Overlaid on the row's right edge: it takes no width (a hidden button
     that did truncated labels) and no height (16px = the row's line). */
  position: absolute; right: 6px; top: 50%; margin-top: -8px;
  width: 20px; height: 16px; padding: 0;
  display: inline-flex; align-items: center; justify-content: center;
  background: none; border: 0; border-radius: 3px; cursor: pointer;
  color: var(--s-secondary); opacity: 0; transition: opacity .1s;
}
.pfas-pin-btn svg { width: 14px; height: 14px; fill: none; stroke: currentColor;
                    stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.pfas-si:hover .pfas-pin-btn, .pfas-pin-btn:focus { opacity: 1; background: var(--s-light); }
.pfas-si { position: relative; }
.pfas-pin-btn:hover { background: #e9ecef; color: var(--s-body); }
.pfas-sb-scroll .pfas-pin-btn.is-pinned { opacity: .7; color: var(--s-primary-dk); }
.pfas-si-pinned .pfas-pin-btn { font-size: var(--fs-md); line-height: 1; }
#pfas-shell.panel-collapsed .pfas-pin-btn,
#sidebar.pfas-sidebar.toggled .pfas-pin-btn { display: none; }

.pfas-si {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 7px 12px 7px 16px;
  color: var(--s-input-text);
  text-decoration: none;
  font-size: var(--fs-sm);   /* nav: 13px keeps every label on one line */
  border-left: 3px solid transparent;
  overflow: hidden;
  transition: color .1s, background .1s;
}
.pfas-si:hover {
  color: #212529;
  background: #e9ecef;
  text-decoration: none;
}
.pfas-si.si-active {
  color: var(--s-primary-dk);
  border-left-color: var(--s-primary);
  background: var(--s-primary-lt);
  font-weight: 600;
}
.pfas-si-icon {
  flex: 0 0 18px;
  width: 18px;
  text-align: center;
  line-height: 1;
  color: #adb5bd;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pfas-si.si-active .pfas-si-icon { color: var(--s-primary-dk); }
.pfas-si-label { flex: 1; overflow: hidden; text-overflow: ellipsis; }
.pfas-si-icon svg {
  width: 15px;
  height: 15px;
  display: block;
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* Hide labels when collapsed to rail */
#pfas-shell.panel-collapsed .pfas-si-label,
#sidebar.pfas-sidebar.toggled .pfas-si-label { display: none; }

/* ── Dashboard pin ─────────────────────────────────────────────────── */
.pfas-sb-pin {
  flex: 0 0 auto;
  border-bottom: 2px solid var(--s-border);
}
.pfas-sb-dash {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px 12px 10px 16px;
  color: var(--s-input-text);
  text-decoration: none;
  font-size: var(--fs-sm);   /* nav: 13px keeps every label on one line */
  font-weight: 600;
  border-left: 3px solid transparent;
}
.pfas-sb-dash:hover {
  color: #212529;
  background: #e9ecef;
  text-decoration: none;
}
.pfas-sb-dash.si-active {
  color: var(--s-primary-dk);
  border-left-color: var(--s-primary);
  background: var(--s-primary-lt);
}
#pfas-shell.panel-collapsed .pfas-sb-dash-label,
#sidebar.pfas-sidebar.toggled .pfas-sb-dash-label { display: none; }

/* Core pages draw the one top toolbar (templates/pfas_topbar.pt);
   nothing here restyles core's old #senaite-toolbar any more. */

/* Collapse toggle at bottom */
.pfas-sb-foot {
  flex: 0 0 auto;
  border-top: 1px solid var(--s-border);
}
.pfas-sb-collapse-btn {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  padding: 8px 14px;
  background: none;
  border: none;
  cursor: pointer;
  color: #adb5bd;
  font-size: var(--fs-md);
  transition: color .1s;
}
.pfas-sb-collapse-btn:hover { color: var(--s-secondary); }
.pfas-sb-collapse-arrow { display: inline-block; transition: transform .2s; }
#pfas-shell.panel-collapsed .pfas-sb-collapse-arrow,
#sidebar.pfas-sidebar.toggled .pfas-sb-collapse-arrow { transform: rotate(180deg); }

/* ── Mobile (core SENAITE pages, ≤768px) ─────────────────────────────────── */
@media (max-width: 768px) {
  /* Sidebar becomes a fixed full-height drawer — taken out of document flow.
     All key properties use !important to beat SENAITE's #sidebar rules. */
  body:not(.pfas-app) #sidebar.pfas-sidebar {
    position: fixed !important;
    top: 52px !important; left: 0 !important; bottom: 0 !important; right: auto !important;
    z-index: 1000 !important;
    transform: translateX(-100%) !important;
    box-shadow: none !important;
    transition: transform .22s ease !important;
    min-width: 260px !important;
    max-width: 260px !important;
    width: 260px !important;
    overflow: hidden !important;
    overflow-y: auto !important;
    white-space: normal !important;
    background-color: #fff !important;
  }
  body:not(.pfas-app) #sidebar.pfas-sidebar.mobile-open {
    transform: translateX(0) !important;
    box-shadow: 4px 0 24px rgba(0,0,0,.35) !important;
  }
  /* Main content takes full width — override SENAITE's width:calc(100% - 50px) */
  body:not(.pfas-app) .wrapper > div,
  body:not(.pfas-app) .wrapper div.container-fluid,
  body:not(.pfas-app) .wrapper div.container-lg,
  body:not(.pfas-app) .wrapper div.container-md,
  body:not(.pfas-app) .wrapper div.container-sm,
  body:not(.pfas-app) .wrapper div.container-xl {
    width: 100% !important;
    margin-left: 0 !important;
    padding-left: 8px !important;
  }
  /* Full-page backdrop behind open drawer */
  #pfas-mobile-backdrop {
    display: none;
    position: fixed;
    top: 52px; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,.45);
    z-index: 999;
    cursor: pointer;
  }
  #pfas-mobile-backdrop.active { display: block; }
  /* Hide the collapse-to-rail footer button on mobile — replaced by open/close */
  body:not(.pfas-app) .pfas-sb-foot { display: none; }
  /* Scrollable content on core pages */
  body:not(.pfas-app) .pat-structure,
  body:not(.pfas-app) .container { overflow-x: auto; }

}
</style>

<!-- ── SVG icon sprite (Lucide, MIT) ─────────────────────────────────────── -->
