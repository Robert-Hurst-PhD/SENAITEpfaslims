        <a class="pfas-si" title="Reporting template, document templates, EDD configuration, print settings"
           tal:attributes="href gi/href; class python:'pfas-si si-active' if gi['active'] else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-edd-config"/></svg></span>
          <span class="pfas-si-label">Reporting Setup</span>
        </a>
        </tal:g>
        <a class="pfas-si" title="Controlled Publications — CoA issue register (ISO 17025 document control)"
           tal:condition="python:is_mgr"
           tal:attributes="href string:${purl}/@@pfas-controlled-publications;
                           class python:'pfas-si si-active' if '@@pfas-controlled-publications' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-book"/></svg></span>
          <span class="pfas-si-label">Controlled Publications</span>
        </a>
        <a class="pfas-si" title="Delivered EDDs — download EDD files per batch"
           tal:condition="is_mgr"
           tal:attributes="href string:${purl}/@@pfas-edd-batches;
                           class python:'pfas-si si-active' if '@@pfas-edd-batches' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-edd-edd"/></svg></span>
          <span class="pfas-si-label">Delivered EDDs</span>
        </a>
        <a class="pfas-si" title="Regulatory Limits: MCLs and action levels printed as certificate notes"
           tal:condition="python:is_mgr"
           tal:attributes="href string:${purl}/@@pfas-regulatory-limits;
                           class python:'pfas-si si-active' if '@@pfas-regulatory-limits' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-warning"/></svg></span>
          <span class="pfas-si-label">Regulatory Limits</span>
        </a>
      </div>
    </div>

    <!-- ── CONFIGURATION (Manager only — ManageBika) ───────────────────── -->
    <div class="pfas-sg" id="pfas-sg-config"
         tal:condition="python:is_mgr">
      <button class="pfas-sg-head" type="button"
              onclick="pfasSgToggle('pfas-sg-config')">
        <span class="pfas-sg-label">Configuration</span>
        <span class="pfas-sg-arrow">&#9660;</span>
      </button>
      <div class="pfas-sg-items">
        <!-- One item for a page group: its pages are sub-tabs (page_groups.py) -->
        <tal:g define="gi python:context.restrictedTraverse('@@pfas-macros').group_item('settings')" condition="gi">
        <a class="pfas-si" title="Lab settings, site settings, lab staff, terminals"
           tal:attributes="href gi/href; class python:'pfas-si si-active' if gi['active'] else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-workflow"/></svg></span>
          <span class="pfas-si-label">Settings</span>
        </a>
        </tal:g>
        <a class="pfas-si" title="Configuration History: who changed which setting, when, before and after"
