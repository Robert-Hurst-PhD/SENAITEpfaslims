<script>
(function () {
  var SB_STATE_KEY = 'pfas_sb_groups';

  function restoreGroups() {
    var raw;
    try { raw = sessionStorage.getItem(SB_STATE_KEY); } catch (e) {}
    if (!raw) return;
    var closed;
    try { closed = JSON.parse(raw); } catch (e) { return; }
    if (!Array.isArray(closed)) return;
    for (var i = 0; i < closed.length; i++) {
      var el = document.getElementById(closed[i]);
      if (el) el.classList.add('sg-closed');
    }
  }

  function saveGroups() {
    var closed = [];
    document.querySelectorAll('.pfas-sg.sg-closed').forEach(function (el) {
      if (el.id) closed.push(el.id);
    });
    try { sessionStorage.setItem(SB_STATE_KEY, JSON.stringify(closed)); } catch (e) {}
  }

  window.pfasSgToggle = function (groupId) {
    var el = document.getElementById(groupId);
    if (!el) return;
    el.classList.toggle('sg-closed');
    saveGroups();
  };

  var _isMobile = function () { return window.innerWidth <= 768; };

  window.pfasCloseMobileSidebar = function () {
    var sb = document.getElementById('sidebar');
    if (sb) sb.classList.remove('mobile-open');
    var bd = document.getElementById('pfas-mobile-backdrop');
    if (bd) bd.classList.remove('active');
  };

  /* pfasSidebarCollapseToggle: open/close or collapse the sidebar.
     PFAS pages:  mobile = panel-open overlay on #pfas-shell;
                  desktop = panel-collapsed icon rail.
     Core pages:  mobile = mobile-open slide-in drawer on #sidebar;
                  desktop = toggled icon rail on #sidebar. */
  window.pfasSidebarCollapseToggle = function () {
    var shell = document.getElementById('pfas-shell');
    if (shell) {
      /* PFAS workspace page — handled by pfas_macros.pt pfasTogglePanel */
      if (typeof window.pfasTogglePanel === 'function') {
        window.pfasTogglePanel();
      } else {
        var collapsed = shell.classList.toggle('panel-collapsed');
        try { sessionStorage.setItem('pfas_panel_collapsed', collapsed ? '1' : '0'); } catch (e) {}
      }
    } else {
      /* Core SENAITE page */
      var sb = document.getElementById('sidebar');
      if (!sb) return;
      if (_isMobile()) {
        var isOpen = sb.classList.toggle('mobile-open');
        var bd = document.getElementById('pfas-mobile-backdrop');
        if (bd) bd.classList.toggle('active', isOpen);
      } else {
        var collapsed = sb.classList.toggle('toggled');
        try { sessionStorage.setItem('pfas_panel_collapsed', collapsed ? '1' : '0'); } catch (e) {}
      }
    }
  };

  function autoExpandActiveGroup() {
    var active = document.querySelector('.pfas-si.si-active');
    if (!active) return;
    var group = active.closest('.pfas-sg');
    if (group) group.classList.remove('sg-closed');
  }

  restoreGroups();
  autoExpandActiveGroup();
})();

/* ── Core SENAITE page: replace SENAITE logo + inject sidebar toggle ── */
(function () {
  if (document.body.classList.contains('pfas-app')) return;

  function applyModuleName() {
    var brand = document.querySelector('#senaite-toolbar .navbar-brand');
    if (!brand) return;
    var raw = (document.title || '').trim();
    /* Split on em-dash (—), en-dash (–), pipe, or space-hyphen-space.
       JS \uXXXX escapes are ASCII and are not entity-encoded by Chameleon.
       Literal Unicode chars in script blocks get encoded (e.g. — -> &#8212;)
       which would break the regex; escapes avoid that entirely. */
    var reSep = /\s*[\u2014\u2013|]\s*|\s+-\s+/;
    var parts = raw.split(reSep);
    var clean = [];
    for (var i = 0; i < parts.length; i++) {
      var p = parts[i].trim();
      if (p && !/^senaite/i.test(p)) { clean.push(p); }
    }
    var name = clean[0] || 'LIMS';
    brand.textContent = name;
    brand.style.cssText = 'color:#fff;font-size:16px;font-weight:600;letter-spacing:-.01em;white-space:nowrap';
  }

  function injectSidebarToggle() {
    var nav = document.getElementById('senaite-toolbar');
    if (!nav || nav.querySelector('.pfas-core-toggle')) return;
    var brand = nav.querySelector('.navbar-brand');
    if (!brand) return;
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'pfas-core-toggle';
    btn.setAttribute('onclick', 'pfasSidebarCollapseToggle()');
    btn.setAttribute('title', 'Toggle navigation');
    btn.innerHTML = '&#9776;';
    nav.insertBefore(btn, brand);
  }

  function injectBackdrop() {
    if (document.getElementById('pfas-mobile-backdrop')) return;
    var bd = document.createElement('div');
    bd.id = 'pfas-mobile-backdrop';
    bd.setAttribute('onclick', 'pfasCloseMobileSidebar()');
    bd.setAttribute('aria-hidden', 'true');
    document.body.appendChild(bd);
  }

  /* Replace plain username text with icon+text span so CSS can
     show only the icon on narrow screens */
  function fixUserButton() {
    var btn = document.getElementById('navbarUserDropdown');
    if (!btn || btn.querySelector('.pfas-user-icon')) return;
    var text = btn.textContent.trim();
    if (!text) return;
    btn.innerHTML =
      '<i class="fas fa-user-circle pfas-user-icon" aria-hidden="true"></i>' +
      '<span class="pfas-user-text">' + text + '</span>';
  }

  function wireNavLinks() {
    /* Auto-close the sidebar when a nav link is tapped on mobile */
    var links = document.querySelectorAll('#sidebar .pfas-si');
    for (var i = 0; i < links.length; i++) {
      links[i].addEventListener('click', function () {
        if (_isMobile()) { pfasCloseMobileSidebar(); }
      });
    }
  }

  /* Restore desktop icon-rail state on core pages */
  function restoreRailState() {
    if (_isMobile()) return;
    try {
      if (sessionStorage.getItem('pfas_panel_collapsed') === '1') {
        var sb = document.getElementById('sidebar');
        if (sb) sb.classList.add('toggled');
      }
    } catch (e) {}
  }

  /* Close mobile drawer on Escape */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { pfasCloseMobileSidebar(); }
  });

  function init() {
    applyModuleName();
    injectSidebarToggle();
    fixUserButton();
    injectBackdrop();
    wireNavLinks();
    restoreRailState();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  /* Re-apply after all page scripts run, in case SENAITE JS overwrites the brand */
  window.addEventListener('load', applyModuleName);
})();
</script>

</nav>
