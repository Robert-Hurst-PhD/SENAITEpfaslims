<nav id="sidebar" class="pfas-sidebar"
     tal:define="purl    view/portal_url;
                 path    view/current_path;
                 roles   view/user_roles;
                 is_mgr  python:'LabManager' in roles or 'Manager' in roles;
                 is_ana  python:'Analyst' in roles or 'Verifier' in roles;
                 is_clk  python:'LabClerk' in roles;
                 sect    python:request.get('section','')"
     aria-label="Main navigation">

<style id="pfas-sidebar-css">
/* ── PFAS unified sidebar ───────────────────────────────────────────────── */
#sidebar.pfas-sidebar {
  min-width: 220px;
  max-width: 220px;
  background: #f8f9fa;
  border-right: 1px solid #dee2e6;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: min-width .2s ease, max-width .2s ease;
  white-space: nowrap;
  flex-shrink: 0;
}

/* Collapse via PFAS shell (workspace pages) */
#pfas-shell.panel-collapsed #sidebar.pfas-sidebar {
  min-width: 48px;
  max-width: 48px;
}

/* Collapse via core SENAITE toggle (core pages) */
#sidebar.pfas-sidebar.toggled {
  min-width: 48px;
  max-width: 48px;
}

/* Inner scroll container */
.pfas-sb-scroll {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 6px 0;
}

/* ── Group (accordion) ─────────────────────────────────────────────────── */
.pfas-sg-head {
  display: flex;
  align-items: center;
  width: 100%;
  background: none;
  border: none;
  padding: 8px 12px 5px 12px;
  cursor: pointer;
  text-align: left;
  color: #6c757d;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .07em;
  user-select: none;
}
.pfas-sg-head:hover { color: #343a40; }
.pfas-sg-label { flex: 1; overflow: hidden; text-overflow: ellipsis; }
.pfas-sg-arrow {
  font-size: 10px;
  transition: transform .15s;
  display: inline-block;
  color: #adb5bd;
}
.pfas-sg.sg-closed .pfas-sg-arrow { transform: rotate(-90deg); }

/* Hide group label + arrow when collapsed to rail */
#pfas-shell.panel-collapsed .pfas-sg-label,
#pfas-shell.panel-collapsed .pfas-sg-arrow,
#sidebar.pfas-sidebar.toggled .pfas-sg-label,
#sidebar.pfas-sidebar.toggled .pfas-sg-arrow { opacity: 0; }

/* ── Group items ──────────────────────────────────────────────────────── */
.pfas-sg-items { overflow: hidden; }
.pfas-sg.sg-closed .pfas-sg-items { display: none; }

/* Show all items in icon-rail mode regardless of group state */
#pfas-shell.panel-collapsed .pfas-sg-items,
#sidebar.pfas-sidebar.toggled .pfas-sg-items { display: block; }

/* ── Sidebar item ─────────────────────────────────────────────────────── */
.pfas-si {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 7px 12px 7px 16px;
  color: #495057;
  text-decoration: none;
  font-size: 13px;
  border-left: 3px solid transparent;
  overflow: hidden;
  transition: color .1s, background .1s;
}
.pfas-si:hover {
  color: #212529;
  background: #e9ecef;
  text-decoration: none;
}
.pfas-si.si-active {
  color: #428aaf;
  border-left-color: #428aaf;
  background: #e8f4f8;
  font-weight: 600;
}
.pfas-si-icon {
  flex: 0 0 18px;
  width: 18px;
  text-align: center;
  line-height: 1;
  color: #adb5bd;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pfas-si.si-active .pfas-si-icon { color: #428aaf; }
.pfas-si-label { flex: 1; overflow: hidden; text-overflow: ellipsis; }
.pfas-si-icon svg {
  width: 15px;
  height: 15px;
  display: block;
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* Hide labels when collapsed to rail */
#pfas-shell.panel-collapsed .pfas-si-label,
#sidebar.pfas-sidebar.toggled .pfas-si-label { display: none; }

/* ── Dashboard pin ─────────────────────────────────────────────────── */
.pfas-sb-pin {
  flex: 0 0 auto;
  border-bottom: 2px solid #dee2e6;
}
.pfas-sb-dash {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px 12px 10px 16px;
  color: #495057;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  border-left: 3px solid transparent;
}
.pfas-sb-dash:hover {
  color: #212529;
  background: #e9ecef;
  text-decoration: none;
}
.pfas-sb-dash.si-active {
  color: #428aaf;
  border-left-color: #428aaf;
  background: #e8f4f8;
}
#pfas-shell.panel-collapsed .pfas-sb-dash-label,
#sidebar.pfas-sidebar.toggled .pfas-sb-dash-label { display: none; }

/* ── Core SENAITE page header unification ──────────────────────────── */
body:not(.pfas-app) #senaite-toolbar {
  background: #343a40 !important;
  border-bottom: none !important;
  height: 52px !important;
  min-height: 52px !important;
  max-height: 52px !important;
  padding: 0 16px 0 0 !important;
  display: flex !important;
  align-items: center !important;
  flex-wrap: nowrap !important;
}
body:not(.pfas-app) #senaite-toolbar .navbar-collapse,
body:not(.pfas-app) #senaite-toolbar .collapse {
  height: 52px !important;
  display: flex !important;
  align-items: center !important;
  flex: 1 !important;
  justify-content: flex-end !important;
}
body:not(.pfas-app) .navbar-brand {
  font-size: 17px;
  font-weight: 600;
  color: #fff !important;
  letter-spacing: -.01em;
  white-space: nowrap;
  flex: 1;
  margin: 0 10px;
}
body:not(.pfas-app) .navbar-brand img { display: none; }
body:not(.pfas-app) #senaite-toolbar .nav-link,
body:not(.pfas-app) #senaite-toolbar .dropdown-toggle {
  color: rgba(255,255,255,.7) !important;
  height: 52px;
  display: flex !important;
  align-items: center !important;
  padding-left: 6px !important;
  padding-right: 6px !important;
}
body:not(.pfas-app) #senaite-toolbar .nav-link i.fas,
body:not(.pfas-app) #senaite-toolbar .dropdown-toggle i.fas {
  font-size: 18px !important;
}
body:not(.pfas-app) #senaite-toolbar .navbar-nav { gap: 0 !important; }
body:not(.pfas-app) #senaite-toolbar .nav-link:hover,
body:not(.pfas-app) #senaite-toolbar .dropdown-toggle:hover {
  color: #fff !important;
}
/* Bootstrap's collapse toggler is redundant — we force navbar-collapse always
   open via display:flex!important above, so hide it on all screen sizes. */
body:not(.pfas-app) #senaite-toolbar .navbar-toggler { display: none !important; }

/* Desktop: user dropdown shows text; mobile overrides show icon-only */
body:not(.pfas-app) #navbarUserDropdown .pfas-user-icon { display: none; }

/* Sidebar toggle button injected before the navbar-brand on core pages */
body:not(.pfas-app) .pfas-core-toggle {
  background: none; border: none; border-right: 1px solid rgba(255,255,255,.1);
  outline: none; color: rgba(255,255,255,.7); cursor: pointer;
  width: 48px; height: 52px;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 18px; flex-shrink: 0; padding: 0;
  transition: color .12s, background .12s;
}
body:not(.pfas-app) .pfas-core-toggle:hover {
  color: #fff; background: rgba(255,255,255,.07);
}
/* Dark dropdown menus on core pages */
body:not(.pfas-app) #senaite-toolbar .dropdown-menu {
  background: #2d3236 !important;
  border: 1px solid rgba(255,255,255,.12) !important;
  border-radius: 6px !important;
  padding: 4px !important;
  box-shadow: 0 8px 24px rgba(0,0,0,.35) !important;
}
body:not(.pfas-app) #senaite-toolbar .dropdown-menu a,
body:not(.pfas-app) #senaite-toolbar .dropdown-menu .nav-link {
  color: rgba(255,255,255,.82) !important;
  border-radius: 4px !important;
  padding: 8px 12px !important;
}
body:not(.pfas-app) #senaite-toolbar .dropdown-menu a:hover,
body:not(.pfas-app) #senaite-toolbar .dropdown-menu .nav-link:hover {
  background: rgba(255,255,255,.08) !important;
  color: #fff !important;
}

/* Collapse toggle at bottom */
.pfas-sb-foot {
  flex: 0 0 auto;
  border-top: 1px solid #dee2e6;
}
.pfas-sb-collapse-btn {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  padding: 8px 14px;
  background: none;
  border: none;
  cursor: pointer;
  color: #adb5bd;
  font-size: 15px;
  transition: color .1s;
}
.pfas-sb-collapse-btn:hover { color: #6c757d; }
.pfas-sb-collapse-arrow { display: inline-block; transition: transform .2s; }
#pfas-shell.panel-collapsed .pfas-sb-collapse-arrow,
#sidebar.pfas-sidebar.toggled .pfas-sb-collapse-arrow { transform: rotate(180deg); }

/* ── Mobile (core SENAITE pages, ≤768px) ─────────────────────────────────── */
@media (max-width: 768px) {
  /* Sidebar becomes a fixed full-height drawer — taken out of document flow */
  body:not(.pfas-app) #sidebar.pfas-sidebar {
    position: fixed;
    top: 52px; left: 0; bottom: 0;
    z-index: 1000;
    transform: translateX(-100%);
    box-shadow: none;
    transition: transform .22s ease;
    min-width: 260px !important;
    max-width: 260px !important;
    overflow-y: auto;
  }
  body:not(.pfas-app) #sidebar.pfas-sidebar.mobile-open {
    transform: translateX(0);
    box-shadow: 4px 0 24px rgba(0,0,0,.35);
  }
  /* Full-page backdrop behind open drawer */
  #pfas-mobile-backdrop {
    display: none;
    position: fixed;
    top: 52px; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,.45);
    z-index: 999;
    cursor: pointer;
  }
  #pfas-mobile-backdrop.active { display: block; }
  /* Hide the collapse-to-rail footer button on mobile — replaced by open/close */
  body:not(.pfas-app) .pfas-sb-foot { display: none; }
  /* Make the toolbar toggle visible on mobile */
  body:not(.pfas-app) .pfas-core-toggle { display: inline-flex !important; }
  /* Core page content: remove any left margin that assumed a sidebar */
  body:not(.pfas-app) .container-fluid,
  body:not(.pfas-app) #content-wrapper,
  body:not(.pfas-app) #content { margin-left: 0 !important; padding-left: 8px !important; }
  /* Scrollable content on core pages */
  body:not(.pfas-app) .pat-structure,
  body:not(.pfas-app) .container { overflow-x: auto; }

  /* ── Toolbar layout on mobile ──────────────────────────────────────────── */
  /* Single row, never wraps */
  body:not(.pfas-app) #senaite-toolbar {
    flex-wrap: nowrap !important;
    overflow: hidden;
  }
  /* Brand: shrinks if needed, truncates, doesn't push icons off-screen */
  body:not(.pfas-app) .navbar-brand {
    flex: 1 1 0 !important;
    min-width: 0 !important;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 14px !important;
    margin: 0 4px !important;
  }
  /* Tighten icon padding on mobile to gain space */
  body:not(.pfas-app) #senaite-toolbar .nav-link,
  body:not(.pfas-app) #senaite-toolbar .dropdown-toggle {
    padding-left: 4px !important;
    padding-right: 4px !important;
  }
  /* Language selector: rarely needed on mobile — accessible via desktop */
  body:not(.pfas-app) #senaite-toolbar li.nav-item:has(i.fa-globe) {
    display: none !important;
  }
  /* LIMS setup cog: reachable from the sidebar Configuration group */
  body:not(.pfas-app) #senaite-toolbar li.nav-item:has(i.fa-cog) {
    display: none !important;
  }
  /* User dropdown: show icon, hide username text to save width */
  body:not(.pfas-app) #navbarUserDropdown .pfas-user-icon {
    display: inline-block !important;
  }
  body:not(.pfas-app) #navbarUserDropdown .pfas-user-text {
    display: none !important;
  }
}
</style>

<!-- ── SVG icon sprite (Lucide, MIT) ─────────────────────────────────────── -->
