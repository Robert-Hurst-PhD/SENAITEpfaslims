                           class python:'pfas-si si-active' if '@@pfas-config-history' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-book"/></svg></span>
          <span class="pfas-si-label">Configuration History</span>
        </a>
        <a class="pfas-si" title="System Map — clickable navigation diagram"
           tal:attributes="href string:${purl}/@@pfas-system-map;
                           class python:'pfas-si si-active' if '@@pfas-system-map' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-sitemap"/></svg></span>
          <span class="pfas-si-label">System Map</span>
        </a>
        <a class="pfas-si" title="General — all settings"
           tal:attributes="href string:${purl}/@@lims-setup;
                           class python:'pfas-si si-active' if '@@lims-setup' in path and not sect else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-grid"/></svg></span>
          <span class="pfas-si-label">General</span>
        </a>
        <a class="pfas-si" title="Storage &amp; Inventory"
           tal:attributes="href string:${purl}/@@lims-setup?section=storage;
                           class python:'pfas-si si-active' if '@@lims-setup' in path and sect=='storage' else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-storage"/></svg></span>
          <span class="pfas-si-label">Storage &amp; Inventory</span>
        </a>
        <a class="pfas-si" title="Instrument Setup"
           tal:attributes="href string:${purl}/@@lims-setup?section=instruments;
                           class python:'pfas-si si-active' if '@@lims-setup' in path and sect=='instruments' else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-instrument-setup"/></svg></span>
          <span class="pfas-si-label">Instrument Setup</span>
        </a>
        <a class="pfas-si" title="Method &amp; Analyte Setup"
           tal:attributes="href string:${purl}/@@lims-setup?section=methods;
                           class python:'pfas-si si-active' if '@@lims-setup' in path and sect=='methods' else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-method-setup"/></svg></span>
          <span class="pfas-si-label">Method &amp; Analyte Setup</span>
        </a>
        <a class="pfas-si" title="Workflow &amp; QC"
           tal:attributes="href string:${purl}/@@lims-setup?section=workflow;
                           class python:'pfas-si si-active' if '@@lims-setup' in path and sect=='workflow' else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-workflow"/></svg></span>
          <span class="pfas-si-label">Workflow &amp; QC</span>
        </a>
        <a class="pfas-si" title="Regulatory Reporting"
           tal:attributes="href string:${purl}/@@lims-setup?section=regulatory;
                           class python:'pfas-si si-active' if '@@lims-setup' in path and sect=='regulatory' else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-regulatory"/></svg></span>
          <span class="pfas-si-label">Regulatory Reporting</span>
