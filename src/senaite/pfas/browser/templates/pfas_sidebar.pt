  </div><!-- /pfas-sb-scroll -->

  <!-- Collapse toggle at bottom -->
  <div class="pfas-sb-foot">
    <button class="pfas-sb-collapse-btn" type="button"
            onclick="pfasSidebarCollapseToggle()"
            title="Collapse sidebar">
      <span class="pfas-sb-collapse-arrow">&#8249;</span>
    </button>
  </div>

<script>
(function () {
  /* Group state: by default only the user's role
     group and the current page's group are open. A group the user opens or
     closes by hand is remembered per user (localStorage, keyed by user id) and
     wins over the default next time. */
  /* per user, not per browser: lab terminals are shared */
  var _sbNav = document.getElementById('sidebar');
  var SB_STATE_KEY = 'pfas_sb_groups_v2:' + ((_sbNav && _sbNav.getAttribute('data-user')) || '');

  function loadChoices() {
    try { var o = JSON.parse(localStorage.getItem(SB_STATE_KEY) || '{}');
          return (o && typeof o === 'object') ? o : {}; } catch (e) { return {}; }
  }

  function restoreGroups() {
    var nav = document.getElementById('sidebar');
    var roleGroup = nav ? nav.getAttribute('data-role-group') : '';
    var choices = loadChoices();
    document.querySelectorAll('.pfas-sg').forEach(function (el) {
      var open = el.id === roleGroup;
      if (choices.hasOwnProperty(el.id)) open = choices[el.id] === 'open';
      el.classList.toggle('sg-closed', !open);
    });
  }

  function saveGroup(el) {
    var choices = loadChoices();
    choices[el.id] = el.classList.contains('sg-closed') ? 'closed' : 'open';
    try { localStorage.setItem(SB_STATE_KEY, JSON.stringify(choices)); } catch (e) {}
  }

  window.pfasSgToggle = function (groupId) {
    var el = document.getElementById(groupId);
    if (!el) return;
    el.classList.toggle('sg-closed');
    saveGroup(el);
  };

  var _isMobile = function () { return window.innerWidth <= 768; };

  window.pfasCloseMobileSidebar = function () {
    var sb = document.getElementById('sidebar');
    if (sb) sb.classList.remove('mobile-open');
    var bd = document.getElementById('pfas-mobile-backdrop');
    if (bd) bd.classList.remove('active');
  };

  /* pfasSidebarCollapseToggle: open/close or collapse the sidebar.
     PFAS pages:  mobile = panel-open overlay on #pfas-shell;
                  desktop = panel-collapsed icon rail.
     Core pages:  mobile = mobile-open slide-in drawer on #sidebar;
                  desktop = toggled icon rail on #sidebar. */
  window.pfasSidebarCollapseToggle = function () {
    var shell = document.getElementById('pfas-shell');
    if (shell) {
      /* PFAS workspace page — handled by pfas_macros.pt pfasTogglePanel */
      if (typeof window.pfasTogglePanel === 'function') {
        window.pfasTogglePanel();
      } else {
        var collapsed = shell.classList.toggle('panel-collapsed');
        try { sessionStorage.setItem('pfas_panel_collapsed', collapsed ? '1' : '0'); } catch (e) {}
      }
    } else {
      /* Core SENAITE page */
      var sb = document.getElementById('sidebar');
      if (!sb) return;
      if (_isMobile()) {
        var isOpen = sb.classList.toggle('mobile-open');
        var bd = document.getElementById('pfas-mobile-backdrop');
        if (bd) bd.classList.toggle('active', isOpen);
      } else {
        var collapsed = sb.classList.toggle('toggled');
        try { sessionStorage.setItem('pfas_panel_collapsed', collapsed ? '1' : '0'); } catch (e) {}
      }
    }
  };

  function autoExpandActiveGroup() {
    var active = document.querySelector('.pfas-sb-scroll .pfas-si.si-active');   /* not a pinned copy */
    if (!active) return;
    var group = active.closest('.pfas-sg');
    if (group) group.classList.remove('sg-closed');
  }

  restoreGroups();
  autoExpandActiveGroup();
})();

/* ── Sidebar pins: the user's pinned pages under Dashboard ─────────────
   Each pin is a copy of the user's own sidebar link for that path, so label,
   icon and permission come from the sidebar itself; a path the user can no
   longer see is not shown. Saved on the server per user (sidebar_pins.py). */
(function () {
  var nav = document.getElementById('sidebar');
  var box = document.getElementById('pfas-sb-pinned');
  if (!nav || !box) return;
  var portal = (nav.getAttribute('data-portal') || '').replace(/\/+$/, '');
  var url = nav.getAttribute('data-pins-url');
  var token = nav.getAttribute('data-token') || '';
  var pins;
  try { pins = JSON.parse(nav.getAttribute('data-pins') || '[]'); } catch (e) { pins = []; }
  if (!Array.isArray(pins)) pins = [];
  var items = Array.prototype.slice.call(nav.querySelectorAll('.pfas-sb-scroll .pfas-si[href]'));

  function rel(href) {
    var h = (href || '').split('#')[0];
    return h.indexOf(portal + '/') === 0 ? h.slice(portal.length + 1) : null;
  }
  function itemFor(path) {
    for (var i = 0; i < items.length; i++) if (rel(items[i].href) === path) return items[i];
    return null;
  }
  function pinButton(onClick, pinned, unpinGlyph) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'pfas-pin-btn' + (pinned ? ' is-pinned' : '');
    b.title = pinned ? 'Unpin' : 'Pin under Dashboard';
    b.setAttribute('aria-label', b.title);
    b.tabIndex = -1;              // a mouse convenience: not a tab stop per item
    if (unpinGlyph) { b.textContent = '\u00D7'; }
    else { b.innerHTML = '\u003csvg>\u003cuse href="#ico-pin"/>\u003c/svg>'; }
    b.addEventListener('click', function (ev) { ev.preventDefault(); ev.stopPropagation(); onClick(); });
    return b;
  }
  function save(path, on) {
    var fd = new FormData();
    fd.append('path', path); fd.append('pinned', on ? '1' : '0'); fd.append('_authenticator', token);
    fetch(url, {method: 'POST', body: fd, credentials: 'same-origin'})
      .then(function (r) { return r.json(); })
      .then(function (d) { if (d && Array.isArray(d.pins)) { pins = d.pins; render(); } })
      .catch(function () {});
  }
  function render() {
    box.innerHTML = '';
    pins.forEach(function (p) {
      var src = itemFor(p);
      if (!src) return;
      var a = src.cloneNode(true);
      a.classList.add('pfas-si-pinned');
      var old = a.querySelector('.pfas-pin-btn');
      if (old) old.parentNode.removeChild(old);
      a.appendChild(pinButton(function () { save(p, false); }, true, true));
      box.appendChild(a);
    });
    box.classList.toggle('has-pins', box.children.length > 0);
    items.forEach(function (it) {
      var p = rel(it.href);
      if (!p) return;
      var old = it.querySelector('.pfas-pin-btn');
      if (old) old.parentNode.removeChild(old);
      var on = pins.indexOf(p) >= 0;
      it.appendChild(pinButton(function () { save(p, !on); }, on, false));
    });
  }
  render();
})();

/* ── Core SENAITE page: mobile drawer, rail state, viewport ── */
(function () {
  if (document.body.classList.contains('pfas-app')) return;

  function injectBackdrop() {
    if (document.getElementById('pfas-mobile-backdrop')) return;
    var bd = document.createElement('div');
    bd.id = 'pfas-mobile-backdrop';
    bd.setAttribute('onclick', 'pfasCloseMobileSidebar()');
    bd.setAttribute('aria-hidden', 'true');
    document.body.appendChild(bd);
  }


  function wireNavLinks() {
    /* Auto-close the sidebar when a nav link is tapped on mobile */
    var links = document.querySelectorAll('#sidebar .pfas-si');
    for (var i = 0; i < links.length; i++) {
      links[i].addEventListener('click', function () {
        if (window.innerWidth <= 768) { pfasCloseMobileSidebar(); }
      });
    }
  }

  /* Restore desktop icon-rail state on core pages */
  function restoreRailState() {
    if (window.innerWidth <= 768) return;
    try {
      if (sessionStorage.getItem('pfas_panel_collapsed') === '1') {
        var sb = document.getElementById('sidebar');
        if (sb) sb.classList.add('toggled');
      }
    } catch (e) {}
  }

  /* Close mobile drawer on Escape */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { pfasCloseMobileSidebar(); }
  });

  /* Fix SENAITE's initial-scale=0.8 viewport — core pages end up with two
     <meta name="viewport"> tags and the 0.8 one wins, making everything
     appear zoomed out on mobile. Force 1.0 by replacing all viewport metas. */
  function fixViewport() {
    var metas = document.querySelectorAll('meta[name="viewport"]');
    if (metas.length <= 1) return;
    for (var i = 1; i < metas.length; i++) {
      metas[i].parentNode.removeChild(metas[i]);
    }
    metas[0].setAttribute('content', 'width=device-width, initial-scale=1.0');
  }

  function init() {
    fixViewport();
    injectBackdrop();
    wireNavLinks();
    restoreRailState();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

</nav>
