          <span class="pfas-si-icon"><svg><use href="#ico-prep-standards"/></svg></span>
          <span class="pfas-si-label">Prepared Standards</span>
        </a>
        <!-- One Logbooks item: Templates -> Method sequence -> By
             batch are tabs of one page; bench staff see By batch only. -->
        <a class="pfas-si" title="Logbooks: templates, method sequence, by batch"
           tal:attributes="href string:${purl}/@@pfas-logbook-batches;
                           class python:'pfas-si si-active' if ('@@pfas-logbook-batches' in path or '@@pfas-logbook-index' in path or '@@pfas-logbook-dynamic' in path or '@@pfas-prep-logbooks' in path or '@@pfas-logbook-admin' in path) else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-book-open"/></svg></span>
          <span class="pfas-si-label">Logbooks</span>
        </a>
        <a class="pfas-si" title="Samples awaiting homogenisation, and the record of it"
           tal:attributes="href string:${purl}/@@pfas-homogenisation;
                           class python:'pfas-si si-active' if ('@@pfas-homogenisation' in path and '@@pfas-homogenisation-setup' not in path) else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-extraction"/></svg></span>
          <span class="pfas-si-label">Homogenisation</span>
        </a>
        <a class="pfas-si" title="Extraction Guide"
           tal:attributes="href string:${purl}/@@pfas-extraction-guide;
                           class python:'pfas-si si-active' if '@@pfas-extraction-guide' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-extraction"/></svg></span>
          <span class="pfas-si-label">Extraction Guide</span>
        </a>
        <a class="pfas-si" title="Controlled Documents — QAM, SOPs, job aids, supplemental"
           tal:attributes="href string:${purl}/@@pfas-sop;
                           class python:'pfas-si si-active' if '@@pfas-sop' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-book-open"/></svg></span>
          <span class="pfas-si-label">Controlled Documents</span>
        </a>
        <a class="pfas-si" title="Deviations &amp; CARs"
           tal:attributes="href string:${purl}/@@pfas-deviations;
                           class python:'pfas-si si-active' if '@@pfas-deviations' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-warning"/></svg></span>
          <span class="pfas-si-label">Deviations / CARs</span>
        </a>
      </div>
    </div>

    <!-- ── EQUIPMENT (all staff roles; was Facility QC): every
         item a SENAITE instrument with a type; the daily checks below. -->
    <div class="pfas-sg" id="pfas-sg-facilityqc"
         tal:condition="python:is_mgr or is_ana or is_clk">
      <button class="pfas-sg-head" type="button"
              onclick="pfasSgToggle('pfas-sg-facilityqc')">
        <span class="pfas-sg-label">Equipment</span>
        <span class="pfas-sg-arrow">&#9660;</span>
      </button>
      <div class="pfas-sg-items">
        <a class="pfas-si" title="Every instrument and piece of equipment, with what is due"
           tal:attributes="href string:${purl}/@@pfas-equipment;
                           class python:'pfas-si si-active' if ('@@pfas-equipment' in path and '@@pfas-equipment-types' not in path) else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-unit-registry"/></svg></span>
          <span class="pfas-si-label">Equipment</span>
        </a>
        <a class="pfas-si" title="What each type obliges: calibration frequency, correction factor, external certificate"
           tal:condition="is_mgr"
           tal:attributes="href string:${purl}/@@pfas-equipment-types;
                           class python:'pfas-si si-active' if '@@pfas-equipment-types' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-unit-registry"/></svg></span>
          <span class="pfas-si-label">Equipment Types</span>
        </a>
        <a class="pfas-si" title="Homogenisation methods and each matrix's default"
           tal:condition="is_mgr"
           tal:attributes="href string:${purl}/@@pfas-homogenisation-setup;
                           class python:'pfas-si si-active' if '@@pfas-homogenisation-setup' in path else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-unit-registry"/></svg></span>
          <span class="pfas-si-label">Homogenisation Methods</span>
        </a>
        <!-- One item for a page group: its pages are sub-tabs (page_groups.py) -->
        <tal:g define="gi python:context.restrictedTraverse('@@pfas-macros').group_item('equipment-checks')" condition="gi">
        <a class="pfas-si" title="Daily checklist, temperature, balance, weight sets, pipettes, reagent water, waste, eye wash"
           tal:attributes="href gi/href; class python:'pfas-si si-active' if gi['active'] else 'pfas-si'">
          <span class="pfas-si-icon"><svg><use href="#ico-daily-checklist"/></svg></span>
          <span class="pfas-si-label">Equipment Checks</span>
        </a>
        </tal:g>
      </div>
    </div>

    <!-- ── INSTRUMENTS &amp; IMPORT (all staff roles) ───────────────────── -->
    <div class="pfas-sg" id="pfas-sg-instruments"
         tal:condition="python:is_mgr or is_ana or is_clk">
      <button class="pfas-sg-head" type="button"
              onclick="pfasSgToggle('pfas-sg-instruments')">
        <span class="pfas-sg-label">Instruments &amp; Import</span>
        <span class="pfas-sg-arrow">&#9660;</span>
