  <symbol id="ico-toggles" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="7" rx="3.5"/><rect x="3" y="13" width="18" height="7" rx="3.5"/><path d="M15 7.5h2"/><path d="M7 16.5h2"/></symbol>
  <symbol id="ico-people" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><rect x="5" y="3" width="8" height="8" rx="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
  <symbol id="ico-published" viewBox="0 0 24 24"><path d="M9 2v17.5A2.5 2.5 0 0 1 6.5 22 2.5 2.5 0 0 1 4 19.5V2"/><path d="M3 2h7"/><path d="M4 9h5"/><path d="m13 14 3 3 5-6"/></symbol>
  <symbol id="ico-batch" viewBox="0 0 24 24"><path d="M21 8v13H3V8"/><path d="M1.5 3h21v5h-21Z"/><path d="M10 12h4"/></symbol>
  <symbol id="ico-sequence" viewBox="0 0 24 24"><path d="M10 6h11"/><path d="M10 12h11"/><path d="M10 18h11"/><path d="m3 4 3 2-3 2"/><path d="m3 10 3 2-3 2"/><path d="m3 16 3 2-3 2"/></symbol>
  <symbol id="ico-chain" viewBox="0 0 24 24"><path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 0 1 0 10h-2"/><path d="M8 12h8"/></symbol>
  <symbol id="ico-pipette" viewBox="0 0 24 24"><path d="m2 22 1-1h3l9-9"/><path d="M3 21v-3l9-9"/><path d="m15 6 3.4-3.4a2.1 2.1 0 1 1 3 3L18 9l.4.4a2.1 2.1 0 1 1-3 3l-3.8-3.8a2.1 2.1 0 1 1 3-3l.4.4Z"/></symbol>
  <symbol id="ico-template" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><rect x="8" y="11" width="8" height="3" rx=".5"/><path d="M8 17h5"/></symbol>
  <symbol id="ico-ref-thermometer" viewBox="0 0 24 24"><path d="M11 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/><path d="m14 7 2 2 4.5-4.5"/></symbol>
  <symbol id="ico-tiers" viewBox="0 0 24 24"><path d="M4 20h16"/><path d="M6 15.5h12"/><path d="M8 11h8"/><path d="M10 6.5h4"/></symbol>
