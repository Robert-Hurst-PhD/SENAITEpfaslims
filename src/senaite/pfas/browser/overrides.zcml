<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:browser="http://namespaces.zope.org/browser">

  <!--
    Override @@lims-setup from senaite.core.

    We register on ISenaitePFASLayer (which extends ISenaiteCore) so Zope's
    adapter-lookup specificity selects our view over the senaite.core
    registration on ISenaiteCore — no conflict, no includeOverrides needed.
  -->
  <browser:page
      name="lims-setup"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class="senaite.pfas.browser.lims_setup.PFASSetupView"
      permission="senaite.core.permissions.ManageBika"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />

  <!--
    Override senaite.sidebar viewlet manager from senaite.core.

    ISenaitePFASLayer > ISenaiteCore in adapter specificity, so Zope selects
    PFASSidebarManager on all PFAS-layer requests without needing includeOverrides.

    Upgrade note: if senaite.core changes SidebarViewletManager.available()
    signature, check sidebar.py PFASSidebarManager.

    Provides: senaite.core.browser.viewlets.interfaces.ISidebar
  -->
  <browser:viewletManager
      name="senaite.sidebar"
      provides="senaite.core.browser.viewlets.interfaces.ISidebar"
      permission="zope2.View"
      class="senaite.pfas.browser.sidebar.PFASSidebarManager"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />

  <!--
    Override senaite.core's toolbar (plone.toolbar viewlet manager) so core
    pages draw the same top bar as PFAS pages (GAPS §93, DECISIONS
    2026-10-03). Same specificity rule as the sidebar above.

    Upgrade note: PFASToolbarManager subclasses core's ToolbarViewletManager;
    check browser/topbar.py if core changes it.
  -->
  <browser:viewletManager
      name="plone.toolbar"
      provides="plone.app.layout.viewlets.interfaces.IToolbar"
      permission="zope2.View"
      class="senaite.pfas.browser.topbar.PFASToolbarManager"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />

  <!--
    Worksheet instrument pickers offer analysis instruments only (GAPS §100b):
    equipment whose type is not "offered in worksheets" (a fridge, an eye
    wash) is left out. Subclasses of core's views, same registrations, on the
    PFAS layer. Upgrade note: PFASWorksheetFolderView overrides
    FolderView._get_instruments_brains and PFASManageResultsView
    ManageResultsView.getInstruments (browser/equipment.py).
  -->
  <browser:page
      for="bika.lims.interfaces.IWorksheetFolder"
      name="base_view"
      class="senaite.pfas.browser.equipment.PFASWorksheetFolderView"
      permission="zope.Public"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />
  <browser:page
      for="bika.lims.interfaces.IWorksheet"
      name="manage_results"
      class="senaite.pfas.browser.equipment.PFASManageResultsView"
      permission="senaite.core.permissions.ViewResults"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />

  <!--
    Override @@email (report/COA delivery) from senaite.core
    (bika.lims.browser.publish.emailview.EmailView) so the state EDD CSV rides
    the same email as the report PDF (D63 step D). Registered on
    ISenaitePFASLayer (> ISenaiteCore) — a more-specific-layer subclass, not a
    core fork. PFASEmailView.email_attachments calls super() then appends the
    EDD; if the core email_attachments contract changes, revisit edd_email.py.

    Two contexts, mirroring core: Sample (IAnalysisRequest) and Client.
    Permission mirrors core's @@email (senaite.core.permissions.ManageAnalysisRequests);
    keep in sync with the core registration on upgrade.
  -->
  <browser:page
      name="email"
      for="bika.lims.interfaces.IAnalysisRequest"
      class="senaite.pfas.browser.edd_email.PFASEmailView"
      permission="senaite.core.permissions.ManageAnalysisRequests"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />

  <browser:page
      name="email"
      for="bika.lims.interfaces.IClient"
      class="senaite.pfas.browser.edd_email.PFASEmailView"
      permission="senaite.core.permissions.ManageAnalysisRequests"
      layer="senaite.pfas.interfaces.ISenaitePFASLayer"
      />

</configure>
