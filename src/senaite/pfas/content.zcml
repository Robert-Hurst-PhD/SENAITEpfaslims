<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="senaite.pfas">

  <!-- Reagent (barcode-scanned lot) -->
  <class class=".content.reagent.Reagent">
    <require
        permission="zope2.View"
        interface=".content.reagent.IReagent" />
  </class>

  <!-- EnvironmentalReading (RPi temperature/humidity) -->
  <class class=".content.envreading.EnvironmentalReading">
    <require
        permission="zope2.View"
        interface=".content.envreading.IEnvironmentalReading" />
  </class>

</configure>
